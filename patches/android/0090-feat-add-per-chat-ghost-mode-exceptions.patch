diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TelePeersActivity.kt b/TMessagesProj/src/main/java/tele/ui/settings/TelePeersActivity.kt
index eb90a1fe9..fefce472b 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TelePeersActivity.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TelePeersActivity.kt
@@ -51,12 +51,16 @@ class TelePeersActivity(private val account: Int, private val mode: String) : Ba
         else -> "ignored users"
     }
 
-    private fun modeOf(dialogId: Long): String? = if (isIgnoreMode) {
-        PrivacyRules.ignoredMode(account, dialogId)
-    } else {
-        PrivacyRules.ghostMode(account, dialogId)
+    private fun modeOf(dialogId: Long): String? {
+        if (isIgnoreMode) {
+            return PrivacyRules.ignoredMode(account, dialogId)
+        }
+        val ghost = PrivacyRules.ghostMode(account, dialogId) ?: return null
+        return if (ghost == ghostMode()) ghost else null
     }
 
+    private fun ghostMode(): String = if (mode == MODE_GHOST_NEVER) PrivacyRules.GHOST_NEVER else PrivacyRules.GHOST_ALWAYS
+
     private fun applyMode(dialogId: Long, newMode: String?) {
         if (isIgnoreMode) {
             PrivacyRules.setIgnored(account, dialogId, newMode)
@@ -228,7 +232,7 @@ class TelePeersActivity(private val account: Int, private val mode: String) : Ba
         listView.setOnItemClickListener { _, position ->
             val peer = peers.getOrNull(position - 1) ?: return@setOnItemClickListener
             val current = modeOf(peer.dialogId)
-            val next = if (current != null) null else if (isIgnoreMode) PrivacyRules.MODE_FADE else mode
+            val next = if (current != null) null else if (isIgnoreMode) PrivacyRules.MODE_FADE else ghostMode()
             applyMode(peer.dialogId, next)
             adapter?.notifyDataSetChanged()
         }
@@ -252,12 +256,12 @@ class TelePeersActivity(private val account: Int, private val mode: String) : Ba
         val options = if (isIgnoreMode) {
             arrayOf("hide", "fade", "remove")
         } else {
-            arrayOf("always ghost", "never ghost", "remove")
+            arrayOf(if (mode == MODE_GHOST_NEVER) "never ghost" else "always ghost", "remove")
         }
         builder.setItems(options) { _, which ->
             when (which) {
-                0 -> applyMode(peer.dialogId, if (isIgnoreMode) PrivacyRules.MODE_HIDE else PrivacyRules.GHOST_ALWAYS)
-                1 -> applyMode(peer.dialogId, if (isIgnoreMode) PrivacyRules.MODE_FADE else PrivacyRules.GHOST_NEVER)
+                0 -> applyMode(peer.dialogId, if (isIgnoreMode) PrivacyRules.MODE_HIDE else ghostMode())
+                1 -> if (isIgnoreMode) applyMode(peer.dialogId, PrivacyRules.MODE_FADE) else applyMode(peer.dialogId, null)
                 else -> applyMode(peer.dialogId, null)
             }
             adapter?.notifyDataSetChanged()
