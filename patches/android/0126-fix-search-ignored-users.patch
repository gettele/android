@@ -53,25 +56,35 @@ class TelePeersActivity(private val account: Int, private val mode: String) : Ba
         root.orientation = LinearLayout.VERTICAL
         root.setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundGray))
 
+        val search = android.widget.EditText(context)
+        search.setSingleLine(true)
+        search.hint = "Search"
+        search.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16f)
+        search.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
+        search.setHintTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2))
+        search.setPadding(AndroidUtilities.dp(16f), 0, AndroidUtilities.dp(16f), 0)
+        root.addView(search, LinearLayout.LayoutParams(-1, AndroidUtilities.dp(48f)))
+
         val list = ListView(context)
         list.setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundGray))
         list.divider = android.graphics.drawable.ColorDrawable(android.graphics.Color.TRANSPARENT)
         list.dividerHeight = AndroidUtilities.dp(4f)
-        list.setOnItemClickListener { _, _, position, _ ->
-            val dialog = items.getOrNull(position) ?: return@setOnItemClickListener
-            if (!selected.remove(dialog.id)) {
-                selected.add(dialog.id)
-            }
-            updateCounter()
-            (list.adapter as BaseAdapter).notifyDataSetChanged()
-        }
-        list.adapter = object : BaseAdapter() {
+        val adapter = object : BaseAdapter() {
             override fun getCount(): Int = items.size
             override fun getItem(position: Int): Any = items[position]
             override fun getItemId(position: Int): Long = items[position].id
             override fun getView(position: Int, convertView: View?, parent: ViewGroup): View =
                 row(convertView, items[position])
         }
+        listAdapter = adapter
+        list.adapter = adapter
+        search.addTextChangedListener(object : android.text.TextWatcher {
+            override fun beforeTextChanged(s: CharSequence?, start: Int, count: Int, after: Int) = Unit
+            override fun onTextChanged(s: CharSequence?, start: Int, before: Int, count: Int) {
+                filterItems(s?.toString().orEmpty())
+            }
+            override fun afterTextChanged(s: android.text.Editable?) = Unit
+        })
         root.addView(list, LinearLayout.LayoutParams(-1, 0, 1f))
 
         val bar = LinearLayout(context)
@@ -112,20 +125,49 @@ class TelePeersActivity(private val account: Int, private val mode: String) : Ba
 
     private fun load() {
         val messagesController = AccountInstance.getInstance(account).getMessagesController()
+        val savedMessagesId = UserConfig.getInstance(account).clientUserId
         val all = messagesController.getDialogs(0) ?: emptyList()
-        items = all.filter { dialog ->
+        allItems = all.filter { dialog ->
             if (mode != MODE_IGNORE) {
                 !DialogObject.isFolderDialogId(dialog.id)
             } else {
-                isUser(dialog)
+                dialog.id != savedMessagesId && isUser(dialog)
             }
         }
+        items = allItems
         selected.clear()
         selected.addAll(currentSelection())
         updateCounter()
     }
 
-    /** A person or a bot: the peer of the dialog is a user, not a chat. */
+    private fun filterItems(query: String) {
+        val needle = query.trim().lowercase()
+        items = if (needle.isEmpty()) {
+            allItems
+        } else {
+            val messagesController = AccountInstance.getInstance(account).getMessagesController()
+            allItems.filter { dialog ->
+                val user = messagesController.getUser(dialog.id)
+                val chat = messagesController.getChat(dialog.id)
+                val name = if (user != null) {
+                    "${user.first_name.orEmpty()} ${user.last_name.orEmpty()} ${user.username.orEmpty()}"
+                } else {
+                    chat?.title.orEmpty()
+                }
+                name.lowercase().contains(needle)
+            }
+        }
+        listAdapter?.notifyDataSetChanged()
+    }
+
+    private fun toggleSelection(dialogId: Long) {
+        if (!selected.remove(dialogId)) {
+            selected.add(dialogId)
+        }
+        updateCounter()
+        listAdapter?.notifyDataSetChanged()
+    }
+
     private fun isUser(dialog: TLRPC.Dialog): Boolean {
         val peer = dialog.peer
         if (peer != null) {
@@ -180,9 +222,11 @@ class TelePeersActivity(private val account: Int, private val mode: String) : Ba
         cell.setCustomMessage(null)
         cell.setDialog(dialog, DialogsActivity.DIALOGS_TYPE_FORWARD, 0)
         cell.setChecked(selected.contains(dialog.id), convertView != null)
+        cell.setOnClickListener { toggleSelection(dialog.id) }
         return cell
     }
 
+
     companion object {
         const val MODE_IGNORE = "ignore"
         const val MODE_GHOST_ALWAYS = "ghost_always"
