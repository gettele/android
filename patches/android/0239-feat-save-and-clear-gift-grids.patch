+    /** The grid is kept on this device under a name, as the desktop menu does it. */
+    private fun saveGridAs() {
+        editText(lc("Save grid"), "") { name ->
+            if (name.isEmpty()) return@editText
+            GiftGrid.saveGrid(currentAccount, name, layout)
+            BulletinFactory.of(this).createSimpleBulletin(R.raw.info, lc("Grid saved")).show()
+        }
+    }
+
+    /** The saved grids: a tap loads one, the dialog clears all of them. */
+    private fun showSavedGrids() {
+        val grids = GiftGrid.savedGrids(currentAccount)
+        if (grids.isEmpty()) {
+            BulletinFactory.of(this).createSimpleBulletin(R.raw.info, lc("There are no saved grids")).show()
+            return
+        }
+        val names = grids.keys.toTypedArray()
+        AlertDialog.Builder(parentActivity ?: return, resourceProvider)
+            .setTitle(lc("Saved grids"))
+            .setItems(names) { _, which ->
+                val json = grids[names[which]] ?: return@setItems
+                layout = Layout.fromJson(json)
+                GiftGrid.resolve(currentAccount, layout)
+                GiftGrid.save(currentAccount, layout)
+                recycler?.adapter?.update(true)
+            }
+            .setNegativeButton(lc("Delete all")) { _, _ ->
+                for (name in names) GiftGrid.deleteGrid(currentAccount, name)
+            }
+            .setPositiveButton(LocaleController.getString(R.string.Cancel), null)
+            .show()
+    }
+
+    /** Empties the grid, as the desktop menu has it. */
+    private fun clearGrid() {
+        AlertDialog.Builder(parentActivity ?: return, resourceProvider)
+            .setTitle(lc("Clear grid"))
+            .setMessage(lc("All the cells of the grid are emptied. The saved grids stay."))
+            .setPositiveButton(lc("Clear")) { _, _ ->
+                layout.clear()
+                GiftGrid.save(currentAccount, layout)
+                recycler?.adapter?.update(true)
+            }
+            .setNegativeButton(LocaleController.getString(R.string.Cancel), null)
+            .show()
+    }
+
+    /** A one line dialog with a text field, as the studio has it. */
+    private fun editText(title: String, value: String, onDone: (String) -> Unit) {
+        val context = parentActivity ?: return
+        val input = org.telegram.ui.Components.EditTextBoldCursor(context)
+        input.setText(value)
+        input.setTextSize(android.util.TypedValue.COMPLEX_UNIT_DIP, 18f)
+        input.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText, resourceProvider))
+        input.setCursorColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText, resourceProvider))
+        input.setBackground(null)
+        input.setPadding(AndroidUtilities.dp(23f), 0, AndroidUtilities.dp(23f), 0)
+        val frame = FrameLayout(context)
+        frame.addView(input, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, 48f))
+        AlertDialog.Builder(context, resourceProvider)
+            .setTitle(title)
+            .setView(frame)
+            .setPositiveButton(LocaleController.getString(R.string.Done)) { _, _ -> onDone(input.text.toString().trim()) }
+            .setNegativeButton(LocaleController.getString(R.string.Cancel), null)
+            .show()
+    }
