+    /** The named grids of the account: a name and the layout it holds. */
+    @JvmStatic
+    fun savedGrids(account: Int): LinkedHashMap<String, String> {
+        val result = LinkedHashMap<String, String>()
+        val json = TeleDatabaseHelper.get(KEY_SAVED + account) ?: return result
+        runCatching {
+            val objectJson = JSONObject(json)
+            val keys = objectJson.keys()
+            while (keys.hasNext()) {
+                val key = keys.next()
+                val value = objectJson.optString(key)
+                if (value.isNotEmpty()) result[key] = value
+            }
+        }.onFailure { org.telegram.messenger.FileLog.e(it) }
+        return result
+    }
+
+    @JvmStatic
+    fun saveGrid(account: Int, name: String, layout: Layout) {
+        if (name.isEmpty()) return
+        val grids = savedGrids(account)
+        grids[name] = layout.toJson()
+        storeGrids(account, grids)
+    }
+
+    @JvmStatic
+    fun deleteGrid(account: Int, name: String) {
+        val grids = savedGrids(account)
+        grids.remove(name)
+        storeGrids(account, grids)
+    }
+
+    private fun storeGrids(account: Int, grids: LinkedHashMap<String, String>) {
+        val objectJson = JSONObject()
+        for ((name, value) in grids) objectJson.put(name, value)
+        TeleDatabaseHelper.put(KEY_SAVED + account, objectJson.toString())
+    }
+
     /** The collection that the last cell was made of, so a new cell starts from it. */
     @JvmStatic
     fun lastCollection(account: Int): String = TeleDatabaseHelper.get(KEY_LAST + account) ?: ""
