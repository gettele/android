+
+    /** The caption a sticker goes out with; [fromField] tells the field to be cleared after the send. */
+    class Taken(@JvmField val text: CharSequence, @JvmField val fromField: Boolean)
+
+    @JvmField
+    val TOO_LONG = Taken("", false)
+
+    private const val ARM_TTL_MS = 120_000L
+    private const val SPOILER_MASK = '\u2588'
+
+    private var armedId = 0L
+    private var armedText: CharSequence? = null
+    private var armedAt = 0L
+
+    @JvmStatic
+    fun sendEnabled(): Boolean = TeleConfig.STICKER_CAPTIONS_SEND.value
+
+    @JvmStatic
+    fun showEnabled(): Boolean = TeleConfig.STICKER_CAPTIONS_SHOW.value
+
+    private fun isSticker(document: TLRPC.Document?): Boolean {
+        if (document == null || MessageObject.isGifDocument(document) || MessageObject.isMaskDocument(document)) return false
+        var sticker = false
+        for (attribute in document.attributes) {
+            if (attribute is TLRPC.TL_documentAttributeCustomEmoji) return false
+            if (attribute is TLRPC.TL_documentAttributeSticker) sticker = true
+        }
+        return sticker
+    }
+
+    /** Whether this document can go out with a caption: stickers only, no emoji, masks or GIFs. */
+    @JvmStatic
+    fun canCaption(document: TLRPC.Document?): Boolean = isSticker(document)
+
+    private fun isCaptioned(message: MessageObject?): Boolean {
+        if (message == null || message.isRestrictedMessage || message.caption.isNullOrEmpty()) return false
+        if (message.type != MessageObject.TYPE_STICKER && message.type != MessageObject.TYPE_ANIMATED_STICKER) return false
+        return !message.isAnimatedEmoji && message.messageOwner?.media is TLRPC.TL_messageMediaDocument
+    }
+
+    /** Whether the chat cell draws the caption of this sticker message. */
+    @JvmStatic
+    fun shows(message: MessageObject?): Boolean = showEnabled() && isCaptioned(message)
+
+    // a caption typed in the dialog waits for the send, which may go through a schedule or confirm step first
+    @JvmStatic
+    fun arm(document: TLRPC.Document?, caption: CharSequence) {
+        armedId = document?.id ?: 0L
+        armedText = caption
+        armedAt = System.currentTimeMillis()
+    }
+
+    /**
+     * The caption for the sticker about to go out: the armed one, else the text of the field.
+     * Null sends a plain sticker; [TOO_LONG] cancels the send.
+     */
+    @JvmStatic
+    fun take(fragment: BaseFragment?, account: Int, sticker: TLRPC.Document?, clearsField: Boolean, field: CharSequence?): Taken? {
+        if (!sendEnabled() || !isSticker(sticker)) return null
+        val armed = armedText
+        val text: CharSequence
+        val fromField: Boolean
+        if (armed != null && sticker!!.id == armedId && System.currentTimeMillis() - armedAt < ARM_TTL_MS) {
+            armedText = null
+            text = armed
+            fromField = false
+        } else {
+            armedText = null
+            // the field of a suggestion search holds the emoji, not a caption
+            if (clearsField || field == null) return null
+            text = AndroidUtilities.getTrimmedString(field)
+            if (text.isEmpty() || Emoji.fullyConsistsOfEmojis(text)) return null
+            fromField = true
+        }
+        val over = text.length - MessagesController.getInstance(account).captionMaxLengthLimit
+        if (over > 0) {
+            if (fragment != null) {
+                BulletinFactory.of(fragment).createSimpleBulletin(R.raw.error, LocaleController.formatString(R.string.TeleStickerCaptionTooLong, over)).show()
+            }
+            return TOO_LONG
+        }
+        return Taken(text, fromField)
+    }
+
+    /** Puts the caption and its entities on the sticker about to go out. */
+    @JvmStatic
+    fun apply(params: SendMessagesHelper.SendMessageParams, caption: CharSequence, account: Int) {
+        val message = arrayOf(caption)
+        val entities = MediaDataController.getInstance(account).getEntities(message, true)
+        params.caption = message[0].toString()
+        params.entities = entities
+    }
+
+    private fun label(message: MessageObject): String {
+        val sticker = LocaleController.getString(R.string.AttachSticker)
+        val emoji = message.stickerEmoji
+        return if (emoji.isNullOrEmpty()) sticker else "$emoji $sticker"
+    }
+
+    /** The label ahead of the caption in the chat list, null when the stock preview stays. */
+    @JvmStatic
+    fun dialogPrefix(message: MessageObject?): String? =
+        if (shows(message)) "${label(message!!)}, " else null
+
+    /** The notification text of a captioned sticker, null when the stock text stays. */
+    @JvmStatic
+    fun notifyText(message: MessageObject?): String? {
+        if (!shows(message)) return null
+        val owner = message!!.messageOwner
+        val raw = owner.message
+        if (raw.isNullOrEmpty()) return null
+        val builder = StringBuilder(raw)
+        if (!message.didSpoilLoginCode()) {
+            for (entity in owner.entities) {
+                if (entity !is TLRPC.TL_messageEntitySpoiler) continue
+                val end = minOf(entity.offset + entity.length, builder.length)
+                for (i in max(entity.offset, 0) until end) builder.setCharAt(i, SPOILER_MASK)
+            }
+        }
+        return "${label(message)}, $builder"
+    }
+
+    @JvmStatic
+    fun onToggled() {
+        TeleHooks.bumpUiRevision()
+        for (account in 0 until org.telegram.messenger.UserConfig.MAX_ACCOUNT_COUNT) {
+            org.telegram.messenger.NotificationCenter.getInstance(account).postNotificationName(org.telegram.messenger.NotificationCenter.dialogsNeedReload)
+        }
+    }
+
+    /** Extra height under the sticker for a caption bubble of the given text height. */
+    @JvmStatic
+    fun extraHeight(textHeight: Int): Int = GAP_DP.dp() + textHeight + PAD_V_DP.dp() * 2
+
+    /** The caption bubble under the sticker, on the side the message sits. */
+    @JvmStatic
+    fun place(out: Rect, imageLeft: Float, imageRight: Float, imageBottom: Float, textWidth: Int, textHeight: Int, outgoing: Boolean) {
+        val width = textWidth + 28.dp()
+        val top = (imageBottom + GAP_DP.dp()).toInt()
+        val left = if (outgoing) (imageRight - width).toInt() else imageLeft.toInt()
+        out.set(left, top, left + width, top + textHeight + PAD_V_DP.dp() * 2)
+    }
+
+    @JvmStatic
+    fun textInsetX(outgoing: Boolean): Int = (if (outgoing) 11 else 17).dp()
+
+    @JvmStatic
+    fun textInsetY(): Int = PAD_V_DP.dp()
+
+    @JvmStatic
+    fun drawBubble(
+        canvas: Canvas,
+        bubble: MessageDrawable,
+        bounds: Rect,
+        top: Int,
+        parentWidth: Int,
+        parentHeight: Int,
+        parentViewTopOffset: Int,
+        blurTop: Int,
+        blurBottom: Int,
+        pinnedTop: Boolean,
+        pinnedBottom: Boolean,
+        alpha: Float
+    ) {
+        bubble.setTop(top, parentWidth, parentHeight, parentViewTopOffset, blurTop, blurBottom, pinnedTop, pinnedBottom)
+        bubble.setBounds(bounds.left, bounds.top, bounds.right, bounds.bottom)
+        val shadow = bubble.shadowDrawable
+        if (shadow != null) {
+            shadow.setBounds(bounds.left, bounds.top, bounds.right, bounds.bottom)
+            shadow.alpha = (255 * alpha).toInt()
+            shadow.draw(canvas)
+        }
+        bubble.alpha = (255 * alpha).toInt()
+        bubble.draw(canvas)
+        bubble.alpha = 255
+    }
+
+    /** The "Send with caption…" step of the sticker preview menu. */
+    @JvmStatic
+    fun ask(activity: Activity, provider: Theme.ResourcesProvider?, document: TLRPC.Document?, send: Runnable) {
+        val field = TeleHooks.themedField(activity, provider)
+        field.inputType = InputType.TYPE_CLASS_TEXT or InputType.TYPE_TEXT_FLAG_MULTI_LINE or InputType.TYPE_TEXT_FLAG_CAP_SENTENCES
+        field.gravity = Gravity.LEFT or Gravity.TOP
+        field.setSingleLine(false)
+        field.maxLines = 6
+        field.hint = LocaleController.getString(R.string.Caption)
+        val container = android.widget.FrameLayout(activity)
+        container.addView(field, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT.toFloat(), Gravity.TOP, 24f, 0f, 24f, 0f))
+        val builder = AlertDialog.Builder(activity, provider)
+        builder.setTitle(LocaleController.getString(R.string.TeleStickerCaptionTitle))
+        builder.setView(container)
+        builder.setPositiveButton(LocaleController.getString(R.string.Send)) { _, _ ->
+            val text = field.text?.toString()?.trim().orEmpty()
+            if (text.isNotEmpty()) arm(document, text)
+            send.run()
+        }
+        builder.setNegativeButton(LocaleController.getString(R.string.Cancel), null)
+        val dialog = builder.create()
+        dialog.setOnShowListener {
+            field.requestFocus()
+            AndroidUtilities.showKeyboard(field)
+        }
+        dialog.show()
+    }
+
+    private fun Int.dp(): Int = AndroidUtilities.dp(this.toFloat())
+
+    private const val GAP_DP = 3
+    private const val PAD_V_DP = 7
+}
