     private const val KEY = "link_rewrite_rules"
 
+    // targets that shut down, with the service that replaced them
+    private val GONE_TARGETS = mapOf("vxtiktok.com" to "tnktok.com")
+
+    // the saved rules keep the old target until the user edits them
+    @JvmStatic
+    fun migrateTargets(targets: List<String>): List<String> {
+        val out = ArrayList<String>()
+        var migrated = 0
+        for (target in targets) {
+            val live = GONE_TARGETS[target] ?: target
+            if (live != target) migrated++
+            if (!out.contains(live)) out.add(live)
+        }
+        if (migrated > 0) {
+            android.util.Log.d("TeleLinkRewrite", "rule=$TYPE_DOMAIN migrated=$migrated")
+        }
+        return out
+    }
