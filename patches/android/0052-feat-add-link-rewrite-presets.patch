@@ -122,15 +174,22 @@ object LinkRewrites {
 
     private fun applyRules(url: String, rules: List<Rule>): String? {
         for (rule in rules) {
+            if (!rule.enabled) continue
             if (rule.type == TYPE_DOMAIN) {
-                applyDomains(url, rule)?.let { return it }
+                applyDomains(url, rule)?.let {
+                    android.util.Log.d("TeleLinkRewrite", "rule=${rule.type}")
+                    return it
+                }
             } else if (rule.find.isNotEmpty()) {
                 val rewritten = runCatching {
                     val regex = Regex(rule.find, RegexOption.IGNORE_CASE)
                     val match = regex.find(url) ?: return@runCatching null
                     url.replaceRange(match.range, expand(rule.replace, match))
                 }.getOrNull()
-                if (rewritten != null) return rewritten
+                if (rewritten != null) {
+                    android.util.Log.d("TeleLinkRewrite", "rule=${rule.type}")
+                    return rewritten
+                }
             }
         }
         return null
