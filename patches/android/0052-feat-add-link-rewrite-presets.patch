+    @JvmStatic
+    fun normalizeDomain(value: String): String {
+        var result = value.trim().lowercase()
+        result = result.removePrefix("https://").removePrefix("http://")
+        result = result.substringBefore('/').substringBefore('?').substringBefore('#')
+        result = result.substringAfterLast('@').substringBefore(':')
+        if (result.startsWith("*.")) result = result.substring(2)
+        if (result.startsWith("www.")) result = result.substring(4)
+        result = result.trimEnd('.')
+        return if (Regex("^(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.)+[a-z0-9-]{2,}$").matches(result)) result else ""
+    }
+
+    @JvmStatic
+    fun presets(): List<Rule> = listOf(
