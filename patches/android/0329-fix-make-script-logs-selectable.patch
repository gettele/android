-        override fun onBindViewHolder(holder: RecyclerView.ViewHolder, position: Int) {
-            val view = holder.itemView as TextView
-            val line = lines[position]
-            if (line.length > 10 && line[2] == ':' && line[5] == ':') {
-                val text = SpannableStringBuilder(line)
-                text.setSpan(
-                    ForegroundColorSpan(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2, resourceProvider)),
-                    0, 8, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE
-                )
-                view.text = text
-            } else {
-                view.text = line
+        if (lines == shownLines) return
+        val scroll = scrollView ?: return
+        val atBottom = !scroll.canScrollVertically(1)
+        val text = SpannableStringBuilder()
+        val color = Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2, resourceProvider)
+        for (line in lines) {
+            if (text.isNotEmpty()) text.append('\n')
+            val start = text.length
+            text.append(line)
+            val timeLength = when {
+                line.length >= 14 && line[0] == '[' && line[3] == ':' && line[6] == ':' && line[9] == '.' && line[13] == ']' -> 14
+                line.length >= 8 && line[2] == ':' && line[5] == ':' -> 8
+                else -> 0
             }
+            if (timeLength > 0) text.setSpan(ForegroundColorSpan(color), start, start + timeLength, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
         }
+        view.text = if (lines.isEmpty()) lc("The log is empty.") else text
+        shownLines = lines
+        if (atBottom && lines.isNotEmpty()) scroll.post { scroll.fullScroll(View.FOCUS_DOWN) }
     }
 
     private fun lc(text: String): String = tele.helpers.TeleLowercase.lc(text)
