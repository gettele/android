+    /** The catalog of the third party: the parts of a gift of it, when the setting is on. */
+    private fun chooseCatalog() {
+        if (!GiftStudioCatalog.enabled()) {
+            catalogRow?.setValue(lc("off"), true)
+            return
+        }
+        GiftStudioCatalog.requestGifts { catalog ->
+            if (catalog.isEmpty()) {
+                catalogRow?.setValue(lc("nothing found"), true)
+                return@requestGifts
+            }
+            val names = catalog.map { it.title }.toTypedArray()
+            val builder = AlertDialog.Builder(parentActivity, resourceProvider)
+                .setTitle(lc("Catalog"))
+                .setItems(names) { _, which ->
+                    val picked = catalog[which]
+                    useCatalog = true
+                    catalogRow?.setValue(picked.title, true)
+                    GiftStudioCatalog.requestParts(picked.slug) { found ->
+                        catalogParts = GiftStudio.Parts(
+                            found.models.map { GiftStudio.Part(it.name, it.permille, null, 0, 0, 0, 0, 0) },
+                            found.backdrops.map {
+                                GiftStudio.Part(it.name, it.permille, null, 0, it.centerColor, it.edgeColor, it.patternColor, it.textColor)
+                            },
+                            found.symbols.map { GiftStudio.Part(it.name, it.permille, null, 0, 0, 0, 0, 0) }
+                        )
+                        update()
+                    }
+                }
+            builder.show()
+        }
+    }
+
+    /** The models of the other gifts and the custom ones of the device. */
+    private fun chooseMoreModels() {
+        val items = ArrayList<String>()
+        val actions = ArrayList<() -> Unit>()
+        for (gift in gifts) {
+            if (gift === this.gift) continue
+            val own = GiftStudio.partsOf(gift)
+            for (part in own.models) {
+                items.add(part.name)
+                actions.add {
+                    model = part
+                    update()
+                }
+            }
+        }
+        for (custom in GiftStudioModels.list()) {
+            items.add(custom.key)
+            actions.add {
+                model = GiftStudio.Part(custom.key, 0, null, 0, 0, 0, 0, 0, GiftStudioModels.fileFor(custom.id).absolutePath)
+                update()
+            }
+        }
+        if (items.isEmpty()) return
+        val builder = AlertDialog.Builder(parentActivity, resourceProvider)
+            .setTitle(lc("More models"))
+            .setItems(items.toTypedArray()) { _, which -> actions[which]() }
+        builder.show()
+    }
