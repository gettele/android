--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/GiftStudioModels.kt
@@ -0,0 +1,73 @@
+package tele.helpers
+
+import android.os.Environment
+import android.util.Base64
+import org.telegram.messenger.ApplicationLoader
+import org.telegram.messenger.FileLog
+import java.io.File
+import java.util.UUID
+
+/**
+ * The custom models of the gift studio (desktop 0234): a .tgs file of the device becomes a model
+ * of the studio. The file is stored in the fork storage, so it survives the restarts of the app.
+ */
+object GiftStudioModels {
+
+    private const val MAX_BYTES = 1024 * 1024
+
+    /** The folder of the fork where the custom models are kept. */
+    @JvmStatic
+    fun folder(): File {
+        val folder = File(ApplicationLoader.getFilesDirFixed("tele_gift_studio_models"))
+        folder.mkdirs()
+        return folder
+    }
+
+    /** The file of a custom model by its id. */
+    @JvmStatic
+    fun fileFor(id: String): File = File(folder(), id + ".tgs")
+
+    /** The custom models of the studio, the most recent first. */
+    @JvmStatic
+    fun list(): List<CustomModel> {
+        val folder = folder()
+        val result = ArrayList<CustomModel>()
+        val files = folder.listFiles() ?: return result
+        for (file in files) {
+            if (!file.name.endsWith(".tgs")) continue
+            val id = file.name.removeSuffix(".tgs")
+            if (id.length != 32) continue
+            result.add(CustomModel(id, file.name, file.length()))
+        }
+        result.sortByDescending { it.length }
+        return result
+    }
+
+    /** One custom model. */
+    class CustomModel(
+        @JvmField val id: String,
+        @JvmField val fileName: String,
+        @JvmField val size: Long
+    ) {
+        @JvmField val key = "@my/$id"
+    }
+
+    /** Imports a .tgs file as a custom model. */
+    @JvmStatic
+    fun importModel(file: File): CustomModel? {
+        if (!file.exists() || file.length() > MAX_BYTES) return null
+        val bytes = runCatching { file.readBytes() }.getOrNull() ?: return null
+        if (!bytes.startsWith(byteArrayOf(0x1F, 0x8B))) return null
+        val id = UUID.randomUUID().toString().replace("-", "")
+        val target = fileFor(id)
+        runCatching { target.writeBytes(bytes) }
+        if (!target.exists()) return null
+        return list().firstOrNull { it.id == id }
+    }
+
+    /** Removes a custom model. */
+    @JvmStatic
+    fun remove(id: String) {
+        runCatching { fileFor(id).delete() }
+    }
+}
