 .../src/main/java/tele/helpers/TeleCrash.kt   | 87 ++++++++++++++++++-
 .../tele/ui/settings/TeleSettingsActivity.kt  |  6 +-
 .../src/main/res/xml/provider_paths.xml       |  1 +
 4 files changed, 93 insertions(+), 3 deletions(-)

diff --git a/TMessagesProj/src/main/java/tele/TeleConfig.kt b/TMessagesProj/src/main/java/tele/TeleConfig.kt
