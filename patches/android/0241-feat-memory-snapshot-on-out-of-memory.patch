@@ -1694,7 +1696,7 @@ class TeleSettingsActivity @JvmOverloads constructor(private val mode: String =
                 rows.add(Row(TYPE_SHADOW))
                 rows
             }
-            MODE_SERVER -> listOf(
+            MODE_SERVER -> listOfNotNull(
                 Row(TYPE_HEADER, "server"),
                 Row(TYPE_VALUE, "Server url", value = if (TeleConfig.TELE_SERVER_URL.value.isBlank()) "Empty (disabled)" else TeleConfig.TELE_SERVER_URL.value, item = TeleConfig.TELE_SERVER_URL),
                 Row(TYPE_LINK, title = "Refresh now", mode = "server_refresh", id = "tele-refresh-badges"),
@@ -1702,7 +1704,9 @@ class TeleSettingsActivity @JvmOverloads constructor(private val mode: String =
                 toggle("Usernames from the server", TeleConfig.SERVER_USERNAMES),
                 toggle("Notifications from the server", TeleConfig.NOTICES_SERVER),
                 toggle("Send crash reports", TeleConfig.SEND_CRASH_REPORTS),
+                toggle("Memory snapshot on crashing", TeleConfig.CRASH_HEAP_DUMP),
                 Row(TYPE_LINK, title = "Send pending crash report", mode = "server_send_crash", id = "tele-send-pending-crash"),
+                if (tele.helpers.TeleCrash.hasDump()) Row(TYPE_LINK, title = "Share the snapshot", mode = "server_share_dump", id = "tele-share-dump", value = tele.helpers.TeleCrash.dumpSize()) else null,
                 Row(TYPE_SHADOW)
             )
             MODE_MENU -> listOf(
