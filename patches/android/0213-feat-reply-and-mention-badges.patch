 .../src/main/java/tele/ui/TeleNoticeCell.kt   | 32 +++++++++++++++----
 2 files changed, 39 insertions(+), 8 deletions(-)

diff --git a/TMessagesProj/src/main/java/tele/helpers/TeleMentions.kt b/TMessagesProj/src/main/java/tele/helpers/TeleMentions.kt
index 9abae54bd..84de6d03e 100644
--- a/TMessagesProj/src/main/java/tele/helpers/TeleMentions.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/TeleMentions.kt
@@ -23,7 +23,7 @@ import tele.TeleConfig
  * Mentions and replies in the notification center (tele 0232, the badge of 0246 is in the cell).
  * Every new incoming message of a group that mentions you or answers yours becomes an entry of the
  * kind [NoticeKind.MENTION], muted chats included. The entry keeps the message (peer, id, topic) so
- * a tap opens it; its JSON has `from` (the sender), and for the Replies chat the copy there
+ * a tap opens it; its JSON has `from` (the sender), `reply`, and for the Replies chat the copy there
  * (`source`, `smsg`). The hooks sit in MessagesController and run on the UI thread.
  */
 object TeleMentions {
@@ -142,7 +142,9 @@ object TeleMentions {
         if (!qualifies(account, dialogId, message, target)) return
         val key = key(target)
         if (!remember(account, key) || TeleNotices.find(account, key) != null) return
-        val extra = JSONObject().put("from", target.from)
+        val extra = JSONObject()
+            .put("from", target.from)
+            .put("reply", isReply(account, message, target))
         if (target.source != 0L) extra.put("source", target.source).put("smsg", target.sourceMsg)
         TeleNotices.add(account, TeleNotice(
             kind = NoticeKind.MENTION,
@@ -221,6 +223,15 @@ object TeleMentions {
         return false
     }
 
+    // an answer to your message, as opposed to a mention by name
+    private fun isReply(account: Int, message: MessageObject, target: Target): Boolean {
+        if (message.replyMessageObject != null) return repliesToSelf(account, message, target)
+        if (textMentionsSelf(account, message)) return false
+        if (target.replies) return true
+        val to = message.messageOwner.reply_to?.reply_to_msg_id ?: 0
+        return to != 0 && message.messageOwner.mentioned && !(target.forum && to.toLong() == target.topic)
+    }
+
     private fun previewOf(message: MessageObject): String {
         val caption = message.caption?.toString().orEmpty()
         val text = caption.ifEmpty { message.messageText?.toString().orEmpty() }.trim()
