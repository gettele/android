         }
     }
 
-    /** A whole text of a script: its own screen, scrollable and selectable. */
     @JvmStatic
     fun text(runtime: ScriptRuntime, options: JSONObject) {
-        val activity = LaunchActivity.instance ?: return
         val title = options.optString("title")
         val text = options.optString("text")
-        // the message menu is still up at this point: let it close, or the new screen goes behind it
         AndroidUtilities.runOnUIThread({
-            try {
-                activity.actionBarLayout?.presentFragment(tele.ui.TeleScriptTextActivity(title, text))
-            } catch (e: Throwable) {
