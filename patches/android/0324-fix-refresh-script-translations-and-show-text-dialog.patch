@@ -63,7 +63,8 @@ object ScriptMessageActions {
         val context = JSONObject()
             .put("chatId", JSONObject().put("\$b", message.getDialogId().toString()))
             .put("messageId", message.getId())
-            .put("text", message.messageText?.toString() ?: "")
+            .put("text", message.caption?.toString() ?: message.messageText?.toString() ?: "")
+            .put("canReplaceText", message.type == MessageObject.TYPE_TEXT || message.type == MessageObject.TYPE_EMOJIS)
             .put("date", message.messageOwner?.date ?: 0)
             .put("out", message.isOut())
         action.runtime.dispatch(action.callback, "message", JSONArray().put(context))
diff --git a/TMessagesProj/src/main/java/tele/scripting/ScriptRuntime.kt b/TMessagesProj/src/main/java/tele/scripting/ScriptRuntime.kt
index d84161816..dd9c3d60d 100644
--- a/TMessagesProj/src/main/java/tele/scripting/ScriptRuntime.kt
+++ b/TMessagesProj/src/main/java/tele/scripting/ScriptRuntime.kt
@@ -455,6 +455,7 @@ class ScriptRuntime(
                     true
                 }
                 "decorate.register" -> {
+                    if (!allows("display", "messages")) throw ScriptException("not-granted", "message decorations need display(messages)")
                     val argsValue = scalar?.toIntOrNull() ?: 0
                     if (!decorators.contains(argsValue)) decorators.add(argsValue)
                     true
@@ -464,16 +465,12 @@ class ScriptRuntime(
                     true
                 }
                 "decorate.message" -> {
+                    if (!allows("display", "messages")) throw ScriptException("not-granted", "message decorations need display(messages)")
                     val argsValue = value ?: throw ScriptException("bad-argument", "decorateMessage needs a target")
                     val peerId = peerIdOf(argsValue.opt("peer"))
-                    if (peerId != 0L) {
-                        val decoration = argsValue.optJSONObject("decoration")
-                        if (decoration == null) {
-                            ScriptDisplay.set(account, id, peerId, argsValue.optLong("id").toInt(), null)
-                        } else {
-                            ScriptDisplay.set(account, id, peerId, argsValue.optLong("id").toInt(), decoration)
-                        }
-                    }
+                    if (peerId == 0L) throw ScriptException("bad-argument", "decorateMessage needs a resolved target peer")
+                    val decoration = argsValue.optJSONObject("decoration")
+                    ScriptDisplay.set(account, id, peerId, argsValue.optLong("id").toInt(), decoration)
                     true
                 }
                 "accounts.list" -> {
@@ -585,7 +582,7 @@ class ScriptRuntime(
             return info(UserConfig.getInstance(account).currentUser)
         }
         if (id < 0) {
-            val raw = -id
+            val raw = -nativePeerId(id)
             val chat = MessagesController.getInstance(account).getChat(raw)
                 ?: MessagesController.getInstance(account).getChat(-raw)
             if (chat != null) return info(chat)
@@ -636,17 +633,26 @@ class ScriptRuntime(
         return result
     }
 
+    private fun longValue(value: Any?): Long = when (value) {
+        is Number -> value.toLong()
+        is String -> value.toLongOrNull() ?: 0L
+        is JSONObject -> value.optString("\$b").toLongOrNull() ?: 0L
+        else -> 0L
+    }
+
+    private fun nativePeerId(id: Long): Long =
+        if (id <= -1000000000000L) id + 1000000000000L else id
+
     private fun peerIdOf(peer: Any?): Long {
-        if (peer !is JSONObject) return 0
-        peer.optString("\$b").toLongOrNull()?.let { return it }
+        if (peer !is JSONObject || peer.has("\$b")) return nativePeerId(longValue(peer))
         return when (peer.optString("_")) {
             "inputPeerSelf" -> UserConfig.getInstance(account).getClientUserId()
-            "inputPeerUser" -> peer.optLong("userId")
-            "inputPeerChat" -> -peer.optLong("chatId")
-            "inputPeerChannel" -> -1000000000000L - peer.optLong("channelId")
-            "peerUser" -> peer.optLong("userId")
-            "peerChat" -> -peer.optLong("chatId")
-            "peerChannel" -> -1000000000000L - peer.optLong("channelId")
+            "inputPeerUser" -> longValue(peer.opt("userId"))
+            "inputPeerChat" -> -longValue(peer.opt("chatId"))
+            "inputPeerChannel" -> -longValue(peer.opt("channelId"))
+            "peerUser" -> longValue(peer.opt("userId"))
+            "peerChat" -> -longValue(peer.opt("chatId"))
+            "peerChannel" -> -longValue(peer.opt("channelId"))
             else -> 0
         }
     }
diff --git a/TMessagesProj/src/main/java/tele/scripting/ScriptUi.kt b/TMessagesProj/src/main/java/tele/scripting/ScriptUi.kt
index 6bc07955a..1a7509fb7 100644
