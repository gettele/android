From: test <test@example.com>
Date: Tue, 10 Nov 2026 00:08:53 +0300
Subject: [PATCH] fix: refresh script translations and show text dialogs

---
 .../org/telegram/messenger/MessageObject.java |  3 ++
 .../main/java/tele/scripting/ScriptDisplay.kt | 43 ++++++++++++++++---
 .../tele/scripting/ScriptMessageActions.kt    |  3 +-
 .../main/java/tele/scripting/ScriptRuntime.kt | 40 +++++++++--------
 .../src/main/java/tele/scripting/ScriptUi.kt  | 21 +++++----
 5 files changed, 77 insertions(+), 33 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/MessageObject.java b/TMessagesProj/src/main/java/org/telegram/messenger/MessageObject.java
index 634101966..6ce360523 100644
--- a/TMessagesProj/src/main/java/org/telegram/messenger/MessageObject.java
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/MessageObject.java
@@ -8243,6 +8243,9 @@ public class MessageObject {
     }
 
     public ArrayList<TLRPC.MessageEntity> getEntities() {
+        if (tele.TeleConfig.SCRIPTING.getValue() && tele.scripting.ScriptDisplay.hasReplacement(this)) {
+            return new ArrayList<>();
+        }
         if (messageOwner == null) return null;
         if (summarized) {
             if (translated && messageOwner.translatedSummaryText != null) {
diff --git a/TMessagesProj/src/main/java/tele/scripting/ScriptDisplay.kt b/TMessagesProj/src/main/java/tele/scripting/ScriptDisplay.kt
index 9373dc596..a037bf107 100644
--- a/TMessagesProj/src/main/java/tele/scripting/ScriptDisplay.kt
+++ b/TMessagesProj/src/main/java/tele/scripting/ScriptDisplay.kt
@@ -21,6 +21,9 @@ object ScriptDisplay {
     private val explicit = ConcurrentHashMap<String, Decoration>()
     private val owners = ConcurrentHashMap<String, String>()
     private val cache = ConcurrentHashMap<String, Decoration?>()
+    private val messages = java.util.Collections.synchronizedMap(java.util.WeakHashMap<MessageObject, Boolean>())
+    private data class Original(val text: CharSequence, val source: String?, val editDate: Int, val translated: Boolean, val summarized: Boolean)
+    private val originals = java.util.WeakHashMap<MessageObject, Original>()
 
     private fun key(account: Int, peerId: Long, messageId: Int) = "$account:$peerId:$messageId"
 
@@ -41,7 +44,7 @@ object ScriptDisplay {
             }
         }
         cache.remove(key)
-        refresh(account)
+        refresh(account, key)
     }
 
     @JvmStatic
@@ -77,14 +80,19 @@ object ScriptDisplay {
 
     @JvmStatic
     fun apply(account: Int, message: MessageObject) {
+        messages[message] = true
+        restore(message)
         if (!TeleConfig.SCRIPTING.value) return
-        val decoration = decoration(account, message) ?: return
-        val text = decoration.text
-        if (text != null) {
-            message.messageText = SpannableStringBuilder(text)
+        val text = decoration(account, message)?.text ?: return
+        synchronized(originals) {
+            originals[message] = Original(message.messageText, message.messageOwner.message, message.messageOwner.edit_date, message.translated, message.summarized)
         }
+        message.messageText = SpannableStringBuilder(text)
     }
 
+    @JvmStatic
+    fun hasReplacement(message: MessageObject): Boolean = synchronized(originals) { originals.containsKey(message) }
+
     @JvmStatic
     fun clearScript(account: Int, script: String) {
         val mine = owners.entries.filter { it.value == script && it.key.startsWith("$account:") }.map { it.key }
@@ -102,9 +110,30 @@ object ScriptDisplay {
         cache.clear()
     }
 
-    private fun refresh(account: Int) {
+    private fun restore(message: MessageObject) {
+        synchronized(originals) {
+            originals.remove(message)?.let {
+                if (message.messageOwner.message == it.source && message.messageOwner.edit_date == it.editDate && message.translated == it.translated && message.summarized == it.summarized) {
+                    message.messageText = it.text
+                }
+            }
+        }
+    }
+
+    private fun refresh(account: Int, target: String? = null) {
         AndroidUtilities.runOnUIThread {
-            NotificationCenter.getInstance(account).postNotificationName(NotificationCenter.updateInterfaces, 0)
+            val loaded = synchronized(messages) { messages.keys.toList() }
+            for (group in loaded.filter { it.currentAccount == account && (target == null || key(account, it.getDialogId(), it.getId()) == target) }.groupBy { it.getDialogId() }) {
+                val updated = ArrayList<MessageObject>()
+                for (message in group.value) {
+                    restore(message)
+                    message.generateLayout(null)
+                    message.forceUpdate = true
+                    message.resetLayout()
+                    updated.add(message)
+                }
+                NotificationCenter.getInstance(account).postNotificationName(NotificationCenter.replaceMessagesObjects, group.key, updated)
+            }
         }
     }
 }
diff --git a/TMessagesProj/src/main/java/tele/scripting/ScriptMessageActions.kt b/TMessagesProj/src/main/java/tele/scripting/ScriptMessageActions.kt
index fa8f5490f..4e88d0e1f 100644
