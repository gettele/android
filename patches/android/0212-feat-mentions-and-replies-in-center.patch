@@ -0,0 +1,273 @@
+package tele.helpers
+
+import android.os.Bundle
+import org.json.JSONObject
+import org.telegram.messenger.ChatObject
+import org.telegram.messenger.DialogObject
+import org.telegram.messenger.FileLog
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.MessageObject
+import org.telegram.messenger.MessagesController
+import org.telegram.messenger.MessagesStorage
+import org.telegram.messenger.R
+import org.telegram.messenger.UserConfig
+import org.telegram.messenger.UserObject
+import org.telegram.messenger.support.LongSparseIntArray
+import org.telegram.tgnet.TLRPC
+import org.telegram.ui.ActionBar.BaseFragment
+import org.telegram.ui.ChatActivity
+import org.telegram.ui.Components.Forum.ForumUtilities
+import tele.TeleConfig
+
+/**
+ * Mentions and replies in the notification center (tele 0232, the badge of 0246 is in the cell).
+ * Every new incoming message of a group that mentions you or answers yours becomes an entry of the
+ * kind [NoticeKind.MENTION], muted chats included. The entry keeps the message (peer, id, topic) so
+ * a tap opens it; its JSON has `from` (the sender), and for the Replies chat the copy there
+ * (`source`, `smsg`). The hooks sit in MessagesController and run on the UI thread.
+ */
+object TeleMentions {
+
+    private const val EDIT_WINDOW = 120
+    private const val MAX_PREVIEW = 300
+    private const val MAX_LOGGED = 2000
+
+    private class Target(
+        val chat: Long,
+        val msg: Int,
+        val topic: Long,
+        val from: Long,
+        val name: String,
+        val source: Long,
+        val sourceMsg: Int,
+        val forum: Boolean,
+        val replies: Boolean
+    )
+
+    // keys given out in this run: an entry deleted by the user does not come back with an edit
+    private val logged = Array(UserConfig.MAX_ACCOUNT_COUNT) { LinkedHashSet<String>() }
+
+    @JvmStatic
+    fun enabled(): Boolean = TeleNotices.enabled() && TeleConfig.NOTICES_MENTIONS.value
+
+    /** Registers the tap action; the entries of an earlier run need it too. */
+    @JvmStatic
+    fun install() {
+        TeleNotices.registerAction(NoticeKind.MENTION, TeleNotices.Action { fragment, account, notice -> open(fragment, account, notice) })
+    }
+
+    /** New messages of a dialog, from MessagesController.updateInterfaceWithMessages. */
+    @JvmStatic
+    fun onNew(account: Int, dialogId: Long, messages: List<MessageObject>?, mode: Int) {
+        if (mode != ChatActivity.MODE_DEFAULT || messages.isNullOrEmpty() || !enabled()) return
+        for (message in messages) {
+            runCatching { log(account, dialogId, message, message.messageOwner.date) }.onFailure { FileLog.e(it) }
+        }
+    }
+
+    /** Edited messages: the text of a logged one follows, a message that now mentions you is logged. */
+    @JvmStatic
+    fun onEdited(account: Int, dialogId: Long, messages: List<MessageObject>?) {
+        if (messages.isNullOrEmpty() || !enabled()) return
+        val now = (System.currentTimeMillis() / 1000L).toInt()
+        for (message in messages) {
+            runCatching {
+                val target = targetOf(account, dialogId, message) ?: return@runCatching
+                val existing = TeleNotices.find(account, key(target))
+                if (existing != null) {
+                    TeleNotices.setText(account, existing.id, previewOf(message))
+                    return@runCatching
+                }
+                val edited = message.messageOwner.edit_date
+                if (edited != 0 && edited >= now - EDIT_WINDOW) log(account, dialogId, message, edited)
+            }.onFailure { FileLog.e(it) }
+        }
+    }
+
+    /** The dialog (or the topic [threadId]) is read up to [maxId]. */
+    @JvmStatic
+    fun onRead(account: Int, dialogId: Long, maxId: Int, threadId: Long) {
+        markRead(account) { notice ->
+            val json = notice.json()
+            val external = json.optLong("source") != 0L
+            val (dialog, id) = where(notice, json)
+            dialog == dialogId && id <= maxId && (external || sameThread(notice.topicId, threadId))
+        }
+    }
+
+    /** Reads of other devices: dialog id to the last read message. */
+    @JvmStatic
+    fun onInboxRead(account: Int, inbox: LongSparseIntArray?) {
+        if (inbox == null || !enabled()) return
+        for (i in 0 until inbox.size()) onRead(account, inbox.keyAt(i), inbox.valueAt(i), 0L)
+    }
+
+    /** The content of messages is read: for a mention this is the moment it is seen. */
+    @JvmStatic
+    fun onContentRead(account: Int, dialogId: Long, ids: List<Int>?) {
+        if (ids.isNullOrEmpty()) return
+        markRead(account) { notice ->
+            val (dialog, id) = where(notice, notice.json())
+            dialog == dialogId && ids.contains(id)
+        }
+    }
+
+    private fun markRead(account: Int, match: (TeleNotice) -> Boolean) {
+        if (!enabled() || TeleNotices.unread(account, NoticeKind.MENTION) == 0) return
+        for (notice in TeleNotices.list(account)) {
+            if (notice.kind == NoticeKind.MENTION && notice.unread && match(notice)) TeleNotices.markRead(account, notice.id)
+        }
+    }
+
+    // the message that tells whether the entry was read: the copy in the Replies chat when there is one
+    private fun where(notice: TeleNotice, json: JSONObject): Pair<Long, Int> {
+        val source = json.optLong("source")
+        return if (source != 0L) source to json.optInt("smsg") else notice.peer to notice.messageId
+    }
+
+    // the General topic reads as no topic
+    private fun sameThread(topic: Long, thread: Long): Boolean = topic == thread || (topic <= 1L && thread <= 1L)
+
+    private fun key(target: Target): String = "mention:${target.chat}:${target.msg}"
+
+    private fun remember(account: Int, key: String): Boolean {
+        val set = logged[account]
+        if (!set.add(key)) return false
+        if (set.size > MAX_LOGGED) set.remove(set.first())
+        return true
+    }
+
+    private fun log(account: Int, dialogId: Long, message: MessageObject, date: Int) {
+        val target = targetOf(account, dialogId, message) ?: return
+        if (!qualifies(account, dialogId, message, target)) return
+        val key = key(target)
+        if (!remember(account, key) || TeleNotices.find(account, key) != null) return
+        val extra = JSONObject().put("from", target.from)
+        if (target.source != 0L) extra.put("source", target.source).put("smsg", target.sourceMsg)
+        TeleNotices.add(account, TeleNotice(
+            kind = NoticeKind.MENTION,
+            date = date,
+            key = key,
+            title = titleOf(account, target),
+            text = previewOf(message),
+            peer = target.chat,
+            messageId = target.msg,
+            topicId = target.topic,
+            extra = extra.toString()
+        ))
+    }
+
+    // where the entry leads; null for the messages that never count: own, service, not of a group
+    private fun targetOf(account: Int, dialogId: Long, message: MessageObject): Target? {
+        val owner = message.messageOwner ?: return null
+        if (message.isOutOwner() || owner is TLRPC.TL_messageService || message.isSponsored() || message.id <= 0) return null
+        val controller = MessagesController.getInstance(account)
+        val self = UserConfig.getInstance(account).getClientUserId()
+        if (UserObject.isReplyUser(dialogId)) {
+            // the Replies chat holds the answers to your comments, forwarded from the discussion
+            val forwarded = owner.fwd_from ?: return null
+            val saved = forwarded.saved_from_peer ?: return null
+            if (forwarded.saved_from_msg_id == 0) return null
+            val from = MessageObject.getPeerId(forwarded.from_id)
+            if (from == self || ignored(account, from)) return null
+            val name = when {
+                from > 0 -> controller.getUser(from)?.let { UserObject.getUserName(it) }
+                from < 0 -> controller.getChat(-from)?.title
+                else -> null
+            } ?: forwarded.from_name.orEmpty()
+            return Target(DialogObject.getPeerDialogId(saved), forwarded.saved_from_msg_id, 0L, from, name, dialogId, message.id, false, true)
+        }
+        if (dialogId >= 0) return null
+        val chat = controller.getChat(-dialogId) ?: return null
+        if (ChatObject.isChannelAndNotMegaGroup(chat) || ChatObject.isMonoForum(chat)) return null
+        val from = message.getFromChatId()
+        if (from == self) return null
+        val name = when {
+            from > 0 -> controller.getUser(from)?.let { UserObject.getUserName(it) }
+            from < 0 -> controller.getChat(-from)?.title
+            else -> null
+        }.orEmpty()
+        val forum = ChatObject.isForum(chat)
+        return Target(dialogId, message.id, if (forum) message.getTopicId() else 0L, from, name, 0L, 0, forum, false)
+    }
+
+    private fun ignored(account: Int, from: Long): Boolean =
+        from != 0L && TeleConfig.IGNORE_USERS.value && PrivacyRules.ignoredMode(account, from) != null
+
+    private fun qualifies(account: Int, dialogId: Long, message: MessageObject, target: Target): Boolean =
+        !PrivacyRules.isMuted(account, dialogId, message) &&
+            (target.replies || message.messageOwner.mentioned || repliesToSelf(account, message, target) || textMentionsSelf(account, message))
+
+    private fun repliesToSelf(account: Int, message: MessageObject, target: Target): Boolean {
+        val to = message.replyMessageObject ?: return false
+        if (target.forum && to.id.toLong() == target.topic) return false
+        return to.isOutOwner() || to.getFromChatId() == UserConfig.getInstance(account).getClientUserId()
+    }
+
+    private fun textMentionsSelf(account: Int, message: MessageObject): Boolean {
+        val owner = message.messageOwner
+        val entities = owner.entities
+        if (entities.isNullOrEmpty()) return false
+        val user = UserConfig.getInstance(account).getCurrentUser() ?: return false
+        val text = owner.message.orEmpty()
+        for (entity in entities) {
+            if (entity is TLRPC.TL_messageEntityMentionName) {
+                if (entity.user_id == user.id) return true
+            } else if (entity is TLRPC.TL_messageEntityMention && entity.length > 1 && entity.offset >= 0 && entity.offset + entity.length <= text.length) {
+                val name = text.substring(entity.offset + 1, entity.offset + entity.length)
+                if (UserObject.hasPublicUsername(user, name)) return true
+            }
+        }
+        return false
+    }
+
+    private fun previewOf(message: MessageObject): String {
+        val caption = message.caption?.toString().orEmpty()
+        val text = caption.ifEmpty { message.messageText?.toString().orEmpty() }.trim()
+        if (text.length <= MAX_PREVIEW) return text
+        val end = if (Character.isHighSurrogate(text[MAX_PREVIEW - 1])) MAX_PREVIEW - 1 else MAX_PREVIEW
+        return text.substring(0, end)
+    }
+
+    private fun nameOf(controller: MessagesController, dialogId: Long): String = when {
+        dialogId > 0 -> controller.getUser(dialogId)?.let { UserObject.getUserName(it) }.orEmpty()
+        dialogId < 0 -> controller.getChat(-dialogId)?.title.orEmpty()
+        else -> ""
+    }
+
+    private fun titleOf(account: Int, target: Target): String {
+        val controller = MessagesController.getInstance(account)
+        var chat = nameOf(controller, target.chat)
+        if (target.topic != 0L) {
+            controller.getTopicsController().findTopic(-target.chat, target.topic)?.title?.let { chat += " \u203A $it" }
+        }
+        return if (target.name.isEmpty()) chat else LocaleController.formatString(R.string.TeleNoticesMentionIn, target.name, chat)
+    }
+
+    // a topic of a forum opens through the topic, like a push does
+    private fun open(fragment: BaseFragment, account: Int, notice: TeleNotice): Boolean {
+        val dialogId = notice.peer
+        if (dialogId == 0L) return false
+        val args = Bundle()
+        if (dialogId < 0) args.putLong("chat_id", -dialogId) else args.putLong("user_id", dialogId)
+        if (notice.messageId != 0) args.putInt("message_id", notice.messageId)
+        val controller = MessagesController.getInstance(account)
+        if (!controller.checkCanOpenChat(args, fragment)) return true
+        val chat = ChatActivity(args)
+        val topicId = notice.topicId
+        if (dialogId < 0 && topicId > 0) {
+            val topics = controller.getTopicsController()
+            if (topics.findTopic(-dialogId, topicId) != null) {
+                ForumUtilities.applyTopic(chat, MessagesStorage.TopicKey.of(dialogId, topicId))
+            } else {
+                topics.loadTopic(-dialogId, topicId) {
+                    ForumUtilities.applyTopic(chat, MessagesStorage.TopicKey.of(dialogId, topicId))
+                    fragment.presentFragment(chat)
+                }
+                return true
+            }
+        }
+        fragment.presentFragment(chat)
+        return true
+    }
+}
