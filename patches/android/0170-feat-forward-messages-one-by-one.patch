diff --git a/TMessagesProj/src/main/java/tele/helpers/ForwardSplit.kt b/TMessagesProj/src/main/java/tele/helpers/ForwardSplit.kt
new file mode 100644
index 000000000..6fa6d0f44
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/ForwardSplit.kt
@@ -0,0 +1,95 @@
+package tele.helpers
+
+import android.os.Handler
+import android.os.Looper
+import org.telegram.messenger.MessageObject
+import org.telegram.tgnet.TLObject
+import org.telegram.tgnet.TLRPC
+import tele.TeleConfig
+
+// forward one by one: split points between requests, and a per-chat runner that waits out flood limits
+object ForwardSplit {
+
+    private const val MAX_FLOOD_WAIT = 300
+    private const val MAX_RETRIES = 3
+
+    private class Entry(val req: TLObject, val run: Runnable) {
+        var retries = 0
+    }
+
+    // account -> dialog -> requests of the forward in flight, head is the one on the wire
+    private val queues = HashMap<Int, HashMap<Long, ArrayDeque<Entry>>>()
+    private val handler = Handler(Looper.getMainLooper())
+
+    // true when the request has to go out right after messages[index]
+    @JvmStatic
+    fun after(messages: List<MessageObject>, index: Int, pending: Int, scheduleDate: Int): Boolean {
+        if (!TeleConfig.FORWARD_ONE_BY_ONE.value || scheduleDate != 0) {
+            return false
+        }
+        val next = messages.getOrNull(index + 1) ?: return false
+        val group = messages[index].messageOwner?.grouped_id ?: 0L
+        // albums stay in one request
+        return group == 0L || group != (next.messageOwner?.grouped_id ?: 0L)
+    }
+
+    // false: the caller sends right away, as stock does
+    @JvmStatic
+    fun enqueue(account: Int, dialogId: Long, scheduleDate: Int, req: TLObject, run: Runnable): Boolean {
+        if (!TeleConfig.FORWARD_ONE_BY_ONE.value || scheduleDate != 0) {
+            return false
+        }
+        val start: Boolean
+        synchronized(queues) {
+            val queue = queues.getOrPut(account) { HashMap() }.getOrPut(dialogId) { ArrayDeque() }
+            queue.addLast(Entry(req, run))
+            start = queue.size == 1
+        }
+        if (start) {
+            run.run()
+        }
+        return true
+    }
+
+    // network thread; true: the request is sent again after a flood wait, skip the stock handling
+    @JvmStatic
+    fun onResult(account: Int, dialogId: Long, req: TLObject, error: TLRPC.TL_error?): Boolean {
+        var retry: Entry? = null
+        var next: Entry? = null
+        var delay = 0L
+        synchronized(queues) {
+            val byDialog = queues[account] ?: return false
+            val queue = byDialog[dialogId] ?: return false
+            val head = queue.firstOrNull()
+            if (head == null || head.req !== req) {
+                return false
+            }
+            val wait = floodWait(error)
+            if (wait in 1..MAX_FLOOD_WAIT && head.retries < MAX_RETRIES) {
+                head.retries++
+                retry = head
+                delay = (wait + 1) * 1000L
+            } else {
+                queue.removeFirst()
+                next = queue.firstOrNull()
+                if (queue.isEmpty()) {
+                    byDialog.remove(dialogId)
+                    if (byDialog.isEmpty()) {
+                        queues.remove(account)
+                    }
+                }
+            }
+        }
+        retry?.let {
+            handler.postDelayed(it.run, delay)
+            return true
+        }
+        next?.let { handler.post(it.run) }
+        return false
+    }
+
+    private fun floodWait(error: TLRPC.TL_error?): Int {
+        val text = error?.text ?: return 0
+        return if (text.startsWith("FLOOD_WAIT_")) text.substring("FLOOD_WAIT_".length).toIntOrNull() ?: 0 else 0
+    }
+}
