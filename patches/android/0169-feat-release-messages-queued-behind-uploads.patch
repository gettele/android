+    /** The message waits in the queue, its bubble shows it. */
+    @JvmStatic
+    fun isHeld(account: Int, dialogId: Long, msgId: Int): Boolean {
+        if (!tele.TeleConfig.QUEUE_BEHIND_MEDIA.value) return false
+        synchronized(held) {
+            val list = held[account]?.get(dialogId) ?: return false
+            return list.any { it.msgId == msgId && !it.cancelled }
+        }
+    }
+
+    /** Held messages that only wait for these uploads: cancelling releases them. */
+    @JvmStatic
+    fun releasedByCancel(account: Int, objects: List<MessageObject>): Int {
+        if (objects.isEmpty() || !tele.TeleConfig.QUEUE_BEHIND_MEDIA.value) return 0
+        val dialogId = objects[0].dialogId
+        val ids = objects.map { it.id }
+        val helper = SendMessagesHelper.getInstance(account)
+        synchronized(held) {
+            val list = held[account]?.get(dialogId) ?: return 0
+            return list.count {
+                !it.cancelled && it.msgId !in ids
+                    && helper.teleHasUploadingMedia(dialogId, it.msgId, it.replyMsgId)
+                    && !helper.teleHasUploadingMedia(dialogId, it.msgId, it.replyMsgId, ids)
+            }
+        }
+    }
+
+    /** Asks first when held messages would be sent by this cancel, else just proceeds. */
+    @JvmStatic
+    fun confirmCancel(fragment: BaseFragment, objects: List<MessageObject>, proceed: Runnable) {
+        val count = releasedByCancel(fragment.currentAccount, objects)
+        val activity = fragment.parentActivity
+        if (count == 0 || activity == null) {
+            proceed.run()
+            return
+        }
+        val dialog = AlertDialog.Builder(activity, fragment.resourceProvider)
+            .setTitle(LocaleController.getString(R.string.TeleStopUploadTitle))
+            .setMessage(LocaleController.formatPluralString("TeleQueuedSentOnStop", count))
+            .setNegativeButton(LocaleController.getString(R.string.Cancel), null)
+            .setPositiveButton(LocaleController.getString(R.string.TeleStopUpload)) { _, _ -> proceed.run() }
+            .create()
+        fragment.showDialog(dialog)
+        dialog.redPositive()
+    }
+
+    /** Same, for views that have no fragment at hand: uses the top one. */
+    @JvmStatic
+    fun confirmCancel(account: Int, objects: List<MessageObject>, proceed: Runnable) {
+        val fragment = LaunchActivity.getSafeLastFragment()
+        if (fragment == null || fragment.currentAccount != account) {
+            proceed.run()
+            return
+        }
+        confirmCancel(fragment, objects, proceed)
+    }
+
+    @JvmStatic
+    fun heldMarker(): CharSequence = LocaleController.getString(R.string.TeleQueuedMarker)
+
+    /** Sends the message now, the upload it waits for keeps going. */
+    @JvmStatic
+    fun releaseNow(account: Int, dialogId: Long, msgId: Int) {
+        val taken = ArrayList<Held>()
+        synchronized(held) {
+            val dialogs = held[account] ?: return
+            val list = dialogs[dialogId] ?: return
+            val it = list.iterator()
+            while (it.hasNext()) {
+                val entry = it.next()
+                if (entry.msgId == msgId && !entry.cancelled) {
+                    taken.add(entry)
+                    it.remove()
+                }
+            }
+            if (list.isEmpty()) dialogs.remove(dialogId)
+            if (dialogs.isEmpty()) held.remove(account)
+        }
+        dispatch(taken)
+    }
+
+    private fun notifyChanged(account: Int, dialogId: Long, msgIds: List<Int>) {
+        if (msgIds.isEmpty()) return
+        handler.post {
+            val fragment: BaseFragment = LaunchActivity.getSafeLastFragment() ?: return@post
+            if (fragment is ChatActivity && fragment.currentAccount == account && fragment.dialogId == dialogId) {
+                for (id in msgIds) fragment.tele_heldChanged(id)
+            }
+        }
+    }
