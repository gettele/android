@@ -0,0 +1,370 @@
+package tele.helpers
+
+import android.text.TextUtils
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.DialogObject
+import org.telegram.messenger.FileLoader
+import org.telegram.messenger.ImageLocation
+import org.telegram.messenger.MessageObject
+import org.telegram.messenger.MessagesController
+import org.telegram.messenger.R
+import org.telegram.messenger.SendMessagesHelper
+import org.telegram.messenger.Utilities
+import org.telegram.tgnet.TLRPC
+import org.telegram.ui.Components.BulletinFactory
+import tele.TeleConfig
+import java.io.File
+
+object ProtectedMessages {
+
+    private enum class Kind {
+        TEXT, PHOTO, VISUAL, FILE, STICKER, VOICE, ROUND, POLL, CONTACT, LOCATION, VENUE
+    }
+
+    @JvmStatic
+    fun enabled(): Boolean {
+        return TeleConfig.COPY_PROTECTED.value
+    }
+
+    @JvmStatic
+    fun peerNoForwards(account: Int, dialogId: Long): Boolean {
+        return !enabled() && MessagesController.getInstance(account).isPeerNoForwards(dialogId)
+    }
+
+    @JvmStatic
+    fun forbidsForward(message: MessageObject): Boolean {
+        return !enabled() && message.messageOwner.noforwards
+    }
+
+    @JvmStatic
+    fun allowsForward(message: MessageObject): Boolean {
+        return message.canForwardMessage() || copyable(message)
+    }
+
+    private fun isProtected(message: MessageObject): Boolean {
+        val account = message.currentAccount
+        return message.messageOwner.noforwards || MessagesController.getInstance(account).isPeerNoForwards(message.getDialogId())
+    }
+
+    private fun copyable(message: MessageObject): Boolean {
+        if (!enabled() || !isProtected(message)) return false
+        if (message.isQuickReply() || message.isSponsored()) return false
+        return message.messageOwner !is TLRPC.TL_message_secret
+    }
+
+    @JvmStatic
+    fun interceptForward(
+        messages: ArrayList<MessageObject>,
+        peer: Long,
+        replyToTopMsg: MessageObject?,
+        hideCaption: Boolean,
+        payStars: Long,
+        notify: Boolean,
+        scheduleDate: Int
+    ): Boolean {
+        if (!enabled() || DialogObject.isEncryptedDialog(peer)) {
+            return false
+        }
+        var taken = false
+        val skipped = ArrayList<String>()
+        val iterator = messages.iterator()
+        while (iterator.hasNext()) {
+            val message = iterator.next()
+            if (message.getId() > 0 && copyable(message)) {
+                taken = true
+                iterator.remove()
+                val kind = classify(message, skipped)
+                if (kind != null) {
+                    sendCopy(message, kind, peer, replyToTopMsg, hideCaption, payStars, notify, scheduleDate)
+                }
+            }
+        }
+        if (taken) {
+            showSkipped(skipped)
+        }
+        return taken
+    }
+
+    private fun classify(message: MessageObject, skipped: MutableList<String>): Kind? {
+        val media = MessageObject.getMedia(message.messageOwner)
+        if (media == null || media is TLRPC.TL_messageMediaWebPage) {
+            return if (TextUtils.isEmpty(message.messageOwner.message)) null else Kind.TEXT
+        }
+        return when (media) {
+            is TLRPC.TL_messageMediaInvoice -> {
+                addSkipped(skipped, "paid media")
+                null
+            }
+            is TLRPC.TL_messageMediaGame -> {
+                addSkipped(skipped, "games")
+                null
+            }
+            is TLRPC.TL_messageMediaStory -> {
+                addSkipped(skipped, "stories")
+                null
+            }
+            is TLRPC.TL_messageMediaPhoto -> {
+                if (media.photo is TLRPC.TL_photo) Kind.PHOTO else {
+                    addSkipped(skipped, "unsupported media")
+                    null
+                }
+            }
+            is TLRPC.TL_messageMediaDocument -> {
+                val document = media.document
+                when {
+                    document == null -> {
+                        addSkipped(skipped, "unsupported media")
+                        null
+                    }
+                    MessageObject.isStickerDocument(document) -> Kind.STICKER
+                    MessageObject.isVoiceDocument(document) -> Kind.VOICE
+                    MessageObject.isRoundVideoDocument(document) -> Kind.ROUND
+                    MessageObject.isVideoDocument(document) || MessageObject.isGifDocument(document) -> Kind.VISUAL
+                    else -> Kind.FILE
+                }
+            }
+            is TLRPC.TL_messageMediaPoll -> {
+                val answers = media.poll.answers
+                if (answers.any { it.media != null } || media.attached_media != null || media.results?.solution_media != null) {
+                    addSkipped(skipped, "polls with media")
+                    null
+                } else if (media.poll.quiz && (media.results?.results?.none { it.correct } != false)) {
+                    addSkipped(skipped, "unanswered quizzes")
+                    null
+                } else {
+                    Kind.POLL
+                }
+            }
+            is TLRPC.TL_messageMediaContact -> Kind.CONTACT
+            is TLRPC.TL_messageMediaGeo -> {
+                if (message.isLiveLocation()) {
+                    addSkipped(skipped, "live locations")
+                    null
+                } else {
+                    Kind.LOCATION
+                }
+            }
+            is TLRPC.TL_messageMediaVenue -> {
+                if (message.isLiveLocation()) {
+                    addSkipped(skipped, "live locations")
+                    null
+                } else {
+                    Kind.VENUE
+                }
+            }
+            else -> {
+                addSkipped(skipped, "unsupported media")
+                null
+            }
+        }
+    }
+
+    private fun addSkipped(skipped: MutableList<String>, reason: String) {
+        if (!skipped.contains(reason)) {
+            skipped.add(reason)
+        }
+    }
+
+    private fun sendCopy(
+        message: MessageObject,
+        kind: Kind,
+        peer: Long,
+        replyToTopMsg: MessageObject?,
+        hideCaption: Boolean,
+        payStars: Long,
+        notify: Boolean,
+        scheduleDate: Int
+    ) {
+        val account = message.currentAccount
+        val media = MessageObject.getMedia(message.messageOwner)
+        val caption = if (hideCaption) "" else message.messageOwner.message ?: ""
+        val entities = if (hideCaption) null else message.messageOwner.entities
+        if (kind == Kind.PHOTO) {
+            val photo = (media as TLRPC.TL_messageMediaPhoto).photo as TLRPC.TL_photo
+            if (photoPath(account, photo) == null) {
+                val size = FileLoader.getClosestPhotoSizeWithSize(photo.sizes, AndroidUtilities.getPhotoSize(true))
+                FileLoader.getInstance(account).loadFile(ImageLocation.getForPhoto(size, photo), message, null, 1, 0)
+            }
+            waitAndSend(60000, { photoPath(account, photo) }) { ready ->
+                sendPhoto(account, photo, ready, peer, replyToTopMsg, caption, entities, media.spoiler, payStars, notify, scheduleDate)
+            }
+            return
+        }
+        if (kind == Kind.FILE || kind == Kind.STICKER || kind == Kind.VOICE || kind == Kind.ROUND || kind == Kind.VISUAL) {
+            val document = (media as TLRPC.TL_messageMediaDocument).document as TLRPC.TL_document
+            if (documentPath(account, document) == null) {
+                FileLoader.getInstance(account).loadFile(document, message, 1, 0)
+            }
+            waitAndSend(60000, { documentPath(account, document) }) { ready ->
+                sendDocument(account, document, ready, peer, replyToTopMsg, caption, entities, media.spoiler, payStars, notify, scheduleDate)
+            }
+            return
+        }
+        val params = SendMessagesHelper.SendMessageParams()
+        params.peer = peer
+        params.replyToTopMsg = replyToTopMsg
+        params.notify = notify
+        params.scheduleDate = scheduleDate
+        params.payStars = payStars
+        params.monoForumPeer = 0
+        params.params = HashMap()
+        params.params.put("tele_nodraft", "1")
+        when (kind) {
+            Kind.TEXT -> {
+                params.message = message.messageOwner.message
+                params.webPage = (media as? TLRPC.TL_messageMediaWebPage)?.webpage
+                params.searchLinks = true
+            }
+            Kind.POLL -> {
+                params.poll = pollCopy(media as TLRPC.TL_messageMediaPoll)
+            }
+            Kind.CONTACT -> {
+                val contact = media as TLRPC.TL_messageMediaContact
+                val user = TLRPC.TL_user()
+                user.id = contact.user_id
+                user.phone = contact.phone_number
+                user.first_name = contact.first_name
+                user.last_name = contact.last_name
+                if (!TextUtils.isEmpty(contact.vcard)) {
+                    val reason = TLRPC.RestrictionReason()
+                    reason.text = contact.vcard
+                    user.restriction_reason.add(reason)
+                }
+                params.user = user
+            }
+            Kind.LOCATION, Kind.VENUE -> {
+                params.location = media
+            }
+            else -> {}
+        }
+        SendMessagesHelper.getInstance(account).sendMessage(params)
+    }
+
+    private fun waitAndSend(timeoutMs: Long, check: () -> String?, send: (String) -> Unit) {
+        val path = check()
+        if (path != null) {
+            send(path)
+            return
+        }
+        if (timeoutMs <= 0) {
+            AndroidUtilities.runOnUIThread {
+                BulletinFactory.global().createSimpleBulletin(R.raw.error, "Could not download media to send copy.").show()
+            }
+            return
+        }
+        AndroidUtilities.runOnUIThread({
+            waitAndSend(timeoutMs - 500, check, send)
+        }, 500)
+    }
+
+    private fun sendPhoto(
+        account: Int,
+        photo: TLRPC.TL_photo,
+        path: String,
+        peer: Long,
+        replyToTopMsg: MessageObject?,
+        caption: String,
+        entities: ArrayList<TLRPC.MessageEntity>?,
+        spoiler: Boolean,
+        payStars: Long,
+        notify: Boolean,
+        scheduleDate: Int
+    ) {
+        val params = SendMessagesHelper.SendMessageParams()
+        params.photo = photo
+        params.path = path
+        params.peer = peer
+        params.replyToTopMsg = replyToTopMsg
+        params.caption = caption
+        params.entities = entities
+        params.hasMediaSpoilers = spoiler
+        params.notify = notify
+        params.scheduleDate = scheduleDate
+        params.payStars = payStars
+        params.monoForumPeer = 0
+        params.params = HashMap()
+        params.params.put("tele_nodraft", "1")
+        SendMessagesHelper.getInstance(account).sendMessage(params)
+    }
+
+    private fun sendDocument(
+        account: Int,
+        document: TLRPC.TL_document,
+        path: String,
+        peer: Long,
+        replyToTopMsg: MessageObject?,
+        caption: String,
+        entities: ArrayList<TLRPC.MessageEntity>?,
+        spoiler: Boolean,
+        payStars: Long,
+        notify: Boolean,
+        scheduleDate: Int
+    ) {
+        val params = SendMessagesHelper.SendMessageParams()
+        params.document = document
+        params.path = path
+        params.peer = peer
+        params.replyToTopMsg = replyToTopMsg
+        params.caption = caption
+        params.entities = entities
+        params.hasMediaSpoilers = spoiler
+        params.notify = notify
+        params.scheduleDate = scheduleDate
+        params.payStars = payStars
+        params.monoForumPeer = 0
+        params.params = HashMap()
+        params.params.put("tele_nodraft", "1")
+        if (MessageObject.isVideoDocument(document) || MessageObject.isGifDocument(document) || MessageObject.isRoundVideoDocument(document)) {
+            params.params.put("tele_force_reupload", "1")
+        }
+        SendMessagesHelper.getInstance(account).sendMessage(params)
+    }
+
+    private fun photoPath(account: Int, photo: TLRPC.TL_photo): String? {
+        if (photo.sizes.isEmpty()) return null
+        val size = FileLoader.getClosestPhotoSizeWithSize(photo.sizes, AndroidUtilities.getPhotoSize(true)) ?: return null
+        val path = FileLoader.getInstance(account).getPathToAttach(size.location, false) ?: return null
+        return if (path.exists() && path.length() > 0) path.absolutePath else null
+    }
+
+    private fun documentPath(account: Int, document: TLRPC.TL_document): String? {
+        val path = FileLoader.getInstance(account).getPathToAttach(document, false) ?: return null
+        return if (path.exists() && path.length() > 0) path.absolutePath else null
+    }
+
+    private fun pollCopy(media: TLRPC.TL_messageMediaPoll): TLRPC.TL_messageMediaPoll {
+        val copy = TLRPC.TL_messageMediaPoll()
+        val poll = TLRPC.TL_poll()
+        poll.id = Utilities.random.nextLong()
+        poll.question = media.poll.question
+        for (answer in media.poll.answers) {
+            val copyAnswer = TLRPC.TL_pollAnswer()
+            copyAnswer.text = answer.text
+            copyAnswer.option = answer.option
+            copyAnswer.media = answer.media
+            copy.poll.answers.add(copyAnswer)
+        }
+        poll.public_voters = media.poll.public_voters
+        poll.multiple_choice = media.poll.multiple_choice
+        poll.quiz = media.poll.quiz
+        poll.shuffle_answers = media.poll.shuffle_answers
+        poll.revoting_disabled = media.poll.revoting_disabled
+        poll.open_answers = media.poll.open_answers
+        copy.poll = poll
+        if (media.results != null && !TextUtils.isEmpty(media.results.solution)) {
+            val results = TLRPC.TL_pollResults()
+            results.solution = media.results.solution
+            results.solution_entities = media.results.solution_entities
+            copy.results = results
+        }
+        return copy
+    }
+
+    private fun showSkipped(skipped: List<String>) {
+        if (skipped.isEmpty()) return
+        val text = "Not copied: " + skipped.joinToString(", ") + "."
+        AndroidUtilities.runOnUIThread {
+            BulletinFactory.global().createSimpleBulletin(R.raw.error, text).show()
+        }
+    }
+}
