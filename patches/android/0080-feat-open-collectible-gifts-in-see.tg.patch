diff --git a/TMessagesProj/src/main/java/tele/helpers/Gifts.kt b/TMessagesProj/src/main/java/tele/helpers/Gifts.kt
index 9c397e4ff..cfca4051a 100644
--- a/TMessagesProj/src/main/java/tele/helpers/Gifts.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/Gifts.kt
@@ -1,6 +1,16 @@
 package tele.helpers
 
+import android.content.Context
+import android.net.Uri
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.View
+import android.widget.TextView
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.browser.Browser
 import org.telegram.tgnet.tl.TL_stars
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Components.LinkSpanDrawable
 import tele.TeleConfig
 
 object Gifts {
@@ -10,4 +20,30 @@ object Gifts {
         is TL_stars.TL_starGiftUnique -> if (TeleConfig.SHOW_GIFT_IDS.value) gift.gift_id else null
         else -> if (TeleConfig.SHOW_REGULAR_GIFT_IDS.value) gift?.id else null
     }
+
+    @JvmStatic
+    fun seeTgView(context: Context, resourcesProvider: Theme.ResourcesProvider?): TextView =
+        LinkSpanDrawable.LinksTextView(context, resourcesProvider).apply {
+            setTextColor(Theme.getColor(Theme.key_dialogTextGray2, resourcesProvider))
+            setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12f)
+            gravity = Gravity.CENTER
+            setLinkTextColor(Theme.getColor(Theme.key_featuredStickers_addButton, resourcesProvider))
+            setPadding(AndroidUtilities.dp(5f), 0, AndroidUtilities.dp(5f), 0)
+            visibility = View.GONE
+        }
+
+    @JvmStatic
+    fun bindSeeTg(view: View?, gift: TL_stars.StarGift?) {
+        val text = view as? TextView ?: return
+        val slug = (gift as? TL_stars.TL_starGiftUnique)?.slug
+        if (!TeleConfig.SEETG_BUTTON.value || slug.isNullOrEmpty()) {
+            text.visibility = View.GONE
+            return
+        }
+        val link = AndroidUtilities.replaceSingleTag("**open in see.tg >**") {
+            Browser.openUrl(text.context, "https://t.me/seetgbot/nft?startapp=" + Uri.encode(slug))
+        }
+        text.text = AndroidUtilities.replaceArrows(link, true)
+        text.visibility = View.VISIBLE
+    }
 }
