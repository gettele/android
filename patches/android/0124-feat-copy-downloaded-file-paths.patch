+            case tele_option_copy_file_path: {
+                String tele_path = teleLocalFilePath(selectedObject);
+                if (tele_path == null) {
+                    BulletinFactory.of(this).createSimpleBulletin(R.raw.error, "The file is not downloaded on this device.").show();
