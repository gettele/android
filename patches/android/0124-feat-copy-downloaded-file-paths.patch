@@ -46573,6 +46584,16 @@ public class ChatActivity extends BaseFragment implements
     private long tele_pressedEmojiId;
     private long tele_menuEmojiId;
 
+    /** The path of a downloaded file of a message, null when the file is not on the device. */
+    private String teleLocalFilePath(MessageObject message) {
+        if (message == null || message.messageOwner == null) return null;
+        if (message.messageOwner.media == null || message.messageOwner.media.document == null) return null;
+        TLRPC.Document document = message.messageOwner.media.document;
+        File file = FileLoader.getInstance(currentAccount).getPathToAttach(document, true);
+        if (file == null || !file.exists()) return null;
+        return file.getAbsolutePath();
+    }
+
     public void fillMessageMenu(
         MessageObject primaryMessage,
 
