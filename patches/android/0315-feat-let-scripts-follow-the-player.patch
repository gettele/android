diff --git a/TMessagesProj/src/main/java/tele/scripting/ScriptPlayer.kt b/TMessagesProj/src/main/java/tele/scripting/ScriptPlayer.kt
new file mode 100644
index 000000000..b491f87c9
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/scripting/ScriptPlayer.kt
@@ -0,0 +1,99 @@
+package tele.scripting
+
+import org.json.JSONArray
+import org.json.JSONObject
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.MediaController
+import org.telegram.messenger.MessageObject
+import org.telegram.messenger.NotificationCenter
+import java.util.concurrent.CopyOnWriteArrayList
+
+/** The app player as the scripts see it: a snapshot of what plays, the controls and the changes. */
+object ScriptPlayer {
+
+    private val listeners = CopyOnWriteArrayList<Pair<ScriptRuntime, Int>>()
+    private var observing = false
+
+    private val delegate = object : NotificationCenter.NotificationCenterDelegate {
+        override fun didReceivedNotification(id: Int, account: Int, vararg args: Any?) {
+            notifyListeners()
+        }
+    }
+
+    @JvmStatic
+    fun current(): JSONObject? {
+        val controller = MediaController.getInstance()
+        val message = controller.getPlayingMessageObject() ?: return null
+        val document = message.getDocument()
+        val seconds = message.getDuration()
+        val playing = controller.isPlayingMessage(message)
+        val type = when {
+            message.isVoice() -> "voice"
+            message.isRoundVideo() -> "video"
+            else -> "song"
+        }
+        return JSONObject()
+            .put("type", type)
+            .put("title", message.getMusicTitle().orEmpty())
+            .put("performer", message.getMusicAuthor().orEmpty())
+            .put("duration", seconds * 1000L)
+            .put("position", (message.audioProgress * seconds * 1000L).toLong())
+            .put("playing", playing)
+            .put("chatId", JSONObject().put("\$b", message.getDialogId().toString()))
+            .put("messageId", message.getId())
+            .put("documentId", JSONObject().put("\$b", (document?.id ?: 0L).toString()))
+    }
+
+    @JvmStatic
+    fun control(action: String): Boolean {
+        AndroidUtilities.runOnUIThread {
+            val controller = MediaController.getInstance()
+            val message = controller.getPlayingMessageObject() ?: return@runOnUIThread
+            when (action) {
+                "play" -> if (!controller.isPlayingMessage(message)) controller.playMessage(message)
+                "pause" -> if (controller.isPlayingMessage(message)) controller.pauseMessage(message)
+                "toggle" -> if (controller.isPlayingMessage(message)) controller.pauseMessage(message) else controller.playMessage(message)
+                "stop" -> controller.cleanup()
+                "next" -> controller.playNextMessage()
+                "previous" -> controller.playPreviousMessage()
+            }
+        }
+        return true
+    }
+
+    @JvmStatic
+    fun listen(runtime: ScriptRuntime, id: Int) {
+        if (listeners.none { it.first === runtime && it.second == id }) {
+            listeners.add(runtime to id)
+        }
+        ensureObserver()
+    }
+
+    @JvmStatic
+    fun unlisten(runtime: ScriptRuntime, id: Int) {
+        listeners.removeAll { it.first === runtime && it.second == id }
+    }
+
+    @JvmStatic
+    fun unregister(runtime: ScriptRuntime) {
+        listeners.removeAll { it.first === runtime }
+    }
+
+    private fun ensureObserver() {
+        if (observing) return
+        observing = true
+        val center = NotificationCenter.getGlobalInstance()
+        center.addObserver(delegate, NotificationCenter.messagePlayingDidStart)
+        center.addObserver(delegate, NotificationCenter.messagePlayingPlayStateChanged)
+        center.addObserver(delegate, NotificationCenter.messagePlayingDidReset)
+    }
+
+    private fun notifyListeners() {
+        if (listeners.isEmpty()) return
+        listeners.removeAll { !it.first.isRunning() }
+        for ((runtime, id) in listeners) {
+            val track = current()
+            runtime.dispatchPlayer(id, track ?: JSONObject.NULL)
+        }
+    }
+}
