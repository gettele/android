From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Mon, 5 Oct 2026 16:26:07 +0300
Subject: [PATCH] feat: gate bot button payloads behind a toggle

show bot button payloads on long press, in the interface section, on by
default since the popover itself is already confirmed working.

Confidence: high
Scope-risk: narrow
---
 .../src/main/java/org/telegram/ui/ChatActivity.java         | 6 +++---
 TMessagesProj/src/main/java/tele/TeleConfig.kt              | 2 ++
 TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt  | 1 +
 3 files changed, 6 insertions(+), 3 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
index 5f61fbe7e..d32a117c5 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
@@ -40398,7 +40398,7 @@ public class ChatActivity extends BaseFragment implements
                 } catch (Exception ignore) {}
                 return;
             }
-            final TL_keyboard.TL_inlineButtonTypeCallback buttonTypeCallback = TLKeyboardHelper.getType(button, TL_keyboard.TL_inlineButtonTypeCallback.class);
+            final TL_keyboard.TL_inlineButtonTypeCallback buttonTypeCallback = tele.TeleConfig.BOT_BUTTON_PAYLOADS.getValue() ? TLKeyboardHelper.getType(button, TL_keyboard.TL_inlineButtonTypeCallback.class) : null;
             if (buttonTypeCallback != null) {
                 tele.TeleHooks.showBotButtonPayload(ChatActivity.this, "callback data", buttonTypeCallback.data == null ? new byte[0] : buttonTypeCallback.data);
                 try {
@@ -40406,12 +40406,12 @@ public class ChatActivity extends BaseFragment implements
                 } catch (Exception ignore) {}
                 return;
             }
-            final TL_keyboard.TL_inlineButtonTypeSwitchInline buttonTypeSwitchInline = TLKeyboardHelper.getType(button, TL_keyboard.TL_inlineButtonTypeSwitchInline.class);
+            final TL_keyboard.TL_inlineButtonTypeSwitchInline buttonTypeSwitchInline = tele.TeleConfig.BOT_BUTTON_PAYLOADS.getValue() ? TLKeyboardHelper.getType(button, TL_keyboard.TL_inlineButtonTypeSwitchInline.class) : null;
             if (buttonTypeSwitchInline != null) {
                 tele.TeleHooks.showBotButtonPayload(ChatActivity.this, "inline query", buttonTypeSwitchInline.query == null ? new byte[0] : buttonTypeSwitchInline.query.getBytes());
                 return;
             }
-            final TL_keyboard.TL_inlineButtonTypeWebView buttonTypeWebView = TLKeyboardHelper.getType(button, TL_keyboard.TL_inlineButtonTypeWebView.class);
+            final TL_keyboard.TL_inlineButtonTypeWebView buttonTypeWebView = tele.TeleConfig.BOT_BUTTON_PAYLOADS.getValue() ? TLKeyboardHelper.getType(button, TL_keyboard.TL_inlineButtonTypeWebView.class) : null;
             if (buttonTypeWebView != null) {
                 tele.TeleHooks.showBotButtonPayload(ChatActivity.this, "web app url", buttonTypeWebView.url == null ? new byte[0] : buttonTypeWebView.url.getBytes());
                 return;
diff --git a/TMessagesProj/src/main/java/tele/TeleConfig.kt b/TMessagesProj/src/main/java/tele/TeleConfig.kt
index fd3494de3..d9abdf119 100644
--- a/TMessagesProj/src/main/java/tele/TeleConfig.kt
+++ b/TMessagesProj/src/main/java/tele/TeleConfig.kt
@@ -104,6 +104,8 @@ object TeleConfig {
     val USERNAME_ALIASES = BoolItem("username_aliases", false)
     @JvmField
     val INLINE_NO_VIA = BoolItem("inline_no_via", false)
+    @JvmField
+    val BOT_BUTTON_PAYLOADS = BoolItem("bot_button_payloads", true)
 
     private var prefs: SharedPreferences? = null
 
diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt
index e06f1e736..8f194b54e 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt
@@ -40,6 +40,7 @@ object TeleSearch {
             section(GUID_INTERFACE + 7, "reveal spoilers automatically", "interface", TeleSettingsActivity.MODE_INTERFACE),
             section(GUID_INTERFACE + 8, "hide mention and reaction badges", "interface", TeleSettingsActivity.MODE_INTERFACE),
             section(GUID_INTERFACE + 9, "turn off animated userpics", "interface", TeleSettingsActivity.MODE_INTERFACE),
+            section(GUID_INTERFACE + 10, "show bot button payloads on long press", "interface", TeleSettingsActivity.MODE_INTERFACE),
 
             section(GUID_PRIVACY, "tele privacy", "privacy", TeleSettingsActivity.MODE_PRIVACY),
             section(GUID_PRIVACY + 1, "hide stories", "privacy", TeleSettingsActivity.MODE_PRIVACY),
