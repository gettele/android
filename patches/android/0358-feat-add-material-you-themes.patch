+            "n2_1000" to android.R.color.system_neutral2_1000
+        )
+    }
+
+    private class Palette(val scheme: DynamicScheme) {
+        val colors = MaterialDynamicColors()
+    }
+
+    @JvmStatic
+    fun resolveToken(token: String?, dark: Boolean, amoled: Boolean): Int? {
+        val raw = token ?: return null
+        val at = raw.indexOf('@')
+        if (at >= 0 && raw.indexOf('@', at + 1) >= 0) return null
+        val base = (if (at >= 0) raw.substring(0, at) else raw).lowercase()
+        if (base.isEmpty()) return null
+        val alpha = if (at >= 0) parseAlpha(raw.substring(at + 1)) ?: return null else null
+        val source = TeleConfig.MATERIAL_SOURCE.value
+        val system = source != "custom" && source != "photo"
+        val palette = palette(system, dark) ?: return null
+        val color = rawTone(base, system, palette) ?: semantic(base, palette) ?: return null
+        val resolved = if (dark && amoled) amoled(base, color) else color
+        return if (alpha == null) resolved else (resolved and 0x00FFFFFF) or (alpha shl 24)
+    }
+
+    @JvmStatic
+    fun photoSeed(context: Context, uri: Uri): Int? {
+        val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
+        runCatching {
+            context.contentResolver.openInputStream(uri)?.use { BitmapFactory.decodeStream(it, null, bounds) }
+        }
+        if (bounds.outWidth <= 0 || bounds.outHeight <= 0) return null
+        var sample = 1
+        while (bounds.outWidth / sample > MAX_PHOTO_DIMENSION || bounds.outHeight / sample > MAX_PHOTO_DIMENSION) {
+            sample *= 2
+        }
+        val options = BitmapFactory.Options().apply {
+            inSampleSize = sample
+            inPreferredConfig = Bitmap.Config.ARGB_8888
+        }
+        val bitmap = runCatching {
+            context.contentResolver.openInputStream(uri)?.use { BitmapFactory.decodeStream(it, null, options) }
+        }.getOrNull() ?: return null
+        return try {
+            seedOf(bitmap)
+        } finally {
+            bitmap.recycle()
+        }
+    }
+
+    private fun parseAlpha(value: String): Int? {
+        if (value.isEmpty() || value.length > 3 || value.any { !it.isDigit() }) return null
+        val percent = value.toIntOrNull() ?: return null
+        if (percent !in 0..100) return null
+        return (percent * 255 + 50) / 100
+    }
+
+    private fun palette(system: Boolean, dark: Boolean): Palette? {
+        val seed = if (system) {
+            systemSignature() ?: return null
+        } else {
+            TeleConfig.MATERIAL_SEED.value.let { if (it == 0) DEFAULT_SEED else it }
+        }
+        synchronized(lock) {
+            if (cachedSystem == system && cachedSeed == seed && cachedDark == dark) {
+                cached?.let { return it }
+            }
+            val scheme = if (system) systemScheme(dark) else SchemeTonalSpot(Hct.fromInt(seed), dark, 0.0)
+            if (scheme == null) {
+                cached = null
+                return null
+            }
+            return Palette(scheme).also {
+                cachedSystem = system
+                cachedSeed = seed
+                cachedDark = dark
+                cached = it
+            }
+        }
+    }
+
+    private fun systemSignature(): Int? {
+        if (Build.VERSION.SDK_INT < 31) return null
+        val accent = systemColor("a1_500") ?: return null
+        val neutral = systemColor("n1_500") ?: return null
+        return accent xor Integer.rotateLeft(neutral, 16)
+    }
+
+    private fun systemScheme(dark: Boolean): DynamicScheme? {
+        if (Build.VERSION.SDK_INT < 31) return null
+        val accent1 = systemColor("a1_500") ?: return null
+        val accent2 = systemColor("a2_500") ?: return null
+        val accent3 = systemColor("a3_500") ?: return null
+        val neutral1 = systemColor("n1_500") ?: return null
+        val neutral2 = systemColor("n2_500") ?: return null
+        val source = systemColor("a1_600") ?: accent1
+        return DynamicScheme(
+            Hct.fromInt(source),
+            Variant.TONAL_SPOT,
+            dark,
+            0.0,
+            TonalPalette.fromHct(Hct.fromInt(accent1)),
+            TonalPalette.fromHct(Hct.fromInt(accent2)),
+            TonalPalette.fromHct(Hct.fromInt(accent3)),
+            TonalPalette.fromHct(Hct.fromInt(neutral1)),
+            TonalPalette.fromHct(Hct.fromInt(neutral2))
+        )
+    }
+
+    private fun systemColor(token: String): Int? {
+        if (Build.VERSION.SDK_INT < 31) return null
+        val id = systemTones[token] ?: return null
+        val context = ApplicationLoader.applicationContext ?: return null
+        return runCatching { context.resources.getColor(id, context.theme) }.getOrNull()
+    }
+
+    private fun rawTone(token: String, system: Boolean, palette: Palette): Int? {
+        if (token.length < 4 || token[2] != '_') return null
+        val family = token.substring(0, 2)
+        val tone = TONES[token.substring(3)] ?: return null
+        if (system) return systemColor(token)
+        val tones = when (family) {
+            "a1" -> palette.scheme.primaryPalette
+            "a2" -> palette.scheme.secondaryPalette
+            "a3" -> palette.scheme.tertiaryPalette
+            "n1" -> palette.scheme.neutralPalette
+            "n2" -> palette.scheme.neutralVariantPalette
+            else -> return null
+        }
+        return tones.tone(tone)
+    }
+
+    private fun semantic(token: String, palette: Palette): Int? {
+        val scheme = palette.scheme
+        val colors = palette.colors
+        return when (token) {
+            "m3_primary" -> colors.primary().getArgb(scheme)
+            "m3_on_primary" -> colors.onPrimary().getArgb(scheme)
+            "m3_primary_container" -> colors.primaryContainer().getArgb(scheme)
+            "m3_on_primary_container" -> colors.onPrimaryContainer().getArgb(scheme)
+            "m3_secondary" -> colors.secondary().getArgb(scheme)
+            "m3_on_secondary" -> colors.onSecondary().getArgb(scheme)
+            "m3_secondary_container" -> colors.secondaryContainer().getArgb(scheme)
+            "m3_on_secondary_container" -> colors.onSecondaryContainer().getArgb(scheme)
+            "m3_tertiary" -> colors.tertiary().getArgb(scheme)
+            "m3_on_tertiary" -> colors.onTertiary().getArgb(scheme)
+            "m3_tertiary_container" -> colors.tertiaryContainer().getArgb(scheme)
+            "m3_on_tertiary_container" -> colors.onTertiaryContainer().getArgb(scheme)
+            "m3_surface" -> colors.surface().getArgb(scheme)
+            "m3_surface_dim" -> colors.surfaceDim().getArgb(scheme)
+            "m3_surface_bright" -> colors.surfaceBright().getArgb(scheme)
+            "m3_surface_container" -> colors.surfaceContainer().getArgb(scheme)
+            "m3_surface_container_low" -> colors.surfaceContainerLow().getArgb(scheme)
+            "m3_surface_container_lowest" -> colors.surfaceContainerLowest().getArgb(scheme)
+            "m3_surface_container_high" -> colors.surfaceContainerHigh().getArgb(scheme)
+            "m3_surface_container_highest" -> colors.surfaceContainerHighest().getArgb(scheme)
+            "m3_on_surface" -> colors.onSurface().getArgb(scheme)
+            "m3_on_surface_variant" -> colors.onSurfaceVariant().getArgb(scheme)
+            "m3_outline" -> colors.outline().getArgb(scheme)
+            "m3_outline_variant" -> colors.outlineVariant().getArgb(scheme)
+            "m3_error" -> colors.error().getArgb(scheme)
+            "m3_on_error" -> colors.onError().getArgb(scheme)
+            "m3_error_container" -> colors.errorContainer().getArgb(scheme)
+            "m3_on_error_container" -> colors.onErrorContainer().getArgb(scheme)
+            "m3_success" -> SUCCESS.tone(if (scheme.isDark) 80 else 40)
+            "m3_on_success" -> SUCCESS.tone(if (scheme.isDark) 20 else 100)
+            else -> null
+        }
+    }
+
+    private fun amoled(token: String, color: Int): Int = when (token) {
+        "m3_surface", "m3_surface_dim", "m3_surface_container_lowest" -> 0xFF000000.toInt()
+        else -> color
+    }
+
+    private fun seedOf(bitmap: Bitmap): Int? {
+        val width = bitmap.width
+        val height = bitmap.height
+        if (width <= 0 || height <= 0) return null
+        val pixels = IntArray(width * height)
+        bitmap.getPixels(pixels, 0, width, 0, 0, width, height)
+        var count = 0
+        for (pixel in pixels) {
+            if (pixel ushr 24 >= 0x80) pixels[count++] = pixel
+        }
+        if (count == 0) return null
+        val quantized = QuantizerCelebi.quantize(pixels.copyOf(count), MAX_PHOTO_COLORS)
+        if (quantized.isEmpty()) return null
+        return Score.score(quantized).firstOrNull()
+    }
+}
