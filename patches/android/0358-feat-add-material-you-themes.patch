+            "n1_10" to android.R.color.system_neutral1_10,
+            "n1_50" to android.R.color.system_neutral1_50,
+            "n1_100" to android.R.color.system_neutral1_100,
+            "n1_200" to android.R.color.system_neutral1_200,
