+        if (enabled) enable() else disable()
+    }
+
+    @JvmStatic
+    fun onThemeSelected(theme: Theme.ThemeInfo?, accentId: Int, nightSlot: Boolean): Boolean {
+        if (!isSupported() || theme == null) return false
+        if (isMaterial(theme)) {
+            if (!TeleConfig.MATERIAL_THEME.value) {
+                TeleConfig.set(TeleConfig.MATERIAL_THEME, true)
+                if (theme.name == NAME_AMOLED) {
+                    TeleConfig.set(TeleConfig.MATERIAL_AMOLED, true)
+                } else if (theme.name == NAME_DARK) {
+                    TeleConfig.set(TeleConfig.MATERIAL_AMOLED, false)
+                }
