+
+    private val NAMES = arrayOf(NAME_LIGHT, NAME_DARK, NAME_AMOLED)
+    private val ASSETS = arrayOf(ASSET_LIGHT, ASSET_DARK, ASSET_AMOLED)
+    private val FINGERPRINT_TOKENS = arrayOf("a1_100", "a2_100", "a3_100", "n1_100", "n2_100")
+
+    private var appliedPalette: Long? = null
+    private var registered = false
+    private var startupPending = false
+    private var wallpaperPending = false
+
+    @JvmStatic
+    fun isSupported(): Boolean = Build.VERSION.SDK_INT >= 31
+
+    @JvmStatic
+    fun isEnabled(): Boolean = isSupported() && TeleConfig.MATERIAL_THEME.value
+
+    @JvmStatic
+    fun isMaterial(theme: Theme.ThemeInfo?): Boolean =
+        theme != null && (theme.name == NAME_LIGHT || theme.name == NAME_DARK || theme.name == NAME_AMOLED)
+
+    @JvmStatic
+    fun hiddenInPickers(theme: Theme.ThemeInfo?): Boolean = !isEnabled() && isMaterial(theme)
+
+    @JvmStatic
+    fun sourceLabel(): String = when (TeleConfig.MATERIAL_SOURCE.value) {
+        SOURCE_CUSTOM -> "Custom color"
+        SOURCE_PHOTO -> "From a photo"
+        else -> "System colors"
+    }
+
+    @JvmStatic
+    fun seedLabel(): String = String.format(java.util.Locale.US, "#%06X", TeleConfig.MATERIAL_SEED.value and 0xFFFFFF)
+
+    @JvmStatic
+    fun register(themes: MutableList<Theme.ThemeInfo>, dict: MutableMap<String, Theme.ThemeInfo>) {
+        if (!isSupported() || registered || dict.containsKey(NAME_LIGHT)) return
+        registered = true
+        NAMES.forEachIndexed { index, name ->
+            val info = Theme.ThemeInfo.tele_new()
+            info.name = name
+            info.assetName = ASSETS[index]
+            info.sortIndex = 6 + index
+            fillPreview(info)
+            themes.add(info)
+            dict[name] = info
+        }
+    }
+
+    @JvmStatic
+    fun fillPreview(info: Theme.ThemeInfo) {
+        val dark = info.name != NAME_LIGHT
+        val amoled = info.name == NAME_AMOLED
+        val background = when {
+            amoled -> 0xff000000.toInt()
+            dark -> 0xff535659.toInt()
+            else -> 0xffebeef4.toInt()
+        }
+        val incoming = when {
+            amoled -> 0xff1c1c1c.toInt()
+            dark -> 0xff747a84.toInt()
+            else -> 0xffffffff.toInt()
+        }
+        val outgoing = when {
+            amoled -> 0xff8ab4f8.toInt()
+            dark -> 0xff75a2e6.toInt()
+            else -> 0xff7cb2fe.toInt()
+        }
+        info.setPreviewBackgroundColor(color("m3_surface_dim", dark, amoled, background))
+        info.setPreviewInColor(color("m3_surface_container_low", dark, amoled, incoming))
+        info.setPreviewOutColor(color("m3_primary", dark, amoled, outgoing))
+    }
+
+    @JvmStatic
+    fun resolveValue(assetName: String?, raw: String?): Int? {
+        if (raw == null) return null
+        val dark: Boolean
+        val amoled: Boolean
+        when (assetName) {
+            ASSET_LIGHT -> {
+                dark = false
+                amoled = false
+            }
+            ASSET_DARK -> {
+                dark = true
+                amoled = false
+            }
+            ASSET_AMOLED -> {
+                dark = true
+                amoled = true
+            }
+            else -> return null
+        }
+        val text = raw.trim()
+        if (text.isEmpty()) return null
+        val at = text.indexOf('@')
+        val base = if (at >= 0) text.substring(0, at) else text
+        if (base.isEmpty()) return null
+        val exact = runCatching { MaterialPalette.resolveToken(text, dark, amoled) }.getOrNull()
+        if (exact != null) return exact
+        val resolved = runCatching { MaterialPalette.resolveToken(base, dark, amoled) }.getOrNull() ?: return null
+        if (at < 0) return resolved
+        val percent = text.substring(at + 1).toIntOrNull() ?: return resolved
+        val alpha = percent.coerceIn(0, 100) * 255 / 100
+        return (resolved and 0x00FFFFFF) or (alpha shl 24)
+    }
+
+    @JvmStatic
+    fun init() {
+        refreshPreviews()
+        if (!isEnabled()) return
+        val material = isMaterial(Theme.getCurrentTheme()) || isMaterial(Theme.getCurrentNightTheme())
+        startupPending = !material
+        if (material) {
+            if (TeleConfig.MATERIAL_WALLPAPER.value) {
+                wallpaperPending = loadMaterialWallpapers()
+            } else {
+                val parked = parkMaterialWallpaper()
+                val legacy = loadMaterialWallpapers()
+                val parkedLegacy = legacy && parkMaterialWallpaper()
+                clearMaterialWallpaper()
+                removeMaterialWallpaperPrefs()
+                wallpaperPending = parked || parkedLegacy
+            }
+        }
+        appliedPalette = fingerprint()
+    }
+
+    @JvmStatic
+    fun onToggle(enabled: Boolean) {
