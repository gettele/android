+            }
+            return true
+        }
+        if (!TeleConfig.MATERIAL_THEME.value) return false
+        abandonTo(theme, accentId, nightSlot)
+        return true
+    }
+
+    @JvmStatic
+    fun onWallpaperChosen() {
+        val active = Theme.getActiveTheme()
+        if (!isEnabled() || !isMaterial(active)) return
+        if (active.overrideWallpaper == null) {
+            TeleConfig.set(TeleConfig.MATERIAL_WALLPAPER, false)
+            removeMaterialWallpaperPrefs()
+        } else {
+            TeleConfig.set(TeleConfig.MATERIAL_WALLPAPER, true)
+        }
+    }
+
+    private fun abandonTo(selected: Theme.ThemeInfo, accentId: Int, nightSlot: Boolean) {
+        if (accentId >= 0) selected.setCurrentAccentId(accentId)
+        EmojiThemes.saveCustomTheme(selected, selected.currentAccentId)
+        val selectedNight = nightSlot || useNight()
+        val day = if (selectedNight) stockDayFallback() ?: selected else selected
+        val night = if (selectedNight) selected else stockNightFallback() ?: selected
+        TeleConfig.set(TeleConfig.MATERIAL_THEME, false)
+        TeleConfig.set(TeleConfig.MATERIAL_WALLPAPER, false)
+        mainPrefs().edit().putString("theme", day.getKey()).putString("nighttheme", night.getKey()).apply()
+        themeConfig().edit().putString("lastDayTheme", day.getKey()).putString("lastDarkTheme", night.getKey()).apply()
+        clearSnapshot()
+        clearMaterialWallpaper()
+        removeMaterialWallpaperPrefs()
+        startupPending = false
+        wallpaperPending = false
+        Theme.tele_applyDayNightThemes(day, night, selectedNight)
+        notifyThemeChange()
+    }
+
+    private fun stockDayFallback(): Theme.ThemeInfo? {
+        val snapshot = themeByKey(TeleConfig.MATERIAL_SNAPSHOT_DAY_KEY.value)
+        if (snapshot != null && !isMaterial(snapshot)) return snapshot
+        return Theme.getTheme("Blue") ?: Theme.getTheme("Day") ?: defaultDay()
+    }
+
+    private fun stockNightFallback(): Theme.ThemeInfo? {
+        val snapshot = themeByKey(TeleConfig.MATERIAL_SNAPSHOT_NIGHT_KEY.value)
+        if (snapshot != null && !isMaterial(snapshot)) return snapshot
+        return Theme.getTheme("Night") ?: Theme.getTheme("Dark Blue") ?: defaultNight()
+    }
+
+    @JvmStatic
+    fun previewItem(account: Int): ChatThemeBottomSheet.ChatThemeItem? {
+        if (!isEnabled()) return null
+        val light = Theme.getTheme(NAME_LIGHT) ?: return null
+        val night = Theme.getTheme(nightName()) ?: return null
+        val chatTheme = EmojiThemes(account)
+        chatTheme.emoji = MATERIAL_EMOJI
+        chatTheme.key = ThemeKey.ofEmoticon(MATERIAL_EMOJI)
+        chatTheme.chatTheme = TLRPC.ChatTheme.ofEmoticon(MATERIAL_EMOJI)
+        chatTheme.items.add(previewEntry(light))
+        chatTheme.items.add(previewEntry(light))
+        chatTheme.items.add(previewEntry(night))
+        chatTheme.items.add(previewEntry(night))
+        chatTheme.loadPreviewColors(account)
+        val item = ChatThemeBottomSheet.ChatThemeItem(chatTheme)
+        item.themeIndex = if (Theme.isCurrentThemeDay()) 0 else 2
+        return item
+    }
+
+    private fun previewEntry(info: Theme.ThemeInfo): EmojiThemes.ThemeItem =
+        EmojiThemes.ThemeItem().apply {
+            themeInfo = info
+            accentId = info.currentAccentId
+        }
+
+    @JvmStatic
+    fun onOptionsChanged() {
+        if (!isSupported()) return
+        refreshPreviews()
+        val active = Theme.getActiveTheme()
+        if (!isEnabled() || !isMaterial(active)) {
+            notifyThemeList()
+            return
+        }
+        val dayTheme = Theme.getCurrentTheme()
+        val nightTheme = Theme.getCurrentNightTheme()
+        val dayMaterial = isMaterial(dayTheme)
+        val nightMaterial = isMaterial(nightTheme)
+        val nightActive = useNight()
+        val day = if (dayMaterial) (Theme.getTheme(NAME_LIGHT) ?: dayTheme) else dayTheme
+        val night = if (nightMaterial) (Theme.getTheme(nightName()) ?: nightTheme) else nightTheme
+        if (day == null || night == null) return
+        applySlots(day, night, nightActive)
+        writeMaterialPrefs(dayMaterial, nightMaterial)
+        appliedPalette = fingerprint()
+        notifyThemeChange()
+    }
+
+    @JvmStatic
+    fun onResume() {
+        if (!isEnabled()) {
+            startupPending = false
+            wallpaperPending = false
+            return
+        }
+        if (startupPending) {
+            startupPending = false
+            if (!isMaterial(Theme.getCurrentTheme()) && !isMaterial(Theme.getCurrentNightTheme())) {
+                enable()
+                return
+            }
+        }
+        if (wallpaperPending) {
+            wallpaperPending = false
+            Theme.reloadWallpaper(false)
+        }
+        if (TeleConfig.MATERIAL_SOURCE.value != SOURCE_SYSTEM) return
+        if (!isMaterial(Theme.getActiveTheme())) return
+        val current = fingerprint() ?: return
+        val previous = appliedPalette
+        appliedPalette = current
+        if (previous == null || previous == current) return
+        Theme.tele_reloadThemeColors()
+        refreshPreviews()
+        notifyThemeChange()
+    }
+
+    @JvmStatic
+    fun setSeed(seed: Int) {
+        TeleConfig.set(TeleConfig.MATERIAL_SEED, seed or 0xFF000000.toInt())
+        TeleConfig.set(TeleConfig.MATERIAL_SOURCE, SOURCE_CUSTOM)
+        onOptionsChanged()
+    }
+
+    @JvmStatic
+    fun seedFromPhoto(uri: Uri, onResult: (Boolean) -> Unit) {
+        val context: Context = ApplicationLoader.applicationContext ?: run {
+            onResult(false)
+            return
+        }
+        Utilities.globalQueue.postRunnable {
+            val seed = runCatching { MaterialPalette.photoSeed(context, uri) }.getOrNull()
+            AndroidUtilities.runOnUIThread {
+                if (seed != null) {
+                    TeleConfig.set(TeleConfig.MATERIAL_SEED, seed)
+                    TeleConfig.set(TeleConfig.MATERIAL_SOURCE, SOURCE_PHOTO)
+                    onOptionsChanged()
+                }
+                onResult(seed != null)
+            }
+        }
+    }
+
+    private fun enable() {
+        val day = Theme.getTheme(NAME_LIGHT) ?: return
+        val night = Theme.getTheme(nightName()) ?: return
+        saveSnapshot()
+        parkActiveWallpaper()
+        clearMaterialWallpaper()
+        removeMaterialWallpaperPrefs()
+        TeleConfig.set(TeleConfig.MATERIAL_WALLPAPER, false)
+        applySlots(day, night, useNight())
+        writeMaterialPrefs(true, true)
+        refreshPreviews()
+        appliedPalette = fingerprint()
+        notifyThemeChange()
+    }
+
+    private fun disable() {
+        val dayTheme = Theme.getCurrentTheme()
+        val nightTheme = Theme.getCurrentNightTheme()
+        val dayMaterial = isMaterial(dayTheme)
+        val nightMaterial = isMaterial(nightTheme)
+        if (!dayMaterial && !nightMaterial) {
+            clearSnapshot()
+            notifyThemeList()
+            return
+        }
+        if (!TeleConfig.MATERIAL_SNAPSHOT_VALID.value) {
+            fallbackToStock()
+            clearSnapshot()
+            notifyThemeChange()
+            return
+        }
+        val nightActive = TeleConfig.MATERIAL_SNAPSHOT_NIGHT_ACTIVE.value
+        val day: Theme.ThemeInfo? = if (dayMaterial) (themeByKey(TeleConfig.MATERIAL_SNAPSHOT_DAY_KEY.value) ?: defaultDay()) else dayTheme
+        val night: Theme.ThemeInfo? = if (nightMaterial) (themeByKey(TeleConfig.MATERIAL_SNAPSHOT_NIGHT_KEY.value) ?: defaultNight()) else nightTheme
+        if (day == null || night == null) {
+            fallbackToStock()
+            clearSnapshot()
+            notifyThemeChange()
+            return
+        }
+        applySlots(day, night, nightActive)
+        restoreAuto()
+        if (dayMaterial) {
+            restoreMainPref("theme", TeleConfig.MATERIAL_SNAPSHOT_THEME.value)
+            restoreThemeConfig("lastDayTheme", TeleConfig.MATERIAL_SNAPSHOT_LAST_DAY.value)
+        }
+        if (nightMaterial) {
+            restoreMainPref("nighttheme", TeleConfig.MATERIAL_SNAPSHOT_NIGHT_THEME.value)
+            restoreThemeConfig("lastDarkTheme", TeleConfig.MATERIAL_SNAPSHOT_LAST_NIGHT.value)
+        }
+        TeleConfig.set(TeleConfig.MATERIAL_WALLPAPER, false)
+        clearMaterialWallpaper()
+        removeMaterialWallpaperPrefs()
+        wallpaperPending = false
+        clearSnapshot()
+        notifyThemeChange()
+    }
+
+    private fun fallbackToStock() {
+        val nightActive = Theme.getActiveTheme() === Theme.getCurrentNightTheme()
+        applySlots(defaultDay() ?: return, defaultNight() ?: defaultDay() ?: return, nightActive)
+        TeleConfig.set(TeleConfig.MATERIAL_WALLPAPER, false)
+        clearMaterialWallpaper()
+        removeMaterialWallpaperPrefs()
+        mainPrefs().edit().remove("theme").remove("nighttheme").apply()
+        themeConfig().edit().remove("lastDayTheme").remove("lastDarkTheme").apply()
+    }
+
+    private fun applySlots(day: Theme.ThemeInfo, night: Theme.ThemeInfo, nightActive: Boolean) {
+        Theme.tele_applyDayNightThemes(day, night, nightActive)
+    }
+
+    private fun useNight(): Boolean =
+        Theme.isCurrentThemeNight() || Theme.getActiveTheme()?.isDark() == true
+
+    private fun parkActiveWallpaper() {
+        val wallpaper = Theme.getActiveTheme()?.overrideWallpaper ?: return
+        parkWallpaper(wallpaper)
+    }
+
+    private fun parkMaterialWallpaper(): Boolean {
+        val day = Theme.getTheme(NAME_LIGHT)
+        val night = Theme.getTheme(nightName()) ?: Theme.getTheme(NAME_DARK)
+        val wallpaper = day?.overrideWallpaper ?: night?.overrideWallpaper ?: return false
+        parkWallpaper(wallpaper)
+        return true
+    }
+
+    private fun parkWallpaper(wallpaper: Theme.OverrideWallpaperInfo) {
+        val targets = ArrayList<Theme.ThemeInfo>()
+        for (key in arrayOf(TeleConfig.MATERIAL_SNAPSHOT_DAY_KEY.value, TeleConfig.MATERIAL_SNAPSHOT_NIGHT_KEY.value)) {
+            val target = themeByKey(key) ?: continue
+            if (isMaterial(target)) continue
+            if (targets.any { it === target }) continue
+            targets.add(target)
+            if (target.overrideWallpaper == null) target.setOverrideWallpaper(wallpaper)
+        }
+    }
+
+    private fun clearMaterialWallpaper() {
+        for (name in NAMES) {
+            val info = Theme.getTheme(name) ?: continue
+            info.overrideWallpaper = null
+        }
+    }
+
+    private fun removeMaterialWallpaperPrefs() {
+        val editor = themeConfig().edit()
+        for (name in NAMES) {
+            editor.remove(name + "_owp")
+        }
+        editor.apply()
+    }
+
+    private fun saveSnapshot() {
+        TeleConfig.set(TeleConfig.MATERIAL_SNAPSHOT_VALID, true)
+        TeleConfig.set(TeleConfig.MATERIAL_SNAPSHOT_THEME, mainPrefs().getString("theme", "").orEmpty())
+        TeleConfig.set(TeleConfig.MATERIAL_SNAPSHOT_NIGHT_THEME, mainPrefs().getString("nighttheme", "").orEmpty())
+        TeleConfig.set(TeleConfig.MATERIAL_SNAPSHOT_LAST_DAY, themeConfig().getString("lastDayTheme", "").orEmpty())
+        TeleConfig.set(TeleConfig.MATERIAL_SNAPSHOT_LAST_NIGHT, themeConfig().getString("lastDarkTheme", "").orEmpty())
+        TeleConfig.set(TeleConfig.MATERIAL_SNAPSHOT_DAY_KEY, Theme.getCurrentTheme()?.getKey() ?: "Blue")
+        TeleConfig.set(TeleConfig.MATERIAL_SNAPSHOT_NIGHT_KEY, Theme.getCurrentNightTheme()?.getKey() ?: "Dark Blue")
+        TeleConfig.set(TeleConfig.MATERIAL_SNAPSHOT_AUTO, Theme.selectedAutoNightType)
+        TeleConfig.set(TeleConfig.MATERIAL_SNAPSHOT_NIGHT_ACTIVE, Theme.getActiveTheme() === Theme.getCurrentNightTheme())
+    }
+
+    private fun restoreAuto() {
+        val type = TeleConfig.MATERIAL_SNAPSHOT_AUTO.value
+        if (type < 0) return
+        Theme.selectedAutoNightType = type
+        Theme.saveAutoNightThemeConfig()
+    }
+
+    private fun writeMaterialPrefs(day: Boolean, night: Boolean) {
+        val main = mainPrefs().edit()
+        if (day) main.putString("theme", NAME_LIGHT)
+        if (night) main.putString("nighttheme", nightName())
+        main.apply()
+        val config = themeConfig().edit()
+        if (day) config.putString("lastDayTheme", NAME_LIGHT)
+        if (night) config.putString("lastDarkTheme", nightName())
+        config.apply()
+    }
+
+    private fun restoreMainPref(key: String, value: String) {
+        val editor = mainPrefs().edit()
+        if (value.isEmpty()) editor.remove(key) else editor.putString(key, value)
+        editor.apply()
+    }
+
+    private fun restoreThemeConfig(key: String, value: String) {
+        val editor = themeConfig().edit()
+        if (value.isEmpty()) editor.remove(key) else editor.putString(key, value)
+        editor.apply()
+    }
+
+    private fun clearSnapshot() {
+        TeleConfig.set(TeleConfig.MATERIAL_SNAPSHOT_VALID, false)
+    }
+
+    private fun fingerprint(): Long? {
+        val dark = Theme.getActiveTheme()?.isDark() == true
+        val amoled = dark && TeleConfig.MATERIAL_AMOLED.value
+        var hash = 1125899906842597L
+        for (token in FINGERPRINT_TOKENS) {
+            val value = runCatching { MaterialPalette.resolveToken(token, dark, amoled) }.getOrNull() ?: return null
+            hash = hash * 31 + value
+        }
+        return hash
+    }
+
+    private fun refreshPreviews() {
+        for (name in NAMES) Theme.getTheme(name)?.let { fillPreview(it) }
+    }
+
+    private fun loadMaterialWallpapers(): Boolean {
+        var loaded = false
+        val config = themeConfig()
+        for (name in NAMES) {
+            val info = Theme.getTheme(name) ?: continue
+            info.tele_loadWallpapers(config)
+            if (info.overrideWallpaper != null) loaded = true
+        }
+        return loaded
+    }
+
+    private fun notifyThemeList() {
+        NotificationCenter.getGlobalInstance().postNotificationName(NotificationCenter.themeListUpdated)
+    }
+
+    private fun notifyThemeChange() {
+        notifyThemeList()
+        AndroidUtilities.runOnUIThread {
+            LaunchActivity.instance?.actionBarLayout?.rebuildAllFragmentViews(true, true)
+        }
+    }
+
+    private fun color(token: String, dark: Boolean, amoled: Boolean, fallback: Int): Int =
+        runCatching { MaterialPalette.resolveToken(token, dark, amoled) }.getOrNull() ?: fallback
+
+    private fun nightName(): String = if (TeleConfig.MATERIAL_AMOLED.value) NAME_AMOLED else NAME_DARK
+
+    private fun themeByKey(key: String): Theme.ThemeInfo? {
+        if (key.isEmpty()) return null
+        val direct = Theme.getTheme(key)
+        if (direct != null) return direct
+        return when (key) {
+            "Default" -> Theme.getTheme("Blue")
+            "Dark" -> Theme.getTheme("Dark Blue")
+            else -> null
+        }
+    }
+
+    private fun defaultDay(): Theme.ThemeInfo? = Theme.getTheme("Blue")
+
+    private fun defaultNight(): Theme.ThemeInfo? = Theme.getTheme("Dark Blue")
+
+    private fun mainPrefs() = MessagesController.getGlobalMainSettings()
+
+    private fun themeConfig() = ApplicationLoader.applicationContext.getSharedPreferences("themeconfig", Context.MODE_PRIVATE)
+}
