diff --git a/TMessagesProj/src/main/java/tele/helpers/TeleBadges.kt b/TMessagesProj/src/main/java/tele/helpers/TeleBadges.kt
new file mode 100644
index 000000000..1e3c974f1
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/TeleBadges.kt
@@ -0,0 +1,33 @@
+package tele.helpers
+
+import android.util.Log
+import com.lambdapioneer.argon2kt.Argon2Kt
+import com.lambdapioneer.argon2kt.Argon2Mode
+import com.lambdapioneer.argon2kt.Argon2Version
+import java.util.Base64
+
+object TeleBadges {
+    private val argon2 = Argon2Kt()
+
+    @JvmStatic
+    fun key(scope: String, id: Long, salt: ByteArray,
+            passes: Int = 1, memoryKiB: Int = 8192, lanes: Int = 1,
+            hashLen: Int = 16): String {
+        val password = "$scope:$id".toByteArray(Charsets.UTF_8)
+        val result = argon2.hash(Argon2Mode.ARGON2_ID, password, salt, passes, memoryKiB, lanes, hashLen, Argon2Version.V13)
+        val raw = result.rawHashAsByteArray()
+        return Base64.getUrlEncoder().withoutPadding().encodeToString(raw)
+    }
+
+    @JvmStatic
+    fun verifySelfCheck(): Boolean {
+        val salt = ByteArray(16) { it.toByte() }
+        val computed = key("prod", 777000L, salt, 1, 8192, 1, 16)
+        val expected = "iguxbtP_SnLvK69aBff2OQ"
+        val channel = key("prod", -1001234567890L, salt, 1, 8192, 1, 16)
+        val expectedChannel = "w5Zbi-HfwlqkJ6S4wjwqcw"
+        val ok = computed == expected && channel == expectedChannel
+        Log.i("TeleBadges", "self-check: $ok (user=$computed channel=$channel)")
+        return ok
+    }
+}
diff --git a/TMessagesProj/src/main/java/tele/helpers/TeleServer.kt b/TMessagesProj/src/main/java/tele/helpers/TeleServer.kt
index 4f2cb8505..1655601b7 100644
--- a/TMessagesProj/src/main/java/tele/helpers/TeleServer.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/TeleServer.kt
@@ -4,6 +4,7 @@ import android.content.Context
 import org.telegram.messenger.ApplicationLoader
 import org.telegram.messenger.FileLog
 import tele.TeleConfig
+import tele.helpers.TeleBadges
 import java.io.File
 import java.net.HttpURLConnection
 import java.net.URL
@@ -32,6 +33,7 @@ object TeleServer {
     @JvmStatic
     fun start(context: Context) {
         if (!isEnabled()) return
+        TeleBadges.verifySelfCheck()
         fetchAsync(context)
     }
 
