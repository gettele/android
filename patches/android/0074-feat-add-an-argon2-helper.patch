 import java.net.URL
@@ -32,6 +33,7 @@ object TeleServer {
     @JvmStatic
     fun start(context: Context) {
         if (!isEnabled()) return
+        TeleBadges.verifySelfCheck()
         fetchAsync(context)
     }
 
@@ -50,6 +52,10 @@ object TeleServer {
                     val body = connection.inputStream.bufferedReader().use { it.readText() }
                     cachedFile(context).writeText(body)
                     FileLog.d("TeleServer: fetched ${body.length} bytes")
+                    if (TeleBadges.loadFromJson(body)) {
+                        val account = org.telegram.messenger.UserConfig.selectedAccount
+                        android.os.Handler(android.os.Looper.getMainLooper()).post { TeleBadges.apply(account) }
+                    }
                 } else {
                     FileLog.e("TeleServer: HTTP ${connection.responseCode}")
                 }
