+package tele.ui
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Paint
+import android.graphics.RectF
+import android.text.TextPaint
+import android.text.TextUtils
+import android.view.View
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.ui.ActionBar.Theme
+import tele.helpers.GiftStudio
+
+/**
+ * The pill of the rarity of a part (desktop 0248): the name of the tier in the color of the tier,
+ * or the permille of the part when it has no tier.
+ */
+class RarityPillView(context: Context) : View(context) {
+
+    private val paint = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val textPaint = TextPaint(Paint.ANTI_ALIAS_FLAG)
+    private val rect = RectF()
+
+    private var text = ""
+    private var color = 0
+
+    init {
+        textPaint.textSize = AndroidUtilities.dp(12f)
+    }
+
+    /** The text of the pill and the color of it; a color of zero is the color of the text. */
+    fun setPill(text: String, color: Int) {
+        this.text = text
+        this.color = color
+        requestLayout()
+        invalidate()
+    }
+
+    /** The pill of a part of the studio. */
+    fun setPart(part: GiftStudio.Part?) {
+        if (part == null) {
+            setPill("", 0)
+            return
+        }
+        val tier = GiftStudio.tierText(part.tier)
+        if (tier.isNotEmpty()) {
+            setPill(tier, GiftStudio.rarityColor(part.tier))
+            return
+        }
+        setPill(GiftStudio.rarityText(part.permille), 0)
+    }
+
+    override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
+        val padding = AndroidUtilities.dp(10f)
+        val width = if (text.isEmpty()) 0 else (textPaint.measureText(text) + padding * 2).toInt()
+        val height = AndroidUtilities.dp(22f)
+        setMeasuredDimension(width, height)
+    }
+
+    override fun onDraw(canvas: Canvas) {
+        if (text.isEmpty()) return
+        val fill = if (color == 0) {
+            Theme.getColor(Theme.key_windowBackgroundWhite)
+        } else {
+            (color and 0x00FFFFFF) or (0x26 shl 24)
+        }
+        paint.color = fill
+        rect.set(0f, 0f, width.toFloat(), height.toFloat())
+        canvas.drawRoundRect(rect, height / 2f, height / 2f, paint)
+        textPaint.color = if (color == 0) {
+            Theme.getColor(Theme.key_windowBackgroundWhiteGrayText)
+        } else {
+            color
+        }
+        val baseline = (height - (textPaint.descent() + textPaint.ascent())) / 2f
+        canvas.drawText(text, (width - textPaint.measureText(text)) / 2f, baseline, textPaint)
+    }
+}
