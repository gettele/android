+            fun of(name: String?): Tier {
+                return when (name?.trim()?.lowercase()) {
+                    "uncommon" -> UNCOMMON
+                    "rare" -> RARE
+                    "epic" -> EPIC
+                    "legendary" -> LEGENDARY
+                    else -> DEFAULT
