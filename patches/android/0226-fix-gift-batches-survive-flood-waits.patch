+++ b/TMessagesProj/src/main/java/tele/helpers/GiftBatch.kt
@@ -0,0 +1,264 @@
+package tele.helpers
+
+import android.os.SystemClock
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.R
+import org.telegram.tgnet.ConnectionsManager
+import org.telegram.tgnet.RequestDelegate
+import org.telegram.tgnet.TLObject
+import org.telegram.tgnet.TLRPC
+
+/**
+ * Runs an action over gifts one by one (desktop 0213): it waits out `FLOOD_WAIT` of Telegram and goes
+ * on, skips the items the server refuses, reports the progress and can be stopped. The steps send their
+ * requests through [Run.send], which hands rate limits to the runner instead of the network layer. All
+ * the calls are on the UI thread.
+ */
+object GiftBatch {
+
+    private const val TICK = 250L
+    private const val FLOOD = "FLOOD_WAIT_"
+
+    /**
+     * Why a step failed. [text] is the error type of the server. [unknown]: a payment was sent and its
+     * result never came, so the gift may have gone through; the batch stops and nothing is repeated.
+     */
+    class Failure(@JvmField val text: String, @JvmField val unknown: Boolean = false) {
+        companion object {
+            /** A server answer (4xx) means nothing was done; anything else after a payment may have been. */
+            @JvmStatic
+            fun of(error: TLRPC.TL_error?, fallback: String, afterPayment: Boolean): Failure {
+                val text = error?.text?.takeIf { it.isNotEmpty() } ?: fallback
+                return Failure(text, afterPayment && (error == null || error.code !in 400..499))
+            }
+        }
+    }
+
+    class Progress(@JvmField val index: Int, /** Seconds of a rate limit that is being waited out, else 0. */ @JvmField val wait: Int)
+
+    class Result(
+        @JvmField val done: Int,
+        /** Indexes of the items the server refused, and why. */
+        @JvmField val skipped: List<Int>,
+        @JvmField val errors: List<String>,
+        /** The reason the batch stopped before its end; the item [next] is the one that failed. */
+        @JvmField val failure: Failure?,
+        @JvmField val cancelled: Boolean,
+        /** The first item that was not processed: the rest were left alone. */
+        @JvmField val next: Int
+    ) {
+        /** The items that are not done: refused, failed and not reached. */
+        fun left(total: Int): List<Int> = skipped + (next until total)
+    }
+
+    class Job(
+        @JvmField val account: Int,
+        @JvmField val total: Int,
+        /** A refused item is skipped and the run goes on; otherwise the first refusal stops it. */
+        @JvmField val skipFailed: Boolean,
+        /** Asked between the steps and while a rate limit is waited out: false cancels the run. */
+        @JvmField val alive: () -> Boolean,
+        /** Does the work of one item and calls `done` once: null on success. */
+        @JvmField val step: (index: Int, run: Run, done: (Failure?) -> Unit) -> Unit,
+        @JvmField val progress: (Progress) -> Unit,
+        @JvmField val finished: (Result) -> Unit
+    )
+
+    @JvmStatic
+    fun start(job: Job): Run {
+        val run = Run(job)
+        run.next()
+        return run
+    }
+
+    class Run internal constructor(private val job: Job) {
+        private var index = 0
+        private var stepId = 0
+        private var running = false
+        private var finished = false
+        private var done = 0
+        private val skipped = ArrayList<Int>()
+        private val errors = ArrayList<String>()
+        private var failure: Failure? = null
+        private var cancelled = false
+        private var waitTill = 0L
+        private var shown = -1
+        private var resend: Runnable? = null
+        private val ticker = Runnable { tick() }
+
+        /**
+         * Sends a request of the step. A rate limit is answered by the server before anything is done, so
+         * the same request is sent again once the wait is over; every other answer goes to [callback].
+         */
+        fun send(request: TLObject, callback: (TLObject?, TLRPC.TL_error?) -> Unit) {
+            val id = stepId
+            ConnectionsManager.getInstance(job.account).sendRequest(request, RequestDelegate { response, error ->
+                AndroidUtilities.runOnUIThread {
+                    if (finished || id != stepId) return@runOnUIThread
+                    val seconds = floodSeconds(error)
+                    if (seconds > 0) {
+                        TeleFloodWait.report(job.account, request, seconds)
+                        waitOut(seconds) { send(request, callback) }
+                    } else {
+                        callback(response, error)
+                    }
+                }
+            }, ConnectionsManager.RequestFlagDoNotWaitFloodWait)
+        }
+
+        internal fun next() {
+            if (finished) return
+            if (index >= job.total) {
+                finish()
+                return
+            } else if (!job.alive()) {
+                cancel()
+                return
+            }
+            running = true
+            val id = ++stepId
+            report()
+            job.step(index, this) { failure -> stepDone(id, failure) }
+        }
+
+        private fun stepDone(id: Int, failure: Failure?) {
+            if (finished || id != stepId || !running) return
+            running = false
+            clearWait()
+            if (failure == null) {
+                done++
+            } else if (failure.unknown || !job.skipFailed) {
+                this.failure = failure
+                finish()
+                return
+            } else {
+                skipped.add(index)
+                errors.add(failure.text)
+            }
+            index++
+            next()
+        }
+
+        private fun waitOut(seconds: Int, then: Runnable) {
+            resend = then
+            waitTill = SystemClock.elapsedRealtime() + seconds * 1000L
+            AndroidUtilities.cancelRunOnUIThread(ticker)
+            AndroidUtilities.runOnUIThread(ticker, TICK)
+            report()
+        }
+
+        private fun tick() {
+            if (finished) return
+            if (!job.alive()) {
+                cancel()
+            } else if (SystemClock.elapsedRealtime() >= waitTill) {
+                val again = resend
+                clearWait()
+                again?.run()
+            } else {
+                report()
+                AndroidUtilities.runOnUIThread(ticker, TICK)
+            }
+        }
+
+        private fun clearWait() {
+            AndroidUtilities.cancelRunOnUIThread(ticker)
+            resend = null
+            if (waitTill != 0L) {
+                waitTill = 0L
+                report()
+            }
+        }
+
+        private fun report() {
+            if (finished) return
+            val left = if (waitTill != 0L) waitTill - SystemClock.elapsedRealtime() else 0L
+            val wait = ((maxOf(left, 0L) + 999L) / 1000L).toInt()
+            if (shown == wait && wait > 0) return
+            shown = wait
+            job.progress(Progress(index, wait))
+        }
+
+        private fun cancel() {
+            if (finished) return
+            cancelled = true
+            finish()
+        }
+
+        private fun finish() {
+            if (finished) return
+            finished = true
+            AndroidUtilities.cancelRunOnUIThread(ticker)
+            resend = null
+            job.finished(Result(done, skipped, errors, failure, cancelled, index))
+        }
+
+        private fun floodSeconds(error: TLRPC.TL_error?): Int {
+            val text = error?.text
+            if (error == null || error.code != 420 || text == null || !text.startsWith(FLOOD)) return 0
+            return text.substring(FLOOD.length).toIntOrNull()?.takeIf { it > 0 } ?: 2
+        }
+    }
+
+    /** "12 m 5 s" and the like. */
+    @JvmStatic
+    fun waitText(seconds: Int): String = TeleFloodWait.duration(seconds)
+
+    /** The status of a run: "2 of 7", and the wait of a rate limit when there is one. */
+    @JvmStatic
+    fun progressText(progress: Progress, total: Int): String {
+        val text = LocaleController.formatString(R.string.TeleGiftsProgress, progress.index + 1, total)
+        return if (progress.wait > 0) LocaleController.formatString(R.string.TeleGiftsBatchWaiting, text, waitText(progress.wait)) else text
+    }
+
+    /** Words for an error type of the server; unknown types are shown as they are. */
+    @JvmStatic
+    fun reason(type: String?): String = when {
+        type.isNullOrEmpty() -> LocaleController.getString(R.string.TeleGiftsFailed)
+        type == "STARGIFT_USAGE_LIMITED" -> LocaleController.getString(R.string.Gift2SoldOutTitle)
+        type == "STARGIFT_USER_USAGE_LIMITED" -> LocaleController.getString(R.string.TeleGiftsErrorUserLimit)
+        type == "USER_DISALLOWED_STARGIFTS" -> LocaleController.getString(R.string.TeleGiftsErrorRestricted)
+        type == "STARGIFT_MESSAGE_INVALID" -> LocaleController.getString(R.string.TeleGiftsErrorMessage)
+        type == "STARGIFT_ALREADY_BURNED" -> LocaleController.getString(R.string.UniqueGiftNotFoundBurned)
+        type.startsWith("STARGIFT_TRANSFER_TOO_EARLY_") -> LocaleController.getString(R.string.TeleGiftsErrorTransferEarly)
+        type.startsWith("STARGIFT_RESELL_TOO_EARLY_") -> LocaleController.getString(R.string.TeleGiftsErrorSellEarly)
+        else -> type
+    }
+
+    /** A failure as a sentence; a payment of an unknown result tells to check the balance. */
+    @JvmStatic
+    fun describe(failure: Failure): String {
+        val text = reason(failure.text)
+        return if (failure.unknown && failure.text != "BALANCE_TOO_LOW") {
+            text + " " + LocaleController.getString(R.string.TeleGiftsCheckBalance)
+        } else {
+            text
+        }
+    }
+
+    /** What to tell the user when the run of [total] items is over; [success] when everything went well. */
+    @JvmStatic
+    fun summary(result: Result, total: Int, success: String): String {
+        val reasons = ArrayList<String>()
+        for (error in result.errors) {
+            val reason = reason(error)
+            if (!reasons.contains(reason)) reasons.add(reason)
+        }
+        val skipped = result.skipped.size
+        val skips = if (skipped > 0) LocaleController.formatString(R.string.TeleGiftsBatchSkipped, skipped, reasons.joinToString("; ")) else ""
+        val failure = result.failure
+        return when {
+            result.cancelled -> {
+                val text = LocaleController.formatString(R.string.TeleGiftsBatchCancelled, result.done + skipped, total)
+                if (skips.isEmpty()) text else "$text $skips"
+            }
+            failure != null -> {
+                val text = LocaleController.formatString(R.string.TeleGiftsBatchStopped, result.done, total, describe(failure))
+                if (skips.isEmpty()) text else "$text $skips"
+            }
+            skipped > 0 -> LocaleController.formatString(R.string.TeleGiftsBatchDone, result.done, skips)
+            else -> success
+        }
+    }
+}
