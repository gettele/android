diff --git a/TMessagesProj/src/main/java/tele/helpers/TeleLowercase.kt b/TMessagesProj/src/main/java/tele/helpers/TeleLowercase.kt
new file mode 100644
index 000000000..29a589a22
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/TeleLowercase.kt
@@ -0,0 +1,90 @@
+package tele.helpers
+
+import java.util.Locale
+import java.util.concurrent.ConcurrentHashMap
+import java.util.regex.Pattern
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.NotificationCenter
+import tele.TeleConfig
+
+// lowercase interface (tele 0022/0035): language pack templates and tele's own texts, never user data
+object TeleLowercase {
+
+    // format specifiers, markup, entities, @mentions and links stay as they are
+    private val KEEP: Pattern = Pattern.compile(
+        "%(?:\\d+\\$)?[-#+ 0,(<]*\\d*(?:\\.\\d+)?[a-zA-Z%]" +
+            "|<[a-zA-Z/!][^>]*>" +
+            "|&#?\\w+;" +
+            "|@\\w+" +
+            "|(?:https?|tg|ton|mailto):(?://)?[^\\s)\\]>\"']+" +
+            "|\\b(?:[A-Za-z0-9-]+\\.)+(?i:org|com|me|net|io|app|dev)\\b[^\\s)\\]>\"']*"
+    )
+
+    // the date patterns and codes of the language pack are data, not text
+    private val DATA_KEY_PREFIXES = arrayOf("formatter", "chatDate", "chatFullDate", "formatDate")
+    private val DATA_KEY_SUFFIXES = arrayOf("TodayAt", "DayAt", "DayYearAt")
+    private const val DATA_KEY_CODE = "LanguageCode"
+
+    private const val CACHE_LIMIT = 8192
+    private val cache = ConcurrentHashMap<String, String>()
+
+    @JvmStatic
+    fun enabled(): Boolean = TeleConfig.LOWERCASE_INTERFACE.value
+
+    // a language pack template: the arguments are formatted in later, so they are never touched
+    @JvmStatic
+    fun template(key: String?, value: String?): String? {
+        if (value == null || !TeleConfig.LOWERCASE_INTERFACE.value) return value
+        if (key != null && isDataKey(key)) return value
+        cache[value]?.let { return it }
+        val lowered = lowerSegments(value)
+        if (cache.size >= CACHE_LIMIT) cache.clear()
+        cache[value] = lowered
+        return lowered
+    }
+
+    // a literal text of tele; dynamic parts are appended after the call
+    @JvmStatic
+    fun lc(text: String): String = if (TeleConfig.LOWERCASE_INTERFACE.value) lowerSegments(text) else text
+
+    @JvmStatic
+    fun lc(text: CharSequence?): CharSequence? =
+        if (text is String && TeleConfig.LOWERCASE_INTERFACE.value) lowerSegments(text) else text
+
+    // the cached templates and the visible screens follow the switch
+    @JvmStatic
+    fun onToggled() {
+        cache.clear()
+        // after the click handler: the rebuild replaces the views it runs in
+        AndroidUtilities.runOnUIThread {
+            NotificationCenter.getGlobalInstance().postNotificationName(NotificationCenter.reloadInterface)
+        }
+    }
+
+    private fun isDataKey(key: String): Boolean {
+        if (key == DATA_KEY_CODE) return true
+        for (prefix in DATA_KEY_PREFIXES) {
+            if (key.startsWith(prefix)) return true
+        }
+        for (suffix in DATA_KEY_SUFFIXES) {
+            if (key.endsWith(suffix)) return true
+        }
+        return false
+    }
+
+    private fun lowerSegments(text: String): String {
+        val matcher = KEEP.matcher(text)
+        var result: StringBuilder? = null
+        var plain = 0
+        while (matcher.find()) {
+            if (matcher.end() == matcher.start()) continue
+            val builder = result ?: StringBuilder(text.length).also { result = it }
+            builder.append(text.substring(plain, matcher.start()).lowercase(Locale.ROOT))
+            builder.append(text, matcher.start(), matcher.end())
+            plain = matcher.end()
+        }
+        val builder = result ?: return text.lowercase(Locale.ROOT)
+        builder.append(text.substring(plain).lowercase(Locale.ROOT))
+        return builder.toString()
+    }
+}
