From: tangenx <me@tangenx.dev>
Date: Wed, 21 Oct 2026 19:01:19 +0300
Subject: [PATCH] fix: show the new settings after an update from tele
 1

---
 .../main/java/tele/helpers/TeleNewSettings.kt | 28 +++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/TMessagesProj/src/main/java/tele/helpers/TeleNewSettings.kt b/TMessagesProj/src/main/java/tele/helpers/TeleNewSettings.kt
index 2fbb9941f..bfcc88d34 100644
--- a/TMessagesProj/src/main/java/tele/helpers/TeleNewSettings.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/TeleNewSettings.kt
@@ -23,6 +23,28 @@ object TeleNewSettings {
     private val fresh = ArrayList<String>()
     private var seen = false
 
+    // the settings of the tele 1 release: what came after it is new for the users who update from it
+    private val TELE1_SETTINGS = setOf(
+        "tele/interface", "tele/privacy", "tele/ids", "tele/sending", "tele/data", "tele/server",
+        "show_seconds", "hide_all_chats_folder", "hide_call_buttons", "confirm_calls",
+        "open_links_directly", "name_instead_of_phone", "reveal_spoilers", "hide_mention_reactions",
+        "static_avatars", "bot_button_payloads", "bubble_badges", "purchase_price", "view_as_tl",
+        "shot", "editor_eyedropper",
+        "hide_stories", "invisible_stories", "ghost_online", "ghost_typing", "ghost_read",
+        "ghost_contents_read", "never_block_screenshots", "allow_screenshots_disappearing",
+        "keep_disappearing_media", "local_drafts", "inline_no_via", "hide_sponsored",
+        "hide_proxy_sponsor", "clean_opened_links", "clean_sent_links", "rewrite_pasted_links",
+        "no_link_previews", "link_preview_mode",
+        "show_peer_id", "peer_ids_without_spaces", "bot_api_peer_ids", "show_dc", "merge_id_dc",
+        "message_id_menu", "show_gift_ids", "show_regular_gift_ids", "seetg_button", "copy_emoji_id",
+        "hd_photos", "docked_media", "punctual_scheduled", "queue_behind_media", "send_older_replies",
+        "double_enter_send", "quick_replies_in_groups", "copy_protected", "calcmula", "calcmula_preview",
+        "server_usernames", "send_crash_reports", "tele_server_url",
+        "local_names", "keep_deleted_messages", "keep_self_deleted_messages", "edit_history",
+        "username_aliases", "deleted_marker", "deleted_reply",
+        "auto_update", "show_changelog"
+    )
+
     // UI thread
     @JvmStatic
     fun fresh(): List<String> {
@@ -46,10 +68,16 @@ object TeleNewSettings {
                 for (i in 0 until list.length()) previous.add(list.optString(i))
             }
             current.filterTo(fresh) { it !in knownIds || it in previous }
+        } else if (updatedFromOlderTele()) {
+            // no list yet, but the app came from an older tele: the settings of the tele 1 release are the baseline
+            current.filterTo(fresh) { it !in TELE1_SETTINGS }
         }
         write(current, false)
     }
 
+    // the changelog was posted before, so the app was updated from an older tele
+    private fun updatedFromOlderTele(): Boolean = TeleConfig.CHANGELOG_ACCOUNTS.value.isNotEmpty()
+
     private fun write(current: List<String>, seen: Boolean) {
         TeleConfig.set(TeleConfig.KNOWN_SETTINGS, JSONObject()
             .put("known", JSONArray(current))
