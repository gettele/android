+package tele.helpers
+
+import android.net.Uri
+import org.telegram.ui.ActionBar.BaseFragment
+import tele.TeleConfig
+import tele.ui.settings.TeleSettingsActivity
+
+// tg://settings/tele[/<page>[/<id>]][?highlight=<id>]: the desktop deep links of the tele settings
+object TeleSettingsLinks {
+
+    private const val BASE = "tg://settings/tele"
+
+    private val SLUGS = mapOf(
+        "interface" to TeleSettingsActivity.MODE_INTERFACE,
+        "chats" to TeleSettingsActivity.MODE_CHATS,
+        "messages" to TeleSettingsActivity.MODE_MESSAGES,
+        "sending" to TeleSettingsActivity.MODE_SENDING,
+        "notifications" to TeleSettingsActivity.MODE_NOTIFICATIONS,
+        "menus" to TeleSettingsActivity.MODE_MENUS,
+        "privacy" to TeleSettingsActivity.MODE_PRIVACY,
+        "profiles" to TeleSettingsActivity.MODE_PROFILES_IDS,
+        "profiles-ids" to TeleSettingsActivity.MODE_PROFILES_IDS,
+        "ids" to TeleSettingsActivity.MODE_PROFILES_IDS,
+        "bots" to TeleSettingsActivity.MODE_BOTS,
+        "debug" to TeleSettingsActivity.MODE_DEBUG,
+        "server" to TeleSettingsActivity.MODE_SERVER,
+        "backup" to TeleSettingsActivity.MODE_BACKUP,
+        "data" to TeleSettingsActivity.MODE_BACKUP,
+        "updates" to TeleSettingsActivity.MODE_UPDATES,
+        "new" to TeleSettingsActivity.MODE_NEW
+    )
+
+    // the slug a page is copied with: the first one of each page
+    private val PAGE_SLUGS: Map<String, String> = SLUGS.entries.groupBy({ it.value }, { it.key }).mapValues { it.value.first() }
+
+    // desktop option id -> our row id, for the options that are named differently; the first id of a row is the one that gets copied
+    private val DESKTOP_IDS: List<Pair<String, String>> = listOf(
+        "tele-title" to optionId(TeleConfig.TITLE_TEMPLATE.key),
+        "tele-lowercase" to optionId(TeleConfig.LOWERCASE_INTERFACE.key),
+        "tele-hide-all-chats" to optionId(TeleConfig.HIDE_ALL_CHATS_FOLDER.key),
+        "tele-hide-similar" to optionId(TeleConfig.HIDE_SIMILAR_CHANNELS.key),
+        "tele-hide-similar-join" to optionId(TeleConfig.HIDE_SIMILAR_CHANNELS.key),
+        "tele-hide-similar-profile" to optionId(TeleConfig.HIDE_SIMILAR_CHANNELS.key),
+        "tele-chat-list-no-reorder-animation" to optionId(TeleConfig.INSTANT_CHAT_MOVE.key),
+        "tele-no-phone-in-header" to optionId(TeleConfig.NAME_INSTEAD_OF_PHONE.key),
+        "tele-static-userpics-chats" to optionId(TeleConfig.STATIC_AVATARS.key),
+        "tele-static-userpics-list" to optionId(TeleConfig.STATIC_AVATARS.key),
+        "tele-hide-calls" to optionId(TeleConfig.HIDE_CALL_BUTTONS.key),
+        "tele-call-button" to optionId(TeleConfig.HIDE_CALL_BUTTONS.key),
+        "tele-group-call-button" to optionId(TeleConfig.HIDE_CALL_BUTTONS.key),
+        "tele-hide-mentions-button" to optionId(TeleConfig.HIDE_MENTION_REACTIONS.key),
+        "tele-hide-reactions-button" to optionId(TeleConfig.HIDE_MENTION_REACTIONS.key),
+        "tele-group-quick-replies" to optionId(TeleConfig.QUICK_REPLIES_IN_GROUPS.key),
+        "tele-media-past-limit" to optionId(TeleConfig.KEEP_MEDIA_PAST_LIMIT.key),
+        "tele-background-menu" to optionId(TeleConfig.LOCAL_CHAT_BACKGROUNDS.key),
+        "tele-message-seconds" to optionId(TeleConfig.SHOW_SECONDS.key),
+        "tele-keep-secret-media" to optionId(TeleConfig.KEEP_DISAPPEARING_MEDIA.key),
+        "tele-keep-deleted" to optionId(TeleConfig.KEEP_DELETED_MESSAGES.key),
+        "tele-keep-deleted-persist" to optionId(TeleConfig.KEEP_DELETED_MESSAGES.key),
+        "tele-edit-history-persist" to optionId(TeleConfig.EDIT_HISTORY.key),
+        "tele-saved-history-period" to optionId(TeleConfig.DELETED_RETENTION.key),
+        "tele-recover-forwarded" to optionId(TeleConfig.RECOVER_FORWARDED_POSTS.key),
+        "tele-deleted-icon" to optionId(TeleConfig.DELETED_MARKER.key),
+        "tele-link-previews" to optionId(TeleConfig.LINK_PREVIEW_MODE.key),
+        "tele-audio-voice" to optionId(TeleConfig.AUDIO_AS_VOICE.key),
+        "tele-docked-attachments" to optionId(TeleConfig.DOCKED_MEDIA.key),
+        "tele-calcmula-inline" to optionId(TeleConfig.CALCMULA_INLINE_RESULT.key),
+        "tele-silence-chats" to optionId(TeleConfig.SILENCE_COMPLETELY.key),
+        "tele-sticker-set-owner" to optionId(TeleConfig.COPY_STICKER_OWNER.key),
+        "tele-nft-purchase-price" to optionId(TeleConfig.PURCHASE_PRICE.key),
+        "tele-profile-photo-bg" to optionId(TeleConfig.PROFILE_PHOTO_BACKGROUND.key),
+        "tele-profile-photo-bg-whole" to optionId(TeleConfig.PROFILE_PHOTO_BACKGROUND_COLOR.key),
+        "tele-button-payloads" to optionId(TeleConfig.BOT_BUTTON_PAYLOADS.key),
+        "tele-inline-without-via" to optionId(TeleConfig.INLINE_NO_VIA.key),
+        "tele-allow-screen-capture" to optionId(TeleConfig.NEVER_BLOCK_SCREENSHOTS.key),
+        "tele-screenshot-secret-media" to optionId(TeleConfig.ALLOW_SCREENSHOTS_DISAPPEARING.key),
+        "tele-no-link-warning" to optionId(TeleConfig.OPEN_LINKS_DIRECTLY.key),
+        "tele-link-rewrites" to optionId(TeleConfig.REWRITE_PASTED_LINKS.key),
+        "tele-ghost" to optionId(TeleConfig.GHOST_MODE.key),
+        "tele-ghost-schedule-pending" to optionId(TeleConfig.GHOST_SCHEDULED_MESSAGES.key),
+        "tele-ghost-chats" to optionId(TeleConfig.GHOST_PER_CHAT.key),
+        "tele-hide-ignored" to optionId(TeleConfig.IGNORE_USERS.key),
+        "tele-ignore-in-menu" to optionId(TeleConfig.IGNORE_BUTTON.key),
+        "tele-peek-last-seen" to optionId(TeleConfig.LAST_SEEN_RESTORE.key),
+        "tele-hide-phone-in-profile" to optionId(TeleConfig.HIDE_PHONE_IN_PROFILES.key),
+        "tele-server-url" to optionId(TeleConfig.TELE_SERVER_URL.key)
+    )
+
+    private val ALIASES: Map<String, String> = DESKTOP_IDS.toMap()
+    private val DESKTOP_OF: Map<String, String> = DESKTOP_IDS.groupBy({ it.second }, { it.first }).mapValues { it.value.first() }
+
+    @JvmStatic
+    fun optionId(key: String): String = "tele-" + key.replace('_', '-')
+
+    /** The link of a row, with the desktop id where there is one. */
+    @JvmStatic
+    fun link(id: String): String = "$BASE?highlight=${DESKTOP_OF[id] ?: id}"
+
+    @JvmStatic
+    fun pageLink(mode: String): String? = PAGE_SLUGS[TeleSettingsActivity.canonicalMode(mode)]?.let { "$BASE/$it" }
+
+    @JvmStatic
+    fun isLink(url: String?): Boolean = parse(url) != null
+
+    /** The settings screen a link opens: the row's page when the link names a row. */
+    @JvmStatic
+    fun fragment(url: String): BaseFragment {
+        val parsed = parse(url) ?: return TeleSettingsActivity()
+        val fallback = parsed.page ?: TeleSettingsActivity.MODE_ROOT
+        val id = parsed.id?.let(::canonicalId) ?: return TeleSettingsActivity(fallback)
+        val page = TeleSettingsActivity.pageOf(id, parsed.page) ?: return TeleSettingsActivity(fallback)
+        return TeleSettingsActivity(page, null, id)
+    }
+
+    private class Parsed(val page: String?, val id: String?)
+
+    private fun parse(url: String?): Parsed? {
+        if (url == null) return null
+        // tg:settings/tele is the same link as tg://settings/tele
+        val fixed = if (url.startsWith("tg:settings", true)) "tg://settings" + url.substring("tg:settings".length) else url
+        val uri = runCatching { Uri.parse(fixed) }.getOrNull() ?: return null
+        if (!"tg".equals(uri.scheme, true) || !"settings".equals(uri.host, true)) return null
+        val segments = uri.pathSegments
+        if (segments.isEmpty() || !"tele".equals(segments[0], true)) return null
+        var page: String? = null
+        var id: String? = null
+        var next = 1
+        if (segments.size > next) {
+            page = SLUGS[segments[next].lowercase()]
+            // a lone id after tele/ works too
+            if (page != null) next++
+        }
+        if (segments.size > next) id = segments[next]
+        if (id.isNullOrEmpty()) id = uri.getQueryParameter("highlight")
+        return Parsed(page, id?.takeIf { it.isNotBlank() })
+    }
+
+    /** The id of our row: the desktop ids, our keys and the ids without the prefix all work. */
+    private fun canonicalId(raw: String): String {
+        var id = raw.trim().lowercase().replace('_', '-')
+        if (!id.startsWith("tele-")) id = "tele-$id"
+        return ALIASES[id] ?: id
+    }
+}
