From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Fri, 6 Nov 2026 17:42:30 +0300
Subject: [PATCH] fix: round docked media corners with cover crop

---
 TMessagesProj/src/main/java/tele/ui/TeleDockedStrip.kt | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/TMessagesProj/src/main/java/tele/ui/TeleDockedStrip.kt b/TMessagesProj/src/main/java/tele/ui/TeleDockedStrip.kt
index 083183593..17b37d6f0 100644
--- a/TMessagesProj/src/main/java/tele/ui/TeleDockedStrip.kt
+++ b/TMessagesProj/src/main/java/tele/ui/TeleDockedStrip.kt
@@ -318,6 +318,12 @@ class TeleDockedStrip(
             spoilerEffect?.callback = this
             val image = BackupImageView(context)
             image.setRoundRadius(AndroidUtilities.dp(8f))
+            image.outlineProvider = object : android.view.ViewOutlineProvider() {
+                override fun getOutline(view: android.view.View, outline: android.graphics.Outline) {
+                    outline.setRoundRect(0, 0, view.width, view.height, AndroidUtilities.dp(8f).toFloat())
+                }
+            }
+            image.clipToOutline = true
             if (item.spoiler && android.os.Build.VERSION.SDK_INT >= android.os.Build.VERSION_CODES.S) {
                 image.setRenderEffect(android.graphics.RenderEffect.createBlurEffect(
                     AndroidUtilities.dp(6f).toFloat(), AndroidUtilities.dp(6f).toFloat(), android.graphics.Shader.TileMode.CLAMP
