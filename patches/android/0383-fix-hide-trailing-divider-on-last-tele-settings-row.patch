From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: test <test@example.com>
Date: Thu, 26 Nov 2026 18:18:03 +0300
Subject: [PATCH] fix: hide trailing divider on last tele settings row

---
 .../src/main/java/tele/ui/settings/TeleSettingsActivity.kt | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
index d69c943a6..70ad24303 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
@@ -683,6 +683,8 @@ class TeleSettingsActivity @JvmOverloads constructor(
         searchHits = emptyList()
         rows = pageRows()
         rows.forEachIndexed { position, row ->
+            val nextRow = rows.getOrNull(position + 1)
+            val divider = nextRow != null && nextRow.type != TYPE_SHADOW
             val title = row.title.orEmpty()
             val shown = lc(displayTitle(title))
             val subtitle = row.subtitle?.let { lc(it) }
@@ -703,7 +705,7 @@ class TeleSettingsActivity @JvmOverloads constructor(
                                     cell.setCollapseSwitchClick { setGroupValue(row, !(row.item!!.value as Boolean)) }
                                     cell.setCollapseDividerVisible(false)
                                     if (!subtitle.isNullOrEmpty()) {
-                                         cell.setTextAndValue(shownWithBadge, subtitle, true, true)
+                                         cell.setTextAndValue(shownWithBadge, subtitle, true, divider)
                                      }
                                      cell.setPadding(0, 0, 0, 0)
                                      cell.setCollapseLayout(AndroidUtilities.dp(140f), true)
@@ -718,7 +720,7 @@ class TeleSettingsActivity @JvmOverloads constructor(
                                     val cell = view as TextCheckCell2
                                     cell.clearCollapseLayout()
                                     if (!subtitle.isNullOrEmpty()) {
-                                        cell.setTextAndValueAndCheck(shownWithBadge, subtitle, checked, true, true)
+                                        cell.setTextAndValueAndCheck(shownWithBadge, subtitle, checked, true, divider)
                                     }
                                     cell.setPadding(if (row.indent > 0) AndroidUtilities.dp(16f) else 0, 0, 0, 0)
                                     cell.setEnabled(parentEnabled)
@@ -739,6 +741,7 @@ class TeleSettingsActivity @JvmOverloads constructor(
                     }
                     else -> UItem.asButton(position, lc(title))
                 }.also { item ->
+                    item.hideDivider = !divider
                     // a recycled TextCell keeps the shift of a group child, so every text row sets it
                     if (item.bind == null && row.type != TYPE_SHADOW && row.type != TYPE_CUSTOM) {
                         val shift = if (row.indent > 0) AndroidUtilities.dp(16f).toFloat() else 0f
