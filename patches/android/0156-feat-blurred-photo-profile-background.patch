+++ b/TMessagesProj/src/main/java/tele/ui/TeleProfilePhoto.kt
@@ -0,0 +1,231 @@
+package tele.ui
+
+import android.graphics.Bitmap
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.Rect
+import android.graphics.drawable.Drawable
+import android.util.LruCache
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.ImageLocation
+import org.telegram.messenger.ImageReceiver
+import org.telegram.messenger.MessagesController
+import org.telegram.messenger.Utilities
+import org.telegram.tgnet.TLObject
+import org.telegram.tgnet.TLRPC
+import org.telegram.ui.ProfileActivity
+import tele.TeleConfig
+import kotlin.math.max
+import kotlin.math.min
+
+/**
+ * The blurred profile photo as the header background of one [ProfileActivity].
+ * Every instance belongs to one account and one fragment.
+ */
+class TeleProfilePhoto private constructor(
+    private val fragment: ProfileActivity,
+    private val account: Int
+) {
+
+    private class Blurred(val bitmap: Bitmap, val edge: Int)
+
+    private var key: String? = null
+    private var blurred: Blurred? = null
+    private var synthetic: MessagesController.PeerColor? = null
+    private var receiver: ImageReceiver? = null
+    private var destroyed = false
+    private var blurringKey: String? = null
+
+    private val paint = Paint(Paint.FILTER_BITMAP_FLAG)
+    private val srcRect = Rect()
+    private val dstRect = Rect()
+
+    init {
+        live.add(this)
+    }
+
+    /** The header takes the photo, the pattern emoji of the stock header is dropped. */
+    fun isActive(): Boolean = blurred != null && enabled()
+
+    /** The colour the stock profile should use: a colour of the photo while it is ready, else the stock one. */
+    fun peerColor(stock: MessagesController.PeerColor?, source: TLObject?, excluded: Boolean): MessagesController.PeerColor? {
+        if (destroyed || excluded || !enabled()) {
+            release()
+            return stock
+        }
+        val location = ImageLocation.getForUserOrChat(account, source, ImageLocation.TYPE_BIG)
+        if (location == null || source == null) {
+            release()
+            return stock
+        }
+        val newKey = "$account:${location.getKey(source, null, false)}"
+        if (newKey != key) {
+            release()
+            key = newKey
+            cache.get(newKey)?.let { publish(it, silent = true) } ?: load(location, source, newKey)
+        }
+        return synthetic ?: stock
+    }
+
+    /** Draws the photo over the header; false means the stock background has to be drawn. */
+    fun draw(canvas: Canvas, width: Int, visibleHeight: Int, fullHeight: Int, alpha: Int): Boolean {
+        val photo = blurred ?: return false
+        if (!enabled() || width <= 0 || visibleHeight <= 0) return false
+        val height = max(visibleHeight, fullHeight)
+        val side = photo.bitmap.width
+        if (width >= height) {
+            val part = (side.toLong() * height / width).toInt().coerceIn(1, side)
+            srcRect.set(0, (side - part) / 2, side, (side - part) / 2 + part)
+        } else {
+            val part = (side.toLong() * width / height).toInt().coerceIn(1, side)
+            srcRect.set((side - part) / 2, 0, (side - part) / 2 + part, side)
+        }
+        dstRect.set(0, 0, width, height)
+        paint.alpha = alpha
+        canvas.save()
+        canvas.clipRect(0, 0, width, visibleHeight)
+        canvas.drawBitmap(photo.bitmap, srcRect, dstRect, paint)
+        canvas.restore()
+        return true
+    }
+
+    fun detach() {
+        destroyed = true
+        live.remove(this)
+        release()
+    }
+
+    private fun enabled(): Boolean = TeleConfig.PROFILE_PHOTO_BACKGROUND.value
+
+    private fun release() {
+        key = null
+        blurringKey = null
+        blurred = null
+        synthetic = null
+        receiver?.let {
+            it.setDelegate(null)
+            it.onDetachedFromWindow()
+            it.clearImage()
+        }
+        receiver = null
+    }
+
+    private fun load(location: ImageLocation, source: TLObject, loadKey: String) {
+        val imageReceiver = ImageReceiver()
+        imageReceiver.setCurrentAccount(account)
+        imageReceiver.setDelegate { r, set, thumb, _ ->
+            if (!set || thumb || destroyed || key != loadKey || receiver !== r || blurringKey == loadKey) return@setDelegate
+            val bitmap = r.bitmap ?: return@setDelegate
+            val square = squareOf(bitmap) ?: return@setDelegate
+            blurringKey = loadKey
+            // the receiver stays attached only until the first full image
+            Utilities.globalQueue.postRunnable {
+                val result = blur(square)
+                AndroidUtilities.runOnUIThread {
+                    if (destroyed || key != loadKey) return@runOnUIThread
+                    cache.put(loadKey, result)
+                    publish(result, silent = false)
+                }
+            }
+        }
+        receiver = imageReceiver
+        imageReceiver.onAttachedToWindow()
+        imageReceiver.setImage(location, "${SIDE}_$SIDE", null as Drawable?, null, source, 0)
+    }
+
+    private fun publish(result: Blurred, silent: Boolean) {
+        blurred = result
+        synthetic = peerColorOf(result.edge)
+        receiver?.let {
+            it.setDelegate(null)
+            it.onDetachedFromWindow()
+            it.clearImage()
+        }
+        receiver = null
+        if (!silent) {
+            fragment.tele_photoChanged()
+        }
+    }
+
+    private fun onConfig() {
+        if (destroyed) return
+        if (!enabled()) {
+            release()
+        }
+        fragment.tele_photoChanged()
+    }
+
+    private fun peerColorOf(edge: Int): MessagesController.PeerColor? {
+        val status = TLRPC.TL_emojiStatusCollectible()
+        val opaque = edge or (0xFF shl 24)
+        status.edge_color = opaque
+        status.center_color = opaque
+        status.text_color = Color.WHITE
+        // light enough to lift the action buttons off the photo, not to wash them out
+        status.pattern_color = mix(opaque, Color.WHITE, 0.35f)
+        return MessagesController.PeerColor.fromCollectible(status)
+    }
+
+    companion object {
+        private const val SIDE = 96
+        private const val RADIUS = 16
+        private const val TARGET_LIGHTNESS = 0.3
+        private const val MIN_DARKEN = 0.2
+        private const val MAX_DARKEN = 0.7
+
+        // the blurred photos of the opened profiles; the key holds the account
+        private val cache = LruCache<String, Blurred>(8)
+        private val live = ArrayList<TeleProfilePhoto>()
+
+        @JvmStatic
+        fun create(fragment: ProfileActivity, account: Int): TeleProfilePhoto = TeleProfilePhoto(fragment, account)
+
+        @JvmStatic
+        fun onConfigChanged() {
+            if (!TeleConfig.PROFILE_PHOTO_BACKGROUND.value) cache.evictAll()
+            for (photo in ArrayList(live)) photo.onConfig()
+        }
+
+        private fun squareOf(source: Bitmap): Bitmap? {
+            if (source.isRecycled || source.width <= 0 || source.height <= 0) return null
+            val side = min(source.width, source.height)
+            val result = Bitmap.createBitmap(SIDE, SIDE, Bitmap.Config.ARGB_8888)
+            val canvas = Canvas(result)
+            canvas.drawColor(Color.BLACK)
+            val from = Rect((source.width - side) / 2, (source.height - side) / 2, (source.width - side) / 2 + side, (source.height - side) / 2 + side)
+            canvas.drawBitmap(source, from, Rect(0, 0, SIDE, SIDE), Paint(Paint.FILTER_BITMAP_FLAG))
+            return result
+        }
+
+        private fun blur(square: Bitmap): Blurred {
+            Utilities.stackBlurBitmap(square, RADIUS)
+            Utilities.stackBlurBitmap(square, RADIUS)
+            val average = average(square, 0, SIDE)
+            val lightness = 0.299 * Color.red(average) / 255.0 + 0.587 * Color.green(average) / 255.0 + 0.114 * Color.blue(average) / 255.0
+            val darken = if (lightness > 0.0) (1.0 - TARGET_LIGHTNESS / lightness).coerceIn(MIN_DARKEN, MAX_DARKEN) else MIN_DARKEN
+            Canvas(square).drawColor(Color.argb((darken * 255.0 + 0.5).toInt(), 0, 0, 0))
+            return Blurred(square, average(square, 0, SIDE))
+        }
+
+        /** The mean colour of the rows [from, to) of a square bitmap. */
+        private fun average(bitmap: Bitmap, from: Int, to: Int): Int {
+            val width = bitmap.width
+            val rows = max(to - from, 1)
+            val pixels = IntArray(width * rows)
+            bitmap.getPixels(pixels, 0, width, 0, from, width, rows)
+            var r = 0L
+            var g = 0L
+            var b = 0L
+            for (pixel in pixels) {
+                r += Color.red(pixel)
+                g += Color.green(pixel)
+                b += Color.blue(pixel)
+            }
+            val count = pixels.size.toLong()
+            return Color.rgb((r / count).toInt(), (g / count).toInt(), (b / count).toInt())
+        }
+
+        private fun mix(from: Int, to: Int, amount: Float): Int = androidx.core.graphics.ColorUtils.blendARGB(from, to, amount)
+    }
+}
