From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Fri, 23 Oct 2026 14:44:45 +0300
Subject: [PATCH 160/161] fix: open submenus in message menus

---
 .../java/org/telegram/ui/ChatActivity.java    | 49 ++++++++++++++++++-
 .../main/java/tele/helpers/TeleMenuLayout.kt  | 16 ++++--
 2 files changed, 61 insertions(+), 4 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
index f691405b9..3e11d0169 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
@@ -31685,7 +31685,7 @@ public class ChatActivity extends BaseFragment implements
             final boolean isReactionsAvailableFinal = !suggestEdit && isReactionsAvailable;
 
             int flags = 0;
-            if (isReactionsViewAvailable || showMessageSeen || showSponsorInfo) {
+            if (isReactionsViewAvailable || showMessageSeen || showSponsorInfo || tele.helpers.TeleMenuLayout.hasRuntimeSubmenu(options)) {
                 flags |= ActionBarPopupWindow.ActionBarPopupWindowLayout.FLAG_USE_SWIPEBACK;
             }
 
@@ -32446,6 +32446,8 @@ public class ChatActivity extends BaseFragment implements
                     }
                 }
                 scrimPopupWindowItems = new ActionBarMenuSubItem[items.size()];
+                final java.util.List<Integer> teleSubmenuCounts = tele.helpers.TeleMenuLayout.runtimeSubmenuCounts();
+                int teleSubmenuIndex = 0;
                 for (int a = 0, N = items.size(); a < N; a++) {
                     final Integer option = options.get(a);
                     if (option == OPTION_DELETE && showWelcomeMessageRevertOption(selectedObject)) {
@@ -32457,6 +32459,51 @@ public class ChatActivity extends BaseFragment implements
                         scrimPopupWindowItems[a] = null;
                         continue;
                     }
+                    if (option == tele.helpers.TeleMenuLayout.RUNTIME_SUBMENU && teleSubmenuIndex < teleSubmenuCounts.size() && popupLayout.getSwipeBack() != null) {
+                        final int teleChildEnd = Math.min(a + 1 + teleSubmenuCounts.get(teleSubmenuIndex++), N);
+                        LinearLayout teleSubmenuLayout = new LinearLayout(getParentActivity());
+                        teleSubmenuLayout.setOrientation(LinearLayout.VERTICAL);
+                        ActionBarMenuSubItem teleBackCell = new ActionBarMenuSubItem(getParentActivity(), true, false, themeDelegate);
+                        teleBackCell.setItemHeight(44);
+                        teleBackCell.setTextAndIcon(LocaleController.getString(R.string.Back), R.drawable.msg_arrow_back);
+                        teleBackCell.getTextView().setPadding(LocaleController.isRTL ? 0 : AndroidUtilities.dp(40), 0, LocaleController.isRTL ? AndroidUtilities.dp(40) : 0, 0);
+                        teleBackCell.setOnClickListener(v1 -> popupLayout.getSwipeBack().closeForeground());
+                        teleSubmenuLayout.addView(teleBackCell, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT));
+                        teleSubmenuLayout.addView(new ActionBarPopupWindow.GapView(contentView.getContext(), themeDelegate), LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, 8));
+                        for (int c = a + 1; c < teleChildEnd; c++) {
+                            final int childOption = options.get(c);
+                            if (childOption == tele.helpers.TeleMenuLayout.RUNTIME_SEPARATOR) {
+                                teleSubmenuLayout.addView(new ActionBarPopupWindow.GapView(contentView.getContext(), themeDelegate), LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, 8));
+                                continue;
+                            }
+                            ActionBarMenuSubItem childCell = new ActionBarMenuSubItem(getParentActivity(), false, c == teleChildEnd - 1, themeDelegate);
+                            childCell.setMinimumWidth(AndroidUtilities.dp(200));
+                            if (childOption == tele.helpers.TeleMenuLayout.RUNTIME_SUBMENU) {
+                                // nested submenus stay inline as a heading
+                                childCell.setTextAndIcon(items.get(c), 0);
+                                childCell.setEnabled(false);
+                                childCell.setSelectorColor(Color.TRANSPARENT);
+                            } else {
+                                childCell.setTextAndIcon(items.get(c), icons.get(c));
+                                childCell.setOnClickListener(v1 -> {
+                                    if (selectedObject != null) processSelectedOption(childOption);
+                                });
+                                scrimPopupWindowItems[c] = childCell;
+                            }
+                            teleSubmenuLayout.addView(childCell, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT));
+                        }
+                        final int teleForeground = popupLayout.addViewToSwipeBack(teleSubmenuLayout);
+                        ActionBarMenuSubItem submenuCell = new ActionBarMenuSubItem(getParentActivity(), a == 0, teleChildEnd >= N, themeDelegate);
+                        submenuCell.setMinimumWidth(AndroidUtilities.dp(200));
+                        submenuCell.setTextAndIcon(items.get(a), 0);
+                        submenuCell.setRightIcon(R.drawable.msg_arrowright);
+                        submenuCell.openSwipeBackLayout = () -> popupLayout.getSwipeBack().openForeground(teleForeground);
+                        submenuCell.setOnClickListener(v1 -> submenuCell.openSwipeBack());
+                        popupLayout.addView(submenuCell);
+                        scrimPopupWindowItems[a] = submenuCell;
+                        a = teleChildEnd - 1;
+                        continue;
+                    }
                     ActionBarMenuSubItem cell = new ActionBarMenuSubItem(getParentActivity(), a == 0, a == N - 1, themeDelegate);
                     cell.setMinimumWidth(AndroidUtilities.dp(200));
                     cell.setTextAndIcon(items.get(a), option == tele.helpers.TeleMenuLayout.RUNTIME_SUBMENU ? 0 : icons.get(a));
diff --git a/TMessagesProj/src/main/java/tele/helpers/TeleMenuLayout.kt b/TMessagesProj/src/main/java/tele/helpers/TeleMenuLayout.kt
index 3dc0103ce..316440cd2 100644
--- a/TMessagesProj/src/main/java/tele/helpers/TeleMenuLayout.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/TeleMenuLayout.kt
@@ -45,6 +45,14 @@ object TeleMenuLayout {
     const val RUNTIME_SEPARATOR = Int.MIN_VALUE
     const val RUNTIME_SUBMENU = Int.MIN_VALUE + 1
 
+    /** The submenus of the last applied layout: the number of rows after each top-level title row. */
+    private val submenuChildCounts = ArrayList<Int>()
+
+    @JvmStatic
+    fun hasRuntimeSubmenu(options: List<Int>): Boolean = options.contains(RUNTIME_SUBMENU)
+
+    @JvmStatic
+    fun runtimeSubmenuCounts(): List<Int> = submenuChildCounts.toList()
 
     private const val KEY_PREFIX = "tele_menu_"
     private const val MIGRATED_KEY = "tele_menu_migrated"
@@ -213,6 +221,7 @@ object TeleMenuLayout {
      * the items that are not in the layout keep their place at the end.
      */
     fun apply(kind: TeleMenuKind, account: Int, items: ArrayList<CharSequence>, icons: ArrayList<Int>, options: ArrayList<Int>) {
+        submenuChildCounts.clear()
         val stored = load(kind, account)
         if (stored.isNullOrEmpty()) return
         val layout = resolve(kind, account)
@@ -248,7 +257,7 @@ object TeleMenuLayout {
                 }
             }
         }
-        fun addEntries(entries: List<TeleMenuEntry>) {
+        fun addEntries(entries: List<TeleMenuEntry>, depth: Int) {
             for (entry in entries) {
                 when (entry) {
                     is TeleMenuEntry.Item -> addKey(entry.key)
@@ -259,17 +268,18 @@ object TeleMenuLayout {
                     }
                     is TeleMenuEntry.Submenu -> if (entry.enabled) {
                         val before = sortedItems.size
-                        addEntries(entry.entries)
+                        addEntries(entry.entries, depth + 1)
                         if (sortedItems.size > before) {
                             sortedItems.add(before, entry.title)
                             sortedIcons.add(before, 0)
                             sortedOptions.add(before, RUNTIME_SUBMENU)
+                            if (depth == 0) submenuChildCounts.add(sortedItems.size - before)
                         }
                     }
                 }
             }
         }
-        addEntries(layout)
+        addEntries(layout, 0)
         for (index in options.indices) addIndex(index)
         items.clear(); items.addAll(sortedItems)
         icons.clear(); icons.addAll(sortedIcons)
