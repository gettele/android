-    // true when the request has to go out right after messages[index]
+    // true when the request has to go out right after messages[index]; pending counts the ones already in it
     @JvmStatic
     fun after(messages: List<MessageObject>, index: Int, pending: Int, scheduleDate: Int): Boolean {
-        if (!TeleConfig.FORWARD_ONE_BY_ONE.value || scheduleDate != 0) {
+        val oneByOne = TeleConfig.FORWARD_ONE_BY_ONE.value && scheduleDate == 0
+        if (!oneByOne && !TeleConfig.SELECT_MANY.value) {
             return false
         }
         val next = messages.getOrNull(index + 1) ?: return false
         val group = messages[index].messageOwner?.grouped_id ?: 0L
+        val nextGroup = next.messageOwner?.grouped_id ?: 0L
         // albums stay in one request
-        return group == 0L || group != (next.messageOwner?.grouped_id ?: 0L)
+        if (group != 0L && group == nextGroup) {
+            return false
+        }
+        if (oneByOne) {
+            return true
+        }
+        // the stock cut at 100 would split an album that fits into the next request whole
+        if (nextGroup == 0L) {
+            return false
+        }
+        var album = 0
+        var i = index + 1
+        while (i < messages.size && messages[i].messageOwner?.grouped_id == nextGroup) {
+            album++
+            i++
+        }
+        return album <= SelectMany.PER_REQUEST && pending + album > SelectMany.PER_REQUEST
     }
 
     // false: the caller sends right away, as stock does
diff --git a/TMessagesProj/src/main/java/tele/helpers/SelectMany.kt b/TMessagesProj/src/main/java/tele/helpers/SelectMany.kt
new file mode 100644
index 000000000..073f6eed0
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/SelectMany.kt
@@ -0,0 +1,64 @@
+package tele.helpers
+
+import org.telegram.messenger.MessagesController
+import org.telegram.tgnet.TLObject
+import org.telegram.tgnet.TLRPC
+import tele.TeleConfig
+
+// selecting past the stock cap of 100: requests still carry at most 100 ids each
+object SelectMany {
+    const val PER_REQUEST = 100
+    private const val MAX_SELECTED = 10000
+
+    // a report names its messages in one request, so it keeps the stock cap
+    @JvmStatic
+    fun max(report: Boolean): Int = if (!report && TeleConfig.SELECT_MANY.value) MAX_SELECTED else PER_REQUEST
+
+    @JvmStatic
+    fun parts(ids: ArrayList<Int>): List<ArrayList<Int>> {
+        if (!TeleConfig.SELECT_MANY.value || ids.size <= PER_REQUEST) {
+            return listOf(ids)
+        }
+        return ids.chunked(PER_REQUEST).map { ArrayList(it) }
+    }
+
+    // true when the deletion was handed over to the controller in parts of 100
+    @JvmStatic
+    fun deleteInParts(
+        controller: MessagesController,
+        messages: ArrayList<Int>?,
+        randoms: ArrayList<Long>?,
+        encryptedChat: TLRPC.EncryptedChat?,
+        dialogId: Long,
+        forAll: Boolean,
+        mode: Int,
+        cacheOnly: Boolean,
+        taskId: Long,
+        taskRequest: TLObject?,
+        topicId: Int,
+        movedToScheduled: Boolean,
+        movedToScheduledMessageId: Int,
+        userInitiated: Boolean
+    ): Boolean {
+        if (!TeleConfig.SELECT_MANY.value || taskId != 0L || messages == null || messages.size <= PER_REQUEST) {
+            return false
+        }
+        // secret chats pair every id with its random id; otherwise the randoms ride with the first part
+        val paired = randoms != null && randoms.size == messages.size
+        var from = 0
+        while (from < messages.size) {
+            val to = minOf(from + PER_REQUEST, messages.size)
+            val partRandoms = when {
+                paired -> ArrayList(randoms!!.subList(from, to))
+                from == 0 -> randoms
+                else -> null
+            }
+            controller.deleteMessages(
+                ArrayList(messages.subList(from, to)), partRandoms, encryptedChat, dialogId, forAll, mode,
+                cacheOnly, 0L, taskRequest, topicId, movedToScheduled, movedToScheduledMessageId, userInitiated
+            )
+            from = to
+        }
+        return true
+    }
+}
