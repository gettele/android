+    private void teleApplyLabels() {
+        final boolean labelShown = teleLabelShown();
+        final boolean iconShown = teleIconShown();
+        textView.setVisibility(labelShown ? VISIBLE : INVISIBLE);
+        if (iconShown) {
+            if (teleIconHiddenByLabels) {
+                if (backupImageView != null) {
+                    backupImageView.setVisibility(VISIBLE);
+                } else {
+                    imageView.setVisibility(VISIBLE);
+                }
+                teleIconHiddenByLabels = false;
+            }
+        } else if (!teleIconHiddenByLabels) {
+            imageView.setVisibility(GONE);
+            if (backupImageView != null) {
+                backupImageView.setVisibility(GONE);
+            }
+            teleIconHiddenByLabels = true;
+        }
+        final int height = getHeight();
+        final float iconSize = tele_iconSize();
+        final boolean smallIcon = iconSize <= 24;
+        final float iconHeight = imageView.getHeight();
+        final float backupHeight = backupImageView != null ? backupImageView.getHeight() : 0f;
+        if (height > 0) {
+            if (!labelShown) {
+                // No label: always center icon vertically regardless of size
+                final float iconY = (height - iconHeight) / 2f;
+                imageView.setTranslationY(iconY - imageView.getTop());
+                if (backupImageView != null) {
+                    backupImageView.setTranslationY((height - backupHeight) / 2f - backupImageView.getTop());
+                }
+            } else if (smallIcon) {
+                // Label + small icon: center in space above the text
+                final float availTop = textView.getTop();
+                imageView.setTranslationY((availTop - iconHeight) / 2f - imageView.getTop());
+                if (backupImageView != null) {
+                    backupImageView.setTranslationY((availTop - backupHeight) / 2f - backupImageView.getTop());
+                }
+            } else {
+                // Label + large icon: top-aligned
+                imageView.setTranslationY(0);
+                if (backupImageView != null) {
+                    backupImageView.setTranslationY(0);
+                }
+            }
+        } else {
+            imageView.setTranslationY(0);
+            if (backupImageView != null) {
+                backupImageView.setTranslationY(0);
+            }
+        }
+        if (labelShown && !iconShown && height > 0) {
+            final float textHeight = textView.getHeight();
+            textView.setTranslationY((height - textHeight) / 2f - textView.getTop());
+        } else {
+            textView.setTranslationY(0);
+        }
+        if (teleEqualWidth) {
+            checkVisualWidth();
+        }
+        invalidate();
+    }
