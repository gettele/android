+    private fun pickMiniAppBot() {
+        val args = Bundle()
+        args.putInt("dialogsType", DialogsActivity.DIALOGS_TYPE_START_ATTACH_BOT)
+        args.putBoolean("onlySelect", true)
+        args.putBoolean("allowUsers", false)
+        args.putBoolean("allowGroups", false)
+        args.putBoolean("allowLegacyGroups", false)
+        args.putBoolean("allowMegagroups", false)
+        args.putBoolean("allowChannels", false)
+        args.putBoolean("allowBots", true)
+        val picker = DialogsActivity(args)
+        val target = replaceIndex
+        picker.setDelegate { fragment, dids, _, _, _, _, _, topicsFragment ->
+            val dialogId = dids.firstOrNull()?.dialogId ?: return@setDelegate false
+            fragment.finishFragment()
+            topicsFragment?.removeSelfFromStack()
+            AndroidUtilities.runOnUIThread({ replaceIndex = target; addMiniApp(dialogId) }, 250)
+            true
+        }
+        presentFragment(picker)
+    }
