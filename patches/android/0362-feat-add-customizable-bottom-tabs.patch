+                    val user = MessagesController.getInstance(account).getUser(dialogId)
+                    if (user != null) t.tele_setDialogAvatar(user, AvatarDrawable(user))
+                } else if (DialogObject.isChatDialog(dialogId)) {
+                    val chat = MessagesController.getInstance(account).getChat(-dialogId)
+                    if (chat != null) t.tele_setDialogAvatar(chat, AvatarDrawable(chat))
+                }
+                t
+            }
+        }
+        tab.isClickable = false
+        tab.isFocusable = false
+        tab.setSelected(selected, false)
+        return tab
+    }
