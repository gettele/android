+    private fun bulletin(text: String) {
+        BulletinFactory.of(this).createSimpleBulletin(R.raw.error, text).show()
+    }
+
+    // the look of the slots
+
+    private fun titleOf(slot: MainTabsConfig.Slot): CharSequence =
+        MainTabsConfig.pageTitle(account, slot) ?: when (slot.kind) {
+            MainTabsConfig.KIND_CHATS -> LocaleController.getString(R.string.MainTabsChats)
+            MainTabsConfig.KIND_CONTACTS -> LocaleController.getString(R.string.MainTabsContacts)
+            MainTabsConfig.KIND_CALLS -> LocaleController.getString(R.string.MainTabsCalls)
+            MainTabsConfig.KIND_SETTINGS -> LocaleController.getString(R.string.Settings)
+            MainTabsConfig.KIND_PROFILE -> LocaleController.getString(R.string.MainTabsProfile)
+            MainTabsConfig.KIND_SAVED -> LocaleController.getString(R.string.SavedMessages)
+            MainTabsConfig.KIND_SEARCH, MainTabsConfig.KIND_NOTIFICATIONS, MainTabsConfig.KIND_DATA_USAGE ->
+                localized(MainTabsConfig.titleResOf(slot.kind))
+            MainTabsConfig.KIND_NEW_MESSAGE -> LocaleController.getString(R.string.TeleTabNewMessage)
+            MainTabsConfig.KIND_CAMERA -> LocaleController.getString(R.string.TeleTabCamera)
+            MainTabsConfig.KIND_CONTACTS_SAVED -> LocaleController.getString(R.string.MainTabsContacts)
+            else -> if (MainTabsConfig.isTeleSettingsKind(slot.kind) || MainTabsConfig.isStockSettingsKind(slot.kind)) {
+                localized(MainTabsConfig.titleResOf(slot.kind))
+            } else if (slot.isMiniApp) {
+                TeleMiniAppFragment.title(account, slot.botId)
+            } else {
+                chatTitle(slot.dialogId)
+            }
+        }
+
+    private fun chatTitle(dialogId: Long): CharSequence {
+        if (dialogId == UserConfig.getInstance(account).clientUserId) {
+            return LocaleController.getString(R.string.SavedMessages)
+        }
+        if (DialogObject.isEncryptedDialog(dialogId)) {
+            val encryptedChat = MessagesController.getInstance(account).getEncryptedChat(DialogObject.getEncryptedChatId(dialogId))
+            if (encryptedChat != null) {
+                val user = MessagesController.getInstance(account).getUser(encryptedChat.user_id)
+                if (user != null) {
+                    return UserObject.getUserName(user)
+                }
+            }
+            return ""
+        }
+        return DialogObject.getName(account, dialogId)
+    }
+
+
+    private fun pageAnimationOf(slot: MainTabsConfig.Slot): GlassTabView.TabAnimation? {
+        if ((!slot.isPage && !slot.isActionShortcut && slot.kind != MainTabsConfig.KIND_SAVED) || slot.kind == MainTabsConfig.KIND_PROFILE || slot.isMiniApp) {
+            return null
+        }
+        return animationByName(MainTabsConfig.iconNameOf(slot))
+    }
+
+    private fun animationByName(name: String): GlassTabView.TabAnimation? {
+        if (name.isEmpty()) {
+            return null
+        }
+        return try {
+            GlassTabView.TabAnimation.valueOf(name)
+        } catch (e: IllegalArgumentException) {
+            FileLog.e(e)
+            null
+        }
+    }
+
+    private fun iconLabel(animation: GlassTabView.TabAnimation): String {
+        val pretty = animation.name.lowercase().replace('_', ' ').replaceFirstChar { it.uppercase() }
+        return lc(pretty)
+    }
+
+    /** The filled frame of a tab animation, the way a selected tab shows it. */
+    private fun bindAnimationPreview(view: RLottieImageView, animation: GlassTabView.TabAnimation, selected: Boolean) {
+        val color = Theme.getColor(if (selected) Theme.key_glass_tabSelected else Theme.key_glass_tabUnselected, resourceProvider)
+        view.setColorFilter(PorterDuffColorFilter(color, PorterDuff.Mode.SRC_IN))
+        if (animation.iconStatic != -1) {
+            view.setImageResource(animation.iconStatic)
+            return
+        }
+        view.setAnimation(animation.iconToFilled, 24, 24)
+        val drawable = view.animatedDrawable ?: return
+        if (animation.endFrameMid != -1) {
+            drawable.setCurrentFrame(animation.endFrameMid, false)
+        } else {
+            drawable.setProgress(0.99f)
+        }
+    }
+
+    private fun dialogIdOf(slot: MainTabsConfig.Slot): Long =
+        if (slot.kind == MainTabsConfig.KIND_SAVED) UserConfig.getInstance(account).clientUserId else slot.dialogId
+
+    private fun showSelectedText(): Boolean = MainTabsConfig.labelsMode() == MainTabsConfig.LABELS_SELECTED
+
+    private fun labelsValue(): String = when (MainTabsConfig.labelsMode()) {
+        MainTabsConfig.LABELS_SELECTED -> lc("Selected")
+        MainTabsConfig.LABELS_ICONS -> lc("Icons only")
+        else -> lc("All")
+    }
+
+    /** The interactive preview bar: a positional drag reorders the slots, a plain tap opens the slot menu. */
+    private inner class PreviewBar(context: Context) : LinearLayout(context) {
+        private var dragging = false
+        private var fromIdx = -1
+        private var targetIdx = -1
+        private var downX = 0f
+        private var downY = 0f
+        private var downChild: View? = null
+        private val slop = AndroidUtilities.dp(6f).toFloat()
+
+        /** Gestures live at dispatch level: whatever a menu does to a tab view cannot break them. */
+        override fun dispatchTouchEvent(event: MotionEvent): Boolean {
+            when (event.actionMasked) {
+                MotionEvent.ACTION_DOWN -> {
+                    downChild = childAtX(event.x)
+                    fromIdx = if (downChild == null) -1 else indexOfChild(downChild)
+                    targetIdx = fromIdx
+                    downX = event.rawX
+                    downY = event.rawY
+                    dragging = false
+                    return downChild != null
+                }
+                MotionEvent.ACTION_MOVE -> {
+                    if (!dragging) {
+                        val dx = event.rawX - downX
+                        val dy = event.rawY - downY
+                        if (downChild == null || abs(dx) < slop || abs(dx) < abs(dy)) {
+                            return super.dispatchTouchEvent(event)
+                        }
+                        dragging = true
+                        parent.requestDisallowInterceptTouchEvent(true)
+                        downChild?.translationZ = AndroidUtilities.dp(4f).toFloat()
+                    }
+                    val child = downChild ?: return super.dispatchTouchEvent(event)
+                    if (childCount >= 2) {
+                        val w = width / childCount.toFloat()
+                        val rawOffset = event.rawX - downX
+                        val target = Math.round(fromIdx + rawOffset / w).coerceIn(0, childCount - 1)
+                        if (target != targetIdx) {
+                            targetIdx = target
+                            AndroidUtilities.vibrate(this)
+                            applyGap(child, fromIdx, targetIdx, w)
+                        }
+                        child.translationX = rawOffset
+                    }
+                    return true
+                }
+                MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> {
+                    val child = downChild
+                    downChild = null
+                    parent.requestDisallowInterceptTouchEvent(false)
+                    if (dragging) {
+                        dragging = false
+                        if (child != null) {
+                            settle(child, event.actionMasked == MotionEvent.ACTION_UP)
+                        }
+                    } else if (event.actionMasked == MotionEvent.ACTION_UP && child != null && abs(event.rawX - downX) < slop && abs(event.rawY - downY) < slop) {
+                        if (fromIdx in slots.indices) {
+                            post {
+                                if (child.parent === this && fromIdx in slots.indices) {
+                                    showSlotMenu(child, fromIdx)
+                                }
+                            }
+                        }
+                    }
+                    return true
+                }
+            }
+            return super.dispatchTouchEvent(event)
+        }
+
+        /** Equal-width tabs: the x span picks the touched child. */
+        private fun childAtX(x: Float): View? {
+            for (i in 0 until childCount) {
+                val child = getChildAt(i)
+                if (x >= child.left && x <= child.right) {
+                    return child
+                }
+            }
+            return null
+        }
+
+        /** Posts the physical reorder so it never happens inside the touch dispatch itself. */
+        private fun settle(v: View, commit: Boolean) {
+            val from = fromIdx
+            val to = targetIdx
+            post {
+                if (v.parent !== this || indexOfChild(v) != from || childCount == 0) {
+                    return@post
+                }
+                val w = width / childCount.toFloat()
+                if (commit && to != from && to in 0 until childCount) {
+                    v.translationX -= (to - from) * w
+                    slots.add(to, slots.removeAt(from))
+                    removeView(v)
+                    addView(v, to)
+                    save()
+                }
+                v.animate().cancel()
+                v.animate().translationX(0f).translationZ(0f).setDuration(160).start()
+                for (i in 0 until childCount) {
+                    val child = getChildAt(i)
+                    if (child === v) {
+                        continue
+                    }
+                    child.animate().cancel()
+                    child.animate().translationX(0f).setDuration(160).start()
+                }
+            }
+        }
+
+        /** Slides the tabs between from and target so the gap opens under the dragged tab. */
+        private fun applyGap(dragged: View, from: Int, target: Int, w: Float) {
+            for (i in 0 until childCount) {
+                val child = getChildAt(i)
+                if (child === dragged) {
+                    continue
+                }
+                val tx = when {
+                    target > from && i in (from + 1)..target -> -w
+                    target < from && i in target until from -> w
+                    else -> 0f
+                }
+                if (child.translationX != tx) {
+                    child.animate().cancel()
+                    child.animate().translationX(tx).setDuration(160).start()
+                }
+            }
+        }
+    }
+
+    private inner class Adapter(private val context: Context) : RecyclerListView.SelectionAdapter() {
+        override fun getItemCount(): Int = 5 + if (showSelectedText()) 1 else 0
+
+        override fun isEnabled(holder: RecyclerView.ViewHolder): Boolean =
+            holder.itemViewType == TYPE_ADD || holder.itemViewType == TYPE_LABELS || holder.itemViewType == TYPE_SELECTED_TEXT
+
+        override fun onCreateViewHolder(parent: ViewGroup, viewType: Int): RecyclerView.ViewHolder {
+            val view: View = when (viewType) {
+                TYPE_PREVIEW -> createPreviewCell(context)
+                TYPE_ADD -> TextCell(context)
+                TYPE_LABELS -> TextSettingsCell(context)
+                TYPE_SELECTED_TEXT -> TextCheckCell(context, resourceProvider)
+                TYPE_ICON_SIZE_SLIDER -> SlideIntChooseView(context, resourceProvider)
+                else -> TextInfoPrivacyCell(context)
+            }
+            if (view.layoutParams == null) {
+                view.layoutParams = RecyclerView.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT)
+            }
+            return RecyclerListView.Holder(view)
+        }
+
+        override fun onBindViewHolder(holder: RecyclerView.ViewHolder, position: Int) {
+            when (holder.itemViewType) {
+                TYPE_PREVIEW -> bindPreviewCell(holder.itemView)
+                TYPE_ADD -> {
+                    (holder.itemView as TextCell).setTextAndIcon(lc("Add tab"), R.drawable.msg_add, false)
+                    holder.itemView.setOnClickListener { showAddMenu(it) }
+                }
+                TYPE_LABELS -> {
+                    (holder.itemView as TextSettingsCell).setTextAndValue(lc("Labels"), labelsValue(), true)
+                    holder.itemView.setOnClickListener { showLabelsDialog() }
+                }
+                TYPE_ICON_SIZE_SLIDER -> {
+                    val view = holder.itemView as SlideIntChooseView
+                    val current = TeleConfig.MAIN_TABS_ICON_SIZE.value
+                    view.setLabel(lc("Icon size"))
+                    view.setShowDividers(true)
+                    view.set(
+                        current,
+                        SlideIntChooseView.Options.make(
+                            0,
+                            intArrayOf(16, 20, 24, 28, 32),
+                            1
+                        ) { _, v -> "$v dp" },
+                        { size ->
+                            TeleConfig.set(TeleConfig.MAIN_TABS_ICON_SIZE, size)
+                            TeleHooks.onConfigChanged(TeleConfig.MAIN_TABS_ICON_SIZE)
+                            adapter?.notifyItemChanged(itemCount - 1)
+                        }
+                    )
+                }
+                TYPE_SELECTED_TEXT -> {
+                    (holder.itemView as TextCheckCell).setTextAndCheck(lc("Text on the selected tab"), TeleConfig.MAIN_TABS_SELECTED_TEXT.value, true)
+                    holder.itemView.setOnClickListener {
+                        TeleConfig.set(TeleConfig.MAIN_TABS_SELECTED_TEXT, !TeleConfig.MAIN_TABS_SELECTED_TEXT.value)
+                        TeleHooks.onConfigChanged(TeleConfig.MAIN_TABS_SELECTED_TEXT)
+                        adapter?.notifyDataSetChanged()
+                    }
+                }
+                TYPE_SHADOW -> (holder.itemView as TextInfoPrivacyCell).setText(
+                    lc("The preview is interactive: drag a tab to reorder it, tap a tab to change or remove it.")
+                )
+            }
+        }
+
+        override fun getItemViewType(position: Int): Int {
+            val last = itemCount - 1
+            return when {
+                position == 0 -> TYPE_LABELS
+                position == 1 -> TYPE_ICON_SIZE_SLIDER
+                showSelectedText() && position == 2 -> TYPE_SELECTED_TEXT
+                position == last - 2 -> TYPE_ADD
+                position == last -> TYPE_PREVIEW
+                else -> TYPE_SHADOW
+            }
+        }
+    }
+
+    /** The stock tab animations as a grid of filled previews. */
+    private inner class IconSheet(
+        context: Context,
+        private val provider: Theme.ResourcesProvider?,
+        current: String,
+        private val onPick: (String) -> Unit
+    ) : BottomSheet(context, true, provider) {
+
+        init {
+            fixNavigationBar()
+            setCanDismissWithSwipe(false)
+            val root = LinearLayout(context)
+            root.orientation = LinearLayout.VERTICAL
+
+            val handle = View(context)
+            handle.background = Theme.createRoundRectDrawable(
+                AndroidUtilities.dp(2f),
+                Theme.multAlpha(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText4, provider), 0.6f)
+            )
+            root.addView(handle, LayoutHelper.createLinear(36, 4, Gravity.CENTER_HORIZONTAL, 0, 8, 0, 0))
+
+            val titleView = TextView(context)
+            titleView.text = lc("Tab icon")
+            titleView.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 20f)
+            titleView.typeface = AndroidUtilities.bold()
+            titleView.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText, provider))
+            root.addView(titleView, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT, Gravity.START, 20, 10, 20, 6))
+
+            val selectedBackground = Theme.createRoundRectDrawable(
+                AndroidUtilities.dp(10f),
+                Theme.multAlpha(Theme.getColor(Theme.key_glass_tabSelected, provider), 0.13f)
+            )
+
+            fun addSection(title: String, animations: List<GlassTabView.TabAnimation>) {
+                if (animations.isEmpty()) {
+                    return
+                }
+                val header = TextView(context)
+                header.text = title
+                header.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14f)
+                header.typeface = AndroidUtilities.bold()
+                header.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText, provider))
+                root.addView(header, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT, Gravity.START, 20, 14, 20, 4))
+                val columns = 4
+                var row: LinearLayout? = null
+                for (animation in animations) {
+                    if (row == null || row.childCount == columns) {
+                        row = LinearLayout(context)
+                        row.orientation = LinearLayout.HORIZONTAL
+                        root.addView(row, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT))
+                    }
+                    val picked = animation.name == current
+                    val cell = LinearLayout(context)
+                    cell.orientation = LinearLayout.VERTICAL
+                    cell.gravity = Gravity.CENTER
+                    cell.setPadding(AndroidUtilities.dp(4f), AndroidUtilities.dp(8f), AndroidUtilities.dp(4f), AndroidUtilities.dp(8f))
+                    if (picked) {
+                        cell.background = selectedBackground
+                    }
+                    val preview = RLottieImageView(context)
+                    bindAnimationPreview(preview, animation, picked)
+                    cell.addView(preview, LinearLayout.LayoutParams(AndroidUtilities.dp(30f), AndroidUtilities.dp(30f)))
+                    val name = TextView(context)
+                    name.text = iconLabel(animation)
+                    name.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 11f)
+                    name.setGravity(Gravity.CENTER)
+                    name.setSingleLine(true)
+                    name.setTextColor(Theme.getColor(
+                        if (picked) Theme.key_glass_tabSelectedText else Theme.key_windowBackgroundWhiteGrayText2, provider
+                    ))
+                    cell.addView(name, LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT))
+                    cell.setOnClickListener {
+                        dismiss()
+                        onPick(animation.name)
+                    }
+                    row.addView(cell, LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f))
+                }
+                // stretch the trailing cells so the last row lines up with the grid
+                while (row != null && row.childCount < columns) {
+                    row.addView(View(context), LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.MATCH_PARENT, 1f))
+                }
+            }
+
+            val all = GlassTabView.TabAnimation.values().toList()
+            addSection(lc("Animated"), all.filter { it.iconStatic == -1 })
+            addSection(lc("Icons"), all.filter { it.iconStatic != -1 })
+            val maxHeight = (AndroidUtilities.displaySize.y * 0.72f).toInt()
+            setCustomView(BoundedScrollView(context, maxHeight).also { scroll ->
+                scroll.addView(root, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT))
+            })
+        }
+
+    }
+
+
+    /** A scroll view that never grows past the height of the screen, so its content scrolls. */
+    private class BoundedScrollView(context: Context, private val maxHeight: Int) : ScrollView(context) {
+        override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
+            super.onMeasure(widthMeasureSpec, MeasureSpec.makeMeasureSpec(maxHeight, MeasureSpec.AT_MOST))
+        }
+    }
+
+    private fun lc(text: String): String = TeleLowercase.lc(text)
+
+    private fun localized(resId: Int): String = TeleLowercase.lc(LocaleController.getString(resId))
+
+    companion object {
+        private const val TYPE_PREVIEW = 1
+        private const val TYPE_ADD = 3
+        private const val TYPE_LABELS = 4
+        private const val TYPE_SHADOW = 5
+        private const val TYPE_SELECTED_TEXT = 6
+        private const val TYPE_ICON_SIZE_SLIDER = 8
+
+        private const val ID_MORE = 7301
+        private const val ID_RESET = 7302
+    }
+}
