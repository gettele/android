+                    return@runOnUIThread
+                }
+                openApp(botApp, themeParams)
+            }
+        }, ConnectionsManager.RequestFlagFailOnServerErrors)
+    }
+
+    private fun openApp(botApp: TLRPC.BotApp, themeParams: TLRPC.TL_dataJSON?) {
+        val request = TLRPC.TL_messages_requestAppWebView()
+        val app = TLRPC.TL_inputBotAppID()
+        app.id = botApp.id
+        app.access_hash = botApp.access_hash
+        request.app = app
+        request.peer = MessagesController.getInstance(account).getInputPeer(botId)
+        request.platform = "android"
+        request.write_allowed = true
+        request.compact = false
+        request.fullscreen = false
+        if (themeParams != null) {
+            request.theme_params = themeParams
+            request.flags = request.flags or 4
+        }
+        ConnectionsManager.getInstance(account).sendRequest(request, { response, error ->
+            AndroidUtilities.runOnUIThread {
+                val url = (response as? TLRPC.TL_webViewResultUrl)?.url
+                if (container == null || fragmentView == null || error != null || url.isNullOrEmpty()) {
+                    showPlaceholder(R.string.TeleMiniAppOpenFailed)
+                    return@runOnUIThread
+                }
+                queryId = (response as TLRPC.TL_webViewResultUrl).query_id
+                placeholder?.visibility = View.GONE
+                container?.loadUrl(account, url, response.same_origin)
+                MediaDataController.getInstance(account).increaseWebappRating(botId)
+                if (queryId != 0L) {
+                    AndroidUtilities.cancelRunOnUIThread(pollRunnable)
+                    AndroidUtilities.runOnUIThread(pollRunnable, POLL_PERIOD)
+                }
+            }
+        }, ConnectionsManager.RequestFlagInvokeAfter or ConnectionsManager.RequestFlagFailOnServerErrors)
+    }
+
+    private fun openMenuButtonApp(themeParams: TLRPC.TL_dataJSON?) {
+        val user = MessagesController.getInstance(account).getUser(botId)
+        if (user == null) {
+            showPlaceholder(R.string.TeleMiniAppOpenFailed)
+            return
+        }
+        // getBotMenuButton is bot-only; users read the menu button from the full user info
+        MessagesController.getInstance(account).loadFullUser(user, classGuid, false) { full ->
+            if (container == null || fragmentView == null) {
+                return@loadFullUser
+            }
+            val button = full?.bot_info?.menu_button as? org.telegram.tgnet.tl.TL_bots.TL_botMenuButton
+            if (button == null || button.url.isNullOrEmpty()) {
+                showPlaceholder(R.string.TeleMiniAppUnsupported)
+                return@loadFullUser
+            }
+            openButtonUrl(button.url, themeParams)
+        }
+    }
+
+    private fun openButtonUrl(url: String, themeParams: TLRPC.TL_dataJSON?) {
+        val request = TLRPC.TL_messages_requestWebView()
+        request.bot = MessagesController.getInstance(account).getInputUser(botId)
+        request.peer = MessagesController.getInstance(account).getInputPeer(botId)
+        request.platform = "android"
+        request.url = url
+        request.flags = request.flags or 2
+        request.compact = false
+        request.fullscreen = false
+        if (themeParams != null) {
+            request.theme_params = themeParams
+            request.flags = request.flags or 4
+        }
+        ConnectionsManager.getInstance(account).sendRequest(request, { response, error ->
+            AndroidUtilities.runOnUIThread {
+                val result = response as? TLRPC.TL_webViewResultUrl
+                if (container == null || fragmentView == null || error != null || result == null || result.url.isNullOrEmpty()) {
+                    showPlaceholder(R.string.TeleMiniAppOpenFailed)
+                    return@runOnUIThread
+                }
+                queryId = result.query_id
+                placeholder?.visibility = View.GONE
+                container?.loadUrl(account, result.url, result.same_origin)
+                MediaDataController.getInstance(account).increaseWebappRating(botId)
+                if (queryId != 0L) {
+                    AndroidUtilities.cancelRunOnUIThread(pollRunnable)
+                    AndroidUtilities.runOnUIThread(pollRunnable, POLL_PERIOD)
+                }
+            }
+        }, ConnectionsManager.RequestFlagInvokeAfter or ConnectionsManager.RequestFlagFailOnServerErrors)
+    }
+
+    private fun showPlaceholder(resId: Int) {
+        placeholder?.text = TeleLowercase.lc(LocaleController.getString(resId))
+        placeholder?.visibility = View.VISIBLE
+    }
+
+    private fun closeToChats() {
+        val tabs = (parentActivity as? LaunchActivity)?.actionBarLayout?.lastFragment as? MainTabsActivity
+        tabs?.tele_showChatsTab()
+    }
+
+    private fun confirmClose(callback: Runnable?) {
+        val user = MessagesController.getInstance(account).getUser(botId)
+        val name = if (user == null) title(account, botId) else UserObject.getUserName(user)
+        val dialog = AlertDialog.Builder(context, resourceProvider)
+            .setTitle(name)
+            .setMessage(LocaleController.getString(R.string.BotWebViewChangesMayNotBeSaved))
+            .setPositiveButton(LocaleController.getString(R.string.BotWebViewCloseAnyway)) { _, _ ->
+                closeConfirmation = false
+                callback?.run()
+                closeToChats()
+            }
+            .setNegativeButton(LocaleController.getString(R.string.Cancel), null)
+            .create()
+        dialog.show()
+        (dialog.getButton(AlertDialog.BUTTON_POSITIVE) as? android.widget.TextView)?.setTextColor(Theme.getColor(Theme.key_text_RedBold, resourceProvider))
+    }
+
+    private fun requestClose(callback: Runnable?) {
+        if (closeConfirmation) {
+            confirmClose(callback)
+        } else {
+            callback?.run()
+            closeToChats()
+        }
+    }
+
+    private fun inlineQuery(bot: TLRPC.User, query: String, chatTypes: List<String>) {
+        if (chatTypes.isEmpty()) {
+            val last = (parentActivity as? LaunchActivity)?.actionBarLayout?.lastFragment
+            if (last is ChatActivity) {
+                last.getChatActivityEnterView()?.setFieldText("@" + UserObject.getPublicUsername(bot) + " " + query)
+                closeToChats()
+                return
+            }
+        }
+        val args = Bundle()
+        args.putInt("dialogsType", DialogsActivity.DIALOGS_TYPE_START_ATTACH_BOT)
+        args.putBoolean("onlySelect", true)
+        args.putBoolean("allowGroups", chatTypes.isEmpty() || chatTypes.contains("groups"))
+        args.putBoolean("allowMegagroups", chatTypes.isEmpty() || chatTypes.contains("groups"))
+        args.putBoolean("allowLegacyGroups", chatTypes.isEmpty() || chatTypes.contains("groups"))
+        args.putBoolean("allowUsers", chatTypes.isEmpty() || chatTypes.contains("users"))
+        args.putBoolean("allowChannels", chatTypes.contains("channels"))
+        args.putBoolean("allowBots", chatTypes.contains("bots"))
+        val picker = DialogsActivity(args)
+        picker.setDelegate { fragment, dids, _, _, _, _, _, topicsFragment ->
+            val dialogId = dids.firstOrNull()?.dialogId ?: return@setDelegate false
+            fragment.finishFragment()
+            topicsFragment?.removeSelfFromStack()
+            val chat = Bundle()
+            chat.putBoolean("scrollToTopOnResume", true)
+            if (DialogObject.isEncryptedDialog(dialogId)) {
+                chat.putInt("enc_id", DialogObject.getEncryptedChatId(dialogId))
+            } else if (DialogObject.isUserDialog(dialogId)) {
+                chat.putLong("user_id", dialogId)
+            } else {
+                chat.putLong("chat_id", -dialogId)
+            }
+            chat.putString("start_text", "@" + UserObject.getPublicUsername(bot) + " " + query)
+            AndroidUtilities.runOnUIThread({
+                if (MessagesController.getInstance(account).checkCanOpenChat(chat, this)) {
+                    presentFragment(ChatActivity(chat))
+                }
+            }, 250)
+            true
+        }
+        presentFragment(picker)
+    }
+
+    private fun openInvoice(inputInvoice: TLRPC.InputInvoice, slug: String, response: TLObject) {
+        if (response is TLRPC.TL_payments_paymentFormStars) {
+            val progress = AlertDialog(context, AlertDialog.ALERT_TYPE_SPINNER)
+            progress.showDelayed(150)
+            StarsController.getInstance(account).openPaymentForm(null, inputInvoice, response, {
+                progress.dismiss()
+            }) { status ->
+                container?.onInvoiceStatusUpdate(slug, status)
+            }
+            return
+        }
+        val payment: PaymentFormActivity = when (response) {
+            is TLRPC.PaymentForm -> {
+                MessagesController.getInstance(account).putUsers(response.users, false)
+                PaymentFormActivity(response, slug, this)
+            }
+            is TLRPC.PaymentReceipt -> PaymentFormActivity(response)
+            else -> return
+        }
+        payment.setPaymentFormCallback { status ->
+            container?.onInvoiceStatusUpdate(slug, status.name.lowercase(Locale.ROOT))
+        }
+        payment.setResourcesProvider(resourceProvider)
+        presentFragment(payment)
+    }
+
+    override fun onRequestPermissionsResultFragment(requestCode: Int, permissions: Array<String>, grantResults: IntArray) {
+        container?.onRequestPermissionsResult(requestCode, permissions, grantResults)
+        super.onRequestPermissionsResultFragment(requestCode, permissions, grantResults)
+    }
+
+    companion object {
+        private const val ID_SETTINGS = 7801
+        private const val POLL_PERIOD = 60_000L
+
+        @JvmStatic
+        fun findAttachBot(account: Int, botId: Long): TLRPC.TL_attachMenuBot? =
+            MediaDataController.getInstance(account).attachMenuBots?.bots?.firstOrNull { it.bot_id == botId }
+
+        @JvmStatic
+        fun title(account: Int, botId: Long): CharSequence {
+            val bot = findAttachBot(account, botId)
+            if (bot != null && !bot.short_name.isNullOrEmpty()) {
+                return bot.short_name
+            }
+            return DialogObject.getName(account, botId)
+        }
+
+        @JvmStatic
+        fun attachBots(account: Int): List<TLRPC.TL_attachMenuBot> =
+            MediaDataController.getInstance(account).attachMenuBots?.bots?.filter {
+                it.bot_id != 0L && (it.show_in_attach_menu || it.show_in_side_menu)
+            } ?: emptyList()
+    }
+}
