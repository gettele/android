+    private fun addSlot(slot: MainTabsConfig.Slot) {
+        val target = replaceIndex
+        replaceIndex = -1
+        if (target in slots.indices) {
+            if (slots[target].key == slot.key) {
+                return
+            }
+            if (slots.withIndex().any { (i, s) -> i != target && s.key == slot.key }) {
+                bulletin(lc("This tab is already on the bar."))
+                return
+            }
+            slots[target] = slot
+            save()
+            adapter?.notifyDataSetChanged()
+            return
+        }
+        if (slots.size >= MainTabsConfig.MAX_SLOTS) {
+            bulletin(lc("The bar holds six tabs."))
+            return
+        }
+        if (slots.any { it.key == slot.key }) {
+            return
+        }
+        slots.add(slot)
+        save()
+        adapter?.notifyDataSetChanged()
+        listView?.layoutManager?.scrollToPosition((adapter?.itemCount ?: 1) - 1)
+    }
+
+    /** In replace mode the slot being replaced does not block its own kind. */
+    private fun offered(predicate: (MainTabsConfig.Slot) -> Boolean): Boolean =
+        slots.withIndex().any { (i, s) -> i != replaceIndex && predicate(s) }
