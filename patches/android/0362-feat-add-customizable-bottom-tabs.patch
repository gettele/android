+    private fun bindPreviewCell(view: View) {
+        val bar = view.tag as? LinearLayout ?: return
+        bar.removeAllViews()
+        val mode = MainTabsConfig.labelsMode()
+        val selectedText = TeleConfig.MAIN_TABS_SELECTED_TEXT.value
+        val selectedIndex = 0
+        slots.forEachIndexed { index, slot ->
+            val tab = createPreviewTab(bar.context, slot, index == selectedIndex)
+            tab.tele_setLabelsMode(mode)
+            tab.tele_setSelectedText(selectedText)
+            tab.tele_setEqualWidth(true)
+            tab.tele_onSelectionChangedForLabels()
+            bar.addView(tab, LinearLayout.LayoutParams(0, AndroidUtilities.dp(48f), 1f))
+        }
+        bar.post {
+            val childW = if (bar.childCount > 0) bar.getChildAt(0).width else 0
+            if (childW > 0) {
+                val maxText = (childW - AndroidUtilities.dp(16f)).coerceAtLeast(0)
+                for (i in 0 until bar.childCount) {
+                    val tab = bar.getChildAt(i) as? GlassTabView ?: continue
+                    tab.tele_setMaxLabelWidth(maxText)
+                }
+            }
+        }
+    }
