+        card.background = Theme.createRoundRectDrawable(AndroidUtilities.dp(28f), dark)
+        card.setPadding(AndroidUtilities.dp(12f), AndroidUtilities.dp(12f), AndroidUtilities.dp(12f), AndroidUtilities.dp(12f))
