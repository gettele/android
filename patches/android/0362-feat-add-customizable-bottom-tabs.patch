+    private fun addMiniApp(botId: Long) {
+        if (botId <= 0L || !DialogObject.isUserDialog(botId)) {
+            bulletin(localized(R.string.TeleMiniAppUnsupported))
+            return
+        }
+        val user = MessagesController.getInstance(account).getUser(botId)
+        if (user == null) {
+            MessagesController.getInstance(account).reloadUser(botId)
+            bulletin(localized(R.string.TeleMiniAppOpenFailed))
+            return
+        }
+        if (!user.bot) {
+            bulletin(localized(R.string.TeleMiniAppUnsupported))
+            return
+        }
+        val slot = MainTabsConfig.Slot(MainTabsConfig.miniAppKey(botId), botHash = user.access_hash)
+        if (offered { it.key == slot.key }) {
+            bulletin(localized(R.string.TeleMiniAppAlreadyAdded))
+            return
+        }
+        addSlot(slot)
+    }
+
+    private fun pickMiniApp() {
+        if (replaceIndex < 0 && slots.size >= MainTabsConfig.MAX_SLOTS) {
+            bulletin(lc("The bar holds six tabs."))
+            return
+        }
+        if (loadingMiniApps) return
+        val activity = parentActivity ?: return
+        loadingMiniApps = true
+        val progress = AlertDialog(activity, AlertDialog.ALERT_TYPE_SPINNER)
+        progress.showDelayed(150)
+        try {
+            MediaDataController.getInstance(account).loadAttachMenuBots(false, true) {
+                loadingMiniApps = false
+                progress.dismiss()
+                if (parentActivity == null) return@loadAttachMenuBots
+                val bots = TeleMiniAppFragment.attachBots(account)
+                val names = (bots.map { bot ->
+                    bot.short_name?.takeIf { it.isNotEmpty() } ?: DialogObject.getName(account, bot.bot_id)
+                } + localized(R.string.TeleMiniAppChooseBot)).toTypedArray()
+                val builder = AlertDialog.Builder(activity, resourceProvider)
+                builder.setTitle(localized(R.string.TeleMiniAppPickerTitle))
+                builder.setItems(names) { _, which ->
+                    if (which == bots.size) pickMiniAppBot() else addMiniApp(bots[which].bot_id)
+                }
+                builder.setNegativeButton(LocaleController.getString(R.string.Cancel), null)
+                val dialog = builder.create()
+                dialog.setOnDismissListener { replaceIndex = -1 }
+                showDialog(dialog)
+            }
+        } catch (e: Exception) {
+            loadingMiniApps = false
+            progress.dismiss()
+            FileLog.e(e)
+            bulletin(localized(R.string.TeleMiniAppOpenFailed))
+        }
+    }
