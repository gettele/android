+
+    const val KIND_CHATS = "chats"
+    const val KIND_CONTACTS = "contacts"
+    const val KIND_CALLS = "calls"
+    const val KIND_SETTINGS = "settings"
+    const val KIND_PROFILE = "profile"
+    const val KIND_SAVED = "saved"
+    const val KIND_ARCHIVE = "archive"
+    const val KIND_FOLDERS = "folders"
+    const val KIND_FOLDER_PREFIX = "folder:"
+    const val KIND_TELE_SETTINGS = "tele-settings"
+    const val KIND_SEARCH = "search"
+    const val KIND_NOTIFICATIONS = "notifications"
+    const val KIND_DATA_USAGE = "data-usage"
+    const val KIND_SETTINGS_THEME = "settings:ThemeActivity"
+    const val KIND_SETTINGS_NOTIFICATIONS = "settings:NotificationsSettingsActivity"
+    const val KIND_SETTINGS_DATA_USAGE = "settings:DataUsageActivity"
+    const val KIND_SETTINGS_PRIVACY = "settings:PrivacySettingsActivity"
+    const val KIND_SETTINGS_FOLDERS = "settings:FiltersSetupActivity"
+    const val KIND_NEW_MESSAGE = "new-message"
+    const val KIND_CAMERA = "camera"
+    const val KIND_CONTACTS_SAVED = "contacts-saved"
+    private const val KIND_CHAT_PREFIX = "chat:"
+    private const val KIND_TELE_SECTION_PREFIX = "$KIND_TELE_SETTINGS:"
+    const val KIND_MINIAPP_PREFIX = "miniapp:"
+    const val MAX_SLOTS = 6
+    const val LABELS_ALL = 0
+    const val LABELS_SELECTED = 1
+    const val LABELS_ICONS = 2
+    private val DEFAULT_ICONS = mapOf(
+        KIND_CHATS to "CHATS",
+        KIND_CONTACTS to "CONTACTS",
+        KIND_CALLS to "CALLS",
+        KIND_SETTINGS to "SETTINGS",
+        KIND_ARCHIVE to "STORIES_ARCHIVE",
+        KIND_FOLDERS to "CHATS",
+        KIND_TELE_SETTINGS to "SETTINGS",
+        KIND_SEARCH to "SEARCH",
+        KIND_NOTIFICATIONS to "NOTIFICATIONS",
+        KIND_DATA_USAGE to "DATA_USAGE",
+        KIND_SETTINGS_THEME to "SETTINGS",
+        KIND_SETTINGS_NOTIFICATIONS to "NOTIFICATIONS",
+        KIND_SETTINGS_DATA_USAGE to "DATA_USAGE",
+        KIND_SETTINGS_PRIVACY to "SETTINGS",
+        KIND_SETTINGS_FOLDERS to "CHATS",
+        KIND_NEW_MESSAGE to "NEW_MESSAGE",
+        KIND_CAMERA to "CAMERA",
+        KIND_CONTACTS_SAVED to "CONTACTS",
+        KIND_SAVED to "SAVED"
+    )
+    private val TELE_SECTION_MODES = linkedMapOf(
+        "appearance" to TeleSettingsActivity.MODE_INTERFACE,
+        "interface" to TeleSettingsActivity.MODE_INTERFACE,
+        "chats" to TeleSettingsActivity.MODE_CHATS,
+        "messages" to TeleSettingsActivity.MODE_MESSAGES,
+        "sending" to TeleSettingsActivity.MODE_SENDING,
+        "menus" to TeleSettingsActivity.MODE_MENUS,
+        "privacy" to TeleSettingsActivity.MODE_PRIVACY,
+        "profiles-ids" to TeleSettingsActivity.MODE_PROFILES_IDS,
+        "bots" to TeleSettingsActivity.MODE_BOTS,
+        "money" to TeleSettingsActivity.MODE_MONEY,
+        "scripts" to TeleSettingsActivity.MODE_SCRIPTS,
+        "debug" to TeleSettingsActivity.MODE_DEBUG,
+        "server" to TeleSettingsActivity.MODE_SERVER,
+        "backup" to TeleSettingsActivity.MODE_BACKUP,
+        "updates" to TeleSettingsActivity.MODE_UPDATES
+    )
+    private val TELE_SECTION_TITLES = mapOf(
+        "appearance" to R.string.TeleTabAppearance,
+        "interface" to R.string.TeleTabInterface,
+        "chats" to R.string.TeleTabChats,
+        "messages" to R.string.TeleTabMessages,
+        "sending" to R.string.TeleTabSending,
+        "menus" to R.string.TeleTabMenus,
+        "privacy" to R.string.TeleTabPrivacy,
+        "profiles-ids" to R.string.TeleTabProfilesIds,
+        "bots" to R.string.TeleTabBots,
+        "money" to R.string.TeleTabMoney,
+        "scripts" to R.string.TeleTabScripts,
+        "debug" to R.string.TeleTabDebug,
+        "server" to R.string.TeleTabServer,
+        "backup" to R.string.TeleTabBackup,
+        "updates" to R.string.TeleTabUpdates
+    )
+    private val TELE_SECTION_ICONS = mapOf(
+        "appearance" to "COLORS",
+        "interface" to "COLORS",
+        "chats" to "CHATS",
+        "messages" to "CHATS",
+        "sending" to "REPLIES",
+        "menus" to "SETTINGS",
+        "privacy" to "SETTINGS",
+        "profiles-ids" to "CONTACTS",
+        "bots" to "SETTINGS",
+        "money" to "WALLET",
+        "scripts" to "SYMBOLS",
+        "debug" to "SETTINGS",
+        "server" to "LINK",
+        "backup" to "FILES",
+        "updates" to "SETTINGS"
+    )
+    private val TELE_SECTION_KINDS = TELE_SECTION_MODES.keys.mapTo(HashSet()) { teleSectionKind(it) }
+
+    @JvmField
+    val TELE_SECTION_SLUGS = TELE_SECTION_MODES.keys.toList()
+
+    @JvmField
+    val STOCK_SETTINGS_KINDS = listOf(
+        KIND_SETTINGS_THEME,
+        KIND_SETTINGS_NOTIFICATIONS,
+        KIND_SETTINGS_DATA_USAGE,
+        KIND_SETTINGS_PRIVACY,
+        KIND_SETTINGS_FOLDERS
+    )
+
+    @JvmStatic
+    fun isStockSettingsKind(kind: String): Boolean = kind in STOCK_SETTINGS_KINDS
+
+    @JvmStatic
+    fun labelsMode(): Int = when (TeleConfig.MAIN_TABS_LABELS.value) {
+        "selected" -> LABELS_SELECTED
+        "icons" -> LABELS_ICONS
+        else -> LABELS_ALL
+    }
+
+    @JvmStatic
+    fun isTeleSettingsKind(kind: String): Boolean = kind == KIND_TELE_SETTINGS || kind in TELE_SECTION_KINDS
+
+    @JvmStatic
+    fun teleSectionKind(slug: String): String = KIND_TELE_SECTION_PREFIX + slug
+
+    @JvmStatic
+    fun teleSettingsMode(kind: String): String {
+        if (kind == KIND_TELE_SETTINGS) return TeleSettingsActivity.MODE_ROOT
+        return TELE_SECTION_MODES[kind.removePrefix(KIND_TELE_SECTION_PREFIX)] ?: TeleSettingsActivity.MODE_ROOT
+    }
+
+    @JvmStatic
+    fun titleResOf(kind: String): Int = when (kind) {
+        KIND_TELE_SETTINGS -> R.string.TeleTabTele
+        KIND_SEARCH -> R.string.Search
+        KIND_NOTIFICATIONS -> R.string.SettingsNotifications
+        KIND_DATA_USAGE -> R.string.TeleTabDataStorage
+        KIND_SETTINGS_THEME -> R.string.ChatSettings
+        KIND_SETTINGS_NOTIFICATIONS -> R.string.SettingsNotifications
+        KIND_SETTINGS_DATA_USAGE -> R.string.TeleTabDataStorage
+        KIND_SETTINGS_PRIVACY -> R.string.PrivacySettings
+        KIND_SETTINGS_FOLDERS -> R.string.Filters
+        KIND_SAVED -> R.string.SavedMessages
+        else -> if (kind.startsWith(KIND_TELE_SECTION_PREFIX)) {
+            TELE_SECTION_TITLES[kind.removePrefix(KIND_TELE_SECTION_PREFIX)] ?: 0
+        } else {
+            0
+        }
+    }
+
+    /** The icon a page slot shows: its own choice, or the one its kind starts with. */
+    @JvmStatic
+    fun iconNameOf(slot: Slot): String =
+        if (slot.iconName.isNotEmpty()) slot.iconName
+        else if (slot.isFolder) "CHATS"
+        else DEFAULT_ICONS[slot.kind] ?: if (isTeleSettingsKind(slot.kind)) {
+            TELE_SECTION_ICONS[slot.kind.removePrefix(KIND_TELE_SECTION_PREFIX)] ?: "SETTINGS"
+        } else {
+            ""
+        }
+
+    @JvmStatic
+    fun isFolderKind(kind: String): Boolean = kind.startsWith(KIND_FOLDER_PREFIX)
+
+    @JvmStatic
+    fun folderKey(filterId: Int): String = KIND_FOLDER_PREFIX + filterId
+
+    @JvmStatic
+    fun pageTitle(account: Int, slot: Slot): CharSequence? = when {
+        slot.kind == KIND_ARCHIVE -> LocaleController.getString(R.string.TeleTabArchived)
+        slot.kind == KIND_FOLDERS -> LocaleController.getString(R.string.TeleTabFolders)
+        slot.isFolder -> folderTitle(account, slot.filterId)
+        else -> null
+    }
+
+    @JvmStatic
+    fun folderTitle(account: Int, filterId: Int): CharSequence? {
+        val filter = MessagesController.getInstance(account).dialogFiltersById.get(filterId) ?: return null
+        return if (filter.isDefault) LocaleController.getString(R.string.FilterAllChats) else filter.name
+    }
+
+    /** The stock order and pages of the account; the toggle stays as it is. */
+    @JvmStatic
+    fun reset(account: Int) {
+        save(defaults(account))
+    }
+
+    @JvmStatic
+    fun chatKey(dialogId: Long): String = KIND_CHAT_PREFIX + dialogId
+
+    @JvmStatic
+    fun miniAppKey(botId: Long): String = KIND_MINIAPP_PREFIX + botId
+
+    @JvmField
+    val PAGE_KINDS = listOf(
+        KIND_CHATS, KIND_CONTACTS, KIND_CALLS, KIND_SETTINGS, KIND_PROFILE,
+        KIND_ARCHIVE, KIND_FOLDERS, KIND_TELE_SETTINGS, KIND_SEARCH, KIND_NOTIFICATIONS, KIND_DATA_USAGE,
+        KIND_SETTINGS_THEME, KIND_SETTINGS_NOTIFICATIONS, KIND_SETTINGS_DATA_USAGE, KIND_SETTINGS_PRIVACY, KIND_SETTINGS_FOLDERS
+    )
+    private val ACTION_SHORTCUT_KINDS = setOf(KIND_NEW_MESSAGE, KIND_CAMERA, KIND_CONTACTS_SAVED)
+
+    class Slot(val kind: String, val iconName: String = "", val botHash: Long = 0L) {
+        val key: String get() = kind
+        val isActionShortcut: Boolean get() = kind in ACTION_SHORTCUT_KINDS
+        val isShortcut: Boolean get() = kind == KIND_SAVED || kind.startsWith(KIND_CHAT_PREFIX) || isActionShortcut
+        val isPage: Boolean get() = !isShortcut
+        val isFolder: Boolean get() = isFolderKind(kind)
+        val filterId: Int
+            get() = if (isFolder) kind.substring(KIND_FOLDER_PREFIX.length).toIntOrNull() ?: -1 else -1
+        val isMiniApp: Boolean get() = kind.startsWith(KIND_MINIAPP_PREFIX)
+        val dialogId: Long
+            get() = if (kind.startsWith(KIND_CHAT_PREFIX)) {
+                kind.substring(KIND_CHAT_PREFIX.length).toLongOrNull() ?: 0
+            } else {
+                0
+            }
+        val botId: Long
+            get() = if (isMiniApp) {
+                kind.substring(KIND_MINIAPP_PREFIX.length).toLongOrNull() ?: 0
+            } else {
+                0
+            }
+    }
+
+    private var version = 0
+    @JvmStatic
+    fun version(): Int = version
+
+    @JvmStatic
+    fun onChanged() {
+        version++
+        cachedRaw = null
+    }
+
+    private var cachedRaw: String? = null
+    private var cachedAccount = -1
+    private var cachedSlots: List<Slot> = emptyList()
+
+    @JvmStatic
+    fun slots(account: Int): List<Slot> {
+        val raw = TeleConfig.MAIN_TABS_CONFIG.value
+        if (raw == cachedRaw && account == cachedAccount) return cachedSlots
+        val parsed = parse(raw)
+        val list = if (parsed.isNullOrEmpty()) defaults(account) else normalize(parsed, account)
+        cachedRaw = raw
+        cachedAccount = account
+        cachedSlots = list
+        return list
+    }
+
+    @JvmStatic
+    fun save(slots: List<Slot>) {
+        TeleConfig.set(TeleConfig.MAIN_TABS_CONFIG, serialize(normalize(slots, UserConfig.selectedAccount)))
+        onChanged()
+    }
+
+    /** Hiding calls leaves the settings page in its place, like the stock bar does. */
+    @JvmStatic
+    fun remove(account: Int, key: String) {
+        val list = ArrayList(slots(account))
+        val index = list.indexOfFirst { it.key == key }
+        if (index < 0) return
+        if (key == KIND_CALLS && list.none { it.kind == KIND_SETTINGS }) {
+            list[index] = Slot(KIND_SETTINGS)
+        } else {
+            list.removeAt(index)
+        }
+        save(list)
+    }
+
+    @JvmStatic
+    fun pageCount(account: Int): Int = slots(account).count { it.isPage }
+
+    @JvmStatic
+    fun pageSlotAt(account: Int, position: Int): Slot? {
+        if (position < 0) return null
+        var index = 0
+        for (slot in slots(account)) {
+            if (!slot.isPage) continue
+            if (index == position) return slot
+            index++
+        }
+        return null
+    }
+
+    @JvmStatic
+    fun pagePosition(account: Int, kind: String): Int {
+        var index = 0
+        for (slot in slots(account)) {
+            if (!slot.isPage) continue
+            if (slot.kind == kind) return index
+            index++
+        }
+        return -1
+    }
+
+    @JvmStatic
+    fun chatsPosition(account: Int): Int = pagePosition(account, KIND_CHATS)
+
+    private fun defaults(account: Int): List<Slot> {
+        val calls = account in 0 until UserConfig.MAX_ACCOUNT_COUNT && UserConfig.getInstance(account).showCallsTab
+        return listOf(
+            Slot(KIND_CHATS),
+            Slot(KIND_CONTACTS),
+            Slot(if (calls) KIND_CALLS else KIND_SETTINGS),
+            Slot(KIND_PROFILE)
+        )
+    }
+
+    private fun normalize(input: List<Slot>, account: Int): List<Slot> {
+        val out = ArrayList<Slot>(MAX_SLOTS)
+        val seen = HashSet<String>()
+        fun add(slot: Slot) {
+            if (out.size >= MAX_SLOTS || !seen.add(slot.key)) return
+            out.add(slot)
+        }
+        for (slot in input) {
+            val valid = slot.kind == KIND_CHATS || slot.kind in PAGE_KINDS || isTeleSettingsKind(slot.kind) || slot.kind == KIND_SAVED || slot.isActionShortcut ||
+                (slot.kind.startsWith(KIND_CHAT_PREFIX) && slot.dialogId != 0L) ||
+                (slot.isFolder && MessagesController.getInstance(account).dialogFiltersById.get(slot.filterId) != null) ||
+                (slot.isMiniApp && slot.botId > 0L)
+            if (valid) add(slot)
+        }
+        if (out.none { it.kind == KIND_CHATS }) {
+            out.add(0, Slot(KIND_CHATS))
+            if (out.size > MAX_SLOTS) out.removeAt(out.lastIndex)
+        }
+        return out
+    }
+
+    private fun serialize(slots: List<Slot>): String {
+        val array = JSONArray()
+        for (slot in slots) {
+            val object_ = JSONObject()
+            object_.put("kind", slot.kind)
+            if (slot.iconName.isNotEmpty()) object_.put("icon", slot.iconName)
+            if (slot.botHash != 0L) object_.put("hash", slot.botHash)
+            array.put(object_)
+        }
+        return JSONObject().put("version", 1).put("slots", array).toString()
+    }
+
+    private fun parse(raw: String): List<Slot>? {
+        if (raw.isBlank()) return null
+        return runCatching {
+            val array = JSONObject(raw).optJSONArray("slots") ?: return@runCatching null
+            val out = ArrayList<Slot>(array.length())
+            for (i in 0 until array.length()) {
+                val object_ = array.optJSONObject(i) ?: continue
+                val storedKind = object_.optString("kind", "")
+                if (storedKind.isEmpty()) continue
+                val kind = when (storedKind) {
+                    KIND_NOTIFICATIONS -> KIND_SETTINGS_NOTIFICATIONS
+                    KIND_DATA_USAGE -> KIND_SETTINGS_DATA_USAGE
+                    else -> storedKind
+                }
+                out.add(Slot(kind, object_.optString("icon", ""), object_.optLong("hash", 0L)))
+            }
+            out
+        }.getOrElse {
+            FileLog.e(it)
+            null
+        }
+    }
+}
