From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: test <test@example.com>
Date: Sun, 22 Nov 2026 17:25:29 +0300
Subject: [PATCH] feat: mark new tele toggles with NEW

---
 .../main/java/tele/ui/settings/TeleSettingsActivity.kt | 10 ++++++----
 1 file changed, 6 insertions(+), 4 deletions(-)

diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
index 3cda1b9a3..7492abfd0 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
@@ -688,13 +688,15 @@ class TeleSettingsActivity @JvmOverloads constructor(
             val title = row.title.orEmpty()
             val shown = lc(displayTitle(title))
             val subtitle = row.subtitle?.let { lc(it) }
+            val isNew = row.item?.key?.let { tele.helpers.TeleNewSettings.fresh().contains(it) } == true && !tele.helpers.TeleNewSettings.isSeen()
+            val shownWithBadge = if (isNew) tele.helpers.TeleNewSettings.withBadge(shown) else shown
             if (row.type == TYPE_HEADER) {
                 items.add(UItem.asHeader(position, shown))
             } else {
                 items.add(when (row.type) {
                     TYPE_TOGGLE -> {
                         if (row.expandable) {
-                            UItem.asExpandableSwitch(position, shown, lc("%d on").format(row.childCount)).apply {
+                            UItem.asExpandableSwitch(position, shownWithBadge, lc("%d on").format(row.childCount)).apply {
                                  checked = row.item!!.value as Boolean
                                  collapsed = !expandedGroups.contains(row.item.key)
                                 clickCallback = View.OnClickListener { toggleExpanded(row) }
@@ -703,7 +705,7 @@ class TeleSettingsActivity @JvmOverloads constructor(
                                     cell.setCollapseSwitchClick { setGroupValue(row, !(row.item!!.value as Boolean)) }
                                     cell.setCollapseDividerVisible(false)
                                     if (!subtitle.isNullOrEmpty()) {
-                                         cell.setTextAndValue(shown, subtitle, true, divider)
+                                         cell.setTextAndValue(shownWithBadge, subtitle, true, divider)
                                      }
                                      cell.setPadding(0, 0, 0, 0)
                                      cell.setCollapseLayout(AndroidUtilities.dp(140f), true)
@@ -711,14 +713,14 @@ class TeleSettingsActivity @JvmOverloads constructor(
                              }
                         } else {
                             val parentEnabled = row.parent?.value as? Boolean ?: true
-                            UItem.asSwitchNoIcon(position, shown).apply {
+                            UItem.asSwitchNoIcon(position, shownWithBadge).apply {
                                 checked = row.item!!.value as Boolean
                                 enabled = parentEnabled
                                 bind = Utilities.Callback { view: View ->
                                     val cell = view as TextCheckCell2
                                     cell.clearCollapseLayout()
                                     if (!subtitle.isNullOrEmpty()) {
-                                        cell.setTextAndValueAndCheck(shown, subtitle, checked, true, divider)
+                                        cell.setTextAndValueAndCheck(shownWithBadge, subtitle, checked, true, divider)
                                     }
                                     cell.setPadding(if (row.indent > 0) AndroidUtilities.dp(16f) else 0, 0, 0, 0)
                                     cell.setEnabled(parentEnabled)
