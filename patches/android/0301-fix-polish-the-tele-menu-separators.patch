 package tele.helpers
 
+import android.view.View
 import org.telegram.messenger.R
+import org.telegram.ui.ActionBar.ActionBarPopupWindow
 import tele.Item
 import tele.db.TeleDatabaseHelper
 
@@ -434,6 +436,38 @@ object TeleMenuLayout {
         submenuChildCounts.clear(); submenuChildCounts.addAll(counts)
     }
 
+    /**
+     * Hides the runtime separators that end up next to each other, at the top or at the bottom
+     * once the stock code hides some of the rows between them, like the translate item.
+     */
+    @JvmStatic
+    fun collapseSeparators(layout: ActionBarPopupWindow.ActionBarPopupWindowLayout, separators: List<View>) {
+        if (separators.isEmpty()) return
+        var contentSince = false
+        var pending: View? = null
+        for (i in 0 until layout.viewsCount) {
+            val view = layout.getItemAt(i) ?: continue
+            if (view.visibility != View.VISIBLE) continue
+            if (!separators.contains(view)) {
+                contentSince = true
+                pending = null
+                continue
+            }
+            if (contentSince) {
+                contentSince = false
+                pending = view
+            } else if (pending != null && isThickSeparator(view) && !isThickSeparator(pending)) {
+                pending.visibility = View.GONE
+                pending = view
+            } else {
+                view.visibility = View.GONE
+            }
+        }
+        pending?.visibility = View.GONE
+    }
+
+    private fun isThickSeparator(view: View): Boolean = view is ActionBarPopupWindow.GapView
+
     private fun submenuIcon(title: String): Int = when (title) {
         "Tools" -> R.drawable.msg_settings
         "tele" -> R.drawable.tele_flask
@@ -573,19 +607,20 @@ object TeleMenuLayout {
