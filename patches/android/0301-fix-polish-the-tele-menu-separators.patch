From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: test <test@example.com>
Date: Sat, 7 Nov 2026 16:46:46 +0300
Subject: [PATCH] fix: polish the tele menu separators

---
 .../telegram/ui/ActionBar/ActionBarPopupWindow.java |  6 +++++-
 .../src/main/java/tele/helpers/TeleMenuLayout.kt    | 13 +++++++------
 2 files changed, 12 insertions(+), 7 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/ActionBar/ActionBarPopupWindow.java b/TMessagesProj/src/main/java/org/telegram/ui/ActionBar/ActionBarPopupWindow.java
index e61b8fc40..418f5ce78 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/ActionBar/ActionBarPopupWindow.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/ActionBar/ActionBarPopupWindow.java
@@ -1114,7 +1114,11 @@ public class ActionBarPopupWindow extends PopupWindow {
 
         public ThinGapView(Context context, Theme.ResourcesProvider resourcesProvider) {
             super(context);
-            linePaint.setColor(Theme.getColor(Theme.key_divider, resourcesProvider));
+            final int background = Theme.getColor(Theme.key_actionBarDefaultSubmenuBackground, resourcesProvider);
+            final int color = AndroidUtilities.computePerceivedBrightness(background) < 0.5f
+                    ? 0x40FFFFFF
+                    : Theme.getColor(Theme.key_divider, resourcesProvider);
+            linePaint.setColor(color);
         }
 
         @Override
diff --git a/TMessagesProj/src/main/java/tele/helpers/TeleMenuLayout.kt b/TMessagesProj/src/main/java/tele/helpers/TeleMenuLayout.kt
index 53e8fb889..ac9510451 100644
--- a/TMessagesProj/src/main/java/tele/helpers/TeleMenuLayout.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/TeleMenuLayout.kt
@@ -573,19 +573,20 @@ object TeleMenuLayout {
             addIndex(index, false)
         }
         if (tailTools != null) {
-            if (sortedItems.isNotEmpty()) {
+            val before = sortedItems.size
+            addEntries(listOf(tailTools), 0)
+            if (sortedItems.size > before && before > 0) {
                 var style: TeleMenuEntry.Separator.Style? = null
                 for (separator in tailToolsSeparators) {
                     if (separator.enabled) style = thicker(style, separator.style)
                 }
                 val finalStyle = style
-                if (finalStyle != null && !isRuntimeSeparator(sortedOptions.last())) {
-                    sortedItems.add("")
-                    sortedIcons.add(0)
-                    sortedOptions.add(separatorOption(finalStyle))
+                if (finalStyle != null && !isRuntimeSeparator(sortedOptions[before - 1])) {
+                    sortedItems.add(before, "")
+                    sortedIcons.add(before, 0)
+                    sortedOptions.add(before, separatorOption(finalStyle))
                 }
             }
-            addEntries(listOf(tailTools), 0)
         }
         items.clear(); items.addAll(sortedItems)
         icons.clear(); icons.addAll(sortedIcons)
