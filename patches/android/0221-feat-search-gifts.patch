+import android.widget.LinearLayout
+import android.widget.TextView
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.AndroidUtilities.dp
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.R
+import org.telegram.tgnet.tl.TL_stars
+import org.telegram.ui.ActionBar.BaseFragment
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Components.EditTextCaption
+import org.telegram.ui.Components.ItemOptions
+import org.telegram.ui.Components.LayoutHelper
+import org.telegram.ui.Components.RecyclerListView
+import org.telegram.ui.Components.UItem
+import org.telegram.ui.Components.UniversalAdapter
+import org.telegram.ui.Components.UniversalRecyclerView
+import org.telegram.ui.Gifts.ProfileGiftsContainer
+import org.telegram.ui.Gifts.ResaleGiftsFragment
+import org.telegram.ui.ProfileActivity
+import tele.helpers.GiftSearch
+
+/** The field and the three attribute chips above the gifts of a profile (desktop 0186). */
+class TeleGiftSearchView(
+    context: Context,
+    private val resourcesProvider: Theme.ResourcesProvider?,
+    private val currentAccount: Int
+) : LinearLayout(context) {
+
+    private var search: GiftSearch? = null
+    private var fragment: BaseFragment? = null
+    private val field = EditTextCaption(context, resourcesProvider)
+    private val clearView = ImageView(context)
+    private val chips = Array(GiftSearch.CHIPS) { ResaleGiftsFragment.Filter(context, resourcesProvider) }
+    private val statusView = TextView(context)
+    private var syncing = false
+    private val refresh = Runnable { sync() }
+
+    init {
+        orientation = VERTICAL
+        setPadding(dp(3f), 0, dp(3f), dp(6f))
+
+        val textColor = Theme.getColor(Theme.key_windowBackgroundWhiteBlackText, resourcesProvider)
+        val box = FrameLayout(context)
+        box.background = Theme.createRoundRectDrawable(dp(10f), Theme.multAlpha(textColor, .06f))
+        addView(box, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, 40, 0f, 6f, 0f, 0f))
+
+        val icon = ImageView(context)
+        icon.scaleType = ImageView.ScaleType.CENTER
+        icon.setImageResource(R.drawable.smiles_inputsearch)
+        icon.colorFilter = PorterDuffColorFilter(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText3, resourcesProvider), PorterDuff.Mode.SRC_IN)
+        box.addView(icon, LayoutHelper.createFrame(24, 24f, Gravity.CENTER_VERTICAL or Gravity.LEFT, 10f, 0f, 0f, 0f))
+
+        field.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16f)
+        field.inputType = InputType.TYPE_CLASS_TEXT or InputType.TYPE_TEXT_FLAG_NO_SUGGESTIONS
+        field.setRawInputType(InputType.TYPE_CLASS_TEXT or InputType.TYPE_TEXT_FLAG_NO_SUGGESTIONS)
+        field.imeOptions = EditorInfo.IME_ACTION_SEARCH
+        field.setSingleLine(true)
+        field.setHintTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText3, resourcesProvider))
+        field.setCursorColor(textColor)
+        field.setCursorSize(dp(19f))
+        field.setCursorWidth(1.5f)
+        field.hint = LocaleController.getString(R.string.Search)
+        field.setTextColor(textColor)
+        field.background = null
+        box.addView(field, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT.toFloat(), Gravity.CENTER_VERTICAL or Gravity.LEFT, 43f, 0f, 40f, 0f))
+        field.addTextChangedListener(object : TextWatcher {
+            override fun beforeTextChanged(s: CharSequence?, start: Int, count: Int, after: Int) {}
+            override fun onTextChanged(s: CharSequence?, start: Int, before: Int, count: Int) {}
+            override fun afterTextChanged(s: Editable?) {
+                clearView.visibility = if (s.isNullOrEmpty()) GONE else VISIBLE
+                if (!syncing) search?.setQuery(s?.toString() ?: "")
+            }
+        })
+        field.setOnEditorActionListener { _, _, _ ->
+            AndroidUtilities.hideKeyboard(field)
+            field.clearFocus()
+            true
+        }
+        field.setOnFocusChangeListener { _, focused ->
+            val owner = fragment
+            val activity = owner?.parentActivity
+            if (owner != null && activity != null) {
+                // the profile does not resize for the keyboard otherwise
+                if (focused) {
+                    AndroidUtilities.requestAdjustResize(activity, owner.classGuid)
+                    reveal()
+                    // again once the keyboard has resized the list
+                    postDelayed({ if (field.isFocused) reveal() }, 350)
+                } else {
+                    AndroidUtilities.requestAdjustNothing(activity, owner.classGuid)
+                }
+            }
+        }
+
+        clearView.scaleType = ImageView.ScaleType.CENTER
+        clearView.setImageResource(R.drawable.msg_close)
+        clearView.colorFilter = PorterDuffColorFilter(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText3, resourcesProvider), PorterDuff.Mode.SRC_IN)
+        clearView.visibility = GONE
+        clearView.setOnClickListener { field.setText("") }
+        box.addView(clearView, LayoutHelper.createFrame(40f, 40f, Gravity.CENTER_VERTICAL or Gravity.RIGHT))
+
+        val scroll = HorizontalScrollView(context)
+        scroll.isHorizontalScrollBarEnabled = false
+        val row = LinearLayout(context)
+        row.orientation = HORIZONTAL
+        row.gravity = Gravity.CENTER_VERTICAL
+        scroll.addView(row, LayoutHelper.createFrame(LayoutHelper.WRAP_CONTENT, LayoutHelper.WRAP_CONTENT.toFloat()))
+        addView(scroll, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, 26, 0f, 8f, 0f, 0f))
+        for ((index, chip) in chips.withIndex()) {
+            chip.setOnClickListener { showMenu(index) }
+            row.addView(chip, LayoutHelper.createLinear(LayoutHelper.WRAP_CONTENT, LayoutHelper.WRAP_CONTENT, Gravity.CENTER_VERTICAL, 0, 0, 6, 0))
+        }
+        statusView.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13f)
+        statusView.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText, resourcesProvider))
+        statusView.text = LocaleController.getString(R.string.Loading)
+        statusView.visibility = GONE
+        row.addView(statusView, LayoutHelper.createLinear(LayoutHelper.WRAP_CONTENT, LayoutHelper.WRAP_CONTENT, Gravity.CENTER_VERTICAL, 4, 0, 6, 0))
+    }
+
+    fun bind(search: GiftSearch, fragment: BaseFragment?) {
+        this.fragment = fragment
+        if (this.search !== search) {
+            this.search?.removeViewListener(refresh)
+            this.search = search
+            if (isAttachedToWindow) search.addViewListener(refresh)
+        }
+        sync()
+    }
+
+    // the state of the search changed elsewhere: another page's field, a chip, the loading
+    private fun sync() {
+        val search = search ?: return
+        if (field.text.toString() != search.query) {
+            syncing = true
+            field.setText(search.query)
+            syncing = false
+        }
+        for ((index, chip) in chips.withIndex()) chip.setValue(GiftSearch.chipText(search, index))
+        if (search.truncated) {
+            statusView.text = tele.helpers.TeleLowercase.lc("Only the first gifts are searched")
+            statusView.visibility = VISIBLE
+        } else {
+            statusView.visibility = if (search.isLoading()) VISIBLE else GONE
+        }
+    }
+
+    // the field goes right under the pinned tabs and the profile scrolls its gifts to the top
+    private fun reveal() {
+        (fragment as? ProfileActivity)?.scrollToSharedMedia(true)
+        var parent = parent
+        while (parent != null && parent !is ProfileGiftsContainer.Page) parent = parent.parent
+        (parent as? ProfileGiftsContainer.Page)?.revealSearch()
+    }
+
+    override fun onAttachedToWindow() {
+        super.onAttachedToWindow()
+        search?.addViewListener(refresh)
+        sync()
+    }
+
+    override fun onDetachedFromWindow() {
+        super.onDetachedFromWindow()
+        search?.removeViewListener(refresh)
+    }
+
+    private fun showMenu(index: Int) {
+        val search = search ?: return
+        val fragment = fragment ?: return
+        search.load()
+        if (search.values(index).isEmpty()) return
+        val menu = ItemOptions.makeOptions(fragment, chips[index], false, true)
+            .setDrawScrim(false)
+            .setOnTopOfScrim()
+            .translate(0f, dp(-8f).toFloat())
+            .needsFocus()
+        var query = ""
+        var list: UniversalRecyclerView? = null
+        val listView = object : UniversalRecyclerView(
+            fragment,
+            { items, _ ->
+                // the same match as the stock resale filters: a word start, also in the other keyboard layout
+                val q = query.lowercase()
+                val tq = AndroidUtilities.translitSafe(q)
+                // the gifts keep loading while the menu is open
+                for (value in search.values(index)) {
+                    val name = value.name.lowercase()
+                    if (q.isNotEmpty() && !name.startsWith(q) && !name.startsWith(tq) && !name.contains(" $q") && !name.contains(" $tq")) continue
+                    // nothing picked means every value counts
+                    val checked = search.selectedCount(index) == 0 || search.isSelected(index, value.name)
+                    items.add(valueItem(value, q).setChecked(checked))
+                }
+            },
+            { item, _, _, _, _ ->
+                val attribute = item.`object` as? TL_stars.StarGiftAttribute
+                val name = attribute?.name
+                if (name != null) {
+                    search.toggle(index, name)
+                    list?.adapter?.update(true)
+                }
+            },
+            null
+        ) {
+            override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
+                super.onMeasure(
+                    widthMeasureSpec,
+                    MeasureSpec.makeMeasureSpec(
+                        Math.min((AndroidUtilities.displaySize.y * 0.35f).toInt(), MeasureSpec.getSize(heightMeasureSpec)),
+                        MeasureSpec.getMode(heightMeasureSpec)
+                    )
+                )
+            }
+        }
+        list = listView
+        listView.adapter.setApplyBackground(false)
+
+        val searchLayout = FrameLayout(context)
+        val searchIcon = ImageView(context)
+        searchIcon.scaleType = ImageView.ScaleType.CENTER
+        searchIcon.setImageResource(R.drawable.smiles_inputsearch)
+        searchIcon.colorFilter = PorterDuffColorFilter(Theme.getColor(Theme.key_actionBarDefaultSubmenuItemIcon, resourcesProvider), PorterDuff.Mode.SRC_IN)
+        searchLayout.addView(searchIcon, LayoutHelper.createFrame(24, 24f, Gravity.CENTER_VERTICAL or Gravity.LEFT, 10f, 0f, 0f, 0f))
+        val editText = EditTextCaption(context, resourcesProvider)
+        editText.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16f)
+        val inputType = InputType.TYPE_TEXT_FLAG_CAP_SENTENCES or InputType.TYPE_CLASS_TEXT or InputType.TYPE_TEXT_FLAG_AUTO_CORRECT or InputType.TYPE_TEXT_FLAG_NO_SUGGESTIONS
+        editText.inputType = inputType
+        editText.setRawInputType(inputType)
+        editText.setHintTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText3, resourcesProvider))
+        editText.setCursorColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText, resourcesProvider))
+        editText.setCursorSize(dp(19f))
+        editText.setCursorWidth(1.5f)
+        editText.hint = LocaleController.getString(R.string.Gift2ResaleFiltersSearch)
+        editText.setTextColor(Theme.getColor(Theme.key_actionBarDefaultSubmenuItem, resourcesProvider))
+        editText.background = null
+        searchLayout.addView(editText, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT.toFloat(), Gravity.CENTER_VERTICAL or Gravity.LEFT, 43f, 0f, 8f, 0f))
+        editText.addTextChangedListener(object : TextWatcher {
+            override fun beforeTextChanged(s: CharSequence?, start: Int, count: Int, after: Int) {}
+            override fun onTextChanged(s: CharSequence?, start: Int, before: Int, count: Int) {}
+            override fun afterTextChanged(s: Editable?) {
+                query = s?.toString().orEmpty()
+                listView.adapter.update(true)
+            }
+        })
+        menu.addView(searchLayout, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, 44))
+        menu.addGap()
+
+        if (search.selectedCount(index) > 0) {
+            menu.add(R.drawable.msg_select, LocaleController.getString(R.string.SelectAll)) {
+                search.clear(index)
+                listView.adapter.update(true)
+            }
+        }
+        menu.addView(listView)
+        val live = Runnable { listView.adapter.update(true) }
+        search.addViewListener(live)
+        menu.setOnDismiss {
+            search.removeViewListener(live)
+            AndroidUtilities.hideKeyboard(editText)
+        }
+        menu.show()
+    }
+
+    private fun valueItem(value: GiftSearch.Value, query: String): UItem = when (val attribute = value.attribute) {
+        is TL_stars.starGiftAttributeModel -> ResaleGiftsFragment.ModelItem.Factory.asModel(attribute, value.count, query)
+        is TL_stars.starGiftAttributePattern -> ResaleGiftsFragment.PatternItem.Factory.asPattern(attribute, value.count, query)
+        else -> ResaleGiftsFragment.BackdropItem.Factory.asBackdrop(attribute as TL_stars.starGiftAttributeBackdrop, value.count, query)
+    }
+}
+
+class TeleGiftSearchFactory : UItem.UItemFactory<TeleGiftSearchView>() {
+
+    override fun createView(
+        context: Context,
+        listView: RecyclerListView?,
+        currentAccount: Int,
+        classGuid: Int,
+        resourcesProvider: Theme.ResourcesProvider?
+    ): TeleGiftSearchView = TeleGiftSearchView(context, resourcesProvider, currentAccount)
+
+    override fun bindView(view: View, item: UItem, divider: Boolean, adapter: UniversalAdapter, listView: UniversalRecyclerView) {
+        (view as TeleGiftSearchView).bind(item.`object` as GiftSearch, item.object2 as? BaseFragment)
+    }
+
+    // the same search keeps its view: a rebind would drop the focus of the field
+    override fun equals(a: UItem, b: UItem): Boolean = a.`object` === b.`object`
+
+    override fun contentsEquals(a: UItem, b: UItem): Boolean = a.`object` === b.`object`
+
+    companion object {
+        init {
+            UItem.UItemFactory.setup(TeleGiftSearchFactory())
+        }
+
+        @JvmStatic
+        fun asSearch(search: GiftSearch, fragment: BaseFragment?): UItem {
+            val item = UItem.ofFactory(TeleGiftSearchFactory::class.java)
+            item.`object` = search
+            item.object2 = fragment
+            return item
+        }
+    }
+}
