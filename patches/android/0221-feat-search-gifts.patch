diff --git a/TMessagesProj/src/main/java/tele/helpers/GiftSearch.kt b/TMessagesProj/src/main/java/tele/helpers/GiftSearch.kt
new file mode 100644
index 000000000..304ab8014
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/GiftSearch.kt
@@ -0,0 +1,327 @@
+package tele.helpers
+
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.MessagesController
+import org.telegram.messenger.R
+import org.telegram.tgnet.ConnectionsManager
+import org.telegram.tgnet.TLRPC
+import org.telegram.tgnet.tl.TL_stars
+import org.telegram.ui.Stars.StarsController
+import tele.TeleConfig
+import java.util.WeakHashMap
+
+/**
+ * Search in the gifts of a profile (desktop 0186): collectible gifts only, by title, number, model,
+ * backdrop and symbol, plus a menu of values for each of the three attributes. All the collectibles of
+ * the profile are loaded for it, 100 at a time, as soon as the gifts are shown, so the menus are complete.
+ */
+class GiftSearch private constructor(
+    private val currentAccount: Int,
+    private val dialogId: Long,
+    private val allList: StarsController.GiftsList,
+    private val changed: Runnable
+) {
+
+    /** One value of an attribute in the menu of a chip. */
+    class Value(@JvmField val name: String, @JvmField var count: Int, @JvmField val attribute: TL_stars.StarGiftAttribute)
+
+    private class Item(val gift: TL_stars.SavedStarGift, unique: TL_stars.TL_starGiftUnique) {
+        val attributes = arrayOf<TL_stars.StarGiftAttribute?>(
+            StarsController.findAttribute(unique.attributes, TL_stars.starGiftAttributeModel::class.java),
+            StarsController.findAttribute(unique.attributes, TL_stars.starGiftAttributeBackdrop::class.java),
+            StarsController.findAttribute(unique.attributes, TL_stars.starGiftAttributePattern::class.java)
+        )
+        // one string per item: a list of lowercased copies of every field is what fills the heap
+        val haystack: String = buildString {
+            unique.title?.let { append(it.lowercase()).append('\n') }
+            append('#').append(unique.num).append('\n')
+            for (attribute in attributes) {
+                attribute?.name?.let { append(it.lowercase()).append('\n') }
+            }
+        }
+    }
+
+    private val items = ArrayList<Item>()
+    private val keys = HashSet<String>()
+    private val viewListeners = ArrayList<Runnable>()
+    private var offset = ""
+    private var requestId = 0
+    private var loaded = false
+    private var words: List<String> = emptyList()
+
+    // model, backdrop, symbol
+    private val selected = Array(CHIPS) { LinkedHashSet<String>() }
+
+    /** What the user typed; the field of the header restores it. */
+    var query = ""
+        private set
+
+    /** The found gifts in the order they are shown; the sheet of a gift pages through them. */
+    @JvmField
+    val results = Results()
+
+    fun isActive(): Boolean = words.isNotEmpty() || selected.any { it.isNotEmpty() }
+
+    /** More gifts are still coming. */
+    fun isLoading(): Boolean = requestId != 0
+
+    /** Every collectible of the profile is here. */
+    fun isLoaded(): Boolean = loaded
+
+    fun addViewListener(listener: Runnable) {
+        viewListeners.add(listener)
+    }
+
+    fun removeViewListener(listener: Runnable) {
+        viewListeners.remove(listener)
+    }
+
+    fun setQuery(text: String) {
+        val now = text.trim().lowercase().split(Regex("\\s+")).filter { it.isNotEmpty() }
+        query = text
+        if (now == words) return
+        words = now
+        if (words.isNotEmpty()) load()
+        notifyChanged()
+    }
+
+    fun isSelected(index: Int, name: String): Boolean = selected[index].contains(name)
+
+    fun selectedCount(index: Int): Int = selected[index].size
+
+    fun selectedNames(index: Int): Set<String> = selected[index]
+
+    fun toggle(index: Int, name: String) {
+        if (!selected[index].remove(name)) selected[index].add(name)
+        notifyChanged()
+    }
+
+    fun clear(index: Int) {
+        if (selected[index].isEmpty()) return
+        selected[index].clear()
+        notifyChanged()
+    }
+
+    /** The values of an attribute among the loaded gifts, the most common first. */
+    fun values(index: Int): List<Value> {
+        val map = LinkedHashMap<String, Value>()
+        for (item in items) {
+            val attribute = item.attributes[index] ?: continue
+            val name = attribute.name
+            if (name.isNullOrEmpty()) continue
+            val value = map.getOrPut(name) { Value(name, 0, attribute) }
+            value.count++
+        }
+        return map.values.sortedByDescending { it.count }
+    }
+
+    private fun notifyChanged() {
+        for (listener in ArrayList(viewListeners)) listener.run()
+        // the pages only differ while a search is open, or when it just closed
+        val now = isActive()
+        if (now || shownActive) changed.run()
+        shownActive = now
+    }
+
+    /** Starts the loading of the profile's collectibles, or does nothing when it runs or is done. */
+    fun load() {
+        wanted = true
+        if (requestId != 0 || loaded) return
+        val request = TL_stars.getSavedStarGifts()
+        request.exclude_unlimited = true
+        request.exclude_unupgradable = true
+        request.exclude_upgradable = true
+        request.peer = if (dialogId == 0L) TLRPC.TL_inputPeerSelf() else MessagesController.getInstance(currentAccount).getInputPeer(dialogId)
+        request.offset = offset
+        request.limit = PER_PAGE
+        val generation = ++epoch
+        requestId = ConnectionsManager.getInstance(currentAccount).sendRequest(request) { response, _ ->
+            AndroidUtilities.runOnUIThread {
+                if (generation != epoch) return@runOnUIThread
+                requestId = 0
+                if (response is TL_stars.TL_payments_savedStarGifts) {
+                    done(response)
+                } else {
+                    // stays unloaded: the next use tries again
+                    notifyChanged()
+                }
+            }
+        }
+        notifyChanged()
+    }
+
+    private var epoch = 0
+    private var wanted = false
+    private var shownActive = false
+
+    /** The collectibles of a huge profile did not all fit: the search covers only what was loaded. */
+    var truncated = false
+        private set
+
+    private fun done(result: TL_stars.TL_payments_savedStarGifts) {
+        val messages = MessagesController.getInstance(currentAccount)
+        messages.putUsers(result.users, false)
+        messages.putChats(result.chats, false)
+        for (gift in result.gifts) {
+            val unique = gift.gift as? TL_stars.TL_starGiftUnique ?: continue
+            if (!keys.add(GiftSelection.key(gift))) continue
+            items.add(Item(gift, unique))
+        }
+        val next = result.next_offset
+        if (next.isNullOrEmpty() || result.gifts.isEmpty() || items.size >= MAX_ITEMS) {
+            // a profile with tens of thousands of collectibles would not fit in the heap
+            truncated = items.size >= MAX_ITEMS && !next.isNullOrEmpty() && result.gifts.isNotEmpty()
+            loaded = true
+            org.telegram.messenger.FileLog.d("TeleGiftSearch: items=" + items.size + " truncated=" + truncated)
+        } else {
+            offset = next
+        }
+        notifyChanged()
+        if (!loaded) load()
+    }
+
+    /** A gift left the profile: it is gone from the results too. */
+    private fun drop(gift: TL_stars.SavedStarGift) {
+        val key = GiftSelection.key(gift)
+        if (keys.remove(key)) {
+            items.removeAll { GiftSelection.key(it.gift) == key }
+            if (isActive()) notifyChanged()
+        }
+    }
+
+    /** The profile's gifts were reloaded: start over, and load again when a search is open. */
+    private fun reset() {
+        epoch++
+        if (requestId != 0) {
+            ConnectionsManager.getInstance(currentAccount).cancelRequest(requestId, true)
+            requestId = 0
+        }
+        items.clear()
+        keys.clear()
+        offset = ""
+        loaded = false
+        if (wanted || isActive()) {
+            load()
+            notifyChanged()
+        }
+    }
+
+    private fun matches(item: Item): Boolean {
+        for (i in 0 until CHIPS) {
+            val names = selected[i]
+            if (names.isNotEmpty() && item.attributes[i]?.name !in names) return false
+        }
+        return words.all { word -> item.haystack.contains(word) }
+    }
+
+    /** The gifts that match, as the page of [list] would show them: its collection and visibility filters apply. */
+    fun found(list: StarsController.GiftsList): ArrayList<TL_stars.SavedStarGift> {
+        val skipSaved = !list.isInclude_displayed
+        val skipUnsaved = !list.isInclude_hidden
+        // the profile's own objects carry the latest state of a gift
+        val own = HashMap<String, TL_stars.SavedStarGift>()
+        for (gift in allList.gifts) own[GiftSelection.key(gift)] = gift
+        val found = ArrayList<TL_stars.SavedStarGift>()
+        for (item in items) {
+            val gift = item.gift
+            own[GiftSelection.key(gift)]?.let {
+                gift.unsaved = it.unsaved
+                gift.pinned_to_top = it.pinned_to_top
+                gift.collection_id = it.collection_id
+            }
+            if (list.isCollection && !gift.collection_id.contains(list.collectionId)) continue
+            if ((skipSaved && !gift.unsaved) || (skipUnsaved && gift.unsaved)) continue
+            if (!matches(item)) continue
+            found.add(gift)
+        }
+        results.update(found)
+        return found
+    }
+
+    /** The found gifts as a list for the gift sheet. */
+    class Results : StarsController.IGiftsList {
+        private var gifts = ArrayList<TL_stars.SavedStarGift>()
+
+        fun update(gifts: ArrayList<TL_stars.SavedStarGift>) {
+            this.gifts = gifts
+        }
+
+        override fun notifyUpdate() {}
+
+        override fun getLoadedCount(): Int = gifts.size
+
+        override fun set(index: Int, obj: Any?) {
+            if (obj is TL_stars.SavedStarGift && index in gifts.indices) gifts[index] = obj
+        }
+
+        override fun get(index: Int): Any? = gifts.getOrNull(index)
+
+        override fun indexOf(obj: Any?): Int = gifts.indexOf(obj)
+
+        override fun getTotalCount(): Int = gifts.size
+
+        override fun load() {}
+
+        override fun findGiftToUpgrade(from: Int): Int = -1
+    }
+
+    companion object {
+        const val CHIPS = 3
+        private const val PER_PAGE = 100
+
+        // a profile with tens of thousands of collectibles does not fit in the heap: the search covers a part of it
+        private const val MAX_ITEMS = 3000
+
+        private val instances = WeakHashMap<GiftSearch, Boolean>()
+
+        /** The search of a container, or null while the option is off. */
+        @JvmStatic
+        fun create(currentAccount: Int, dialogId: Long, allList: StarsController.GiftsList, changed: Runnable): GiftSearch? {
+            if (!TeleConfig.GIFT_SEARCH.value) return null
+            return GiftSearch(currentAccount, dialogId, allList, changed).also { instances[it] = true }
+        }
+
+        // the profile's lists were reloaded or lost a gift
+        @JvmStatic
+        fun invalidate(currentAccount: Int, dialogId: Long) {
+            for (search in instances.keys.toList()) {
+                if (search.currentAccount == currentAccount && search.dialogId == dialogId) search.reset()
+            }
+        }
+
+        @JvmStatic
+        fun removed(currentAccount: Int, dialogId: Long, gift: TL_stars.SavedStarGift) {
+            for (search in instances.keys.toList()) {
+                if (search.currentAccount == currentAccount && search.dialogId == dialogId) search.drop(gift)
+            }
+        }
+
+        @JvmStatic
+        fun chipName(index: Int): String = LocaleController.getString(
+            when (index) {
+                0 -> R.string.Gift2AttributeModel
+                1 -> R.string.Gift2AttributeBackdrop
+                else -> R.string.Gift2AttributeSymbol
+            }
+        )
+
+        /** The name of a chip: the value when one is picked, how many when several, the attribute otherwise. */
+        @JvmStatic
+        fun chipText(search: GiftSearch, index: Int): String {
+            val names = search.selectedNames(index)
+            return when (names.size) {
+                0 -> chipName(index)
+                1 -> names.first()
+                else -> LocaleController.formatPluralString(
+                    when (index) {
+                        0 -> "TeleGiftsModels"
+                        1 -> "TeleGiftsBackdrops"
+                        else -> "TeleGiftsSymbols"
+                    },
+                    names.size
+                )
+            }
+        }
+    }
+}
