 .../java/org/telegram/ui/ChatActivity.java    | 43 +++++++++++++++++++
 .../src/main/java/tele/helpers/MessageMenu.kt |  8 +++-
 2 files changed, 49 insertions(+), 2 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
index 6bec52878..a9a6cc4f7 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
@@ -1256,6 +1256,8 @@ public class ChatActivity extends BaseFragment implements
     public final static int tele_option_shot = 130;
     public final static int tele_option_copy_service_text = 219;
     public final static int tele_option_copy_file_path = 220;
+    public final static int tele_option_copy_alias = 221;
+    public final static int tele_option_delete_alias = 222;
     public final static int OPTION_ABOUT_REVENUE_SHARING_ADS = 33;
     public final static int OPTION_REPORT_AD = 34;
     public final static int OPTION_REMOVE_ADS = 35;
@@ -33985,6 +33987,27 @@ public class ChatActivity extends BaseFragment implements
                 BulletinFactory.of(this).createCopyBulletin(getString(R.string.TeleMessageIdCopied)).show();
                 break;
             }
+            case tele_option_copy_alias: {
+                String tele_alias = teleAliasOf(selectedObject);
+                if (tele_alias == null) break;
+                AndroidUtilities.addToClipboard("@" + tele_alias);
+                BulletinFactory.of(this).createCopyBulletin(getString(R.string.TeleMessageIdCopied)).show();
+                break;
+            }
+            case tele_option_delete_alias: {
+                final String tele_alias = teleAliasOf(selectedObject);
+                if (tele_alias == null) break;
+                AlertDialog.Builder tele_builder = new AlertDialog.Builder(getParentActivity(), themeDelegate);
+                tele_builder.setTitle("Delete the alias @" + tele_alias + "?");
+                tele_builder.setMessage("The alias will stop pointing to this chat.");
+                tele_builder.setPositiveButton("Delete", (dialog, which) -> {
+                    tele.helpers.Aliases.remove(currentAccount, tele_alias);
+                    closeMenu();
+                });
+                tele_builder.setNegativeButton("Cancel", null);
+                tele_builder.show();
+                break;
+            }
             case tele_option_copy_file_path: {
                 String tele_path = teleLocalFilePath(selectedObject);
                 if (tele_path == null) {
@@ -46515,6 +46538,15 @@ public class ChatActivity extends BaseFragment implements
     private long tele_pressedEmojiId;
     private long tele_menuEmojiId;
 
+    /** The alias of the pressed message, null when the message holds no known alias. */
+    private String teleAliasOf(MessageObject message) {
+        if (message == null || message.messageText == null) return null;
+        for (String alias : tele.helpers.Aliases.findAll(message.messageText)) {
+            if (tele.helpers.Aliases.dialogId(currentAccount, alias) != 0) return alias;
+        }
+        return null;
+    }
+
     /** The path of a downloaded file of a message, null when the file is not on the device. */
     private String teleLocalFilePath(MessageObject message) {
         if (message == null || message.messageOwner == null) return null;
@@ -46552,6 +46584,17 @@ public class ChatActivity extends BaseFragment implements
             options.add(0, tele_option_copy_msg_id);
             icons.add(0, R.drawable.msg_copy);
         }
+        if (tele.TeleConfig.USERNAME_ALIASES.getValue() && message.getId() > 0) {
+            String tele_alias = teleAliasOf(message);
+            if (tele_alias != null) {
+                items.add(0, "Delete alias @" + tele_alias);
+                options.add(0, tele_option_delete_alias);
+                icons.add(0, R.drawable.msg_delete);
+                items.add(0, "Copy alias @" + tele_alias);
+                options.add(0, tele_option_copy_alias);
+                icons.add(0, R.drawable.msg_copy);
+            }
+        }
         if (tele.TeleConfig.COPY_FILE_PATH.getValue() && message.getId() > 0) {
             String tele_path = teleLocalFilePath(message);
             if (tele_path != null) {
diff --git a/TMessagesProj/src/main/java/tele/helpers/MessageMenu.kt b/TMessagesProj/src/main/java/tele/helpers/MessageMenu.kt
index 95e825e22..e4b0f9e35 100644
--- a/TMessagesProj/src/main/java/tele/helpers/MessageMenu.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/MessageMenu.kt
@@ -62,7 +62,9 @@ object MessageMenu {
         Item(ChatActivity.tele_option_mark_viewed, "Mark as viewed", "mark_viewed", TeleConfig.KEEP_DISAPPEARING_MEDIA),
         Item(ChatActivity.tele_option_shot, "shot", "shot", TeleConfig.SHOT),
         Item(ChatActivity.tele_option_copy_service_text, "Copy service text", "copy_service_text", TeleConfig.COPY_SERVICE_TEXT),
-        Item(ChatActivity.tele_option_copy_file_path, "Copy file path", "copy_file_path", TeleConfig.COPY_FILE_PATH)
+        Item(ChatActivity.tele_option_copy_file_path, "Copy file path", "copy_file_path", TeleConfig.COPY_FILE_PATH),
+        Item(ChatActivity.tele_option_copy_alias, "Copy alias", "copy_alias", TeleConfig.USERNAME_ALIASES),
+        Item(ChatActivity.tele_option_delete_alias, "Delete alias", "delete_alias", TeleConfig.USERNAME_ALIASES)
     )
 
     private const val KEY = "message_menu_hidden"
@@ -76,7 +78,9 @@ object MessageMenu {
         ChatActivity.tele_option_shot to TeleConfig.SHOT,
         ChatActivity.tele_option_mark_viewed to TeleConfig.KEEP_DISAPPEARING_MEDIA,
         ChatActivity.tele_option_copy_service_text to TeleConfig.COPY_SERVICE_TEXT,
-        ChatActivity.tele_option_copy_file_path to TeleConfig.COPY_FILE_PATH
+        ChatActivity.tele_option_copy_file_path to TeleConfig.COPY_FILE_PATH,
+        ChatActivity.tele_option_copy_alias to TeleConfig.USERNAME_ALIASES,
+        ChatActivity.tele_option_delete_alias to TeleConfig.USERNAME_ALIASES
     )
 
     private fun loadOrder(): Map<Int, Int> {
