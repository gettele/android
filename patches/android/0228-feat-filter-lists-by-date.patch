+    }
+
+    override fun equals(a: UItem, b: UItem): Boolean = a.`object` === b.`object` && a.object2 === b.object2
+
+    // the loading progress changes while the item stays: always bind again
+    override fun contentsEquals(a: UItem, b: UItem): Boolean = false
+
+    companion object {
+        init {
+            UItem.UItemFactory.setup(TeleDatesBarFactory())
+        }
+
+        @JvmStatic
+        fun asBar(dates: GiftDates, list: StarsController.GiftsList): UItem {
+            val item = UItem.ofFactory(TeleDatesBarFactory::class.java)
+            item.`object` = dates
+            item.object2 = list
+            return item
+        }
+    }
+}
