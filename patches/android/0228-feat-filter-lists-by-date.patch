+/**
+ * The date filter of a list (desktop 0193): a link to pick the days, how far the loading got, or the
+ * chosen days as a chip with a cross. Hidden while idle unless [idleShown].
+ */
+class TeleDatesBar(
+    context: Context,
+    private val resourcesProvider: Theme.ResourcesProvider?,
+    private val idleShown: Boolean,
+    sidePadding: Float
+) : LinearLayout(context) {
+
+    private enum class Mode { IDLE, LOADING, ACTIVE }
+
+    private val pill = LinearLayout(context)
+    private val label = TextView(context)
+    private val cross = TextView(context)
+    private val link = TextView(context)
+    private var mode = Mode.IDLE
+
+    var onChoose: (() -> Unit)? = null
+    var onCancel: (() -> Unit)? = null
+    var onClear: (() -> Unit)? = null
+
+    init {
+        id = ID_BAR
+        orientation = HORIZONTAL
+        gravity = Gravity.CENTER_VERTICAL
+        setPadding(dp(sidePadding), dp(4f), dp(sidePadding), dp(6f))
+
+        pill.orientation = HORIZONTAL
+        pill.gravity = Gravity.CENTER_VERTICAL
+        label.id = ID_CHOOSE
+        label.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14f)
+        label.typeface = AndroidUtilities.bold()
+        label.gravity = Gravity.CENTER_VERTICAL
+        label.compoundDrawablePadding = dp(6f)
+        label.setOnClickListener { if (mode != Mode.LOADING) onChoose?.invoke() }
+        pill.addView(label, LayoutHelper.createLinear(LayoutHelper.WRAP_CONTENT, LayoutHelper.WRAP_CONTENT))
+
+        cross.id = ID_CLEAR
+        cross.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14f)
+        cross.typeface = AndroidUtilities.bold()
+        cross.text = "\u2715"
+        cross.alpha = .7f
+        cross.contentDescription = LocaleController.getString(R.string.Clear)
+        cross.setPadding(dp(8f), 0, 0, 0)
+        cross.setOnClickListener { onClear?.invoke() }
+        pill.addView(cross, LayoutHelper.createLinear(LayoutHelper.WRAP_CONTENT, LayoutHelper.WRAP_CONTENT))
+        addView(pill, LayoutHelper.createLinear(LayoutHelper.WRAP_CONTENT, LayoutHelper.WRAP_CONTENT))
+
+        link.id = ID_CANCEL
+        link.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14f)
+        link.text = TeleLowercase.lc(LocaleController.getString(R.string.Cancel))
+        link.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteLinkText, resourcesProvider))
+        link.setOnClickListener { onCancel?.invoke() }
+        addView(link, LayoutHelper.createLinear(LayoutHelper.WRAP_CONTENT, LayoutHelper.WRAP_CONTENT, 10f, 0f, 0f, 0f))
+
+        setIdle()
+    }
+
+    fun setIdle() {
+        mode = Mode.IDLE
+        style(false)
+        label.text = TeleLowercase.lc("Filter by date")
+        label.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteLinkText, resourcesProvider))
+        label.setCompoundDrawablesRelativeWithIntrinsicBounds(icon(), null, null, null)
+        cross.visibility = GONE
+        link.visibility = GONE
+        visibility = if (idleShown) VISIBLE else GONE
+    }
+
+    fun setLoading(count: Int, oldest: Int) {
+        mode = Mode.LOADING
+        style(false)
+        label.text = if (oldest != 0) {
+            TeleLowercase.lc("Loaded %s \u00b7 now at %s").format(
+                LocaleController.formatNumber(count.toLong(), ','),
+                LocaleController.getInstance().chatFullDate.format(oldest * 1000L)
+            )
+        } else {
+            TeleLowercase.lc(LocaleController.getString(R.string.Loading))
+        }
+        label.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText, resourcesProvider))
+        label.setCompoundDrawablesRelativeWithIntrinsicBounds(null, null, null, null)
+        cross.visibility = GONE
+        link.visibility = VISIBLE
+        visibility = VISIBLE
+    }
+
+    fun setActive(range: ListDates.Range) {
+        mode = Mode.ACTIVE
+        style(true)
+        label.text = range.label()
+        label.setTextColor(Theme.getColor(Theme.key_featuredStickers_buttonText, resourcesProvider))
+        label.setCompoundDrawablesRelativeWithIntrinsicBounds(null, null, null, null)
+        cross.setTextColor(Theme.getColor(Theme.key_featuredStickers_buttonText, resourcesProvider))
+        cross.visibility = VISIBLE
+        link.visibility = GONE
+        visibility = VISIBLE
+    }
+
+    private fun style(chip: Boolean) {
+        if (chip) {
+            pill.setPadding(dp(12f), dp(6f), dp(12f), dp(6f))
+            pill.background = Theme.createRoundRectDrawable(dp(16f), Theme.getColor(Theme.key_featuredStickers_addButton, resourcesProvider))
+        } else {
+            pill.setPadding(0, dp(6f), 0, dp(6f))
+            pill.background = null
+        }
+    }
+
+    private fun icon(): Drawable? {
+        val drawable = context.getDrawable(R.drawable.msg_calendar2)?.mutate() ?: return null
+        drawable.colorFilter = PorterDuffColorFilter(Theme.getColor(Theme.key_windowBackgroundWhiteLinkText, resourcesProvider), PorterDuff.Mode.SRC_IN)
+        return drawable
+    }
+
+    companion object {
+        const val ID_BAR = 9685
+        const val ID_CHOOSE = 9686
+        const val ID_CLEAR = 9687
+        const val ID_CANCEL = 9688
+    }
+}
