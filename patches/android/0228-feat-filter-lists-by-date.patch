+import tele.ui.TeleDatesBar
+
+/**
+ * The days the shared media of a profile is limited to (desktop 0193), for every media tab at once. The
+ * layout asks [min] and [max] of each page it loads and starts over when [changed] runs; a chip at the
+ * bottom of the layout shows the days on the media tabs.
+ */
+class MediaDates private constructor(
+    private val layout: FrameLayout,
+    private val fragment: BaseFragment,
+    resources: Theme.ResourcesProvider?,
+    private val changed: Runnable
+) {
+
+    var range: ListDates.Range? = null
+        private set
+
+    private var tab = -1
+    private val chip = TeleDatesBar(layout.context, resources, false, 0f)
+
+    init {
+        chip.visibility = View.GONE
+        chip.onChoose = { choose() }
+        chip.onClear = { clear() }
+        layout.addView(chip, LayoutHelper.createFrame(LayoutHelper.WRAP_CONTENT, LayoutHelper.WRAP_CONTENT.toFloat(), Gravity.BOTTOM or Gravity.CENTER_HORIZONTAL, 0f, 0f, 0f, 16f))
+    }
+
+    fun isActive(): Boolean = range != null
+
+    /** The first second of the days, or 0 without a range. */
+    fun min(): Int = range?.start ?: 0
+
+    /** The last second of the days, or 0 without a range. */
+    fun max(): Int = range?.let { it.end - 1 } ?: 0
+
+    /** Whether a message of this date belongs in the list. */
+    fun accepts(date: Int): Boolean = range?.contains(date) ?: true
+
+    fun choose() {
+        ListDates.choose(fragment, range) { change(it) }
+    }
+
+    fun clear() {
+        change(null)
+    }
+
+    private fun change(value: ListDates.Range?) {
+        range = value
+        update()
+        changed.run()
+    }
+
+    /** The tab on screen changed. */
+    fun tabChanged(tab: Int) {
+        this.tab = tab
+        update()
+    }
+
+    private fun update() {
+        val value = range
+        if (value != null && mediaTab(tab)) {
+            chip.setActive(value)
+            // the pages were added after the chip
+            chip.bringToFront()
+        } else {
+            chip.visibility = View.GONE
+        }
+    }
+
+    companion object {
+
+        /** The date filter of a layout, or null while the option is off. */
+        @JvmStatic
+        fun create(layout: FrameLayout, fragment: BaseFragment, resources: Theme.ResourcesProvider?, changed: Runnable): MediaDates? =
+            if (ListDates.enabled()) MediaDates(layout, fragment, resources, changed) else null
+
+        /** The tabs of the layout that list messages of the chat. */
+        @JvmStatic
+        fun mediaTab(tab: Int): Boolean = tab in 0..5 || tab == SharedMediaLayout.TAB_POLL
+    }
+}
