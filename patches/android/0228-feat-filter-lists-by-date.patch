diff --git a/TMessagesProj/src/main/java/tele/helpers/GiftDates.kt b/TMessagesProj/src/main/java/tele/helpers/GiftDates.kt
new file mode 100644
index 000000000..3e1b9f934
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/GiftDates.kt
@@ -0,0 +1,237 @@
+package tele.helpers
+
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.MessagesController
+import org.telegram.tgnet.ConnectionsManager
+import org.telegram.tgnet.TLRPC
+import org.telegram.tgnet.tl.TL_stars
+import org.telegram.ui.ActionBar.BaseFragment
+import org.telegram.ui.Stars.StarsController
+import tele.ui.TeleDatesBar
+import java.util.WeakHashMap
+
+/**
+ * The days the gifts of a profile are limited to (desktop 0193). The gifts of the range are loaded
+ * apart from the stock list, 100 at a time and newest first, until a page reaches past the first day.
+ * One instance per profile gifts container; each gift list (a collection, a filter) loads its own copy.
+ */
+class GiftDates private constructor(
+    private val currentAccount: Int,
+    private val dialogId: Long,
+    private val allList: StarsController.GiftsList,
+    private val fragment: BaseFragment,
+    private val changed: Runnable
+) {
+
+    private class Source(val list: StarsController.GiftsList) {
+        val items = ArrayList<TL_stars.SavedStarGift>()
+        val keys = HashSet<String>()
+        var offset = ""
+        var requestId = 0
+        var loaded = false
+        var oldest = 0
+    }
+
+    private val sources = HashMap<String, Source>()
+    private var epoch = 0
+
+    var range: ListDates.Range? = null
+        private set
+
+    /** The shown gifts as a list for the gift sheet. */
+    @JvmField
+    val results = GiftSearch.Results()
+
+    fun isActive(): Boolean = range != null
+
+    fun choose() {
+        ListDates.choose(fragment, range) { change(it) }
+    }
+
+    private fun change(value: ListDates.Range?) {
+        range = value
+        reset(false)
+        changed.run()
+    }
+
+    /** Everything loaded is dropped; the next pass of the list loads the range again. */
+    private fun reset(notify: Boolean) {
+        epoch++
+        for (source in sources.values) {
+            if (source.requestId != 0) ConnectionsManager.getInstance(currentAccount).cancelRequest(source.requestId, true)
+        }
+        sources.clear()
+        if (notify && isActive()) changed.run()
+    }
+
+    private fun keyOf(list: StarsController.GiftsList): String =
+        listOf(
+            list.isCollection, list.collectionId, list.sort_by_date,
+            list.isInclude_unlimited, list.isInclude_limited, list.isInclude_upgradable, list.isInclude_unique,
+            list.isInclude_displayed, list.isInclude_hidden
+        ).joinToString(":")
+
+    fun isLoading(list: StarsController.GiftsList): Boolean = (sources[keyOf(list)]?.requestId ?: 0) != 0
+
+    fun isLoaded(list: StarsController.GiftsList): Boolean = sources[keyOf(list)]?.loaded == true
+
+    /** The bar above the gifts: the days, or how far the loading of [list] got. */
+    fun bind(bar: TeleDatesBar, list: StarsController.GiftsList) {
+        bar.onChoose = { choose() }
+        bar.onCancel = { change(null) }
+        bar.onClear = { change(null) }
+        val range = range
+        val source = sources[keyOf(list)]
+        when {
+            range == null -> bar.setIdle()
+            source != null && !source.loaded -> bar.setLoading(source.items.size, source.oldest)
+            else -> bar.setActive(range)
+        }
+    }
+
+    /** The gifts of the days in [list]; starts the loading of the range and returns what is there. */
+    fun found(list: StarsController.GiftsList): ArrayList<TL_stars.SavedStarGift> {
+        val source = sources.getOrPut(keyOf(list)) { Source(list) }
+        load(source)
+        // the objects of the profile's lists carry the latest state of a gift
+        val own = HashMap<String, TL_stars.SavedStarGift>()
+        for (gift in allList.gifts) own[GiftSelection.key(gift)] = gift
+        for (gift in list.gifts) own[GiftSelection.key(gift)] = gift
+        for (gift in source.items) {
+            own[GiftSelection.key(gift)]?.let {
+                gift.unsaved = it.unsaved
+                gift.pinned_to_top = it.pinned_to_top
+                gift.collection_id = it.collection_id
+            }
+        }
+        return ArrayList(source.items)
+    }
+
+    private fun load(source: Source) {
+        val range = range ?: return
+        if (source.requestId != 0 || source.loaded) return
+        val list = source.list
+        val request = TL_stars.getSavedStarGifts()
+        request.sort_by_value = !list.sort_by_date
+        request.exclude_unupgradable = !list.isInclude_limited
+        request.exclude_upgradable = !list.isInclude_upgradable
+        request.exclude_unlimited = !list.isInclude_unlimited
+        request.exclude_unique = !list.isInclude_unique
+        request.exclude_saved = !list.isInclude_displayed
+        request.exclude_unsaved = !list.isInclude_hidden
+        request.peer_color_available = list.peer_color_available
+        request.peer = if (dialogId == 0L) TLRPC.TL_inputPeerSelf() else MessagesController.getInstance(currentAccount).getInputPeer(dialogId)
+        request.offset = source.offset
+        request.limit = PER_PAGE
+        if (list.isCollection) {
+            request.flags = request.flags or 64
+            request.collection_id = list.collectionId
+        }
+        val generation = epoch
+        source.requestId = ConnectionsManager.getInstance(currentAccount).sendRequest(request) { response, _ ->
+            AndroidUtilities.runOnUIThread {
+                if (generation != epoch) return@runOnUIThread
+                source.requestId = 0
+                if (response is TL_stars.TL_payments_savedStarGifts) {
+                    done(source, range, response)
+                } else {
+                    // what came is shown; the bar stops saying it loads
+                    source.loaded = true
+                    changed.run()
+                }
+            }
+        }
+    }
+
+    private fun done(source: Source, range: ListDates.Range, result: TL_stars.TL_payments_savedStarGifts) {
+        val messages = MessagesController.getInstance(currentAccount)
+        messages.putUsers(result.users, false)
+        messages.putChats(result.chats, false)
+        var pageOldest = 0
+        for (gift in result.gifts) {
+            // pinned gifts come first whatever their date
+            if (!gift.pinned_to_top && gift.date != 0 && (pageOldest == 0 || gift.date < pageOldest)) pageOldest = gift.date
+            if (source.keys.add(GiftSelection.key(gift))) source.items.add(gift)
+        }
+        if (pageOldest != 0) source.oldest = pageOldest
+        val next = result.next_offset
+        if (next.isNullOrEmpty() || result.gifts.isEmpty()) {
+            source.loaded = true
+        } else {
+            source.offset = next
+            // by value the gifts are not in date order: nothing says where the range ends
+            if (source.list.sort_by_date && pageOldest != 0 && pageOldest < range.start) source.loaded = true
+        }
+        load(source)
+        changed.run()
+    }
+
+    /** A gift left the profile: it is gone from the loaded ranges too. */
+    private fun drop(gift: TL_stars.SavedStarGift) {
+        val key = GiftSelection.key(gift)
+        var any = false
+        for (source in sources.values) {
+            if (source.keys.remove(key)) {
+                source.items.removeAll { GiftSelection.key(it) == key }
+                any = true
+            }
+        }
+        if (any && isActive()) changed.run()
+    }
+
+    companion object {
+        private const val PER_PAGE = 100
+
+        private val instances = WeakHashMap<GiftDates, Boolean>()
+
+        /** The date filter of a container, or null while the option is off. */
+        @JvmStatic
+        fun create(currentAccount: Int, dialogId: Long, allList: StarsController.GiftsList, fragment: BaseFragment, changed: Runnable): GiftDates? {
+            if (!ListDates.enabled()) return null
+            return GiftDates(currentAccount, dialogId, allList, fragment, changed).also { instances[it] = true }
+        }
+
+        // the profile's lists were reloaded or lost a gift
+        @JvmStatic
+        fun invalidate(currentAccount: Int, dialogId: Long) {
+            for (dates in instances.keys.toList()) {
+                if (dates.currentAccount == currentAccount && dates.dialogId == dialogId) dates.reset(true)
+            }
+        }
+
+        @JvmStatic
+        fun removed(currentAccount: Int, dialogId: Long, gift: TL_stars.SavedStarGift) {
+            for (dates in instances.keys.toList()) {
+                if (dates.currentAccount == currentAccount && dates.dialogId == dialogId) dates.drop(gift)
+            }
+        }
+
+        /** What the list shows while a search or the days are on: the search results limited to the days. */
+        @JvmStatic
+        fun shown(search: GiftSearch?, dates: GiftDates?, list: StarsController.GiftsList): ArrayList<TL_stars.SavedStarGift> {
+            val found = if (search != null && search.isActive()) search.found(list) else dates!!.found(list)
+            val range = dates?.range
+            if (dates != null && range != null) {
+                found.removeAll { !range.contains(it.date) }
+                dates.results.update(found)
+            }
+            return found
+        }
+
+        @JvmStatic
+        fun isLoading(search: GiftSearch?, dates: GiftDates?, list: StarsController.GiftsList): Boolean =
+            (search != null && search.isActive() && search.isLoading()) || (dates != null && dates.isActive() && dates.isLoading(list))
+
+        @JvmStatic
+        fun isLoaded(search: GiftSearch?, dates: GiftDates?, list: StarsController.GiftsList): Boolean =
+            (search == null || !search.isActive() || search.isLoaded()) && (dates == null || !dates.isActive() || dates.isLoaded(list))
+
+        /** The gifts for the sheet of a gift: what the days show, else what the search found. */
+        @JvmStatic
+        fun results(search: GiftSearch?, dates: GiftDates?): StarsController.IGiftsList =
+            if (dates != null && dates.isActive()) dates.results else search!!.results
+
+        @JvmStatic
+        fun emptyText(): String = TeleLowercase.lc("No gifts in this date range.")
+    }
+}
