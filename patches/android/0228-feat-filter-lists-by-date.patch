@@ -0,0 +1,67 @@
+package tele.helpers
+
+import android.os.Bundle
+import org.telegram.messenger.LocaleController
+import org.telegram.ui.ActionBar.BaseFragment
+import org.telegram.ui.CalendarActivity
+import tele.TeleConfig
+import java.util.Calendar
+import java.util.Date
+
+/**
+ * The days a long list is limited to (desktop 0193): shared by the star transactions, the profile
+ * gifts ([GiftDates]) and the shared media ([MediaDates]).
+ */
+object ListDates {
+
+    /** Whole local days, [start] inclusive and [end] exclusive, in unix seconds. */
+    class Range(@JvmField val start: Int, @JvmField val end: Int) {
+
+        fun contains(date: Int): Boolean = date >= start && date < end
+
+        fun label(): String {
+            val first = Date(start * 1000L)
+            val last = Date((end - 1) * 1000L)
+            val full = LocaleController.getInstance().chatFullDate
+            if (day(start) == day(end - 1)) return full.format(first)
+            // chatDate is chatFullDate without the year, so both ends read the same way
+            val short = LocaleController.getInstance().chatDate
+            val sameYear = calendar(start)[Calendar.YEAR] == calendar(end - 1)[Calendar.YEAR]
+            return (if (sameYear) short.format(first) else full.format(first)) + " \u2013 " + full.format(last)
+        }
+
+        private fun day(time: Int): Int = calendar(time).let { it[Calendar.YEAR] * 1000 + it[Calendar.DAY_OF_YEAR] }
+    }
+
+    @JvmStatic
+    fun enabled(): Boolean = TeleConfig.LIST_DATES.value
+
+    @JvmStatic
+    fun calendar(time: Int): Calendar = Calendar.getInstance().also { it.timeInMillis = time * 1000L }
+
+    private fun midnight(time: Int): Calendar =
+        calendar(time).also {
+            it[Calendar.HOUR_OF_DAY] = 0
+            it[Calendar.MINUTE] = 0
+            it[Calendar.SECOND] = 0
+            it[Calendar.MILLISECOND] = 0
+        }
+
+    private fun seconds(time: Calendar): Int = (time.timeInMillis / 1000).toInt()
+
+    /** Opens the calendar to pick the first and the last day; [done] gets the range. */
+    @JvmStatic
+    fun choose(fragment: BaseFragment?, current: Range?, done: (Range) -> Unit) {
+        fragment ?: return
+        val args = Bundle().apply { putInt("type", CalendarActivity.TYPE_DATE_RANGE) }
+        val first = current?.let { seconds(midnight(it.start)) } ?: 0
+        val last = current?.let { seconds(midnight(it.end - 1)) } ?: 0
+        val picker = CalendarActivity(args, 0, first)
+            .setRangePicker(first, last, TeleLowercase.lc("Apply"), TeleLowercase.lc("Clear")) { start, end ->
+                // the end of the last day is the start of the next one
+                val till = midnight(end).also { it.add(Calendar.DAY_OF_MONTH, 1) }
+                done(Range(start, seconds(till)))
+            }
+        fragment.presentFragment(picker)
+    }
+}
