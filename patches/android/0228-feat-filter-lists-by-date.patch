+    // tele: all days from the first Telegram day to today are selectable
+    private void fillRangeDays() {
+        Calendar calendar = Calendar.getInstance();
+        calendar.setTimeInMillis(RANGE_MIN_DATE * 1000L);
+        startOfDay(calendar);
+        minDate = (int) (calendar.getTimeInMillis() / 1000L);
+        minMontYear = calendar.get(Calendar.YEAR) * 100 + calendar.get(Calendar.MONTH);
+        int minMonths = calendar.get(Calendar.YEAR) * 12 + calendar.get(Calendar.MONTH);
+        Calendar today = Calendar.getInstance();
+        startOfDay(today);
+        while (!calendar.after(today)) {
+            int month = calendar.get(Calendar.YEAR) * 100 + calendar.get(Calendar.MONTH);
+            SparseArray<PeriodDay> days = messagesByYearMounth.get(month);
+            if (days == null) {
+                days = new SparseArray<>();
+                messagesByYearMounth.put(month, days);
+            }
+            PeriodDay day = new PeriodDay();
+            day.hasImage = false;
+            day.date = (int) (calendar.getTimeInMillis() / 1000L);
+            days.put(calendar.get(Calendar.DAY_OF_MONTH) - 1, day);
+            calendar.add(Calendar.DAY_OF_MONTH, 1);
+        }
+        endReached = true;
+        monthCount = Math.max(monthCount, startFromYear * 12 + startFromMonth - minMonths + 1);
+        adapter.notifyDataSetChanged();
+    }
+
+    private static void startOfDay(Calendar calendar) {
+        calendar.set(Calendar.HOUR_OF_DAY, 0);
+        calendar.set(Calendar.MINUTE, 0);
+        calendar.set(Calendar.SECOND, 0);
+        calendar.set(Calendar.MILLISECOND, 0);
+    }
+
+    private void createRangeBar(Context context) {
+        bottomBar = new FrameLayout(context) {
+            @Override
+            public void onDraw(Canvas canvas) {
+                canvas.drawRect(0, 0, getMeasuredWidth(), AndroidUtilities.getShadowHeight(), Theme.dividerPaint);
+            }
+        };
+        bottomBar.setWillNotDraw(false);
+        bottomBar.setPadding(0, AndroidUtilities.getShadowHeight(), 0, 0);
+        LinearLayout row = new LinearLayout(context);
+        row.setOrientation(LinearLayout.HORIZONTAL);
+        bottomBar.addView(row, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.MATCH_PARENT));
+
+        rangeClearButton = createRangeButton(context, rangeClearText, Theme.key_text_RedBold);
+        rangeClearButton.setOnClickListener(view -> {
+            if (selectionAnimator != null) {
+                selectionAnimator.cancel();
+                selectionAnimator = null;
+            }
+            dateSelectedStart = dateSelectedEnd = 0;
+            updateRangeBar();
+            animateSelection();
+        });
+        row.addView(rangeClearButton, LayoutHelper.createLinear(0, LayoutHelper.MATCH_PARENT, 1f));
+
+        rangeApplyButton = createRangeButton(context, rangeApplyText, Theme.key_chat_fieldOverlayText);
+        rangeApplyButton.setOnClickListener(view -> {
+            if (dateSelectedStart == 0 || dateSelectedEnd == 0) {
+                return;
+            }
+            RangeCallback done = rangeCallback;
+            int start = Math.min(dateSelectedStart, dateSelectedEnd);
+            int end = Math.max(dateSelectedStart, dateSelectedEnd);
+            finishFragment();
+            if (done != null) {
+                done.onRange(start, end);
+            }
+        });
+        row.addView(rangeApplyButton, LayoutHelper.createLinear(0, LayoutHelper.MATCH_PARENT, 1f));
+        contentView.addView(bottomBar, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, 48, Gravity.BOTTOM, 0, 0, 0, 0));
+        updateRangeBar();
+    }
+
+    private TextView createRangeButton(Context context, String text, int colorKey) {
+        TextView button = new TextView(context);
+        button.setGravity(Gravity.CENTER);
+        button.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15);
+        button.setTypeface(AndroidUtilities.bold());
+        button.setAllCaps(true);
+        button.setText(text);
+        button.setTextColor(Theme.getColor(colorKey));
+        button.setBackground(Theme.createSelectorDrawable(ColorUtils.setAlphaComponent(Theme.getColor(colorKey), (int) (0.2f * 255)), 2));
+        return button;
+    }
+
+    private void updateRangeBar() {
+        boolean selected = dateSelectedStart != 0 && dateSelectedEnd != 0;
+        int days = selected ? 1 + Math.round(Math.abs(dateSelectedStart - dateSelectedEnd) / 86400f) : 0;
+        actionBar.setTitle(days > 0 ? LocaleController.formatPluralString("Days", days) : LocaleController.getString(R.string.SelectDays));
+        if (rangeApplyButton != null) {
+            rangeApplyButton.setEnabled(selected);
+            rangeApplyButton.setAlpha(selected ? 1f : 0.5f);
+            rangeClearButton.setEnabled(selected);
+            rangeClearButton.setAlpha(selected ? 1f : 0.5f);
+        }
+    }
+
+    /** A picker of a day range: [start] and [end] are the first seconds of the first and the last day, or 0. */
+    public CalendarActivity setRangePicker(int start, int end, String applyText, String clearText, RangeCallback callback) {
+        dateSelectedStart = start;
+        dateSelectedEnd = end;
+        rangeApplyText = applyText;
+        rangeClearText = clearText;
+        rangeCallback = callback;
+        return this;
+    }
+
+    public interface RangeCallback {
+        void onRange(int start, int end);
+    }
+
