diff --git a/TMessagesProj/src/main/java/tele/TeleHooks.kt b/TMessagesProj/src/main/java/tele/TeleHooks.kt
index fc763b05a..a3a1c1547 100644
--- a/TMessagesProj/src/main/java/tele/TeleHooks.kt
+++ b/TMessagesProj/src/main/java/tele/TeleHooks.kt
@@ -20,6 +20,7 @@ import org.telegram.ui.ActionBar.AlertDialog
 import org.telegram.ui.ActionBar.BaseFragment
 import org.telegram.ui.ActionBar.Theme
 import org.telegram.ui.Components.EditTextBoldCursor
+import org.telegram.tgnet.TLRPC
 import tele.db.TeleDatabaseHelper
 import tele.helpers.TeleCrash
 import tele.helpers.LocalNames
@@ -50,6 +51,19 @@ object TeleHooks {
             (if (is24Hour) cloud24 else cloud12) ?: ""
         }
 
+    // a service message shows its own time when the seconds are on
+    @JvmStatic
+    fun withServiceTime(message: MessageObject?, text: CharSequence?): CharSequence? {
+        if (!TeleConfig.SHOW_SECONDS.value || text == null || text.isEmpty()) return text
+        val owner = message?.messageOwner ?: return text
+        if (owner !is TLRPC.TL_messageService || owner.date <= 0) return text
+        val time = LocaleController.getInstance().getFormatterDay().format(owner.date * 1000L)
+        val builder = android.text.SpannableStringBuilder(text)
+        builder.append(" · ").append(time)
+        android.util.Log.d("TeleSeconds", "account=${message?.currentAccount} mid=${message?.getId()} status=appended")
+        return builder
+    }
+
     private var callConfirmed = false
 
     @JvmStatic
