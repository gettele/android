diff --git a/TMessagesProj/src/main/java/tele/helpers/RecoveredPosts.kt b/TMessagesProj/src/main/java/tele/helpers/RecoveredPosts.kt
new file mode 100644
index 000000000..48f6fa1a6
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/RecoveredPosts.kt
@@ -0,0 +1,262 @@
+package tele.helpers
+
+import android.os.SystemClock
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.ChatObject
+import org.telegram.messenger.DialogObject
+import org.telegram.messenger.FileLog
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.MessageObject
+import org.telegram.messenger.MessagesController
+import org.telegram.messenger.MessagesStorage
+import org.telegram.messenger.R
+import org.telegram.messenger.UserConfig
+import org.telegram.tgnet.SerializedData
+import org.telegram.tgnet.TLRPC
+import org.telegram.ui.ChatActivity
+import org.telegram.ui.Components.BulletinFactory
+import tele.TeleConfig
+import tele.db.TeleDatabaseHelper
+import java.lang.ref.WeakReference
+import java.util.concurrent.ConcurrentHashMap
+
+/**
+ * A deleted channel post comes back from the forward it was opened from:
+ * the post is rebuilt locally, kept like a deleted message and marked with the chat of the forward.
+ */
+object RecoveredPosts {
+    class Source(@JvmField val dialogId: Long, @JvmField val messageId: Int, @JvmField val name: String)
+
+    private class Pending(
+        val account: Int,
+        val channelId: Long,
+        val postId: Int,
+        val forwards: List<TLRPC.Message>,
+        val groupSize: Int,
+        val at: Long
+    )
+
+    private const val PENDING_TIMEOUT = 120_000L
+
+    @Volatile
+    private var pending: Pending? = null
+
+    // account -> dialog -> message -> where the post was recovered from
+    private val sources = ConcurrentHashMap<Int, ConcurrentHashMap<Long, ConcurrentHashMap<Int, Source>>>()
+
+    private fun enabled(): Boolean = TeleConfig.KEEP_DELETED_MESSAGES.value && TeleConfig.RECOVER_FORWARDED_POSTS.value
+
+    /** The id of the channel post the message is a forward of, 0 when it isn't a forward from that channel. */
+    private fun forwardedPost(message: TLRPC.Message?, channelId: Long): Int {
+        val fwd = message?.fwd_from ?: return 0
+        val from = fwd.from_id
+        return if (from != null && from.channel_id == channelId) fwd.channel_post else 0
+    }
+
+    /** Remembers the forward the user is jumping from to its original post; only the last jump counts. */
+    @JvmStatic
+    fun note(account: Int, message: MessageObject?, group: MessageObject.GroupedMessages?, channelId: Long, postId: Int) {
+        pending = null
+        if (!enabled() || message == null || postId <= 0 || channelId <= 0) return
+        val owner = message.messageOwner ?: return
+        val dialogId = message.dialogId
+        if (DialogObject.isEncryptedDialog(dialogId) || dialogId == -channelId || owner.id <= 0) return
+        if (forwardedPost(owner, channelId) != postId) return
+        val members = group?.messages?.takeIf { it.contains(message) } ?: arrayListOf(message)
+        val forwards = members.mapNotNull { it.messageOwner }.filter { forwardedPost(it, channelId) > 0 }
+        pending = Pending(account, channelId, postId, forwards, members.size, SystemClock.elapsedRealtime())
+    }
+
+    /**
+     * The chat didn't find the post it was opened at: when the jump came from a forward of it,
+     * the post is restored from the forward. Returns true when the restoring took over the "not found" report.
+     */
+    @JvmStatic
+    fun recover(chat: ChatActivity, postId: Int): Boolean {
+        val data = pending ?: return false
+        if (data.postId != postId || data.account != chat.getCurrentAccount() || chat.getDialogId() != -data.channelId) return false
+        pending = null
+        if (!enabled() || SystemClock.elapsedRealtime() - data.at > PENDING_TIMEOUT) return false
+        val channel = MessagesController.getInstance(data.account).getChat(data.channelId) ?: return false
+        if (!ChatObject.isChannelAndNotMegaGroup(channel) || channel is TLRPC.TL_channelForbidden) return false
+        val weak = WeakReference(chat)
+        MessagesStorage.getInstance(data.account).storageQueue.postRunnable {
+            val shown = runCatching { store(data) }.onFailure { FileLog.e(it) }.getOrDefault(false)
+            AndroidUtilities.runOnUIThread {
+                val target = weak.get() ?: return@runOnUIThread
+                if (target.isFinished || target.parentActivity == null) return@runOnUIThread
+                if (shown) {
+                    target.scrollToMessageId(data.postId, 0, true, 0, true, 0)
+                } else {
+                    BulletinFactory.of(target).createErrorBulletin(LocaleController.getString(R.string.MessageNotFound), target.themeDelegate).show()
+                }
+            }
+        }
+        return true
+    }
+
+    // storage queue: true when the post is in the local storage as a kept message
+    private fun store(data: Pending): Boolean {
+        val account = data.account
+        val dialogId = -data.channelId
+        val storage = MessagesStorage.getInstance(account)
+        val ids = data.forwards.map { forwardedPost(it, data.channelId) }.distinct()
+        val existing = HashSet<Int>()
+        val cursor = storage.database.queryFinalized("SELECT mid FROM messages_v2 WHERE uid = $dialogId AND mid IN (${ids.joinToString(",")})")
+        try {
+            while (cursor.next()) existing.add(cursor.intValue(0))
+        } finally {
+            cursor.dispose()
+        }
+        if (data.postId in existing) return DeletedMessages.isKeptDb(account, dialogId, data.postId)
+        val missing = data.forwards.filter { forwardedPost(it, data.channelId) !in existing }
+        val grouped = if (data.groupSize > 1 && missing.size == data.groupSize) missing[0].grouped_id else 0L
+        val posts = ArrayList<TLRPC.Message>()
+        val sourcesOf = HashMap<Int, Source>()
+        for (forward in missing) {
+            val post = build(forward, data.channelId, grouped) ?: continue
+            if (!DeletedMessages.keepInChat(account, post, false)) continue
+            if (posts.any { it.id == post.id }) continue
+            posts.add(post)
+            val forwardDialog = MessageObject.getDialogId(forward)
+            sourcesOf[post.id] = Source(forwardDialog, forward.id, nameOf(account, forwardDialog))
+        }
+        if (posts.none { it.id == data.postId }) return false
+        // the kept copy needs the row of the storage to be shown in the chat
+        storage.putMessages(posts, true, false, true, 0, ChatActivity.MODE_DEFAULT, 0)
+        for (post in posts) {
+            DeletedMessages.archiveMessage(account, post)
+            val source = sourcesOf[post.id] ?: continue
+            TeleDatabaseHelper.putRecoveredPost(account, dialogId, post.id, source.dialogId, source.messageId, source.name)
+            put(account, dialogId, post.id, source)
+        }
+        DeletedMessages.markKept(account, dialogId, posts.map { it.id })
+        return true
+    }
+
+    private fun build(forward: TLRPC.Message, channelId: Long, grouped: Long): TLRPC.Message? {
+        val fwd = forward.fwd_from ?: return null
+        val post = fwd.channel_post
+        if (post <= 0 || forward.action != null && forward.action !is TLRPC.TL_messageActionEmpty) return null
+        val stream = SerializedData(forward.objectSize)
+        val copy: TLRPC.Message?
+        try {
+            forward.serializeToStream(stream)
+            val read = SerializedData(stream.toByteArray())
+            try {
+                copy = TLRPC.Message.TLdeserialize(read, read.readInt32(false), false)
+            } finally {
+                read.cleanup()
+            }
+        } finally {
+            stream.cleanup()
+        }
+        if (copy == null) return null
+        copy.id = post
+        copy.dialog_id = -channelId
+        copy.peer_id = TLRPC.TL_peerChannel().also { it.channel_id = channelId }
+        copy.from_id = null
+        copy.saved_peer_id = null
+        copy.fwd_from = null
+        copy.reply_to = null
+        copy.reply_markup = null
+        copy.replies = null
+        copy.reactions = null
+        copy.factcheck = null
+        copy.suggested_post = null
+        copy.restriction_reason.clear()
+        copy.guestchat_via_from = null
+        copy.summary_from_language = null
+        copy.from_rank = null
+        copy.via_business_bot_id = 0
+        copy.views = 0
+        copy.forwards = 0
+        copy.edit_date = 0
+        copy.ttl_period = 0
+        copy.quick_reply_shortcut_id = 0
+        copy.effect = 0
+        copy.paid_message_stars = 0
+        copy.report_delivery_until_date = 0
+        copy.schedule_repeat_period = 0
+        copy.from_boosts_applied = 0
+        copy.post = true
+        copy.out = false
+        copy.unread = false
+        copy.mentioned = false
+        copy.media_unread = false
+        copy.pinned = false
+        copy.from_scheduled = false
+        copy.legacy = false
+        copy.send_state = 0
+        copy.local_id = 0
+        copy.attachPath = ""
+        copy.date = if (fwd.date != 0) fwd.date else forward.date
+        copy.post_author = fwd.post_author
+        copy.grouped_id = grouped
+        if (copy.message == null) copy.message = ""
+        // the forward's flags describe the forward: keep only what the post has
+        var flags = 0
+        if (copy.media != null) flags = flags or TLRPC.MESSAGE_FLAG_HAS_MEDIA
+        if (copy.entities.isNotEmpty()) flags = flags or TLRPC.MESSAGE_FLAG_HAS_ENTITIES
+        if (copy.via_bot_id != 0L) flags = flags or TLRPC.MESSAGE_FLAG_HAS_BOT_ID
+        if (!copy.post_author.isNullOrEmpty()) flags = flags or (1 shl 16)
+        if (grouped != 0L) flags = flags or (1 shl 17)
+        copy.flags = flags
+        copy.flags2 = if (copy.rich_message != null) 1 shl 13 else 0
+        return copy
+    }
+
+    private fun nameOf(account: Int, dialogId: Long): String {
+        if (dialogId == UserConfig.getInstance(account).clientUserId) return LocaleController.getString(R.string.SavedMessages)
+        return MessagesController.getInstance(account).getPeerName(dialogId)
+    }
+
+    private fun put(account: Int, dialogId: Long, messageId: Int, source: Source) {
+        sources.getOrPut(account) { ConcurrentHashMap() }.getOrPut(dialogId) { ConcurrentHashMap() }[messageId] = source
+    }
+
+    @JvmStatic
+    fun load(account: Int, dialogId: Long) {
+        for (row in TeleDatabaseHelper.getRecoveredPosts(account, dialogId)) {
+            put(account, dialogId, row.messageId, Source(row.sourceDialogId, row.sourceMessageId, row.sourceName))
+        }
+    }
+
+    @JvmStatic
+    fun forget(account: Int, dialogId: Long, messageId: Int) {
+        sources[account]?.get(dialogId)?.remove(messageId)
+    }
+
+    @JvmStatic
+    fun forgetAll(account: Int, dialogId: Long?) {
+        if (dialogId == null) sources.remove(account) else sources[account]?.remove(dialogId)
+    }
+
+    private fun sourceOf(messageObject: MessageObject?): Source? {
+        if (messageObject == null || messageObject.messageOwner == null) return null
+        val account = messageObject.currentAccount
+        val dialogId = messageObject.dialogId
+        val source = sources[account]?.get(dialogId)?.get(messageObject.id) ?: return null
+        return if (DeletedMessages.isKept(account, dialogId, messageObject.id)) source else null
+    }
+
+    /** Whether the message is a kept post that was recovered from a forward; the bound cells already loaded the dialog. */
+    @JvmStatic
+    fun isRecovered(messageObject: MessageObject?): Boolean = sourceOf(messageObject) != null
+
+    @JvmStatic
+    fun sourceText(messageObject: MessageObject?): CharSequence? {
+        val source = sourceOf(messageObject) ?: return null
+        val account = messageObject!!.currentAccount
+        val name = nameOf(account, source.dialogId).ifEmpty { source.name }
+        return if (name.isEmpty()) LocaleController.getString(R.string.TeleRecoveredFromUnknown) else LocaleController.formatString(R.string.TeleRecoveredFrom, name)
+    }
+
+    /** Tells where the recovered post came from; false when the message isn't one. */
+    @JvmStatic
+    fun showSource(chat: ChatActivity, messageObject: MessageObject?): Boolean {
+        val text = sourceText(messageObject) ?: return false
+        BulletinFactory.of(chat).createSimpleBulletin(R.raw.info, text).show()
+        return true
+    }
+}
