index 000000000..9b7fbf212
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/TeleSendConfirm.kt
@@ -0,0 +1,155 @@
+package tele.helpers
+
+import android.graphics.Canvas
+import android.graphics.ColorFilter
+import android.graphics.Paint
+import android.graphics.PixelFormat
+import android.graphics.RectF
+import android.graphics.drawable.Drawable
+import android.view.View
+import androidx.core.graphics.ColorUtils
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.R
+import org.telegram.tgnet.TLRPC
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Cells.ContextLinkCell
+import org.telegram.ui.Cells.StickerCell
+import org.telegram.ui.Cells.StickerEmojiCell
+import org.telegram.ui.Components.Bulletin
+import org.telegram.ui.Components.BulletinFactory
+import org.telegram.ui.LaunchActivity
+import tele.TeleConfig
+
+/**
+ * Confirm before sending: the first tap on a sticker or a GIF only selects it, the second tap on
+ * the same item within [TIMEOUT_MS] sends it. The callers return when [stickerTap] and the like say no.
+ */
+object TeleSendConfirm {
+
+    private const val TIMEOUT_MS = 5000L
+
+    private class Selection(val view: View, val key: Any) {
+        val highlight = Highlight(view, key)
+        val expire = Runnable { clear() }
+        val detach = object : View.OnAttachStateChangeListener {
+            override fun onViewAttachedToWindow(v: View) {}
+
+            // a recycled or scrolled-away cell can't keep the selection
+            override fun onViewDetachedFromWindow(v: View) {
+                if (current === this@Selection) {
+                    clear()
+                }
+            }
+        }
+        var bulletin: Bulletin? = null
+    }
+
+    private var current: Selection? = null
+
+    @JvmStatic
+    fun stickers(): Boolean = TeleConfig.CONFIRM_SEND.value && TeleConfig.CONFIRM_STICKERS.value
+
+    @JvmStatic
+    fun gifs(): Boolean = TeleConfig.CONFIRM_SEND.value && TeleConfig.CONFIRM_GIFS.value
+
+    @JvmStatic
+    fun voice(): Boolean = TeleConfig.CONFIRM_SEND.value && TeleConfig.CONFIRM_VOICE.value
+
+    // what the cell shows right now: a rebound cell no longer matches its selection
+    private fun keyOf(view: View): Any? = when (view) {
+        is StickerEmojiCell -> view.sticker
+        is StickerCell -> view.sticker
+        is ContextLinkCell -> view.document ?: view.result
+        else -> null
+    }
+
+    /** The sticker panel grid. */
+    @JvmStatic
+    fun stickerTap(view: View): Boolean = !stickers() || confirmed(view)
+
+    /** The sticker suggestions over the field. */
+    @JvmStatic
+    fun suggestionTap(view: View): Boolean = !stickers() || view !is StickerCell || confirmed(view)
+
+    /** The GIF panel grid. */
+    @JvmStatic
+    fun gifTap(view: View): Boolean = !gifs() || view !is ContextLinkCell || confirmed(view)
+
+    /** An inline bot result that is sent by the tap itself. */
+    @JvmStatic
+    fun inlineTap(view: View, result: TLRPC.BotInlineResult): Boolean {
+        val needed = when (result.type) {
+            "sticker" -> stickers()
+            "gif" -> gifs()
+            else -> false
+        }
+        return !needed || view !is ContextLinkCell || confirmed(view)
+    }
+
+    @JvmStatic
+    fun clear() {
+        val selection = current ?: return
+        current = null
+        AndroidUtilities.cancelRunOnUIThread(selection.expire)
+        selection.view.removeOnAttachStateChangeListener(selection.detach)
+        selection.view.overlay.remove(selection.highlight)
+        selection.bulletin?.hide()
+    }
+
+    private fun confirmed(view: View): Boolean {
+        val key = keyOf(view) ?: return true
+        val selection = current
+        if (selection != null && selection.view === view && selection.key === key) {
+            clear()
+            return true
+        }
+        select(view, key)
+        return false
+    }
+
+    private fun select(view: View, key: Any) {
+        clear()
+        val selection = Selection(view, key)
+        current = selection
+        view.addOnAttachStateChangeListener(selection.detach)
+        view.overlay.add(selection.highlight)
+        view.invalidate()
+        AndroidUtilities.runOnUIThread(selection.expire, TIMEOUT_MS)
+        LaunchActivity.getSafeLastFragment()?.let {
+            selection.bulletin = BulletinFactory.of(it)
+                .createSimpleBulletin(R.raw.info, LocaleController.getString(R.string.TeleConfirmTapAgain), 1, Bulletin.DURATION_SHORT)
+                .also { b -> b.show() }
+        }
+    }
+
+    private class Highlight(private val view: View, private val key: Any) : Drawable() {
+        private val fill = Paint(Paint.ANTI_ALIAS_FLAG)
+        private val stroke = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            style = Paint.Style.STROKE
+            strokeWidth = AndroidUtilities.dpf2(2f)
+        }
+        private val rect = RectF()
+
+        override fun draw(canvas: Canvas) {
+            if (keyOf(view) !== key) {
+                return
+            }
+            val color = Theme.getColor(Theme.key_featuredStickers_addButton)
+            fill.color = ColorUtils.setAlphaComponent(color, 38)
+            stroke.color = color
+            val inset = stroke.strokeWidth / 2f
+            rect.set(inset, inset, view.width - inset, view.height - inset)
+            val radius = AndroidUtilities.dpf2(8f)
+            canvas.drawRoundRect(rect, radius, radius, fill)
+            canvas.drawRoundRect(rect, radius, radius, stroke)
+        }
+
+        override fun setAlpha(alpha: Int) {}
+
+        override fun setColorFilter(colorFilter: ColorFilter?) {}
+
+        @Deprecated("Deprecated in Java")
+        override fun getOpacity(): Int = PixelFormat.TRANSLUCENT
+    }
+}
