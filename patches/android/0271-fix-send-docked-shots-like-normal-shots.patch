From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Thu, 5 Nov 2026 16:10:10 +0300
Subject: [PATCH] fix: send docked shots like normal shots

---
 .../org/telegram/messenger/SendMessagesHelper.java     |  2 +-
 .../src/main/java/tele/ui/settings/TeleShotActivity.kt | 10 +---------
 2 files changed, 2 insertions(+), 10 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/SendMessagesHelper.java b/TMessagesProj/src/main/java/org/telegram/messenger/SendMessagesHelper.java
index eabfd9d2a..6d9966666 100644
--- a/TMessagesProj/src/main/java/org/telegram/messenger/SendMessagesHelper.java
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/SendMessagesHelper.java
@@ -9553,7 +9553,7 @@ public class SendMessagesHelper extends BaseController implements NotificationCe
         if (uri != null && AndroidUtilities.isInternalUri(uri)) {
             return ERROR_TYPE_UNSUPPORTED;
         }
-        if (path != null && AndroidUtilities.isInternalUri(Uri.fromFile(new File(path))) && !path.contains("/tele_drafts/")) {
+        if (path != null && AndroidUtilities.isInternalUri(Uri.fromFile(new File(path))) && !path.contains("/tele_drafts/") && !path.contains("/tele_docked/")) {
             return ERROR_TYPE_UNSUPPORTED;
         }
         MimeTypeMap myMime = MimeTypeMap.getSingleton();
diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleShotActivity.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleShotActivity.kt
index e9cb26024..5e9a242cb 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TeleShotActivity.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleShotActivity.kt
@@ -392,7 +392,7 @@ class TeleShotActivity(origin: ChatActivity, private val source: List<MessageObj
         if (!canSendBack()) return
         val shotOptions = options
         export { rendered ->
-            val forceDocument = (!shotOptions.background && shotOptions.transparent) || !fitsPhoto(rendered.width, rendered.height)
+            val forceDocument = !shotOptions.background && shotOptions.transparent
             val entry = MediaController.PhotoEntry(0, 0, 0, rendered.file.absolutePath, 0, false, rendered.width, rendered.height, rendered.file.length())
             // the shot folder is emptied on every open, a docked shot has to outlive it
             val kept = if (tele.helpers.DockedMedia.enabled()) keepForTray(rendered.file) else null
@@ -412,12 +412,6 @@ class TeleShotActivity(origin: ChatActivity, private val source: List<MessageObj
         file.copyTo(File(dir, file.name), overwrite = true)
     }.getOrNull()
 
-    private fun fitsPhoto(width: Int, height: Int): Boolean {
-        val longSide = maxOf(width, height)
-        val shortSide = minOf(width, height)
-        return longSide <= PHOTO_SIDE_LIMIT && shortSide > 0 && longSide.toFloat() / shortSide <= PHOTO_MAX_RATIO
-    }
-
     companion object {
         private const val MENU_OPTIONS = 1
         private const val MENU_COPY = 2
@@ -426,8 +420,6 @@ class TeleShotActivity(origin: ChatActivity, private val source: List<MessageObj
         private const val MENU_SEND = 5
         private const val IMAGE_WAIT_MS = 3000L
         private const val SHEET_HEIGHT_RATIO = 0.5f
-        private const val PHOTO_SIDE_LIMIT = 2560
-        private const val PHOTO_MAX_RATIO = 20f
 
         private val PART_LABELS = listOf(
             ShotPart.NAMES to "Names and badges",
