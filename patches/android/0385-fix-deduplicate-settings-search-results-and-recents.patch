From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: test <test@example.com>
Date: Thu, 26 Nov 2026 18:34:11 +0300
Subject: [PATCH] fix: deduplicate settings search results and recents

---
 .../java/org/telegram/ui/ProfileActivity.java | 55 ++++++++++++++++---
 1 file changed, 48 insertions(+), 7 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/ProfileActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/ProfileActivity.java
index 82ff2ef74..ca619e90f 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/ProfileActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/ProfileActivity.java
@@ -15023,12 +15023,16 @@ public class ProfileActivity extends BaseFragment implements NotificationCenter.
                             String url = data.readString(false);
                             MessagesController.FaqSearchResult result = new MessagesController.FaqSearchResult(title, path, url);
                             result.num = num;
-                            recentSearches.add(result);
+                            if (!tele_containsVisibleResult(recentSearches, result)) {
+                                recentSearches.add(result);
+                            }
                         } else if (type == 1) {
                             SearchResult result = resultHashMap.get(data.readInt32(false));
                             if (result != null) {
                                 result.num = num;
-                                recentSearches.add(result);
+                                if (!tele_containsVisibleResult(recentSearches, result)) {
+                                    recentSearches.add(result);
+                                }
                             }
                         }
                     } catch (Exception ignore) {
@@ -15538,9 +15542,11 @@ public class ProfileActivity extends BaseFragment implements NotificationCenter.
         }
 
         public void addRecent(Object object) {
-            int index = recentSearches.indexOf(object);
-            if (index >= 0) {
-                recentSearches.remove(index);
+            for (int a = 0; a < recentSearches.size(); a++) {
+                if (tele_sameVisibleResult(recentSearches.get(a), object)) {
+                    recentSearches.remove(a);
+                    break;
+                }
             }
             recentSearches.add(0, object);
             if (!searchWas) {
@@ -15577,6 +15583,39 @@ public class ProfileActivity extends BaseFragment implements NotificationCenter.
             return 0;
         }
 
+        private static String tele_visibleTitle(Object object) {
+            if (object instanceof SearchResult) {
+                SearchResult result = (SearchResult) object;
+                return result.displayTitle != null ? result.displayTitle : result.searchTitle;
+            } else if (object instanceof MessagesController.FaqSearchResult) {
+                return ((MessagesController.FaqSearchResult) object).title;
+            }
+            return null;
+        }
+
+        private static String[] tele_path(Object object) {
+            if (object instanceof SearchResult) {
+                return ((SearchResult) object).path;
+            } else if (object instanceof MessagesController.FaqSearchResult) {
+                return ((MessagesController.FaqSearchResult) object).path;
+            }
+            return null;
+        }
+
+        private static boolean tele_sameVisibleResult(Object first, Object second) {
+            String title = tele_visibleTitle(first);
+            return title != null && title.equals(tele_visibleTitle(second)) && Arrays.equals(tele_path(first), tele_path(second));
+        }
+
+        private static boolean tele_containsVisibleResult(List<?> results, Object candidate) {
+            for (Object result : results) {
+                if (tele_sameVisibleResult(result, candidate)) {
+                    return true;
+                }
+            }
+            return false;
+        }
+
         public void search(String text) {
             lastSearchString = text;
             if (searchRunnable != null) {
@@ -15649,8 +15688,10 @@ public class ProfileActivity extends BaseFragment implements NotificationCenter.
                                     continue;
                                 }
                             }
-                            results.add(result);
-                            names.add(stringBuilder);
+                            if (!tele_containsVisibleResult(results, result)) {
+                                results.add(result);
+                                names.add(stringBuilder);
+                            }
                         }
                     }
                 }
