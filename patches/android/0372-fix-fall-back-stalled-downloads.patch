From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: test <test@example.com>
Date: Wed, 25 Nov 2026 08:32:04 +0300
Subject: [PATCH] fix: fall back stalled downloads

---
 TMessagesProj/jni/tgnet/Connection.cpp        | 17 +++++-
 TMessagesProj/jni/tgnet/Connection.h          |  5 ++
 .../jni/tgnet/ConnectionsManager.cpp          | 59 +++++++++++++++++--
 TMessagesProj/jni/tgnet/Datacenter.cpp        | 30 +++++++---
 TMessagesProj/jni/tgnet/Datacenter.h          |  3 +-
 TMessagesProj/jni/tgnet/Request.cpp           |  2 +-
 TMessagesProj/jni/tgnet/Request.h             |  2 +
 7 files changed, 104 insertions(+), 14 deletions(-)

diff --git a/TMessagesProj/jni/tgnet/Connection.cpp b/TMessagesProj/jni/tgnet/Connection.cpp
index 3ce0c222d..8f1b2c907 100644
--- a/TMessagesProj/jni/tgnet/Connection.cpp
+++ b/TMessagesProj/jni/tgnet/Connection.cpp
@@ -308,7 +308,7 @@ void Connection::connect() {
     }
     uint32_t isStatic = connectionType == ConnectionTypeProxy || !ConnectionsManager::getInstance(currentDatacenter->instanceNum).proxyAddress.empty() ? TcpAddressFlagStatic : 0;
     TcpAddress *tcpAddress = nullptr;
-    if (isMediaConnectionType(connectionType)) {
+    if (isMediaConnectionType(connectionType) && !(isDownloadConnectionType(connectionType) && regularDownloadRoute)) {
         currentAddressFlags = TcpAddressFlagDownload | isStatic;
         tcpAddress = currentDatacenter->getCurrentAddress(currentAddressFlags | ipv6);
         if (tcpAddress == nullptr) {
@@ -415,6 +415,18 @@ bool Connection::isMediaConnectionType(ConnectionType type) {
     return (type & ConnectionTypeGenericMedia) != 0 || (type & ConnectionTypeDownload) != 0;
 }
 
+bool Connection::isDownloadConnectionType(uint32_t type) {
+    return (type & 0xffff) == ConnectionTypeDownload;
+}
+
+bool Connection::usesMediaAddress() const {
+    return isMediaConnection;
+}
+
+bool Connection::isRegularDownloadRoute() const {
+    return regularDownloadRoute;
+}
+
 void Connection::setHasUsefullData() {
     if (!usefullData) {
         usefullDataReceiveTime = ConnectionsManager::getInstance(currentDatacenter->instanceNum).getCurrentTimeMonotonicMillis();
@@ -738,6 +750,9 @@ void Connection::onConnected() {
     wasConnected = true;
     if (LOGS_ENABLED) DEBUG_D("connection(%p, account%u, dc%u, type %d) connected to %s:%hu", this, currentDatacenter->instanceNum, currentDatacenter->getDatacenterId(), connectionType, hostAddress.c_str(), hostPort);
     ConnectionsManager::getInstance(currentDatacenter->instanceNum).onConnectionConnected(this);
+    if (isDownloadConnectionType(connectionType) && isMediaConnection) {
+        mediaConnectTimeouts = 0;
+    }
 }
 
 bool Connection::hasPendingRequests() {
diff --git a/TMessagesProj/jni/tgnet/Connection.h b/TMessagesProj/jni/tgnet/Connection.h
index 81e4d5edc..50aad4fd6 100644
--- a/TMessagesProj/jni/tgnet/Connection.h
+++ b/TMessagesProj/jni/tgnet/Connection.h
@@ -42,6 +42,9 @@ public:
     Datacenter *getDatacenter();
     bool isSuspended();
     static bool isMediaConnectionType(ConnectionType type);
+    static bool isDownloadConnectionType(uint32_t type);
+    bool usesMediaAddress() const;
+    bool isRegularDownloadRoute() const;
 
 protected:
 
@@ -102,6 +105,8 @@ private:
     uint32_t currentTimeout = 4;
     uint32_t receivedDataAmount = 0;
     uint32_t generation = 0;
+    bool regularDownloadRoute = false;
+    uint8_t mediaConnectTimeouts = 0;
 
     uint8_t temp[64];
 
diff --git a/TMessagesProj/jni/tgnet/ConnectionsManager.cpp b/TMessagesProj/jni/tgnet/ConnectionsManager.cpp
index b9d0c46a0..b3a19b673 100644
--- a/TMessagesProj/jni/tgnet/ConnectionsManager.cpp
+++ b/TMessagesProj/jni/tgnet/ConnectionsManager.cpp
@@ -701,6 +701,54 @@ void ConnectionsManager::onConnectionClosed(Connection *connection, int reason)
         lastProtocolUsefullData = false;
     }
     Datacenter *datacenter = connection->getDatacenter();
+    if (reason == 2 && Connection::isDownloadConnectionType(connection->getConnectionType()) &&
+            !datacenter->isCdnDatacenter && connection->usesMediaAddress() &&
+            !connection->hasSomeDataSinceLastConnect && !connection->regularDownloadRoute) {
+        if (++connection->mediaConnectTimeouts >= 2) {
+            uint32_t flags = connection->currentAddressFlags & ~TcpAddressFlagDownload;
+            if (datacenter->getCurrentAddress(flags) != nullptr) {
+                uint32_t token = connection->getConnectionToken();
+                uint8_t slot = connection->getConnectionNum();
+                scheduleTask([this, connection, datacenter, token, slot] {
+                    if (LOGS_ENABLED) DEBUG_D("download slot %u timed out twice on media route, trying regular DC %u", slot, datacenter->getDatacenterId());
+                    connection->regularDownloadRoute = true;
+                    connection->mediaConnectTimeouts = 0;
+                    connection->failedConnectionCount = 0;
+                    connection->willRetryConnectCount = 1;
+                    connection->lastReconnectTimeout = 100;
+                    connection->isTryingNextPort = false;
+                    connection->forceNextPort = false;
+                    connection->recreateSession();
+                    auto markRegular = [&](Request *request) {
+                        if (request->cancelled || request->datacenterId != datacenter->getDatacenterId() ||
+                                !Connection::isDownloadConnectionType(request->connectionType) ||
+                                (uint8_t) (request->connectionType >> 16) != slot) {
+                            return;
+                        }
+                        request->regularDownloadRoute = true;
+                        request->regularDownloadDcId = request->datacenterId;
+                        if (request->isInitMediaRequest) {
+                            request->isInitMediaRequest = false;
+                            request->isInitRequest = true;
+                        }
+                    };
+                    for (auto &request : runningRequests) {
+                        if (request->connectionToken == token) {
+                            markRegular(request.get());
+                            request->retryCount = 0;
+                            request->clear(true);
+                        }
+                    }
+                    for (auto &request : requestsQueue) {
+                        markRegular(request.get());
+                    }
+                    processRequestQueue(ConnectionTypeDownload, datacenter->getDatacenterId(), connection);
+                });
+            }
+        }
+    } else if (reason != 2 || connection->hasSomeDataSinceLastConnect) {
+        connection->mediaConnectTimeouts = 0;
+    }
     if ((connection->getConnectionType() == ConnectionTypeGeneric || connection->getConnectionType() == ConnectionTypeGenericMedia) && datacenter->isHandshakingAny()) {
         datacenter->onHandshakeConnectionClosed(connection);
     }
@@ -806,7 +854,10 @@ void ConnectionsManager::onConnectionConnected(Connection *connection) {
         return;
     }
 
-    if (datacenter->hasAuthKey(connectionType, 1)) {
+    ConnectionType authKeyType = connectionType == ConnectionTypeDownload
+            ? (ConnectionType) (ConnectionTypeDownload | (connection->getConnectionNum() << 16))
+            : connectionType;
+    if (datacenter->hasAuthKey(authKeyType, 1)) {
         if (connectionType == ConnectionTypePush) {
             sendingPushPing = false;
             lastPushPingTime = getCurrentTimeMonotonicMillis();
@@ -1132,7 +1183,7 @@ void ConnectionsManager::processServerResponse(TLObject *message, int64_t messag
             salt->valid_until = salt->valid_since = getCurrentTime();
             salt->valid_until += 30 * 60;
             salt->salt = response->server_salt;
-            datacenter->addServerSalt(salt, Connection::isMediaConnectionType(connection->getConnectionType()));
+            datacenter->addServerSalt(salt, connection->usesMediaAddress());
 
             for (auto & runningRequest : runningRequests) {
                 Request *request = runningRequest.get();
@@ -1648,7 +1699,7 @@ void ConnectionsManager::processServerResponse(TLObject *message, int64_t messag
                 break;
         }
     } else if (typeInfo == typeid(TL_bad_server_salt)) {
-        bool media = Connection::isMediaConnectionType(connection->getConnectionType());
+        bool media = connection->usesMediaAddress();
         requestSaltsForDatacenter(datacenter, media, connection->getConnectionType() == ConnectionTypeTemp);
         if (messageId != 0) {
             auto time = (int64_t) (messageId / 4294967296.0 * 1000);
@@ -3193,7 +3244,7 @@ void ConnectionsManager::processRequestQueue(uint32_t connectionTypes, uint32_t
     size_t count = neededDatacenters.size();
     for (uint32_t a = 0; a < count; a++) {
         Datacenter *datacenter = neededDatacenters[a].first;
-        bool media = Connection::isMediaConnectionType(neededDatacenters[a].second) && datacenter->hasMediaAddress();
+        bool media = datacenter->isMediaRoute(neededDatacenters[a].second);
         if (datacenter->getDatacenterId() != movingToDatacenterId && !datacenter->isHandshaking(media) && !datacenter->hasAuthKey(neededDatacenters[a].second, 1)) {
             datacenter->beginHandshake(media ? HandshakeTypeMediaTemp : HandshakeTypeTemp, true);
         }
diff --git a/TMessagesProj/jni/tgnet/Datacenter.cpp b/TMessagesProj/jni/tgnet/Datacenter.cpp
index 7adf307da..cf855fe0b 100644
--- a/TMessagesProj/jni/tgnet/Datacenter.cpp
+++ b/TMessagesProj/jni/tgnet/Datacenter.cpp
@@ -820,10 +820,15 @@ void Datacenter::recreateSessions(HandshakeType type) {
                 a->recreateSession();
             }
         }
+        for (auto & a : downloadConnection) {
+            if (a != nullptr && a->isRegularDownloadRoute()) {
+                a->recreateSession();
+            }
+        }
     }
     if (type == HandshakeTypeAll || type == HandshakeTypeMediaTemp || type == HandshakeTypePerm) {
         for (auto & a : downloadConnection) {
-            if (a != nullptr) {
+            if (a != nullptr && !a->isRegularDownloadRoute()) {
                 a->recreateSession();
             }
         }
@@ -1072,7 +1077,18 @@ inline void generateMessageKey(int32_t instanceNum, uint8_t *authKey, uint8_t *m
     }
 }
 
-ByteArray *Datacenter::getAuthKey(ConnectionType connectionType, bool perm, int64_t *authKeyId, int32_t allowPendingKey) {
+bool Datacenter::isMediaRoute(uint32_t connectionType) {
+    if (!Connection::isMediaConnectionType((ConnectionType) (connectionType & 0xffff)) || !hasMediaAddress()) {
+        return false;
+    }
+    if (Connection::isDownloadConnectionType(connectionType)) {
+        Connection *connection = downloadConnection[(uint8_t) (connectionType >> 16)];
+        return connection == nullptr || !connection->isRegularDownloadRoute();
+    }
+    return true;
+}
+
+ByteArray *Datacenter::getAuthKey(ConnectionType connectionType, bool perm, int64_t *authKeyId, int32_t allowPendingKey, Connection *connection) {
     bool usePermKey = isCdnDatacenter || perm || !PFS_ENABLED;
     if (usePermKey) {
         if (authKeyId != nullptr) {
@@ -1080,7 +1096,7 @@ ByteArray *Datacenter::getAuthKey(ConnectionType connectionType, bool perm, int6
         }
         return authKeyPerm;
     } else {
-        bool media = Connection::isMediaConnectionType(connectionType) && hasMediaAddress();
+        bool media = connection != nullptr ? connection->usesMediaAddress() : isMediaRoute(connectionType);
         ByteArray *authKeyPending = nullptr;
         int64_t authKeyPendingId = 0;
         for (auto & iter : handshakes) {
@@ -1112,7 +1128,7 @@ ByteArray *Datacenter::getAuthKey(ConnectionType connectionType, bool perm, int6
 
 NativeByteBuffer *Datacenter::createRequestsData(std::vector<std::unique_ptr<NetworkMessage>> &requests, int32_t *quickAckId, Connection *connection, bool pfsInit) {
     int64_t authKeyId;
-    ByteArray *authKey = getAuthKey(connection->getConnectionType(), pfsInit, &authKeyId, 1);
+    ByteArray *authKey = getAuthKey(connection->getConnectionType(), pfsInit, &authKeyId, 1, connection);
     if (authKey == nullptr) {
         return nullptr;
     }
@@ -1195,7 +1211,7 @@ NativeByteBuffer *Datacenter::createRequestsData(std::vector<std::unique_ptr<Net
         RAND_bytes((uint8_t *) &value, 8);
         buffer->writeInt64(value);
     } else {
-        buffer->writeInt64(getServerSalt(Connection::isMediaConnectionType(connection->getConnectionType())));
+        buffer->writeInt64(getServerSalt(connection->usesMediaAddress()));
         buffer->writeInt64(connection->getSessionId());
     }
     buffer->writeInt64(messageId);
@@ -1245,7 +1261,7 @@ NativeByteBuffer *Datacenter::createRequestsData(std::vector<std::unique_ptr<Net
 
 bool Datacenter::decryptServerResponse(int64_t keyId, uint8_t *key, uint8_t *data, uint32_t length, Connection *connection) {
     int64_t authKeyId;
-    ByteArray *authKey = getAuthKey(connection->getConnectionType(), false, &authKeyId, 1);
+    ByteArray *authKey = getAuthKey(connection->getConnectionType(), false, &authKeyId, 1, connection);
     if (authKey == nullptr) {
         return false;
     }
@@ -1324,7 +1340,7 @@ Connection *Datacenter::getProxyConnection(uint8_t num, bool create, bool connec
 }
 
 Connection *Datacenter::getDownloadConnection(uint8_t num, bool create) {
-    ByteArray *authKey = getAuthKey(ConnectionTypeDownload, false, nullptr, 0);
+    ByteArray *authKey = getAuthKey((ConnectionType) (ConnectionTypeDownload | (num << 16)), false, nullptr, 0);
     if (authKey == nullptr) {
         return nullptr;
     }
diff --git a/TMessagesProj/jni/tgnet/Datacenter.h b/TMessagesProj/jni/tgnet/Datacenter.h
index 8d10580b8..e0f025705 100644
--- a/TMessagesProj/jni/tgnet/Datacenter.h
