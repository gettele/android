 bool Request::isCancelRequest() {
diff --git a/TMessagesProj/jni/tgnet/Request.h b/TMessagesProj/jni/tgnet/Request.h
index 78b28608e..662f27d5e 100644
--- a/TMessagesProj/jni/tgnet/Request.h
+++ b/TMessagesProj/jni/tgnet/Request.h
@@ -47,6 +47,8 @@ public:
     bool cancelled = false;
     bool isInitRequest = false;
     bool isInitMediaRequest = false;
+    bool regularDownloadRoute = false;
+    uint32_t regularDownloadDcId = 0;
     uint8_t dataType = 0;
     int32_t serializedLength = 0;
     int32_t startTime = 0;
