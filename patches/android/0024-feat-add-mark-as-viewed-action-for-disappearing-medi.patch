From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Fri, 2 Oct 2026 20:16:49 +0300
Subject: [PATCH] feat: add mark as viewed action for disappearing media

---
 .../telegram/messenger/MessagesController.java   |  2 +-
 .../main/java/org/telegram/ui/ChatActivity.java  | 10 ++++++++++
 TMessagesProj/src/main/java/tele/TeleHooks.kt    | 16 ++++++++++++++++
 3 files changed, 27 insertions(+), 1 deletion(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/MessagesController.java b/TMessagesProj/src/main/java/org/telegram/messenger/MessagesController.java
index 6923bf3d0..0e70528fa 100644
--- a/TMessagesProj/src/main/java/org/telegram/messenger/MessagesController.java
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/MessagesController.java
@@ -14393,7 +14393,7 @@ public class MessagesController extends BaseController implements NotificationCe
         if (messageObject.scheduled) {
             return;
         }
-        if (tele.TeleConfig.KEEP_DISAPPEARING_MEDIA.getValue() && tele.TeleHooks.isDisappearing(messageObject)) {
+        if (tele.TeleHooks.shouldSkipViewed() && tele.TeleHooks.isDisappearing(messageObject)) {
             return;
         }
         ArrayList<Integer> arrayList = new ArrayList<>();
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
index 8ff300bdd..178374b7b 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
@@ -1242,6 +1242,7 @@ public class ChatActivity extends BaseFragment implements
     public final static int OPTION_TRANSCRIBE = 30;
     public final static int OPTION_HIDE_SPONSORED_MESSAGE = 31;
     public final static int OPTION_VIEW_IN_TOPIC = 32;
+    public final static int tele_option_mark_viewed = 217;
     public final static int OPTION_ABOUT_REVENUE_SHARING_ADS = 33;
     public final static int OPTION_REPORT_AD = 34;
     public final static int OPTION_REMOVE_ADS = 35;
@@ -33496,6 +33497,10 @@ public class ChatActivity extends BaseFragment implements
                 presentFragment(fragment);
                 break;
             }
+            case tele_option_mark_viewed: {
+                tele.TeleHooks.forceMarkViewed(currentAccount, selectedObject);
+                break;
+            }
             case OPTION_COPY: {
                 final TL_iv.RichMessage copyRichMessage = selectedObject.messageOwner != null ? selectedObject.messageOwner.rich_message : null;
                 if (selectedObject.isDice()) {
@@ -45987,6 +45992,11 @@ public class ChatActivity extends BaseFragment implements
             deleteIconRes = R.drawable.msg_delete;
         }
 
+        if (tele.TeleConfig.KEEP_DISAPPEARING_MEDIA.getValue() && tele.TeleHooks.isDisappearing(selectedObject)) {
+            items.add("mark as viewed");
+            options.add(tele_option_mark_viewed);
+            icons.add(R.drawable.msg_delete);
+        }
         if (type == -1) {
             if ((selectedObject.type == MessageObject.TYPE_TEXT || selectedObject.type == MessageObject.TYPE_ARTICLE || selectedObject.isAnimatedEmoji() || selectedObject.isAnimatedEmojiStickers() || getMessageCaption(selectedObject, selectedObjectGroup) != null) && (!noforwardsOrPaidMedia || isEphemeral) && !message.isExpiredStory()) {
                 items.add(LocaleController.getString(R.string.Copy));
diff --git a/TMessagesProj/src/main/java/tele/TeleHooks.kt b/TMessagesProj/src/main/java/tele/TeleHooks.kt
index 2d13554ef..481600c3c 100644
--- a/TMessagesProj/src/main/java/tele/TeleHooks.kt
+++ b/TMessagesProj/src/main/java/tele/TeleHooks.kt
@@ -7,6 +7,7 @@ import org.telegram.messenger.AccountInstance
 import org.telegram.messenger.LocaleController
 import org.telegram.messenger.NotificationCenter
 import org.telegram.messenger.MessageObject
+import org.telegram.messenger.MessagesController
 import org.telegram.messenger.UserConfig
 import org.telegram.ui.ActionBar.AlertDialog
 import tele.db.TeleDatabaseHelper
@@ -72,6 +73,21 @@ object TeleHooks {
         return media.ttl_seconds != 0
     }
 
+    private var forceViewed = false
+
+    @JvmStatic
+    fun shouldSkipViewed(): Boolean = !forceViewed && TeleConfig.KEEP_DISAPPEARING_MEDIA.value
+
+    @JvmStatic
+    fun forceMarkViewed(account: Int, message: MessageObject) {
+        forceViewed = true
+        try {
+            MessagesController.getInstance(account).markMessageContentAsRead(message)
+        } finally {
+            forceViewed = false
+        }
+    }
+
     @JvmStatic
     fun storiesHeaderTitle(stock: CharSequence?): CharSequence = stock ?: TeleBuild.label()
 }
