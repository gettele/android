diff --git a/TMessagesProj/src/main/java/tele/helpers/ObservedActivity.kt b/TMessagesProj/src/main/java/tele/helpers/ObservedActivity.kt
new file mode 100644
index 000000000..006bc1764
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/ObservedActivity.kt
@@ -0,0 +1,156 @@
+package tele.helpers
+
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.ApplicationLoader
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.MessagesController
+import org.telegram.messenger.NotificationCenter
+import org.telegram.messenger.R
+import org.telegram.messenger.UserObject
+import org.telegram.messenger.Utilities
+import tele.TeleConfig
+import tele.db.TeleDatabaseHelper
+import java.util.Calendar
+import java.util.concurrent.ConcurrentHashMap
+
+/**
+ * The last activity this device has already seen for people whose last seen is hidden
+ * (tele 0325). Incoming messages, typing, read receipts and reactions are remembered
+ * locally; nothing is requested from the server, and only the time of the action is kept.
+ */
+object ObservedActivity {
+    private const val PREFIX = "observed_activity"
+    private const val MAX_ENTRIES = 5000
+    private const val SAVE_DELAY = 10_000L
+    private const val NOTIFY_INTERVAL = 1000L
+
+    private val times = ConcurrentHashMap<Int, ConcurrentHashMap<Long, Int>>()
+    private val loaded = ConcurrentHashMap.newKeySet<Int>()
+    private val scheduled = ConcurrentHashMap.newKeySet<Int>()
+    private val lastNotify = ConcurrentHashMap<Int, Long>()
+
+    private fun key(account: Int) = "$PREFIX:$account"
+
+    /** Load every activated account off the UI thread; the status labels read the memory map. */
+    @JvmStatic
+    fun preload() {
+        Utilities.globalQueue.postRunnable {
+            // preload runs before the accounts finish activating, so read every key
+            for (account in 0 until org.telegram.messenger.UserConfig.MAX_ACCOUNT_COUNT) {
+                load(account)
+            }
+        }
+    }
+
+    private fun load(account: Int) {
+        if (!loaded.add(account)) return
+        val raw = TeleDatabaseHelper.get(key(account)) ?: return
+        val map = times.getOrPut(account) { ConcurrentHashMap() }
+        for (part in raw.split(';')) {
+            val pair = part.split(':')
+            if (pair.size != 2) continue
+            val id = pair[0].toLongOrNull() ?: continue
+            val whenTime = pair[1].toIntOrNull() ?: continue
+            if (id > 0 && whenTime > 0 && whenTime > (map[id] ?: 0)) {
+                map[id] = whenTime
+            }
+        }
+    }
+
+    /** Remember an action of [userId] seen at [whenTime]; hidden statuses only. */
+    @JvmStatic
+    fun note(account: Int, userId: Long, whenTime: Int) {
+        if (!TeleConfig.OBSERVED_ACTIVITY.value || userId <= 0 || whenTime <= 0) return
+        if (UserObject.isService(userId)) return
+        val user = MessagesController.getInstance(account).getUser(userId) ?: return
+        if (user.bot || user.self || user.support) return
+        if (user.status == null || user.status.expires > 0) return
+        val now = (System.currentTimeMillis() / 1000L).toInt()
+        val stamp = minOf(whenTime, now)
+        val map = times.getOrPut(account) { ConcurrentHashMap() }
+        if (stamp <= (map[userId] ?: 0)) return
+        map[userId] = stamp
+        trim(map)
+        scheduleSave(account)
+        notifyUi(account)
+    }
+
+    @JvmStatic
+    fun lastSeen(account: Int, userId: Long): Int = times[account]?.get(userId) ?: 0
+
+    /** "last seen recently" becomes "last seen recently (14:32)" while the option is on. */
+    @JvmStatic
+    fun withStatus(account: Int, userId: Long, status: String?): String? {
+        if (!TeleConfig.OBSERVED_ACTIVITY.value || status.isNullOrEmpty()) return status
+        val whenTime = lastSeen(account, userId)
+        if (whenTime <= 0) return status
+        return "$status (${formatWhen(whenTime)})"
+    }
+
+    private fun formatWhen(whenTime: Int): String {
+        val date = java.util.Date(whenTime * 1000L)
+        val then = Calendar.getInstance().apply { timeInMillis = date.time }
+        val now = Calendar.getInstance()
+        val timeText = android.text.format.DateFormat.getTimeFormat(
+            ApplicationLoader.applicationContext
+        ).format(date)
+        val yesterday = Calendar.getInstance().apply {
+            timeInMillis = date.time
+            add(Calendar.DAY_OF_YEAR, 1)
+        }
+        return when {
+            then.get(Calendar.YEAR) == now.get(Calendar.YEAR) &&
+                then.get(Calendar.DAY_OF_YEAR) == now.get(Calendar.DAY_OF_YEAR) -> timeText
+            yesterday.get(Calendar.YEAR) == now.get(Calendar.YEAR) &&
+                yesterday.get(Calendar.DAY_OF_YEAR) == now.get(Calendar.DAY_OF_YEAR) ->
+                LocaleController.formatString(R.string.YesterdayAtFormatted, timeText)
+            then.get(Calendar.YEAR) == now.get(Calendar.YEAR) ->
+                LocaleController.formatString(
+                    R.string.formatDateAtTime,
+                    LocaleController.getInstance().formatterDayMonth.format(date),
+                    timeText
+                )
+            else -> LocaleController.formatString(
+                R.string.formatDateAtTime,
+                LocaleController.getInstance().formatterYear.format(date),
+                timeText
+            )
+        }
+    }
+
+    private fun trim(map: ConcurrentHashMap<Long, Int>) {
+        if (map.size <= MAX_ENTRIES) return
+        val oldest = map.entries.minByOrNull { it.value } ?: return
+        map.remove(oldest.key)
+    }
+
+    private fun scheduleSave(account: Int) {
+        if (!scheduled.add(account)) return
+        Utilities.globalQueue.postRunnable({
+            scheduled.remove(account)
+            save(account)
+        }, SAVE_DELAY)
+    }
+
+    private fun save(account: Int) {
+        val map = times[account] ?: return
+        val builder = StringBuilder()
+        for ((id, whenTime) in map) {
+            if (builder.isNotEmpty()) builder.append(';')
+            builder.append(id).append(':').append(whenTime)
+        }
+        TeleDatabaseHelper.put(key(account), builder.toString())
+    }
+
+    private fun notifyUi(account: Int) {
+        val now = System.currentTimeMillis()
+        if (now - (lastNotify[account] ?: 0L) < NOTIFY_INTERVAL) return
+        lastNotify[account] = now
+        AndroidUtilities.runOnUIThread {
+            NotificationCenter.getInstance(account).postNotificationName(
+                NotificationCenter.updateInterfaces,
+                MessagesController.UPDATE_MASK_STATUS
+            )
+        }
+    }
+}
