diff --git a/TMessagesProj/src/main/java/tele/scripting/ScriptMessageActions.kt b/TMessagesProj/src/main/java/tele/scripting/ScriptMessageActions.kt
new file mode 100644
index 000000000..26cd9484b
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/scripting/ScriptMessageActions.kt
@@ -0,0 +1,79 @@
+package tele.scripting
+
+import org.json.JSONArray
+import org.json.JSONObject
+import org.telegram.messenger.MessageObject
+import java.util.concurrent.CopyOnWriteArrayList
+import java.util.concurrent.atomic.AtomicInteger
+
+/** The actions a script puts into the long-press menu of a message. */
+object ScriptMessageActions {
+
+    class Action(
+        val runtime: ScriptRuntime,
+        val callback: Int,
+        val text: String,
+        val icon: String?,
+        val chats: List<String>
+    )
+
+    private val actions = CopyOnWriteArrayList<Action>()
+    private val ids = AtomicInteger(1)
+
+    @JvmStatic
+    fun register(runtime: ScriptRuntime, options: JSONObject): Int {
+        // the id the js side sends is the callback; the token only removes this item again
+        val id = ids.getAndIncrement()
+        val chats = options.opt("chats")?.let { raw ->
+            when (raw) {
+                is JSONArray -> buildList { for (i in 0 until raw.length()) add(raw.optString(i)) }
+                else -> listOf(raw.toString())
+            }
+        } ?: listOf("all")
+        actions.add(Action(runtime, options.optInt("id"), options.optString("text"), options.optString("icon"), chats))
+        return id
+    }
+
+    @JvmStatic
+    fun unregister(runtime: ScriptRuntime, token: Int) {
+        actions.removeAll { it.runtime === runtime && it.callback == token }
+    }
+
+    @JvmStatic
+    fun unregister(runtime: ScriptRuntime) {
+        actions.removeAll { it.runtime === runtime }
+    }
+
+    /** The actions that fit this message's chat, in registration order. */
+    @JvmStatic
+    fun list(account: Int, message: MessageObject): List<Action> {
+        if (actions.isEmpty()) return emptyList()
+        val kind = chatKind(message)
+        return actions.filter { action ->
+            action.runtime.isRunning() && action.runtime.account == account &&
+                (action.chats.contains("all") || action.chats.contains(kind))
+        }
+    }
+
+    @JvmStatic
+    fun invoke(account: Int, message: MessageObject, index: Int) {
+        val action = list(account, message).getOrNull(index) ?: return
+        val context = JSONObject()
+            .put("chatId", JSONObject().put("\$b", message.getDialogId().toString()))
+            .put("messageId", message.getId())
+            .put("text", message.messageText?.toString() ?: "")
+            .put("date", message.messageOwner?.date ?: 0)
+            .put("out", message.isOut())
+        action.runtime.dispatch(action.callback, "message", JSONArray().put(context))
+    }
+
+    private fun chatKind(message: MessageObject): String {
+        val peer = message.messageOwner?.peer_id
+        return when (peer) {
+            is org.telegram.tgnet.TLRPC.TL_peerUser -> "user"
+            is org.telegram.tgnet.TLRPC.TL_peerChat -> "group"
+            is org.telegram.tgnet.TLRPC.TL_peerChannel -> if (message.messageOwner != null && message.messageOwner.post) "channel" else "group"
+            else -> "user"
+        }
+    }
+}
