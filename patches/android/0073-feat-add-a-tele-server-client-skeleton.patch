+package tele.helpers
+
+import android.content.Context
+import org.telegram.messenger.ApplicationLoader
+import org.telegram.messenger.FileLog
+import tele.TeleConfig
+import java.io.File
+import java.net.HttpURLConnection
+import java.net.URL
+
+object TeleServer {
+    private const val CACHE_FILE = "tele_badges.json"
+    private const val ENDPOINT = "/v1/badges"
+
+    @JvmStatic
+    fun isEnabled(): Boolean = TeleConfig.TELE_SERVER_URL.value.isNotBlank()
+
+    @JvmStatic
+    fun serverUrl(): String = TeleConfig.TELE_SERVER_URL.value.trim().trimEnd('/')
+
+    @JvmStatic
+    fun cachedFile(context: Context = ApplicationLoader.applicationContext): File =
+        File(context.filesDir, CACHE_FILE)
+
+    @JvmStatic
+    fun init(context: Context) {
+        // Skeleton: a full fetch loop is wired in a follow-up patch.
+        // Kept as an explicit no-op entry point so the rest of the app
+        // can call TeleServer.start() without caring about the URL.
+    }
+
+    @JvmStatic
+    fun start(context: Context) {
+        if (!isEnabled()) return
+        fetchAsync(context)
+    }
+
+    @JvmStatic
+    fun fetchAsync(context: Context = ApplicationLoader.applicationContext) {
+        val base = serverUrl()
+        if (base.isEmpty()) return
+        Thread {
+            var connection: HttpURLConnection? = null
+            try {
+                connection = URL(base + ENDPOINT).openConnection() as HttpURLConnection
+                connection.connectTimeout = 10_000
+                connection.readTimeout = 30_000
+                connection.setRequestProperty("Accept", "application/json")
+                if (connection.responseCode in 200..299) {
+                    val body = connection.inputStream.bufferedReader().use { it.readText() }
+                    cachedFile(context).writeText(body)
+                    FileLog.d("TeleServer: fetched ${body.length} bytes")
+                } else {
+                    FileLog.e("TeleServer: HTTP ${connection.responseCode}")
+                }
+            } catch (e: Exception) {
+                FileLog.e(e)
+            } finally {
+                connection?.disconnect()
+            }
+        }.start()
+    }
+
+    @JvmStatic
+    fun clearCachedData(context: Context = ApplicationLoader.applicationContext) {
+        val file = cachedFile(context)
+        if (file.exists()) file.delete()
+    }
+
+    @JvmStatic
+    fun cachedJson(context: Context = ApplicationLoader.applicationContext): String? {
+        val file = cachedFile(context)
+        return if (file.exists()) runCatching { file.readText() }.getOrNull() else null
+    }
+}
