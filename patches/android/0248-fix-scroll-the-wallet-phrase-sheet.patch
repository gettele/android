From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Tue, 3 Nov 2026 16:31:12 +0300
Subject: [PATCH] fix: scroll the wallet phrase sheet

---
 .../ui/Wallet/WalletKeysBackupFragment.java        | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Wallet/WalletKeysBackupFragment.java b/TMessagesProj/src/main/java/org/telegram/ui/Wallet/WalletKeysBackupFragment.java
index dea4438e3..097c4c97e 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Wallet/WalletKeysBackupFragment.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Wallet/WalletKeysBackupFragment.java
@@ -18,6 +18,7 @@ import android.view.View;
 import android.widget.FrameLayout;
 import android.widget.ImageView;
 import android.widget.LinearLayout;
+import android.widget.ScrollView;
 import android.widget.TextView;
 
 import org.json.JSONException;
@@ -274,7 +275,18 @@ public class WalletKeysBackupFragment extends UniversalFragment implements Notif
         contentLayout.addView(makeLearnBullet(context, resourcesProvider, R.drawable.wallet_learn_protected,
                 LocaleController.getString(R.string.WalletRecoveryPhraseSupportWarning)));
 
-        linearLayout.addView(contentLayout, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT));
+        // 24 words in two columns are taller than a small screen, so the content scrolls
+        ScrollView contentScroll = new ScrollView(context) {
+            @Override
+            protected void onMeasure(int widthMeasureSpec, int heightMeasureSpec) {
+                final int cap = (int) (AndroidUtilities.displaySize.y * 0.66f);
+                super.onMeasure(widthMeasureSpec, MeasureSpec.makeMeasureSpec(cap, MeasureSpec.AT_MOST));
+            }
+        };
+        contentScroll.setVerticalScrollBarEnabled(false);
+        contentScroll.setClipToPadding(false);
+        contentScroll.addView(contentLayout, LayoutHelper.createScroll(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT, Gravity.TOP));
+        linearLayout.addView(contentScroll, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT));
 
         ButtonWithCounterView button = new ButtonWithCounterView(context, resourcesProvider).setRound();
         button.setText(LocaleController.getString(R.string.WalletRecoveryPhraseLearnButton), false);
