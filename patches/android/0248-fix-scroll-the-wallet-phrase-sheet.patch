+    /** The share of the screen a scrollable sheet body may take, so its buttons stay visible. In dp. */
+    private static int contentHeight(Context context) {
+        final android.util.DisplayMetrics metrics = context.getResources().getDisplayMetrics();
+        final int screenDp = (int) (metrics.heightPixels / metrics.density);
+        return Math.max(220, (int) (screenDp * 0.62f));
+    }
