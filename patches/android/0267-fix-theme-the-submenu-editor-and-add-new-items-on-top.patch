Subject: [PATCH] fix: theme the submenu editor and add new items on top

---
 .../java/tele/ui/settings/TeleMenuActivity.kt    | 16 ++++++++++------
 1 file changed, 10 insertions(+), 6 deletions(-)

diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleMenuActivity.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleMenuActivity.kt
index 68d430390..62b4a6612 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TeleMenuActivity.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleMenuActivity.kt
@@ -81,7 +81,7 @@ class TeleMenuActivity(private val kind: TeleMenuKind = TeleMenuKind.MESSAGE) :
         load()
 
         val frameLayout = FrameLayout(context)
-        frameLayout.setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundGray))
+        frameLayout.setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundGray, resourceProvider))
         fragmentView = frameLayout
 
         val listView = RecyclerListView(context)
@@ -368,7 +368,8 @@ class TeleMenuActivity(private val kind: TeleMenuKind = TeleMenuKind.MESSAGE) :
                 2 -> TeleMenuEntry.Separator.Style.THICK
                 else -> TeleMenuEntry.Separator.Style.AUTO
             }
-            currentLevel().add(TeleMenuEntry.Separator(style))
+            currentLevel().add(0, TeleMenuEntry.Separator(style))
+            listView?.layoutManager?.scrollToPosition(1)
             adapter?.notifyDataSetChanged()
         }
         showDialog(builder.create())
@@ -382,7 +383,8 @@ class TeleMenuActivity(private val kind: TeleMenuKind = TeleMenuKind.MESSAGE) :
         builder.setPositiveButton(lc("Create")) { _, _ ->
             val title = input.text.toString().trim()
             if (title.isEmpty()) return@setPositiveButton
-            currentLevel().add(TeleMenuEntry.Submenu(title, mutableListOf()))
+            currentLevel().add(0, TeleMenuEntry.Submenu(title, mutableListOf()))
+            listView?.layoutManager?.scrollToPosition(1)
             adapter?.notifyDataSetChanged()
         }
         builder.setNegativeButton(lc("Cancel"), null)
@@ -420,8 +422,10 @@ class TeleMenuActivity(private val kind: TeleMenuKind = TeleMenuKind.MESSAGE) :
         input.setHint(lc(hint))
         input.setSingleLine(true)
         input.setTextSize(android.util.TypedValue.COMPLEX_UNIT_DIP, 16f)
-        input.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
-        input.setHintColor(Theme.getColor(Theme.key_windowBackgroundWhiteHintText))
+        input.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText, resourceProvider))
+        val hintColor = Theme.getColor(Theme.key_windowBackgroundWhiteHintText, resourceProvider)
+        input.setHintTextColor(hintColor)
+        input.setHintColor(hintColor)
         input.setPadding(0, AndroidUtilities.dp(12f), 0, AndroidUtilities.dp(12f))
         input.setBackgroundDrawable(Theme.createEditTextDrawable(parentActivity, true))
         input.setImeOptions(android.view.inputmethod.EditorInfo.IME_ACTION_DONE)
@@ -464,7 +468,7 @@ class TeleMenuActivity(private val kind: TeleMenuKind = TeleMenuKind.MESSAGE) :
                     handle.setFocusable(false)
                     handle.setScaleType(ImageView.ScaleType.CENTER)
                     handle.setImageResource(R.drawable.list_reorder)
-                    handle.setColorFilter(PorterDuffColorFilter(Theme.getColor(Theme.key_stickers_menu), PorterDuff.Mode.MULTIPLY))
+                    handle.setColorFilter(PorterDuffColorFilter(Theme.getColor(Theme.key_stickers_menu, resourceProvider), PorterDuff.Mode.MULTIPLY))
                     var dragging = false
                     handle.setOnTouchListener { _, event ->
                         when (event.actionMasked) {
