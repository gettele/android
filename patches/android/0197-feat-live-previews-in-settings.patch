+package tele.ui.settings
+
+import android.content.Context
+import android.graphics.Canvas
+import android.text.SpannableStringBuilder
+import android.text.TextUtils
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.View
+import android.widget.LinearLayout
+import android.widget.TextView
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.R
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Cells.TextDetailCell
+import org.telegram.ui.Components.AvatarDrawable
+import tele.TeleConfig
+import tele.helpers.InvisibleNames
+import tele.helpers.PeerId
+import tele.helpers.TeleLowercase
+
+/**
+ * Desktop 0244: live previews inside the settings pages for the peer ids, the invisible names and the
+ * hidden characters. They show made-up examples built from the current config each time the page
+ * rebinds: no account, no network and no real data. The ghost mode has its own [TeleGhostPreview].
+ */
+object TelePreviews {
+
+    // the text inset of the list cells
+    private const val CELL_PAD = 21
+
+    private const val BLANK = "\u3164"
+
+    // the desktop sample: hangul filler, variation selector, zero width space, variation selector
+    private const val SAMPLE_BIO = "\u3164\uFE0E\u200B\uFE0E"
+    private const val SAMPLE_USERNAME = "username"
+
+    /** The invisible names of the "Phrase" dialog and of the page: two blank-named examples. */
+    class NamesPreview(context: Context, private val provider: Theme.ResourcesProvider?, private val dialog: Boolean) : LinearLayout(context) {
+
+        private class Entry(val username: String?, val name: TextView)
+
+        private val entries = ArrayList<Entry>()
+        private val note: TextView
+
+        init {
+            orientation = LinearLayout.VERTICAL
+            layoutDirection = direction()
+            if (dialog) {
+                setPadding(0, dp(12f), 0, 0)
+            } else {
+                setPadding(dp(CELL_PAD), dp(4f), dp(CELL_PAD), 0)
+            }
+            addEntry(1L, SAMPLE_USERNAME, "Blank name, has a username")
+            addEntry(4L, null, "Blank name, no username")
+            note = noteView(context, provider, dialog, 0)
+            addView(note, LinearLayout.LayoutParams(-1, -2))
+            update(null)
+        }
+
+        /** [typedPhrase] is the phrase being edited in the dialog, null shows the saved one. */
+        fun update(typedPhrase: String?) {
+            for (entry in entries) {
+                // the stock name stays blank while the option is off
+                entry.name.text = InvisibleNames.sampleName(entry.username, typedPhrase) ?: BLANK
+            }
+            note.text = lc(if (TeleConfig.INVISIBLE_NAMES.value) NOTE_NAMES else NOTE_NAMES_OFF)
+        }
+
+        private fun addEntry(id: Long, username: String?, status: String) {
+            val row = LinearLayout(context)
+            row.orientation = LinearLayout.HORIZONTAL
+            row.gravity = Gravity.CENTER_VERTICAL
+            row.setPadding(0, dp(6f), 0, dp(6f))
+
+            val avatar = AvatarDrawable()
+            avatar.setTextSize(dp(16f))
+            avatar.setInfo(id, BLANK, null)
+            row.addView(AvatarView(context, avatar), LinearLayout.LayoutParams(dp(40f), dp(40f)))
+
+            val texts = LinearLayout(context)
+            texts.orientation = LinearLayout.VERTICAL
+            val name = TextView(context)
+            name.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16f)
+            name.typeface = AndroidUtilities.bold()
+            name.setTextColor(Theme.getColor(if (dialog) Theme.key_dialogTextBlack else Theme.key_windowBackgroundWhiteBlackText, provider))
+            name.maxLines = 1
+            name.ellipsize = TextUtils.TruncateAt.END
+            texts.addView(name, LinearLayout.LayoutParams(-1, -2))
+            val state = TextView(context)
+            state.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13f)
+            state.setTextColor(Theme.getColor(if (dialog) Theme.key_dialogTextGray2 else Theme.key_windowBackgroundWhiteGrayText2, provider))
+            state.maxLines = 1
+            state.ellipsize = TextUtils.TruncateAt.END
+            state.text = lc(status)
+            texts.addView(state, LinearLayout.LayoutParams(-1, -2))
+            val textParams = LinearLayout.LayoutParams(0, -2, 1f)
+            textParams.marginStart = dp(12f)
+            row.addView(texts, textParams)
+
+            addView(row, LinearLayout.LayoutParams(-1, -2))
+            entries.add(Entry(username, name))
+        }
+    }
+
+    /** The avatar drawable has no view of its own: a plain circle on the card. */
+    private class AvatarView(context: Context, private val avatar: AvatarDrawable) : View(context) {
+        override fun onDraw(canvas: Canvas) {
+            avatar.setBounds(0, 0, width, height)
+            avatar.draw(canvas)
+        }
+    }
+
+    /** The names preview of the page: under the phrase row, inside its group. */
+    @JvmStatic
+    fun namesView(context: Context, provider: Theme.ResourcesProvider?): View =
+        NamesPreview(context, provider, false)
+
+    /** The peer id rows of a made-up user and a made-up channel, formatted by the current settings. */
+    @JvmStatic
+    fun idsView(context: Context, provider: Theme.ResourcesProvider?): View {
+        val card = card(context, provider)
+        if (TeleConfig.SHOW_PEER_ID.value) {
+            addPeer(card, provider, "Example user", PeerId.sample(false, 2, false))
+            addPeer(card, provider, "Example channel", PeerId.sample(true, 5, true))
+        }
+        card.addView(noteView(context, provider, false, dp(CELL_PAD)).apply {
+            text = lc(if (TeleConfig.SHOW_PEER_ID.value) NOTE_IDS else NOTE_IDS_OFF)
+        }, LinearLayout.LayoutParams(-1, -2))
+        return card
+    }
+
+    /** A bio made only of hidden characters: chips with the code points while the option is on. */
+    @JvmStatic
+    fun hiddenCharsView(context: Context, provider: Theme.ResourcesProvider?): View {
+        val card = card(context, provider)
+        // a plain wrapping text: a single-line ellipsizing TextView measures the chips as zero width and drops them
+        val bio = TextView(context)
+        bio.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16f)
+        bio.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText, provider))
+        bio.setPadding(dp(CELL_PAD), dp(4f), dp(CELL_PAD), 0)
+        bio.text = InvisibleNames.withHiddenChars(SpannableStringBuilder(SAMPLE_BIO))
+        card.addView(bio, LinearLayout.LayoutParams(-1, -2))
+        val label = TextView(context)
+        label.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13f)
+        label.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2, provider))
+        label.setPadding(dp(CELL_PAD), dp(1f), dp(CELL_PAD), 0)
+        label.text = LocaleController.getString(R.string.UserBio)
+        card.addView(label, LinearLayout.LayoutParams(-1, -2))
+        card.addView(noteView(context, provider, false, dp(CELL_PAD)).apply {
+            text = lc(if (TeleConfig.SHOW_HIDDEN_CHARS.value) NOTE_CHARS else NOTE_CHARS_OFF)
+        }, LinearLayout.LayoutParams(-1, -2))
+        return card
+    }
+
+    private fun addPeer(card: LinearLayout, provider: Theme.ResourcesProvider?, title: String, sample: PeerId.Sample) {
+        val context = card.context
+        val header = TextView(context)
+        header.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14f)
+        header.typeface = AndroidUtilities.bold()
+        header.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlueHeader, provider))
+        header.setPadding(dp(CELL_PAD), dp(10f), dp(CELL_PAD), dp(0f))
+        header.text = lc(title)
+        card.addView(header, LinearLayout.LayoutParams(-1, -2))
+
+        val id = TextDetailCell(context, CELL_PAD, provider, false, false)
+        id.setTextAndValue(sample.id, LocaleController.getString(R.string.TeleProfileId), sample.dc != null)
+        card.addView(id, LinearLayout.LayoutParams(-1, -2))
+        val dc = sample.dc ?: return
+        val row = TextDetailCell(context, CELL_PAD, provider, false, false)
+        row.setTextAndValue(dc, LocaleController.getString(R.string.TeleProfileDc), false)
+        card.addView(row, LinearLayout.LayoutParams(-1, -2))
+    }
+
+    private const val NOTE_NAMES = "Examples with made-up names. Nothing is loaded or sent."
+    private const val NOTE_NAMES_OFF = "The option is off: blank names stay blank."
+    private const val NOTE_IDS = "Examples with made-up ids and data centers. Nothing is loaded or sent."
+    private const val NOTE_IDS_OFF = "The ID row is off: profiles show no ID."
+    private const val NOTE_CHARS = "An example bio made only of hidden characters. Nothing is loaded or sent."
+    private const val NOTE_CHARS_OFF = "The option is off: such a bio looks empty."
+
+    private fun noteView(context: Context, provider: Theme.ResourcesProvider?, dialog: Boolean, left: Int): TextView {
+        val view = TextView(context)
+        view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12f)
+        view.setTextColor(Theme.getColor(if (dialog) Theme.key_dialogTextGray2 else Theme.key_windowBackgroundWhiteGrayText2, provider))
+        view.setPadding(left, dp(6f), left, dp(10f))
+        return view
+    }
+
+    private fun card(context: Context, provider: Theme.ResourcesProvider?): LinearLayout {
+        val card = LinearLayout(context)
+        card.orientation = LinearLayout.VERTICAL
+        card.layoutDirection = direction()
+        return card
+    }
+
+    private fun direction(): Int = if (LocaleController.isRTL) View.LAYOUT_DIRECTION_RTL else View.LAYOUT_DIRECTION_LTR
+
+    private fun lc(text: String): String = TeleLowercase.lc(text)
+
+    private fun dp(value: Float): Int = AndroidUtilities.dp(value)
+
+    private fun dp(value: Int): Int = AndroidUtilities.dp(value.toFloat())
+}
