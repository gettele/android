Subject: [PATCH] fix: update the link rewrite presets

---
 .../main/java/tele/helpers/LinkRewrites.kt    | 35 ++++++++++++++++---
 .../src/main/java/tele/helpers/Tracking.kt    |  2 +-
 2 files changed, 31 insertions(+), 6 deletions(-)

diff --git a/TMessagesProj/src/main/java/tele/helpers/LinkRewrites.kt b/TMessagesProj/src/main/java/tele/helpers/LinkRewrites.kt
index e093b214f..0bcd9cf20 100644
--- a/TMessagesProj/src/main/java/tele/helpers/LinkRewrites.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/LinkRewrites.kt
@@ -43,6 +43,25 @@ object LinkRewrites {
 
     private const val KEY = "link_rewrite_rules"
 
+    // targets that shut down, with the service that replaced them
+    private val GONE_TARGETS = mapOf("vxtiktok.com" to "tnktok.com")
+
+    // the saved rules keep the old target until the user edits them
+    @JvmStatic
+    fun migrateTargets(targets: List<String>): List<String> {
+        val out = ArrayList<String>()
+        var migrated = 0
+        for (target in targets) {
+            val live = GONE_TARGETS[target] ?: target
+            if (live != target) migrated++
+            if (!out.contains(live)) out.add(live)
+        }
+        if (migrated > 0) {
+            android.util.Log.d("TeleLinkRewrite", "rule=$TYPE_DOMAIN migrated=$migrated")
+        }
+        return out
+    }
+
     private val URL_REGEX = Regex("https?://[^\\s<>\"']+")
 
     @JvmStatic
@@ -73,7 +92,7 @@ object LinkRewrites {
                     out.add(Rule(
                         TYPE_DOMAIN,
                         from = toStringList(obj.optJSONArray("from")).map(::normalizeDomain).filter(String::isNotEmpty),
-                        to = toStringList(obj.optJSONArray("to")).map(::normalizeDomain).filter(String::isNotEmpty),
+                        to = migrateTargets(toStringList(obj.optJSONArray("to")).map(::normalizeDomain).filter(String::isNotEmpty)),
                         random = random,
                         enabled = obj.optBoolean("enabled", obj.optBoolean("on", true))
                     ))
@@ -97,9 +116,9 @@ object LinkRewrites {
 
     @JvmStatic
     fun presets(): List<Rule> = listOf(
-        Rule(TYPE_DOMAIN, listOf("x.com", "twitter.com"), listOf("fixupx.com", "fxtwitter.com", "vxtwitter.com", "fixvx.com"), random = true),
+        Rule(TYPE_DOMAIN, listOf("x.com", "twitter.com"), listOf("fixupx.com", "fxtwitter.com", "vxtwitter.com", "fixvx.com", "samekosabax.com"), random = true),
         Rule(TYPE_DOMAIN, listOf("instagram.com"), listOf("ddinstagram.com", "kkinstagram.com")),
-        Rule(TYPE_DOMAIN, listOf("tiktok.com"), listOf("vxtiktok.com", "tnktok.com")),
+        Rule(TYPE_DOMAIN, listOf("tiktok.com"), listOf("tnktok.com")),
         Rule(TYPE_DOMAIN, listOf("reddit.com"), listOf("rxddit.com", "vxreddit.com")),
         Rule(TYPE_DOMAIN, listOf("bsky.app"), listOf("fxbsky.app", "bskx.app")),
         Rule(TYPE_DOMAIN, listOf("pixiv.net"), listOf("phixiv.net"))
@@ -157,7 +176,10 @@ object LinkRewrites {
         for (rule in rules) {
             if (!rule.enabled) continue
             if (rule.type == TYPE_DOMAIN) {
-                applyDomains(url, rule)?.let { return it }
+                applyDomains(url, rule)?.let {
+                    android.util.Log.d("TeleLinkRewrite", "rule=${rule.type}")
+                    return it
+                }
             } else if (rule.find.isNotEmpty()) {
                 val rewritten = runCatching {
                     val regex = Regex(rule.find, RegexOption.IGNORE_CASE)
@@ -165,7 +187,10 @@ object LinkRewrites {
                     val replacement = expand(rule.replace, match)
                     url.replaceRange(match.range, replacement) to (match.value + " -> " + replacement)
                 }.getOrNull()
-                if (rewritten != null) return rewritten
+                if (rewritten != null) {
+                    android.util.Log.d("TeleLinkRewrite", "rule=${rule.type}")
+                    return rewritten
+                }
             }
         }
         return null
