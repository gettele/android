+++ b/TMessagesProj/src/main/java/tele/helpers/CopyLinks.kt
@@ -0,0 +1,54 @@
+package tele.helpers
+
+import android.text.SpannableStringBuilder
+import android.text.Spanned
+import android.text.style.URLSpan
+import org.telegram.tgnet.TLRPC
+import tele.TeleConfig
+
+/**
+ * Strips links hidden in invisible text when copying (desktop 0343). A custom-url entity whose
+ * whole range is invisible code points carries no visible text, so the link goes and the invisible
+ * characters with it; a link over visible text stays.
+ */
+object CopyLinks {
+
+    @JvmStatic
+    fun enabled(): Boolean = TeleConfig.REMOVE_INVISIBLE_COPY_LINKS.value
+
+    /** The plain copy of a message: invisible custom links are dropped from the spanned text. */
+    @JvmStatic
+    fun clean(text: CharSequence?): CharSequence? {
+        if (!enabled() || text !is Spanned) return text
+        val spans = text.getSpans(0, text.length, URLSpan::class.java)
+        var result: SpannableStringBuilder? = null
+        // right to left, so earlier offsets stay valid while ranges are removed
+        for (span in spans.sortedByDescending { text.getSpanStart(it) }) {
+            val start = text.getSpanStart(span)
+            val end = text.getSpanEnd(span)
+            if (start < 0 || end <= start) continue
+            if (!InvisibleNames.isInvisibleText(text.subSequence(start, end))) continue
+            val builder = result ?: SpannableStringBuilder(text).also { result = it }
+            builder.removeSpan(span)
+            builder.delete(start, end)
+        }
+        return result ?: text
+    }
+
+    /** The Markdown/HTML copy: invisible text-url entities are dropped before conversion. */
+    @JvmStatic
+    fun cleanEntities(text: String, entities: List<TLRPC.MessageEntity>?): List<TLRPC.MessageEntity>? {
+        if (!enabled() || entities.isNullOrEmpty()) return entities
+        val result = ArrayList<TLRPC.MessageEntity>(entities.size)
+        for (entity in entities) {
+            if (entity is TLRPC.TL_messageEntityTextUrl && hidden(text, entity.offset, entity.length)) continue
+            result.add(entity)
+        }
+        return result
+    }
+
+    private fun hidden(text: String, offset: Int, length: Int): Boolean {
+        if (offset < 0 || length <= 0 || offset > text.length || length > text.length - offset) return false
+        return InvisibleNames.isInvisibleText(text.substring(offset, offset + length))
+    }
+}
\ No newline at end of file
