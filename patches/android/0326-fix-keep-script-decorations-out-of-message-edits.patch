From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: test <test@example.com>
Date: Tue, 10 Nov 2026 01:58:42 +0300
Subject: [PATCH] fix: keep script decorations out of message edits

---
 .../org/telegram/ui/Components/ChatActivityEnterView.java     | 4 ++--
 TMessagesProj/src/main/java/tele/scripting/ScriptDisplay.kt   | 4 ++++
 .../src/main/java/tele/scripting/ScriptMessageActions.kt      | 2 ++
 3 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Components/ChatActivityEnterView.java b/TMessagesProj/src/main/java/org/telegram/ui/Components/ChatActivityEnterView.java
index 5b65e83ab..c194817c9 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Components/ChatActivityEnterView.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Components/ChatActivityEnterView.java
@@ -8238,7 +8238,7 @@ public class ChatActivityEnterView extends FrameLayout implements
             return;
         }
         ArrayList<TLRPC.MessageEntity> entities = MediaDataController.getInstance(currentAccount).getEntities(message, supportsSendingNewEntities());
-        if (!TextUtils.equals(message[0], editingMessageObject.messageText) || entities != null && !entities.isEmpty() || !editingMessageObject.messageOwner.entities.isEmpty() || editingMessageObject.messageOwner.media instanceof TLRPC.TL_messageMediaWebPage) {
+        if (!TextUtils.equals(message[0], tele.TeleConfig.SCRIPTING.getValue() ? tele.scripting.ScriptDisplay.editingText(editingMessageObject) : editingMessageObject.messageText) || entities != null && !entities.isEmpty() || !editingMessageObject.messageOwner.entities.isEmpty() || editingMessageObject.messageOwner.media instanceof TLRPC.TL_messageMediaWebPage) {
             editingMessageObject.editingMessage = message[0];
             editingMessageObject.editingMessageEntities = entities;
             editingMessageObject.editingMessageSearchWebPage = messageWebPageSearch;
@@ -10580,7 +10580,7 @@ public class ChatActivityEnterView extends FrameLayout implements
                 editingText = editingMessageObject.caption;
             } else {
                 currentLimit = accountInstance.getMessagesController().getMaxMessageLength();
-                editingText = editingMessageObject.messageText;
+                editingText = tele.TeleConfig.SCRIPTING.getValue() ? tele.scripting.ScriptDisplay.editingText(editingMessageObject) : editingMessageObject.messageText;
             }
             if (editingText != null) {
                 final Paint.FontMetricsInt fontMetricsInt;
diff --git a/TMessagesProj/src/main/java/tele/scripting/ScriptDisplay.kt b/TMessagesProj/src/main/java/tele/scripting/ScriptDisplay.kt
index e0831b987..34b876fa1 100644
--- a/TMessagesProj/src/main/java/tele/scripting/ScriptDisplay.kt
+++ b/TMessagesProj/src/main/java/tele/scripting/ScriptDisplay.kt
@@ -107,6 +107,10 @@ object ScriptDisplay {
         message.messageText = SpannableStringBuilder(text)
     }
 
+    @JvmStatic
+    fun editingText(message: MessageObject): CharSequence =
+        if (hasReplacement(message)) message.messageOwner.message.orEmpty() else message.messageText
+
     @JvmStatic
     fun onTextChanged(message: MessageObject) {
         synchronized(originals) { originals.remove(message) }
diff --git a/TMessagesProj/src/main/java/tele/scripting/ScriptMessageActions.kt b/TMessagesProj/src/main/java/tele/scripting/ScriptMessageActions.kt
index 4e88d0e1f..139a06c4c 100644
--- a/TMessagesProj/src/main/java/tele/scripting/ScriptMessageActions.kt
+++ b/TMessagesProj/src/main/java/tele/scripting/ScriptMessageActions.kt
@@ -64,6 +64,8 @@ object ScriptMessageActions {
             .put("chatId", JSONObject().put("\$b", message.getDialogId().toString()))
             .put("messageId", message.getId())
             .put("text", message.caption?.toString() ?: message.messageText?.toString() ?: "")
+            .put("sourceText", message.messageOwner?.message ?: "")
+            .put("editDate", message.messageOwner?.edit_date ?: 0)
             .put("canReplaceText", message.type == MessageObject.TYPE_TEXT || message.type == MessageObject.TYPE_EMOJIS)
             .put("date", message.messageOwner?.date ?: 0)
             .put("out", message.isOut())
