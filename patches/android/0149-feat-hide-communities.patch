new file mode 100644
index 000000000..d20d65880
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/TeleCommunities.kt
@@ -0,0 +1,43 @@
+package tele.helpers
+
+import org.telegram.messenger.AccountInstance
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.ChatObject
+import org.telegram.messenger.MessageObject
+import org.telegram.messenger.NotificationCenter
+import org.telegram.messenger.UserConfig
+import org.telegram.tgnet.TLRPC
+import tele.TeleConfig
+
+// Hides communities: their members stay in the list as regular chats.
+object TeleCommunities {
+    @JvmStatic
+    fun hidden(): Boolean = TeleConfig.HIDE_COMMUNITIES.value
+
+    // stock "collapsed into one row" reads go through here
+    @JvmStatic
+    fun collapsed(stock: Boolean): Boolean = stock && !hidden()
+
+    // the community a chat belongs to, 0 means none for the UI
+    @JvmStatic
+    fun linked(stock: Long): Long = if (hidden()) 0L else stock
+
+    @JvmStatic
+    fun excludes(obj: Any?): Boolean = hidden() && obj is TLRPC.Chat && ChatObject.isCommunity(obj)
+
+    @JvmStatic
+    fun hiddenService(message: MessageObject?): Boolean =
+        hidden() && message != null && message.type == MessageObject.TYPE_COMMUNITY_CHANGED
+
+    @JvmStatic
+    fun onToggled() {
+        AndroidUtilities.runOnUIThread {
+            for (account in 0 until UserConfig.MAX_ACCOUNT_COUNT) {
+                if (!UserConfig.getInstance(account).isClientActivated) continue
+                val instance = AccountInstance.getInstance(account)
+                instance.messagesController.sortDialogs(null)
+                instance.notificationCenter.postNotificationName(NotificationCenter.dialogsNeedReload)
+            }
+        }
+    }
+}
