From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Thu, 5 Nov 2026 02:53:52 +0300
Subject: [PATCH] fix: keep silent video audio detection safe

---
 TMessagesProj/src/main/java/tele/helpers/SilentVideo.kt | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/TMessagesProj/src/main/java/tele/helpers/SilentVideo.kt b/TMessagesProj/src/main/java/tele/helpers/SilentVideo.kt
index 6fbe43b1e..2490b431d 100644
--- a/TMessagesProj/src/main/java/tele/helpers/SilentVideo.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/SilentVideo.kt
@@ -23,6 +23,9 @@ object SilentVideo {
         if (info.muted) return
         val params = IntArray(AnimatedFileInfo.PARAM_NUM_COUNT)
         AnimatedFileNative.getVideoInfo(path, params, info.videoOffset)
+        if (params[AnimatedFileInfo.PARAM_NUM_SUPPORTED_VIDEO_CODEC] == 0) return
+        if (params[AnimatedFileInfo.PARAM_NUM_WIDTH] <= 0 || params[AnimatedFileInfo.PARAM_NUM_HEIGHT] <= 0) return
+        if (params[AnimatedFileInfo.PARAM_NUM_DURATION] <= 0) return
         if (params[AnimatedFileInfo.PARAM_NUM_HAS_AUDIO] != 0) return
         info.muted = !asVideo()
     }
