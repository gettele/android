+    @JvmStatic
+    fun addToLocalSearch(account: Int, query: String, result: ArrayList<Any>, names: ArrayList<CharSequence>) {
+        if (!TeleConfig.USERNAME_ALIASES.value || query.isEmpty()) return
+        val matches = matchingPeers(account, query, true)
+        if (matches.isEmpty()) return
+        val present = HashSet<Long>()
+        for (obj in result) {
+            if (obj is TLRPC.User) present.add(obj.id)
+            if (obj is TLRPC.Chat) present.add(-obj.id)
+        }
+        val controller = org.telegram.messenger.MessagesController.getInstance(account)
+        for (match in matches) {
+            val alias = match.first
+            val did = match.second
+            if (present.contains(did)) continue
+            if (did > 0) {
+                val user = controller.getUser(did) ?: continue
+                result.add(user)
+                names.add(org.telegram.messenger.AndroidUtilities.generateSearchName(
+                    org.telegram.messenger.ContactsController.formatName(user.first_name, user.last_name),
+                    "@$alias",
+                    "@$query"
+                ))
+            } else {
+                val chat = controller.getChat(-did) ?: continue
+                result.add(chat)
+                names.add(org.telegram.messenger.AndroidUtilities.generateSearchName(chat.title, "@$alias", "@$query"))
+            }
+        }
+    }
