@@ -232,6 +232,7 @@ public class PopupSwipeBackLayout extends FrameLayout {
             p.setBackScaleY(Math.min(1, h / p.getMeasuredHeight()));
         }
         p.updateAnimation = true;
+        p.applySwipeBackAnchor();
 
         for (int i = 0; i < getChildCount(); i++) {
             View ch = getChildAt(i);
@@ -246,6 +247,10 @@ public class PopupSwipeBackLayout extends FrameLayout {
         return transitionProgress > 0;
     }
 
+    public boolean hasForeground() {
+        return currentForegroundIndex >= 0 && currentForegroundIndex < getChildCount();
+    }
+
     @Override
     public boolean dispatchTouchEvent(MotionEvent ev) {
         if (processTouchEvent(ev)) {
