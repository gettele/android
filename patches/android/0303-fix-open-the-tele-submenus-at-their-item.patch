From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: test <test@example.com>
Date: Sat, 7 Nov 2026 18:28:54 +0300
Subject: [PATCH] fix: open the tele submenus at their item

---
 .../ui/ActionBar/ActionBarPopupWindow.java    | 27 +++++++++++++++++++
 .../java/org/telegram/ui/ChatActivity.java    | 24 ++++++++++++++++-
 .../ChatScrimPopupContainerLayout.java        |  2 +-
 .../ui/Components/PopupSwipeBackLayout.java   |  5 ++++
 4 files changed, 56 insertions(+), 2 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/ActionBar/ActionBarPopupWindow.java b/TMessagesProj/src/main/java/org/telegram/ui/ActionBar/ActionBarPopupWindow.java
index ba89cf52f..32b0c27a5 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/ActionBar/ActionBarPopupWindow.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/ActionBar/ActionBarPopupWindow.java
@@ -108,6 +108,8 @@ public class ActionBarPopupWindow extends PopupWindow {
         public boolean clipChildren;
         public boolean swipeBackGravityRight;
         public boolean swipeBackGravityBottom;
+        private float swipeBackAnchorY;
+        private float baseTranslationY;
 
         private OnDispatchKeyEventListener mOnDispatchKeyEventListener;
         private float backScaleX = 1;
@@ -270,6 +272,31 @@ public class ActionBarPopupWindow extends PopupWindow {
             return swipeBackLayout;
         }
 
+        /** Opens the swipe-back page at the y of the item that was pressed, not at the top. */
+        public void setSwipeBackAnchorY(float y) {
+            swipeBackAnchorY = y;
+            applySwipeBackAnchor();
+        }
+
+        /** The translation the popup's container asks for, like the reactions strip expanding. */
+        public void setBaseTranslationY(float y) {
+            baseTranslationY = y;
+            applySwipeBackAnchor();
+        }
+
+        public void applySwipeBackAnchor() {
+            if (swipeBackAnchorY == 0 && baseTranslationY == 0) {
+                return;
+            }
+            float anchor = 0;
+            if (swipeBackAnchorY != 0 && swipeBackLayout != null && swipeBackLayout.hasForeground()) {
+                anchor = swipeBackAnchorY * swipeBackLayout.transitionProgress;
+            } else if (swipeBackLayout != null && !swipeBackLayout.hasForeground() && swipeBackLayout.transitionProgress == 0) {
+                swipeBackAnchorY = 0;
+            }
+            setTranslationY(baseTranslationY + anchor);
+        }
+
         public int addViewToSwipeBack(View v) {
             swipeBackLayout.addView(v, LayoutHelper.createFrame(LayoutHelper.WRAP_CONTENT, LayoutHelper.WRAP_CONTENT, shownFromBottom ? Gravity.BOTTOM : Gravity.TOP));
             return swipeBackLayout.getChildCount() - 1;
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
index 4679ac1c0..f9a0b7712 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
@@ -33794,7 +33794,29 @@ public class ChatActivity extends BaseFragment implements
                         submenuCell.setMinimumWidth(AndroidUtilities.dp(200));
                         submenuCell.setTextAndIcon(items.get(a), icons.get(a));
                         submenuCell.setRightIcon(R.drawable.msg_arrowright);
-                        submenuCell.openSwipeBackLayout = () -> popupLayout.getSwipeBack().openForeground(teleForeground);
+                        submenuCell.openSwipeBackLayout = () -> {
+                            final PopupSwipeBackLayout swipeBack = popupLayout.getSwipeBack();
+                            if (swipeBack == null) {
+                                return;
+                            }
+                            int submenuHeight = teleSubmenuLayout.getMeasuredHeight();
+                            if (submenuHeight <= 0) {
+                                final int width = Math.max(swipeBack.getMeasuredWidth(), popupLayout.getMeasuredWidth());
+                                teleSubmenuLayout.measure(
+                                        View.MeasureSpec.makeMeasureSpec(width, View.MeasureSpec.AT_MOST),
+                                        View.MeasureSpec.makeMeasureSpec(0, View.MeasureSpec.UNSPECIFIED));
+                                submenuHeight = teleSubmenuLayout.getMeasuredHeight();
+                            }
+                            final int[] cellLocation = new int[2];
+                            final int[] popupLocation = new int[2];
+                            submenuCell.getLocationInWindow(cellLocation);
+                            popupLayout.getLocationInWindow(popupLocation);
+                            int anchor = cellLocation[1] - popupLocation[1] - backgroundPaddings.top;
+                            final int maxAnchor = popupLayout.getMeasuredHeight() - backgroundPaddings.top - backgroundPaddings.bottom - submenuHeight;
+                            anchor = Utilities.clamp(anchor, maxAnchor, 0);
+                            swipeBack.openForeground(teleForeground);
+                            popupLayout.setSwipeBackAnchorY(anchor);
+                        };
                         submenuCell.setOnClickListener(v1 -> submenuCell.openSwipeBack());
                         popupLayout.addView(submenuCell);
                         scrimPopupWindowItems[a] = submenuCell;
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Components/ChatScrimPopupContainerLayout.java b/TMessagesProj/src/main/java/org/telegram/ui/Components/ChatScrimPopupContainerLayout.java
index cee8fe972..51c216c00 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Components/ChatScrimPopupContainerLayout.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Components/ChatScrimPopupContainerLayout.java
@@ -174,7 +174,7 @@ public class ChatScrimPopupContainerLayout extends LinearLayout {
     }
 
     public void setExpandSize(float expandSize) {
-        popupWindowLayout.setTranslationY(expandSize);
+        popupWindowLayout.setBaseTranslationY(expandSize);
         this.expandSize = expandSize;
         updateBottomViewPosition();
     }
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Components/PopupSwipeBackLayout.java b/TMessagesProj/src/main/java/org/telegram/ui/Components/PopupSwipeBackLayout.java
index abf70dbbd..3a7bdc5ad 100644
