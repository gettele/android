From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Mon, 5 Oct 2026 23:45:57 +0300
Subject: [PATCH] feat: drag handles in the menu editor

Each row gets the stock list_reorder grip on the left (text is padded
past it), touching it starts the drag the same way the folders edit
screen does, so the rows read as draggable.

Confidence: medium
Scope-risk: narrow
---
 .../java/tele/ui/settings/TeleMenuActivity.kt | 35 +++++++++++++++++--
 1 file changed, 32 insertions(+), 3 deletions(-)

diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleMenuActivity.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleMenuActivity.kt
index f7563fecc..9f37b4cb1 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TeleMenuActivity.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleMenuActivity.kt
@@ -1,12 +1,18 @@
 package tele.ui.settings
 
 import android.content.Context
+import android.graphics.PorterDuff
+import android.graphics.PorterDuffColorFilter
+import android.view.Gravity
+import android.view.MotionEvent
 import android.view.View
+import android.widget.ImageView
 import android.view.ViewGroup
 import android.widget.FrameLayout
 import androidx.recyclerview.widget.ItemTouchHelper
 import androidx.recyclerview.widget.LinearLayoutManager
 import androidx.recyclerview.widget.RecyclerView
+import org.telegram.messenger.AndroidUtilities
 import org.telegram.messenger.R
 import org.telegram.ui.ActionBar.ActionBar
 import org.telegram.ui.ActionBar.BaseFragment
@@ -23,6 +29,7 @@ class TeleMenuActivity : BaseFragment() {
     private var adapter: Adapter? = null
     private var touchHelper: ItemTouchHelper? = null
     private var rows: MutableList<MessageMenu.Item> = mutableListOf()
+    private var listView: RecyclerListView? = null
 
     override fun createView(context: Context): View {
         actionBar.setBackButtonImage(R.drawable.ic_ab_back)
@@ -45,6 +52,7 @@ class TeleMenuActivity : BaseFragment() {
         val listView = RecyclerListView(context)
         listView.setLayoutManager(LinearLayoutManager(context))
         listView.setVerticalScrollBarEnabled(false)
+        this.listView = listView
         adapter = Adapter(context)
         listView.setAdapter(adapter)
 
@@ -75,7 +83,7 @@ class TeleMenuActivity : BaseFragment() {
 
         listView.setOnItemClickListener { view, position ->
             val item = rows.getOrNull(position - 1) ?: return@setOnItemClickListener
-            val cell = view as TextCheckCell
+            val cell = (if (view is FrameLayout) view.getChildAt(0) else view) as TextCheckCell
             val newValue = !cell.isChecked
             cell.setChecked(newValue)
             MessageMenu.setHidden(item.code, !newValue)
@@ -104,14 +112,35 @@ class TeleMenuActivity : BaseFragment() {
             val view: View = when (viewType) {
                 TYPE_HEADER -> HeaderCell(context)
                 TYPE_SHADOW -> TextInfoPrivacyCell(context)
-                else -> TextCheckCell(context)
+                else -> {
+                    val cell = TextCheckCell(context)
+                    cell.setPadding(AndroidUtilities.dp(38f), 0, 0, 0)
+                    val handle = ImageView(context)
+                    handle.setFocusable(false)
+                    handle.setScaleType(ImageView.ScaleType.CENTER)
+                    handle.setImageResource(R.drawable.list_reorder)
+                    handle.setColorFilter(PorterDuffColorFilter(Theme.getColor(Theme.key_stickers_menu), PorterDuff.Mode.MULTIPLY))
+                    handle.setOnTouchListener { _, event ->
+                        if (event.actionMasked == MotionEvent.ACTION_DOWN) {
+                            listView?.findContainingViewHolder(cell)?.let { touchHelper?.startDrag(it) }
+                            true
+                        } else {
+                            false
+                        }
+                    }
+                    val wrap = FrameLayout(context)
+                    wrap.addView(cell, FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT))
+                    wrap.addView(handle, FrameLayout.LayoutParams(AndroidUtilities.dp(48f), AndroidUtilities.dp(48f), Gravity.LEFT or Gravity.CENTER_VERTICAL))
+                    wrap
+                }
             }
             view.layoutParams = RecyclerView.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT)
             return RecyclerListView.Holder(view)
         }
 
         override fun onBindViewHolder(holder: RecyclerView.ViewHolder, position: Int) {
-            when (val cell = holder.itemView) {
+            val unwrapped = if (holder.itemView is FrameLayout) holder.itemView.getChildAt(0) else holder.itemView
+            when (val cell = unwrapped) {
                 is HeaderCell -> cell.setText("items (long press to reorder)")
                 is TextInfoPrivacyCell -> cell.setText(
                     if (rows.none { MessageMenu.isHidden(it.code) }) "everything is shown"
