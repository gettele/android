@@ -0,0 +1,95 @@
+package tele.ui
+
+import android.app.Activity
+import android.graphics.Canvas
+import android.view.Gravity
+import android.view.View
+import android.view.ViewGroup
+import android.widget.FrameLayout
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.AndroidUtilities.dp
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Components.AnimatedTextView
+import org.telegram.ui.Components.CubicBezierInterpolator
+import org.telegram.ui.Components.LayoutHelper
+import org.telegram.ui.Components.MediaActionDrawable
+import org.telegram.ui.Components.RadialProgress2
+import org.telegram.ui.IUpdateLayout
+import tele.helpers.TeleUpdater
+
+// the bottom "update" bar of the main tabs, like the stock standalone one: shown once a tele update is downloaded
+class TeleUpdateLayout(private val activity: Activity, private val container: ViewGroup?) : IUpdateLayout(activity, container) {
+    private var layout: FrameLayout? = null
+    private var icon: RadialProgress2? = null
+
+    init {
+        TeleUpdater.addListener(Listener(this))
+    }
+
+    // the main tabs can be recreated; a collected layout unregisters itself
+    private class Listener(layout: TeleUpdateLayout) : Runnable {
+        private val ref = java.lang.ref.WeakReference(layout)
+        override fun run() {
+            val layout = ref.get()
+            if (layout == null) TeleUpdater.removeListener(this) else layout.updateAppUpdateViews(0, true)
+        }
+    }
+
+    override fun createUpdateUI(currentAccount: Int) {
+        if (container == null || layout != null) return
+        val bar = FrameLayout(activity)
+        bar.visibility = View.INVISIBLE
+        bar.translationY = dp(44f).toFloat()
+        bar.background = Theme.getSelectorDrawable(0x40ffffff, false)
+        container.addView(bar, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, 44, Gravity.LEFT or Gravity.BOTTOM))
+        bar.setOnClickListener { TeleUpdater.install(activity) }
+        val text = object : AnimatedTextView(activity, true, true, true) {
+            override fun onDraw(canvas: Canvas) {
+                canvas.save()
+                canvas.translate(dp(15f).toFloat(), 0f)
+                super.onDraw(canvas)
+                canvas.translate((measuredWidth - width()) / 2f - dp(30f), dp(11f).toFloat())
+                icon?.draw(canvas)
+                canvas.restore()
+            }
+        }
+        text.setTextSize(dp(15f).toFloat())
+        text.setTypeface(AndroidUtilities.bold())
+        text.setTextColor(0xffffffff.toInt())
+        text.setGravity(Gravity.CENTER)
+        text.setText("update tele", false)
+        bar.addView(text, LayoutHelper.createFrameMatchParent())
+        icon = RadialProgress2(text).apply {
+            setColors(0xffffffff.toInt(), 0xffffffff.toInt(), Theme.getColor(Theme.key_featuredStickers_addButton), Theme.getColor(Theme.key_featuredStickers_addButton))
+            setProgressRect(0, 0, dp(22f), dp(22f))
+            setCircleRadius(dp(11f))
+            setAsMini()
+            setIcon(MediaActionDrawable.ICON_UPDATE, true, false)
+        }
+        layout = bar
+    }
+
+    override fun updateAppUpdateViews(currentAccount: Int, animated: Boolean) {
+        if (container == null) return
+        if (TeleUpdater.isReady()) {
+            createUpdateUI(currentAccount)
+            val bar = layout ?: return
+            if (bar.tag != null) return
+            bar.visibility = View.VISIBLE
+            bar.tag = 1
+            if (animated) {
+                bar.animate().translationY(0f).setInterpolator(CubicBezierInterpolator.EASE_OUT).setListener(null).setDuration(180).start()
+            } else {
+                bar.translationY = 0f
+            }
+            container.requestLayout()
+        } else {
+            val bar = layout ?: return
+            if (bar.tag == null) return
+            bar.tag = null
+            bar.translationY = dp(44f).toFloat()
+            bar.visibility = View.INVISIBLE
+            container.requestLayout()
+        }
+    }
+}
