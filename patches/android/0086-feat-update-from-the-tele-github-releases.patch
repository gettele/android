diff --git a/TMessagesProj/src/main/java/tele/helpers/TeleUpdater.kt b/TMessagesProj/src/main/java/tele/helpers/TeleUpdater.kt
new file mode 100644
index 000000000..c5f415a91
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/TeleUpdater.kt
@@ -0,0 +1,265 @@
+package tele.helpers
+
+import android.app.Activity
+import android.os.Build
+import org.json.JSONObject
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.ApplicationLoader
+import org.telegram.messenger.BuildVars
+import org.telegram.messenger.DispatchQueue
+import org.telegram.messenger.FileLog
+import tele.TeleBuild
+import tele.TeleConfig
+import java.io.File
+import java.net.HttpURLConnection
+import java.net.URL
+import java.security.MessageDigest
+import java.util.concurrent.CopyOnWriteArraySet
+
+// self-updater over the github releases of this project (tele 0006): a json feed points at a signed apk and its sha256;
+// android itself refuses an apk signed with another key than the installed app
+object TeleUpdater {
+    enum class State { DISABLED, IDLE, CHECKING, LATEST, DOWNLOADING, READY, FAILED }
+
+    data class Status(val state: State, val tag: String = "", val ready: Long = 0, val total: Long = 0, val error: String = "")
+
+    private class Release(val tag: String, val url: String, val sha256: String, val newer: Boolean)
+
+    const val RELEASES = "https://github.com/gettele/android/releases"
+    private const val FEED_URL = "$RELEASES/latest/download/tele-update-android.json"
+    private const val DOWNLOAD_PREFIX = "$RELEASES/download/"
+    private const val FIRST_CHECK_DELAY = 15_000L
+    private const val CHECK_INTERVAL = 3 * 60 * 60_000L
+    private const val TIMEOUT = 60_000
+    private const val MAX_FEED_SIZE = 64 * 1024L
+    private const val MAX_APK_SIZE = 512 * 1024 * 1024L
+    private const val APK_MIME = "application/vnd.android.package-archive"
+
+    private val queue by lazy { DispatchQueue("teleUpdater") }
+    private val listeners = CopyOnWriteArraySet<Runnable>()
+    private val scheduledCheck = Runnable { check() }
+
+    @Volatile
+    var status = Status(State.DISABLED)
+        private set
+
+    // queue thread only
+    private var busy = false
+    private var readyFile: File? = null
+
+    private fun updatesDir(): File = File(ApplicationLoader.applicationContext.filesDir, "cache/tele_update")
+
+    @JvmStatic
+    fun tag(): String = "v${BuildVars.BUILD_VERSION_STRING}-tele.${TeleBuild.BUILD}"
+
+    // telegram's version code: the installed one carries the abi digit (×10 + flavor)
+    private fun runningBase(): Long = runCatching {
+        val context = ApplicationLoader.applicationContext
+        val info = context.packageManager.getPackageInfo(context.packageName, 0)
+        (if (Build.VERSION.SDK_INT >= 28) info.longVersionCode else info.versionCode.toLong()) / 10
+    }.getOrDefault(0L)
+
+    @JvmStatic
+    fun start() {
+        queue.postRunnable {
+            if (TeleBuild.BUILD <= 0) {
+                publish(Status(State.DISABLED, error = "local builds don't update themselves."))
+                return@postRunnable
+            }
+            publish(Status(State.IDLE))
+            schedule(FIRST_CHECK_DELAY)
+        }
+    }
+
+    @JvmStatic
+    fun onAutoUpdateChanged() {
+        queue.postRunnable { if (TeleConfig.AUTO_UPDATE.value) schedule(FIRST_CHECK_DELAY) else queue.cancelRunnable(scheduledCheck) }
+    }
+
+    @JvmStatic
+    fun checkNow() {
+        queue.postRunnable { check() }
+    }
+
+    @JvmStatic
+    fun isReady(): Boolean = status.state == State.READY
+
+    // hands the downloaded apk to the system installer, which asks for "install unknown apps" when needed
+    @JvmStatic
+    fun install(activity: Activity?): Boolean {
+        val file = readyFile ?: return false
+        if (activity == null || !isReady() || !file.exists()) return false
+        return AndroidUtilities.openForView(file, file.name, APK_MIME, activity, null, false)
+    }
+
+    @JvmStatic
+    fun addListener(listener: Runnable) {
+        listeners.add(listener)
+    }
+
+    @JvmStatic
+    fun removeListener(listener: Runnable) {
+        listeners.remove(listener)
+    }
+
+    private fun publish(value: Status) {
+        if (value == status) return
+        status = value
+        AndroidUtilities.runOnUIThread { listeners.forEach(Runnable::run) }
+    }
+
+    private fun schedule(delay: Long) {
+        queue.cancelRunnable(scheduledCheck)
+        if (TeleConfig.AUTO_UPDATE.value && status.state != State.READY && status.state != State.DISABLED) {
+            queue.postRunnable(scheduledCheck, delay)
+        }
+    }
+
+    private fun check() {
+        val state = status.state
+        if (state == State.DISABLED || state == State.READY || busy) return
+        busy = true
+        queue.cancelRunnable(scheduledCheck)
+        publish(Status(State.CHECKING))
+        try {
+            val feed = java.io.ByteArrayOutputStream()
+            get(FEED_URL, MAX_FEED_SIZE, feed, null)
+            val release = parse(feed.toString("UTF-8"))
+            if (release == null) {
+                fail("malformed feed")
+            } else if (!release.newer) {
+                updatesDir().listFiles()?.forEach(File::delete)
+                finish(Status(State.LATEST))
+            } else {
+                val target = File(updatesDir(), "tele-${release.tag}.apk")
+                updatesDir().listFiles()?.forEach { if (it != target) it.delete() }
+                if (target.exists() && sha256(target) == release.sha256) {
+                    readyFile = target
+                    finish(Status(State.READY, release.tag))
+                } else {
+                    download(release, target)
+                }
+            }
+        } catch (e: HttpStatusException) {
+            fail(if (e.code == 404) "no releases published yet" else "unexpected http status ${e.code}")
+        } catch (e: TooLargeException) {
+            fail("response is too large")
+        } catch (e: Exception) {
+            fail("network error: ${e.message ?: e.javaClass.simpleName}")
+        }
+    }
+
+    private fun parse(text: String): Release? {
+        val o = runCatching { JSONObject(text) }.getOrNull() ?: return null
+        val tag = o.optString("tag")
+        val base = (o.opt("base") as? Number)?.toLong() ?: return null
+        val counter = (o.opt("counter") as? Number)?.toLong() ?: return null
+        val url = o.optString("url")
+        val sha = o.optString("apk_sha256").lowercase()
+        if (tag.isEmpty() || base !in 1..0xFFFFFFFFL || counter !in 1..0xFFFFFFFFL
+            || !url.startsWith("$DOWNLOAD_PREFIX$tag/") || !url.endsWith(".apk")
+            || sha.length != 64 || sha.any { it !in '0'..'9' && it !in 'a'..'f' }) return null
+        val running = runningBase()
+        return Release(tag, url, sha, base > running || (base == running && counter > TeleBuild.BUILD))
+    }
+
+    private fun download(release: Release, target: File) {
+        publish(Status(State.DOWNLOADING, release.tag))
+        target.parentFile?.mkdirs()
+        val temp = File(target.parentFile, target.name + ".part")
+        try {
+            temp.outputStream().use { out ->
+                get(release.url, MAX_APK_SIZE, out) { ready, total -> publish(Status(State.DOWNLOADING, release.tag, ready, total)) }
+            }
+            if (sha256(temp) != release.sha256) {
+                fail("downloaded apk doesn't match the feed")
+                return
+            }
+            if (!temp.renameTo(target)) {
+                fail("can't write ${target.name}")
+                return
+            }
+        } finally {
+            temp.delete()
+        }
+        readyFile = target
+        finish(Status(State.READY, release.tag))
+    }
+
+    private class HttpStatusException(val code: Int) : Exception()
+    private class TooLargeException : Exception()
+
+    private fun get(url: String, limit: Long, out: java.io.OutputStream, progress: ((Long, Long) -> Unit)?) {
+        var connection: HttpURLConnection? = null
+        try {
+            connection = URL(url).openConnection() as HttpURLConnection
+            connection.connectTimeout = TIMEOUT
+            connection.readTimeout = TIMEOUT
+            connection.instanceFollowRedirects = true
+            connection.setRequestProperty("User-Agent", "tele/${BuildVars.BUILD_VERSION_STRING}-tele.${TeleBuild.BUILD}")
+            val code = connection.responseCode
+            if (code != HttpURLConnection.HTTP_OK) throw HttpStatusException(code)
+            val total = connection.contentLength.toLong()
+            if (total > limit) throw TooLargeException()
+            var size = 0L
+            var lastPercent = -1L
+            connection.inputStream.use { input ->
+                val buffer = ByteArray(64 * 1024)
+                while (true) {
+                    val read = input.read(buffer)
+                    if (read < 0) break
+                    size += read
+                    if (size > limit) throw TooLargeException()
+                    out.write(buffer, 0, read)
+                    if (progress != null && total > 0) {
+                        val percent = size * 100 / total
+                        if (percent != lastPercent) {
+                            lastPercent = percent
+                            progress(size, total)
+                        }
+                    }
+                }
+            }
+        } finally {
+            connection?.disconnect()
+        }
+    }
+
+    private fun sha256(file: File): String = runCatching {
+        val digest = MessageDigest.getInstance("SHA-256")
+        file.inputStream().use { input ->
+            val buffer = ByteArray(64 * 1024)
+            while (true) {
+                val read = input.read(buffer)
+                if (read < 0) break
+                digest.update(buffer, 0, read)
+            }
+        }
+        digest.digest().joinToString("") { "%02x".format(it) }
+    }.getOrDefault("")
+
+    private fun fail(error: String) {
+        FileLog.e("TeleUpdater: $error")
+        finish(Status(State.FAILED, error = error))
+    }
+
+    private fun finish(value: Status) {
+        busy = false
+        publish(value)
+        schedule(CHECK_INTERVAL)
+    }
+
+    @JvmStatic
+    fun statusText(): String {
+        val s = status
+        return when (s.state) {
+            State.DISABLED -> s.error.ifEmpty { "local builds don't update themselves." }
+            State.IDLE -> "not checked yet."
+            State.CHECKING -> "checking for updates..."
+            State.LATEST -> "you have the latest build."
+            State.DOWNLOADING -> if (s.total > 0) "downloading ${s.tag}: ${s.ready * 100 / s.total}%" else "downloading ${s.tag}..."
+            State.READY -> "${s.tag} is ready, install to update."
+            State.FAILED -> "update failed: ${s.error}"
+        }
+    }
+}
