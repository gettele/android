+/**
+ * Imports a wallet from a raw Ed25519 private key (tele 0309). The key stays in the protected
+ * storage; Telegram's phrase backup does not accept it, so the screen says so up front.
+ */
+public class WalletPrivateKeyFragment extends BaseFragment {
+
+    private EditText input;
+    private TextView status;
+    private ButtonWithCounterView importButton;
+    private String detectedAddress;
+    private SecretPhrase detectedPhrase;
+    private int generation;
+
+    private void check(String text) {
+        final int current = ++generation;
+        final String[] words = text.trim().split("\\s+");
+        final ArrayList<String> list = new ArrayList<>();
+        for (String word : words) {
+            if (!word.isEmpty()) list.add(word);
+        }
+        if (list.isEmpty()) {
+            detectedAddress = null;
+            status.setVisibility(View.GONE);
+            importButton.setEnabled(false);
+            return;
+        }
+        Utilities.globalQueue.postRunnable(() -> {
+            String address = null;
+            boolean isKey = false;
+            SecretPhrase phrase = null;
+            try {
+                phrase = SecretPhrase.fromWords(list);
+                isKey = WalletEngine2.detectPrivateKey(phrase);
+                if (isKey) address = WalletEngine2.privateKeyAddress(phrase);
+            } catch (Throwable e) {
+                FileLog.e(e);
+            }
+            final boolean key = isKey;
+            final String found = address;
+            final SecretPhrase result = phrase;
+            AndroidUtilities.runOnUIThread(() -> {
+                if (current != generation) {
+                    if (result != null) result.close();
+                    return;
+                }
+                if (detectedPhrase != null) detectedPhrase.close();
+                detectedPhrase = result;
+                detectedAddress = found;
+                status.setVisibility(View.VISIBLE);
+                if (key && found != null) {
+                    status.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2, resourceProvider));
+                    status.setText("Address: " + found);
+                    importButton.setEnabled(true);
+                } else {
+                    status.setTextColor(Theme.getColor(Theme.key_text_RedRegular, resourceProvider));
+                    status.setText("This is not a private key.");
+                    importButton.setEnabled(false);
+                }
+            });
+        });
+    }
+
