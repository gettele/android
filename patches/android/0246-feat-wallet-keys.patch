+namespace {
+
+// A private-key secret is whitespace separated: the key, and after a rotation the 12 words.
+std::vector<std::string> split_secret(const std::string &phrase) {
+    std::vector<std::string> words;
+    std::string current;
+    for (const auto byte : phrase) {
+        const bool separator = byte == ' ' || byte == '\t' || byte == '\n'
+            || byte == '\r' || byte == '\f' || byte == 11;
+        if (separator) {
+            if (!current.empty()) {
+                words.push_back(std::move(current));
+                current.clear();
+            }
+        } else {
+            current.push_back(static_cast<char>(byte));
+        }
+    }
+    if (!current.empty()) words.push_back(std::move(current));
+    return words;
+}
+
+} // namespace
+
+extern "C" JNIEXPORT jboolean JNICALL
+Java_org_telegram_ui_Wallet_WalletEngine2_nativeDetectPrivateKey(
+        JNIEnv *env, jclass, jbyteArray secret) {
+    if (!secret) return JNI_FALSE;
+    try {
+        const jsize length = env->GetArrayLength(secret);
+        SensitiveString phrase(static_cast<size_t>(length));
+        env->GetByteArrayRegion(secret, 0, length, reinterpret_cast<jbyte *>(phrase.value.data()));
+        if (env->ExceptionCheck()) return JNI_FALSE;
+        return we::detect_private_key(split_secret(phrase.value)) ? JNI_TRUE : JNI_FALSE;
+    } catch (...) {
+        // A key that does not parse is simply not a private key.
+        return JNI_FALSE;
+    }
+}
+
+extern "C" JNIEXPORT jbyteArray JNICALL
+Java_org_telegram_ui_Wallet_WalletEngine2_nativePrivateKeyPublicKey(
+        JNIEnv *env, jclass, jbyteArray secret) {
+    if (!secret) {
+        throw_java(env, "java/lang/IllegalArgumentException", "Private key is required");
+        return nullptr;
+    }
+    try {
+        const jsize length = env->GetArrayLength(secret);
+        SensitiveString phrase(static_cast<size_t>(length));
+        env->GetByteArrayRegion(secret, 0, length, reinterpret_cast<jbyte *>(phrase.value.data()));
+        if (env->ExceptionCheck()) return nullptr;
+        const auto key = we::private_key_public_key(phrase.value);
+        if (key.size() != 32) throw std::runtime_error("Unexpected public key size");
+        jbyteArray result = env->NewByteArray(32);
+        if (result) env->SetByteArrayRegion(result, 0, 32, reinterpret_cast<const jbyte *>(key.data()));
+        return result;
+    } catch (const std::bad_alloc &) {
+        throw_java(env, "java/lang/OutOfMemoryError", "Could not derive the wallet key");
+    } catch (...) {
+        throw_java(env, "java/lang/IllegalArgumentException", "Invalid private key");
+    }
+    return nullptr;
+}
+
+extern "C" JNIEXPORT jstring JNICALL
+Java_org_telegram_ui_Wallet_WalletEngine2_nativePrivateKeyAddress(
+        JNIEnv *env, jclass, jbyteArray secret) {
+    if (!secret) {
+        throw_java(env, "java/lang/IllegalArgumentException", "Private key is required");
+        return nullptr;
+    }
+    try {
+        const jsize length = env->GetArrayLength(secret);
+        SensitiveString phrase(static_cast<size_t>(length));
+        env->GetByteArrayRegion(secret, 0, length, reinterpret_cast<jbyte *>(phrase.value.data()));
+        if (env->ExceptionCheck()) return nullptr;
+        const auto address = we::private_key_address(phrase.value, we::Network::kMainnet);
+        return env->NewStringUTF(address.c_str());
+    } catch (const std::bad_alloc &) {
+        throw_java(env, "java/lang/OutOfMemoryError", "Could not derive the wallet address");
+    } catch (...) {
+        throw_java(env, "java/lang/IllegalArgumentException", "Invalid private key");
+    }
+    return nullptr;
+}
