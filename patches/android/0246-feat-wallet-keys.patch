+        input = new EditText(context);
+        input.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14);
+        input.setTypeface(AndroidUtilities.getTypeface("fonts/rmono.ttf"));
+        input.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText, resourceProvider));
+        input.setHintTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteHintText, resourceProvider));
+        input.setHint("hex or base64 key, then the 12 words");
+        input.setInputType(InputType.TYPE_CLASS_TEXT | InputType.TYPE_TEXT_FLAG_MULTI_LINE | InputType.TYPE_TEXT_FLAG_NO_SUGGESTIONS);
+        input.setBackground(Theme.createRoundRectDrawable(dp(10), Theme.getColor(Theme.key_windowBackgroundGray, resourceProvider)));
+        input.setPadding(dp(12), dp(12), dp(12), dp(12));
+        input.addTextChangedListener(new TextWatcher() {
+            @Override public void beforeTextChanged(CharSequence s, int start, int count, int after) {}
+            @Override public void onTextChanged(CharSequence s, int start, int before, int count) {}
+            @Override public void afterTextChanged(Editable s) {
+                check(s == null ? "" : s.toString());
+            }
+        });
+        root.addView(input, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, dp(120), 0, 0, 0, 0, 8));
+
+        status = new TextView(context);
+        status.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12);
+        status.setTypeface(AndroidUtilities.getTypeface("fonts/rmono.ttf"));
+        status.setVisibility(View.GONE);
+        root.addView(status, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT, 0, 0, 0, 8));
+
+        importButton = new ButtonWithCounterView(context, resourceProvider);
+        importButton.setRound();
+        importButton.setText(getString(R.string.WalletImportButton));
+        importButton.setEnabled(false);
+        importButton.setOnClickListener(v -> onImportPressed());
+        root.addView(importButton, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, 48, Gravity.CENTER_HORIZONTAL, 0, 12, 0, 0));
+
+        return fragmentView;
+    }
+
+    private void onImportPressed() {
+        if (importButton.isLoading()) return;
+        final String address = detectedAddress;
+        if (TextUtils.isEmpty(address) || detectedPhrase == null) return;
+        final SecretPhrase phrase = detectedPhrase.copy();
+        final GramWallet wallet = GramWallet.getInstance(currentAccount);
+        final String pastAddress = wallet.getAddress();
+        importButton.setLoading(true);
+        wallet.importWallet(phrase, error -> {
+            importButton.setLoading(false);
+            if ("WRONG_CONTRACT".equalsIgnoreCase(error) || "INVALID_PHRASE".equalsIgnoreCase(error)) {
+                new AlertDialog.Builder(getContext(), resourceProvider)
+                    .setTitle(getString(R.string.WalletInvalidRecoveryPhrase))
+                    .setMessage(getString(R.string.WalletInvalidRecoveryPhraseInfo))
+                    .setPositiveButton(getString(R.string.WalletOK), null)
+                    .show();
+                return;
+            }
+            if (error != null) {
+                BulletinFactory.of(this).showForError(error);
+                return;
+            }
+            finishFragment();
+            wallet.notifyUpdate();
+        });
+    }
+
+    @Override
+    public void onFragmentDestroy() {
+        if (detectedPhrase != null) {
+            detectedPhrase.close();
+            detectedPhrase = null;
+        }
+        super.onFragmentDestroy();
+    }
+
+    @Override
+    public boolean isSupportEdgeToEdge() {
+        return true;
+    }
