+/* The generator/async-generator object is created only after the initial
+   resume, but that prologue already builds mapped arguments and evaluates
+   default parameters. Both can create open var_refs while cur_gc_obj is still
+   NULL. Adopt those refs once the owner exists, so the cycle collector cannot
+   free the coroutine while a closure still points into its frame. */
+static void js_coro_adopt_var_refs(JSContext *ctx, JSStackFrame *sf,
+                                   JSGCObjectHeader *owner)
+{
+    int i;
+    sf->cur_gc_obj = owner;
+    for (i = 0; i < sf->var_ref_count; i++) {
+        JSVarRef *var_ref = sf->var_refs[i];
+        if (var_ref && !var_ref->is_detached && !var_ref->is_coro) {
+            var_ref->is_coro = true;
+            JS_REF_COUNT(owner)++;
+            add_gc_object(ctx->rt, &var_ref->header, JS_GC_OBJ_TYPE_VAR_REF);
+        }
+    }
+}
