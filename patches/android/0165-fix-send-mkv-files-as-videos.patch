index 000000000..22f8ccaa5
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/MkvVideo.kt
@@ -0,0 +1,52 @@
+package tele.helpers
+
+import android.media.MediaMetadataRetriever
+import org.telegram.messenger.FileLog
+import org.telegram.messenger.VideoEditedInfo
+import org.telegram.tgnet.TLRPC
+import tele.TeleConfig
+
+// send mkv files as videos (tele 0153): stock only takes mp4 and files the converter can read
+object MkvVideo {
+
+    private const val MIME = "video/x-matroska"
+
+    private fun isMkv(path: String?): Boolean = path != null && path.endsWith(".mkv", ignoreCase = true)
+
+    /** An mkv counts as a video only when its video track has a real size and length. */
+    @JvmStatic
+    fun isVideo(path: String?): Boolean {
+        if (!TeleConfig.SEND_MKV_AS_VIDEO.value || !isMkv(path)) return false
+        val retriever = MediaMetadataRetriever()
+        return try {
+            retriever.setDataSource(path)
+            val video = retriever.extractMetadata(MediaMetadataRetriever.METADATA_KEY_HAS_VIDEO) == "yes"
+            val width = retriever.extractMetadata(MediaMetadataRetriever.METADATA_KEY_VIDEO_WIDTH)?.toIntOrNull() ?: 0
+            val height = retriever.extractMetadata(MediaMetadataRetriever.METADATA_KEY_VIDEO_HEIGHT)?.toIntOrNull() ?: 0
+            val duration = retriever.extractMetadata(MediaMetadataRetriever.METADATA_KEY_DURATION)?.toLongOrNull() ?: 0L
+            video && width > 0 && height > 0 && duration > 0
+        } catch (e: Exception) {
+            FileLog.e(e)
+            false
+        } finally {
+            try {
+                retriever.release()
+            } catch (ignore: Exception) {
+            }
+        }
+    }
+
+    /** The file keeps its container, so the document says so and doesn't promise streaming. */
+    @JvmStatic
+    fun label(
+        document: TLRPC.TL_document,
+        attribute: TLRPC.TL_documentAttributeVideo,
+        path: String?,
+        info: VideoEditedInfo?
+    ) {
+        if (!TeleConfig.SEND_MKV_AS_VIDEO.value || !isMkv(path)) return
+        if (info != null && info.needConvert()) return
+        document.mime_type = MIME
+        attribute.supports_streaming = false
+    }
+}
