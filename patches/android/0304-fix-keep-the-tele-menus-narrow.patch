@@ -6,6 +6,8 @@ import android.animation.Animator;
 import android.animation.AnimatorListenerAdapter;
 import android.animation.ValueAnimator;
 import android.content.Context;
+import android.graphics.Canvas;
+import android.graphics.Paint;
 import android.graphics.PorterDuff;
 import android.graphics.PorterDuffColorFilter;
 import android.graphics.drawable.Drawable;
@@ -169,6 +171,33 @@ public class ActionBarMenuSubItem extends FrameLayout implements Theme.Colorable
         checkView.setColor(-1, -1, colorKey);
     }
 
+    private boolean teleDividerTop, teleDividerBottom;
+
+    public void tele_setDividers() {
+        tele_setDividers(true, true);
+    }
+
+    public void tele_setDividers(boolean top, boolean bottom) {
+        teleDividerTop |= top;
+        teleDividerBottom |= bottom;
+        invalidate();
+    }
+
+    @Override
+    protected void dispatchDraw(Canvas canvas) {
+        super.dispatchDraw(canvas);
+        if (teleDividerTop || teleDividerBottom) {
+            final int height = dp(1);
+            final Paint paint = Theme.dividerPaint;
+            if (teleDividerTop) {
+                canvas.drawRect(0, 0, getMeasuredWidth(), height, paint);
+            }
+            if (teleDividerBottom) {
+                canvas.drawRect(0, getMeasuredHeight() - height, getMeasuredWidth(), getMeasuredHeight(), paint);
+            }
+        }
+    }
+
