+    /** Runs the action of a button of the bar, or explains why it can't. [anchor] is the button. */
+    @JvmStatic
+    fun perform(selection: GiftSelection, action: Action, fragment: BaseFragment?, anchor: View, resourcesProvider: Theme.ResourcesProvider?) {
+        if (selection.isBusy) return
+        val reason = reason(selection, action)
+        if (reason != null) {
+            explain(fragment, reason)
+            return
+        }
+        val context = anchor.context
+        when (action) {
+            Action.SHOW -> setSaved(selection, true, fragment)
+            Action.HIDE -> setSaved(selection, false, fragment)
+            Action.PIN -> setPinned(selection, true, fragment)
+            Action.UNPIN -> setPinned(selection, false, fragment)
+            Action.TRANSFER -> transfer(selection, fragment, context, resourcesProvider)
+            Action.SELL -> sell(selection, fragment, context, resourcesProvider)
+            Action.UNLIST -> unlist(selection, fragment, context, resourcesProvider)
+            Action.CONVERT -> convert(selection, fragment, context, resourcesProvider)
+            Action.COLLECTION -> chooseCollection(selection, fragment, anchor)
+        }
+    }
