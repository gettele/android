+    // every list that may hold another object of the same gift
+    private fun lists(selection: GiftSelection): List<StarsController.GiftsList> {
+        val result = ArrayList<StarsController.GiftsList>()
+        result.add(selection.allList)
+        selection.collections.all?.let { result.add(it) }
+        result.addAll(selection.collections.gifts.values)
+        if (!result.contains(selection.list)) result.add(selection.list)
+        return result
+    }
+
+    // the price is [price], or the gift is off sale when it is null; the same gift in other lists is another object
+    private fun markResale(selection: GiftSelection, gift: TL_stars.SavedStarGift, price: AmountUtils.Amount?) {
+        val targets = ArrayList<TL_stars.SavedStarGift>()
+        targets.add(gift)
+        for (list in lists(selection)) {
+            for (other in list.gifts) if (other !== gift && StarsController.eq(other, gift)) targets.add(other)
+        }
+        for (target in targets) {
+            val unique = unique(target) ?: continue
+            if (price != null) {
+                unique.flags = unique.flags or 16
+                unique.resale_ton_only = price.currency == AmountUtils.Currency.TON
+                unique.resell_amount = arrayListOf(price.convertTo(AmountUtils.Currency.STARS).toTl(), price.convertTo(AmountUtils.Currency.TON).toTl())
+            } else {
+                unique.flags = unique.flags and 16.inv()
+                unique.resale_ton_only = false
+                unique.resell_amount = null
+            }
+        }
+    }
+
+    private fun sell(selection: GiftSelection, fragment: BaseFragment?, context: Context, resourcesProvider: Theme.ResourcesProvider?) {
+        StarsIntroActivity.showGiftResellPriceSheet(context, selection.currentAccount, Utilities.Callback2<AmountUtils.Amount, Runnable> { price, close ->
+            close?.run()
+            confirmSell(selection, fragment, context, resourcesProvider, price)
+        }, resourcesProvider)
+    }
+
+    // the sheet asks for one price: tell it goes to every gift before anything is listed
+    private fun confirmSell(selection: GiftSelection, fragment: BaseFragment?, context: Context, resourcesProvider: Theme.ResourcesProvider?, price: AmountUtils.Amount) {
+        val gifts = selection.gifts
+        val amount = StarsIntroActivity.formatStarsAmountString(price.toTl()).toString()
+        val text = StarsIntroActivity.replaceStarsWithPlain(
+            price.currency == AmountUtils.Currency.TON,
+            LocaleController.formatPluralString("TeleGiftsSellConfirm", gifts.size, "XTR $amount"),
+            .66f
+        )
+        AlertDialog.Builder(context, resourcesProvider)
+            .setTitle(LocaleController.getString(R.string.Gift2ActionResell))
+            .setMessage(text)
+            .setPositiveButton(LocaleController.getString(R.string.Gift2ActionResell)) { _, _ ->
+                // the whole batch is one protected action
+                StarsLock.guard(fragment, StarsLock.SELL) {
+                    if (!selection.isBusy) runSell(selection, fragment, gifts, price)
+                }
+            }
+            .setNegativeButton(LocaleController.getString(R.string.Cancel), null)
+            .show()
+    }
+
+    private fun unlist(selection: GiftSelection, fragment: BaseFragment?, context: Context, resourcesProvider: Theme.ResourcesProvider?) {
+        val gifts = selection.gifts
+        AlertDialog.Builder(context, resourcesProvider)
+            .setTitle(LocaleController.getString(R.string.Gift2ActionUnlist))
+            .setMessage(LocaleController.formatPluralString("TeleGiftsUnlistConfirm", gifts.size))
+            .setPositiveButton(LocaleController.getString(R.string.Gift2ActionUnlist)) { _, _ ->
+                if (!selection.isBusy) runSell(selection, fragment, gifts, null)
+            }
+            .setNegativeButton(LocaleController.getString(R.string.Cancel), null)
+            .show()
+    }
+
+    // [price] null takes the gifts off sale
+    private fun runSell(selection: GiftSelection, fragment: BaseFragment?, gifts: List<TL_stars.SavedStarGift>, price: AmountUtils.Amount?) {
+        val messages = MessagesController.getInstance(selection.currentAccount)
+        runBatch(
+            selection, fragment, if (price != null) "gifts-listed" else "gifts-unlisted", gifts,
+            LocaleController.formatPluralString(if (price != null) "TeleGiftsPutOnSale" else "TeleGiftsRemovedFromSale", gifts.size),
+            { index, batch, done ->
+                val gift = gifts[index]
+                val request = TL_stars.updateStarGiftPrice()
+                request.stargift = selection.list.getInput(gift)
+                request.resell_amount = price?.toTl() ?: TL_stars.StarsAmount.ofStars(0)
+                batch.send(request) { response, err ->
+                    if (response is TLRPC.Updates) {
+                        messages.processUpdates(response, false)
+                        markResale(selection, gift, price)
+                        done(null)
+                    } else {
+                        done(GiftBatch.Failure.of(err, "SELL_FAILED", false))
+                    }
+                }
+            },
+            { for (list in lists(selection)) list.notifyUpdate() }
+        )
+    }
+
+    private fun convert(selection: GiftSelection, fragment: BaseFragment?, context: Context, resourcesProvider: Theme.ResourcesProvider?) {
+        val gifts = selection.gifts
+        val stars = gifts.sumOf { it.convert_stars }
+        AlertDialog.Builder(context, resourcesProvider)
+            .setTitle(LocaleController.getString(R.string.TeleGiftsConvertTitle))
+            .setMessage(LocaleController.formatPluralString("TeleGiftsConvertConfirm", gifts.size, LocaleController.formatNumber(stars, ',')))
+            .setPositiveButton(LocaleController.getString(R.string.Gift2ConvertButton)) { _, _ ->
+                // the whole batch is one protected action
+                StarsLock.guard(fragment, StarsLock.CONVERT) {
+                    if (!selection.isBusy) runConvert(selection, fragment, gifts, stars)
+                }
+            }
+            .setNegativeButton(LocaleController.getString(R.string.Cancel), null)
+            .show()
+    }
+
+    private fun runConvert(selection: GiftSelection, fragment: BaseFragment?, gifts: List<TL_stars.SavedStarGift>, stars: Long) {
+        val account = selection.currentAccount
+        val dialogId = selection.dialogId
+        runBatch(
+            selection, fragment, "gifts-converted", gifts,
+            LocaleController.formatPluralString("TeleGiftsConverted", gifts.size, LocaleController.formatNumber(stars, ',')),
+            { index, batch, done ->
+                val gift = gifts[index]
+                val request = TL_stars.convertStarGift()
+                request.stargift = selection.list.getInput(gift)
+                batch.send(request) { response, err ->
+                    if (response is TLRPC.TL_boolTrue) {
+                        StarsController.getInstance(account).removeProfileGiftLocally(dialogId, gift)
+                        selection.remove(gift)
+                        val full = if (dialogId >= 0) MessagesController.getInstance(account).getUserFull(dialogId) else null
+                        if (full != null) {
+                            full.stargifts_count = maxOf(0, full.stargifts_count - 1)
+                            if (full.stargifts_count <= 0) full.flags2 = full.flags2 and 256.inv()
+                        }
+                        done(null)
+                    } else {
+                        done(GiftBatch.Failure.of(err, "CONVERT_FAILED", false))
+                    }
+                }
+            },
+            { result ->
+                if (result.done > 0) {
+                    if (dialogId >= 0) {
+                        StarsController.getInstance(account).invalidateBalance()
+                        StarsController.getInstance(account).invalidateTransactions(true)
+                    } else {
+                        BotStarsController.getInstance(account).invalidateStarsBalance(dialogId)
+                        BotStarsController.getInstance(account).invalidateTransactions(dialogId, true)
+                    }
+                }
+            }
+        )
+    }
+
+    // the menu lists the collections; the ones that already hold every picked gift are dimmed
+    private fun chooseCollection(selection: GiftSelection, fragment: BaseFragment?, anchor: View) {
+        if (fragment == null) return
+        val gifts = selection.gifts
+        val options = ItemOptions.makeOptions(fragment, anchor).setDrawScrim(false)
+        for (collection in selection.collections.getCollections()) {
+            val id = collection.collection_id
+            val title = collection.title
+            val inside = gifts.all { it.collection_id.contains(id) }
+            options.add(if (inside) LocaleController.formatString(R.string.TeleGiftsInCollection, title) else title) {
+                addToCollection(selection, fragment, id, title)
+            }
+            if (inside) {
+                options.lastView?.let {
+                    it.alpha = .4f
+                    it.isEnabled = false
+                }
+            }
+        }
+        options.show()
+    }
+
+    // one request for all the gifts; the selection stays locked until the server answers
+    private fun addToCollection(selection: GiftSelection, fragment: BaseFragment, id: Int, title: String) {
+        if (selection.isBusy) return
+        val targets = selection.gifts.filter { !it.collection_id.contains(id) }
+        if (targets.isEmpty()) return
+        val account = selection.currentAccount
+        val collections = selection.collections
+        selection.work(true, LocaleController.getString(R.string.TeleGiftsAdding))
+        val request = TL_stars.updateStarGiftCollection()
+        request.peer = MessagesController.getInstance(account).getInputPeer(selection.dialogId)
+        request.collection_id = id
+        request.flags = request.flags or 4
+        for (gift in targets) request.add_stargift.add(selection.list.getInput(gift))
+        ConnectionsManager.getInstance(account).sendRequest(request) { response, err ->
+            AndroidUtilities.runOnUIThread {
+                if (response is TL_stars.TL_starGiftCollection) {
+                    // the same bookkeeping as the add from the menu of a gift
+                    val list = collections.getListById(id)
+                    if (list != null) {
+                        list.gifts.addAll(0, targets)
+                        list.totalCount += targets.size
+                        list.notifyUpdate()
+                        collections.updateIcon(id)
+                    }
+                    for (gift in targets) collections.updateGiftsCollections(gift, id, true)
+                    val known = collections.getCollections()
+                    val index = known.indexOfFirst { it.collection_id == id }
+                    if (index >= 0) known[index] = response
+                    NotificationCenter.getInstance(account).postNotificationName(NotificationCenter.starUserGiftCollectionsLoaded, selection.dialogId, collections)
+                    toast(selection, fragment, "gifts-collected", LocaleController.formatPluralString("TeleGiftsAddedToCollection", targets.size, title))
+                } else {
+                    bulletins(fragment).showForError(err)
+                }
+                selection.exit()
+            }
+        }
+    }
 }
