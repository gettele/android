+
+    /** Says why a dimmed button of the bar does nothing. */
+    @JvmStatic
+    fun explain(fragment: BaseFragment?, reason: String) {
+        bulletins(fragment).createSimpleBulletin(R.raw.error, reason).show()
+    }
