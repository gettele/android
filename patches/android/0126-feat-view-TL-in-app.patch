From: tangenx <me@tangenx.dev>
Date: Thu, 22 Oct 2026 08:27:42 +0300
Subject: [PATCH 126/132] feat: view TL in app

---
 .../src/main/java/tele/helpers/ViewAsTl.kt    | 26 ++++++++++++++++++-
 1 file changed, 25 insertions(+), 1 deletion(-)

diff --git a/TMessagesProj/src/main/java/tele/helpers/ViewAsTl.kt b/TMessagesProj/src/main/java/tele/helpers/ViewAsTl.kt
index fb131cc3a..ffe27b2a5 100644
--- a/TMessagesProj/src/main/java/tele/helpers/ViewAsTl.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/ViewAsTl.kt
@@ -11,6 +11,7 @@ import org.telegram.messenger.AndroidUtilities
 import org.telegram.messenger.ApplicationLoader
 import org.telegram.messenger.ChatObject
 import org.telegram.messenger.LocaleController
+import android.net.Uri
 import org.telegram.messenger.browser.Browser
 import org.telegram.tgnet.SerializedData
 import org.telegram.tgnet.TLObject
@@ -154,7 +155,30 @@ object ViewAsTl {
         if (url.length > MAX_DIRECT_URL_LENGTH) {
             openRedirect(fragment, url)
         } else {
-            Browser.openUrl(fragment.parentActivity, url)
+            openInApp(fragment, url)
+        }
+    }
+
+    /** Opens the page inside the app, the browser of the system stays the fallback. */
+    @JvmStatic
+    fun openInApp(fragment: BaseFragment, url: String) {
+        if (!isEnabled()) return
+        val activity = fragment.parentActivity ?: return
+        runCatching {
+            Browser.openUrl(
+                activity,
+                Uri.parse(url),
+                true,
+                false,
+                false,
+                null,
+                null,
+                false,
+                true,
+                false
+            )
+        }.onFailure {
+            runCatching { Browser.openUrl(activity, url) }
         }
     }
 
