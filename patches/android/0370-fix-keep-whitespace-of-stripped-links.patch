From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: test <test@example.com>
Date: Sun, 22 Nov 2026 12:04:20 +0300
Subject: [PATCH] fix: keep whitespace of stripped links

A stripped invisible link took its spaces with it. Whitespace is visible spacing: the link goes but spaces and tabs stay as plain text, only zero-width characters are removed. Plain and rich HTML copies alike.
---
 .../java/org/telegram/ui/iv/RichHtml.java     | 20 ++++++++++++++++--
 .../src/main/java/tele/helpers/CopyLinks.kt   | 21 ++++++++++++++-----
 .../main/java/tele/helpers/InvisibleNames.kt  |  3 ++-
 3 files changed, 36 insertions(+), 8 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/iv/RichHtml.java b/TMessagesProj/src/main/java/org/telegram/ui/iv/RichHtml.java
index c26eda484..3f132fdc7 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/iv/RichHtml.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/iv/RichHtml.java
@@ -452,14 +452,17 @@ public class RichHtml {
             String url = null;
             URLSpanReplacement[] urls = sp.getSpans(pos, next, URLSpanReplacement.class);
             if (urls.length > 0) url = urls[0].getURL();
-            // a link over invisible text (spaces included) carries nothing visible: drop it whole
+            // a link over invisible text (spaces included) carries nothing visible: drop the link,
+            // keep the whitespace as plain text
             boolean hiddenLink = url != null && tele.helpers.CopyLinks.enabled()
                 && tele.helpers.InvisibleNames.isInvisibleText(cs.subSequence(pos, next));
             long emojiId = 0;
             AnimatedEmojiSpan[] emoji = sp.getSpans(pos, next, AnimatedEmojiSpan.class);
             if (emoji.length > 0 && !emoji[0].standard) emojiId = emoji[0].getDocumentId();
 
-            if (!hiddenLink) {
+            if (hiddenLink) {
+                escapeSpaces(out, cs, pos, next);
+            } else {
                 openInline(out, flags, url, emojiId);
                 escape(out, cs, pos, next);
                 closeInline(out, flags, url, emojiId);
@@ -553,6 +556,19 @@ public class RichHtml {
         }
     }
 
+    // the whitespace of a stripped invisible link stays; zero-width characters go
+    private static void escapeSpaces(StringBuilder out, CharSequence text, int start, int end) {
+        int i = start;
+        while (i < end) {
+            int ch = Character.codePointAt(text, i);
+            int size = Character.charCount(ch);
+            if (tele.helpers.InvisibleNames.isSpace(ch)) {
+                escape(out, text, i, i + size);
+            }
+            i += size;
+        }
+    }
+
     private static String escapeAttr(String s) {
         if (s == null) return "";
         return s.replace("&", "&amp;").replace("\"", "&quot;").replace("<", "&lt;").replace(">", "&gt;");
diff --git a/TMessagesProj/src/main/java/tele/helpers/CopyLinks.kt b/TMessagesProj/src/main/java/tele/helpers/CopyLinks.kt
index dd19c2764..4cdc5bc33 100644
--- a/TMessagesProj/src/main/java/tele/helpers/CopyLinks.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/CopyLinks.kt
@@ -9,15 +9,15 @@ import tele.TeleConfig
 /**
  * Strips links hidden in invisible text when copying (desktop 0343). A custom-url entity whose
  * whole range is invisible code points — spaces and tabs included, like the desktop table —
- * carries no visible text, so the link goes and the invisible characters with it; a link over
- * visible text stays.
+ * carries no visible text, so the link goes; whitespace stays as plain text, only the zero-width
+ * characters go with it. A link over visible text stays.
  */
 object CopyLinks {
 
     @JvmStatic
     fun enabled(): Boolean = TeleConfig.REMOVE_INVISIBLE_COPY_LINKS.value
 
-    /** The plain copy of a message: invisible custom links are dropped from the spanned text. */
+    /** The plain copy of a message: invisible custom links lose the link, whitespace stays. */
     @JvmStatic
     fun clean(text: CharSequence?): CharSequence? {
         if (!enabled() || text !is Spanned) return text
@@ -31,12 +31,23 @@ object CopyLinks {
             if (!InvisibleNames.isInvisibleText(text.subSequence(start, end))) continue
             val builder = result ?: SpannableStringBuilder(text).also { result = it }
             builder.removeSpan(span)
-            builder.delete(start, end)
+            // whitespace is visible spacing: keep it, drop only the zero-width characters
+            var i = end
+            while (i > start) {
+                val ch = Character.codePointBefore(builder, i)
+                val size = Character.charCount(ch)
+                if (InvisibleNames.isSpace(ch)) {
+                    i -= size
+                } else {
+                    builder.delete(i - size, i)
+                    i -= size
+                }
+            }
         }
         return result ?: text
     }
 
-    /** The Markdown/HTML copy: invisible text-url entities are dropped before conversion. */
+    /** The Markdown/HTML copy: invisible text-url entities lose the link, the text stays. */
     @JvmStatic
     fun cleanEntities(text: String, entities: List<TLRPC.MessageEntity>?): List<TLRPC.MessageEntity>? {
         if (!enabled() || entities.isNullOrEmpty()) return entities
diff --git a/TMessagesProj/src/main/java/tele/helpers/InvisibleNames.kt b/TMessagesProj/src/main/java/tele/helpers/InvisibleNames.kt
index 9c2613023..3d3622349 100644
--- a/TMessagesProj/src/main/java/tele/helpers/InvisibleNames.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/InvisibleNames.kt
@@ -64,7 +64,8 @@ object InvisibleNames {
     }
 
     // QChar::isSpace: the Latin-1 whitespace plus the space, line and paragraph separators
-    private fun isSpace(ch: Int): Boolean {
+    @JvmStatic
+    fun isSpace(ch: Int): Boolean {
         if (ch in 0x09..0x0D || ch == 0x85) return true
         val type = Character.getType(ch)
         return type == Character.SPACE_SEPARATOR.toInt() ||
