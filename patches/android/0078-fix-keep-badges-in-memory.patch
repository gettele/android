+    private fun mark(chat: TLRPC.Chat, p: Peer) {
+        synchronized(stockFlags) {
+            if (!stockFlags.containsKey(chat)) stockFlags[chat] = StockFlags(chat.verified, chat.scam, chat.fake, false)
+        }
         chat.verified = p.checkmark
         chat.scam = p.scam
         chat.fake = p.fake
-        markedUsers.add(pid)
+    }
+
+    private fun unmark(obj: TLObject) {
+        val s = stockFlags.remove(obj) ?: return
+        restore(obj, s)
+    }
+
+    private fun restore(obj: TLObject, s: StockFlags) {
+        when (obj) {
+            is TLRPC.User -> {
+                obj.verified = s.verified
+                obj.scam = s.scam
+                obj.fake = s.fake
+                obj.support = s.support
+            }
+            is TLRPC.Chat -> {
+                obj.verified = s.verified
+                obj.scam = s.scam
+                obj.fake = s.fake
+            }
+        }
+    }
+
+    @JvmStatic
+    fun stockUsers(users: List<TLRPC.User?>): List<TLRPC.User?> =
+        withStockFlags(users) { data -> TLRPC.User.TLdeserialize(data, data.readInt32(false), false) }
+
+    @JvmStatic
+    fun stockChats(chats: List<TLRPC.Chat?>): List<TLRPC.Chat?> =
+        withStockFlags(chats) { data -> TLRPC.Chat.TLdeserialize(data, data.readInt32(false), false) }
+
+    private fun <T : TLObject> withStockFlags(objects: List<T?>, read: (SerializedData) -> T?): List<T?> {
+        if (stockFlags.isEmpty()) return objects
+        var result: ArrayList<T?>? = null
+        for (i in objects.indices) {
+            val obj = objects[i] ?: continue
+            val s = stockFlags[obj] ?: continue
+            val copy = copyOf(obj, read) ?: continue
+            restore(copy, s)
+            if (result == null) result = ArrayList(objects)
+            result[i] = copy
+        }
+        return result ?: objects
+    }
+
+    private fun <T : TLObject> copyOf(obj: T, read: (SerializedData) -> T?): T? {
+        val out = SerializedData(obj.objectSize)
+        return try {
+            obj.serializeToStream(out)
+            val input = SerializedData(out.toByteArray())
+            try {
+                read(input)
+            } finally {
+                input.cleanup()
+            }
+        } catch (e: Exception) {
+            FileLog.e(e)
+            null
+        } finally {
+            out.cleanup()
+        }
     }
 
     @JvmStatic
