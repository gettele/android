+extern "C" JNIEXPORT jbyteArray JNICALL
+Java_org_telegram_ui_Wallet_WalletEngine2_nativeRecoverWalletSecret(
+        JNIEnv *env, jclass, jlong handle, jbyteArray words_bytes) {
+    if (!words_bytes) {
+        throw_java(env, "java/lang/IllegalArgumentException", "RECOVER_INVALID_WORDS");
+        return nullptr;
+    }
+    try {
+        auto client = get_client(handle);
+        const jsize length = env->GetArrayLength(words_bytes);
+        SensitiveString phrase(static_cast<size_t>(length));
+        env->GetByteArrayRegion(words_bytes, 0, length, reinterpret_cast<jbyte *>(phrase.value.data()));
+        if (env->ExceptionCheck()) return nullptr;
+        const auto words = split_secret(phrase.value);
+        if (words.size() != 12) {
+            throw_java(env, "java/lang/IllegalArgumentException", "RECOVER_INVALID_WORDS");
+            return nullptr;
+        }
+        const auto recovered = client.wallet->recover_wallet_secret(words);
+        jbyteArray result = env->NewByteArray(static_cast<jsize>(recovered.phrase.size()));
+        if (result) {
+            env->SetByteArrayRegion(result, 0, static_cast<jsize>(recovered.phrase.size()),
+                reinterpret_cast<const jbyte *>(recovered.phrase.data()));
+        }
+        return result;
+    } catch (const we::wallet_client_error::InvalidProtectedSecret &) {
+        throw_java(env, "java/lang/IllegalArgumentException", "RECOVER_INVALID_WORDS");
+    } catch (const we::wallet_client_error::EncryptedCommentLookupFailed &) {
+        throw_java(env, "java/lang/IllegalStateException", "RECOVER_NOT_FOUND");
+    } catch (const we::wallet_client_error::WalletIdentityMismatch &) {
+        throw_java(env, "java/lang/IllegalStateException", "RECOVER_MISMATCH");
+    } catch (const we::wallet_client_error::SendAlreadyInProgress &) {
+        throw_java(env, "java/lang/IllegalStateException", "RECOVER_BUSY");
+    } catch (const std::bad_alloc &) {
+        throw_java(env, "java/lang/OutOfMemoryError", "Could not recover the wallet");
+    } catch (...) {
+        throw_java(env, "java/lang/IllegalStateException", "RECOVER_FAILED");
+    }
+    return nullptr;
+}
