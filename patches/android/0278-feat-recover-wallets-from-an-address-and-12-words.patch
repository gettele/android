     }
 
+    private static native byte[] nativeRecoverWalletSecret(long handle, byte[] words);
+
+    /**
+     * Rebuilds a rotated wallet's secret from its address and the 12 words the latest key
+     * rotation installed. Configures a temporary engine with the words' public key, lets the
+     * engine walk the wallet's key-change history back to the anchor key, and returns a
+     * private-key secret ({anchor key, 12 words}) ready for {@link GramWallet#importWallet}.
+     * Call from the UI thread; the callback is delivered on the UI thread. Never logs the words.
+     */
+    public static void recoverWalletSecret(
+        int currentAccount,
+        @Nullable String address,
+        SecretPhrase words,
+        Utilities.Callback2<SecretPhrase /* recovered secret */, String /* error */> onResult
+    ) {
+        if (!isValidRecipientAddress(address)) {
+            onResult.run(null, "RECOVER_INVALID_ADDRESS");
+            return;
+        }
+        if (words == null || words.wordCount() != 12) {
+            onResult.run(null, "RECOVER_INVALID_WORDS");
+            return;
+        }
+        final byte[] publicKey;
+        final byte[] wordsBytes;
+        try {
+            publicKey = secretPhraseToPublicKey(words);
+            wordsBytes = words.copyBytes();
+        } catch (RuntimeException e) {
+            onResult.run(null, "RECOVER_INVALID_WORDS");
+            return;
+        }
+        Utilities.globalQueue.postRunnable(() -> {
+            WalletEngine2 engine = null;
+            SecretPhrase result = null;
+            String error = null;
+            try {
+                engine = new WalletEngine2(currentAccount, address, publicKey);
+                final byte[] secret = nativeRecoverWalletSecret(engine.ptr, wordsBytes);
+                if (secret != null && secret.length > 0) {
+                    result = new SecretPhrase(secret);
+                    Arrays.fill(secret, (byte) 0);
+                } else {
+                    error = "RECOVER_FAILED";
+                }
+            } catch (RuntimeException e) {
+                error = errorMessage(e);
+            } finally {
+                Arrays.fill(wordsBytes, (byte) 0);
+                if (engine != null) engine.close();
+            }
+            final SecretPhrase recovered = result;
+            final String failure = error;
+            AndroidUtilities.runOnUIThread(() -> onResult.run(recovered, failure));
+        });
+    }
+
     /**
      * Returns the 32-byte address anchor public key derived from the first 12 words.
      * Accepts 12- or 24-word Rotation phrases; only the anchor half is validated.
