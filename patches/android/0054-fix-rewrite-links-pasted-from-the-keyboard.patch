From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Mon, 5 Oct 2026 22:14:49 +0300
Subject: [PATCH] fix: rewrite links pasted from the keyboard

Gboard's clipboard button does not route through onTextContextMenuItem;
it commits the clipboard text straight through InputConnection. The
message field now wraps its input connection so a commit whose text a
rule rewrites is committed rewritten, with the same toast.

Confidence: high
Scope-risk: narrow
---
 .../ui/Components/EditTextCaption.java        | 23 +++++++++++++++++++
 1 file changed, 23 insertions(+)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Components/EditTextCaption.java b/TMessagesProj/src/main/java/org/telegram/ui/Components/EditTextCaption.java
index 5041083c5..fd0feebcb 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Components/EditTextCaption.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Components/EditTextCaption.java
@@ -40,6 +40,8 @@ import android.view.View;
 import android.view.ViewGroup;
 import android.view.accessibility.AccessibilityNodeInfo;
 import android.view.inputmethod.EditorInfo;
+import android.view.inputmethod.InputConnection;
+import android.view.inputmethod.InputConnectionWrapper;
 import android.widget.FrameLayout;
 import android.widget.TextView;
 
@@ -962,6 +964,27 @@ public class EditTextCaption extends EditTextBoldCursor implements FloatingToolb
         return Theme.getColor(key, resourcesProvider);
     }
 
+    @Override
+    public InputConnection onCreateInputConnection(EditorInfo outAttrs) {
+        InputConnection ic = super.onCreateInputConnection(outAttrs);
+        if (ic == null) {
+            return null;
+        }
+        return new InputConnectionWrapper(ic, true) {
+            @Override
+            public boolean commitText(CharSequence text, int newCursorPosition) {
+                if (text != null) {
+                    android.util.Pair<String, java.util.ArrayList<String>> rewritten = tele.helpers.LinkRewrites.applyToText(text.toString());
+                    if (rewritten != null) {
+                        Toast.makeText(getContext(), TextUtils.join("\n", rewritten.second), Toast.LENGTH_SHORT).show();
+                        return super.commitText(rewritten.first, newCursorPosition);
+                    }
+                }
+                return super.commitText(text, newCursorPosition);
+            }
+        };
+    }
+
     protected boolean teleRewritePaste() {
         ClipboardManager clipboard = (ClipboardManager) getContext().getSystemService(Context.CLIPBOARD_SERVICE);
         ClipData clip = clipboard == null ? null : clipboard.getPrimaryClip();
