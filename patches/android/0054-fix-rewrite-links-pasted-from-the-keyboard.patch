From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Mon, 5 Oct 2026 22:14:49 +0300
Subject: [PATCH] fix: rewrite links pasted from the keyboard

Gboard's clipboard button does not route through onTextContextMenuItem;
it commits the clipboard text straight through InputConnection. The
message field now wraps its input connection so a commit whose text a
rule rewrites is committed rewritten, with the same toast.

Confidence: high
Scope-risk: narrow
---
 .../main/java/org/telegram/ui/Components/EditTextCaption.java   | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Components/EditTextCaption.java b/TMessagesProj/src/main/java/org/telegram/ui/Components/EditTextCaption.java
index 47c7441cf..75cc36214 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Components/EditTextCaption.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Components/EditTextCaption.java
@@ -40,6 +40,8 @@ import android.view.View;
 import android.view.ViewGroup;
 import android.view.accessibility.AccessibilityNodeInfo;
 import android.view.inputmethod.EditorInfo;
+import android.view.inputmethod.InputConnection;
+import android.view.inputmethod.InputConnectionWrapper;
 import android.widget.FrameLayout;
 import android.widget.TextView;
 
