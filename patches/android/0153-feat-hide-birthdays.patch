diff --git a/TMessagesProj/src/main/java/tele/helpers/TeleListScreens.kt b/TMessagesProj/src/main/java/tele/helpers/TeleListScreens.kt
new file mode 100644
index 000000000..dda4b2aa6
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/TeleListScreens.kt
@@ -0,0 +1,17 @@
+package tele.helpers
+
+import org.telegram.ui.ActionBar.BaseFragment
+import java.util.Collections
+import java.util.WeakHashMap
+
+// Open screens that redraw themselves when a display option flips.
+object TeleListScreens {
+    private val screens: MutableSet<BaseFragment> = Collections.newSetFromMap(WeakHashMap())
+
+    @JvmStatic
+    fun track(screen: BaseFragment) {
+        synchronized(screens) { screens.add(screen) }
+    }
+
+    fun open(): List<BaseFragment> = synchronized(screens) { screens.toList() }
+}
