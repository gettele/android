+++ b/TMessagesProj/src/main/java/tele/helpers/TeleBirthdays.kt
@@ -0,0 +1,28 @@
+package tele.helpers
+
+import org.telegram.messenger.AccountInstance
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.NotificationCenter
+import org.telegram.messenger.UserConfig
+import org.telegram.ui.DialogsActivity
+import org.telegram.ui.ProfileActivity
+
+// Hides birthday banners, hints and effects; the birthday data itself stays untouched.
+object TeleBirthdays {
+    @JvmStatic
+    fun onToggled() {
+        AndroidUtilities.runOnUIThread {
+            // the gift button and its birthday hint re-check
+            for (account in 0 until UserConfig.MAX_ACCOUNT_COUNT) {
+                AccountInstance.getInstance(account).notificationCenter
+                    .postNotificationName(NotificationCenter.didUpdatePremiumGiftFieldIcon)
+            }
+            for (screen in TeleListScreens.open()) {
+                when (screen) {
+                    is DialogsActivity -> screen.tele_refreshHint()
+                    is ProfileActivity -> screen.tele_refreshBirthday()
+                }
+            }
+        }
+    }
+}
