From: tangenx <me@tangenx.dev>
Date: Fri, 16 Oct 2026 16:57:04 +0300
Subject: [PATCH] feat: show server verification badge in profiles

---
 .../java/org/telegram/ui/ProfileActivity.java    | 16 ++++++++++++++--
 .../src/main/java/tele/helpers/TeleBadges.kt     | 13 +++++++++++++
 2 files changed, 27 insertions(+), 2 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/ProfileActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/ProfileActivity.java
index 7d04140cd..e9d50e8b5 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/ProfileActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/ProfileActivity.java
@@ -11802,7 +11802,11 @@ public class ProfileActivity extends BaseFragment implements NotificationCenter.
                     nameTextView.setRightDrawable(null);
                     nameTextViewRightDrawableContentDescription = null;
                 }
-                if (leftIcon == null && currentEncryptedChat == null && user.bot_verification_icon != 0) {
+                final long teleIconId = copyFromChatActivity ? 0 : tele.helpers.TeleBadges.iconDocumentId(currentAccount, user.id);
+                if (leftIcon == null && currentEncryptedChat == null && teleIconId != 0) {
+                    nameTextView.setLeftDrawableOutside(true);
+                    leftIcon = getBotVerificationDrawable(teleIconId, false);
+                } else if (leftIcon == null && currentEncryptedChat == null && user.bot_verification_icon != 0) {
                     nameTextView.setLeftDrawableOutside(true);
                     leftIcon = getBotVerificationDrawable(user.bot_verification_icon, false);
                 } else {
@@ -12076,7 +12080,15 @@ public class ProfileActivity extends BaseFragment implements NotificationCenter.
                 } else {
                     nameTextView.setRightDrawable(null);
                 }
-                if (chat.bot_verification_icon != 0) {
+                long chatTeleIconId = 0;
+                if (ChatObject.isChannel(chat)) {
+                    long peerId = chat.id > 0 ? -(1000000000000L + chat.id) : chat.id;
+                    chatTeleIconId = tele.helpers.TeleBadges.iconDocumentId(currentAccount, peerId);
+                }
+                if (chatTeleIconId != 0) {
+                    nameTextView.setLeftDrawableOutside(true);
+                    nameTextView.setLeftDrawable(getBotVerificationDrawable(chatTeleIconId, false));
+                } else if (chat.bot_verification_icon != 0) {
                     nameTextView.setLeftDrawableOutside(true);
                     nameTextView.setLeftDrawable(getBotVerificationDrawable(chat.bot_verification_icon, false));
                 } else {
diff --git a/TMessagesProj/src/main/java/tele/helpers/TeleBadges.kt b/TMessagesProj/src/main/java/tele/helpers/TeleBadges.kt
index 6825f87ea..8ccdc7b0d 100644
--- a/TMessagesProj/src/main/java/tele/helpers/TeleBadges.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/TeleBadges.kt
@@ -274,6 +274,19 @@ object TeleBadges {
         markedUsers.add(pid)
     }
 
+    @JvmStatic
+    fun iconDocumentId(account: Int, peerId: Long): Long {
+        val p = peer(account, peerId) ?: return 0L
+        val icon = p.icon ?: return 0L
+        return runCatching { icon.toLong() }.getOrDefault(0L)
+    }
+
+    @JvmStatic
+    fun description(account: Int, peerId: Long): String? = peer(account, peerId)?.description
+
+    @JvmStatic
+    fun supportText(account: Int, peerId: Long): String? = peer(account, peerId)?.supportText
+
     @JvmStatic
     fun verifySelfCheck(): Boolean {
         val argon2 = com.lambdapioneer.argon2kt.Argon2Kt()
