+package tele.ui.settings
+
+import android.text.InputFilter
+import android.text.InputType
+import android.util.TypedValue
+import android.widget.FrameLayout
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.R
+import org.telegram.ui.ActionBar.AlertDialog
+import org.telegram.ui.ActionBar.BaseFragment
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Components.EditTextBoldCursor
+import org.telegram.ui.Components.LayoutHelper
+
+/** The input dialogs of tele: a themed field with the stock line, never a bare EditText. */
+object TeleDialog {
+
+    @JvmStatic
+    @JvmOverloads
+    fun input(
+        fragment: BaseFragment,
+        title: CharSequence,
+        value: String = "",
+        hint: String = "",
+        message: CharSequence? = null,
+        inputType: Int = InputType.TYPE_CLASS_TEXT,
+        maxLength: Int = 0,
+        positive: CharSequence = LocaleController.getString(R.string.Save),
+        onDone: (String) -> Unit
+    ) {
+        val context = fragment.parentActivity ?: return
+        val input = EditTextBoldCursor(context)
+        input.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 18f)
+        input.setTextColor(Theme.getColor(Theme.key_dialogTextBlack, fragment.resourceProvider))
+        input.setHintTextColor(Theme.getColor(Theme.key_dialogTextHint, fragment.resourceProvider))
+        input.setBackgroundDrawable(Theme.createEditTextDrawable(context, true))
+        input.setPadding(0, AndroidUtilities.dp(6f), 0, AndroidUtilities.dp(6f))
+        input.setSingleLine(true)
+        input.inputType = inputType
+        if (maxLength > 0) {
+            input.filters = arrayOf(InputFilter.LengthFilter(maxLength))
+        }
+        if (hint.isNotEmpty()) {
+            input.hint = hint
+        }
+        input.setText(value)
+        input.setSelection(input.text.length)
+        val holder = FrameLayout(context)
+        holder.setPadding(AndroidUtilities.dp(24f), 0, AndroidUtilities.dp(24f), 0)
+        holder.addView(input, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT.toFloat()))
+        val builder = AlertDialog.Builder(context, fragment.resourceProvider)
+            .setTitle(title)
+            .setView(holder)
+            .setPositiveButton(positive) { _, _ -> onDone(input.text.toString()) }
+            .setNegativeButton(LocaleController.getString(R.string.Cancel), null)
+        if (message != null) {
+            builder.setMessage(message)
+        }
+        builder.show()
+    }
+}
diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleScriptPage.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleScriptPage.kt
new file mode 100644
index 000000000..850fbc57e
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleScriptPage.kt
@@ -0,0 +1,151 @@
+package tele.ui.settings
+
+import android.graphics.Typeface
+import android.text.InputType
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.View
+import android.view.ViewGroup
+import android.widget.EditText
+import android.widget.LinearLayout
+import android.widget.ScrollView
+import android.widget.TextView
+import org.json.JSONArray
+import org.json.JSONObject
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.R
+import tele.scripting.ScriptFile
+import tele.scripting.ScriptRuntime
+import tele.scripting.Scripts
+import org.telegram.ui.ActionBar.AlertDialog
+import org.telegram.ui.ActionBar.BaseFragment
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Components.LayoutHelper
+import org.telegram.ui.Components.Switch
+
+/**
+ * The settings page a script registered: the rows it builds are drawn as a plain dialog, and every
+ * change is sent back to the script, which decides what to keep.
+ */
+object TeleScriptPage {
+
+    @JvmStatic
+    fun show(fragment: BaseFragment, account: Int, script: ScriptFile) {
+        val runtime = Scripts.runtime(account, script.id) ?: return
+        val context = fragment.parentActivity ?: return
+        val rows = runtime.settingsRows() ?: return
+        val title = runtime.settingsPageTitle() ?: script.name
+        val theme = fragment.resourceProvider
+        val scroll = ScrollView(context)
+        val column = LinearLayout(context)
+        column.orientation = LinearLayout.VERTICAL
+        column.setPadding(dp(20), dp(4), dp(20), dp(4))
+        scroll.addView(column, ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT))
+        for (index in 0 until rows.length()) {
+            val row = rows.optJSONObject(index) ?: continue
+            column.addView(view(fragment, runtime, account, script, row), ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT))
+        }
+        val dialog = AlertDialog.Builder(context, theme)
+            .setTitle(title)
+            .setView(scroll)
+            .setNegativeButton(LocaleController.getString(R.string.Close), null)
+            .create()
+        dialog.show()
+    }
+
+    private fun dp(value: Int): Int = AndroidUtilities.dp(value.toFloat())
+
+    private fun view(fragment: BaseFragment, runtime: ScriptRuntime, account: Int, script: ScriptFile, row: JSONObject): View {
+        val context = fragment.parentActivity ?: throw IllegalStateException()
+        val text = row.optString("text")
+        return when (row.optString("kind")) {
+            "header" -> label(context, text, 14, true, Theme.getColor(Theme.key_windowBackgroundWhiteBlueHeader, fragment.resourceProvider))
+            "notice" -> label(context, text, 14, false, Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2, fragment.resourceProvider))
+            "separator" -> {
+                val line = View(context)
+                line.setBackgroundColor(Theme.getColor(Theme.key_divider, fragment.resourceProvider))
+                line.layoutParams = LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, Math.max(1, dp(1)))
+                line
+            }
+            "check" -> {
+                val switch = Switch(context, fragment.resourceProvider)
+                switch.setChecked(row.optBoolean("value"), 2, false)
+                switch.setOnCheckedChangeListener { _, checked ->
+                    send(fragment, runtime, account, script, row.optInt("onChange"), JSONArray().put(checked))
+                }
+                rowView(context, text, switch, fragment)
+            }
+            "input" -> rowView(context, text, valueLabel(context, row.optString("value"), fragment), fragment).apply {
+                setOnClickListener {
+                    prompt(fragment, lc(text), row.optString("value"), InputType.TYPE_CLASS_TEXT, row.optInt("maxLength")) { value ->
+                        send(fragment, runtime, account, script, row.optInt("onChange"), JSONArray().put(value))
+                    }
+                }
+            }
+            "slider" -> rowView(context, text, valueLabel(context, formatNumber(row.optDouble("value")), fragment), fragment).apply {
+                setOnClickListener {
+                    val min = row.optDouble("min")
+                    val max = row.optDouble("max")
+                    prompt(fragment, lc(text), formatNumber(row.optDouble("value")), InputType.TYPE_CLASS_NUMBER or InputType.TYPE_NUMBER_FLAG_DECIMAL, 0) { value ->
+                        val next = value.trim().toDoubleOrNull()?.coerceIn(min, max)
+                        if (next != null) {
+                            send(fragment, runtime, account, script, row.optInt("onChange"), JSONArray().put(next))
+                        }
+                    }
+                }
+            }
+            "item", "button" -> rowView(context, text, valueLabel(context, row.optString("detail"), fragment), fragment).apply {
+                setOnClickListener { send(fragment, runtime, account, script, row.optInt("onClick"), JSONArray()) }
+            }
+            else -> label(context, "", 14, false, Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2, fragment.resourceProvider))
+        }
+    }
+
+    private fun send(fragment: BaseFragment, runtime: ScriptRuntime, account: Int, script: ScriptFile, callback: Int, args: JSONArray) {
+        if (callback != 0) {
+            runtime.dispatch(callback, "page", args)
+        }
+        // the script decides what the row shows now: close and open the page again on the next frame
+        fragment.parentActivity?.let { activity ->
+            AndroidUtilities.runOnUIThread({ show(fragment, account, script) }, 250)
+        }
+    }
+
+    private fun prompt(fragment: BaseFragment, title: String, current: String, inputType: Int, maxLength: Int, done: (String) -> Unit) {
+        TeleDialog.input(fragment, title, value = current, inputType = inputType, maxLength = maxLength, onDone = done)
+    }
+
+    private fun rowView(context: android.content.Context, text: String, trailing: View, fragment: BaseFragment): LinearLayout {
+        val row = LinearLayout(context)
+        row.orientation = LinearLayout.HORIZONTAL
+        row.gravity = Gravity.CENTER_VERTICAL
+        row.setPadding(0, dp(12), 0, dp(12))
+        row.addView(label(context, text, 16, false, Theme.getColor(Theme.key_windowBackgroundWhiteBlackText, fragment.resourceProvider)), LayoutHelper.createLinear(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f))
+        row.addView(trailing, LayoutHelper.createLinear(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT, 0f, 0, 0, 0, 0))
+        row.isClickable = true
+        return row
+    }
+
+    private fun valueLabel(context: android.content.Context, text: String, fragment: BaseFragment): TextView {
+        val view = TextView(context)
+        view.text = text
+        view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14f)
+        view.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlueText6, fragment.resourceProvider))
+        return view
+    }
+
+    private fun label(context: android.content.Context, text: String, size: Int, bold: Boolean, color: Int): TextView {
+        val view = TextView(context)
+        view.text = text
+        view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, size.toFloat())
+        view.setTextColor(color)
+        if (bold) view.setTypeface(AndroidUtilities.bold())
+        view.setPadding(0, dp(6), 0, dp(6))
+        return view
+    }
+
+    private fun formatNumber(value: Double): String = if (value == Math.floor(value)) value.toLong().toString() else value.toString()
+
+    private fun lc(text: String): String = tele.helpers.TeleLowercase.lc(text)
+}
