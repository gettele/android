+package tele.helpers
+
+import android.content.Context
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.ApplicationLoader
+import org.telegram.messenger.NotificationCenter
+import org.telegram.ui.ActionBar.Theme
+
+/** The in-app day and night switch, the same one the chat list toggle uses. */
+object TeleThemeMode {
+
+    @JvmStatic
+    fun isDark(): Boolean = Theme.getActiveTheme().isDark
+
+    @JvmStatic
+    fun setDark(dark: Boolean) {
+        val preferences = ApplicationLoader.applicationContext
+            .getSharedPreferences("themeconfig", Context.MODE_PRIVATE)
+        var day = preferences.getString("lastDayTheme", "Blue") ?: "Blue"
+        val dayInfo = Theme.getTheme(day)
+        if (dayInfo == null || dayInfo.isDark) day = "Blue"
+        var night = preferences.getString("lastDarkTheme", "Dark Blue") ?: "Dark Blue"
+        val nightInfo = Theme.getTheme(night)
+        if (nightInfo == null || !nightInfo.isDark) night = "Dark Blue"
+        val target = Theme.getTheme(if (dark) night else day) ?: return
+        AndroidUtilities.runOnUIThread {
+            NotificationCenter.getGlobalInstance()
+                .postNotificationName(NotificationCenter.needSetDayNightTheme, target, false, null, -1)
+        }
+    }
+}
