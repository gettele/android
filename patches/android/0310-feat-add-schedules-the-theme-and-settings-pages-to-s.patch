+/** The log of one script: a screen of monospace lines with their times, selectable, like the mtproto log. */
+class TeleScriptLogActivity(
+    private val account: Int,
+    private val scriptId: String,
+    private val scriptName: String
+) : BaseFragment() {
+
+    private var listView: RecyclerListView? = null
+    private var adapter: Adapter? = null
+    private var empty: TextView? = null
+    private val handler = Handler(Looper.getMainLooper())
+    private val tick = object : Runnable {
+        override fun run() {
+            refresh()
+            handler.postDelayed(this, 1000)
+        }
+    }
+
+    override fun createView(context: Context): View {
+        actionBar.setBackButtonImage(R.drawable.ic_ab_back)
+        actionBar.setAllowOverlayTitle(true)
+        actionBar.setTitle(lc(scriptName) + " · " + lc("log"))
+        actionBar.setActionBarMenuOnItemClick(object : ActionBar.ActionBarMenuOnItemClick() {
+            override fun onItemClick(id: Int) {
+                if (id == -1) {
+                    finishFragment()
+                } else if (id == 1) {
+                    Scripts.clearLog(account, scriptId)
+                    refresh()
+                }
+            }
+        })
+        actionBar.createMenu().addItem(1, R.drawable.msg_delete)
+
+        val content = FrameLayout(context)
+        content.setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundWhite, resourceProvider))
+        val list = RecyclerListView(context, resourceProvider)
+        list.layoutManager = LinearLayoutManager(context, LinearLayoutManager.VERTICAL, false)
+        list.setVerticalScrollBarEnabled(true)
+        list.setPadding(0, AndroidUtilities.dp(4f), AndroidUtilities.dp(12f), AndroidUtilities.dp(8f))
+        list.clipToPadding = false
+        list.adapter = Adapter().also { adapter = it }
+        content.addView(list, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.MATCH_PARENT.toFloat()))
+        listView = list
+        val none = TextView(context)
+        none.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14f)
+        none.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2, resourceProvider))
+        none.text = lc("The log is empty.")
+        none.gravity = Gravity.CENTER
+        none.visibility = View.GONE
+        content.addView(none, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT, Gravity.CENTER))
+        empty = none
+        refresh()
+        return content
+    }
+
+    override fun onResume() {
+        super.onResume()
+        handler.post(tick)
+    }
+
+    override fun onPause() {
+        super.onPause()
+        handler.removeCallbacks(tick)
+    }
+
+    override fun onFragmentDestroy() {
+        handler.removeCallbacks(tick)
+        super.onFragmentDestroy()
+    }
+
+    private fun refresh() {
+        val lines = Scripts.log(account, scriptId)
+        val atBottom = listView == null || listView!!.layoutManager == null ||
+            (listView!!.layoutManager as LinearLayoutManager).findLastVisibleItemPosition() >= (adapter?.itemCount ?: 0) - 2
+        adapter?.lines = lines
+        adapter?.notifyDataSetChanged()
+        empty?.visibility = if (lines.isEmpty()) View.VISIBLE else View.GONE
+        if (lines.isNotEmpty() && atBottom) {
+            listView?.scrollToPosition(lines.size - 1)
+        }
+    }
+
+    private inner class Adapter : RecyclerListView.SelectionAdapter() {
+
+        var lines: List<String> = emptyList()
+
+        override fun getItemCount(): Int = lines.size
+
+        override fun isEnabled(holder: RecyclerView.ViewHolder): Boolean = false
+
+        override fun onCreateViewHolder(parent: ViewGroup, viewType: Int): RecyclerView.ViewHolder {
+            val text = TextView(parent.context)
+            text.typeface = Typeface.MONOSPACE
+            text.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12f)
+            text.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText, resourceProvider))
+            text.setTextIsSelectable(true)
+            text.setPadding(AndroidUtilities.dp(12f), AndroidUtilities.dp(2f), AndroidUtilities.dp(4f), AndroidUtilities.dp(2f))
+            text.setLineSpacing(AndroidUtilities.dp(2f).toFloat(), 1f)
+            text.layoutParams = RecyclerView.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT)
+            return object : RecyclerView.ViewHolder(text) {}
+        }
+
+        override fun onBindViewHolder(holder: RecyclerView.ViewHolder, position: Int) {
+            val view = holder.itemView as TextView
+            val line = lines[position]
+            if (line.length > 10 && line[2] == ':' && line[5] == ':') {
+                val text = SpannableStringBuilder(line)
+                text.setSpan(
+                    ForegroundColorSpan(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2, resourceProvider)),
+                    0, 8, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE
+                )
+                view.text = text
+            } else {
+                view.text = line
+            }
+        }
+    }
+
+    private fun lc(text: String): String = tele.helpers.TeleLowercase.lc(text)
+}
