-        add(input.firstOrNull { it.kind == KIND_CHATS } ?: Slot(KIND_CHATS))
+        var chatsAdded = false
         for (slot in input) {
-            if (slot.kind == KIND_CHATS) continue
+            if (slot.kind == KIND_CHATS) {
+                if (!chatsAdded) {
+                    add(slot)
+                    chatsAdded = true
+                }
+                continue
+            }
             val valid = slot.kind in PAGE_KINDS || isTeleSettingsKind(slot.kind) || slot.kind == KIND_SAVED || slot.isActionShortcut ||
                 (slot.kind.startsWith(KIND_CHAT_PREFIX) && slot.dialogId != 0L) ||
                 (slot.isFolder && MessagesController.getInstance(account).dialogFiltersById.get(slot.filterId) != null) ||
                 (slot.isMiniApp && slot.botId > 0L)
             if (valid) add(slot)
         }
+        if (!chatsAdded) {
+            if (out.size >= MAX_SLOTS) {
+                out.removeAt(out.lastIndex)
+            }
+            out.add(0, Slot(KIND_CHATS))
+        }
         return out
     }
 
