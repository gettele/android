From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Wed, 21 Oct 2026 12:58:49 +0300
Subject: [PATCH 104/128] fix: clean the ignored list

---
 .../telegram/ui/Adapters/DialogsAdapter.java  |  4 +++
 .../tele/ui/settings/TelePeersActivity.kt     | 25 ++++++++++++++++---
 2 files changed, 26 insertions(+), 3 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Adapters/DialogsAdapter.java b/TMessagesProj/src/main/java/org/telegram/ui/Adapters/DialogsAdapter.java
index 690be0c3e..87d903641 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Adapters/DialogsAdapter.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Adapters/DialogsAdapter.java
@@ -1628,6 +1628,10 @@ public class DialogsAdapter extends RecyclerListView.SelectionAdapter implements
             if (array == null) {
                 array = new ArrayList<>();
             }
+            if (parentFragment instanceof tele.ui.settings.TelePeersActivity) {
+                // the ignored list holds people only, the ghost lists can hold any chat
+                array = ((tele.ui.settings.TelePeersActivity) parentFragment).filterUsers(array);
+            }
         }
 
         dialogsCount = array.size();
diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TelePeersActivity.kt b/TMessagesProj/src/main/java/tele/ui/settings/TelePeersActivity.kt
index d9af99278..d8b4c633d 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TelePeersActivity.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TelePeersActivity.kt
@@ -3,6 +3,7 @@ package tele.ui.settings
 import android.os.Bundle
 import android.view.View
 import org.telegram.messenger.DialogObject
+import org.telegram.tgnet.TLRPC
 import org.telegram.ui.DialogsActivity
 import tele.helpers.PrivacyRules
 
@@ -10,7 +11,7 @@ import tele.helpers.PrivacyRules
  * Picker of the fork privacy exceptions. It reuses the stock forward screen: the chat list with
  * the checkmarks and the bottom bar, so it looks like sending a message to several chats.
  */
-class TelePeersActivity(account: Int, private val mode: String) : DialogsActivity(argsFor()) {
+class TelePeersActivity(account: Int, private val mode: String) : DialogsActivity(argsFor(mode)) {
 
     private val account = account
 
@@ -35,6 +36,20 @@ class TelePeersActivity(account: Int, private val mode: String) : DialogsActivit
         return super.addOrRemoveSelectedDialog(did, cell)
     }
 
+    /** The picker of the ignored list shows people only, the ghost lists can hold any chat. */
+    fun filterUsers(dialogs: ArrayList<TLRPC.Dialog>): ArrayList<TLRPC.Dialog> {
+        val messagesController = org.telegram.messenger.AccountInstance.getInstance(account).getMessagesController()
+        val filtered = ArrayList<TLRPC.Dialog>()
+        for (dialog in dialogs) {
+            if (dialog is DialogsActivity.DialogsHeader) continue
+            // a chat or a channel has no user behind the dialog
+            if (messagesController.getUser(dialog.id) != null) {
+                filtered.add(dialog)
+            }
+        }
+        return filtered
+    }
+
     private fun currentSelection(): List<Long> {
         val peers = if (mode == MODE_IGNORE) {
             PrivacyRules.ignoredPeers(account)
@@ -73,10 +88,14 @@ class TelePeersActivity(account: Int, private val mode: String) : DialogsActivit
         const val MODE_GHOST_ALWAYS = "ghost_always"
         const val MODE_GHOST_NEVER = "ghost_never"
 
-        private fun argsFor(): Bundle {
+        private fun argsFor(mode: String): Bundle {
             val args = Bundle()
             args.putBoolean("onlySelect", true)
-            args.putInt("dialogsType", DialogsActivity.DIALOGS_TYPE_FORWARD)
+            // the ignored list holds people only, the ghost lists can hold any chat
+            args.putInt(
+                "dialogsType",
+                if (mode == MODE_IGNORE) DialogsActivity.DIALOGS_TYPE_USERS_ONLY else DialogsActivity.DIALOGS_TYPE_FORWARD
+            )
             // the alert string turns the screen into the multi select one: the checkmarks and the
             // bottom bar with the recipients count, like when a message is sent to several chats
             args.putString("selectAlertString", "Choose a chat")
