diff --git a/TMessagesProj/src/main/java/tele/helpers/MediaViewerInfo.kt b/TMessagesProj/src/main/java/tele/helpers/MediaViewerInfo.kt
new file mode 100644
index 000000000..1e212c6b3
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/MediaViewerInfo.kt
@@ -0,0 +1,56 @@
+package tele.helpers
+
+import android.text.SpannableStringBuilder
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.MessageObject
+import org.telegram.messenger.R
+import org.telegram.tgnet.TLRPC
+import tele.TeleConfig
+
+// the data center of the shown media, appended to the viewer subtitle like on the desktop
+object MediaViewerInfo {
+
+    private const val SEPARATOR = " · "
+
+    /** The subtitle of a chat media: the message date, then the media data center. */
+    @JvmStatic
+    fun subtitle(base: CharSequence?, message: MessageObject?): CharSequence? {
+        if (message == null || !TeleConfig.SHOW_DC.value) return base
+        val document = message.getDocument()
+        return append(base, dcLabel(if (document != null) document.dc_id else photoDc(message.getPhoto())))
+    }
+
+    /** The subtitle of a profile photo, whose own date is already shown. */
+    @JvmStatic
+    fun photoSubtitle(base: CharSequence?, photo: TLRPC.Photo?): CharSequence? {
+        if (photo == null || !TeleConfig.SHOW_DC.value) return base
+        return append(base, dcLabel(photoDc(photo)))
+    }
+
+    /** The story header subtitle with the data center of its media. */
+    @JvmStatic
+    fun storySubtitle(base: CharSequence?, media: TLRPC.MessageMedia?): CharSequence? {
+        if (media == null || base == null || !TeleConfig.SHOW_DC.value) return base
+        val document = media.document
+        return append(base, dcLabel(if (document != null) document.dc_id else photoDc(media.photo)))
+    }
+
+    private fun dcLabel(dc: Int): String? = if (dc == 0) null else LocaleController.formatString(R.string.TeleMediaDc, dc)
+
+    private fun append(text: CharSequence?, label: CharSequence?): CharSequence? {
+        if (label.isNullOrEmpty()) return text
+        if (text.isNullOrEmpty()) return label
+        if (text is String) return text + SEPARATOR + label
+        return SpannableStringBuilder(text).append(SEPARATOR).append(label)
+    }
+
+    private fun photoDc(photo: TLRPC.Photo?): Int {
+        if (photo == null) return 0
+        if (photo.dc_id != 0) return photo.dc_id
+        for (size in photo.sizes) {
+            val dc = size.location?.dc_id ?: 0
+            if (dc != 0) return dc
+        }
+        return 0
+    }
+}
