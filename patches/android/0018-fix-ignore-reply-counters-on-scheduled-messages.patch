Subject: [PATCH 018/128] fix: ignore reply counters on scheduled messages

---
 .../src/main/java/org/telegram/messenger/MessageObject.java   | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/MessageObject.java b/TMessagesProj/src/main/java/org/telegram/messenger/MessageObject.java
index b2eccc82f..d3d5c0114 100644
--- a/TMessagesProj/src/main/java/org/telegram/messenger/MessageObject.java
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/MessageObject.java
@@ -11626,7 +11626,7 @@ public class MessageObject {
     }
 
     public boolean hasReplies() {
-        return messageOwner.replies != null && messageOwner.replies.replies > 0;
+        return !scheduled && messageOwner.replies != null && messageOwner.replies.replies > 0;
     }
 
     public boolean canViewThread() {
@@ -11645,7 +11645,7 @@ public class MessageObject {
     }
 
     public int getRepliesCount() {
-        return messageOwner.replies != null ? messageOwner.replies.replies : 0;
+        return !scheduled && messageOwner.replies != null ? messageOwner.replies.replies : 0;
     }
 
     public boolean canEditMessage(TLRPC.Chat chat) {
