+    // the server never pairs an error with a suggestion, but names the fix in the error text
+    private fun repair(query: String, failed: Result): Result {
+        val error = failed.error ?: return failed
+        val match = DID_YOU_MEAN.find(error) ?: return failed
+        val (word, fix) = match.destructured
+        val at = query.indexOf(word, ignoreCase = true)
+        if (at < 0) return failed
+        val expression = query.replaceRange(at, at + word.length, fix)
+        val value = fetch(expression).value ?: return failed
+        return Result(null, error, null, expression, value)
+    }
