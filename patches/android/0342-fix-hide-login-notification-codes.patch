diff --git a/TMessagesProj_AppTests/src/androidTest/java/org/telegram/messenger/NotificationsLoginCodeTest.java b/TMessagesProj_AppTests/src/androidTest/java/org/telegram/messenger/NotificationsLoginCodeTest.java
