index 000000000..f8caf6617
--- /dev/null
+++ b/TMessagesProj_AppTests/src/androidTest/java/org/telegram/messenger/NotificationsLoginCodeTest.java
@@ -0,0 +1,137 @@
+package org.telegram.messenger;
+
+import org.junit.BeforeClass;
+import org.junit.Test;
+import org.telegram.tgnet.TLRPC;
+import org.telegram.tgnet.tl.TL_keyboard;
+
+import java.lang.reflect.Method;
+import java.util.concurrent.CountDownLatch;
+import java.util.concurrent.TimeUnit;
+
+import static org.junit.Assert.assertEquals;
+import static org.junit.Assert.assertFalse;
+import static org.junit.Assert.assertTrue;
+
+public class NotificationsLoginCodeTest {
+    @BeforeClass
+    public static void initializeApplication() throws Exception {
+        CountDownLatch ready = new CountDownLatch(1);
+        AndroidUtilities.runOnUIThread(() -> {
+            try {
+                ApplicationLoader.postInitApplication();
+            } finally {
+                ready.countDown();
+            }
+        });
+        assertTrue(ready.await(30, TimeUnit.SECONDS));
+    }
+
+    private MessageObject message(long dialogId, String body, boolean push) {
+        TLRPC.TL_message owner = new TLRPC.TL_message();
+        owner.id = 1;
+        owner.dialog_id = dialogId;
+        owner.peer_id = new TLRPC.TL_peerUser();
+        owner.peer_id.user_id = dialogId;
+        owner.from_id = owner.peer_id;
+        owner.message = body;
+        owner.date = (int) (System.currentTimeMillis() / 1000);
+        MessageObject message = new MessageObject(0, owner, body, "Telegram", null, false, false, false, false);
+        if (!push) message.localType = 0;
+        return message;
+    }
+
+    private boolean protectedMessage(MessageObject message) throws Exception {
+        Method method = NotificationsController.class.getDeclaredMethod("tele_isLoginCode", MessageObject.class);
+        method.setAccessible(true);
+        return (boolean) method.invoke(null, message);
+    }
+
+    private void assertHidden(MessageObject message) throws Exception {
+        NotificationsController controller = NotificationsController.getInstance(0);
+        String raw = message.messageOwner.message;
+        String hidden = LocaleController.getString(R.string.NotificationHiddenMessage);
+        String[] sender = {"previous sender"};
+        boolean[] preview = {true};
+        assertEquals(hidden, controller.getShortStringForMessage(message, sender, preview));
+        assertFalse(preview[0]);
+        assertEquals("Telegram", sender[0]);
+        Method summary = NotificationsController.class.getDeclaredMethod("getStringForMessage", MessageObject.class, boolean.class, boolean[].class, boolean[].class);
+        summary.setAccessible(true);
+        boolean[] hasText = {true};
+        preview[0] = true;
+        assertEquals(hidden, summary.invoke(controller, message, false, hasText, preview));
+        assertFalse(preview[0]);
+        assertFalse(hasText[0]);
+        assertEquals(raw, message.messageOwner.message);
+    }
+
+    @Test
+    public void serviceCodesAreHiddenWithoutLayoutOrSpoilerEntities() throws Exception {
+        for (long id : new long[]{777000, UserObject.VERIFY}) {
+            for (boolean push : new boolean[]{false, true}) {
+                for (String body : new String[]{"Login code: 86421", "Код входа: 86421", "Code: 864-210", "Code: 12345678"}) {
+                    MessageObject message = message(id, body, push);
+                    assertTrue(protectedMessage(message));
+                    assertHidden(message);
+                }
+            }
+        }
+    }
+
+    @Test
+    public void revealingSpoilersDoesNotRevealNotificationCodes() throws Exception {
+        MessageObject message = message(777000, "Login code: 86421", false);
+        message.spoilLoginCode();
+        message.isSpoilersRevealed = true;
+        assertHidden(message);
+    }
+
+    @Test
+    public void copyButtonCannotBypassHiddenText() throws Exception {
+        MessageObject message = message(777000, "Open the chat to sign in", true);
+        TLRPC.TL_replyInlineMarkup markup = new TLRPC.TL_replyInlineMarkup();
+        TL_keyboard.TL_keyboardInlineButtonRow row = new TL_keyboard.TL_keyboardInlineButtonRow();
+        TL_keyboard.TL_keyboardInlineButton button = new TL_keyboard.TL_keyboardInlineButton();
+        TL_keyboard.TL_inlineButtonTypeCopy copy = new TL_keyboard.TL_inlineButtonTypeCopy();
+        copy.copy_text = "86421";
+        button.text = "Copy 86421";
+        button.type = copy;
+        row.buttons.add(button);
+        markup.rows.add(row);
+        message.messageOwner.reply_markup = markup;
+        assertTrue(protectedMessage(message));
+        assertHidden(message);
+    }
+
+    @Test
+    public void popupPreviewCannotRevealCodes() throws Exception {
+        android.content.SharedPreferences preferences = ApplicationLoader.applicationContext.getSharedPreferences("login_code_notification_test", 0);
+        preferences.edit().putBoolean("custom_777000", true).putInt("popup_777000", 3).commit();
+        try {
+            java.util.ArrayList<MessageObject> popups = new java.util.ArrayList<>();
+            Method add = NotificationsController.class.getDeclaredMethod("addToPopupMessages", java.util.ArrayList.class, MessageObject.class, long.class, boolean.class, android.content.SharedPreferences.class);
+            add.setAccessible(true);
+            NotificationsController controller = NotificationsController.getInstance(0);
+            assertEquals(0, add.invoke(controller, popups, message(777000, "Login code: 86421", false), 777000L, false, preferences));
+            assertTrue(popups.isEmpty());
+            MessageObject ordinary = message(777000, "A new device signed in", false);
+            assertEquals(3, add.invoke(controller, popups, ordinary, 777000L, false, preferences));
+            assertEquals(ordinary, popups.get(0));
+        } finally {
+            preferences.edit().clear().commit();
+            ApplicationLoader.applicationContext.deleteSharedPreferences("login_code_notification_test");
+        }
+    }
+
+    @Test
+    public void ordinaryMessagesAndOtherChatsAreUnaffected() throws Exception {
+        assertFalse(protectedMessage(message(777000, "A new device signed in", false)));
+        assertFalse(protectedMessage(message(777000, "Telegram 13.2.2 is available", true)));
+        assertFalse(protectedMessage(message(12345, "Login code: 86421", true)));
+        MessageObject outgoing = message(777000, "86421", false);
+        outgoing.messageOwner.out = true;
+        assertFalse(protectedMessage(outgoing));
+        assertEquals("Login code: 86421", NotificationsController.getInstance(0).getShortStringForMessage(message(12345, "Login code: 86421", true), new String[1], new boolean[1]));
+    }
+}
