+    private static final java.util.regex.Pattern tele_loginCodePattern = java.util.regex.Pattern.compile("(?<![0-9-])[0-9][0-9-]{3,6}[0-9](?![0-9-])");
+
+    private static boolean tele_isLoginCode(MessageObject messageObject) {
+        if (messageObject == null || messageObject.messageOwner == null) return false;
+        TLRPC.Message owner = messageObject.messageOwner;
+        long dialogId = messageObject.getDialogId();
+        if (owner.out || owner.from_scheduled || (dialogId != 777000 && dialogId != UserObject.VERIFY)) return false;
+        if (owner.message != null && tele_loginCodePattern.matcher(owner.message).find()) return true;
+        if (messageObject.messageText != null && tele_loginCodePattern.matcher(messageObject.messageText).find()) return true;
+        if (owner.reply_markup instanceof TLRPC.TL_replyInlineMarkup) {
+            for (TL_keyboard.KeyboardInlineButtonRow row : ((TLRPC.TL_replyInlineMarkup) owner.reply_markup).rows) {
+                for (TL_keyboard.KeyboardInlineButton button : row.buttons) {
+                    TL_keyboard.TL_inlineButtonTypeCopy copy = TLKeyboardHelper.getType(button, TL_keyboard.TL_inlineButtonTypeCopy.class);
+                    if (copy != null && copy.copy_text != null && tele_loginCodePattern.matcher(copy.copy_text).find()) return true;
+                }
+            }
+        }
+        return false;
+    }
