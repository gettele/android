diff --git a/TMessagesProj/src/main/java/tele/helpers/TeleToast.kt b/TMessagesProj/src/main/java/tele/helpers/TeleToast.kt
new file mode 100644
index 000000000..f7740d112
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/TeleToast.kt
@@ -0,0 +1,34 @@
+package tele.helpers
+
+import org.telegram.messenger.UserConfig
+import tele.TeleConfig
+
+/**
+ * Logs the toasts and bulletins that the features of tele show in the notification center. A
+ * feature calls [log] next to its own show call; the toast itself is left as it was.
+ */
+object TeleToast {
+
+    private const val MERGE_MS = 10_000L
+    private val last = HashMap<String, Long>()
+
+    @JvmStatic
+    fun enabled(): Boolean = TeleNotices.enabled() && TeleConfig.NOTICES_TELE_TOASTS.value
+
+    /** [site] names the call site; the same site within 10 s stays one entry. */
+    @JvmStatic
+    @JvmOverloads
+    fun log(site: String, text: CharSequence?, title: String = "", account: Int = UserConfig.selectedAccount) {
+        if (!enabled() || text.isNullOrEmpty()) return
+        val now = System.currentTimeMillis()
+        // the key carries the start of the window, so a repeat inside it replaces the entry
+        val start = synchronized(last) {
+            val at = last[site]
+            if (at != null && now - at < MERGE_MS) at else now.also { last[site] = it }
+        }
+        TeleNotices.add(
+            account,
+            TeleNotice(kind = NoticeKind.TELE, title = title, text = text.toString(), key = "toast:$site:$start")
+        )
+    }
+}
