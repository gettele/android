@@ -963,6 +964,22 @@ public class EditTextCaption extends EditTextBoldCursor implements FloatingToolb
 
     @Override
     public boolean onTextContextMenuItem(int id) {
+        if (id == android.R.id.paste && tele.helpers.LinkRewrites.rewritePastedLinksEnabled()) {
+            ClipboardManager clipboard = (ClipboardManager) getContext().getSystemService(Context.CLIPBOARD_SERVICE);
+            ClipData clip = clipboard == null ? null : clipboard.getPrimaryClip();
+            CharSequence clipText = clip != null && clip.getItemCount() > 0 ? clip.getItemAt(0).coerceToText(getContext()) : null;
+            if (!TextUtils.isEmpty(clipText)) {
+                android.util.Pair<String, java.util.ArrayList<String>> rewritten = tele.helpers.LinkRewrites.applyToText(clipText.toString());
+                if (rewritten != null) {
+                    int start = Math.max(0, getSelectionStart());
+                    int end = Math.min(getText().length(), getSelectionEnd());
+                    setText(getText().replace(start, end, rewritten.first));
+                    setSelection(start + rewritten.first.length(), start + rewritten.first.length());
+                    Toast.makeText(getContext(), TextUtils.join("\n", rewritten.second), Toast.LENGTH_SHORT).show();
+                    return true;
+                }
+            }
+        }
         if (id == android.R.id.paste) {
             ClipboardManager clipboard = (ClipboardManager) getContext().getSystemService(Context.CLIPBOARD_SERVICE);
             ClipData clipData = clipboard.getPrimaryClip();
