diff --git a/TMessagesProj/src/main/java/tele/helpers/LinkRewrites.kt b/TMessagesProj/src/main/java/tele/helpers/LinkRewrites.kt
index aa0b9cfb6..f891ed816 100644
--- a/TMessagesProj/src/main/java/tele/helpers/LinkRewrites.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/LinkRewrites.kt
@@ -1,11 +1,189 @@
 package tele.helpers
 
+import org.json.JSONArray
+import org.json.JSONObject
+import tele.TeleConfig
+import tele.db.TeleDatabaseHelper
+
 object LinkRewrites {
 
+    const val TYPE_DOMAIN = "domain"
+    const val TYPE_PATTERN = "pattern"
+
+    class Rule(
+        val type: String,
+        val from: List<String> = emptyList(),
+        val to: List<String> = emptyList(),
+        val find: String = "",
+        val replace: String = "",
+        val random: Boolean = false
+    ) {
+        fun toJson(): JSONObject = JSONObject().apply {
+            put("type", type)
+            if (type == TYPE_DOMAIN) {
+                put("from", JSONArray(from))
+                put("to", JSONArray(to))
+                if (random) put("random", true)
+            } else {
+                put("find", find)
+                put("replace", replace)
+            }
+        }
+
+        fun summary(): String = if (type == TYPE_DOMAIN) {
+            from.joinToString(", ") + " → " + to.joinToString(", ")
+        } else {
+            find + " → " + replace
+        }
+    }
+
+    private const val KEY = "link_rewrite_rules"
+
+    private val URL_REGEX = Regex("https?://[^\\s<>\"']+")
+
     @JvmStatic
     fun usernameToLink(url: String): String {
         val trimmed = url.trim()
         val match = Regex("^@([a-zA-Z][a-zA-Z0-9_]{3,31})$").find(trimmed) ?: return url
         return "https://t.me/" + match.groupValues[1]
     }
+
+    @JvmStatic
+    fun rules(): List<Rule> {
+        val raw = TeleDatabaseHelper.get(KEY) ?: return emptyList()
+        val out = ArrayList<Rule>()
+        runCatching {
+            val array = JSONArray(raw)
+            for (i in 0 until array.length()) {
+                val obj = array.getJSONObject(i)
+                val type = obj.optString("type", TYPE_DOMAIN)
+                if (type == TYPE_PATTERN) {
+                    out.add(Rule(TYPE_PATTERN, find = obj.optString("find"), replace = obj.optString("replace")))
+                } else {
+                    out.add(Rule(
+                        TYPE_DOMAIN,
+                        from = toStringList(obj.optJSONArray("from")),
+                        to = toStringList(obj.optJSONArray("to")),
+                        random = obj.optBoolean("random", false)
+                    ))
+                }
+            }
+        }
+        return out
+    }
+
+    private fun toStringList(array: JSONArray?): List<String> {
+        if (array == null) return emptyList()
+        val out = ArrayList<String>()
+        for (i in 0 until array.length()) {
+            val value = array.optString(i).trim()
+            if (value.isNotEmpty()) out.add(value)
+        }
+        return out
+    }
+
+    @JvmStatic
+    fun saveRules(rules: List<Rule>) {
+        if (rules.isEmpty()) {
+            TeleDatabaseHelper.put(KEY, null)
+            return
+        }
+        val array = JSONArray()
+        rules.forEach { array.put(it.toJson()) }
+        TeleDatabaseHelper.put(KEY, array.toString())
+    }
+
+    @JvmStatic
+    fun rewritePastedLinksEnabled(): Boolean = TeleConfig.REWRITE_PASTED_LINKS.value
+
+    // returns the rewritten text and up to three change notes, or null when nothing matched
+    @JvmStatic
+    fun applyToText(text: String): android.util.Pair<String, java.util.ArrayList<String>>? {
+        if (!TeleConfig.REWRITE_PASTED_LINKS.value) return null
+        val rules = rules()
+        if (rules.isEmpty()) return null
+        val notes = ArrayList<String>()
+        val memo = HashMap<String, String>()
+        val result = URL_REGEX.replace(text) { match ->
+            val url = match.value
+            if (memo.containsKey(url)) return@replace memo[url]!!
+            val rewritten = applyRules(url, rules)
+            if (rewritten != null) {
+                memo[url] = rewritten
+                if (notes.size < 3) notes.add(url + " → " + rewritten)
+                rewritten
+            } else {
+                url
+            }
+        }
+        if (notes.isEmpty()) return null
+        return android.util.Pair(result, notes)
+    }
+
+    private fun applyRules(url: String, rules: List<Rule>): String? {
+        for (rule in rules) {
+            if (rule.type == TYPE_DOMAIN) {
+                applyDomains(url, rule)?.let { return it }
+            } else if (rule.find.isNotEmpty()) {
+                val rewritten = runCatching {
+                    val regex = Regex(rule.find, RegexOption.IGNORE_CASE)
+                    val match = regex.find(url) ?: return@runCatching null
+                    url.replaceRange(match.range, expand(rule.replace, match))
+                }.getOrNull()
+                if (rewritten != null) return rewritten
+            }
+        }
+        return null
+    }
+
+    private fun hostOf(url: String): Pair<Int, String>? {
+        val match = Regex("^https?://(?:[^/?#@\\s]*@)?([^/?#:@\\s]+)", RegexOption.IGNORE_CASE).find(url) ?: return null
+        var host = match.groupValues[1].lowercase().trimEnd('.')
+        runCatching { host = java.net.IDN.toASCII(host).lowercase() }
+        return match.groups[1]!!.range.first to host
+    }
+
+    private fun applyDomains(url: String, rule: Rule): String? {
+        if (rule.to.isEmpty()) return null
+        val (hostStart, host) = hostOf(url) ?: return null
+        for (domain in rule.from) {
+            val d = domain.lowercase()
+            var prefix = when {
+                host == d -> ""
+                host.endsWith(".$d") -> host.substring(0, host.length - d.length)
+                else -> continue
+            }
+            if (prefix == "www." || prefix == "m." || prefix == "mobile.") prefix = ""
+            val target = if (rule.random && rule.to.size > 1) rule.to[(url.hashCode() and 0x7fffffff) % rule.to.size] else rule.to.first()
+            val hostEnd = hostStart + host.length
+            return url.substring(0, hostStart) + prefix + target + url.substring(hostEnd)
+        }
+        return null
+    }
+
+    private fun expand(template: String, match: MatchResult): String {
+        val out = StringBuilder()
+        var i = 0
+        while (i < template.length) {
+            val ch = template[i]
+            if (ch == '$' && i + 1 < template.length) {
+                val next = template[i + 1]
+                if (next == '$') {
+                    out.append('$')
+                    i += 2
+                    continue
+                } else if (next.isDigit()) {
+                    val group = next - '0'
+                    if (group <= match.groupValues.size - 1) {
+                        out.append(match.groupValues[group])
+                    }
+                    i += 2
+                    continue
+                }
+            }
+            out.append(ch)
+            i++
+        }
+        return out.toString()
+    }
 }
