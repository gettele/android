+import org.telegram.ui.Components.BulletinFactory
+import tele.TeleConfig
+
+// send audio files as voice messages (tele 0157): decode, resample to 48k mono, encode with the voice recorder's opus encoder
+object AudioVoice {
+
+    private const val RATE = 48000
+    private const val FRAME = 960
+    private const val TIMEOUT_US = 10_000L
+    private const val SIZE_CHECK_FRAMES = 500
+
+    private val EXTENSIONS = setOf("mp3", "m4a", "ogg", "oga", "opus", "wav", "flac", "aac", "amr", "mka")
+
+    // the opus encoder is one per process, so only one conversion runs at a time
+    private val converting = AtomicBoolean(false)
+
+    class Job(
+        val account: Int,
+        val dialogId: Long,
+        val paths: List<String>,
+        val reply: MessageObject?,
+        val replyTop: MessageObject?,
+        val chatArgs: SendMessageChatArguments?,
+        val monoForumPeerId: Long,
+        val suggestion: MessageSuggestionParams?,
+        val payStars: Long
+    )
+
+    private enum class Failure { UNSUPPORTED, TOO_LONG, CANCELLED, FAILED }
+
+    private class Converted(val file: File, val document: TLRPC.TL_document)
+
+    private class Outcome(val result: Converted?, val failure: Failure?)
+
+    private class Cancel {
+        @Volatile
+        var requested = false
+    }
+
+    @JvmStatic
+    fun busy(): Boolean = converting.get()
+
+    @JvmStatic
+    fun isAudioPath(path: String?): Boolean {
+        if (path.isNullOrEmpty()) return false
+        val dot = path.lastIndexOf('.')
+        if (dot < 0 || dot == path.length - 1) return false
+        val ext = path.substring(dot + 1).lowercase()
+        if (ext in EXTENSIONS) return true
+        return MimeTypeMap.getSingleton().getMimeTypeFromExtension(ext)?.startsWith("audio/") == true
+    }
+
+    /** Audio files among the selected ones, the file must be there to be read. */
+    @JvmStatic
+    fun selectedPaths(audios: List<MessageObject>?, files: List<String?>?): ArrayList<String> {
+        val out = ArrayList<String>()
+        if (!TeleConfig.AUDIO_AS_VOICE.value) return out
+        audios?.forEach { message ->
+            val path = message.messageOwner?.attachPath
+            if (isAudioPath(path) && File(path!!).canRead()) out.add(path)
+        }
+        files?.forEach { path ->
+            if (isAudioPath(path) && File(path!!).canRead()) out.add(path)
+        }
+        return out
+    }
+
+    /** The voice may be sent only where a recorded one could be. */
+    @JvmStatic
+    fun canSend(chat: TLRPC.Chat?, userInfo: TLRPC.UserFull?): Boolean {
+        if (chat != null && !ChatObject.canSendVoice(chat)) return false
+        return userInfo == null || !userInfo.voice_messages_forbidden
+    }
+
+    private fun localFile(account: Int, message: MessageObject?): File? {
+        val document = message?.document ?: return null
+        val file = FileLoader.getInstance(account).getPathToAttach(document, true)
+        return if (file != null && file.canRead()) file else null
+    }
+
+    @JvmStatic
+    fun messagePaths(account: Int, message: MessageObject?): ArrayList<String> {
+        val out = ArrayList<String>()
+        localFile(account, message)?.let { out.add(it.absolutePath) }
+        return out
+    }
+
+    /** An audio message that is on the device, next to Delete. */
+    @JvmStatic
+    fun fillMenu(chat: ChatActivity, message: MessageObject, items: ArrayList<CharSequence>, icons: ArrayList<Int>, options: ArrayList<Int>) {
+        if (!TeleConfig.AUDIO_AS_VOICE.value || message.id <= 0 || message.scheduled || chat.isInScheduleMode) return
+        if (message.isVoice || message.isRoundVideo) return
+        val mime = message.document?.mime_type
+        if (!message.isMusic && mime?.startsWith("audio/") != true) return
+        if (!canSend(chat.currentChat, chat.currentUserInfo) || localFile(chat.currentAccount, message) == null) return
+        val at = options.indexOf(ChatActivity.OPTION_DELETE).let { if (it >= 0) it else options.size }
+        items.add(at, LocaleController.getString(R.string.TeleSendAsVoice))
+        icons.add(at, R.drawable.input_mic)
+        options.add(at, ChatActivity.tele_option_audio_voice)
+    }
+
+    @JvmStatic
+    fun run(fragment: BaseFragment, job: Job) {
+        val context = fragment.parentActivity ?: return
+        if (job.paths.isEmpty()) return
+        if (MediaController.getInstance().tele_isRecording()) {
+            error(fragment, "Finish the recording first.")
+            return
+        }
+        if (!converting.compareAndSet(false, true)) {
+            error(fragment, "Another audio file is still converting.")
+            return
+        }
+        val cancel = Cancel()
+        val progress = showProgress(fragment, context, cancel)
+        Thread {
+            var failure: Failure? = null
+            try {
+                for ((index, path) in job.paths.withIndex()) {
+                    if (cancel.requested) {
+                        failure = Failure.CANCELLED
+                        break
+                    }
+                    val outcome = convert(job.account, path, cancel) { fraction ->
+                        val total = (index + fraction) / job.paths.size
+                        AndroidUtilities.runOnUIThread { progress.update(total) }
+                    }
+                    val converted = outcome.result
+                    if (converted == null) {
+                        failure = outcome.failure
+                        if (failure != Failure.TOO_LONG) break
+                        AndroidUtilities.runOnUIThread { sendAsFile(job, path) }
+                        continue
+                    }
+                    AndroidUtilities.runOnUIThread { send(job, converted) }
+                }
+            } finally {
+                converting.set(false)
+            }
+            AndroidUtilities.runOnUIThread {
+                progress.hide()
+                when (failure) {
+                    Failure.UNSUPPORTED -> error(fragment, "This audio format can't be converted to a voice message.")
+                    Failure.TOO_LONG -> error(fragment, "Too long for a voice message, sent as a file.")
+                    Failure.FAILED -> error(fragment, "Couldn't convert the audio.")
+                    else -> {}
+                }
+            }
+        }.start()
+    }
+
+    private fun error(fragment: BaseFragment, text: String) {
+        BulletinFactory.of(fragment).createSimpleBulletin(R.raw.error, TeleLowercase.lc(text)).show()
+    }
+
+    private class Progress(val layout: Bulletin.ProgressLayout, val bulletin: Bulletin) {
+        fun update(value: Float) {
+            layout.setProgress(value.coerceIn(0.02f, 0.98f))
+        }
+
+        fun hide() {
+            bulletin.hide()
+        }
+    }
+
+    private fun showProgress(fragment: BaseFragment, context: Context, cancel: Cancel): Progress {
+        val provider = fragment.resourceProvider
+        val layout = Bulletin.ProgressLayout(context, provider)
+        layout.imageView.setImageResource(R.drawable.input_mic, 0xFFFFFFFF.toInt())
+        layout.textView.setText(TeleLowercase.lc("Converting audio\u2026"), false)
+        layout.setButton(
+            Bulletin.UndoButton(context, true, provider)
+                .setText(TeleLowercase.lc("Cancel"))
+                .setUndoAction { cancel.requested = true }
+        )
+        val bulletin = BulletinFactory.of(fragment).create(layout, -1)
+        bulletin.show()
+        return Progress(layout, bulletin)
+    }
+
+    private fun send(job: Job, converted: Converted) {
+        val params = SendMessagesHelper.SendMessageParams.of(
+            converted.document, null, converted.file.absolutePath, job.dialogId, job.reply, job.replyTop,
+            null, null, null, null, true, 0, 0, 0, null, null, false
+        )
+        params.sendMessageChatArguments = job.chatArgs
+        params.monoForumPeer = job.monoForumPeerId
+        params.suggestionParams = job.suggestion
+        params.payStars = job.payStars
+        SendMessagesHelper.getInstance(job.account).sendMessage(params)
+    }
+
+    // past the stock upload size the voice message isn't possible, the file goes as a document
+    private fun sendAsFile(job: Job, path: String) {
+        val caption: String? = null
+        val mime: String? = null
+        SendMessagesHelper.prepareSendingDocuments(
+            AccountInstance.getInstance(job.account),
+            arrayListOf(path), arrayListOf(path), null as ArrayList<Uri>?, caption, mime,
+            job.dialogId, job.reply, job.replyTop, null, null, null, true, 0, null,
+            job.chatArgs, 0L, false, job.payStars
+        )
+    }
+
+    private fun newVoiceDocument(account: Int): TLRPC.TL_document {
+        val document = TLRPC.TL_document()
+        document.file_reference = ByteArray(0)
+        document.dc_id = Int.MIN_VALUE
+        document.id = SharedConfig.getLastLocalId().toLong()
+        document.user_id = UserConfig.getInstance(account).getClientUserId()
+        document.mime_type = "audio/ogg"
+        SharedConfig.saveConfig()
+        return document
+    }
+
+    private fun convert(account: Int, path: String, cancel: Cancel, progress: (Float) -> Unit): Outcome {
+        val extractor = MediaExtractor()
+        var decoder: MediaCodec? = null
+        var file: File? = null
+        var encoding = false
+        var done = false
+        try {
+            try {
+                extractor.setDataSource(path)
+            } catch (e: Exception) {
+                FileLog.e(e)
+                return Outcome(null, Failure.UNSUPPORTED)
+            }
+            var track = -1
+            for (i in 0 until extractor.trackCount) {
+                if (extractor.getTrackFormat(i).getString(MediaFormat.KEY_MIME)?.startsWith("audio/") == true) {
+                    track = i
+                    break
+                }
+            }
+            if (track < 0) return Outcome(null, Failure.UNSUPPORTED)
+            extractor.selectTrack(track)
+            val format = extractor.getTrackFormat(track)
+            val mime = format.getString(MediaFormat.KEY_MIME) ?: return Outcome(null, Failure.UNSUPPORTED)
+            val durationUs = if (format.containsKey(MediaFormat.KEY_DURATION)) format.getLong(MediaFormat.KEY_DURATION) else 0L
+            decoder = try {
+                MediaCodec.createDecoderByType(mime).also {
+                    it.configure(format, null, null, 0)
+                    it.start()
+                }
+            } catch (e: Exception) {
+                FileLog.e(e)
+                return Outcome(null, Failure.UNSUPPORTED)
+            }
+
+            val document = newVoiceDocument(account)
+            val target = File(
+                FileLoader.getDirectory(FileLoader.MEDIA_DIR_AUDIO),
+                System.currentTimeMillis().toString() + "_" + FileLoader.getAttachFileName(document)
+            )
+            file = target
+            AutoDeleteMediaTask.lockFile(target)
+            val controller = MediaController.getInstance()
+            if (controller.tele_startRecord(target.path, RATE) == 0) return Outcome(null, Failure.FAILED)
+            encoding = true
+
+            val sink = Sink(controller)
+            val info = MediaCodec.BufferInfo()
+            var channels = if (format.containsKey(MediaFormat.KEY_CHANNEL_COUNT)) format.getInteger(MediaFormat.KEY_CHANNEL_COUNT) else 1
+            var rate = if (format.containsKey(MediaFormat.KEY_SAMPLE_RATE)) format.getInteger(MediaFormat.KEY_SAMPLE_RATE) else RATE
+            var float = false
+            var resampler = Resampler(rate)
+            var inputDone = false
+            var outputDone = false
+            var lastFraction = 0f
+            var checkedFrames = 0L
+            while (!outputDone) {
+                if (cancel.requested) return Outcome(null, Failure.CANCELLED)
+                if (!inputDone) {
+                    val index = decoder.dequeueInputBuffer(TIMEOUT_US)
+                    if (index >= 0) {
+                        val buffer = decoder.getInputBuffer(index)!!
+                        val size = extractor.readSampleData(buffer, 0)
+                        if (size < 0) {
+                            decoder.queueInputBuffer(index, 0, 0, 0, MediaCodec.BUFFER_FLAG_END_OF_STREAM)
+                            inputDone = true
+                        } else {
+                            val time = extractor.sampleTime
+                            decoder.queueInputBuffer(index, 0, size, time, 0)
+                            extractor.advance()
+                            if (durationUs > 0) {
+                                val fraction = (time.toFloat() / durationUs).coerceIn(0f, 1f)
+                                if (fraction - lastFraction >= 0.01f) {
+                                    lastFraction = fraction
+                                    progress(fraction)
+                                }
+                            }
+                        }
+                    }
+                }
+                val out = decoder.dequeueOutputBuffer(info, TIMEOUT_US)
+                if (out == MediaCodec.INFO_OUTPUT_FORMAT_CHANGED) {
+                    val changed = decoder.outputFormat
+                    if (changed.containsKey(MediaFormat.KEY_CHANNEL_COUNT)) channels = changed.getInteger(MediaFormat.KEY_CHANNEL_COUNT)
+                    if (changed.containsKey(MediaFormat.KEY_SAMPLE_RATE)) {
+                        val changedRate = changed.getInteger(MediaFormat.KEY_SAMPLE_RATE)
+                        if (changedRate != rate) {
+                            rate = changedRate
+                            resampler = Resampler(rate)
+                        }
+                    }
+                    float = changed.containsKey(MediaFormat.KEY_PCM_ENCODING) &&
+                        changed.getInteger(MediaFormat.KEY_PCM_ENCODING) == android.media.AudioFormat.ENCODING_PCM_FLOAT
+                } else if (out >= 0) {
+                    if (info.size > 0) {
+                        val buffer = decoder.getOutputBuffer(out)!!
+                        buffer.position(info.offset)
+                        buffer.limit(info.offset + info.size)
+                        buffer.order(ByteOrder.nativeOrder())
+                        val mono = toMono(buffer, channels.coerceAtLeast(1), float)
+                        if (!resampler.feed(mono, sink)) return Outcome(null, Failure.FAILED)
+                        if (sink.frames - checkedFrames >= SIZE_CHECK_FRAMES) {
+                            checkedFrames = sink.frames
+                            if (!FileLoader.checkUploadFileSize(account, target.length())) return Outcome(null, Failure.TOO_LONG)
+                        }
+                    }
+                    decoder.releaseOutputBuffer(out, false)
+                    if (info.flags and MediaCodec.BUFFER_FLAG_END_OF_STREAM != 0) outputDone = true
+                }
+            }
+            if (!sink.finish() || sink.samples == 0L) return Outcome(null, Failure.FAILED)
+            encoding = false
+            controller.tele_stopRecord()
+            if (!FileLoader.checkUploadFileSize(account, target.length())) return Outcome(null, Failure.TOO_LONG)
+
+            val attribute = TLRPC.TL_documentAttributeAudio()
+            attribute.voice = true
+            attribute.waveform = MediaController.getWaveform(target.absolutePath)
+            if (attribute.waveform != null) attribute.flags = attribute.flags or 4
+            attribute.duration = sink.samples / RATE.toDouble()
+            document.date = ConnectionsManager.getInstance(account).currentTime
+            document.size = target.length()
+            document.attributes.clear()
+            document.attributes.add(attribute)
+            done = true
+            progress(1f)
+            return Outcome(Converted(target, document), null)
+        } catch (e: Throwable) {
+            FileLog.e(e)
+            return Outcome(null, Failure.FAILED)
+        } finally {
+            if (encoding) MediaController.getInstance().tele_stopRecord()
+            try {
+                decoder?.stop()
+            } catch (ignore: Exception) {
+            }
+            decoder?.release()
+            extractor.release()
+            if (!done && file != null) {
+                AutoDeleteMediaTask.unlockFile(file)
+                file.delete()
+            }
+        }
+    }
+
+    private fun toMono(buffer: ByteBuffer, channels: Int, float: Boolean): FloatArray {
+        return if (float) {
+            val samples = buffer.asFloatBuffer()
+            FloatArray(samples.remaining() / channels).also { out ->
+                for (i in out.indices) {
+                    var sum = 0f
+                    for (c in 0 until channels) sum += samples.get()
+                    out[i] = sum / channels
+                }
+            }
+        } else {
+            val samples = buffer.asShortBuffer()
+            FloatArray(samples.remaining() / channels).also { out ->
+                for (i in out.indices) {
+                    var sum = 0
+                    for (c in 0 until channels) sum += samples.get()
+                    out[i] = sum / (32768f * channels)
+                }
+            }
+        }
+    }
+
+    /** Takes 48k mono samples and hands full opus frames to the encoder. */
+    private class Sink(private val controller: MediaController) {
+        private val frame = ByteBuffer.allocateDirect(FRAME * 2).order(ByteOrder.nativeOrder())
+        private var filled = 0
+        var frames = 0L
+            private set
+        var samples = 0L
+            private set
+
+        fun put(value: Float): Boolean {
+            frame.putShort((filled * 2), (value.coerceIn(-1f, 1f) * 32767f).toInt().toShort())
+            samples++
+            if (++filled < FRAME) return true
+            filled = 0
+            frames++
+            return controller.tele_writeFrame(frame, FRAME * 2) != 0
+        }
+
+        // the last frame must be a short one, it is the one that ends the stream
+        fun finish(): Boolean {
+            val pending = filled
+            if (pending == 0) {
+                frame.putShort(0, 0)
+                return controller.tele_writeFrame(frame, 2) != 0
+            }
+            return controller.tele_writeFrame(frame, pending * 2) != 0
+        }
+    }
+
+    /** Linear when it grows the rate, averaging when it shrinks it. */
+    private class Resampler(rate: Int) {
+        private val step = rate.toDouble() / RATE
+        private var position = 0.0
+        private var base = 0L
+        private var last = 0f
+        private var accumulator = 0.0
+        private var filled = 0.0
+
+        fun feed(input: FloatArray, sink: Sink): Boolean {
+            if (input.isEmpty()) return true
+            if (step == 1.0) {
+                for (value in input) if (!sink.put(value)) return false
+                return true
+            }
+            if (step < 1.0) return grow(input, sink)
+            return shrink(input, sink)
+        }
+
+        private fun grow(input: FloatArray, sink: Sink): Boolean {
+            val end = base + input.size
+            while (true) {
+                val index = position.toLong()
+                if (index + 1 >= end) break
+                val a = if (index < base) last else input[(index - base).toInt()]
+                val b = input[(index + 1 - base).toInt()]
+                val t = (position - index).toFloat()
+                if (!sink.put(a + (b - a) * t)) return false
+                position += step
+            }
+            last = input[input.size - 1]
+            base = end
+            return true
+        }
+
+        private fun shrink(input: FloatArray, sink: Sink): Boolean {
+            for (value in input) {
+                var remaining = 1.0
+                while (remaining > 1e-9) {
+                    val take = minOf(remaining, step - filled)
+                    accumulator += value * take
+                    filled += take
+                    remaining -= take
+                    if (step - filled <= 1e-9) {
+                        if (!sink.put((accumulator / step).toFloat())) return false
+                        accumulator = 0.0
+                        filled = 0.0
+                    }
+                }
+            }
+            return true
+        }
+    }
+}
