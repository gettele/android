From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: test <test@example.com>
Date: Sun, 8 Nov 2026 01:05:05 +0300
Subject: [PATCH] fix: stop location updates when live sharing ends

---
 .../messenger/GoogleLocationProvider.java     | 22 ++++++++++++-------
 1 file changed, 14 insertions(+), 8 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/GoogleLocationProvider.java b/TMessagesProj/src/main/java/org/telegram/messenger/GoogleLocationProvider.java
index 237f27e55..7353dabdb 100644
--- a/TMessagesProj/src/main/java/org/telegram/messenger/GoogleLocationProvider.java
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/GoogleLocationProvider.java
@@ -21,10 +21,13 @@ import com.google.android.gms.location.LocationSettingsRequest;
 import com.google.android.gms.location.LocationSettingsStatusCodes;
 import com.google.android.gms.location.SettingsClient;
 
+import java.util.concurrent.ConcurrentHashMap;
+
 @SuppressLint("MissingPermission")
 public class GoogleLocationProvider implements ILocationServiceProvider {
     private FusedLocationProviderClient locationProviderClient;
     private SettingsClient settingsClient;
+    private final ConcurrentHashMap<ILocationListener, LocationCallback> locationCallbacks = new ConcurrentHashMap<>();
 
     @Override
     public void init(Context context) {
@@ -49,22 +52,25 @@ public class GoogleLocationProvider implements ILocationServiceProvider {
 
     @Override
     public void requestLocationUpdates(ILocationRequest request, ILocationListener locationListener) {
-        locationProviderClient.requestLocationUpdates(((GoogleLocationRequest) request).request, new LocationCallback() {
+        final LocationCallback callback = new LocationCallback() {
             @Override
             public void onLocationResult(@NonNull LocationResult locationResult) {
                 locationListener.onLocationChanged(locationResult.getLastLocation());
             }
-        }, Looper.getMainLooper());
+        };
+        final LocationCallback previous = locationCallbacks.put(locationListener, callback);
+        if (previous != null) {
+            locationProviderClient.removeLocationUpdates(previous);
+        }
+        locationProviderClient.requestLocationUpdates(((GoogleLocationRequest) request).request, callback, Looper.getMainLooper());
     }
 
     @Override
     public void removeLocationUpdates(ILocationListener locationListener) {
-        locationProviderClient.removeLocationUpdates(new LocationCallback() {
-            @Override
-            public void onLocationResult(@NonNull LocationResult locationResult) {
-                locationListener.onLocationChanged(locationResult.getLastLocation());
-            }
-        });
+        final LocationCallback callback = locationCallbacks.remove(locationListener);
+        if (callback != null) {
+            locationProviderClient.removeLocationUpdates(callback);
+        }
     }
 
     @Override
