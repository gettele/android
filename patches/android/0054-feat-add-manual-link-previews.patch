+            manualWebPage = false;
         }
     }
 
     public boolean shouldSkipAutomaticLinkPreview() {
-        return "pasted".equals(tele.TeleConfig.LINK_PREVIEW_MODE.getValue()) && pastedServerLink;
+        String mode = tele.TeleConfig.LINK_PREVIEW_MODE.getValue();
+        if ("added".equals(mode) || manualWebPage) {
+            return true;
+        }
+        return "pasted".equals(mode) && pastedServerLink;
+    }
+
+    public void setManualWebPage(boolean value) {
+        manualWebPage = value;
+    }
+
+    public boolean isManualWebPage() {
+        return manualWebPage;
+    }
+
+    private void showTeleAddLinkPreviewDialog() {
+        if (parentFragment == null || parentFragment.getParentActivity() == null) {
+            return;
+        }
+        EditTextBoldCursor input = new EditTextBoldCursor(parentFragment.getParentActivity());
+        input.setSingleLine(true);
+        input.setTextIsSelectable(true);
+        input.setHint(LocaleController.getString(R.string.TeleLinkPreviewHint));
+        input.setLineColors(getThemedColor(Theme.key_windowBackgroundWhiteInputField), getThemedColor(Theme.key_windowBackgroundWhiteInputFieldActivated), getThemedColor(Theme.key_text_RedRegular));
+
+        LinearLayout container = new LinearLayout(parentFragment.getParentActivity());
+        container.setOrientation(LinearLayout.VERTICAL);
+        int pad = dp(20);
+        container.setPadding(pad, dp(12), pad, 0);
+        container.addView(input, new LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT));
+
+        AlertDialog.Builder builder = resourcesProvider != null
+                ? new AlertDialog.Builder(parentFragment.getParentActivity(), resourcesProvider)
+                : new AlertDialog.Builder(parentFragment.getParentActivity());
+        builder.setTitle(LocaleController.getString(R.string.TeleLinkPreviewTitle));
+        builder.setView(container);
+        builder.setPositiveButton(LocaleController.getString(R.string.Save), (dialog, which) -> {
+            String value = input.getText().toString().trim();
+            if (value.isEmpty()) {
+                return;
+            }
+            if (!value.contains("://")) {
+                value = "https://" + value;
+            }
+            manualWebPage = true;
+            parentFragment.teleAddCustomLinkPreview(value);
+        });
+        builder.setNegativeButton(LocaleController.getString(R.string.Cancel), null);
+        builder.show();
     }
 
     private void hideRecordedAudioPanel(boolean wasSent) {
