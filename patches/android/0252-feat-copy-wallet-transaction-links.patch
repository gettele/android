diff --git a/TMessagesProj/src/main/java/tele/helpers/WalletLinks.kt b/TMessagesProj/src/main/java/tele/helpers/WalletLinks.kt
new file mode 100644
index 000000000..d20b392e9
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/WalletLinks.kt
@@ -0,0 +1,25 @@
+package tele.helpers
+
+import android.util.Base64
+
+// the links to a wallet transaction on tonscan.org; the desktop client builds the same url (tele 0286)
+object WalletLinks {
+
+    private const val BASE = "https://tonscan.org/tx/"
+    private val HEX64 = Regex("[0-9a-fA-F]{64}")
+
+    @JvmStatic
+    fun transactionUrl(hash: String?): String? {
+        if (hash.isNullOrEmpty()) return null
+        if (HEX64.matches(hash)) return BASE + hash.lowercase()
+        val cleaned = hash.replace('-', '+').replace('_', '/')
+        val padded = cleaned + "=".repeat((4 - cleaned.length % 4) % 4)
+        val bytes = try {
+            Base64.decode(padded, Base64.DEFAULT)
+        } catch (e: IllegalArgumentException) {
+            return null
+        }
+        if (bytes.size != 32) return null
+        return BASE + bytes.joinToString("") { "%02x".format(it) }
+    }
+}
