From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Wed, 21 Oct 2026 23:19:31 +0300
Subject: [PATCH] feat: hide the gift button in the message field

---
 .../ui/Components/ChatActivityEnterView.java         | 12 +++++++++++-
 .../layouts/ChatActivityChannelButtonsLayout.java    |  4 ++++
 TMessagesProj/src/main/java/tele/TeleConfig.kt       |  2 ++
 TMessagesProj/src/main/java/tele/TeleHooks.kt        |  6 ++++++
 .../src/main/java/tele/ui/settings/TeleSearch.kt     |  1 +
 .../java/tele/ui/settings/TeleSettingsActivity.kt    |  3 +++
 6 files changed, 27 insertions(+), 1 deletion(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Components/ChatActivityEnterView.java b/TMessagesProj/src/main/java/org/telegram/ui/Components/ChatActivityEnterView.java
index 41050209f..34fdf566b 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Components/ChatActivityEnterView.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Components/ChatActivityEnterView.java
@@ -3734,7 +3734,7 @@ public class ChatActivityEnterView extends FrameLayout implements
     }
 
     private void createGiftButton() {
-        if (giftButton != null || parentFragment == null) {
+        if (giftButton != null || parentFragment == null || tele.TeleConfig.HIDE_GIFT_BUTTON.getValue()) {
             return;
         }
 
@@ -11148,6 +11148,16 @@ public class ChatActivityEnterView extends FrameLayout implements
 
     public void updateGiftButton(boolean animated) {
 
+        if (tele.TeleConfig.HIDE_GIFT_BUTTON.getValue()) {
+            if (birthdayHint != null) {
+                birthdayHint.hide();
+            }
+            if (giftButton != null) {
+                AndroidUtilities.updateViewVisibilityAnimated(giftButton, false);
+            }
+            return;
+        }
+
         final TLRPC.UserFull userInfo = getParentFragment() == null ? null : getParentFragment().getCurrentUserInfo();
         final TLRPC.UserFull myUserInfo = MessagesController.getInstance(currentAccount).getUserFull(UserConfig.getInstance(currentAccount).getClientUserId());
         final TLRPC.User user = getParentFragment() == null ? null : getParentFragment().getCurrentUser();
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Components/chat/layouts/ChatActivityChannelButtonsLayout.java b/TMessagesProj/src/main/java/org/telegram/ui/Components/chat/layouts/ChatActivityChannelButtonsLayout.java
index e2ef297a2..cbe0698b2 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Components/chat/layouts/ChatActivityChannelButtonsLayout.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Components/chat/layouts/ChatActivityChannelButtonsLayout.java
@@ -107,6 +107,10 @@ public class ChatActivityChannelButtonsLayout extends FrameLayout implements Fac
             return;
         }
 
+        if (buttonId == BUTTON_GIFT && tele.TeleConfig.HIDE_GIFT_BUTTON.getValue()) {
+            show = false;
+        }
+
         if (buttonHolders[buttonId] == null && !show) {
             return;
         }
diff --git a/TMessagesProj/src/main/java/tele/TeleConfig.kt b/TMessagesProj/src/main/java/tele/TeleConfig.kt
index 7a545a06d..b4d8ce34a 100644
--- a/TMessagesProj/src/main/java/tele/TeleConfig.kt
+++ b/TMessagesProj/src/main/java/tele/TeleConfig.kt
@@ -202,6 +202,8 @@ object TeleConfig {
     val SHOT = BoolItem("shot", false)
     @JvmField
     val SHOT_VIEW = StringItem("shot_view", "")
+    @JvmField
+    val HIDE_GIFT_BUTTON = BoolItem("hide_gift_button", false)
 
     private var prefs: SharedPreferences? = null
 
diff --git a/TMessagesProj/src/main/java/tele/TeleHooks.kt b/TMessagesProj/src/main/java/tele/TeleHooks.kt
index a3a1c1547..f030c23d0 100644
--- a/TMessagesProj/src/main/java/tele/TeleHooks.kt
+++ b/TMessagesProj/src/main/java/tele/TeleHooks.kt
@@ -114,6 +114,12 @@ object TeleHooks {
         if (item === TeleConfig.STREAMER_MODE) {
             org.telegram.ui.LaunchActivity.instance?.teleRefreshFlagSecure()
         }
+        if (item === TeleConfig.HIDE_GIFT_BUTTON) {
+            for (account in 0 until UserConfig.MAX_ACCOUNT_COUNT) {
+                AccountInstance.getInstance(account).getNotificationCenter()
+                    .postNotificationName(NotificationCenter.didUpdatePremiumGiftFieldIcon)
+            }
+        }
     }
 
     @JvmStatic
diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt
index 85a93db0b..7e1d357b9 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt
@@ -130,6 +130,7 @@ object TeleSearch {
             section(1105, "Screenshot of messages", "interface", TeleSettingsActivity.MODE_INTERFACE),
             section(1106, "Pick brush colors from the image", "interface", TeleSettingsActivity.MODE_INTERFACE),
             section(1109, "Attach media above the field (beta)", "sending", TeleSettingsActivity.MODE_SENDING),
+            section(1120, "Hide the gift button in the message field", "sending", TeleSettingsActivity.MODE_SENDING),
             section(GUID_UPDATES, "Update automatically", "updates", TeleSettingsActivity.MODE_ROOT),
             section(GUID_UPDATES + 1, "Check for updates", "updates", TeleSettingsActivity.MODE_ROOT),
             section(GUID_UPDATES + 2, "Show what's new after updates", "updates", TeleSettingsActivity.MODE_ROOT),
diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
index c88b869a5..59e4caa3b 100644
