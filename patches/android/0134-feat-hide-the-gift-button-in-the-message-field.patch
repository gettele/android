                 item.checked = checked
                 (view as TextCheckCell2).setChecked(checked)
                 TeleConfig.set(row.item, checked)
+                android.util.Log.d("TeleToggle", "key=${row.item.key} state=$checked")
                 if (row.item == TeleConfig.IGNORE_FADE) {
                     tele.helpers.PrivacyRules.setIgnoredModes(
                         UserConfig.selectedAccount,
@@ -355,6 +356,7 @@ class TeleSettingsActivity @JvmOverloads constructor(private val mode: String =
             "Forward protected messages as copies" to "Forward protected content as a fresh copy.",
             "Calculate messages starting with = via calcmula.app" to "Compute text prefixed with an equals sign using calcmula.app.",
             "Preview calcmula results while typing" to "Show a calculation preview before sending.",
+            "Hide the gift button in the message field" to "Hide the gift button in the field and the gift entry of a channel.",
             "Local names for people" to "Set names for people that only you can see.",
             "Keep deleted messages" to "Keep messages deleted for everyone in your local archive.",
             "Keep messages you delete yourself" to "Keep your own deleted messages in the local archive.",
@@ -557,6 +559,7 @@ class TeleSettingsActivity @JvmOverloads constructor(private val mode: String =
                 toggle("Forward protected messages as copies", TeleConfig.COPY_PROTECTED),
                 toggle("Calculate messages starting with = via calcmula.app", TeleConfig.CALCMULA),
                 toggle("Preview calcmula results while typing", TeleConfig.CALCMULA_PREVIEW),
+                toggle("Hide the gift button in the message field", TeleConfig.HIDE_GIFT_BUTTON),
                 Row(TYPE_SHADOW)
             )
             MODE_SERVER -> listOf(
