+++ b/TMessagesProj/src/main/java/tele/helpers/ThinBrush.kt
@@ -0,0 +1,21 @@
+package tele.helpers
+
+import org.telegram.ui.Components.Paint.Brush
+import tele.TeleConfig
+
+// lets the normal brush go thinner than the stock minimum; eraser, blur and shapes are untouched
+object ThinBrush {
+
+    private const val STOCK_MIN = 0.05f
+    // about 2px of a 1280px painting instead of 8px
+    private const val THIN_MIN = -0.048f
+
+    private fun normal(brush: Brush?) = brush !is Brush.Blurer && brush !is Brush.Eraser && brush !is Brush.Shape
+
+    @JvmStatic
+    fun min(brush: Brush?): Float = if (TeleConfig.THIN_BRUSH.value && normal(brush)) THIN_MIN else STOCK_MIN
+
+    /** Keeps a thin weight saved earlier from leaking into the stock range once the option is off. */
+    @JvmStatic
+    fun clamp(brush: Brush?, weight: Float): Float = if (normal(brush)) maxOf(weight, min(brush)) else weight
+}
