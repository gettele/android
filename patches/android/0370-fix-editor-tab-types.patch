+    private fun showStockSettingsPicker(anchor: View) {
+        if (slots.size >= MainTabsConfig.MAX_SLOTS) {
+            bulletin(lc("The bar holds six tabs."))
+            return
+        }
+        val options = ItemOptions.makeOptions(this, anchor)
+        for (stockKind in MainTabsConfig.STOCK_SETTINGS_KINDS) {
+            val kind = if (stockKind == MainTabsConfig.KIND_SETTINGS_FOLDERS) MainTabsConfig.KIND_FOLDERS else stockKind
+            if (slots.any { it.kind == kind }) continue
+            options.add(stockSettingsIcon(kind), localized(MainTabsConfig.titleResOf(stockKind))) {
+                addSlot(MainTabsConfig.Slot(kind))
+            }
+        }
+        options.setBlur(true)
+        options.translate(0f, -AndroidUtilities.dp(4f).toFloat())
+        val bg = Theme.createRoundRectDrawable(AndroidUtilities.dp(28f), Theme.getColor(Theme.key_windowBackgroundWhite, resourceProvider))
