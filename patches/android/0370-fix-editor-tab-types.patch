+        options.setScrimViewBackground(bg)
+        options.show()
+    }
+
+    private fun stockSettingsIcon(kind: String): Int = when (kind) {
+        MainTabsConfig.KIND_SETTINGS_NOTIFICATIONS -> R.drawable.settings_sounds
