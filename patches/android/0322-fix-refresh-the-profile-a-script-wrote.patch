From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: test <test@example.com>
Date: Mon, 9 Nov 2026 23:38:24 +0300
Subject: [PATCH] fix: refresh the profile a script wrote

---
 .../src/main/java/tele/scripting/ScriptTl.kt     | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/TMessagesProj/src/main/java/tele/scripting/ScriptTl.kt b/TMessagesProj/src/main/java/tele/scripting/ScriptTl.kt
index 1912795bd..9e719114b 100644
--- a/TMessagesProj/src/main/java/tele/scripting/ScriptTl.kt
+++ b/TMessagesProj/src/main/java/tele/scripting/ScriptTl.kt
@@ -49,6 +49,22 @@ object ScriptTl {
             ?: throw ScriptException("unsupported", "$method cannot be constructed")
         fill(instance, request, 0)
         val response = send(account, instance, alive)
+        if (response != null && method == "account.updateProfile") {
+            // the app keeps the bio of the current user: take the new one and let the server confirm it
+            try {
+                val current = org.telegram.messenger.UserConfig.getInstance(account).getCurrentUser()
+                if (current != null) {
+                    val about = request.optString("about", "")
+                    val controller = org.telegram.messenger.MessagesController.getInstance(account)
+                    val full = controller.getUserFull(current.id)
+                    if (full != null) {
+                        full.about = about
+                    }
+                    controller.loadFullUser(current, 0, true)
+                }
+            } catch (e: Throwable) {
+            }
+        }
         return if (response == null) null else json(response, 0)
     }
 
