diff --git a/TMessagesProj/src/main/java/tele/helpers/DeletedReply.kt b/TMessagesProj/src/main/java/tele/helpers/DeletedReply.kt
new file mode 100644
index 000000000..2b626b1d0
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/DeletedReply.kt
@@ -0,0 +1,137 @@
+package tele.helpers
+
+import android.text.TextUtils
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.ContactsController
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.MessageObject
+import org.telegram.messenger.MessagesController
+import org.telegram.messenger.R
+import org.telegram.tgnet.TLRPC
+import tele.TeleConfig
+import java.util.concurrent.ConcurrentHashMap
+
+object DeletedReply {
+    class QuoteResult(@JvmField val text: String, @JvmField val entities: ArrayList<TLRPC.MessageEntity>)
+    private val quotedKeys = ConcurrentHashMap<String, Boolean>()
+
+    @JvmStatic
+    fun quoteMode(): Boolean = TeleConfig.DELETED_REPLY.value == "quote"
+
+    @JvmStatic
+    fun isKeptReply(messageObject: MessageObject?): Boolean {
+        return messageObject != null && messageObject.messageOwner != null && DeletedMessages.isKept(messageObject)
+    }
+
+    @JvmStatic
+    fun skipReplyTo(messageObject: MessageObject?): Boolean {
+        return isKeptReply(messageObject) && !quoteMode()
+    }
+
+    @JvmStatic
+    fun keyFor(messageObject: MessageObject): String {
+        return messageObject.currentAccount.toString() + ":" + messageObject.getDialogId() + ":" + messageObject.getId()
+    }
+
+    @JvmStatic
+    fun alreadyQuoted(key: String): Boolean = quotedKeys.containsKey(key)
+
+    @JvmStatic
+    fun markQuoted(key: String) {
+        if (quotedKeys.isEmpty()) {
+            AndroidUtilities.runOnUIThread { quotedKeys.clear() }
+        }
+        quotedKeys[key] = true
+    }
+
+    private fun storedMessage(messageObject: MessageObject): TLRPC.Message? {
+        val id = messageObject.getId()
+        for (message in DeletedMessages.getAll(messageObject.currentAccount, messageObject.getDialogId())) {
+            if (message.id == id) return message
+        }
+        return null
+    }
+
+    private fun senderName(account: Int, message: TLRPC.Message?): String? {
+        if (message == null) return null
+        val controller = MessagesController.getInstance(account)
+        val userId = message.from_id?.user_id ?: 0L
+        if (userId != 0L) {
+            val user = controller.getUser(userId)
+            if (user != null) return ContactsController.formatName(user.first_name, user.last_name)
+        }
+        val chatId = message.from_id?.channel_id ?: message.from_id?.chat_id ?: 0L
+        if (chatId != 0L) {
+            val chat = controller.getChat(chatId)
+            if (chat != null) return chat.title
+        }
+        return null
+    }
+
+    private fun copyEntity(entity: TLRPC.MessageEntity, shift: Int): TLRPC.MessageEntity {
+        val copy = when (entity) {
+            is TLRPC.TL_messageEntityBold -> TLRPC.TL_messageEntityBold()
+            is TLRPC.TL_messageEntityItalic -> TLRPC.TL_messageEntityItalic()
+            is TLRPC.TL_messageEntityUnderline -> TLRPC.TL_messageEntityUnderline()
+            is TLRPC.TL_messageEntityStrike -> TLRPC.TL_messageEntityStrike()
+            is TLRPC.TL_messageEntitySpoiler -> TLRPC.TL_messageEntitySpoiler()
+            is TLRPC.TL_messageEntityCode -> TLRPC.TL_messageEntityCode()
+            is TLRPC.TL_messageEntityTextUrl -> TLRPC.TL_messageEntityTextUrl()
+            is TLRPC.TL_messageEntityMentionName -> TLRPC.TL_messageEntityMentionName()
+            is TLRPC.TL_messageEntityCustomEmoji -> TLRPC.TL_messageEntityCustomEmoji()
+            is TLRPC.TL_messageEntityPre -> TLRPC.TL_messageEntityPre()
+            is TLRPC.TL_messageEntityBlockquote -> TLRPC.TL_messageEntityBlockquote()
+            else -> null
+        } ?: return entity
+        copy.offset = entity.offset + shift
+        copy.length = entity.length
+        if (copy is TLRPC.TL_messageEntityTextUrl && entity is TLRPC.TL_messageEntityTextUrl) copy.url = entity.url
+        if (copy is TLRPC.TL_messageEntityMentionName && entity is TLRPC.TL_messageEntityMentionName) copy.user_id = entity.user_id
+        if (copy is TLRPC.TL_messageEntityCustomEmoji && entity is TLRPC.TL_messageEntityCustomEmoji) copy.document_id = entity.document_id
+        if (copy is TLRPC.TL_messageEntityPre && entity is TLRPC.TL_messageEntityPre) copy.language = entity.language
+        return copy
+    }
+
+    @JvmStatic
+    fun composeQuote(messageObject: MessageObject, quoteText: CharSequence?, ownText: String?, ownEntities: ArrayList<TLRPC.MessageEntity>?): QuoteResult? {
+        val account = messageObject.currentAccount
+        val stored = storedMessage(messageObject)
+        val name = senderName(account, stored)
+        val quotedText = if (!TextUtils.isEmpty(quoteText)) quoteText.toString() else if (stored != null && !TextUtils.isEmpty(stored.message)) stored.message else LocaleController.getString(R.string.TeleDeletedMessage)
+        val own = ownText ?: ""
+        val separator = if (own.isEmpty()) 0 else 1
+        val nameLength = if (name.isNullOrEmpty()) 0 else name.length + 1
+        val limit = MessagesController.getInstance(account).maxMessageLength
+        val available = limit - nameLength - own.length - separator
+        if (available < 2) return null
+        var quote = quotedText.trim()
+        if (quote.length > available) {
+            var length = available - 1
+            while (length > 0 && Character.isHighSurrogate(quote[length - 1])) length--
+            if (length <= 0) return null
+            quote = quote.substring(0, length) + "…"
+        }
+        val prefix = StringBuilder()
+        if (!name.isNullOrEmpty()) prefix.append(name).append('\n')
+        prefix.append(quote)
+        val text = if (own.isEmpty()) prefix.toString() else prefix.toString() + "\n" + own
+
+        val entities = ArrayList<TLRPC.MessageEntity>()
+        val blockquote = TLRPC.TL_messageEntityBlockquote()
+        blockquote.offset = 0
+        blockquote.length = prefix.length
+        entities.add(blockquote)
+        if (!name.isNullOrEmpty()) {
+            val bold = TLRPC.TL_messageEntityBold()
+            bold.offset = 0
+            bold.length = name.length
+            entities.add(bold)
+        }
+        if (!own.isEmpty()) {
+            val shift = prefix.length + 1
+            ownEntities?.forEach { entity -> entities.add(copyEntity(entity, shift)) }
+        }
+        entities.sortBy { it.offset }
+        return QuoteResult(text, entities)
+    }
+}
