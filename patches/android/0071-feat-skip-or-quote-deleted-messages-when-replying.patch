+    private fun chooseDeletedReply() {
+        val activity = parentActivity ?: return
+        val values = arrayOf("skip", "quote")
+        val labels = arrayOf("skip them", "quote them")
+        val builder = if (resourceProvider != null) AlertDialog.Builder(activity, resourceProvider) else AlertDialog.Builder(activity)
+        builder.setTitle("reply to deleted messages")
+        builder.setItems(labels) { _, which ->
+            TeleConfig.set(TeleConfig.DELETED_REPLY, values[which])
+            adapter?.refresh()
+        }
+        showDialog(builder.create())
+    }
+
     private fun sectionTitle(): String = when (mode) {
         MODE_INTERFACE -> "tele · interface"
         MODE_PRIVACY -> "tele · privacy"
@@ -104,6 +117,8 @@ class TeleSettingsActivity @JvmOverloads constructor(private val mode: String =
                 chooseLinkPreviewMode()
             } else if (row.type == TYPE_VALUE && row.item == TeleConfig.DELETED_MARKER) {
                 chooseDeletedMarker()
+            } else if (row.type == TYPE_VALUE && row.item == TeleConfig.DELETED_REPLY) {
+                chooseDeletedReply()
             } else if (row.type == TYPE_LINK || row.type == TYPE_LINK_ICON) {
                 when (row.mode) {
                     TeleNamesActivity.MODE_LOCAL -> presentFragment(TeleNamesActivity(TeleNamesActivity.MODE_LOCAL))
@@ -274,6 +289,7 @@ class TeleSettingsActivity @JvmOverloads constructor(private val mode: String =
