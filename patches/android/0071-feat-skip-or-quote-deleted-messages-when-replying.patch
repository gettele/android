@@ -4416,6 +4416,23 @@ public class SendMessagesHelper extends BaseController implements NotificationCe
             replyToMsg = replyQuote.message;
         }
 
+        if (replyToMsg != null && tele.helpers.DeletedReply.isKeptReply(replyToMsg)) {
+            String teleKey = tele.helpers.DeletedReply.keyFor(replyToMsg);
+            if (tele.helpers.DeletedReply.quoteMode() && !tele.helpers.DeletedReply.alreadyQuoted(teleKey)) {
+                tele.helpers.DeletedReply.QuoteResult teleQuote = tele.helpers.DeletedReply.composeQuote(replyToMsg, replyQuote != null ? replyQuote.getText() : null, message != null ? message : caption, entities);
+                if (teleQuote != null) {
+                    if (message != null) {
+                        message = teleQuote.text;
+                    } else {
+                        caption = teleQuote.text;
+                    }
+                    entities = teleQuote.entities;
+                    tele.helpers.DeletedReply.markQuoted(teleKey);
+                }
+            }
+            replyToMsg = null;
+        }
