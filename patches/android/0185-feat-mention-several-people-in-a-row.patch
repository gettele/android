+    private final RecyclerListView.OnItemLongClickListener tele_chainListener = (view, position) -> {
+        if (position == 0 || getAdapter().isBannedInline() || delegate == null) {
+            return false;
+        }
+        Object object = getAdapter().getItem(position - 1);
+        if (!(object instanceof TLRPC.User)) {
+            return false;
+        }
+        TLRPC.User user = (TLRPC.User) object;
+        if (tele.helpers.ChainMentions.isInlineBot(user)) {
+            mentionsOnItemClickListener.onItemClick(view, position);
+            return true;
+        }
+        delegate.replaceText(getAdapter().getResultStartPosition(), getAdapter().getResultLength(), tele.helpers.ChainMentions.insertion(user), false);
+        return true;
+    };
