+++ b/TMessagesProj/src/main/java/tele/helpers/ChainMentions.kt
@@ -0,0 +1,40 @@
+package tele.helpers
+
+import android.text.SpannableStringBuilder
+import android.text.Spanned
+import org.telegram.messenger.UserObject
+import org.telegram.tgnet.TLRPC
+import org.telegram.ui.Components.RecyclerListView
+import org.telegram.ui.Components.URLSpanUserMention
+import tele.TeleConfig
+
+/** Long-press on a mention suggestion inserts it and opens the list for the next one. */
+object ChainMentions {
+
+    @JvmStatic
+    fun enabled(): Boolean = TeleConfig.CHAIN_MENTIONS.value
+
+    // inline bots keep the stock flow: the mention starts the inline query
+    @JvmStatic
+    fun isInlineBot(user: TLRPC.User): Boolean = user.bot && user.bot_inline_placeholder != null
+
+    /** Sets the listener only while the option is on, so a held tap stays a plain tap otherwise. */
+    @JvmStatic
+    fun bind(list: RecyclerListView, listener: RecyclerListView.OnItemLongClickListener) {
+        list.setOnItemLongClickListener(if (enabled()) listener else null)
+    }
+
+    /** The mention itself followed by an opening `@` for the next one. */
+    @JvmStatic
+    fun insertion(user: TLRPC.User): CharSequence {
+        val username = UserObject.getPublicUsername(user)
+        if (username != null) {
+            return "@$username @"
+        }
+        val name = UserObject.getFirstName(user, false) + " "
+        val result = SpannableStringBuilder(name)
+        result.setSpan(URLSpanUserMention("" + user.id, 3), 0, name.length, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
+        result.append("@")
+        return result
+    }
+}
