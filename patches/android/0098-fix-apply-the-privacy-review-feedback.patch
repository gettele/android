     private fun ghostClass(account: Int, dialogId: Long, global: Boolean): Boolean {
         if (!TeleConfig.GHOST_PER_CHAT.value) {
-            return global
+            return global && TeleConfig.GHOST_MODE.value
         }
         return when (ghostMode(account, dialogId)) {
             GHOST_ALWAYS -> true
             GHOST_NEVER -> false
-            else -> global
+            else -> global && TeleConfig.GHOST_MODE.value
         }
     }
 
+    /** The global ghost switches only work while the ghost mode itself is on. */
+    @JvmStatic
+    fun ghostModeOn(): Boolean = TeleConfig.GHOST_MODE.value
+
+    /** The ignore button in the user profile. */
+    @JvmStatic
+    fun ignoreButtonEnabled(): Boolean = TeleConfig.IGNORE_BUTTON.value && TeleConfig.IGNORE_USERS.value
+
+    /** Ignores the peer from the profile: the messages of the peer are hidden completely. */
+    @JvmStatic
+    fun setIgnoredFromProfile(account: Int, dialogId: Long, ignore: Boolean) {
+        setIgnored(account, dialogId, if (ignore) MODE_HIDE else null)
+        tele.TeleHooks.onPrivacyRulesChanged()
+    }
+
     @JvmStatic
     fun ghostRead(account: Int, dialogId: Long): Boolean = ghostClass(account, dialogId, TeleConfig.GHOST_READ.value)
 
