@@ -486,7 +486,9 @@ object TeleSearch {
             section(1572, "Cut text from a screenshot", "menus", TeleSettingsActivity.MODE_MENUS, "Customize chat screenshots"),
             section(1573, "Change names in a picture", "menus", TeleSettingsActivity.MODE_MENUS, "Save messages as a picture"),
             section(1574, "Hide names in a picture", "menus", TeleSettingsActivity.MODE_MENUS, "Save messages as a picture"),
-            section(1634, "Archived chats swipe", "chats", TeleSettingsActivity.MODE_CHATS, "Turn off swipe to unarchive")
+            section(1634, "Archived chats swipe", "chats", TeleSettingsActivity.MODE_CHATS, "Turn off swipe to unarchive"),
+            section(1635, "volume key sound", "interface", TeleSettingsActivity.MODE_INTERFACE, "Volume keys don't unmute videos"),
+            section(1636, "autoplay video sound", "interface", TeleSettingsActivity.MODE_INTERFACE, "Volume keys don't unmute videos")
         ))
         // a page button and the screen it opens are the same result: the one with the page path wins
         val pageTitles = results.filter { it.path != null && it.path.size > 1 }.map { it.searchTitle.lowercase() }.toHashSet()
diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
