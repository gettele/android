@@ -1720,5 +1720,6 @@ object TeleTextUk {
         "Louder or quieter voice messages on this device; 100% is the system volume." to "Гучніше або тихіше голосові повідомлення на цьому пристрої; 100% — системна гучність.",
         "Louder or quieter round videos on this device; 100% is the system volume." to "Гучніше або тихіше кружечки на цьому пристрої; 100% — системна гучність.",
         "Turn off swipe to unarchive" to "Вимкнути змахування для розархівування",
+        "Volume keys don't unmute videos" to "Кнопки гучності не вмикають звук відео",
     )
 }
diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt
index af00c644e..afb6c5f16 100644
