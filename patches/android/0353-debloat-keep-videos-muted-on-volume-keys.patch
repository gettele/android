From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: test <test@example.com>
Date: Sun, 15 Nov 2026 16:57:39 +0300
Subject: [PATCH] debloat: keep videos muted on volume keys

---
 .../src/main/java/org/telegram/ui/LaunchActivity.java         | 2 +-
 TMessagesProj/src/main/java/tele/TeleConfig.kt                | 2 ++
 TMessagesProj/src/main/java/tele/helpers/TeleTextRu.kt        | 1 +
 TMessagesProj/src/main/java/tele/helpers/TeleTextUk.kt        | 1 +
 TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt    | 4 +++-
 .../src/main/java/tele/ui/settings/TeleSettingsActivity.kt    | 1 +
 6 files changed, 9 insertions(+), 2 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/LaunchActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/LaunchActivity.java
index 8d7a7be70..2b4300c35 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/LaunchActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/LaunchActivity.java
@@ -8787,7 +8787,7 @@ public class LaunchActivity extends BasePermissionsActivity implements INavigati
                         showVoiceChatTooltip(mute ? UndoView.ACTION_VOIP_SOUND_MUTED : UndoView.ACTION_VOIP_SOUND_UNMUTED);
                     }
                 }
-            } else if (!mainFragmentsStack.isEmpty() && (!PhotoViewer.hasInstance() || !PhotoViewer.getInstance().isVisible()) && event.getRepeatCount() == 0) {
+            } else if (!tele.TeleConfig.VOLUME_KEYS_KEEP_MUTED.getValue() && !mainFragmentsStack.isEmpty() && (!PhotoViewer.hasInstance() || !PhotoViewer.getInstance().isVisible()) && event.getRepeatCount() == 0) {
                 BaseFragment fragment = mainFragmentsStack.get(mainFragmentsStack.size() - 1);
                 if (fragment instanceof ChatActivity && !BaseFragment.hasSheets(fragment)) {
                     if (((ChatActivity) fragment).maybePlayVisibleVideo()) {
diff --git a/TMessagesProj/src/main/java/tele/TeleConfig.kt b/TMessagesProj/src/main/java/tele/TeleConfig.kt
index 73bb9a679..b7c327c56 100644
--- a/TMessagesProj/src/main/java/tele/TeleConfig.kt
+++ b/TMessagesProj/src/main/java/tele/TeleConfig.kt
@@ -517,6 +517,8 @@ object TeleConfig {
     @JvmField
     val INLINE_VOLUME_CONTROLS = BoolItem("inline_volume_controls", false)
     @JvmField
+    val VOLUME_KEYS_KEEP_MUTED = BoolItem("volume_keys_keep_muted", false)
+    @JvmField
     val COMPOSER_WRAP = BoolItem("composer_wrap", false)
     @JvmField
     val COMPOSER_AUTOPAIRS = BoolItem("composer_autopairs", false)
diff --git a/TMessagesProj/src/main/java/tele/helpers/TeleTextRu.kt b/TMessagesProj/src/main/java/tele/helpers/TeleTextRu.kt
index 65aa4d19e..5bf2e9206 100644
