@@ -1488,6 +1488,7 @@ class TeleSettingsActivity @JvmOverloads constructor(private val mode: String =
                 Row(TYPE_SHADOW),
                 Row(TYPE_HEADER, "Playback"),
                 toggle("Volume controls in the players", TeleConfig.INLINE_VOLUME_CONTROLS),
+                toggle("Volume keys don't unmute videos", TeleConfig.VOLUME_KEYS_KEEP_MUTED),
                 Row(TYPE_VALUE, "Music volume", subtitle = DESCRIPTIONS["Music volume"], value = tele.helpers.MediaVolumes.percent(tele.helpers.MediaVolumes.MUSIC), item = TeleConfig.MUSIC_VOLUME),
                 Row(TYPE_VALUE, "Video volume", subtitle = DESCRIPTIONS["Video volume"], value = tele.helpers.MediaVolumes.percent(tele.helpers.MediaVolumes.VIDEO), item = TeleConfig.VIDEO_VOLUME),
                 Row(TYPE_VALUE, "Voice message volume", subtitle = DESCRIPTIONS["Voice message volume"], value = tele.helpers.MediaVolumes.percent(tele.helpers.MediaVolumes.VOICE), item = TeleConfig.VOICE_VOLUME),
