@@ -1720,5 +1720,6 @@ object TeleTextRu {
         "Louder or quieter voice messages on this device; 100% is the system volume." to "Громче или тише голосовые сообщения на этом устройстве; 100% — системная громкость.",
         "Louder or quieter round videos on this device; 100% is the system volume." to "Громче или тише кружки на этом устройстве; 100% — системная громкость.",
         "Turn off swipe to unarchive" to "Отключить смахивание для разархивации",
+        "Volume keys don't unmute videos" to "Кнопки громкости не включают звук видео",
     )
 }
diff --git a/TMessagesProj/src/main/java/tele/helpers/TeleTextUk.kt b/TMessagesProj/src/main/java/tele/helpers/TeleTextUk.kt
index 4ef4935ee..585fc6631 100644
