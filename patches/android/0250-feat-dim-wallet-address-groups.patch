From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Tue, 3 Nov 2026 18:08:17 +0300
Subject: [PATCH] feat: dim wallet address groups

---
 .../java/org/telegram/ui/Wallet/WalletActivity.java | 13 ++++++++-----
 TMessagesProj/src/main/java/tele/TeleConfig.kt      |  2 ++
 .../src/main/java/tele/ui/settings/TeleSearch.kt    |  5 ++++-
 .../java/tele/ui/settings/TeleSettingsActivity.kt   |  4 ++++
 4 files changed, 18 insertions(+), 6 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Wallet/WalletActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/Wallet/WalletActivity.java
index 67cddb57b..8fdbaff5f 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Wallet/WalletActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Wallet/WalletActivity.java
@@ -116,6 +116,7 @@ import org.telegram.ui.Components.Bulletin;
 import org.telegram.ui.Components.BulletinFactory;
 import org.telegram.ui.Components.ColoredImageSpan;
 import org.telegram.ui.Components.CubicBezierInterpolator;
+import org.telegram.ui.Components.EllipsizeSpanAnimator;
 import org.telegram.ui.Components.DialogsActivityTopPanelLayout;
 import org.telegram.ui.Components.EditTextBoldCursor;
 import org.telegram.ui.Components.EdgeEffectTrackerFactory;
@@ -3394,18 +3395,20 @@ public class WalletActivity extends UniversalFragment implements NotificationCen
             return LocaleController.getString(R.string.WalletUnknown);
         }
         final SpannableStringBuilder formatted = new SpannableStringBuilder();
+        final boolean dim = tele.TeleConfig.DIM_WALLET_ADDRESS.value;
         int from = 0;
-        for (int i = 0, j = 0; i < address.length(); i++) {
+        int group = 0;
+        for (int i = 0; i < address.length(); i++) {
             if (i > 0 && i % 4 == 0) {
                 formatted.append(i % 16 == 0 ? '\n' : ' ');
-                if (i % 16 == 0) j++;
                 from = formatted.length();
             }
             formatted.append(address.charAt(i));
             if (i % 4 == 3) {
-//                if (j++ % 2 == 1) {
-//                    formatted.setSpan(new EllipsizeSpanAnimator.TextAlphaSpan(0.6f), from, formatted.length(), Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
-//                }
+                if (dim && (group / 4 + group % 4) % 2 == 1) {
+                    formatted.setSpan(new EllipsizeSpanAnimator.TextAlphaSpan(0.6f), from, formatted.length(), Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
+                }
+                group++;
                 from = formatted.length();
             }
         }
diff --git a/TMessagesProj/src/main/java/tele/TeleConfig.kt b/TMessagesProj/src/main/java/tele/TeleConfig.kt
index 02d7c770c..402e844f7 100644
--- a/TMessagesProj/src/main/java/tele/TeleConfig.kt
+++ b/TMessagesProj/src/main/java/tele/TeleConfig.kt
@@ -134,6 +134,8 @@ object TeleConfig {
     @JvmField
     val NO_MONEY = BoolItem("no_money", false)
     @JvmField
+    val DIM_WALLET_ADDRESS = BoolItem("dim_wallet_address", false)
+    @JvmField
     val WALLET_COPY_WORDS = BoolItem("wallet_copy_words", false)
     @JvmField
     val WALLET_PRIVATE_KEYS = BoolItem("wallet_private_keys", false)
diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt
index f73f961fa..5cff512dc 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt
@@ -436,7 +436,10 @@ object TeleSearch {
             section(1546, "Import wallets from private keys", "money", TeleSettingsActivity.MODE_MONEY),
             section(1547, "Copy wallet words", "money", TeleSettingsActivity.MODE_MONEY),
             section(1548, "Rotate the wallet phrase", "money", TeleSettingsActivity.MODE_MONEY, "Rotate the wallet phrase"),
-            section(1549, "Update the secret phrase", "money", TeleSettingsActivity.MODE_MONEY, "Rotate the wallet phrase")
+            section(1549, "Update the secret phrase", "money", TeleSettingsActivity.MODE_MONEY, "Rotate the wallet phrase"),
+            section(1550, "Dim wallet address groups", "money", TeleSettingsActivity.MODE_MONEY, "Dim wallet address groups"),
+            section(1551, "Dim every other address group", "money", TeleSettingsActivity.MODE_MONEY, "Dim wallet address groups"),
+            section(1552, "Address groups", "money", TeleSettingsActivity.MODE_MONEY, "Dim wallet address groups")
         ))
         return results.toTypedArray()
     }
diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
index a351319b7..032434226 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
@@ -1099,6 +1099,7 @@ class TeleSettingsActivity @JvmOverloads constructor(private val mode: String =
             "Console history" to "Remember the last console requests on this device.",
             "Report crashes without a dump" to "Say why a crash had no dump when it is sent.",
             "Turn off Money" to "Money is gone from the app, links and messages included.",
+            "Dim wallet address groups" to "Dims every other group of four in an address, like on iOS.",
             "Force the wallet" to "Show the money wallet even when the server has it off.",
             "Copy wallet words" to "A copy button on the secret phrase screen; the clipboard clears in a minute.",
             "Import wallets from private keys" to "Import a wallet from a raw ed25519 key instead of words.",
@@ -1650,6 +1651,9 @@ class TeleSettingsActivity @JvmOverloads constructor(private val mode: String =
                     rows.add(toggle("Import wallets from private keys", TeleConfig.WALLET_PRIVATE_KEYS))
                     rows.add(toggle("Copy wallet words", TeleConfig.WALLET_COPY_WORDS))
                     rows.add(toggle("Rotate the wallet phrase", TeleConfig.WALLET_ROTATE))
+                    rows.add(Row(TYPE_SHADOW))
+                    rows.add(Row(TYPE_HEADER, "Addresses and balances"))
+                    rows.add(toggle("Dim wallet address groups", TeleConfig.DIM_WALLET_ADDRESS))
                 }
                 rows.add(Row(TYPE_SHADOW))
                 rows
