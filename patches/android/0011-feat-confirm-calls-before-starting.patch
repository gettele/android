From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?t=CE=B1ngenx?= <me@tangenx.dev>
Date: Thu, 1 Oct 2026 19:47:54 +0300
Subject: [PATCH] feat: confirm calls before starting

---
 .../ui/Components/voip/VoIPHelper.java        |  9 +++++++
 .../src/main/java/tele/TeleConfig.kt          |  2 ++
 TMessagesProj/src/main/java/tele/TeleHooks.kt | 25 +++++++++++++++++++
 .../tele/ui/settings/TeleSettingsActivity.kt  |  3 ++-
 4 files changed, 38 insertions(+), 1 deletion(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Components/voip/VoIPHelper.java b/TMessagesProj/src/main/java/org/telegram/ui/Components/voip/VoIPHelper.java
index 1c4f424ad..108b19108 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Components/voip/VoIPHelper.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Components/voip/VoIPHelper.java
@@ -26,6 +26,10 @@ import org.telegram.messenger.AccountInstance;
 import org.telegram.messenger.AndroidUtilities;
 import org.telegram.messenger.ApplicationLoader;
 import org.telegram.messenger.BuildVars;
+import org.telegram.messenger.BuildVars;
+import org.telegram.messenger.UserObject;
+import tele.TeleConfig;
+import tele.TeleHooks;
 import org.telegram.messenger.ChatObject;
 import org.telegram.messenger.ContactsController;
 import org.telegram.messenger.DialogObject;
@@ -74,6 +78,11 @@ public class VoIPHelper {
 	private static final int VOIP_SUPPORT_ID = 4244000;
 
 	public static void startCall(TLRPC.User user, boolean videoCall, boolean canVideoCall, final Activity activity, TLRPC.UserFull userFull, AccountInstance accountInstance) {
+		if (TeleConfig.CONFIRM_CALLS.getValue() && !TeleHooks.isCallConfirmed()) {
+			TeleHooks.confirmCall(activity, UserObject.getUserName(user), () -> VoIPHelper.startCall(user, videoCall, canVideoCall, activity, userFull, accountInstance));
+			return;
+		}
+		TeleHooks.resetCallConfirmed();
 		if (accountInstance == null ? MessagesController.getInstance(UserConfig.selectedAccount).isFrozen() : accountInstance.getMessagesController().isFrozen()) {
 			AccountFrozenAlert.show(accountInstance == null ? UserConfig.selectedAccount : accountInstance.getCurrentAccount());
 			return;
diff --git a/TMessagesProj/src/main/java/tele/TeleConfig.kt b/TMessagesProj/src/main/java/tele/TeleConfig.kt
index ac859d13c..1846728b0 100644
--- a/TMessagesProj/src/main/java/tele/TeleConfig.kt
+++ b/TMessagesProj/src/main/java/tele/TeleConfig.kt
@@ -48,6 +48,8 @@ object TeleConfig {
     val HIDE_ALL_CHATS_FOLDER = BoolItem("hide_all_chats_folder", false)
     @JvmField
     val HIDE_CALL_BUTTONS = BoolItem("hide_call_buttons", false)
+    @JvmField
+    val CONFIRM_CALLS = BoolItem("confirm_calls", false)
 
     private var prefs: SharedPreferences? = null
 
diff --git a/TMessagesProj/src/main/java/tele/TeleHooks.kt b/TMessagesProj/src/main/java/tele/TeleHooks.kt
index b82f3546b..9574812eb 100644
--- a/TMessagesProj/src/main/java/tele/TeleHooks.kt
+++ b/TMessagesProj/src/main/java/tele/TeleHooks.kt
@@ -1,6 +1,9 @@
 package tele
 
+import android.app.Activity
 import android.content.Context
+import org.telegram.messenger.R
+import org.telegram.ui.ActionBar.AlertDialog
 import tele.db.TeleDatabaseHelper
 
 object TeleHooks {
@@ -17,4 +20,26 @@ object TeleHooks {
         } else {
             if (is24Hour) "HH:mm" else "h:mm a"
         }
+
+    private var callConfirmed = false
+
+    @JvmStatic
+    fun isCallConfirmed(): Boolean = callConfirmed
+
+    @JvmStatic
+    fun resetCallConfirmed() {
+        callConfirmed = false
+    }
+
+    @JvmStatic
+    fun confirmCall(activity: Activity, name: String?, onConfirm: Runnable) {
+        callConfirmed = true
+        AlertDialog.Builder(activity)
+            .setTitle("confirm call")
+            .setMessage(name)
+            .setPositiveButton(org.telegram.messenger.LocaleController.getString(R.string.OK)) { _, _ -> onConfirm.run() }
+            .setNegativeButton(org.telegram.messenger.LocaleController.getString(R.string.Cancel), null)
+            .setOnDismissListener { callConfirmed = false }
+            .show()
+    }
 }
diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
index af759a16f..a81e68c8f 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
@@ -69,7 +69,8 @@ class TeleSettingsActivity : BaseFragment() {
             Row(TYPE_HEADER, "interface"),
             Row(TYPE_TOGGLE, "show seconds in message times", item = TeleConfig.SHOW_SECONDS),
             Row(TYPE_TOGGLE, "hide the all chats folder", item = TeleConfig.HIDE_ALL_CHATS_FOLDER),
-            Row(TYPE_TOGGLE, "hide call buttons", item = TeleConfig.HIDE_CALL_BUTTONS)
+            Row(TYPE_TOGGLE, "hide call buttons", item = TeleConfig.HIDE_CALL_BUTTONS),
+            Row(TYPE_TOGGLE, "confirm calls before starting", item = TeleConfig.CONFIRM_CALLS)
         )
 
         override fun getItemCount(): Int = rows.size
