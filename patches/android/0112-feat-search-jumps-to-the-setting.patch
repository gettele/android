-            section(GUID_INTERFACE + 6, "Show names instead of phone numbers", "interface", TeleSettingsActivity.MODE_INTERFACE),
+            section(GUID_INTERFACE + 6, "Show names instead of phone numbers", "interface", TeleSettingsActivity.MODE_INTERFACE, "Show names instead of phone numbers in chat headers"),
             section(GUID_INTERFACE + 7, "Reveal spoilers automatically", "interface", TeleSettingsActivity.MODE_INTERFACE),
             section(GUID_INTERFACE + 8, "Hide mention and reaction badges", "interface", TeleSettingsActivity.MODE_INTERFACE),
             section(GUID_INTERFACE + 9, "Turn off animated userpics", "interface", TeleSettingsActivity.MODE_INTERFACE),
@@ -115,8 +115,8 @@ object TeleSearch {
             section(GUID_SENDING + 7, "Forward protected messages as copies", "sending", TeleSettingsActivity.MODE_SENDING),
             section(GUID_SERVER, "tele server", "server", TeleSettingsActivity.MODE_SERVER),
             section(GUID_SERVER + 1, "Server url", "server", TeleSettingsActivity.MODE_SERVER),
-            section(GUID_SERVER + 2, "Refresh server data now", "server", TeleSettingsActivity.MODE_SERVER),
-            section(GUID_SERVER + 3, "Clear cached server data", "server", TeleSettingsActivity.MODE_SERVER),
+            section(GUID_SERVER + 2, "Refresh server data now", "server", TeleSettingsActivity.MODE_SERVER, "Refresh now"),
+            section(GUID_SERVER + 3, "Clear cached server data", "server", TeleSettingsActivity.MODE_SERVER, "Clear cached data"),
             section(GUID_SERVER + 4, "Usernames from the server", "server", TeleSettingsActivity.MODE_SERVER),
             section(GUID_SERVER + 5, "Send crash reports", "server", TeleSettingsActivity.MODE_SERVER),
             section(GUID_SERVER + 6, "Badges next to names in messages", "interface", TeleSettingsActivity.MODE_INTERFACE),
@@ -125,7 +125,7 @@ object TeleSearch {
             section(1100, "Calculate messages starting with = via calcmula.app", "sending", TeleSettingsActivity.MODE_SENDING),
             section(1101, "Preview calcmula results while typing", "sending", TeleSettingsActivity.MODE_SENDING),
             section(1102, "Save messages as a picture", "interface", TeleSettingsActivity.MODE_INTERFACE),
-            section(1103, "shot", "interface", TeleSettingsActivity.MODE_INTERFACE),
+            section(1103, "shot", "interface", TeleSettingsActivity.MODE_INTERFACE, "Save messages as a picture"),
             section(1104, "Messages as an image", "interface", TeleSettingsActivity.MODE_INTERFACE),
             section(1105, "Screenshot of messages", "interface", TeleSettingsActivity.MODE_INTERFACE),
             section(1106, "Pick brush colors from the image", "interface", TeleSettingsActivity.MODE_INTERFACE),
diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
index 6f4cfb206..9f91cb051 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
@@ -26,7 +26,7 @@ import tele.Item
 import tele.TeleHooks
 import tele.TeleConfig
 
-class TeleSettingsActivity @JvmOverloads constructor(private val mode: String = MODE_ROOT) : BaseFragment() {
+class TeleSettingsActivity @JvmOverloads constructor(private val mode: String = MODE_ROOT, private val jumpTo: String? = null) : BaseFragment() {
 
     private class Row(
         val type: Int,
@@ -44,6 +44,10 @@ class TeleSettingsActivity @JvmOverloads constructor(private val mode: String =
     private var rows: List<Row> = emptyList()
     private var screenContext: Context? = null
 
+    /** The row the search points to: the stock jumps to it by this field name. */
+    @JvmField
+    var teleSearchRow = -1
+
     private fun chooseLinkPreviewMode() {
         val activity = parentActivity ?: return
         val values = arrayOf("all", "pasted", "added")
@@ -131,6 +135,8 @@ class TeleSettingsActivity @JvmOverloads constructor(private val mode: String =
 
     override fun createView(context: Context): View {
         screenContext = context
+        // the search opens the section on the row it points to
+        teleSearchRow = jumpTo?.let { title -> buildRows(mode).indexOfFirst { it.title == title } } ?: -1
         actionBar.setBackButtonImage(R.drawable.ic_ab_back)
         actionBar.setAllowOverlayTitle(true)
         actionBar.setTitle(sectionTitle())
