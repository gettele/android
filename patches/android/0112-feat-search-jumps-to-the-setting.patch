 .../src/main/java/tele/ui/settings/TeleSearch.kt   | 14 +++++++-------
 .../java/tele/ui/settings/TeleSettingsActivity.kt  |  8 +++++++-
 2 files changed, 14 insertions(+), 8 deletions(-)

diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt
index f2e439f3d..85a93db0b 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt
@@ -22,9 +22,9 @@ object TeleSearch {
     private fun entries(fragment: BaseFragment): Array<ProfileActivity.SearchAdapter.SearchResult> {
         val icon = R.drawable.tele_settings_icon
 
-        fun section(guid: Int, title: String, path: String, mode: String) =
-            ProfileActivity.SearchAdapter.SearchResult(guid, title, null, "tele", path, icon) {
-                fragment.presentFragment(TeleSettingsActivity(mode))
+        fun section(guid: Int, title: String, path: String, mode: String, jumpTo: String = title) =
+            ProfileActivity.SearchAdapter.SearchResult(guid, title, "teleSearchRow", "tele", path, icon) {
+                fragment.presentFragment(TeleSettingsActivity(mode, jumpTo))
             }
 
         fun screen(guid: Int, title: String, factory: () -> BaseFragment) =
@@ -39,7 +39,7 @@ object TeleSearch {
             section(GUID_INTERFACE + 3, "Hide call buttons", "interface", TeleSettingsActivity.MODE_INTERFACE),
