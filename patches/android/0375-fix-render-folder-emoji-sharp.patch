From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: test <test@example.com>
Date: Wed, 25 Nov 2026 08:33:03 +0300
Subject: [PATCH] fix: render folder emoji sharp

---
 .../ui/Components/FilterTabsView.java         | 26 ++++++++++++++++++-
 1 file changed, 25 insertions(+), 1 deletion(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Components/FilterTabsView.java b/TMessagesProj/src/main/java/org/telegram/ui/Components/FilterTabsView.java
index 7708f9434..48ac546b5 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Components/FilterTabsView.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Components/FilterTabsView.java
@@ -30,6 +30,7 @@ import android.graphics.drawable.Drawable;
 import android.graphics.drawable.GradientDrawable;
 import android.os.SystemClock;
 import android.text.Layout;
+import android.text.Spannable;
 import android.text.SpannableStringBuilder;
 import android.text.StaticLayout;
 import android.text.TextPaint;
@@ -133,6 +134,7 @@ public class FilterTabsView extends FrameLayout {
         }
 
         public int getWidth(boolean store) {
+            tele_rebuildIcon();
             int width = titleWidth = (int) Math.ceil(HintView2.measureCorrectly(title, textPaint));
             int c;
             if (store) {
@@ -175,11 +177,33 @@ public class FilterTabsView extends FrameLayout {
 
         // icon-only folders: the icon is the title, the real title stays for accessibility
         public CharSequence tele_label;
+        private String tele_emoji;
+        private int tele_emojiSize;
+
+        private void tele_rebuildIcon() {
+            if (tele_emoji == null) {
+                return;
+            }
+            int size = Math.max(1, Math.round(textPaint.getTextSize()));
+            if (size == tele_emojiSize) {
+                return;
+            }
+            title = Emoji.replaceEmoji(tele_emoji, textPaint.getFontMetricsInt(), true);
+            if (title instanceof Spannable) {
+                Emoji.EmojiSpan[] spans = ((Spannable) title).getSpans(0, title.length(), Emoji.EmojiSpan.class);
+                for (Emoji.EmojiSpan span : spans) {
+                    span.size = size;
+                }
+            }
+            tele_emojiSize = size;
+        }
 
         public void tele_setIcon(String emoji) {
             allTabsWidth -= getWidth(false) + dp(TAB_PADDING_WIDTH);
             tele_label = title;
-            title = Emoji.replaceEmoji(emoji, textPaint.getFontMetricsInt(), false);
+            tele_emoji = emoji;
+            tele_emojiSize = 0;
+            tele_rebuildIcon();
             allTabsWidth += getWidth(false) + dp(TAB_PADDING_WIDTH);
         }
 
