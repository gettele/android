From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: test <test@example.com>
Date: Wed, 25 Nov 2026 08:34:21 +0300
Subject: [PATCH] [money] hide gift offers

---
 .../src/main/java/org/telegram/ui/Stars/StarGiftSheet.java      | 2 +-
 TMessagesProj/src/main/java/tele/helpers/GiftOffers.kt          | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Stars/StarGiftSheet.java b/TMessagesProj/src/main/java/org/telegram/ui/Stars/StarGiftSheet.java
index b92e1db75..687183f54 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Stars/StarGiftSheet.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Stars/StarGiftSheet.java
@@ -1149,7 +1149,7 @@ public class StarGiftSheet extends BottomSheetWithRecyclerListView implements No
             .addIf(link != null, R.drawable.msg_share, getString(R.string.ShareFile), () -> {
                 onSharePressed(null);
             })
-            .addIf(giftUnique != null && giftUnique.offer_min_stars > 0, R.drawable.input_suggest_paid_24, getString(R.string.GiftOfferToBuyMenu), this::showGiftOfferSheet)
+            .addIf(!tele.TeleConfig.NO_MONEY.getValue() && giftUnique != null && giftUnique.offer_min_stars > 0, R.drawable.input_suggest_paid_24, getString(R.string.GiftOfferToBuyMenu), this::showGiftOfferSheet)
             .addIf(canSetAsTheme(), R.drawable.msg_colors, getString(R.string.GiftThemesSetIn), this::openSetAsTheme)
             .addIf(walletCollectible == null && myProfile && savedStarGift != null && isMine(currentAccount, dialogId), savedStarGift != null && !savedStarGift.unsaved ? R.drawable.menu_hide_from_profile : R.drawable.menu_show_on_profile, getString(savedStarGift != null && !savedStarGift.unsaved ? R.string.Gift2HideFromProfile : R.string.Gift2ShowOnProfile), this::toggleShow)
             .addIf(tele.helpers.ViewAsTl.isEnabled() && giftUnique != null && !TextUtils.isEmpty(giftUnique.slug), R.drawable.msg_info, getString(R.string.TeleViewAsTl), () -> {
diff --git a/TMessagesProj/src/main/java/tele/helpers/GiftOffers.kt b/TMessagesProj/src/main/java/tele/helpers/GiftOffers.kt
index 4cc9ad8e4..654c1b4ab 100644
--- a/TMessagesProj/src/main/java/tele/helpers/GiftOffers.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/GiftOffers.kt
@@ -10,6 +10,6 @@ object GiftOffers {
         val owner = message?.messageOwner ?: return false
         return !message.isOutOwner &&
             owner.action is TLRPC.TL_messageActionStarGiftPurchaseOffer &&
-            TeleConfig.HIDE_GIFT_OFFERS.value
+            (TeleConfig.HIDE_GIFT_OFFERS.value || TeleConfig.NO_MONEY.value)
     }
 }
