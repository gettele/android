From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Fri, 23 Oct 2026 15:05:19 +0300
Subject: [PATCH] fix: keep dimmed group values in their section

---
 .../main/java/tele/ui/settings/TeleSettingsActivity.kt   | 9 ++-------
 1 file changed, 2 insertions(+), 7 deletions(-)

diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
index 44a3a6bf0..7474e92d8 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
@@ -357,13 +357,8 @@ class TeleSettingsActivity @JvmOverloads constructor(private val mode: String =
                         }
                     }
                     TYPE_VALUE -> UItem.asButton(position, displayTitle(title), row.value.orEmpty()).apply {
-                        val parentEnabled = row.parent?.value as? Boolean ?: true
-                        enabled = parentEnabled
-                        if (row.parent != null) {
-                            bind = Utilities.Callback { view: View ->
-                                view.alpha = if (parentEnabled) 1f else 0.5f
-                            }
-                        }
+                        // TextCell dims its own text; alpha on the view would fade the section background too
+                        enabled = row.parent?.value as? Boolean ?: true
                     }
                     TYPE_LINK_ICON -> UItem.asButton(position, row.icon, if (row.badge) tele.helpers.TeleNewSettings.withBadge(displayTitle(title)) else if (row.mode == MODE_MENU || row.mode == MODE_RULES) title else displayTitle(title))
                     TYPE_LINK -> UItem.asButton(position, if (row.mode == MODE_MENU || row.mode == MODE_RULES) title else displayTitle(title), row.value.orEmpty())
