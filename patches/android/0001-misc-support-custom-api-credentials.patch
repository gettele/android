From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?t=CE=B1ngenx?= <me@tangenx.dev>
Date: Thu, 1 Oct 2026 04:00:24 +0300
Subject: [PATCH 001/128] misc: support custom api credentials

---
 TMessagesProj/build.gradle                                | 8 ++++++++
 .../src/main/java/org/telegram/messenger/BuildVars.java   | 8 ++++++++
 2 files changed, 16 insertions(+)

diff --git a/TMessagesProj/build.gradle b/TMessagesProj/build.gradle
index 70c567de2..48afa7799 100644
--- a/TMessagesProj/build.gradle
+++ b/TMessagesProj/build.gradle
@@ -142,6 +142,14 @@ android {
 
         multiDexEnabled true
 
+        def teleApiId = getProps("TELE_API_ID")
+        def teleApiHash = getProps("TELE_API_HASH")
+        if (teleApiId == null || teleApiId.toString().isEmpty() || teleApiHash == null || teleApiHash.toString().isEmpty()) {
+            println "tele: TELE_API_ID / TELE_API_HASH are not set in local.properties, stock api credentials will be used"
+        }
+        buildConfigField "int", "TELE_API_ID", teleApiId == null || teleApiId.toString().isEmpty() ? "0" : teleApiId.toString()
+        buildConfigField "String", "TELE_API_HASH", "\"" + (teleApiHash == null ? "" : teleApiHash.toString()) + "\""
+
         externalNativeBuild {
             cmake {
                 version '3.22.1'
diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/BuildVars.java b/TMessagesProj/src/main/java/org/telegram/messenger/BuildVars.java
index 4ed7e6491..1f2404095 100644
--- a/TMessagesProj/src/main/java/org/telegram/messenger/BuildVars.java
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/BuildVars.java
@@ -43,6 +43,14 @@ public class BuildVars {
     // works only on official app ids, disable on your forks
     public static boolean SUPPORTS_PASSKEYS = true;
 
+    static {
+        if (BuildConfig.TELE_API_ID != 0) {
+            APP_ID = BuildConfig.TELE_API_ID;
+            APP_HASH = BuildConfig.TELE_API_HASH;
+            SUPPORTS_PASSKEYS = false;
+        }
+    }
+
     static {
         if (ApplicationLoader.applicationContext != null) {
             SharedPreferences sharedPreferences = ApplicationLoader.applicationContext.getSharedPreferences("systemConfig", Context.MODE_PRIVATE);
