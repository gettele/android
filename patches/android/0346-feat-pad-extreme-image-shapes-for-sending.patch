diff --git a/TMessagesProj/src/main/java/tele/helpers/PhotoPadding.kt b/TMessagesProj/src/main/java/tele/helpers/PhotoPadding.kt
new file mode 100644
index 000000000..2065ff2f6
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/PhotoPadding.kt
@@ -0,0 +1,90 @@
+package tele.helpers
+
+import android.graphics.Bitmap
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.RectF
+import org.telegram.messenger.FileLog
+import org.telegram.messenger.MediaController
+import tele.TeleConfig
+
+// desktop 0331: very wide or narrow photos go out as photos, padded to the widest shape Telegram takes
+object PhotoPadding {
+
+    private const val RATIO = 20
+
+    private val imageRect = RectF()
+
+    private fun minimumSide(longer: Int): Int = (longer + RATIO - 1) / RATIO
+
+    /** The shape the photo is sent with: stock's one unless the toggle has to pad it. */
+    @JvmStatic
+    fun paddedAspect(aspect: Float): Float = when {
+        aspect <= 0f || !TeleConfig.PAD_PHOTO_SHAPES.value -> aspect
+        aspect > RATIO -> RATIO.toFloat()
+        aspect < 1f / RATIO -> 1f / RATIO
+        else -> aspect
+    }
+
+    /** Stock files a still image past 10:1; with the toggle it goes out as a padded photo instead. */
+    @JvmStatic
+    fun allowAsPhoto(): Boolean = TeleConfig.PAD_PHOTO_SHAPES.value
+
+    /** The upload bitmap, padded to the allowed shape; the loaded one is recycled when it pads. */
+    @JvmStatic
+    fun padForSend(bitmap: Bitmap?): Bitmap? {
+        if (bitmap == null || !TeleConfig.PAD_PHOTO_SHAPES.value) {
+            return bitmap
+        }
+        val width = bitmap.width
+        val height = bitmap.height
+        val longer = maxOf(width, height)
+        val shorter = minOf(width, height)
+        if (longer <= 0 || shorter >= minimumSide(longer)) {
+            return bitmap
+        }
+        val minimum = minimumSide(longer)
+        val paddedWidth = maxOf(width, minimum)
+        val paddedHeight = maxOf(height, minimum)
+        val padded = try {
+            Bitmap.createBitmap(paddedWidth, paddedHeight, Bitmap.Config.ARGB_8888)
+        } catch (e: Throwable) {
+            FileLog.e(e)
+            return bitmap
+        }
+        val canvas = Canvas(padded)
+        canvas.drawColor(Color.BLACK)
+        canvas.drawBitmap(bitmap, (paddedWidth - width) / 2f, (paddedHeight - height) / 2f, null)
+        bitmap.recycle()
+        return padded
+    }
+
+    /** Where the photo itself sits in its padded preview cell; the margins stay empty. */
+    @JvmStatic
+    fun previewImageRect(cell: RectF, photo: MediaController.PhotoEntry?): RectF {
+        imageRect.set(cell)
+        if (photo == null || photo.isVideo) {
+            return imageRect
+        }
+        val crop = photo.cropState
+        val width = if (crop != null) crop.width else photo.width
+        val height = if (crop != null) crop.height else photo.height
+        if (width <= 0 || height <= 0 || cell.width() <= 0f || cell.height() <= 0f) {
+            return imageRect
+        }
+        val rotated = photo.orientation == 90 || photo.orientation == 270
+        val aspect = if (rotated) height / width.toFloat() else width / height.toFloat()
+        val padded = paddedAspect(aspect)
+        if (padded == aspect) {
+            return imageRect
+        }
+        if (aspect < padded) {
+            val inset = ((cell.width() - cell.height() * aspect) / 2f).coerceIn(0f, cell.width() / 2f)
+            imageRect.set(cell.left + inset, cell.top, cell.right - inset, cell.bottom)
+        } else {
+            val inset = ((cell.height() - cell.width() / aspect) / 2f).coerceIn(0f, cell.height() / 2f)
+            imageRect.set(cell.left, cell.top + inset, cell.right, cell.bottom - inset)
+        }
+        return imageRect
+    }
+}
