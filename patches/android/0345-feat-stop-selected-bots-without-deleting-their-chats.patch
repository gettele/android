diff --git a/TMessagesProj/src/main/java/tele/helpers/StopBots.kt b/TMessagesProj/src/main/java/tele/helpers/StopBots.kt
new file mode 100644
index 000000000..3e84131e1
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/StopBots.kt
@@ -0,0 +1,47 @@
+package tele.helpers
+
+import org.telegram.messenger.DialogObject
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.MessagesController
+import org.telegram.messenger.R
+import org.telegram.messenger.UserObject
+import org.telegram.tgnet.TLRPC
+import org.telegram.ui.ActionBar.BaseFragment
+import org.telegram.ui.Components.AlertsCreator
+
+/** Stops the bots picked in the chat list: blocks the user and keeps the chat. */
+object StopBots {
+
+    @JvmStatic
+    fun canStop(account: Int, dialogId: Long): Boolean = bot(account, dialogId) != null
+
+    @JvmStatic
+    fun count(account: Int, dialogIds: List<Long>): Int = dialogIds.count { canStop(account, it) }
+
+    @JvmStatic
+    fun confirm(fragment: BaseFragment, account: Int, dialogIds: List<Long>, onStopped: Runnable) {
+        val bots = dialogIds.mapNotNull { bot(account, it) }.map { it.id }
+        if (bots.isEmpty()) return
+        AlertsCreator.showSimpleConfirmAlert(
+            fragment,
+            LocaleController.getString(R.string.TeleStopBots),
+            LocaleController.formatPluralString("TeleStopBotsTitle", bots.size),
+            LocaleController.getString(R.string.TeleStopBots),
+            true,
+            Runnable {
+                val controller = MessagesController.getInstance(account)
+                for (id in bots) controller.blockPeer(id)
+                onStopped.run()
+            }
+        )
+    }
+
+    private fun bot(account: Int, dialogId: Long): TLRPC.User? {
+        if (!DialogObject.isUserDialog(dialogId)) return null
+        val controller = MessagesController.getInstance(account)
+        if (controller.blockePeers.indexOfKey(dialogId) >= 0) return null
+        val user = controller.getUser(dialogId) ?: return null
+        if (!user.bot || user.self || UserObject.isDeleted(user) || MessagesController.isSupportUser(user)) return null
+        return user
+    }
+}
