From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Thu, 5 Nov 2026 04:27:20 +0300
Subject: [PATCH] fix: tint adaptive statuses in message headers

---
 TMessagesProj/src/main/java/tele/ui/TeleNameBadges.kt | 11 +++++++----
 1 file changed, 7 insertions(+), 4 deletions(-)

diff --git a/TMessagesProj/src/main/java/tele/ui/TeleNameBadges.kt b/TMessagesProj/src/main/java/tele/ui/TeleNameBadges.kt
index 935466454..004cab89f 100644
--- a/TMessagesProj/src/main/java/tele/ui/TeleNameBadges.kt
+++ b/TMessagesProj/src/main/java/tele/ui/TeleNameBadges.kt
@@ -35,9 +35,12 @@ object TeleNameBadges {
         return CombinedDrawable(area, check)
     }
 
-    private fun SpannableStringBuilder.appendDrawable(drawable: Drawable, size: Int = 0): SpannableStringBuilder {
+    private fun SpannableStringBuilder.appendDrawable(drawable: Drawable, size: Int = 0, paint: Paint? = null): SpannableStringBuilder {
         val span = ColoredImageSpan(drawable, ColoredImageSpan.ALIGN_CENTER)
         span.recolorDrawable = false
+        if (paint != null && drawable is AnimatedEmojiDrawable.SwapAnimatedEmojiDrawable) {
+            span.setCheckColorDelegate { drawable.setColor(paint.color) }
+        }
         if (size > 0) span.setSize(size)
         return append("\u2060", span, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
     }
@@ -79,7 +82,7 @@ object TeleNameBadges {
     }
 
     /** The badges of a forwarded-from or a reply name: the icon before it, the checkmark after it. */
-    class HeaderBadges internal constructor(internal val icon: Drawable?, internal val iconWidth: Int, internal val check: Drawable?, internal val spaceWidth: Int)
+    class HeaderBadges internal constructor(internal val icon: Drawable?, internal val iconWidth: Int, internal val check: Drawable?, internal val spaceWidth: Int, internal val paint: Paint?)
 
     private val cellIcons = WeakHashMap<View, Array<AnimatedEmojiDrawable.SwapAnimatedEmojiDrawable?>>()
 
@@ -200,7 +203,7 @@ object TeleNameBadges {
             icon = cellIcon(view, slot, account, size).also { it.set(iconId, false) }
         }
         val check = if (verified) verifiedDrawable() else null
-        return HeaderBadges(icon, size, check, Math.ceil(paint.measureText(" ").toDouble()).toInt())
+        return HeaderBadges(icon, size, check, Math.ceil(paint.measureText(" ").toDouble()).toInt(), paint)
     }
 
     private fun cellIcon(view: View, slot: Int, account: Int, size: Int): AnimatedEmojiDrawable.SwapAnimatedEmojiDrawable {
@@ -244,7 +247,7 @@ object TeleNameBadges {
         if (badges == null) return text
         val result = SpannableStringBuilder(text)
         if (badges.icon != null) {
-            val icon = SpannableStringBuilder().appendDrawable(badges.icon, badges.iconWidth).append(" ")
+            val icon = SpannableStringBuilder().appendDrawable(badges.icon, badges.iconWidth, badges.paint).append(" ")
             result.insert(nameStart.coerceIn(0, result.length), icon)
         }
         if (badges.check != null) result.append(" ").appendDrawable(badges.check)
