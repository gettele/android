From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Wed, 21 Oct 2026 02:58:06 +0300
Subject: [PATCH] fix: hide phones in streamer mode

---
 .../src/main/java/org/telegram/messenger/UserObject.java | 9 ++++++++-
 .../src/main/java/org/telegram/ui/ChatActivity.java      | 2 +-
 .../src/main/java/org/telegram/ui/ProfileActivity.java   | 4 ++--
 3 files changed, 11 insertions(+), 4 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/UserObject.java b/TMessagesProj/src/main/java/org/telegram/messenger/UserObject.java
index a7b8ac0e9..862a37f59 100644
--- a/TMessagesProj/src/main/java/org/telegram/messenger/UserObject.java
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/UserObject.java
@@ -86,7 +86,14 @@ public class UserObject {
             }
         }
         String name = AndroidUtilities.removeRTL(AndroidUtilities.removeDiacritics(ContactsController.formatName(user.first_name, user.last_name)));
-        return name.length() != 0 || TextUtils.isEmpty(user.phone) ? name : PhoneFormat.getInstance().format("+" + user.phone);
+        if (name.length() != 0 || TextUtils.isEmpty(user.phone)) {
+            return name;
+        }
+        if (tele.TeleConfig.STREAMER_MODE.getValue()) {
+            // the streamer mode hides the phone number
+            return LocaleController.getString(R.string.PhoneHidden);
+        }
+        return PhoneFormat.getInstance().format("+" + user.phone);
     }
 
     public static String getPublicUsername(TLRPC.User user, boolean editable) {
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
index 39c9fca43..25120d8ea 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
@@ -20067,7 +20067,7 @@ public class ChatActivity extends BaseFragment implements
             if (currentUser.self) {
                 avatarContainer.setTitle(LocaleController.getString(R.string.SavedMessages));
             } else if (!MessagesController.isSupportUser(currentUser) && getContactsController().contactsDict.get(currentUser.id) == null && (getContactsController().contactsDict.size() != 0 || !getContactsController().isLoadingContacts())) {
-                if (!TextUtils.isEmpty(currentUser.phone) && !TeleConfig.NAME_INSTEAD_OF_PHONE.getValue()) {
+                if (!TextUtils.isEmpty(currentUser.phone) && !TeleConfig.NAME_INSTEAD_OF_PHONE.getValue() && !TeleConfig.STREAMER_MODE.getValue()) {
                     avatarContainer.setTitle(PhoneFormat.getInstance().format("+" + currentUser.phone), currentUser.scam, currentUser.fake, currentUser.verified, getMessagesController().isPremiumUser(currentUser), currentUser.emoji_status, animated);
                 } else {
                     avatarContainer.setTitle(AndroidUtilities.removeRTL(AndroidUtilities.removeDiacritics(UserObject.getUserName(currentUser))), currentUser.scam, currentUser.fake, currentUser.verified, getMessagesController().isPremiumUser(currentUser), currentUser.emoji_status, animated);
