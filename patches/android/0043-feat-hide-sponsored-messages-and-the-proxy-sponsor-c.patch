From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Mon, 5 Oct 2026 19:25:13 +0300
Subject: [PATCH 043/128] feat: hide sponsored messages and the proxy sponsor
 channel

getSponsoredMessages returns nothing when the toggle is on, so channels
and bots never request or render ads; the proxy promo response is treated
as empty, which both prevents the sponsor dialog and removes an existing
one via the stock noDialog path.

Constraint: psa dialogs are left alone
Confidence: high
Scope-risk: narrow
---
 .../java/org/telegram/messenger/MessagesController.java  | 9 ++++++++-
 TMessagesProj/src/main/java/tele/TeleConfig.kt           | 4 ++++
 .../src/main/java/tele/ui/settings/TeleSearch.kt         | 2 ++
 .../main/java/tele/ui/settings/TeleSettingsActivity.kt   | 9 +++++++++
 4 files changed, 23 insertions(+), 1 deletion(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/MessagesController.java b/TMessagesProj/src/main/java/org/telegram/messenger/MessagesController.java
index 1e7ceb5b8..2bb42de6a 100644
--- a/TMessagesProj/src/main/java/org/telegram/messenger/MessagesController.java
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/MessagesController.java
@@ -10896,8 +10896,9 @@ public class MessagesController extends BaseController implements NotificationCe
             } else if (response instanceof TLRPC.TL_help_promoData) {
                 TLRPC.TL_help_promoData res = (TLRPC.TL_help_promoData) response;
 
+                final boolean teleHideProxySponsor = res.proxy && tele.TeleConfig.HIDE_PROXY_SPONSOR.getValue();
                 long did;
-                if (res.peer == null) {
+                if (res.peer == null || teleHideProxySponsor) {
                     did = 0;
                 } else if (res.peer.user_id != 0) {
                     did = res.peer.user_id;
@@ -10933,6 +10934,9 @@ public class MessagesController extends BaseController implements NotificationCe
                 } else {
                     promoDialogType = PROMO_TYPE_OTHER;
                 }
+                if (teleHideProxySponsor) {
+                    noDialog = true;
+                }
                 proxyDialogAddress = proxyAddress + proxySecret;
                 promoPsaMessage = res.psa_message;
                 nextPromoInfoCheckTime = res.expires;
@@ -21688,6 +21692,9 @@ public class MessagesController extends BaseController implements NotificationCe
     }
 
     public SponsoredMessagesInfo getSponsoredMessages(long dialogId) {
+        if (tele.TeleConfig.HIDE_SPONSORED.getValue()) {
+            return null;
+        }
         SponsoredMessagesInfo info = sponsoredMessages.get(dialogId);
         if (info != null && (info.loading || Math.abs(SystemClock.elapsedRealtime() - info.loadTime) <= 5 * 60 * 1000)) {
             return info;
