@@ -106,6 +106,10 @@ object TeleConfig {
     val INLINE_NO_VIA = BoolItem("inline_no_via", false)
     @JvmField
     val BOT_BUTTON_PAYLOADS = BoolItem("bot_button_payloads", true)
