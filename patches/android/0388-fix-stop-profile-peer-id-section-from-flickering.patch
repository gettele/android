From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: test <test@example.com>
Date: Thu, 26 Nov 2026 21:51:10 +0300
Subject: [PATCH] fix: stop profile peer id section from flickering

---
 .../java/org/telegram/ui/ProfileActivity.java | 37 ++++++++++++-------
 1 file changed, 24 insertions(+), 13 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/ProfileActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/ProfileActivity.java
index ca619e90f..1bf1ef7fe 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/ProfileActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/ProfileActivity.java
@@ -641,7 +641,8 @@ public class ProfileActivity extends BaseFragment implements NotificationCenter.
     private int tele_idRow;
     private int tele_dcRow;
     private tele.helpers.PeerDc.Handle teleDcHandle;
-    private tele.helpers.PeerDc.Info teleDcInfo;
+    private String tele_peerIdText;
+    private String tele_peerDcText;
     private int tele_aliasRow;
     private int phoneSuggestionSectionRow;
     private int graceSuggestionRow;
@@ -10019,30 +10020,35 @@ public class ProfileActivity extends BaseFragment implements NotificationCenter.
     // the data center of a chat comes from the oldest photo of its history
     private void loadTelePeerDc() {
         if (teleDcHandle != null) {
-            teleDcHandle.cancel();
-            teleDcHandle = null;
+            return;
         }
         if (userId != 0 || chatId == 0 || !tele.TeleConfig.SHOW_DC.getValue()) {
             return;
         }
+        if (tele.helpers.PeerId.currentDc(currentAccount, userId, chatId) == 0) {
+            return;
+        }
+        tele_peerIdText = tele.helpers.PeerId.rowText(currentAccount, userId, chatId);
+        tele_peerDcText = tele.helpers.PeerId.dcText(currentAccount, userId, chatId);
         teleDcHandle = tele.helpers.PeerDc.request(currentAccount, userId, chatId, info -> {
             if (userId != 0 || chatId == 0) {
-                // the profile changed while the history was loading
                 return;
             }
             AndroidUtilities.runOnUIThread(() -> {
+                teleDcHandle = null;
                 if (listAdapter == null) {
                     return;
                 }
-                if (teleDcInfo != null && teleDcInfo.getDc() == info.getDc() && teleDcInfo.getUncertain() == info.getUncertain()) {
-                    // the row already shows this value, no redraw needed
-                    return;
-                }
-                teleDcInfo = info;
-                if (tele_idRow >= 0) {
+                final String idText = tele.helpers.PeerId.rowText(currentAccount, userId, chatId);
+                final String dcText = tele.helpers.PeerId.dcText(currentAccount, userId, chatId);
+                final boolean idChanged = !TextUtils.equals(idText, tele_peerIdText);
+                final boolean dcChanged = !TextUtils.equals(dcText, tele_peerDcText);
+                tele_peerIdText = idText;
+                tele_peerDcText = dcText;
+                if (idChanged && tele_idRow >= 0) {
                     listAdapter.notifyItemChanged(tele_idRow);
                 }
-                if (tele_dcRow >= 0) {
+                if (dcChanged && tele_dcRow >= 0) {
                     listAdapter.notifyItemChanged(tele_dcRow);
                 }
             });
@@ -13965,12 +13971,14 @@ public class ProfileActivity extends BaseFragment implements NotificationCenter.
                             containsGift = !myProfile && today && !getMessagesController().premiumPurchaseBlocked();
                         }
                     } else if (position == tele_idRow) {
-                        detailCell.setTextAndValue(tele.helpers.PeerId.rowText(currentAccount, userId, chatId), LocaleController.getString(R.string.TeleProfileId), false);
+                        tele_peerIdText = tele.helpers.PeerId.rowText(currentAccount, userId, chatId);
+                        detailCell.setTextAndValue(tele_peerIdText, LocaleController.getString(R.string.TeleProfileId), false);
                     } else if (position == tele_aliasRow) {
                         String alias = tele.helpers.Aliases.aliasOf(currentAccount, userId != 0 ? userId : -chatId);
                         detailCell.setTextAndValue(alias != null ? "@" + alias : "", "alias", false);
                     } else if (position == tele_dcRow) {
-                        detailCell.setTextAndValue(tele.helpers.PeerId.dcText(currentAccount, userId, chatId), LocaleController.getString(R.string.TeleProfileDc), false);
+                        tele_peerDcText = tele.helpers.PeerId.dcText(currentAccount, userId, chatId);
+                        detailCell.setTextAndValue(tele_peerDcText, LocaleController.getString(R.string.TeleProfileDc), false);
                     } else if (position == phoneRow) {
                         String text;
                         TLRPC.User user = getMessagesController().getUser(userId);
@@ -16198,6 +16206,9 @@ public class ProfileActivity extends BaseFragment implements NotificationCenter.
             put(++pointer, userInfoRow, sparseIntArray);
             put(++pointer, channelInfoRow, sparseIntArray);
             put(++pointer, usernameRow, sparseIntArray);
+            put(++pointer, tele_idRow, sparseIntArray);
+            put(++pointer, tele_dcRow, sparseIntArray);
+            put(++pointer, tele_aliasRow, sparseIntArray);
             put(++pointer, notificationsDividerRow, sparseIntArray);
             put(++pointer, reportDividerRow, sparseIntArray);
             put(++pointer, notificationsRow, sparseIntArray);
