+
+    private val uiRevision = java.util.concurrent.atomic.AtomicInteger()
+
+    /**
+     * The chats rebind their cells when the revision changes: the stock notification for that
+     * needs the load arguments and crashes the app without them.
+     */
+    @JvmStatic
+    fun uiRevision(): Int = uiRevision.get()
+
+    @JvmStatic
+    fun bumpUiRevision() {
