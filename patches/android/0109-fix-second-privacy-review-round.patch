+++ b/TMessagesProj/src/main/java/tele/helpers/LastSeenPeek.kt
@@ -32,6 +32,10 @@ object LastSeenPeek {
 
     @JvmStatic
     fun peek(fragment: BaseFragment, account: Int, userId: Long) {
+        peek(fragment, account, userId, 0)
+    }
+
+    private fun peek(fragment: BaseFragment, account: Int, userId: Long, attempt: Int) {
         if (!TeleConfig.LAST_SEEN_RESTORE.value) {
             return
         }
@@ -43,7 +47,15 @@ object LastSeenPeek {
         }
         val rules = ContactsController.getInstance(account).getPrivacyRules(ContactsController.PRIVACY_RULES_TYPE_LASTSEEN)
         if (rules == null) {
-            show(fragment, "the privacy rules are not loaded yet")
+            // the rules are not in the cache yet: ask the server and wait for them
+            if (attempt == 0) {
+                ContactsController.getInstance(account).loadPrivacySettings(true)
+            }
+            if (attempt < 20) {
+                Handler(Looper.getMainLooper()).postDelayed({ peek(fragment, account, userId, attempt + 1) }, 500L)
+                return
+            }
+            show(fragment, "could not load the privacy rules")
             return
         }
         val saved = saveRules(rules)
diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleGhostPreview.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleGhostPreview.kt
new file mode 100644
index 000000000..f6239fab0
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleGhostPreview.kt
@@ -0,0 +1,397 @@
+package tele.ui.settings
+
+import android.content.Context
+import android.graphics.Color
+import android.graphics.Typeface
+import android.graphics.drawable.GradientDrawable
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.View
+import android.widget.FrameLayout
+import android.widget.ImageView
+import android.widget.LinearLayout
+import android.widget.TextView
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.ImageLocation
+import org.telegram.messenger.R
+import org.telegram.messenger.UserConfig
+import org.telegram.messenger.UserObject
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Components.AvatarDrawable
+import org.telegram.ui.Components.BackupImageView
+import org.telegram.ui.Components.LayoutHelper
+import tele.BoolItem
+import tele.TeleConfig
+
+/**
+ * The live preview of the ghost mode: the left column shows what you show, the right one shows
+ * what the peers see. Clicking a row switches the matching option, like in the desktop client.
+ */
+object TeleGhostPreview {
+
+    /** The stock icon of the premium "Hide My View" mode of the stories. */
+    private val STEALTH_ICON = R.drawable.msg_stories_stealth2
+
+    private class Cell(
+        val title: String,
+        val subtitle: String? = null,
+        val dim: Boolean = false,
+        val badge: Boolean = false,
+        val bubble: Boolean = false,
+        val field: Boolean = false,
+        val out: Boolean = false,
+        val profile: Boolean = false,
+        val story: Boolean = false,
+        val views: Boolean = false
+    )
+
+    private class PreviewRow(val option: BoolItem?, val left: Cell, val right: Cell)
+
+    fun createView(context: Context, onToggle: (BoolItem) -> Unit): View {
+        val card = LinearLayout(context)
+        card.orientation = LinearLayout.VERTICAL
+        // the content lines up with the text of the settings rows
+        card.setPadding(dp(21f), dp(10f), dp(21f), dp(6f))
+        card.background = round(Theme.getColor(Theme.key_windowBackgroundWhite), 12f)
+        val params = LinearLayout.LayoutParams(-1, LayoutHelper.WRAP_CONTENT)
+        params.leftMargin = dp(12f)
+        params.rightMargin = dp(12f)
+        params.topMargin = dp(4f)
+        params.bottomMargin = dp(4f)
+        card.layoutParams = params
+
+        val header = LinearLayout(context)
+        header.orientation = LinearLayout.HORIZONTAL
+        header.addView(headerCell(context, "you"), columnParams())
+        header.addView(headerCell(context, "what they see"), columnParams())
+        card.addView(header, LinearLayout.LayoutParams(-1, LayoutHelper.WRAP_CONTENT))
+
+        val enabled = TeleConfig.GHOST_MODE.value
+        for (row in rows()) {
+            card.addView(buildRow(context, row, enabled, onToggle), LinearLayout.LayoutParams(-1, LayoutHelper.WRAP_CONTENT))
+        }
+        return card
+    }
+
+    /** The caption under the preview card. */
+    fun caption(): String {
+        val text = StringBuilder("Click a row to switch it. Still reveals you: reactions, story replies, live stories.")
+        if (TeleConfig.GHOST_ONLINE.value && !TeleConfig.GHOST_SCHEDULE.value) {
+            text.append(", sending (online for a moment)")
+        }
+        return text.toString()
+    }
+
+    private fun rows(): List<PreviewRow> = listOf(
+        PreviewRow(
+            TeleConfig.GHOST_ONLINE,
+            Cell("online", profile = true),
+            if (TeleConfig.GHOST_ONLINE.value) {
+                Cell("recently", dim = true, badge = true, profile = true)
+            } else {
+                Cell("online", profile = true)
+            }
+        ),
+        PreviewRow(
+            TeleConfig.GHOST_TYPING,
+            Cell("On my way, be there in", field = true),
+            if (TeleConfig.GHOST_TYPING.value) {
+                Cell("recently", dim = true, badge = true, profile = true)
+            } else {
+                Cell("typing…", profile = true)
+            }
+        ),
+        PreviewRow(
+            TeleConfig.GHOST_READ,
+            Cell("See you tomorrow?", bubble = true),
+            if (TeleConfig.GHOST_READ.value) {
+                Cell("See you tomorrow?", bubble = true, out = true)
+            } else {
+                Cell("See you tomorrow?", subtitle = "read", bubble = true, out = true)
+            }
+        ),
+        PreviewRow(
+            null,
+            Cell("Their story", subtitle = "You watch it", story = true),
+            if (TeleConfig.INVISIBLE_STORIES.value) {
+                Cell("11 views", subtitle = "Without you", views = true)
+            } else {
+                Cell("12 views", subtitle = "Including you", views = true)
+            }
+        )
+    )
+
+    private fun buildRow(context: Context, row: PreviewRow, enabled: Boolean, onToggle: (BoolItem) -> Unit): View {
+        val layout = LinearLayout(context)
+        layout.orientation = LinearLayout.HORIZONTAL
+        layout.setPadding(0, dp(10f), 0, dp(10f))
+        layout.addView(cell(context, row.left), columnParams())
+        layout.addView(cell(context, row.right), columnParams())
+        val option = row.option
+        if (enabled && option != null) {
+            layout.isClickable = true
+            layout.setOnClickListener { onToggle(option) }
+        }
+        layout.alpha = if (enabled) 1f else 0.4f
+        return layout
+    }
+
+    private fun columnParams(): LinearLayout.LayoutParams {
+        val params = LinearLayout.LayoutParams(0, LayoutHelper.WRAP_CONTENT, 1f)
+        params.rightMargin = dp(8f)
+        return params
+    }
+
+    private fun cell(context: Context, data: Cell): View {
+        val box = LinearLayout(context)
+        box.orientation = LinearLayout.VERTICAL
+        box.gravity = if (data.out) Gravity.END else Gravity.START
+
+        if (data.story) {
+            // the story card: the circle on the left, the text on the right
+            val card = LinearLayout(context)
+            card.orientation = LinearLayout.HORIZONTAL
+            card.gravity = Gravity.CENTER_VERTICAL
+            card.addView(storyCircle(context), LinearLayout.LayoutParams(dp(40f), dp(40f)))
+            val texts = LinearLayout(context)
+            texts.orientation = LinearLayout.VERTICAL
+            texts.gravity = Gravity.CENTER_VERTICAL
+            texts.addView(label(context, data.title, 14f, false), LinearLayout.LayoutParams(-1, LayoutHelper.WRAP_CONTENT))
+            if (!data.subtitle.isNullOrEmpty()) {
+                texts.addView(label(context, data.subtitle, 12f, true), LinearLayout.LayoutParams(-1, LayoutHelper.WRAP_CONTENT))
+            }
+            val textParams = LinearLayout.LayoutParams(0, LayoutHelper.WRAP_CONTENT, 1f)
+            textParams.leftMargin = dp(8f)
+            card.addView(texts, textParams)
+            box.addView(card, LinearLayout.LayoutParams(-1, LayoutHelper.WRAP_CONTENT))
+            return box
+        }
+        if (data.views) {
+            // the icon on the left, the text on the right
+            val card = LinearLayout(context)
+            card.orientation = LinearLayout.HORIZONTAL
+            card.gravity = Gravity.CENTER_VERTICAL
+            val icon = ImageView(context)
+            icon.setImageResource(STEALTH_ICON)
+            icon.setColorFilter(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2))
+            card.addView(icon, LinearLayout.LayoutParams(dp(20f), dp(20f)))
+            val texts = LinearLayout(context)
+            texts.orientation = LinearLayout.VERTICAL
+            texts.gravity = Gravity.CENTER_VERTICAL
+            texts.addView(label(context, data.title, 14f, false), LinearLayout.LayoutParams(-1, LayoutHelper.WRAP_CONTENT))
+            if (!data.subtitle.isNullOrEmpty()) {
+                texts.addView(label(context, data.subtitle, 12f, true), LinearLayout.LayoutParams(-1, LayoutHelper.WRAP_CONTENT))
+            }
+            val textParams = LinearLayout.LayoutParams(0, LayoutHelper.WRAP_CONTENT, 1f)
+            textParams.leftMargin = dp(8f)
+            card.addView(texts, textParams)
+            box.addView(card, LinearLayout.LayoutParams(-1, LayoutHelper.WRAP_CONTENT))
+            return box
+        }
+        if (data.profile) {
+            box.addView(profilePlate(context, data), LinearLayout.LayoutParams(-1, LayoutHelper.WRAP_CONTENT))
+            return box
+        }
+
+        val titleRow = LinearLayout(context)
+        titleRow.orientation = LinearLayout.HORIZONTAL
+        titleRow.gravity = Gravity.CENTER_VERTICAL
+        val content = LinearLayout(context)
+        content.orientation = LinearLayout.HORIZONTAL
+        content.gravity = Gravity.CENTER_VERTICAL
+
+        if (data.badge && data.bubble) {
+            // the desktop draws the stealth badge next to the bubble
+            content.addView(badge(context), LinearLayout.LayoutParams(dp(16f), dp(16f)))
+        }
+
+        val title = TextView(context)
+        title.text = data.title
+        title.setTextSize(TypedValue.COMPLEX_UNIT_DIP, if (data.bubble) 12f else 14f)
+        title.setTextColor(
+            when {
+                data.dim -> Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2)
+                data.out && data.bubble -> Theme.getColor(Theme.key_chat_messageTextOut)
+                data.bubble -> Theme.getColor(Theme.key_chat_messageTextIn)
+                else -> Theme.getColor(Theme.key_windowBackgroundWhiteBlackText)
+            }
+        )
+        if (data.bubble) {
+            val bubble = LinearLayout(context)
+            bubble.orientation = LinearLayout.HORIZONTAL
+            bubble.gravity = Gravity.CENTER_VERTICAL
+            bubble.setPadding(dp(9f), dp(6f), dp(9f), dp(6f))
+            bubble.background = round(
+                if (data.out) Theme.getColor(Theme.key_chat_outBubble) else Theme.getColor(Theme.key_windowBackgroundGray),
+                12f
+            )
+            bubble.addView(title, LinearLayout.LayoutParams(LayoutHelper.WRAP_CONTENT, LayoutHelper.WRAP_CONTENT))
+            if (data.out) {
+                // one check means the message is not read yet
+                val check = ImageView(context)
+                check.setImageResource(R.drawable.msg_check_s)
+                val checkParams = LinearLayout.LayoutParams(dp(12f), dp(12f))
+                checkParams.leftMargin = dp(6f)
+                bubble.addView(check, checkParams)
+            }
+            content.addView(bubble, LinearLayout.LayoutParams(LayoutHelper.WRAP_CONTENT, LayoutHelper.WRAP_CONTENT))
+        } else {
+            if (data.field) {
+                title.setPadding(dp(10f), dp(6f), dp(10f), dp(6f))
+                title.background = round(Theme.getColor(Theme.key_windowBackgroundGray), 12f)
+            }
+            content.addView(title, LinearLayout.LayoutParams(LayoutHelper.WRAP_CONTENT, LayoutHelper.WRAP_CONTENT))
+        }
+        if (data.badge && !data.bubble) {
+            val badgeParams = LinearLayout.LayoutParams(dp(16f), dp(16f))
+            badgeParams.leftMargin = dp(4f)
+            content.addView(badge(context), badgeParams)
+        }
+        titleRow.addView(content, LinearLayout.LayoutParams(0, LayoutHelper.WRAP_CONTENT, 1f))
+        box.addView(titleRow, LinearLayout.LayoutParams(-1, LayoutHelper.WRAP_CONTENT))
+
+        if (!data.subtitle.isNullOrEmpty()) {
+            box.addView(label(context, data.subtitle, 12f, true), LinearLayout.LayoutParams(-1, LayoutHelper.WRAP_CONTENT))
+        }
+        return box
+    }
+
+    /** The profile plate of the dialog header: the avatar with the name and the status. */
+    private fun profilePlate(context: Context, data: Cell): View {
+        val row = LinearLayout(context)
+        row.orientation = LinearLayout.HORIZONTAL
+        row.gravity = Gravity.CENTER_VERTICAL
+
+        val avatar = FrameLayout(context)
+        val image = userAvatar(context, dp(28f))
+        avatar.addView(image, FrameLayout.LayoutParams(dp(28f), dp(28f)))
+        if (data.badge) {
+            // the desktop puts the stealth badge on the avatar
+            val badgeParams = FrameLayout.LayoutParams(dp(12f), dp(12f))
+            badgeParams.gravity = Gravity.BOTTOM or Gravity.END
+            avatar.addView(badge(context), badgeParams)
+        }
+        row.addView(avatar, LinearLayout.LayoutParams(dp(28f), dp(28f)))
+
+        val texts = LinearLayout(context)
+        texts.orientation = LinearLayout.VERTICAL
+        val name = TextView(context)
+        name.text = userName()
+        name.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15f)
+        name.setTypeface(Typeface.DEFAULT, Typeface.BOLD)
+        name.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
+        name.maxLines = 1
+        name.ellipsize = android.text.TextUtils.TruncateAt.END
+        texts.addView(name, LinearLayout.LayoutParams(-1, LayoutHelper.WRAP_CONTENT))
+
+        val status = TextView(context)
+        status.text = data.title
+        status.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13f)
+        status.setTextColor(
+            if (data.dim) Theme.getColor(Theme.key_windowBackgroundWhiteGrayText3)
+            else Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2)
+        )
+        texts.addView(status, LinearLayout.LayoutParams(-1, LayoutHelper.WRAP_CONTENT))
+
+        val textParams = LinearLayout.LayoutParams(0, LayoutHelper.WRAP_CONTENT, 1f)
+        textParams.leftMargin = dp(8f)
+        row.addView(texts, textParams)
+        return row
+    }
+
+    /** The avatar of the current user: the photo when there is one, the letter otherwise. */
+    private fun userAvatar(context: Context, size: Int): View {
+        val account = UserConfig.selectedAccount
+        val user = UserConfig.getInstance(account).currentUser
+        val image = BackupImageView(context)
+        image.setRoundRadius(size / 2)
+        val avatar = AvatarDrawable(user)
+        avatar.setTextSize((size * 0.42f).toInt())
+        val location = ImageLocation.getForUser(account, user, ImageLocation.TYPE_SMALL)
+        image.setImage(location, "50_50", avatar, user)
+        return image
+    }
+
+    /** The story circle: the letter avatar with the story ring around it. */
+    private fun storyCircle(context: Context): View {
+        val frame = FrameLayout(context)
+        val ring = GradientDrawable()
+        ring.setShape(GradientDrawable.OVAL)
+        ring.setColor(Color.TRANSPARENT)
+        ring.setStroke(dp(2f), Theme.getColor(Theme.key_windowBackgroundWhiteBlueText))
+        frame.background = ring
+
+        val letter = TextView(context)
+        letter.text = userInitial()
+        letter.gravity = Gravity.CENTER
+        letter.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15f)
+        letter.setTypeface(Typeface.DEFAULT, Typeface.BOLD)
+        letter.setTextColor(Color.WHITE)
+        val avatar = GradientDrawable()
+        avatar.setShape(GradientDrawable.OVAL)
+        avatar.setColor(Theme.getColor(Theme.key_avatar_backgroundBlue))
+        letter.background = avatar
+        val params = FrameLayout.LayoutParams(dp(34f), dp(34f))
+        params.gravity = Gravity.CENTER
+        frame.addView(letter, params)
+        return frame
+    }
+
+    private fun badge(context: Context): View {
+        val view = ImageView(context)
+        view.setImageResource(STEALTH_ICON)
+        view.setColorFilter(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2))
+        return view
+    }
+
+    private fun label(context: Context, text: String, size: Float, gray: Boolean): View {
+        val view = TextView(context)
+        view.text = text
+        view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, size)
+        view.setTextColor(
+            if (gray) Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2)
+            else Theme.getColor(Theme.key_windowBackgroundWhiteBlackText)
+        )
+        return view
+    }
+
+    /** The system message look: a centered pill with the service colors. */
+    private fun systemMessage(context: Context, text: String): View {
+        val view = TextView(context)
+        view.text = text
+        view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13f)
+        view.setTextColor(Theme.getColor(Theme.key_chat_serviceText))
+        view.gravity = Gravity.CENTER
+        view.setPadding(dp(10f), dp(4f), dp(10f), dp(4f))
+        view.background = round(Theme.getColor(Theme.key_chat_serviceBackground), 12f)
+        return view
+    }
+
+    private fun headerCell(context: Context, text: String): View {
+        val frame = FrameLayout(context)
+        val params = FrameLayout.LayoutParams(LayoutHelper.WRAP_CONTENT, LayoutHelper.WRAP_CONTENT)
+        params.gravity = Gravity.CENTER
+        frame.addView(systemMessage(context, text), params)
+        return frame
+    }
+
+    private fun userName(): String {
+        val user = UserConfig.getInstance(UserConfig.selectedAccount).currentUser
+        val name = user?.let { UserObject.getFirstName(it) }
+        return if (name.isNullOrEmpty()) "You" else name
+    }
+
+    private fun userInitial(): String {
+        val name = userName()
+        return if (name.isEmpty()) "Y" else name.substring(0, 1).uppercase()
+    }
+
+    private fun round(color: Int, radius: Float): GradientDrawable {
+        val drawable = GradientDrawable()
+        drawable.setColor(color)
+        drawable.setCornerRadius(dp(radius).toFloat())
+        return drawable
+    }
+
+    private fun dp(value: Float): Int = AndroidUtilities.dp(value)
+}
