@@ -142,11 +144,13 @@ object TeleUpdater {
                 }
             }
         } catch (e: HttpStatusException) {
-            fail(if (e.code == 404) "No releases published yet" else "Unexpected http status ${e.code}")
+            fail(if (e.code == 404) "No releases published yet" else "Unexpected http status ${e.code}", e.code != 404)
         } catch (e: TooLargeException) {
             fail("Response is too large")
+        } catch (e: WrongOffsetException) {
+            fail("The server resumed the download at a wrong offset", true)
         } catch (e: Exception) {
