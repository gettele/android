+package tele.helpers
+
+import android.view.View
+import java.text.DateFormat
+import java.text.SimpleDateFormat
+import java.util.Calendar
+import java.util.Date
+import java.util.Locale
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.BuildVars
+import org.telegram.messenger.MessagesController
+import org.telegram.messenger.NotificationCenter
+import org.telegram.messenger.NotificationsController
+import org.telegram.messenger.SharedConfig
+import org.telegram.messenger.UserConfig
+import org.telegram.messenger.UserObject
+import org.telegram.tgnet.ConnectionsManager
+import tele.TeleBuild
+import tele.TeleConfig
+
+/** The live template of the chat list title, a port of the desktop title bar label. */
+object TeleTitle {
+
+    enum class Tick { NONE, MINUTE, SECOND }
+
+    enum class SpanType { VARIABLE, INVALID, BRACKET }
+
+    class Modifier(val name: String, val argument: String = "", val number: Int = 0)
+
+    class Token(
+        val text: String = "",
+        val name: String = "",
+        val format: String = "",
+        val modifiers: List<Modifier> = emptyList(),
+        val group: List<Token> = emptyList(),
+        val variable: Boolean = false,
+        val optional: Boolean = false,
+        val broken: Boolean = false,
+        val brief: Boolean = false
+    )
+
+    class Span(val from: Int, val till: Int, val type: SpanType)
+
+    class Template(val tokens: List<Token>, val spans: List<Span>, val errors: List<String>, val tick: Tick)
+
+    private enum class Arity { NONE, NUMBER, TEXT }
+
+    private class Parsing {
+        val spans = ArrayList<Span>()
+        val errors = ArrayList<String>()
+    }
+
+    private val KNOWN = setOf(
+        "build", "version", "time", "date", "weekday", "day", "month",
+        "name", "username", "id", "accounts", "unread", "status"
+    )
+
+    private fun formatted(name: String) = name == "time" || name == "date"
+
+    private fun quoted(text: String) = "\u201C$text\u201D"
+
+    private fun arity(name: String): Arity? = when (name) {
+        "lower", "upper", "title", "cap", "short", "first", "last", "k" -> Arity.NONE
+        "max", "pad" -> Arity.NUMBER
+        "default" -> Arity.TEXT
+        else -> null
+    }
+
+    /** A modifier or the error that explains why it isn't one. */
+    private fun parseModifier(segment: String): Pair<Modifier?, String> {
+        val colon = segment.indexOf(':')
+        val name = (if (colon < 0) segment else segment.substring(0, colon)).trim()
+        val argument = if (colon < 0) "" else segment.substring(colon + 1)
+        if (name.isEmpty()) return null to "empty modifier"
+        val arity = arity(name) ?: return null to "unknown modifier ${quoted(name)}"
+        return when (arity) {
+            Arity.NONE -> if (colon >= 0) null to "${quoted(name)} takes no value" else Modifier(name) to ""
+            Arity.NUMBER -> {
+                val limit = if (name == "max") 1000 else 64
+                val number = argument.trim().toIntOrNull()
+                if (colon < 0 || number == null || number < 1 || number > limit) {
+                    null to "${quoted(name)} needs a number from 1 to $limit, like $name:${if (name == "max") 20 else 2}"
+                } else {
+                    Modifier(name, number = number) to ""
+                }
+            }
+            Arity.TEXT -> if (colon < 0) null to "${quoted(name)} needs a value, like $name:none" else Modifier(name, argument = argument) to ""
+        }
+    }
+
+    /** The pipes outside of the quoted parts of a date format. */
+    private fun pipes(text: String): List<Int> {
+        val result = ArrayList<Int>()
+        var quotedPart = false
+        text.forEachIndexed { i, ch ->
+            if (ch == '\'') quotedPart = !quotedPart else if (ch == '|' && !quotedPart) result.add(i)
+        }
+        return result
+    }
+
+    private fun parseModifiers(tail: String, error: ((String) -> Unit)?): List<Modifier>? {
+        val result = ArrayList<Modifier>()
+        for (segment in tail.split('|')) {
+            val (modifier, message) = parseModifier(segment)
+            if (modifier == null) {
+                error?.invoke(message)
+                return null
+            }
+            result.add(modifier)
+        }
+        return result
+    }
+
+    private fun validFormat(format: String): Boolean = try {
+        SimpleDateFormat(format, Locale.US)
+        true
+    } catch (e: IllegalArgumentException) {
+        false
+    }
+
+    private fun parseVariable(source: String, from: Int, till: Int, out: Parsing): Token {
+        val text = source.substring(from, till)
+        val body = source.substring(from + 1, till - 1)
+        var end = 0
+        while (end < body.length && body[end] != ':' && body[end] != '|') end++
+        val name = body.substring(0, end).trim()
+        var format = ""
+        var tail: String? = null
+        if (end < body.length && body[end] == ':') {
+            val rest = body.substring(end + 1)
+            if (formatted(name)) {
+                // a date format may hold a pipe, the modifiers start at the first pipe that parses
+                val pipes = pipes(rest)
+                val split = pipes.firstOrNull { parseModifiers(rest.substring(it + 1), null) != null } ?: -1
+                if (split >= 0) {
+                    format = rest.substring(0, split)
+                    tail = rest.substring(split + 1)
+                } else {
+                    format = rest
+                    if (pipes.isNotEmpty()) {
+                        val first = rest.substring(pipes.first() + 1).substringBefore('|').substringBefore(':').trim()
+                        out.errors.add("$text: ${quoted(first)} isn't a modifier, so it stays in the format")
+                    }
+                }
+            } else {
+                val pipe = rest.indexOf('|')
+                format = if (pipe < 0) rest else rest.substring(0, pipe)
+                if (pipe >= 0) tail = rest.substring(pipe + 1)
+            }
+        } else if (end < body.length) {
+            tail = body.substring(end + 1)
+        }
+        var invalid = false
+        var broken = false
+        var modifiers: List<Modifier> = emptyList()
+        if (tail != null) {
+            var error = ""
+            val parsed = parseModifiers(tail) { error = it }
+            if (parsed != null) {
+                modifiers = parsed
+            } else {
+                broken = true
+                invalid = true
+                out.errors.add("$text: $error")
+            }
+        }
+        if (name !in KNOWN) {
+            invalid = true
+            out.errors.add("$text: unknown variable")
+        } else if (formatted(name) && format.isNotEmpty() && !validFormat(format)) {
+            // java throws on a bad pattern, so the token stays as typed
+            broken = true
+            invalid = true
+            out.errors.add("$text: bad date format")
+        }
+        out.spans.add(Span(from, till, if (invalid) SpanType.INVALID else SpanType.VARIABLE))
+        return Token(
+            text = text,
+            name = name,
+            format = format,
+            modifiers = modifiers,
+            variable = true,
+            broken = broken,
+            brief = modifiers.any { it.name == "short" }
+        )
+    }
+
+    private fun unmatched(ch: Char) = "Unmatched $ch, use $ch$ch for a literal one"
+
+    private class Cursor(var position: Int)
+
+    /** Returns the tokens and whether a nested group found its closing bracket. */
+    private fun parseTokens(source: String, cursor: Cursor, nested: Boolean, out: Parsing): Pair<List<Token>, Boolean> {
+        val result = ArrayList<Token>()
+        val literal = StringBuilder()
+        fun flush() {
+            if (literal.isNotEmpty()) {
+                result.add(Token(text = literal.toString()))
+                literal.setLength(0)
+            }
+        }
+        fun invalid(at: Int, ch: Char) {
+            out.spans.add(Span(at, at + 1, SpanType.INVALID))
+            out.errors.add(unmatched(ch))
+        }
+        val size = source.length
+        while (cursor.position < size) {
+            val position = cursor.position
+            val ch = source[position]
+            val doubled = position + 1 < size && source[position + 1] == ch
+            if (doubled && (ch == '{' || ch == '}' || ch == '[' || ch == ']')) {
+                literal.append(ch)
+                cursor.position += 2
+            } else if (ch == '{') {
+                val end = source.indexOf('}', position + 1)
+                if (end < 0) {
+                    invalid(position, ch)
+                    literal.append(source, position, size)
+                    cursor.position = size
+                    break
+                }
+                flush()
+                result.add(parseVariable(source, position, end + 1, out))
+                cursor.position = end + 1
+            } else if (ch == '[') {
+                cursor.position = position + 1
+                val (group, closed) = parseTokens(source, cursor, true, out)
+                if (!closed) {
+                    invalid(position, ch)
+                    literal.append(ch)
+                    flush()
+                    result.addAll(group)
+                    break
+                }
+                out.spans.add(Span(position, position + 1, SpanType.BRACKET))
+                out.spans.add(Span(cursor.position - 1, cursor.position, SpanType.BRACKET))
+                flush()
+                result.add(Token(group = group, optional = true))
+            } else if (ch == ']' && nested) {
+                cursor.position++
+                flush()
+                return result to true
+            } else {
+                if (ch == ']' || ch == '}') invalid(position, ch)
+                literal.append(ch)
+                cursor.position++
+            }
+        }
+        flush()
+        return result to false
+    }
+
+    private fun tickFor(tokens: List<Token>): Tick {
+        var result = Tick.NONE
+        for (token in tokens) {
+            val tick = when {
+                token.optional -> tickFor(token.group)
+                !token.variable -> Tick.NONE
+                formatted(token.name) -> if (token.format.contains('s') || token.format.contains('S')) Tick.SECOND else Tick.MINUTE
+                token.name == "weekday" || token.name == "day" || token.name == "month" -> Tick.MINUTE
+                else -> Tick.NONE
+            }
+            if (tick > result) result = tick
+        }
+        return result
+    }
+
+    @JvmStatic
+    fun parse(source: String): Template {
+        val out = Parsing()
+        val (tokens, _) = parseTokens(source, Cursor(0), false, out)
+        return Template(tokens, out.spans.sortedBy { it.from }, out.errors.distinct(), tickFor(tokens))
+    }
+
+    private fun empty(value: String) = value.isEmpty() || value == "0"
+
+    private fun digits(value: String) = value.isNotEmpty() && value.all { it in '0'..'9' }
+
+    private fun word(text: String, first: Boolean): String {
+        val words = text.trim().split(Regex("\\s+")).filter { it.isNotEmpty() }
+        return if (words.isEmpty()) "" else if (first) words.first() else words.last()
+    }
+
+    private fun titled(text: String): String {
+        val result = StringBuilder(text.length)
+        var start = true
+        for (ch in text) {
+            if (ch.isWhitespace()) {
+                start = true
+                result.append(ch)
+            } else {
+                result.append(if (start) ch.uppercaseChar() else ch)
+                start = false
+            }
+        }
+        return result.toString()
+    }
+
+    private fun capitalized(text: String): String {
+        val index = text.indexOfFirst { !it.isWhitespace() }
+        return if (index < 0) text else text.substring(0, index) + text[index].uppercaseChar() + text.substring(index + 1)
+    }
+
+    private fun elided(text: String, limit: Int): String {
+        if (text.length <= limit) return text
+        var cut = limit - 1
+        if (cut > 0 && Character.isHighSurrogate(text[cut - 1])) cut--
+        while (cut > 0 && text[cut - 1].isWhitespace()) cut--
+        return text.substring(0, cut) + "\u2026"
+    }
+
+    private fun padded(text: String, width: Int): String =
+        if (text.length >= width) text else (if (digits(text)) "0" else " ").repeat(width - text.length) + text
+
+    /** Shortens a number like 1234 to 1.2k. */
+    @JvmStatic
+    fun compact(number: String): String {
+        if (!digits(number) || number.length > 15) return number
+        val value = number.toLong()
+        fun format(unit: Long, suffix: Char): String {
+            val whole = value / unit
+            val tenth = if (whole < 10) (value % unit) * 10 / unit else 0
+            return whole.toString() + (if (tenth != 0L) ".$tenth" else "") + suffix
+        }
+        return when {
+            value < 1000 -> number
+            value < 1000000 -> format(1000, 'k')
+            value < 1000000000 -> format(1000000, 'm')
+            else -> format(1000000000, 'b')
+        }
+    }
+
+    private fun apply(modifier: Modifier, text: String): Pair<String, Boolean> = when (modifier.name) {
+        "lower" -> text.lowercase() to false
+        "upper" -> text.uppercase() to false
+        "title" -> titled(text) to false
+        "cap" -> capitalized(text) to false
+        "first" -> word(text, true) to false
+        "last" -> word(text, false) to false
+        "k" -> compact(text) to false
+        "max" -> elided(text, modifier.number) to false
+        "pad" -> padded(text, modifier.number) to false
+        "default" -> if (empty(text)) modifier.argument to true else text to false
+        else -> text to false
+    }
+
+    /** Renders the tokens; a group gives null when a variable inside is empty or 0. */
+    private fun render(tokens: List<Token>, resolve: (Token) -> String?, optional: Boolean): String? {
+        val result = StringBuilder()
+        for (token in tokens) {
+            when {
+                token.optional -> result.append(render(token.group, resolve, true) ?: "")
+                !token.variable || token.broken -> result.append(token.text)
+                else -> {
+                    val value = resolve(token)
+                    if (value == null) {
+                        result.append(token.text)
+                        continue
+                    }
+                    var text: String = value
+                    var filled = false
+                    for (modifier in token.modifiers) {
+                        val (next, fill) = apply(modifier, text)
+                        text = next
+                        filled = filled || fill
+                    }
+                    if (optional && empty(value) && !filled) return null
+                    result.append(text)
+                }
+            }
+        }
+        return result.toString()
+    }
+
+    private fun counter(count: Int, brief: Boolean): String = count.toString().let { if (brief) compact(it) else it }
+
+    /** The unread count of the app badge, without the muted chats. */
+    private fun unread(): Int {
+        var count = 0
+        for (account in 0 until UserConfig.MAX_ACCOUNT_COUNT) {
+            if (!UserConfig.getInstance(account).isClientActivated) continue
+            if (!SharedConfig.showNotificationsForAllAccounts && account != UserConfig.selectedAccount) continue
+            count += NotificationsController.getInstance(account).totalUnreadCount
+        }
+        return count
+    }
+
+    private fun connecting(account: Int): Boolean = when (ConnectionsManager.getInstance(account).connectionState) {
+        ConnectionsManager.ConnectionStateConnecting,
+        ConnectionsManager.ConnectionStateWaitingForNetwork,
+        ConnectionsManager.ConnectionStateConnectingToProxy -> true
+        else -> false
+    }
+
+    private fun value(token: Token, account: Int, now: Date): String? {
+        val brief = token.brief
+        val user = UserConfig.getInstance(account).currentUser
+        return when (token.name) {
+            "build" -> if (TeleBuild.BUILD > 0) TeleBuild.BUILD.toString() else "dev"
+            "version" -> BuildVars.BUILD_VERSION_STRING.let { if (brief) it.split('.').take(2).joinToString(".") else it }
+            "time" -> SimpleDateFormat(token.format.ifEmpty { "HH:mm" }, Locale.getDefault()).format(now)
+            "date" -> if (token.format.isEmpty()) {
+                DateFormat.getDateInstance(DateFormat.SHORT, Locale.getDefault()).format(now)
+            } else {
+                SimpleDateFormat(token.format, Locale.getDefault()).format(now)
+            }
+            "weekday" -> SimpleDateFormat(if (brief) "EEE" else "EEEE", Locale.getDefault()).format(now)
+            "day" -> Calendar.getInstance().apply { time = now }.get(Calendar.DAY_OF_MONTH).toString()
+            "month" -> SimpleDateFormat(if (brief) "LLL" else "LLLL", Locale.getDefault()).format(now)
+            "name" -> when {
+                user == null -> ""
+                brief && !user.first_name.isNullOrEmpty() -> user.first_name
+                else -> UserObject.getUserName(user)
+            }
+            "username" -> user?.let { UserObject.getPublicUsername(it) }.orEmpty()
+            "id" -> user?.id?.toString().orEmpty()
+            "accounts" -> counter(UserConfig.getActivatedAccountsCount(), brief)
+            "unread" -> counter(unread(), brief)
+            "status" -> if (connecting(account)) (if (brief) "\u2026" else "connecting") else ""
+            else -> null
+        }
+    }
+
+    private var cachedSource: String? = null
+    private var cachedTemplate: Template? = null
+
+    private fun parsed(source: String): Template {
+        val cached = cachedTemplate
+        if (cached != null && cachedSource == source) return cached
+        return parse(source).also {
+            cachedSource = source
+            cachedTemplate = it
+        }
+    }
+
+    /** Renders any template, the editor previews with it. */
+    @JvmStatic
+    fun preview(account: Int, source: String): String {
+        val now = Date()
+        return render(parsed(source).tokens, { value(it, account, now) }, false).orEmpty()
+    }
+
+    /** The current title, empty when the template is empty. */
+    @JvmStatic
+    fun text(account: Int): String = preview(account, TeleConfig.TITLE_TEMPLATE.value)
+
+    private fun delay(tick: Tick): Long {
+        val period = if (tick == Tick.SECOND) 1000L else 60_000L
+        return period - System.currentTimeMillis() % period + 10
+    }
+
+    /** Keeps a title fresh while its view is attached: ticks for the time and listens for the counters. */
+    @JvmStatic
+    fun bind(view: View, account: Int, apply: Runnable) {
+        val binding = Binding(account, apply)
+        view.addOnAttachStateChangeListener(binding)
+        if (view.isAttachedToWindow) binding.onViewAttachedToWindow(view)
+    }
+
+    private class Binding(private val account: Int, private val apply: Runnable) :
+        View.OnAttachStateChangeListener, NotificationCenter.NotificationCenterDelegate, Runnable {
+
+        private var attached = false
+        private var last: String? = null
+
+        override fun onViewAttachedToWindow(v: View) {
+            if (attached) return
+            attached = true
+            val center = NotificationCenter.getInstance(account)
+            center.addObserver(this, NotificationCenter.updateInterfaces)
+            center.addObserver(this, NotificationCenter.dialogsUnreadCounterChanged)
+            center.addObserver(this, NotificationCenter.didUpdateConnectionState)
+            center.addObserver(this, NotificationCenter.mainUserInfoChanged)
+            NotificationCenter.getGlobalInstance().addObserver(this, NotificationCenter.notificationsCountUpdated)
+            // the template may have changed while the view was away
+            last = null
+            run()
+        }
+
+        override fun onViewDetachedFromWindow(v: View) {
+            if (!attached) return
+            attached = false
+            val center = NotificationCenter.getInstance(account)
+            center.removeObserver(this, NotificationCenter.updateInterfaces)
+            center.removeObserver(this, NotificationCenter.dialogsUnreadCounterChanged)
+            center.removeObserver(this, NotificationCenter.didUpdateConnectionState)
+            center.removeObserver(this, NotificationCenter.mainUserInfoChanged)
+            NotificationCenter.getGlobalInstance().removeObserver(this, NotificationCenter.notificationsCountUpdated)
+            AndroidUtilities.cancelRunOnUIThread(this)
+        }
+
+        override fun didReceivedNotification(id: Int, account: Int, vararg args: Any?) {
+            if (id == NotificationCenter.updateInterfaces) {
+                val mask = args.firstOrNull() as? Int ?: return
+                if (mask and MessagesController.UPDATE_MASK_NAME == 0) return
+            }
+            push()
+        }
+
+        private fun push() {
+            val text = text(account)
+            if (text == last) return
+            last = text
+            apply.run()
+        }
+
+        override fun run() {
+            AndroidUtilities.cancelRunOnUIThread(this)
+            push()
+            val tick = parsed(TeleConfig.TITLE_TEMPLATE.value).tick
+            if (attached && tick != Tick.NONE) AndroidUtilities.runOnUIThread(this, delay(tick))
+        }
+    }
+}
