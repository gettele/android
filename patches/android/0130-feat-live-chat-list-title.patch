diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleTitleEditor.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleTitleEditor.kt
new file mode 100644
index 000000000..4067588c8
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleTitleEditor.kt
@@ -0,0 +1,304 @@
+package tele.ui.settings
+
+import android.content.Context
+import android.text.Editable
+import android.text.Spanned
+import android.text.TextWatcher
+import android.text.style.BackgroundColorSpan
+import android.text.style.ForegroundColorSpan
+import android.util.TypedValue
+import android.view.View
+import android.view.ViewGroup
+import android.widget.LinearLayout
+import android.widget.ScrollView
+import android.widget.TextView
+import androidx.core.graphics.ColorUtils
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.R
+import org.telegram.messenger.UserConfig
+import org.telegram.ui.ActionBar.AlertDialog
+import org.telegram.ui.ActionBar.BaseFragment
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Components.EditTextBoldCursor
+import tele.TeleConfig
+import tele.TeleHooks
+import tele.helpers.TeleTitle
+
+/** The editor of the chat list title template, a port of the desktop title template box. */
+object TeleTitleEditor {
+
+    private class Variable(val name: String, val variants: List<String>)
+
+    private class Group(val title: String, val variables: List<Variable>)
+
+    private val GROUPS = listOf(
+        Group("App", listOf(
+            Variable("build", listOf("")),
+            Variable("version", listOf("", "|short"))
+        )),
+        Group("Time", listOf(
+            Variable("time", listOf("", ":HH:mm:ss", ":h:mm a")),
+            Variable("date", listOf("", ":dd MMM", ":dd.MM.yyyy", ":yyyy-MM-dd")),
+            Variable("weekday", listOf("", "|short", "|lower", "|short|lower")),
+            Variable("day", listOf("", "|pad:2")),
+            Variable("month", listOf("", "|short", "|lower", "|short|lower"))
+        )),
+        Group("Account", listOf(
+            Variable("name", listOf("", "|short", "|upper")),
+            Variable("username", listOf("", "|upper")),
+            Variable("id", listOf("")),
+            Variable("accounts", listOf(""))
+        )),
+        Group("State", listOf(
+            Variable("unread", listOf("", "|k", "|default:no")),
+            Variable("status", listOf("", "|short", "|upper", "|default:online"))
+        ))
+    )
+
+    private val PRESETS = listOf(
+        "",
+        "tele {build}",
+        "tele #{build}",
+        "{time:HH:mm} \u00B7 {weekday|short}",
+        "{name}[ \u00B7 {unread} unread]",
+        "{weekday|short|lower} {day} {month|short|lower} \u00B7 {time}",
+        "[{status} \u00B7 ]tele {build}",
+        "tele {version|short}[ \u00B7 {unread|k}]"
+    )
+
+    private const val HELP = "Tap a variable to insert it, hold it for other forms. Modifiers go after |, left to right: " +
+        "lower, upper, title, cap, short, first, last, max:20, pad:2, k, default:text. [ \u2026 ] hides its part when a " +
+        "variable inside is empty or 0, doubled brackets are literal. Time and date formats are java patterns, like HH:mm or dd MMM."
+
+    // the spans of the editor are told apart from the ones the keyboard adds
+    private class Mark(color: Int) : ForegroundColorSpan(color)
+    private class Chip(color: Int) : BackgroundColorSpan(color)
+
+    /** The value shown in the settings row. */
+    @JvmStatic
+    fun summary(): String = TeleConfig.TITLE_TEMPLATE.value.ifEmpty { "App name" }
+
+    private fun dp(value: Float) = AndroidUtilities.dp(value)
+
+    @JvmStatic
+    fun show(fragment: BaseFragment, onSaved: Runnable) {
+        val context = fragment.parentActivity ?: return
+        val provider = fragment.resourceProvider
+        val account = UserConfig.selectedAccount
+        fun color(key: Int) = Theme.getColor(key, provider)
+        val accent = color(Theme.key_windowBackgroundWhiteBlueText4)
+        val error = color(Theme.key_text_RedRegular)
+        val gray = color(Theme.key_windowBackgroundWhiteGrayText)
+
+        val content = LinearLayout(context)
+        content.orientation = LinearLayout.VERTICAL
+        content.setPadding(dp(24f), dp(4f), dp(24f), dp(8f))
+
+        val field = EditTextBoldCursor(context)
+        field.setSingleLine(true)
+        field.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 17f)
+        field.setTextColor(color(Theme.key_windowBackgroundWhiteBlackText))
+        field.setHintTextColor(color(Theme.key_windowBackgroundWhiteHintText))
+        field.hint = "Template"
+        field.setBackgroundDrawable(null)
+        field.setLineColors(
+            color(Theme.key_windowBackgroundWhiteInputField),
+            color(Theme.key_windowBackgroundWhiteInputFieldActivated),
+            error
+        )
+        field.setCursorColor(color(Theme.key_windowBackgroundWhiteBlackText))
+        field.setCursorSize(dp(20f))
+        content.addView(field, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, dp(44f)))
+
+        val preview = TextView(context)
+        preview.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16f)
+        preview.typeface = AndroidUtilities.bold()
+        preview.setTextColor(color(Theme.key_windowBackgroundWhiteBlackText))
+        content.addView(preview, linear(top = 8f))
+
+        val errors = TextView(context)
+        errors.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13f)
+        errors.setTextColor(error)
+        errors.visibility = View.GONE
+        content.addView(errors, linear(top = 4f))
+
+        fun refreshPreview() {
+            val text = TeleTitle.preview(account, field.text.toString())
+            preview.text = text.ifEmpty { "App name" }
+            preview.setTextColor(if (text.isEmpty()) gray else color(Theme.key_windowBackgroundWhiteBlackText))
+        }
+
+        fun highlight(editable: Editable) {
+            editable.getSpans(0, editable.length, Mark::class.java).forEach { editable.removeSpan(it) }
+            editable.getSpans(0, editable.length, Chip::class.java).forEach { editable.removeSpan(it) }
+            val template = TeleTitle.parse(editable.toString())
+            for (span in template.spans) {
+                val tint = if (span.type == TeleTitle.SpanType.INVALID) error else accent
+                editable.setSpan(Mark(tint), span.from, span.till, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
+                if (span.type != TeleTitle.SpanType.BRACKET) {
+                    editable.setSpan(Chip(ColorUtils.setAlphaComponent(tint, 40)), span.from, span.till, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
+                }
+            }
+            errors.text = template.errors.joinToString("\n")
+            errors.visibility = if (template.errors.isEmpty()) View.GONE else View.VISIBLE
+        }
+
+        field.addTextChangedListener(object : TextWatcher {
+            override fun beforeTextChanged(s: CharSequence?, start: Int, count: Int, after: Int) {}
+            override fun onTextChanged(s: CharSequence?, start: Int, before: Int, count: Int) {}
+            override fun afterTextChanged(s: Editable) {
+                highlight(s)
+                refreshPreview()
+            }
+        })
+
+        fun setTemplate(text: String) {
+            field.setText(text)
+            field.setSelection(text.length)
+            field.requestFocus()
+        }
+
+        fun insert(token: String) {
+            val editable = field.text ?: return
+            val start = maxOf(0, minOf(field.selectionStart, field.selectionEnd))
+            val end = maxOf(0, maxOf(field.selectionStart, field.selectionEnd))
+            editable.replace(start, end, token)
+            field.requestFocus()
+        }
+
+        val links = LinearLayout(context)
+        links.orientation = LinearLayout.HORIZONTAL
+        fun link(title: String, action: () -> Unit): TextView {
+            val view = TextView(context)
+            view.text = title
+            view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14f)
+            view.setTextColor(accent)
+            view.setPadding(0, dp(8f), dp(20f), dp(8f))
+            view.setOnClickListener { action() }
+            links.addView(view)
+            return view
+        }
+        link("Presets") {
+            val labels = PRESETS.map { if (it.isEmpty()) "App name" else it }.toTypedArray()
+            builder(context, provider).setTitle("Presets").setItems(labels) { _, which -> setTemplate(PRESETS[which]) }.show()
+        }
+        link("Reset") { setTemplate(TeleConfig.TITLE_TEMPLATE.default) }
+        content.addView(links, linear(top = 4f))
+
+        for (group in GROUPS) {
+            val caption = TextView(context)
+            caption.text = group.title.lowercase()
+            caption.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13f)
+            caption.setTextColor(gray)
+            content.addView(caption, linear(top = 8f))
+            val flow = FlowLayout(context, dp(6f))
+            for (variable in group.variables) {
+                val chip = TextView(context)
+                chip.text = variable.name
+                chip.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14f)
+                chip.setTextColor(accent)
+                chip.setPadding(dp(10f), dp(5f), dp(10f), dp(5f))
+                chip.background = Theme.createSimpleSelectorRoundRectDrawable(dp(14f), ColorUtils.setAlphaComponent(accent, 26), ColorUtils.setAlphaComponent(accent, 60))
+                chip.setOnClickListener { insert("{${variable.name}}") }
+                chip.setOnLongClickListener {
+                    val tokens = variable.variants.map { "{${variable.name}$it}" }
+                    val labels = tokens.map { token ->
+                        val value = TeleTitle.preview(account, token)
+                        "$token \u2192 ${value.ifEmpty { "empty now" }}"
+                    }.toTypedArray()
+                    builder(context, provider).setTitle(variable.name).setItems(labels) { _, which -> insert(tokens[which]) }.show()
+                    true
+                }
+                flow.addView(chip)
+            }
+            content.addView(flow, linear(top = 4f))
+        }
+
+        val help = TextView(context)
+        help.text = HELP
+        help.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13f)
+        help.setTextColor(gray)
+        content.addView(help, linear(top = 12f))
+
+        setTemplate(TeleConfig.TITLE_TEMPLATE.value)
+        // the time in the preview stays live while the editor is open
+        val ticker = object : Runnable {
+            override fun run() {
+                if (!content.isAttachedToWindow) return
+                refreshPreview()
+                content.postDelayed(this, 1000)
+            }
+        }
+        content.addOnAttachStateChangeListener(object : View.OnAttachStateChangeListener {
+            override fun onViewAttachedToWindow(v: View) {
+                content.postDelayed(ticker, 1000)
+            }
+
+            override fun onViewDetachedFromWindow(v: View) {
+                content.removeCallbacks(ticker)
+            }
+        })
+
+        val scroll = ScrollView(context)
+        scroll.addView(content)
+        val dialog = builder(context, provider)
+            .setTitle("Chat list title")
+            .setView(scroll)
+            .setPositiveButton(LocaleController.getString(R.string.Save)) { _, _ ->
+                TeleConfig.set(TeleConfig.TITLE_TEMPLATE, field.text.toString())
+                TeleHooks.onConfigChanged(TeleConfig.TITLE_TEMPLATE)
+                onSaved.run()
+            }
+            .setNegativeButton(LocaleController.getString(R.string.Cancel), null)
+            .create()
+        fragment.showDialog(dialog)
+    }
+
+    private fun builder(context: Context, provider: Theme.ResourcesProvider?) =
+        if (provider != null) AlertDialog.Builder(context, provider) else AlertDialog.Builder(context)
+
+    private fun linear(top: Float) = LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT).apply {
+        topMargin = AndroidUtilities.dp(top)
+    }
+
+    /** Lays the chips out in rows that wrap. */
+    private class FlowLayout(context: Context, private val gap: Int) : ViewGroup(context) {
+        override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
+            val width = MeasureSpec.getSize(widthMeasureSpec)
+            var x = 0
+            var y = 0
+            var rowHeight = 0
+            for (i in 0 until childCount) {
+                val child = getChildAt(i)
+                child.measure(MeasureSpec.makeMeasureSpec(width, MeasureSpec.AT_MOST), MeasureSpec.UNSPECIFIED)
+                if (x > 0 && x + child.measuredWidth > width) {
+                    x = 0
+                    y += rowHeight + gap
+                    rowHeight = 0
+                }
+                x += child.measuredWidth + gap
+                rowHeight = maxOf(rowHeight, child.measuredHeight)
+            }
+            setMeasuredDimension(width, y + rowHeight)
+        }
+
+        override fun onLayout(changed: Boolean, l: Int, t: Int, r: Int, b: Int) {
+            val width = r - l
+            var x = 0
+            var y = 0
+            var rowHeight = 0
+            for (i in 0 until childCount) {
+                val child = getChildAt(i)
+                if (x > 0 && x + child.measuredWidth > width) {
+                    x = 0
+                    y += rowHeight + gap
+                    rowHeight = 0
+                }
+                child.layout(x, y, x + child.measuredWidth, y + child.measuredHeight)
+                x += child.measuredWidth + gap
+                rowHeight = maxOf(rowHeight, child.measuredHeight)
+            }
+        }
+    }
+}
