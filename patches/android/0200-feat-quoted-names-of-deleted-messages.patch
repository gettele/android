+    // Style of the quoted author name; the default and unknown values keep the plain bold name.
+    private fun nameEntity(account: Int, message: TLRPC.Message?): TLRPC.MessageEntity? {
+        val mode = TeleConfig.DELETED_QUOTE_NAME.value
+        if (message == null || (mode != "link" && mode != "mention")) return null
+        val controller = MessagesController.getInstance(account)
+        val userId = message.from_id?.user_id ?: 0L
+        val user = if (userId != 0L) controller.getUser(userId) else null
+        if (user != null && mode == "mention") {
+            val input = controller.getInputUser(user)
+            // an input user without access hash is rejected by the server
+            if (input !is TLRPC.TL_inputUser || input.access_hash != 0L) {
+                return TLRPC.TL_inputMessageEntityMentionName().also { it.user_id = input }
+            }
+        }
+        val username = if (user != null) {
+            UserObject.getPublicUsername(user)
+        } else {
+            val chatId = message.from_id?.channel_id ?: message.from_id?.chat_id ?: 0L
+            if (chatId != 0L) ChatObject.getPublicUsername(controller.getChat(chatId)) else null
+        }
+        if (username.isNullOrEmpty()) return null
+        return TLRPC.TL_messageEntityTextUrl().also { it.url = "https://t.me/$username" }
+    }
+
     internal fun copyEntity(entity: TLRPC.MessageEntity, shift: Int): TLRPC.MessageEntity {
         val copy = when (entity) {
             is TLRPC.TL_messageEntityBold -> TLRPC.TL_messageEntityBold()
@@ -117,17 +143,24 @@ object DeletedReply {
         blockquote.offset = 0
