             bold.offset = 0
             bold.length = name.length
             entities.add(bold)
+            nameEntity(account, stored)?.let { link ->
+                link.offset = 0
+                link.length = name.length
+                entities.add(link)
+                linked = link is TLRPC.TL_messageEntityTextUrl
+            }
         }
         if (!own.isEmpty()) {
             val shift = prefix.length + 1
             ownEntities?.forEach { entity -> entities.add(copyEntity(entity, shift)) }
         }
         entities.sortBy { it.offset }
-        return QuoteResult(text, entities)
+        return QuoteResult(text, entities, linked)
     }
