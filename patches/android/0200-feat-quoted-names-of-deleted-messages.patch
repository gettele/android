+    private fun chooseDeletedQuoteName() {
+        val activity = parentActivity ?: return
+        val values = arrayOf("", "link", "mention")
+        val labels = arrayOf(lc("Bold"), lc("Link"), lc("Mention"))
+        val builder = if (resourceProvider != null) AlertDialog.Builder(activity, resourceProvider) else AlertDialog.Builder(activity)
+        builder.setTitle(lc("Name in quotes"))
+        builder.setMessage(lc("How the author's name is shown in a quote of a deleted message. A link needs a username; a mention notifies the author."))
+        builder.setItems(labels) { _, which ->
+            TeleConfig.set(TeleConfig.DELETED_QUOTE_NAME, values[which])
+            refresh()
+        }
+        showDialog(builder.create())
+    }
