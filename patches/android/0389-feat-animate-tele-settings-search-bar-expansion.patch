From: test <test@example.com>
Date: Thu, 26 Nov 2026 21:51:11 +0300
Subject: [PATCH] feat: animate tele settings search bar expansion

---
 .../tele/ui/settings/TeleSettingsActivity.kt  | 24 +++++++++----------
 1 file changed, 11 insertions(+), 13 deletions(-)

diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
index 76050ffb3..32bd33854 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
@@ -88,6 +88,9 @@ class TeleSettingsActivity @JvmOverloads constructor(
     private var searchHits: List<SearchHit> = emptyList()
 
     override fun getListViewForSimpleGlass(): RecyclerListView? = listView
+    protected override fun useSimpleActionBar(): Boolean = true
+
+    protected override fun useFadeDrawableForActionBar(): Boolean = false
 
     override fun isSupportEdgeToEdge(): Boolean = true
 
@@ -600,10 +603,10 @@ class TeleSettingsActivity @JvmOverloads constructor(
             jumpTo != null -> withGroups(page).indexOfFirst { it.title == jumpTo }
             else -> -1
         }
-        actionBar.setBackButtonImage(R.drawable.ic_ab_back)
-        actionBar.setAllowOverlayTitle(true)
-        actionBar.setTitle(lc(sectionTitle()))
-        actionBar.setActionBarMenuOnItemClick(object : ActionBar.ActionBarMenuOnItemClick() {
+        simpleActionBar.setBackButtonImage(R.drawable.ic_ab_back)
+        simpleActionBar.setTitle(lc(sectionTitle()))
+        simpleActionBar.setBackground(null)
+        simpleActionBar.setActionBarMenuOnItemClick(object : ActionBar.ActionBarMenuOnItemClick() {
             override fun onItemClick(id: Int) {
                 if (id == -1) {
                     if (hasMainTabs) {
@@ -991,8 +994,8 @@ class TeleSettingsActivity @JvmOverloads constructor(
         }
 
     private fun setupNewPage() {
-        actionBar.createMenu().addItem(SEARCH_ITEM, R.drawable.outline_header_search)
-            .setIsSearchField(true, false)
+        simpleActionBar.createMenu().addItem(SEARCH_ITEM, R.drawable.outline_header_search)
+            .setIsSearchField(true)
             .setActionBarMenuItemSearchListener(object : ActionBarMenuItem.ActionBarMenuItemSearchListener() {
                 override fun onSearchExpand() {
                     searchNew("")
@@ -1012,8 +1015,8 @@ class TeleSettingsActivity @JvmOverloads constructor(
     }
 
     private fun setupSearch() {
-        val searchItem = actionBar.createMenu().addItem(SEARCH_ITEM, R.drawable.outline_header_search)
-        searchItem.setIsSearchField(true, false)
+        val searchItem = simpleActionBar.createMenu().addItem(SEARCH_ITEM, R.drawable.outline_header_search)
+        searchItem.setIsSearchField(true)
             .setActionBarMenuItemSearchListener(object : ActionBarMenuItem.ActionBarMenuItemSearchListener() {
                 override fun onSearchExpand() {
                     searchActive = true
@@ -1134,11 +1137,6 @@ class TeleSettingsActivity @JvmOverloads constructor(
         view.setBackgroundColor(background)
         listView?.setBackgroundColor(background)
         listView?.adapter?.update(false)
-        actionBar?.setBackgroundColor(Theme.getColor(Theme.key_actionBarDefault))
-        actionBar?.setItemsColor(Theme.getColor(Theme.key_actionBarDefaultIcon), false)
-        actionBar?.setItemsColor(Theme.getColor(Theme.key_actionBarDefaultIcon), true)
-        actionBar?.setTitleColor(Theme.getColor(Theme.key_actionBarDefaultTitle))
-        actionBar?.setSubtitleColor(Theme.getColor(Theme.key_actionBarDefaultSubtitle))
     }
 
     private fun lc(text: String): String = TeleLowercase.lc(text)
