diff --git a/TMessagesProj/src/main/java/tele/helpers/GhostPending.kt b/TMessagesProj/src/main/java/tele/helpers/GhostPending.kt
new file mode 100644
index 000000000..e109e27e7
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/GhostPending.kt
@@ -0,0 +1,173 @@
+package tele.helpers
+
+import android.os.SystemClock
+import org.json.JSONArray
+import org.json.JSONObject
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.ApplicationLoader
+import org.telegram.messenger.ChatObject
+import org.telegram.messenger.DialogObject
+import org.telegram.messenger.FileLog
+import org.telegram.messenger.MediaDataController
+import org.telegram.messenger.MessageObject
+import org.telegram.messenger.MessagesController
+import org.telegram.messenger.MessagesStorage
+import org.telegram.messenger.NotificationCenter
+import org.telegram.messenger.StatsController
+import org.telegram.messenger.Utilities
+import org.telegram.tgnet.TLObject
+import org.telegram.tgnet.TLRPC
+import org.telegram.tgnet.tl.TL_update
+import tele.db.TeleDatabaseHelper
+import java.util.Collections
+import java.util.WeakHashMap
+
+/**
+ * The waiting copy of a ghost scheduled message. It keeps its local (negative) id the whole time:
+ * the server's scheduled id lives in its own id space and may equal the id of a real message.
+ * The copy goes when the server reports the scheduled message as sent or deleted.
+ */
+object GhostPending {
+
+    private const val KEY = "ghost_pending"
+    private const val MAX_ENTRIES = 200
+    private const val RECENT_MS = 10 * 60_000L
+
+    private class Local(val account: Int, val dialogId: Long) {
+        @Volatile
+        var sent = false
+    }
+
+    private class Entry(val account: Int, val dialogId: Long, val localId: Int, val sentId: Int)
+
+    // weak: a message that never gets its response must not stay here
+    private val local = Collections.synchronizedMap(WeakHashMap<TLRPC.Message, Local>())
+    private val lock = Any()
+    private val entries = ArrayList<Entry>()
+    // scheduled ids reported sent before the send response was handled
+    private val recent = LinkedHashMap<String, Long>()
+    private var loaded = false
+
+    @JvmStatic
+    fun track(account: Int, msgObj: MessageObject) {
+        val message = msgObj.messageOwner ?: return
+        local[message] = Local(account, msgObj.dialogId)
+    }
+
+    @JvmStatic
+    fun isTracked(message: TLRPC.Message?): Boolean = message != null && local.containsKey(message)
+
+    /** Handles the response of a tracked message; false leaves it to the stock handler. */
+    @JvmStatic
+    fun sent(account: Int, msgObj: MessageObject, response: TLObject?): Boolean {
+        val message = msgObj.messageOwner ?: return false
+        val own = local[message] ?: return false
+        val updates = response as? TLRPC.Updates ?: return false
+        val sentId = updates.updates.filterIsInstance<TL_update.TL_updateNewScheduledMessage>().firstOrNull()?.message?.id ?: 0
+        if (sentId == 0) return false
+        // the stock id update would rename the local row to the scheduled id
+        updates.updates.removeAll {
+            it is TL_update.TL_updateNewScheduledMessage || it is TL_update.TL_updateMessageID && it.random_id == message.random_id
+        }
+        val dialogId = msgObj.dialogId
+        message.send_state = MessageObject.MESSAGE_SEND_STATE_SENT
+        MessagesStorage.getInstance(account).updateMessageStateAndId(message.random_id, dialogId, message.id, message.id, message.date, true, 0, 0)
+        StatsController.getInstance(account).incrementSentItemsCount(ApplicationLoader.getCurrentNetworkType(), StatsController.TYPE_MESSAGES, 1)
+        MediaDataController.getInstance(account).increasePeerRaiting(dialogId)
+        Utilities.stageQueue.postRunnable { MessagesController.getInstance(account).processUpdates(updates, false) }
+        NotificationCenter.getInstance(account).postNotificationName(NotificationCenter.messageReceivedByAck, message.id)
+
+        var late = false
+        synchronized(lock) {
+            ensureLoaded()
+            if (recent.remove(key(account, dialogId, sentId)) != null) {
+                late = true
+            } else {
+                entries.add(Entry(account, dialogId, message.id, sentId))
+                while (entries.size > MAX_ENTRIES) entries.removeAt(0)
+            }
+            // after the entry exists: a send that is still in flight records the ids fired in the meantime
+            own.sent = true
+        }
+        if (late) {
+            drop(account, dialogId, arrayListOf(message.id))
+        } else {
+            persist()
+        }
+        return true
+    }
+
+    /** The server sent or deleted these scheduled messages; runs on the stage queue before the sent message is posted. */
+    @JvmStatic
+    fun fired(account: Int, dialogId: Long, ids: List<Int>) {
+        if (ids.isEmpty()) return
+        val gone = ArrayList<Int>()
+        synchronized(lock) {
+            ensureLoaded()
+            val now = SystemClock.elapsedRealtime()
+            recent.values.removeAll { now - it > RECENT_MS }
+            val waiting = inFlight(account, dialogId)
+            for (id in ids) {
+                val entry = entries.firstOrNull { it.account == account && it.dialogId == dialogId && it.sentId == id }
+                if (entry != null) {
+                    entries.remove(entry)
+                    gone.add(entry.localId)
+                } else if (waiting) {
+                    recent[key(account, dialogId, id)] = now
+                }
+            }
+        }
+        if (gone.isEmpty()) return
+        persist()
+        drop(account, dialogId, gone)
+    }
+
+    private fun inFlight(account: Int, dialogId: Long): Boolean = synchronized(local) {
+        local.values.any { it.account == account && it.dialogId == dialogId && !it.sent }
+    }
+
+    // like the stock local delete, but flagged as sent: the chat then removes the copy without the dust effect
+    private fun drop(account: Int, dialogId: Long, ids: ArrayList<Int>) {
+        AndroidUtilities.runOnUIThread {
+            val controller = MessagesController.getInstance(account)
+            val storage = MessagesStorage.getInstance(account)
+            val channelId = if (DialogObject.isChatDialog(dialogId)) controller.getChat(-dialogId).let { if (ChatObject.isChannel(it)) it.id else 0L } else 0L
+            if (channelId == 0L) {
+                for (id in ids) controller.dialogMessagesByIds.get(id)?.deleted = true
+            } else {
+                controller.markDialogMessageAsDeleted(dialogId, ids)
+            }
+            storage.markMessagesAsDeleted(dialogId, ids, true, false, 0, 0)
+            storage.updateDialogsWithDeletedMessages(dialogId, channelId, ids, null)
+            NotificationCenter.getInstance(account).postNotificationName(NotificationCenter.messagesDeleted, ids, channelId, false, true, false, 0, null, false)
+        }
+    }
+
+    private fun key(account: Int, dialogId: Long, sentId: Int) = "$account:$dialogId:$sentId"
+
+    // under [lock]
+    private fun ensureLoaded() {
+        if (loaded) return
+        loaded = true
+        val raw = runCatching { TeleDatabaseHelper.get(KEY) }.getOrNull() ?: return
+        runCatching {
+            val array = JSONArray(raw)
+            for (i in 0 until array.length()) {
+                val o = array.getJSONObject(i)
+                entries.add(Entry(o.getInt("a"), o.getLong("d"), o.getInt("l"), o.getInt("s")))
+            }
+        }.onFailure { FileLog.e(it) }
+    }
+
+    // survives a restart: the waiting copy is stored in the chat, so its scheduled id must not be lost
+    private fun persist() {
+        Utilities.globalQueue.postRunnable {
+            val json = synchronized(lock) {
+                if (entries.isEmpty()) null else JSONArray().also { array ->
+                    for (e in entries) array.put(JSONObject().put("a", e.account).put("d", e.dialogId).put("l", e.localId).put("s", e.sentId))
+                }.toString()
+            }
+            runCatching { TeleDatabaseHelper.put(KEY, json) }.onFailure { FileLog.e(it) }
+        }
+    }
+}
