diff --git a/TMessagesProj/src/main/java/tele/helpers/TeleEyedropper.kt b/TMessagesProj/src/main/java/tele/helpers/TeleEyedropper.kt
new file mode 100644
index 000000000..b7d571c47
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/TeleEyedropper.kt
@@ -0,0 +1,120 @@
+package tele.helpers
+
+import android.graphics.Bitmap
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Matrix
+import android.graphics.PorterDuff
+import android.graphics.PorterDuffColorFilter
+import android.graphics.drawable.LayerDrawable
+import android.view.Gravity
+import android.view.TextureView
+import android.view.View
+import android.view.ViewGroup
+import android.widget.ImageView
+import androidx.core.util.Consumer
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.R
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Components.LayoutHelper
+import org.telegram.ui.Components.Paint.Views.PipettePickerView
+import tele.TeleConfig
+
+object TeleEyedropper {
+    private const val PILL_COLOR = 0xff191919.toInt()
+
+    @JvmStatic
+    fun createButton(host: ViewGroup, photo: Bitmap?, onClick: Runnable): View? {
+        if (!TeleConfig.EDITOR_EYEDROPPER.value || photo == null) return null
+        val button = ImageView(host.context)
+        button.scaleType = ImageView.ScaleType.CENTER
+        button.setImageResource(R.drawable.picker)
+        button.colorFilter = PorterDuffColorFilter(Color.WHITE, PorterDuff.Mode.SRC_IN)
+        button.setPadding(AndroidUtilities.dp(6f), AndroidUtilities.dp(6f), AndroidUtilities.dp(6f), AndroidUtilities.dp(6f))
+        button.background = LayerDrawable(arrayOf(
+            Theme.createCircleDrawable(AndroidUtilities.dp(32f), PILL_COLOR),
+            Theme.createSelectorDrawable(Theme.ACTION_BAR_WHITE_SELECTOR_COLOR)
+        ))
+        button.alpha = 0f
+        button.visibility = View.GONE
+        button.setOnClickListener { onClick.run() }
+        host.addView(button, LayoutHelper.createFrame(32, 32f, Gravity.TOP or Gravity.RIGHT, 0f, 12f, 12f, 0f))
+        return button
+    }
+
+    @JvmStatic
+    fun setProgress(button: View?, progress: Float) {
+        button ?: return
+        button.alpha = progress
+        val scale = 0.6f + 0.4f * progress
+        button.scaleX = scale
+        button.scaleY = scale
+        button.visibility = if (progress <= 0f) View.GONE else View.VISIBLE
+        button.isClickable = progress > 0.5f
+    }
+
+    @JvmStatic
+    fun start(
+        paintView: ViewGroup, container: ViewGroup, renderView: View, entities: View,
+        photo: Bitmap, photoRotation: Int, onPicked: Consumer<Int>
+    ) {
+        if (container.childCount > 0) return
+        val bitmap = try {
+            composite(paintView, renderView, entities, photo, photoRotation)
+        } catch (_: Throwable) {
+            return
+        }
+        val view = PipettePickerView(paintView.context, bitmap)
+        view.setColorListener(onPicked)
+        container.addView(view, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.MATCH_PARENT.toFloat()))
+        view.animateShow()
+    }
+
+    @JvmStatic
+    fun cancel(container: ViewGroup): Boolean {
+        val view = container.getChildAt(0) as? PipettePickerView ?: return false
+        view.animateDisappear(false)
+        return true
+    }
+
+    private fun composite(paintView: ViewGroup, renderView: View, entities: View, photo: Bitmap, photoRotation: Int): Bitmap {
+        val bitmap = Bitmap.createBitmap(paintView.width, paintView.height, Bitmap.Config.ARGB_8888)
+        val canvas = Canvas(bitmap)
+        canvas.drawColor(Color.BLACK)
+
+        canvas.save()
+        canvas.concat(toParent(renderView))
+        val rotation = ((photoRotation % 360) + 360) % 360
+        val sideways = rotation == 90 || rotation == 270
+        val bw = photo.width.toFloat()
+        val bh = photo.height.toFloat()
+        val rotW = if (sideways) bh else bw
+        val rotH = if (sideways) bw else bh
+        val rw = renderView.width.toFloat()
+        val rh = renderView.height.toFloat()
+        val photoMatrix = Matrix()
+        photoMatrix.postTranslate(-bw / 2f, -bh / 2f)
+        photoMatrix.postRotate(rotation.toFloat())
+        photoMatrix.postScale(rw / rotW, rh / rotH)
+        photoMatrix.postTranslate(rw / 2f, rh / 2f)
+        canvas.drawBitmap(photo, photoMatrix, null)
+        (renderView as? TextureView)?.getBitmap()?.let {
+            canvas.drawBitmap(it, 0f, 0f, null)
+            it.recycle()
+        }
+        canvas.restore()
+
+        canvas.save()
+        canvas.concat(toParent(entities))
+        entities.draw(canvas)
+        canvas.restore()
+        return bitmap
+    }
+
+    private fun toParent(v: View) = Matrix().apply {
+        postTranslate(-v.pivotX, -v.pivotY)
+        postScale(v.scaleX, v.scaleY)
+        postRotate(v.rotation)
+        postTranslate(v.pivotX + v.left + v.translationX, v.pivotY + v.top + v.translationY)
+    }
+}
