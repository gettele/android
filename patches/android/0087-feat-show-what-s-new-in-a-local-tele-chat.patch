+package tele.ui.settings
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Typeface
+import android.text.style.CharacterStyle
+import android.text.style.URLSpan
+import android.view.Gravity
+import android.view.View
+import android.view.ViewGroup
+import android.widget.TextView
+import androidx.recyclerview.widget.LinearLayoutManager
+import androidx.recyclerview.widget.RecyclerView
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.ChatMessageSharedResources
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.MessageObject
+import org.telegram.messenger.NotificationCenter
+import org.telegram.messenger.R
+import org.telegram.messenger.browser.Browser
+import org.telegram.tgnet.TLRPC
+import org.telegram.tgnet.tl.TL_keyboard
+import org.telegram.ui.ActionBar.ActionBar
+import org.telegram.ui.ActionBar.BaseFragment
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Cells.ChatMessageCell
+import org.telegram.ui.Components.LayoutHelper
+import org.telegram.ui.Components.RecyclerListView
+import org.telegram.ui.Components.SizeNotifierFrameLayout
+import tele.helpers.TeleChat
+
+// the local tele chat (tele 0075): release notes as incoming bubbles over the chat wallpaper
+class TeleChatActivity : BaseFragment(), NotificationCenter.NotificationCenterDelegate {
+
+    private var items: List<Any> = emptyList()
+    private var adapter: Adapter? = null
+    private var sharedResources: ChatMessageSharedResources? = null
+
+    private fun reload() {
+        val result = ArrayList<Any>()
+        var lastDay = ""
+        for (message in TeleChat.messages(currentAccount)) {
+            val day = LocaleController.formatDateChat(message.date.toLong())
+            if (day != lastDay) {
+                result.add(day)
+                lastDay = day
+            }
+            result.add(MessageObject(currentAccount, message, true, false))
+        }
+        items = result
+        adapter?.notifyDataSetChanged()
+    }
+
+    override fun onFragmentCreate(): Boolean {
+        notificationCenter.addObserver(this, NotificationCenter.dialogsNeedReload)
+        reload()
+        return super.onFragmentCreate()
+    }
+
+    override fun onFragmentDestroy() {
+        notificationCenter.removeObserver(this, NotificationCenter.dialogsNeedReload)
+        super.onFragmentDestroy()
+    }
+
+    override fun didReceivedNotification(id: Int, account: Int, vararg args: Any?) {
+        if (id == NotificationCenter.dialogsNeedReload && TeleChat.messages(currentAccount).size != items.count { it is MessageObject }) {
+            reload()
+        }
+    }
+
+    override fun onResume() {
+        super.onResume()
+        TeleChat.markRead(currentAccount)
+    }
+
+    override fun createView(context: Context): View {
+        actionBar.setBackButtonImage(R.drawable.ic_ab_back)
+        actionBar.setTitle("tele")
+        actionBar.setSubtitle("what's new in tele")
+        actionBar.setActionBarMenuOnItemClick(object : ActionBar.ActionBarMenuOnItemClick() {
+            override fun onItemClick(id: Int) {
+                when (id) {
+                    -1 -> finishFragment()
+                    MENU_ABOUT -> TeleChat.showAbout(this@TeleChatActivity)
+                    MENU_DELETE -> TeleChat.confirmDelete(this@TeleChatActivity) { finishFragment() }
+                }
+            }
+        })
+        val menu = actionBar.createMenu().addItem(0, R.drawable.ic_ab_other)
+        menu.addSubItem(MENU_ABOUT, R.drawable.msg_info, "about tele")
+        menu.addSubItem(MENU_DELETE, R.drawable.msg_delete, "delete chat")
+
+        val root = SizeNotifierFrameLayout(context)
+        root.setBackgroundImage(Theme.getCachedWallpaperNonBlocking(), Theme.isWallpaperMotion())
+        actionBar.setAddToContainer(false)
+        actionBar.setCastShadows(false)
+        fragmentView = root
+
+        val list = ChatList(context)
+        val layoutManager = LinearLayoutManager(context)
+        layoutManager.stackFromEnd = true
+        list.setLayoutManager(layoutManager)
+        list.setVerticalScrollBarEnabled(false)
+        adapter = Adapter(context)
+        list.adapter = adapter
+        root.addView(list, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.MATCH_PARENT.toFloat()))
+        list.setPadding(0, AndroidUtilities.statusBarHeight + ActionBar.getCurrentActionBarHeight(), 0, AndroidUtilities.dp(8f))
+        list.clipToPadding = true
+        root.addView(actionBar, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT.toFloat()))
+        return fragmentView
+    }
+
+    private fun openUrl(url: String?) {
+        if (url.isNullOrEmpty()) return
+        Browser.openUrl(parentActivity, url)
+    }
+
+    private val cellDelegate = object : ChatMessageCell.ChatMessageCellDelegate {
+        override fun didPressBotButton(cell: ChatMessageCell, button: TL_keyboard.KeyboardButtonProto) {
+            openUrl(button.url)
+        }
+
+        override fun didPressUrl(cell: ChatMessageCell, url: CharacterStyle, longPress: Boolean) {
+            if (url is URLSpan) openUrl(url.url)
+        }
+
+        override fun canPerformActions(): Boolean = true
+    }
+
+    private inner class ChatList(context: Context) : RecyclerListView(context) {
+        override fun dispatchDraw(canvas: Canvas) {
+            for (i in 0 until childCount) {
+                val child = getChildAt(i)
+                if (child is ChatMessageCell) {
+                    child.setParentViewSize(measuredWidth, measuredHeight)
+                }
+            }
+            super.dispatchDraw(canvas)
+        }
+    }
+
+    private inner class Adapter(private val context: Context) : RecyclerListView.SelectionAdapter() {
+        override fun getItemCount(): Int = items.size
+
+        override fun isEnabled(holder: RecyclerView.ViewHolder): Boolean = false
+
+        override fun getItemViewType(position: Int): Int = if (items[position] is MessageObject) TYPE_MESSAGE else TYPE_DATE
+
+        override fun onCreateViewHolder(parent: ViewGroup, viewType: Int): RecyclerView.ViewHolder {
+            val view = if (viewType == TYPE_DATE) {
+                TextView(context).apply {
+                    gravity = Gravity.CENTER_HORIZONTAL
+                    setTextColor(Theme.getColor(Theme.key_chat_serviceText))
+                    textSize = 14f
+                    typeface = Typeface.create("sans-serif-medium", Typeface.NORMAL)
+                    setPadding(AndroidUtilities.dp(16f), AndroidUtilities.dp(10f), AndroidUtilities.dp(16f), AndroidUtilities.dp(6f))
+                }
+            } else {
+                ChatMessageCell(context, currentAccount, false, sharedResources ?: ChatMessageSharedResources(context).also { sharedResources = it }, resourceProvider).apply {
+                    setDelegate(cellDelegate)
+                }
+            }
+            view.layoutParams = RecyclerView.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT)
+            return RecyclerListView.Holder(view)
+        }
+
+        override fun onBindViewHolder(holder: RecyclerView.ViewHolder, position: Int) {
+            when (val item = items[position]) {
+                is MessageObject -> {
+                    val next = items.getOrNull(position + 1)
+                    (holder.itemView as ChatMessageCell).setMessageObject(item, null, next is MessageObject, false, false, next == null)
+                }
+                else -> (holder.itemView as TextView).text = item as String
+            }
+        }
+    }
+
+    companion object {
+        const val NEW_SETTINGS_LINK = "tg://settings/tele/new"
+        private const val MENU_ABOUT = 1
+        private const val MENU_DELETE = 2
+        private const val TYPE_DATE = 0
+        private const val TYPE_MESSAGE = 1
+    }
+}
