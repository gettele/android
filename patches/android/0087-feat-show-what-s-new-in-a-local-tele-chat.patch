diff --git a/TMessagesProj/src/main/java/tele/helpers/TeleChangelog.kt b/TMessagesProj/src/main/java/tele/helpers/TeleChangelog.kt
new file mode 100644
index 000000000..0dc8a1201
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/TeleChangelog.kt
@@ -0,0 +1,310 @@
+package tele.helpers
+
+import org.json.JSONArray
+import org.json.JSONObject
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.BuildVars
+import org.telegram.messenger.DispatchQueue
+import org.telegram.messenger.FileLog
+import org.telegram.messenger.R
+import org.telegram.messenger.UserConfig
+import org.telegram.tgnet.ConnectionsManager
+import org.telegram.tgnet.TLRPC
+import org.telegram.tgnet.tl.TL_keyboard
+import org.telegram.ui.ActionBar.AlertDialog
+import org.telegram.ui.ActionBar.BaseFragment
+import tele.TeleBuild
+import tele.TeleConfig
+import java.net.HttpURLConnection
+import java.net.URL
+
+// what's new after an update (tele 0039/0075/0111): the release notes of the running build are fetched from its
+// github release once per account and posted to the local tele chat
+object TeleChangelog {
+    private const val TIMEOUT = 60_000
+    private const val MAX_SIZE = 256 * 1024
+    private const val MAX_ITEMS = 100
+    private const val MAX_CATEGORIES = 16
+    private const val MAX_TITLE = 64
+    private const val MAX_ITEM = 1024
+    private const val MAX_MESSAGE = 4000
+
+    enum class Missing { UNPUBLISHED, LOCAL, FAILED }
+
+    private class Entry(val text: String, val where: String)
+    private class Group(val name: String) {
+        val entries = ArrayList<Entry>()
+    }
+    private class Notes(val title: String, val url: String, val groups: List<Group>)
+    private class Result(val notes: Notes?, val missing: Missing?)
+
+    private val queue by lazy { DispatchQueue("teleChangelog") }
+    // queue thread only
+    private var result: Result? = null
+    private var fetching = false
+    private val waiting = ArrayList<(Result) -> Unit>()
+
+    private fun url(): String = "${TeleUpdater.RELEASES}/download/${TeleUpdater.tag()}/tele-changelog.json"
+
+    private fun key(account: Int): String {
+        val id = UserConfig.getInstance(account).clientUserId
+        return if (ConnectionsManager.getInstance(account).isTestBackend) "test:$id" else id.toString()
+    }
+
+    private fun accounts(): LinkedHashMap<String, Int> {
+        val result = LinkedHashMap<String, Int>()
+        for (part in TeleConfig.CHANGELOG_ACCOUNTS.value.split(',')) {
+            val pair = part.trim().split('=')
+            val build = pair.getOrNull(1)?.toIntOrNull() ?: continue
+            if (pair[0].isNotEmpty() && build > 0) result[pair[0]] = build
+        }
+        return result
+    }
+
+    private fun store(account: Int) {
+        val map = accounts()
+        map[key(account)] = TeleBuild.BUILD
+        TeleConfig.set(TeleConfig.CHANGELOG_ACCOUNTS, map.entries.joinToString(",") { "${it.key}=${it.value}" })
+    }
+
+    private var started = false
+
+    // the first resume of the main activity: accounts are loaded by then
+    @JvmStatic
+    fun onLaunchResume() {
+        if (started) return
+        started = true
+        start()
+    }
+
+    // app start: accounts last shown an older build get this build's notes; accounts added later don't get old ones
+    @JvmStatic
+    fun start() {
+        if (TeleBuild.BUILD <= 0) return
+        AndroidUtilities.runOnUIThread {
+            val map = accounts()
+            val firstRun = map.isEmpty()
+            val pending = ArrayList<Int>()
+            for (account in 0 until UserConfig.MAX_ACCOUNT_COUNT) {
+                if (!UserConfig.getInstance(account).isClientActivated) continue
+                val key = key(account)
+                val stored = map[key] ?: if (firstRun) 0 else TeleBuild.BUILD
+                if (stored >= TeleBuild.BUILD || !TeleConfig.SHOW_CHANGELOG.value) {
+                    map[key] = maxOf(stored, TeleBuild.BUILD)
+                } else {
+                    pending.add(account)
+                }
+            }
+            TeleConfig.set(TeleConfig.CHANGELOG_ACCOUNTS, map.entries.joinToString(",") { "${it.key}=${it.value}" })
+            if (pending.isNotEmpty()) {
+                request(false) { result ->
+                    val notes = result.notes ?: return@request
+                    pending.forEach { post(it, notes) }
+                }
+            }
+        }
+    }
+
+    private fun post(account: Int, notes: Notes) {
+        TeleChat.post(account, messages(notes))
+        store(account)
+    }
+
+    // "what's new": the tele chat, fetching the notes when it is empty; explains a missing changelog (0111)
+    @JvmStatic
+    fun open(fragment: BaseFragment) {
+        val account = fragment.currentAccount
+        if (TeleChat.hasMessages(account)) {
+            TeleChat.open(fragment)
+        } else if (TeleBuild.BUILD <= 0) {
+            showMissing(fragment, Missing.LOCAL)
+        } else {
+            request(true) { result ->
+                val notes = result.notes
+                if (notes == null) {
+                    showMissing(fragment, result.missing ?: Missing.FAILED)
+                    return@request
+                }
+                if (!TeleChat.hasMessages(account)) post(account, notes)
+                TeleChat.open(fragment)
+            }
+        }
+    }
+
+    private fun showMissing(fragment: BaseFragment, missing: Missing) {
+        val activity = fragment.parentActivity ?: return
+        val text = when (missing) {
+            Missing.UNPUBLISHED -> "there are no release notes for this tele version."
+            Missing.LOCAL -> "there are no release notes for this tele version: it's a local build."
+            Missing.FAILED -> "couldn't load the release notes for this tele version, try again later."
+        }
+        fragment.showDialog(AlertDialog.Builder(activity)
+            .setTitle("what's new")
+            .setMessage(text)
+            .setPositiveButton(org.telegram.messenger.LocaleController.getString(R.string.OK), null)
+            .setNeutralButton("full changelog") { _, _ -> org.telegram.messenger.browser.Browser.openUrl(activity, TeleUpdater.RELEASES) }
+            .create())
+    }
+
+    // callbacks run on the UI thread; a failed fetch is retried only on demand
+    private fun request(retry: Boolean, callback: (Result) -> Unit) {
+        queue.postRunnable {
+            val known = result
+            if (known != null && (known.notes != null || !retry)) {
+                AndroidUtilities.runOnUIThread { callback(known) }
+                return@postRunnable
+            }
+            waiting.add(callback)
+            if (!fetching) {
+                fetching = true
+                queue.postRunnable { fetch() }
+            }
+        }
+    }
+
+    private fun fetch() {
+        val fetched = try {
+            val notes = parse(download(url()))
+            if (notes == null) Result(null, Missing.UNPUBLISHED) else Result(notes, null)
+        } catch (e: NotFound) {
+            Result(null, Missing.UNPUBLISHED)
+        } catch (e: Exception) {
+            FileLog.e("TeleChangelog: ${e.message}")
+            Result(null, Missing.FAILED)
+        }
+        fetching = false
+        result = fetched
+        val callbacks = ArrayList(waiting)
+        waiting.clear()
+        AndroidUtilities.runOnUIThread { callbacks.forEach { it(fetched) } }
+    }
+
+    private class NotFound : Exception()
+
+    private fun download(url: String): String {
+        val connection = URL(url).openConnection() as HttpURLConnection
+        try {
+            connection.connectTimeout = TIMEOUT
+            connection.readTimeout = TIMEOUT
+            connection.instanceFollowRedirects = true
+            connection.setRequestProperty("User-Agent", "tele/${BuildVars.BUILD_VERSION_STRING}-tele.${TeleBuild.BUILD}")
+            val code = connection.responseCode
+            if (code == HttpURLConnection.HTTP_NOT_FOUND) throw NotFound()
+            if (code != HttpURLConnection.HTTP_OK) throw Exception("unexpected http status $code")
+            val out = java.io.ByteArrayOutputStream()
+            connection.inputStream.use { input ->
+                val buffer = ByteArray(16 * 1024)
+                while (true) {
+                    val read = input.read(buffer)
+                    if (read < 0) break
+                    out.write(buffer, 0, read)
+                    if (out.size() > MAX_SIZE) throw Exception("response is too large")
+                }
+            }
+            return out.toString("UTF-8")
+        } finally {
+            connection.disconnect()
+        }
+    }
+
+    private fun category(value: Any?): String {
+        val text = (value as? String)?.trim().orEmpty()
+        return if (text.length > MAX_TITLE) "" else text
+    }
+
+    private fun parse(text: String): Notes? {
+        val o = runCatching { JSONObject(text) }.getOrNull() ?: return null
+        val items = o.optJSONArray("items") ?: return null
+        if (o.optString("tag") != TeleUpdater.tag()) return null
+        val title = o.optString("title").trim().takeIf { it.isNotEmpty() && it.length <= MAX_TITLE } ?: "tele ${TeleBuild.BUILD}"
+        val url = o.optString("url").takeIf { it.startsWith(TeleUpdater.RELEASES + "/") } ?: "${TeleUpdater.RELEASES}/tag/${TeleUpdater.tag()}"
+        val groups = ArrayList<Group>()
+        fun group(name: String): Group = groups.firstOrNull { it.name == name } ?: Group(name).also(groups::add)
+        val categories = o.optJSONArray("categories") ?: JSONArray()
+        for (i in 0 until categories.length()) {
+            if (groups.size >= MAX_CATEGORIES) break
+            category(categories.opt(i)).takeIf { it.isNotEmpty() }?.let(::group)
+        }
+        var count = 0
+        for (i in 0 until items.length()) {
+            val item = items.optJSONObject(i) ?: continue
+            val entry = item.optString("text").trim()
+            if (entry.isEmpty()) continue
+            if (++count > MAX_ITEMS) break
+            group(category(item.opt("category"))).entries.add(Entry(entry.take(MAX_ITEM), item.optString("where").trim().take(MAX_ITEM)))
+        }
+        groups.removeAll { it.entries.isEmpty() }
+        return Notes(title, url, groups)
+    }
+
+    private class Message {
+        val text = StringBuilder()
+        val entities = ArrayList<TLRPC.MessageEntity>()
+
+        fun append(value: String, entity: TLRPC.MessageEntity? = null) {
+            if (entity != null && value.isNotEmpty()) {
+                entity.offset = text.length
+                entity.length = value.length
+                entities.add(entity)
+            }
+            text.append(value)
+        }
+    }
+
+    private fun messages(notes: Notes): List<TLRPC.TL_message> {
+        val parts = ArrayList<Message>()
+        var current = Message()
+        current.append("${notes.title} is here", TLRPC.TL_messageEntityBold())
+        current.append("\n")
+        fun piece(fill: Message.() -> Unit) {
+            val probe = Message().apply(fill)
+            if (current.text.length + probe.text.length > MAX_MESSAGE && current.text.isNotBlank()) {
+                parts.add(current)
+                current = Message()
+            }
+            current.fill()
+        }
+        for (group in notes.groups) {
+            piece {
+                append("\n")
+                if (group.name.isNotEmpty()) {
+                    append(group.name, TLRPC.TL_messageEntityBold())
+                    append("\n")
+                }
+            }
+            for (entry in group.entries) {
+                piece {
+                    append("• ${entry.text}")
+                    if (entry.where.isNotEmpty()) {
+                        append("\n")
+                        append(entry.where, TLRPC.TL_messageEntityItalic())
+                    }
+                    append("\n")
+                }
+            }
+        }
+        parts.add(current)
+        val result = parts.map { part ->
+            TLRPC.TL_message().apply {
+                message = part.text.toString().trimEnd()
+                entities = ArrayList(part.entities.filter { it.offset < message.length })
+                entities.forEach { it.length = minOf(it.length, message.length - it.offset) }
+                media = TLRPC.TL_messageMediaEmpty()
+                unread = true
+            }
+        }
+        result.last().reply_markup = buttons(notes)
+        return result
+    }
+
+    private fun buttons(notes: Notes): TLRPC.TL_replyInlineMarkup {
+        val row = TL_keyboard.TL_keyboardInlineButtonRow()
+        row.buttons.add(urlButton("full changelog", notes.url))
+        return TLRPC.TL_replyInlineMarkup().apply { rows.add(row) }
+    }
+
+    private fun urlButton(text: String, url: String) = TL_keyboard.TL_keyboardInlineButton().apply {
+        this.text = text
+        type = TL_keyboard.TL_inlineButtonTypeUrl().apply { this.url = url }
+    }
+}
