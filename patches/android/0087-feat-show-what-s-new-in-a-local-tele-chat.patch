+
+import android.graphics.drawable.Drawable
+import org.telegram.messenger.ApplicationLoader
+import org.telegram.messenger.FileLog
+import org.telegram.messenger.MessagesController
+import org.telegram.messenger.NotificationCenter
+import org.telegram.messenger.R
+import org.telegram.tgnet.ConnectionsManager
+import org.telegram.tgnet.SerializedData
+import org.telegram.tgnet.TLRPC
+import org.telegram.ui.ActionBar.AlertDialog
+import org.telegram.ui.ActionBar.BaseFragment
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Cells.DialogCell
+import tele.db.TeleDatabaseHelper
+import tele.ui.settings.TeleChatActivity
+
+// the local "tele" chat with release notes (tele 0075): stored in tele.db, shown as a row of the main chat list only,
+// never a real peer, so nothing about it reaches the server
+object TeleChat {
+    // desktop's id: the top of the 48-bit user id range, rounded
+    const val PEER_ID = 281474976710000L
+    const val GITHUB_URL = "https://github.com/gettele/android"
+    const val CHANNEL_URL = "https://t.me/teleAppUpdates"
+    private const val READ_KEY = "changelog_read:"
+
+    class Row : DialogCell.CustomDialog()
+
+    private class State(val messages: ArrayList<TLRPC.Message>, var readMaxId: Int, val dialog: TLRPC.TL_dialog)
+
+    private val states = HashMap<Int, State>()
+    private var userpic: Drawable? = null
+
+    // UI thread
+    private fun state(account: Int): State = states.getOrPut(account) {
+        val messages = ArrayList<TLRPC.Message>()
+        for (row in TeleDatabaseHelper.getChangelogMessages(account)) {
+            val stream = SerializedData(row.data)
+            try {
+                TLRPC.Message.TLdeserialize(stream, stream.readInt32(false), false)?.let(messages::add)
+            } catch (e: Exception) {
+                FileLog.e(e)
+            } finally {
+                stream.cleanup()
+            }
+        }
+        val read = TeleDatabaseHelper.get(READ_KEY + account)?.toIntOrNull() ?: 0
+        val dialog = TLRPC.TL_dialog().apply {
+            id = PEER_ID
+            peer = TLRPC.TL_peerUser().apply { user_id = PEER_ID }
+        }
+        State(messages, read, dialog)
+    }
+
+    @JvmStatic
+    fun messages(account: Int): List<TLRPC.Message> = state(account).messages
+
+    @JvmStatic
+    fun hasMessages(account: Int): Boolean = state(account).messages.isNotEmpty()
+
+    @JvmStatic
+    fun unreadCount(account: Int): Int {
+        val s = state(account)
+        return s.messages.count { it.id > s.readMaxId }
+    }
+
+    // adds release notes as incoming messages of the tele peer
+    @JvmStatic
+    fun post(account: Int, messages: List<TLRPC.TL_message>) {
+        if (messages.isEmpty()) return
+        val s = state(account)
+        var id = s.messages.lastOrNull()?.id ?: 0
+        val date = ConnectionsManager.getInstance(account).currentTime
+        for (m in messages) {
+            m.id = ++id
+            m.date = date
+            m.from_id = TLRPC.TL_peerUser().apply { user_id = PEER_ID }
+            m.peer_id = TLRPC.TL_peerUser().apply { user_id = PEER_ID }
+            m.dialog_id = PEER_ID
+            m.flags = m.flags or FLAG_FROM_ID
+            if (!m.entities.isNullOrEmpty()) m.flags = m.flags or FLAG_ENTITIES
+            if (m.reply_markup != null) m.flags = m.flags or FLAG_REPLY_MARKUP
+            val data = SerializedData(m.objectSize)
+            try {
+                m.serializeToStream(data)
+                TeleDatabaseHelper.putChangelogMessage(account, m.id, m.date, data.toByteArray())
+            } finally {
+                data.cleanup()
+            }
+            s.messages.add(m)
+        }
+        changed(account)
+    }
+
+    @JvmStatic
+    fun markRead(account: Int) {
+        val s = state(account)
+        val last = s.messages.lastOrNull()?.id ?: return
+        if (s.readMaxId >= last) return
+        s.readMaxId = last
+        TeleDatabaseHelper.put(READ_KEY + account, last.toString())
+        changed(account)
+    }
+
+    @JvmStatic
+    fun delete(account: Int) {
+        val s = state(account)
+        TeleDatabaseHelper.removeChangelogMessages(account)
+        TeleDatabaseHelper.put(READ_KEY + account, null)
+        s.messages.clear()
+        s.readMaxId = 0
+        changed(account)
+    }
+
+    private fun changed(account: Int) {
+        NotificationCenter.getInstance(account).postNotificationName(NotificationCenter.dialogsNeedReload)
+    }
+
+    // the row in "all chats" of the main list; folders, archive, pickers and forwarding never see it
+    @JvmStatic
+    fun listDialog(account: Int, dialogsType: Int, folderId: Int, filter: MessagesController.DialogFilter?): TLRPC.Dialog? {
+        if (dialogsType != 0 || folderId != 0 || (filter != null && !filter.isDefault)) return null
+        val s = state(account)
+        val last = s.messages.lastOrNull() ?: return null
+        return s.dialog.apply {
+            last_message_date = last.date
+            top_message = last.id
+            unread_count = s.messages.count { it.id > s.readMaxId }
+        }
+    }
+
+    @JvmStatic
+    fun isChat(item: Any?): Boolean = item is TLRPC.Dialog && item.id == PEER_ID
+
+    @JvmStatic
+    fun bind(cell: DialogCell, account: Int) {
+        val last = state(account).messages.lastOrNull()
+        cell.setDialog(Row().apply {
+            name = "tele"
+            message = last?.message?.replace('\n', ' ').orEmpty()
+            date = last?.date ?: 0
+            unread_count = unreadCount(account)
+            verified = true
+        })
+    }
+
+    @JvmStatic
+    fun avatar(dialog: DialogCell.CustomDialog?, stock: Drawable): Drawable =
+        if (dialog is Row) userpic() else stock
+
+    @JvmStatic
+    fun userpic(): Drawable = userpic ?: ApplicationLoader.applicationContext.resources.getDrawable(R.drawable.tele_userpic).also { userpic = it }
+
+    @JvmStatic
+    fun open(fragment: BaseFragment) {
+        fragment.presentFragment(TeleChatActivity())
+    }
+
+    @JvmStatic
+    fun showMenu(fragment: BaseFragment): Boolean {
+        val activity = fragment.parentActivity ?: return false
+        val account = fragment.currentAccount
+        val items = ArrayList<CharSequence>()
+        val actions = ArrayList<Runnable>()
+        if (unreadCount(account) > 0) {
+            items.add(org.telegram.messenger.LocaleController.getString(R.string.MarkAsRead))
+            actions.add(Runnable { markRead(account) })
+        }
+        items.add("about tele")
+        actions.add(Runnable { showAbout(fragment) })
+        items.add("delete chat")
+        actions.add(Runnable { confirmDelete(fragment) })
+        fragment.showDialog(AlertDialog.Builder(activity).setItems(items.toTypedArray()) { _, which -> actions[which].run() }.create())
+        return true
+    }
+
+    @JvmStatic
+    fun showAbout(fragment: BaseFragment) {
+        val activity = fragment.parentActivity ?: return
+        fragment.showDialog(AlertDialog.Builder(activity)
+            .setTitle("tele")
+            .setMessage("what's new in tele. release notes of tele, only on this device.")
+            .setPositiveButton("tele on github") { _, _ -> org.telegram.messenger.browser.Browser.openUrl(activity, GITHUB_URL) }
+            .setNeutralButton("updates channel") { _, _ -> org.telegram.messenger.browser.Browser.openUrl(activity, CHANNEL_URL) }
+            .setNegativeButton(org.telegram.messenger.LocaleController.getString(R.string.Close), null)
+            .create())
+    }
+
+    @JvmStatic
+    fun confirmDelete(fragment: BaseFragment, onDeleted: Runnable? = null) {
+        val activity = fragment.parentActivity ?: return
+        val account = fragment.currentAccount
+        val dialog = AlertDialog.Builder(activity)
+            .setTitle("delete chat")
+            .setMessage("delete the tele chat? it exists only on this device.")
+            .setPositiveButton(org.telegram.messenger.LocaleController.getString(R.string.Delete)) { _, _ ->
+                delete(account)
+                onDeleted?.run()
+            }
+            .setNegativeButton(org.telegram.messenger.LocaleController.getString(R.string.Cancel), null)
+            .create()
+        fragment.showDialog(dialog)
+        (dialog.getButton(android.content.DialogInterface.BUTTON_POSITIVE) as? android.widget.TextView)?.setTextColor(Theme.getColor(Theme.key_text_RedBold))
+    }
+
+    private const val FLAG_REPLY_MARKUP = 1 shl 6
+    private const val FLAG_ENTITIES = 1 shl 7
+    private const val FLAG_FROM_ID = 1 shl 8
+}
