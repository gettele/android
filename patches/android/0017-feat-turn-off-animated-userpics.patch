From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?t=CE=B1ngenx?= <me@tangenx.dev>
Date: Thu, 1 Oct 2026 20:03:08 +0300
Subject: [PATCH] feat: turn off animated userpics

---
 .../src/main/java/org/telegram/messenger/ImageReceiver.java    | 3 ++-
 TMessagesProj/src/main/java/tele/TeleConfig.kt                 | 2 ++
 .../src/main/java/tele/ui/settings/TeleSettingsActivity.kt     | 3 ++-
 3 files changed, 6 insertions(+), 2 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/ImageReceiver.java b/TMessagesProj/src/main/java/org/telegram/messenger/ImageReceiver.java
index 0a6074235..fef82ee03 100644
--- a/TMessagesProj/src/main/java/org/telegram/messenger/ImageReceiver.java
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/ImageReceiver.java
@@ -38,6 +38,7 @@ import androidx.annotation.Keep;
 import org.telegram.tgnet.TLObject;
 import org.telegram.tgnet.TLRPC;
 import org.telegram.ui.Components.AnimatedEmojiDrawable;
+import tele.TeleConfig;
 import org.telegram.ui.Components.AnimatedEmojiSpan;
 import org.telegram.ui.Components.AnimatedFileDrawable;
 import org.telegram.ui.Components.AttachableDrawable;
@@ -497,7 +498,7 @@ public class ImageReceiver implements NotificationCenter.NotificationCenterDeleg
                 location = ImageLocation.getForUserOrChat(currentAccount, object, ImageLocation.TYPE_BIG);
                 filter = "100_100";
             }
-            if (videoLocation != null) {
+            if (videoLocation != null && !TeleConfig.STATIC_AVATARS.getValue()) {
                 setImage(videoLocation, "avatar", location, filter, null, null, strippedBitmap, 0, null, parentObject, 0);
                 animatedFileDrawableRepeatMaxCount = 3;
             } else {
diff --git a/TMessagesProj/src/main/java/tele/TeleConfig.kt b/TMessagesProj/src/main/java/tele/TeleConfig.kt
index 9cb7330a2..b94e14345 100644
--- a/TMessagesProj/src/main/java/tele/TeleConfig.kt
+++ b/TMessagesProj/src/main/java/tele/TeleConfig.kt
@@ -58,6 +58,8 @@ object TeleConfig {
     val REVEAL_SPOILERS = BoolItem("reveal_spoilers", false)
     @JvmField
     val HIDE_MENTION_REACTIONS = BoolItem("hide_mention_reactions", false)
+    @JvmField
+    val STATIC_AVATARS = BoolItem("static_avatars", false)
 
     private var prefs: SharedPreferences? = null
 
diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
index 0c80e511e..174f9f677 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
@@ -74,7 +74,8 @@ class TeleSettingsActivity : BaseFragment() {
             Row(TYPE_TOGGLE, "open links without confirmation", item = TeleConfig.OPEN_LINKS_DIRECTLY),
             Row(TYPE_TOGGLE, "show names instead of phone numbers in chat headers", item = TeleConfig.NAME_INSTEAD_OF_PHONE),
             Row(TYPE_TOGGLE, "reveal spoilers automatically", item = TeleConfig.REVEAL_SPOILERS),
-            Row(TYPE_TOGGLE, "hide mention and reaction badges", item = TeleConfig.HIDE_MENTION_REACTIONS)
+            Row(TYPE_TOGGLE, "hide mention and reaction badges", item = TeleConfig.HIDE_MENTION_REACTIONS),
+            Row(TYPE_TOGGLE, "turn off animated userpics", item = TeleConfig.STATIC_AVATARS)
         )
 
         override fun getItemCount(): Int = rows.size
