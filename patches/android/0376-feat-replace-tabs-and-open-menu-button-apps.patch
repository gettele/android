+    private fun openMenuButtonApp(themeParams: TLRPC.TL_dataJSON?) {
+        val user = MessagesController.getInstance(account).getUser(botId)
+        if (user == null) {
+            showPlaceholder(R.string.TeleMiniAppOpenFailed)
+            return
+        }
+        // getBotMenuButton is bot-only; users read the menu button from the full user info
+        MessagesController.getInstance(account).loadFullUser(user, classGuid, false) { full ->
+            if (container == null || fragmentView == null) {
+                return@loadFullUser
+            }
+            val button = full?.bot_info?.menu_button as? org.telegram.tgnet.tl.TL_bots.TL_botMenuButton
+            if (button == null || button.url.isNullOrEmpty()) {
+                showPlaceholder(R.string.TeleMiniAppUnsupported)
+                return@loadFullUser
+            }
+            openButtonUrl(button.url, themeParams)
+        }
+    }
+
+    private fun openButtonUrl(url: String, themeParams: TLRPC.TL_dataJSON?) {
+        val request = TLRPC.TL_messages_requestWebView()
+        request.bot = MessagesController.getInstance(account).getInputUser(botId)
+        request.peer = MessagesController.getInstance(account).getInputPeer(botId)
+        request.platform = "android"
+        request.url = url
+        request.flags = request.flags or 2
+        request.compact = false
+        request.fullscreen = false
+        if (themeParams != null) {
+            request.theme_params = themeParams
+            request.flags = request.flags or 4
+        }
+        ConnectionsManager.getInstance(account).sendRequest(request, { response, error ->
+            AndroidUtilities.runOnUIThread {
+                val result = response as? TLRPC.TL_webViewResultUrl
+                if (container == null || fragmentView == null || error != null || result == null || result.url.isNullOrEmpty()) {
+                    showPlaceholder(R.string.TeleMiniAppOpenFailed)
+                    return@runOnUIThread
+                }
+                queryId = result.query_id
+                placeholder?.visibility = View.GONE
+                container?.loadUrl(account, result.url, result.same_origin)
+                MediaDataController.getInstance(account).increaseWebappRating(botId)
+                if (queryId != 0L) {
+                    AndroidUtilities.cancelRunOnUIThread(pollRunnable)
+                    AndroidUtilities.runOnUIThread(pollRunnable, POLL_PERIOD)
+                }
+            }
+        }, ConnectionsManager.RequestFlagInvokeAfter or ConnectionsManager.RequestFlagFailOnServerErrors)
+    }
+
     private fun showPlaceholder(resId: Int) {
         placeholder?.text = TeleLowercase.lc(LocaleController.getString(resId))
         placeholder?.visibility = View.VISIBLE
