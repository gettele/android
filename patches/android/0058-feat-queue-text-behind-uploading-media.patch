+package tele.helpers
+
+import android.os.Handler
+import android.os.Looper
+import org.telegram.messenger.FileLog
+import org.telegram.messenger.NotificationCenter
+import org.telegram.messenger.SendMessagesHelper
+
+object SendOrder : NotificationCenter.NotificationCenterDelegate {
+
+    private const val DOUBLE_ENTER_MS = 500L
+    private const val RECHECK_MS = 2000L
+
+    private class Held(
+        val account: Int,
+        val dialogId: Long,
+        val msgId: Int,
+        val replyMsgId: Int,
+        val at: Long,
+        val send: Runnable
+    ) {
+        @Volatile
+        var cancelled = false
+    }
+
+    private val held = HashMap<Int, HashMap<Long, ArrayList<Held>>>()
+    private val handler = Handler(Looper.getMainLooper())
+    private var recheckScheduled = false
+    private var lastEnter = 0L
+    private var initialized = false
+
+    @Volatile
+    private var releasing = false
+
+    @JvmStatic
+    fun hold(
+        account: Int,
+        dialogId: Long,
+        msgId: Int,
+        replyMsgId: Int,
+        scheduled: Boolean,
+        send: Runnable
+    ): Boolean {
+        if (scheduled || releasing) {
+            return false
+        }
+        if (!tele.TeleConfig.QUEUE_BEHIND_MEDIA.value) {
+            return false
+        }
+        if (!SendMessagesHelper.getInstance(account).teleHasUploadingMedia(dialogId, msgId, replyMsgId)) {
+            return false
+        }
+        synchronized(held) {
+            held.getOrPut(account) { HashMap() }.getOrPut(dialogId) { ArrayList() }.add(
+                Held(account, dialogId, msgId, replyMsgId, System.currentTimeMillis(), send)
+            )
+        }
+        scheduleRecheck()
+        return true
+    }
+
+    @JvmStatic
+    fun sendHeldOnDoubleEnter(account: Int, dialogId: Long, fieldEmpty: Boolean): Boolean {
+        val now = System.currentTimeMillis()
+        val since = lastEnter
+        lastEnter = now
+        if (!fieldEmpty
+            || !tele.TeleConfig.DOUBLE_ENTER_SEND.value
+            || !tele.TeleConfig.QUEUE_BEHIND_MEDIA.value
+            || now - since > DOUBLE_ENTER_MS
+        ) {
+            return false
+        }
+        val taken = ArrayList<Held>()
+        synchronized(held) {
+            val dialogs = held[account] ?: return false
+            val list = dialogs[dialogId] ?: return false
+            val it = list.iterator()
+            while (it.hasNext()) {
+                val entry = it.next()
+                if (entry.at >= since) {
+                    taken.add(entry)
+                    it.remove()
+                }
+            }
+        }
+        dispatch(taken)
+        return true
+    }
+
+    @JvmStatic
+    fun flush(account: Int, dialogId: Long) {
+        val taken = ArrayList<Held>()
+        synchronized(held) {
+            val dialogs = held[account] ?: return
+            val list = dialogs[dialogId] ?: return
+            val it = list.iterator()
+            while (it.hasNext()) {
+                val entry = it.next()
+                if (entry.cancelled) {
+                    it.remove()
+                    continue
+                }
+                if (!SendMessagesHelper.getInstance(account).teleHasUploadingMedia(dialogId, entry.msgId, entry.replyMsgId)) {
+                    taken.add(entry)
+                    it.remove()
+                }
+            }
+            if (list.isEmpty()) dialogs.remove(dialogId)
+            if (dialogs.isEmpty()) held.remove(account)
+        }
+        dispatch(taken)
+        scheduleRecheckIfNeeded()
+    }
+
+    @JvmStatic
+    fun markCancelled(account: Int, dialogId: Long, msgIds: List<Int>) {
+        if (msgIds.isEmpty()) return
+        synchronized(held) {
+            val dialogs = held[account] ?: return
+            val list = dialogs[dialogId] ?: return
+            for (entry in list) {
+                if (entry.msgId in msgIds) {
+                    entry.cancelled = true
+                }
+            }
+        }
+    }
+
+    private fun dispatch(taken: List<Held>) {
+        if (taken.isEmpty()) return
+        releasing = true
+        try {
+            for (entry in taken) {
+                runCatching { entry.send.run() }.onFailure { FileLog.e(it) }
+            }
+        } finally {
+            releasing = false
+        }
+    }
+
+    @JvmStatic
+    fun flush(account: Int) {
+        val dialogIds: List<Long>
+        synchronized(held) {
+            val dialogs = held[account] ?: return
+            dialogIds = ArrayList(dialogs.keys)
+        }
+        for (dialogId in dialogIds) {
+            flush(account, dialogId)
+        }
+    }
+
+    @JvmStatic
+    fun flushAll() {
+        val dialogs: List<Pair<Int, Long>>
+        synchronized(held) {
+            dialogs = held.flatMap { (account, map) -> map.keys.map { account to it } }
+        }
+        for ((account, dialogId) in dialogs) {
+            flush(account, dialogId)
+        }
+    }
+
+    private fun scheduleRecheckIfNeeded() {
+        val hasHeld = synchronized(held) { held.isNotEmpty() }
+        if (hasHeld) {
+            scheduleRecheck()
+        }
+    }
+
+    private fun scheduleRecheck() {
+        if (recheckScheduled) {
+            return
+        }
+        recheckScheduled = true
+        handler.postDelayed({
+            recheckScheduled = false
+            val dialogs: List<Pair<Int, Long>>
+            synchronized(held) {
+                dialogs = held.flatMap { (account, map) -> map.keys.map { account to it } }
+            }
+            for ((account, dialogId) in dialogs) {
+                runCatching { flush(account, dialogId) }.onFailure { FileLog.e(it) }
+            }
+            scheduleRecheckIfNeeded()
+        }, RECHECK_MS)
+    }
+
+    @JvmStatic
+    fun init(account: Int) {
+        initialized = true
+    }
+
+    override fun didReceivedNotification(id: Int, account: Int, vararg args: Any?) {
+    }
+}
