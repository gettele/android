+    public boolean teleHasUploadingMedia(long dialogId, int msgId, int replyMsgId) {
+        boolean olderReplies = tele.TeleConfig.SEND_OLDER_REPLIES.getValue();
+        synchronized (delayedMessages) {
+            for (ArrayList<DelayedMessage> arr : delayedMessages.values()) {
+                for (int a = 0, N = arr.size(); a < N; a++) {
+                    DelayedMessage dm = arr.get(a);
+                    if (dm.peer != dialogId) {
+                        continue;
+                    }
+                    int earliestPendingId = Integer.MIN_VALUE;
+                    if (dm.obj != null) {
+                        earliestPendingId = Math.max(earliestPendingId, dm.obj.getId());
+                    }
+                    if (dm.messageObjects != null) {
+                        for (int b = 0, M = dm.messageObjects.size(); b < M; b++) {
+                            earliestPendingId = Math.max(earliestPendingId, dm.messageObjects.get(b).getId());
+                        }
+                    }
+                    if (earliestPendingId == Integer.MIN_VALUE || earliestPendingId <= msgId) {
+                        continue;
+                    }
+                    if (olderReplies && replyMsgId != 0 && earliestPendingId < replyMsgId) {
+                        continue;
+                    }
+                    return true;
+                }
+            }
+        }
+        for (int i = 0; i < sendingMessages.size(); i++) {
+            TLRPC.Message message = sendingMessages.valueAt(i);
+            if (message == null || message.send_state != MessageObject.MESSAGE_SEND_STATE_SENDING
+                || MessageObject.getDialogId(message) != dialogId || message.id <= msgId
+                || message.media == null
+                || !(message.media instanceof TLRPC.TL_messageMediaPhoto || message.media instanceof TLRPC.TL_messageMediaDocument)) {
+                continue;
+            }
+            if (olderReplies && replyMsgId != 0 && message.id < replyMsgId) {
+                continue;
+            }
+            return true;
+        }
+        return false;
+    }
