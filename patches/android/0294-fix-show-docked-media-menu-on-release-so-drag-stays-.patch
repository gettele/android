From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Fri, 6 Nov 2026 21:01:29 +0300
Subject: [PATCH] fix: show docked media menu on release so drag stays
 available

---
 .../src/main/java/tele/ui/TeleDockedStrip.kt  | 23 ++++++++-----------
 1 file changed, 9 insertions(+), 14 deletions(-)

diff --git a/TMessagesProj/src/main/java/tele/ui/TeleDockedStrip.kt b/TMessagesProj/src/main/java/tele/ui/TeleDockedStrip.kt
index cc01b8368..bcb5bdc64 100644
--- a/TMessagesProj/src/main/java/tele/ui/TeleDockedStrip.kt
+++ b/TMessagesProj/src/main/java/tele/ui/TeleDockedStrip.kt
@@ -287,14 +287,12 @@ class TeleDockedStrip(
         private var downY = 0f
         private var armed = false
         private var dragging = false
-        private var menu: ItemOptions? = null
         private val slop = ViewConfiguration.get(context).scaledTouchSlop
         private val longPress = Runnable {
             armed = true
             parent?.requestDisallowInterceptTouchEvent(true)
             performHapticFeedback(HapticFeedbackConstants.LONG_PRESS)
             animate().scaleX(1.05f).scaleY(1.05f).setDuration(100).start()
-            menu = showMenu()
         }
 
         override fun onTouchEvent(event: MotionEvent): Boolean {
@@ -304,7 +302,6 @@ class TeleDockedStrip(
                     downY = event.rawY
                     armed = false
                     dragging = false
-                    menu = null
                     postDelayed(longPress, 350L)
                     return true
                 }
@@ -313,28 +310,28 @@ class TeleDockedStrip(
                     if (!armed) {
                         if (moved > slop) removeCallbacks(longPress)
                     } else if (!dragging && moved > slop) {
-                        dragging = true
-                        menu?.dismiss()
-                        menu = null
-                        startDragAndDrop(
+                        // a popup menu would take the rest of the gesture, so the
+                        // menu waits for a release; moving after the hold starts the drag
+                        dragging = startDragAndDrop(
                             android.content.ClipData.newPlainText("", ""),
                             DragShadowBuilder(this),
                             item,
                             0
                         )
+                        if (dragging) {
+                            animate().scaleX(1.08f).scaleY(1.08f).setDuration(120).start()
+                        }
                     }
                     return true
                 }
                 MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> {
                     removeCallbacks(longPress)
                     parent?.requestDisallowInterceptTouchEvent(false)
-                    if (event.actionMasked == MotionEvent.ACTION_UP && !armed) performClick()
                     if (!dragging) {
                         animate().scaleX(1f).scaleY(1f).setDuration(100).start()
                     }
-                    if (event.actionMasked == MotionEvent.ACTION_CANCEL) {
-                        menu?.dismiss()
-                        menu = null
+                    if (event.actionMasked == MotionEvent.ACTION_UP) {
+                        if (!armed) performClick() else if (!dragging) showMenu()
                     }
                     armed = false
                     dragging = false
@@ -482,7 +479,7 @@ class TeleDockedStrip(
             }.start()
         }
 
-        private fun showMenu(): ItemOptions {
+        private fun showMenu() {
             val document = item.document
             val options = ItemOptions.makeOptions(fragment, this)
             if (index > 0) {
@@ -495,9 +492,7 @@ class TeleDockedStrip(
                 options.add(if (item.spoiler) R.drawable.msg_spoiler_off else R.drawable.msg_spoiler, if (item.spoiler) TeleLowercase.lc("Remove spoiler") else TeleLowercase.lc("Hide with spoiler")) { DockedMedia.toggleSpoiler(key, item) }
             }
             options.add(R.drawable.msg_delete, "Remove", true) { removeWithAnimation() }
-                .dontFocus()
                 .show()
-            return options
         }
     }
 
