diff --git a/TMessagesProj/src/main/java/tele/helpers/TeleLowercase.kt b/TMessagesProj/src/main/java/tele/helpers/TeleLowercase.kt
index 29a589a22..b3b4fd19e 100644
--- a/TMessagesProj/src/main/java/tele/helpers/TeleLowercase.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/TeleLowercase.kt
@@ -43,13 +43,16 @@ object TeleLowercase {
         return lowered
     }
 
-    // a literal text of tele; dynamic parts are appended after the call
+    // a literal text of tele; dynamic parts are appended after the call. the translation comes first:
+    // the tables are keyed by the english original, the lowercase switch then applies to the result
     @JvmStatic
-    fun lc(text: String): String = if (TeleConfig.LOWERCASE_INTERFACE.value) lowerSegments(text) else text
+    fun lc(text: String): String {
+        val translated = TeleTranslate.t(text)
+        return if (TeleConfig.LOWERCASE_INTERFACE.value) lowerSegments(translated) else translated
+    }
 
     @JvmStatic
-    fun lc(text: CharSequence?): CharSequence? =
-        if (text is String && TeleConfig.LOWERCASE_INTERFACE.value) lowerSegments(text) else text
+    fun lc(text: CharSequence?): CharSequence? = if (text is String) lc(text) else text
 
     // the cached templates and the visible screens follow the switch
     @JvmStatic
