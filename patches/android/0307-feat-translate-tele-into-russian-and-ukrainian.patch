diff --git a/TMessagesProj/src/main/java/tele/helpers/TeleTranslate.kt b/TMessagesProj/src/main/java/tele/helpers/TeleTranslate.kt
new file mode 100644
index 000000000..97eb26fad
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/TeleTranslate.kt
@@ -0,0 +1,22 @@
+package tele.helpers
+
+import org.telegram.messenger.LocaleController
+
+/** tele's own texts in the language of the app: russian and ukrainian come from the tables, the rest stays english. */
+object TeleTranslate {
+
+    @JvmStatic
+    fun language(): String = runCatching {
+        LocaleController.getInstance().getCurrentLocale()?.language ?: ""
+    }.getOrDefault("")
+
+    @JvmStatic
+    fun t(text: String): String {
+        if (text.isEmpty()) return text
+        return when (language()) {
+            "ru" -> TeleTextRu.strings[text] ?: text
+            "uk" -> TeleTextUk.strings[text] ?: text
+            else -> text
+        }
+    }
+}
