diff --git a/TMessagesProj/src/main/java/tele/helpers/GiftStudioMenu.kt b/TMessagesProj/src/main/java/tele/helpers/GiftStudioMenu.kt
index d61c021b0..c03c52e1a 100644
--- a/TMessagesProj/src/main/java/tele/helpers/GiftStudioMenu.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/GiftStudioMenu.kt
@@ -8,8 +8,8 @@ import tele.TeleConfig
 import tele.ui.TeleGiftStudioActivity
 
 /**
- * The entry of the gift studio in the menu of a gift (desktop 0197). The row is only there when
- * the setting is on, so the stock menu stays the same without it.
+ * The entry of the gift studio (desktop 0197). The rows are only there when the setting is on, so
+ * the stock menus stay the same without it.
  */
 object GiftStudioMenu {
 
@@ -34,4 +34,15 @@ object GiftStudioMenu {
             fragment?.presentFragment(TeleGiftStudioActivity(account, dialogId, gift))
         }
     }
+
+    /** The studio in the main menu of the chat list, like the desktop client. */
+    @JvmStatic
+    fun addMainMenuItem(fragment: BaseFragment, options: ItemOptions) {
+        if (!enabled()) return
+        val account = org.telegram.messenger.UserConfig.selectedAccount
+        options.add(R.drawable.filled_gift_simple, "Gift studio") {
+            options.dismiss()
+            fragment.presentFragment(TeleGiftStudioActivity(account, 0L, null))
+        }
+    }
 }
