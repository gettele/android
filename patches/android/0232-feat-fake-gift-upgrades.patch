+    /** The id of the gift that the fake upgrade rolls, or 0 when the gift can't be rolled. */
+    private long getFakeUpgradeGiftId() {
+        if (getUniqueGift() != null) return 0;
+        if (messageObject != null) {
+            if (messageObject.messageOwner != null && messageObject.messageOwner.action instanceof TLRPC.TL_messageActionStarGift) {
+                final TLRPC.TL_messageActionStarGift action = (TLRPC.TL_messageActionStarGift) messageObject.messageOwner.action;
+                return action.gift != null ? action.gift.gift_id : 0;
+            }
+            return 0;
+        }
+        if (savedStarGift != null && savedStarGift.gift != null) {
+            return savedStarGift.gift.gift_id;
+        }
+        return 0;
+    }
+
+    /** The gift can really be upgraded, so the request of the upgrade is sent to the server. */
+    private boolean canUpgradeForReal() {
+        if (messageObject != null) {
+            if (messageObject.messageOwner != null && messageObject.messageOwner.action instanceof TLRPC.TL_messageActionStarGift) {
+                return ((TLRPC.TL_messageActionStarGift) messageObject.messageOwner.action).can_upgrade;
+            }
+            return false;
+        }
+        if (savedStarGift != null) {
+            return savedStarGift.can_upgrade || (savedStarGift.gift != null && savedStarGift.gift.can_upgrade);
+        }
+        return false;
+    }
+
+    /** Starts the fake upgrade of tele, when the gift can be rolled. */
+    private boolean startFakeUpgrade() {
+        final long giftId = getFakeUpgradeGiftId();
+        if (giftId == 0) return false;
+        final TL_stars.StarGift gift = getGift();
+        tele.helpers.GiftFakeUpgrade.openRoll(getContext(), currentAccount, resourcesProvider, giftId, gift != null ? gift.title : null);
+        return true;
+    }
