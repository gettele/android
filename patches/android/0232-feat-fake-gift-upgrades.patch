@@ -0,0 +1,182 @@
+package tele.helpers
+
+import android.content.Context
+import android.util.Log
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.R
+import org.telegram.tgnet.tl.TL_stars
+import org.telegram.ui.Stars.StarsController
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Components.BulletinFactory
+import tele.TeleConfig
+import tele.ui.TeleGiftRollSheet
+import kotlin.random.Random
+
+/**
+ * The fake upgrade of a gift (desktop 0198): the upgrade of a regular gift is not sent to the
+ * server, it is rolled locally. The result is a random model, backdrop and symbol with their
+ * rarity weights and a number that counts the local rolls of the gift.
+ *
+ * Nothing is bought and nothing is sent: the roll only picks the attributes of the preview of the
+ * gift that the server already sends for the upgrade.
+ */
+object GiftFakeUpgrade {
+
+    /** The ids of the items of the fake upgrade. */
+    const val ID_FAKE_UPGRADE = 9700
+    const val ID_ROLL_AGAIN = 9701
+    const val ID_CLEAR_HISTORY = 9702
+    const val ID_ROLL_HISTORY = 9703
+
+    private const val TAG = "TeleGiftRoll"
+    private const val HISTORY_LIMIT = 50
+    private const val SHOWN_HISTORY = 20
+
+    /** One rolled upgrade. */
+    class Result(
+        val title: String,
+        val number: Int,
+        val model: TL_stars.starGiftAttributeModel?,
+        val pattern: TL_stars.starGiftAttributePattern?,
+        val backdrop: TL_stars.starGiftAttributeBackdrop?
+    ) {
+        val modelName: String get() = model?.name ?: ""
+        val patternName: String get() = pattern?.name ?: ""
+        val backdropName: String get() = backdrop?.name ?: ""
+    }
+
+    /** The attributes of a gift that a roll picks from. */
+    class Candidates(
+        val models: List<TL_stars.starGiftAttributeModel>,
+        val patterns: List<TL_stars.starGiftAttributePattern>,
+        val backdrops: List<TL_stars.starGiftAttributeBackdrop>
+    ) {
+        val isEmpty: Boolean get() = models.isEmpty() && patterns.isEmpty() && backdrops.isEmpty()
+    }
+
+    private val histories = HashMap<Int, ArrayList<Result>>()
+    private val counters = HashMap<Long, Int>()
+
+    @JvmStatic
+    fun enabled(): Boolean = TeleConfig.GIFT_FAKE_UPGRADE.value
+
+    /** The animation of the roll: without it the result is shown at once. */
+    @JvmStatic
+    fun animated(): Boolean = TeleConfig.GIFT_ROLL_ANIMATION.value
+
+    /** The number of the next roll of the gift. */
+    @JvmStatic
+    @Synchronized
+    fun nextNumber(giftId: Long): Int {
+        val count = (counters[giftId] ?: 0) + 1
+        counters[giftId] = count
+        return count
+    }
+
+    /** The rolls of the account, the newest first. */
+    @JvmStatic
+    fun history(account: Int): List<Result> = synchronized(histories) {
+        histories[account]?.toList() ?: emptyList()
+    }
+
+    /** The rolls of the account that the sheet shows. */
+    @JvmStatic
+    fun shownHistory(account: Int): List<Result> = history(account).take(SHOWN_HISTORY)
+
+    /** Forgets the rolls of the account. */
+    @JvmStatic
+    @Synchronized
+    fun clearHistory(account: Int) {
+        histories.remove(account)
+    }
+
+    /** Remembers a rolled upgrade. */
+    @JvmStatic
+    @Synchronized
+    private fun add(account: Int, result: Result) {
+        val list = histories.getOrPut(account) { ArrayList() }
+        list.add(0, result)
+        while (list.size > HISTORY_LIMIT) {
+            list.removeAt(list.size - 1)
+        }
+    }
+
+    /** Picks an attribute with its rarity weights. */
+    private fun <T> pick(list: List<T>, rarity: (T) -> Int): T? {
+        if (list.isEmpty()) return null
+        var total = 0
+        for (item in list) {
+            total += rarity(item)
+        }
+        if (total <= 0) {
+            return list[Random.nextInt(list.size)]
+        }
+        var left = Random.nextInt(total)
+        for (item in list) {
+            left -= rarity(item)
+            if (left < 0) return item
+        }
+        return list[list.size - 1]
+    }
+
+    /** The attributes of the preview of the gift. */
+    @JvmStatic
+    fun candidates(preview: TL_stars.starGiftUpgradePreview?): Candidates {
+        val attributes = preview?.sample_attributes ?: return Candidates(emptyList(), emptyList(), emptyList())
+        val models = ArrayList<TL_stars.starGiftAttributeModel>()
+        val patterns = ArrayList<TL_stars.starGiftAttributePattern>()
+        val backdrops = ArrayList<TL_stars.starGiftAttributeBackdrop>()
+        for (attribute in attributes) {
+            when (attribute) {
+                is TL_stars.starGiftAttributeModel -> models.add(attribute)
+                is TL_stars.starGiftAttributePattern -> patterns.add(attribute)
+                is TL_stars.starGiftAttributeBackdrop -> backdrops.add(attribute)
+            }
+        }
+        return Candidates(models, patterns, backdrops)
+    }
+
+    /** Rolls a gift and shows the result. */
+    @JvmStatic
+    fun openRoll(
+        context: Context,
+        account: Int,
+        resourcesProvider: Theme.ResourcesProvider?,
+        giftId: Long,
+        title: String?
+    ) {
+        if (!enabled()) return
+        if (giftId == 0L) return
+        StarsController.getInstance(account).getStarGiftPreview(giftId) { preview ->
+            val candidates = candidates(preview)
+            if (candidates.isEmpty) {
+                BulletinFactory.global()
+                    .createSimpleBulletin(R.raw.error, LocaleController.getString(R.string.TeleGiftFakeNoAttributes))
+                    .show()
+                return@getStarGiftPreview
+            }
+            Log.d(TAG, "fake_roll_start")
+            TeleGiftRollSheet(context, account, resourcesProvider, giftId, title, candidates).show()
+        }
+    }
+
+    /** Rolls a gift and shows the result. */
+    @JvmStatic
+    fun roll(
+        account: Int,
+        giftId: Long,
+        title: String?,
+        candidates: Candidates
+    ): Result {
+        val result = Result(
+            title ?: "",
+            nextNumber(giftId),
+            pick(candidates.models) { it.getRarityPermille() },
+            pick(candidates.patterns) { it.getRarityPermille() },
+            pick(candidates.backdrops) { it.getRarityPermille() }
+        )
+        add(account, result)
+        Log.d(TAG, "fake_roll_done")
+        return result
+    }
+}
