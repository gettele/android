+package tele.ui
+
+import android.content.Context
+import android.graphics.drawable.GradientDrawable
+import android.os.Handler
+import android.os.Looper
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.View
+import android.widget.FrameLayout
+import android.widget.LinearLayout
+import android.widget.ScrollView
+import android.widget.TextView
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.R
+import org.telegram.tgnet.tl.TL_stars
+import org.telegram.ui.ActionBar.BottomSheet
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Components.BackupImageView
+import org.telegram.ui.Components.LayoutHelper
+import org.telegram.ui.Stars.StarsIntroActivity
+import tele.helpers.GiftFakeUpgrade
+import kotlin.random.Random
+
+/**
+ * The sheet of the fake upgrade (desktop 0198): it rolls a gift locally and shows the result.
+ * Nothing is bought and nothing is sent.
+ */
+class TeleGiftRollSheet(
+    context: Context,
+    private val account: Int,
+    resourcesProvider: Theme.ResourcesProvider?,
+    private val giftId: Long,
+    private val giftTitle: String?,
+    private val candidates: GiftFakeUpgrade.Candidates
+) : BottomSheet(context, true, resourcesProvider) {
+
+    private val modelView = BackupImageView(context)
+    private val patternView = BackupImageView(context)
+    private val backdropView = View(context)
+    private val numberView = TextView(context)
+    private val modelNameView = TextView(context)
+    private val patternNameView = TextView(context)
+    private val backdropNameView = TextView(context)
+    private val rollButton = TextView(context)
+    private val historyLayout = LinearLayout(context)
+    private val clearHistoryView = TextView(context)
+
+    private val handler = Handler(Looper.getMainLooper())
+    private var rolling = false
+    private var result: GiftFakeUpgrade.Result? = null
+
+    private val step = Runnable {
+        if (!rolling) return@Runnable
+        showScrambled()
+        handler.postDelayed(step, ROLL_INTERVAL)
+    }
+
+    init {
+        currentAccount = account
+        fixNavigationBar()
+
+        val layout = LinearLayout(context)
+        layout.id = GiftFakeUpgrade.ID_FAKE_UPGRADE
+        layout.orientation = LinearLayout.VERTICAL
+        layout.setPadding(AndroidUtilities.dp(16f), 0, AndroidUtilities.dp(16f), 0)
+
+        val titleView = TextView(context)
+        titleView.text = giftTitle ?: LocaleController.getString(R.string.TeleGiftFakeTitle)
+        titleView.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 20f)
+        titleView.typeface = AndroidUtilities.bold()
+        titleView.gravity = Gravity.CENTER
+        titleView.setTextColor(Theme.getColor(Theme.key_dialogTextBlack, resourcesProvider))
+        layout.addView(titleView, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT, Gravity.CENTER, 0, 12, 0, 2))
+
+        val noticeView = TextView(context)
+        noticeView.text = LocaleController.getString(R.string.TeleGiftFakeNotice)
+        noticeView.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13f)
+        noticeView.gravity = Gravity.CENTER
+        noticeView.setTextColor(Theme.getColor(Theme.key_dialogTextGray2, resourcesProvider))
+        layout.addView(noticeView, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT, Gravity.CENTER, 0, 0, 0, 8))
+
+        val preview = FrameLayout(context)
+        preview.addView(backdropView, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, 220))
+        preview.addView(modelView, LayoutHelper.createFrame(160, 160, Gravity.CENTER))
+        preview.addView(patternView, LayoutHelper.createFrame(64, 64, Gravity.CENTER))
+        layout.addView(preview, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, 220))
+
+        numberView.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 17f)
+        numberView.typeface = AndroidUtilities.bold()
+        numberView.gravity = Gravity.CENTER
+        numberView.setTextColor(Theme.getColor(Theme.key_dialogTextBlack, resourcesProvider))
+        layout.addView(numberView, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT, Gravity.CENTER, 0, 8, 0, 2))
+
+        val names = LinearLayout(context)
+        names.orientation = LinearLayout.VERTICAL
+        names.gravity = Gravity.CENTER
+        addName(names, modelNameView)
+        addName(names, patternNameView)
+        addName(names, backdropNameView)
+        layout.addView(names, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT, Gravity.CENTER, 0, 0, 0, 8))
+
+        rollButton.id = GiftFakeUpgrade.ID_ROLL_AGAIN
+        rollButton.text = LocaleController.getString(R.string.TeleGiftFakeRoll)
+        rollButton.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16f)
+        rollButton.typeface = AndroidUtilities.bold()
+        rollButton.gravity = Gravity.CENTER
+        rollButton.setTextColor(Theme.getColor(Theme.key_featuredStickers_addButton, resourcesProvider))
+        rollButton.setPadding(AndroidUtilities.dp(16f), 0, AndroidUtilities.dp(16f), 0)
+        rollButton.background = Theme.createSimpleSelectorRoundRectDrawable(
+            AndroidUtilities.dp(8f),
+            Theme.multAlpha(Theme.getColor(Theme.key_featuredStickers_addButton, resourcesProvider), .12f),
+            Theme.multAlpha(Theme.getColor(Theme.key_featuredStickers_addButton, resourcesProvider), .24f)
+        )
+        rollButton.setOnClickListener { roll() }
+        layout.addView(rollButton, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, 48, Gravity.CENTER, 0, 4, 0, 12))
+
+        val historyTitle = TextView(context)
+        historyTitle.text = LocaleController.getString(R.string.TeleGiftFakeHistory)
+        historyTitle.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15f)
+        historyTitle.typeface = AndroidUtilities.bold()
+        historyTitle.setTextColor(Theme.getColor(Theme.key_dialogTextBlack, resourcesProvider))
+        layout.addView(historyTitle, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT, Gravity.START, 0, 0, 0, 4))
+
+        val scroll = ScrollView(context)
+        historyLayout.id = GiftFakeUpgrade.ID_ROLL_HISTORY
+        historyLayout.orientation = LinearLayout.VERTICAL
+        scroll.addView(historyLayout, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT))
+        layout.addView(scroll, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, 160))
+
+        clearHistoryView.id = GiftFakeUpgrade.ID_CLEAR_HISTORY
+        clearHistoryView.text = LocaleController.getString(R.string.TeleGiftFakeClearHistory)
+        clearHistoryView.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15f)
+        clearHistoryView.gravity = Gravity.CENTER
+        clearHistoryView.setTextColor(Theme.getColor(Theme.key_text_RedBold, resourcesProvider))
+        clearHistoryView.setPadding(0, AndroidUtilities.dp(10f), 0, AndroidUtilities.dp(10f))
+        clearHistoryView.setOnClickListener {
+            GiftFakeUpgrade.clearHistory(account)
+            refreshHistory()
+        }
+        layout.addView(clearHistoryView, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT))
+
+        setCustomView(layout)
+        refreshHistory()
+        roll()
+    }
+
+    private fun addName(parent: LinearLayout, view: TextView) {
+        view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14f)
+        view.gravity = Gravity.CENTER
+        view.setTextColor(Theme.getColor(Theme.key_dialogTextGray2, resourcesProvider))
+        parent.addView(view, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT, Gravity.CENTER, 0, 1, 0, 1))
+    }
+
+    /** The attributes that the roll shows while it runs. */
+    private fun showScrambled() {
+        val models = candidates.models
+        val patterns = candidates.patterns
+        val backdrops = candidates.backdrops
+        var model: TL_stars.starGiftAttributeModel? = null
+        var pattern: TL_stars.starGiftAttributePattern? = null
+        var backdrop: TL_stars.starGiftAttributeBackdrop? = null
+        if (models.isNotEmpty()) {
+            model = models[Random.nextInt(models.size)]
+            StarsIntroActivity.setGiftImage(modelView.getImageReceiver(), model.document, 160)
+        }
+        if (patterns.isNotEmpty()) {
+            pattern = patterns[Random.nextInt(patterns.size)]
+            StarsIntroActivity.setGiftImage(patternView.getImageReceiver(), pattern.document, 64)
+        }
+        if (backdrops.isNotEmpty()) {
+            backdrop = backdrops[Random.nextInt(backdrops.size)]
+            setBackdrop(backdrop)
+        }
+        numberView.text = "#" + (result?.number ?: 0)
+        modelNameView.text = model?.name ?: ""
+        patternNameView.text = pattern?.name ?: ""
+        backdropNameView.text = backdrop?.name ?: ""
+    }
+
+    private fun setBackdrop(backdrop: TL_stars.starGiftAttributeBackdrop) {
+        backdropView.background = GradientDrawable(
+            GradientDrawable.Orientation.TOP_BOTTOM,
+            intArrayOf(
+                backdrop.center_color or 0xFF000000.toInt(),
+                backdrop.edge_color or 0xFF000000.toInt()
+            )
+        )
+    }
+
+    /** Shows the result of the roll. */
+    private fun showResult(result: GiftFakeUpgrade.Result) {
+        numberView.text = "#" + result.number
+        modelNameView.text = result.modelName
+        patternNameView.text = result.patternName
+        backdropNameView.text = result.backdropName
+        result.model?.let { StarsIntroActivity.setGiftImage(modelView.getImageReceiver(), it.document, 160) }
+        result.pattern?.let { StarsIntroActivity.setGiftImage(patternView.getImageReceiver(), it.document, 64) }
+        result.backdrop?.let { setBackdrop(it) }
+        rollButton.text = LocaleController.getString(R.string.TeleGiftFakeRollAgain)
+    }
+
+    /** The roll of the gift: the attributes change until the roll ends. */
+    private fun roll() {
+        val rolled = GiftFakeUpgrade.roll(account, giftId, giftTitle, candidates)
+        result = rolled
+        if (!GiftFakeUpgrade.animated()) {
+            showResult(rolled)
+            return
+        }
+        rolling = true
+        handler.removeCallbacks(step)
+        handler.post(step)
+        handler.postDelayed({
+            rolling = false
+            handler.removeCallbacks(step)
+            showResult(rolled)
+        }, ROLL_DURATION)
+    }
+
+    /** The rolls of the account that the sheet shows under the button. */
+    private fun refreshHistory() {
+        historyLayout.removeAllViews()
+        val history = GiftFakeUpgrade.shownHistory(account)
+        if (history.isEmpty()) {
+            val empty = TextView(context)
+            empty.text = LocaleController.getString(R.string.TeleGiftFakeHistoryEmpty)
+            empty.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14f)
+            empty.setTextColor(Theme.getColor(Theme.key_dialogTextGray2, resourcesProvider))
+            historyLayout.addView(empty, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT))
+            clearHistoryView.visibility = View.GONE
+            return
+        }
+        clearHistoryView.visibility = View.VISIBLE
+        for (item in history) {
+            val view = TextView(context)
+            view.text = (item.title.ifEmpty { LocaleController.getString(R.string.TeleGiftFakeTitle) }) +
+                " #" + item.number +
+                (if (item.modelName.isNotEmpty()) " · " + item.modelName else "")
+            view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14f)
+            view.setTextColor(Theme.getColor(Theme.key_dialogTextBlack, resourcesProvider))
+            view.setPadding(0, AndroidUtilities.dp(4f), 0, AndroidUtilities.dp(4f))
+            historyLayout.addView(view, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT))
+        }
+    }
+
+    override fun onDetachedFromWindow() {
+        super.onDetachedFromWindow()
+        handler.removeCallbacks(step)
+        if (rolling) {
+            rolling = false
+            android.util.Log.d("TeleGiftRoll", "fake_roll_cancel")
+        }
+    }
+
+    companion object {
+        private const val ROLL_INTERVAL = 70L
+        private const val ROLL_DURATION = 1800L
+    }
+}
