+        /** The colour of the bottom rows of the photo as the header shows it, dimmed. */
+        private fun fillOf(photo: Bitmap, width: Int, height: Int): Int {
+            val side = photo.width
+            val bottom = if (width >= height) {
+                val part = (side.toLong() * height / max(width, 1)).toInt().coerceIn(1, side)
+                (side - part) / 2 + part
+            } else {
+                side
+            }
+            val color = average(photo, max(bottom - 2, 0), bottom)
+            val factor = 1.0 - (if (isDarkColor(color)) DIM_DARK else DIM_LIGHT)
+            fun dim(channel: Int) = (channel * factor + 0.5).toInt().coerceIn(0, 255)
+            return Color.rgb(dim(Color.red(color)), dim(Color.green(color)), dim(Color.blue(color)))
+        }
+
         private fun mix(from: Int, to: Int, amount: Float): Int = androidx.core.graphics.ColorUtils.blendARGB(from, to, amount)
+        private fun oklabLightness(color: Int): Double {
+            fun linear(value: Int): Double {
+                val v = value / 255.0
+                return if (v <= 0.04045) v / 12.92 else ((v + 0.055) / 1.055).pow(2.4)
+            }
+            val r = linear(Color.red(color))
+            val g = linear(Color.green(color))
+            val b = linear(Color.blue(color))
+            val l = cbrt(0.4122214708 * r + 0.5363325363 * g + 0.0514459929 * b)
+            val m = cbrt(0.2119034982 * r + 0.6806995451 * g + 0.1073969566 * b)
+            val s = cbrt(0.0883024619 * r + 0.2817188376 * g + 0.6299787005 * b)
+            return 0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s
+        }
+
+        private fun isDarkColor(color: Int): Boolean = oklabLightness(color) < DARK_LIGHTNESS
+
+        private fun luminance(color: Int): Double {
+            fun linear(value: Int): Double {
+                val v = value / 255.0
+                return if (v <= 0.04045) v / 12.92 else ((v + 0.055) / 1.055).pow(2.4)
+            }
+            return 0.2126 * linear(Color.red(color)) + 0.7152 * linear(Color.green(color)) + 0.0722 * linear(Color.blue(color))
+        }
+
+        private fun contrast(a: Int, b: Int): Double {
+            val x = luminance(a) + 0.05
+            val y = luminance(b) + 0.05
+            return max(x, y) / min(x, y)
+        }
+
+        /** Moves a label colour towards white or black until it reads on the background. */
+        private fun readable(label: Int, background: Int, dark: Boolean): Int {
+            val towards = if (dark) Color.WHITE else Color.BLACK
+            var result = label
+            var step = 1
+            while (step <= 20 && contrast(result, background) < LABEL_CONTRAST) {
+                result = mix(label, towards, step / 20f)
+                step++
+            }
+            return (label and (0xFF shl 24)) or (result and 0xFFFFFF)
+        }
+
+        /** The offset of a surface colour from the base one, carried over to the fill. */
+        private fun shift(value: Int, base: Int, fill: Int): Int {
+            val r = Color.red(value) - Color.red(base)
+            val g = Color.green(value) - Color.green(base)
+            val b = Color.blue(value) - Color.blue(base)
+            fun fits(channel: Int) = channel in 0..255
+            val sign = if (fits(Color.red(fill) + r) && fits(Color.green(fill) + g) && fits(Color.blue(fill) + b)) 1 else -1
+            fun at(channel: Int, delta: Int) = (channel + sign * delta).coerceIn(0, 255)
+            return Color.argb(Color.alpha(value), at(Color.red(fill), r), at(Color.green(fill), g), at(Color.blue(fill), b))
+        }
+
