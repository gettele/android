+
+    /**
+     * The profile-scoped colours: every key goes to the original provider, but the surfaces,
+     * dividers and labels of the profile body while the fill is on.
+     */
+    class ProfilePhotoTheme(val inner: Theme.ResourcesProvider?) : Theme.ResourcesProvider {
+        var active = false
+            private set
+        var fill = 0
+            private set
+        private val cache = SparseIntArray()
+
+        fun applyFill(color: Int): Boolean {
+            if (active && fill == color) return false
+            active = true
+            fill = color
+            cache.clear()
+            return true
+        }
+
+        fun deactivate(): Boolean {
+            if (!active) return false
+            active = false
+            cache.clear()
+            return true
+        }
+
+        fun reset() = cache.clear()
+
+        private fun stock(key: Int): Int = inner?.getColor(key) ?: Theme.getColor(key)
+
+        override fun getColor(key: Int): Int {
+            if (!active) return stock(key)
+            if (key == Theme.key_windowBackgroundWhite) return fill or (0xFF shl 24)
+            val kind = kinds.get(key, 0)
+            if (kind == 0) return stock(key)
+            val index = cache.indexOfKey(key)
+            if (index >= 0) return cache.valueAt(index)
+            val base = stock(key)
+            val background = fill or (0xFF shl 24)
+            val result = when (kind) {
+                SURFACE -> shift(base, stock(Theme.key_windowBackgroundWhite), background)
+                LABEL -> readable(base, background, isDarkColor(background))
+                else -> (base and (0xFF shl 24)) or (if (isDarkColor(background)) 0xFFFFFF else 0)
+            }
+            cache.put(key, result)
+            return result
+        }
+
+        override fun getColorOrDefault(key: Int): Int = if (active && overrides(key)) getColor(key) else inner?.getColorOrDefault(key) ?: stock(key)
+
+        override fun getCurrentColor(key: Int): Int = if (active && overrides(key)) getColor(key) else inner?.getCurrentColor(key) ?: stock(key)
+
+        private fun overrides(key: Int) = key == Theme.key_windowBackgroundWhite || kinds.get(key, 0) != 0
+
+        override fun setAnimatedColor(key: Int, color: Int) {
+            inner?.setAnimatedColor(key, color)
+        }
+
+        override fun getDrawable(drawableKey: String?): Drawable? = inner?.getDrawable(drawableKey)
+
+        override fun getPaint(paintKey: String?): Paint? = inner?.getPaint(paintKey) ?: Theme.getThemePaint(paintKey)
+
+        override fun hasGradientService(): Boolean = inner?.hasGradientService() ?: false
+
+        override fun isDark(): Boolean = inner?.isDark() ?: Theme.isCurrentThemeDark()
+
+        override fun applyServiceShaderMatrix(w: Int, h: Int, translationX: Float, translationY: Float) {
+            if (inner != null) inner.applyServiceShaderMatrix(w, h, translationX, translationY)
+            else Theme.applyServiceShaderMatrix(w, h, translationX, translationY)
+        }
+
+        override fun getAnimatedEmojiColorFilter(): ColorFilter? = inner?.animatedEmojiColorFilter ?: Theme.chat_animatedEmojiTextColorFilter
     }
 }
