+    private fun drawSeam(canvas: Canvas, width: Int, bottom: Int, alpha: Int) {
+        val fill = theme?.takeIf { it.active }?.fill ?: return
+        val seam = min(AndroidUtilities.dp(48f), bottom / 2)
+        if (seam <= 0) return
+        if (seamTop != bottom - seam || seamBottom != bottom || seamColor != fill) {
+            seamTop = bottom - seam
+            seamBottom = bottom
+            seamColor = fill
+            seamPaint.shader = LinearGradient(0f, seamTop.toFloat(), 0f, bottom.toFloat(), fill and 0xFFFFFF, fill or (0xFF shl 24), Shader.TileMode.CLAMP)
+        }
+        seamPaint.alpha = alpha
+        canvas.drawRect(0f, seamTop.toFloat(), width.toFloat(), bottom.toFloat(), seamPaint)
+    }
