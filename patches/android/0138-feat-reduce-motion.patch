+++ b/TMessagesProj/src/main/java/tele/helpers/TeleReduceMotion.kt
@@ -0,0 +1,32 @@
+package tele.helpers
+
+import org.telegram.messenger.LiteMode
+import tele.TeleConfig
+import tele.db.TeleDatabaseHelper
+
+// the reduce motion switch (tele 0154): the animations of the stickers, the emoji and the particles are off
+object TeleReduceMotion {
+
+    private const val KEY = "reduce_motion_saved"
+
+    private val REDUCED = LiteMode.FLAGS_ANIMATED_STICKERS or
+        LiteMode.FLAGS_ANIMATED_EMOJI or
+        LiteMode.FLAG_PARTICLES or
+        LiteMode.FLAG_AUTOPLAY_VIDEOS or
+        LiteMode.FLAG_AUTOPLAY_GIFS
+
+    @JvmStatic
+    fun apply() {
+        val saved = TeleDatabaseHelper.get(KEY)
+        if (TeleConfig.REDUCE_MOTION.value) {
+            if (saved == null) {
+                val current = LiteMode.getValue(true)
+                TeleDatabaseHelper.put(KEY, current.toString())
+                LiteMode.setAllFlags(current and REDUCED.inv())
+            }
+        } else if (saved != null) {
+            LiteMode.setAllFlags(saved.toIntOrNull() ?: LiteMode.getValue(true))
+            TeleDatabaseHelper.put(KEY, null)
+        }
+    }
+}
