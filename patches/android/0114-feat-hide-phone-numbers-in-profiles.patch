From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Wed, 21 Oct 2026 23:24:51 +0300
Subject: [PATCH 114/132] feat: hide phone numbers in profiles

---
 .../src/main/java/org/telegram/ui/ProfileActivity.java          | 2 +-
 TMessagesProj/src/main/java/tele/TeleConfig.kt                  | 2 ++
 TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt      | 1 +
 .../src/main/java/tele/ui/settings/TeleSettingsActivity.kt      | 2 ++
 4 files changed, 6 insertions(+), 1 deletion(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/ProfileActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/ProfileActivity.java
index 675a8409f..2f0b5a0cb 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/ProfileActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/ProfileActivity.java
@@ -10815,7 +10815,7 @@ public class ProfileActivity extends BaseFragment implements NotificationCenter.
                     }
                 }
                 infoStartRow = rowCount;
-                if (!isBot && (hasPhone || !hasInfo)) {
+                if (!isBot && (hasPhone || !hasInfo) && !tele.TeleConfig.HIDE_PHONE_IN_PROFILES.getValue()) {
                     phoneRow = rowCount++;
                 }
                 if (userInfo != null && !TextUtils.isEmpty(userInfo.about)) {
diff --git a/TMessagesProj/src/main/java/tele/TeleConfig.kt b/TMessagesProj/src/main/java/tele/TeleConfig.kt
index 4562eaffe..c00812f08 100644
--- a/TMessagesProj/src/main/java/tele/TeleConfig.kt
+++ b/TMessagesProj/src/main/java/tele/TeleConfig.kt
@@ -208,6 +208,8 @@ object TeleConfig {
     val HIDE_SIMILAR_CHANNELS = BoolItem("hide_similar_channels", false)
     @JvmField
     val HIDE_COLLECTIBLE_HINT = BoolItem("hide_collectible_hint", false)
+    @JvmField
+    val HIDE_PHONE_IN_PROFILES = BoolItem("hide_phone_in_profiles", false)
 
     private var prefs: SharedPreferences? = null
 
diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt
index d34056e14..508fe954b 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt
@@ -133,6 +133,7 @@ object TeleSearch {
             section(1120, "Hide the gift button in the message field", "sending", TeleSettingsActivity.MODE_SENDING),
             section(1121, "Hide similar channels", "interface", TeleSettingsActivity.MODE_INTERFACE),
             section(1122, "Hide the collectible status hint", "interface", TeleSettingsActivity.MODE_INTERFACE),
+            section(1124, "Hide phone numbers in profiles", "privacy", TeleSettingsActivity.MODE_PRIVACY),
             section(GUID_UPDATES, "Update automatically", "updates", TeleSettingsActivity.MODE_ROOT),
             section(GUID_UPDATES + 1, "Check for updates", "updates", TeleSettingsActivity.MODE_ROOT),
             section(GUID_UPDATES + 2, "Show what's new after updates", "updates", TeleSettingsActivity.MODE_ROOT),
diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
index de0dcee34..e768f3a25 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
@@ -379,6 +379,7 @@ class TeleSettingsActivity @JvmOverloads constructor(private val mode: String =
             "Mute ignored messages" to "Do not notify about the messages of the ignored people. The server counters stay the same.",
             "Peek at hidden last seen" to "Briefly show the last seen of a peer that hides it, then restore your own rule. The peer can see that you looked.",
             "Streamer mode" to "Block screen capture in every window and hide the notification previews.",
+            "Hide phone numbers in profiles" to "Do not show the phone number row in a profile.",
         )
 
         private fun toggle(title: String, item: Item<*>) = Row(TYPE_TOGGLE, title = title, subtitle = DESCRIPTIONS[title], item = item)
@@ -526,6 +527,7 @@ class TeleSettingsActivity @JvmOverloads constructor(private val mode: String =
                 }
                 rows.add(toggle("Peek at hidden last seen", TeleConfig.LAST_SEEN_RESTORE))
                 rows.add(toggle("Streamer mode", TeleConfig.STREAMER_MODE))
+                rows.add(toggle("Hide phone numbers in profiles", TeleConfig.HIDE_PHONE_IN_PROFILES))
                 rows.add(Row(TYPE_SHADOW))
                 rows.add(Row(TYPE_HEADER, "links"))
                 rows.add(toggle("Clean tracking parameters from opened links", TeleConfig.CLEAN_OPENED_LINKS))
