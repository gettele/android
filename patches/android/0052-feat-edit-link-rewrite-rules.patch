+package tele.ui.settings
+
+import android.content.Context
+import android.text.InputType
+import android.view.View
+import android.view.ViewGroup
+import android.widget.EditText
+import android.widget.FrameLayout
+import android.widget.LinearLayout
+import androidx.recyclerview.widget.LinearLayoutManager
+import androidx.recyclerview.widget.RecyclerView
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.R
+import org.telegram.ui.ActionBar.AlertDialog
+import org.telegram.ui.ActionBar.ActionBar
+import org.telegram.ui.ActionBar.BaseFragment
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Cells.HeaderCell
+import org.telegram.ui.Cells.TextInfoPrivacyCell
+import org.telegram.ui.Cells.TextSettingsCell
+import org.telegram.ui.Components.LayoutHelper
+import org.telegram.ui.Components.RecyclerListView
+import tele.helpers.LinkRewrites
+
+class TeleRulesActivity : BaseFragment() {
+
+    private var adapter: Adapter? = null
+    private var items: MutableList<LinkRewrites.Rule> = mutableListOf()
+
+    private fun reload() {
+        items = LinkRewrites.rules().toMutableList()
+        adapter?.notifyDataSetChanged()
+    }
+
+    override fun createView(context: Context): View {
+        actionBar.setBackButtonImage(R.drawable.ic_ab_back)
+        actionBar.setAllowOverlayTitle(true)
+        actionBar.setTitle("link rewrite rules")
+        actionBar.setActionBarMenuOnItemClick(object : ActionBar.ActionBarMenuOnItemClick() {
+            override fun onItemClick(id: Int) {
+                if (id == -1) {
+                    finishFragment()
+                }
+            }
+        })
+
+        reload()
+
+        val frameLayout = FrameLayout(context)
+        frameLayout.setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundGray))
+        fragmentView = frameLayout
+
+        val listView = RecyclerListView(context)
+        listView.setLayoutManager(LinearLayoutManager(context))
+        listView.setVerticalScrollBarEnabled(false)
+        adapter = Adapter(context)
+        listView.setAdapter(adapter)
+        listView.setOnItemClickListener { view, position ->
+            when {
+                position == items.size + 1 -> showRuleDialog(null, LinkRewrites.TYPE_DOMAIN)
+                position == items.size + 2 -> showRuleDialog(null, LinkRewrites.TYPE_PATTERN)
+                position in 1..items.size -> showRuleDialog(items[position - 1], items[position - 1].type)
+            }
+        }
+        frameLayout.addView(listView, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.MATCH_PARENT.toFloat()))
+        return fragmentView
+    }
+
+    private fun indexOf(rule: LinkRewrites.Rule): Int {
+        for (i in items.indices) {
+            if (items[i] === rule) return i
+        }
+        return -1
+    }
+
+    private fun showRuleDialog(existing: LinkRewrites.Rule?, type: String) {
+        val activity = parentActivity ?: return
+        val domainMode = type == LinkRewrites.TYPE_DOMAIN
+
+        val fromField = EditText(activity)
+        fromField.hint = if (domainMode) "from domains, comma separated" else "find (regex)"
+        fromField.isSingleLine = true
+        fromField.setText(when {
+            existing == null -> ""
+            domainMode -> existing.from.joinToString(", ")
+            else -> existing.find
+        })
+        val toField = EditText(activity)
+        toField.hint = if (domainMode) "to domains, comma separated" else "replace (use \$1..\$9)"
+        toField.isSingleLine = true
+        toField.setText(when {
+            existing == null -> ""
+            domainMode -> existing.to.joinToString(", ")
+            else -> existing.replace
+        })
+
+        val container = LinearLayout(activity)
+        container.orientation = LinearLayout.VERTICAL
+        val pad = AndroidUtilities.dp(20f)
+        container.setPadding(pad, AndroidUtilities.dp(12f), pad, AndroidUtilities.dp(4f))
+        container.addView(fromField, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT))
+        toField.inputType = InputType.TYPE_TEXT_FLAG_NO_SUGGESTIONS
+        container.addView(toField, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT).also {
+            it.topMargin = AndroidUtilities.dp(10f)
+        })
+
+        val builder = if (resourceProvider != null) AlertDialog.Builder(activity, resourceProvider) else AlertDialog.Builder(activity)
+        builder.setTitle(if (domainMode) "domain rule" else "pattern rule")
+        builder.setView(container)
+        if (existing != null) {
+            builder.setNeutralButton(LocaleController.getString(R.string.Delete)) { _, _ ->
+                val index = indexOf(existing)
+                if (index >= 0) {
+                    items.removeAt(index)
+                    LinkRewrites.saveRules(items)
+                    adapter?.notifyItemRemoved(index + 1)
+                    adapter?.notifyItemRangeChanged(index + 1, 2)
+                }
+            }
+        }
+        builder.setPositiveButton(LocaleController.getString(R.string.Save)) { _, _ ->
+            val rule = if (domainMode) {
+                val from = fromField.text.toString().split(",").map { it.trim() }.filter { it.isNotEmpty() }
+                val to = toField.text.toString().split(",").map { it.trim() }.filter { it.isNotEmpty() }
+                if (from.isEmpty() || to.isEmpty()) return@setPositiveButton
+                LinkRewrites.Rule(LinkRewrites.TYPE_DOMAIN, from = from, to = to, random = to.size > 1)
+            } else {
+                val find = fromField.text.toString().trim()
+                if (find.isEmpty()) return@setPositiveButton
+                LinkRewrites.Rule(LinkRewrites.TYPE_PATTERN, find = find, replace = toField.text.toString())
+            }
+            if (existing != null) {
+                val index = indexOf(existing)
+                if (index >= 0) items[index] = rule
+            } else {
+                items.add(rule)
+            }
+            LinkRewrites.saveRules(items)
+            adapter?.notifyDataSetChanged()
+        }
+        builder.setNegativeButton(LocaleController.getString(R.string.Cancel), null)
+        showDialog(builder.create())
+    }
+
+    private inner class Adapter(private val context: Context) : RecyclerListView.SelectionAdapter() {
+
+        private fun itemCount(): Int = items.size + 3
+
+        override fun getItemCount(): Int = itemCount()
+
+        override fun isEnabled(holder: RecyclerView.ViewHolder): Boolean = holder.adapterPosition != 0
+
+        override fun onCreateViewHolder(parent: ViewGroup, viewType: Int): RecyclerView.ViewHolder {
+            val view: View = when (viewType) {
+                TYPE_HEADER -> HeaderCell(context)
+                TYPE_SHADOW -> TextInfoPrivacyCell(context)
+                else -> TextSettingsCell(context)
+            }
+            view.layoutParams = RecyclerView.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT)
+            return RecyclerListView.Holder(view)
+        }
+
+        override fun onBindViewHolder(holder: RecyclerView.ViewHolder, position: Int) {
+            when (val cell = holder.itemView) {
+                is HeaderCell -> cell.setText("rules")
+                is TextInfoPrivacyCell -> cell.setText("applied to links pasted into the message field, first matching rule wins")
+                else -> {
+                    if (position in 1..items.size) {
+                        (cell as TextSettingsCell).setTextAndValue(items[position - 1].summary(), "edit", true)
+                    } else if (position == items.size + 1) {
+                        (cell as TextSettingsCell).setTextAndValue("add domain rule", null, true)
+                    } else {
+                        (cell as TextSettingsCell).setTextAndValue("add pattern rule", null, false)
+                    }
+                }
+            }
+        }
+
+        override fun getItemViewType(position: Int): Int = when (position) {
+            0 -> TYPE_HEADER
+            itemCount() - 1 -> TYPE_SHADOW
+            else -> TYPE_ENTRY
+        }
+    }
+
+    companion object {
+        private const val TYPE_HEADER = 0
+        private const val TYPE_ENTRY = 1
+        private const val TYPE_SHADOW = 2
+    }
+}
\ No newline at end of file
