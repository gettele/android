     private inner class Tile(context: Context, private val item: DockedMedia.Item, private val index: Int) : FrameLayout(context) {
+        private val spoilerEffect = if (item.spoiler) SpoilerEffect() else null
+        private var downX = 0f
+        private var downY = 0f
+        private var longPressed = false
+        private var dragging = false
+
+        override fun dispatchDraw(canvas: Canvas) {
+            super.dispatchDraw(canvas)
+            val effect = spoilerEffect ?: return
+            effect.setColor(0x66FFFFFF)
+            effect.setBounds(0, 0, width, height)
+            effect.draw(canvas)
+        }
+
+        override fun onTouchEvent(event: MotionEvent): Boolean {
+            when (event.actionMasked) {
+                MotionEvent.ACTION_DOWN -> {
+                    downX = event.rawX
+                    downY = event.rawY
+                    longPressed = false
+                    dragging = false
+                }
+                MotionEvent.ACTION_MOVE -> {
+                    val dx = event.rawX - downX
+                    val dy = event.rawY - downY
+                    if (longPressed && !dragging && abs(dx) > AndroidUtilities.dp(8f) && abs(dx) > abs(dy)) {
+                        dragging = true
+                        cancelLongPress()
+                    }
+                    if (dragging && abs(dx) > AndroidUtilities.dp(TILE * 0.55f)) {
+                        DockedMedia.move(key, item, if (dx > 0) 1 else -1)
+                        downX = event.rawX
+                    }
+                }
+                MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> {
+                    if (longPressed) {
+                        val wasDragging = dragging
+                        longPressed = false
+                        dragging = false
+                        if (!wasDragging && event.actionMasked == MotionEvent.ACTION_UP) showMenu()
+                        return true
+                    }
+                }
+            }
+            return super.onTouchEvent(event)
+        }
+
         init {
+            spoilerEffect?.callback = this
             val image = BackupImageView(context)
             image.setRoundRadius(AndroidUtilities.dp(8f))
