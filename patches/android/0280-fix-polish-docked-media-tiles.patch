-                addView(name, LayoutHelper.createFrame((TILE - 8f).toInt(), LayoutHelper.WRAP_CONTENT.toFloat(), Gravity.LEFT or Gravity.BOTTOM, 5f, 0f, 0f, 8f))
+                addFilePreview(context)
             } else if (document != null) {
                 image.setAspectFit(true)
                 val color = Theme.getColor(Theme.key_chat_messagePanelIcons, fragment.resourceProvider)
