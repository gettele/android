+        private fun addFilePreview(context: Context) {
+            val name = item.fileName ?: "file"
+            val type = name.substringAfterLast('.', "").lowercase()
+            val row = LinearLayout(context)
+            row.orientation = LinearLayout.HORIZONTAL
+            row.gravity = Gravity.CENTER_VERTICAL
+            row.setPadding(AndroidUtilities.dp(4f), 0, AndroidUtilities.dp(6f), 0)
+            val icon = android.widget.ImageView(context)
+            icon.setImageResource(AndroidUtilities.getThumbForNameOrMime(name, type, false))
+            row.addView(icon, LinearLayout.LayoutParams(AndroidUtilities.dp(44f), AndroidUtilities.dp(44f)))
+            val text = LinearLayout(context)
+            text.orientation = LinearLayout.VERTICAL
+            text.setPadding(AndroidUtilities.dp(6f), 0, 0, 0)
+            val title = TextView(context)
+            title.setTextSize(android.util.TypedValue.COMPLEX_UNIT_DIP, 12f)
+            title.setTypeface(AndroidUtilities.bold())
+            title.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText, fragment.resourceProvider))
+            title.ellipsize = android.text.TextUtils.TruncateAt.MIDDLE
+            title.maxLines = 2
+            title.text = name
+            text.addView(title, LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT))
+            val subtitle = TextView(context)
+            subtitle.setTextSize(android.util.TypedValue.COMPLEX_UNIT_DIP, 11f)
+            subtitle.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText3, fragment.resourceProvider))
+            subtitle.text = AndroidUtilities.formatFileSize(item.size)
+            text.addView(subtitle, LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, LinearLayout.LayoutParams.WRAP_CONTENT))
+            row.addView(text, LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1f))
+            addView(row, LayoutHelper.createFrameMatchParent())
+        }
+
+        private fun showMenu() {
+            val document = item.document
+            val options = ItemOptions.makeOptions(fragment, this)
+            if (index > 0) {
+                options.add(R.drawable.msg_arrow_back, TeleLowercase.lc("Move left")) { DockedMedia.move(key, item, -1) }
+            }
+            if (index < (DockedMedia.tray(key)?.items?.size ?: 0) - 1) {
+                options.add(R.drawable.msg_arrow_forward, TeleLowercase.lc("Move right")) { DockedMedia.move(key, item, 1) }
+            }
+            if (!item.isFile && document == null) {
+                options.add(if (item.spoiler) R.drawable.msg_spoiler_off else R.drawable.msg_spoiler, if (item.spoiler) TeleLowercase.lc("Remove spoiler") else TeleLowercase.lc("Hide with spoiler")) { DockedMedia.toggleSpoiler(key, item) }
+            }
+            options.add(R.drawable.msg_delete, "Remove", true) { DockedMedia.remove(key, item) }
+                .show()
         }
     }
 
