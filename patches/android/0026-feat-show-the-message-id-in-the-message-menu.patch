From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Sat, 3 Oct 2026 12:32:17 +0300
Subject: [PATCH] feat: show the message id in the message menu

---
 .../src/main/java/org/telegram/ui/ChatActivity.java  | 12 ++++++++++++
 TMessagesProj/src/main/java/tele/TeleConfig.kt       |  2 ++
 .../java/tele/ui/settings/TeleSettingsActivity.kt    |  3 ++-
 TMessagesProj/src/main/res/values/strings_tele.xml   |  1 +
 4 files changed, 17 insertions(+), 1 deletion(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
index 178374b7b..330d9b078 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
@@ -1243,6 +1243,7 @@ public class ChatActivity extends BaseFragment implements
     public final static int OPTION_HIDE_SPONSORED_MESSAGE = 31;
     public final static int OPTION_VIEW_IN_TOPIC = 32;
     public final static int tele_option_mark_viewed = 217;
+    public final static int tele_option_copy_msg_id = 118;
     public final static int OPTION_ABOUT_REVENUE_SHARING_ADS = 33;
     public final static int OPTION_REPORT_AD = 34;
     public final static int OPTION_REMOVE_ADS = 35;
@@ -33501,6 +33502,11 @@ public class ChatActivity extends BaseFragment implements
                 tele.TeleHooks.forceMarkViewed(currentAccount, selectedObject);
                 break;
             }
+            case tele_option_copy_msg_id: {
+                AndroidUtilities.addToClipboard(String.valueOf(selectedObject.getId()));
+                BulletinFactory.of(this).createCopyBulletin(getString(R.string.TeleMessageIdCopied)).show();
+                break;
+            }
             case OPTION_COPY: {
                 final TL_iv.RichMessage copyRichMessage = selectedObject.messageOwner != null ? selectedObject.messageOwner.rich_message : null;
                 if (selectedObject.isDice()) {
@@ -45899,6 +45905,12 @@ public class ChatActivity extends BaseFragment implements
         final boolean isEphemeral = message.isEphemeral();
         final boolean isEphemeralFromBot = isEphemeral && !message.isOut();
 
+        if (tele.TeleConfig.MESSAGE_ID_MENU.getValue() && message.getId() > 0) {
+            items.add(0, "ID: " + message.getId());
+            options.add(0, tele_option_copy_msg_id);
+            icons.add(0, R.drawable.msg_copy);
+        }
+
 
         boolean allowChatActions = true;
         boolean allowPin;
diff --git a/TMessagesProj/src/main/java/tele/TeleConfig.kt b/TMessagesProj/src/main/java/tele/TeleConfig.kt
index ba77f0686..85ec5979b 100644
--- a/TMessagesProj/src/main/java/tele/TeleConfig.kt
+++ b/TMessagesProj/src/main/java/tele/TeleConfig.kt
@@ -90,6 +90,8 @@ object TeleConfig {
     val SHOW_DC = BoolItem("show_dc", false)
     @JvmField
     val MERGE_ID_DC = BoolItem("merge_id_dc", false)
+    @JvmField
+    val MESSAGE_ID_MENU = BoolItem("message_id_menu", false)
 
     private var prefs: SharedPreferences? = null
 
diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
index 23510914d..8f8201012 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
@@ -96,7 +96,8 @@ class TeleSettingsActivity : BaseFragment() {
             Row(TYPE_TOGGLE, "ids without spaces", item = TeleConfig.PEER_IDS_WITHOUT_SPACES),
             Row(TYPE_TOGGLE, "bot api style ids", item = TeleConfig.BOT_API_PEER_IDS),
             Row(TYPE_TOGGLE, "show data center", item = TeleConfig.SHOW_DC),
-            Row(TYPE_TOGGLE, "id and dc in one row", item = TeleConfig.MERGE_ID_DC)
+            Row(TYPE_TOGGLE, "id and dc in one row", item = TeleConfig.MERGE_ID_DC),
+            Row(TYPE_TOGGLE, "show message id in the message menu", item = TeleConfig.MESSAGE_ID_MENU)
         )
 
         override fun getItemCount(): Int = rows.size
diff --git a/TMessagesProj/src/main/res/values/strings_tele.xml b/TMessagesProj/src/main/res/values/strings_tele.xml
index 591f1dad6..843cd2ebe 100644
--- a/TMessagesProj/src/main/res/values/strings_tele.xml
+++ b/TMessagesProj/src/main/res/values/strings_tele.xml
@@ -4,4 +4,5 @@
     <string name="TeleProfileDc">DC</string>
     <string name="TeleIdCopied">ID copied to clipboard</string>
     <string name="TeleDcCopied">DC copied to clipboard</string>
+    <string name="TeleMessageIdCopied">Message ID copied to clipboard</string>
 </resources>
