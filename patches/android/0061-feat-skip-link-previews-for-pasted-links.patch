+    private fun chooseLinkPreviewMode() {
+        val activity = parentActivity ?: return
+        val values = arrayOf("all", "pasted")
+        val labels = arrayOf("for all links", "not for pasted links")
+        val builder = if (resourceProvider != null) AlertDialog.Builder(activity, resourceProvider) else AlertDialog.Builder(activity)
+        builder.setTitle("automatic link previews")
+        builder.setItems(labels) { _, which ->
+            TeleConfig.set(TeleConfig.LINK_PREVIEW_MODE, values[which])
+            adapter?.refresh()
+        }
+        showDialog(builder.create())
+    }
+
