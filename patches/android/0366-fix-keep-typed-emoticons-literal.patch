From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: test <test@example.com>
Date: Sat, 21 Nov 2026 23:04:01 +0300
Subject: [PATCH] fix: keep typed emoticons literal

Auto-pairing turned :-( into :-() by closing the paren. A paren that continues an emoticon (after : ; = 8 B, optional - and extra parens) stays literal, like desktop 0346.
---
 .../src/main/java/tele/helpers/ComposerEditing.kt   | 13 ++++++++++++-
 1 file changed, 12 insertions(+), 1 deletion(-)

diff --git a/TMessagesProj/src/main/java/tele/helpers/ComposerEditing.kt b/TMessagesProj/src/main/java/tele/helpers/ComposerEditing.kt
index 22362bd11..45ecb59ab 100644
--- a/TMessagesProj/src/main/java/tele/helpers/ComposerEditing.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/ComposerEditing.kt
@@ -203,11 +203,22 @@ object ComposerEditing {
             val previous = if (position > 0) s[position - 1] else null
             val word = previous != null && previous.isLetterOrDigit()
             return when (opening) {
-                '(', '[', '{' -> next != closing
+                // a paren that continues an emoticon like :-( stays literal (desktop 0346)
+                '(' -> next != closing && !continuesEmoticon(s, position)
+                '[', '{' -> next != closing
                 else -> boundary(next) && !word && previous != opening
             }
         }
 
+        private fun continuesEmoticon(s: Editable, position: Int): Boolean {
+            var end = position
+            while (end > 0 && s[end - 1] == '(') end--
+            if (end > 0 && s[end - 1] == '-') end--
+            if (end == 0) return false
+            val before = s[end - 1]
+            return before == ':' || before == ';' || before == '=' || before == '8' || before == 'B'
+        }
+
         private fun boundary(next: Char?): Boolean =
             next == null || next.isWhitespace() || next in COMPOSER_CLOSINGS
 
