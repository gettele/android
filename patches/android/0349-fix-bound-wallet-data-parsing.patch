++    #[test]
++    fn test_bin_tree_shared_cells_walk_is_bounded() -> anyhow::Result<()> {
++        // bt_leaf$0 under 60 levels of bt_fork$1 whose two references are one cell: 2^60 paths
++        let mut builder = TonCell::builder();
++        builder.write_bit(false)?;
