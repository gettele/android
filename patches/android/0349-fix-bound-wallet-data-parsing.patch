++/// Libraries a `StateInit` may carry when it is written.
++///
++/// Reading is bound by the dictionary walk budget alone, chain data is parsed whatever it
++/// carries. Writing builds the dictionary again from the parsed map, a new cell tree per
++/// entry (about 3.7 KB and 3.4 us each), and a wallet request attaches a caller-supplied
++/// `StateInit` to each of up to 255 messages: a 97-byte dictionary of shared cells would be
++/// written back as 32768 entries per message. A deployment carries none, rarely a few.
++pub const STATE_INIT_MAX_WRITTEN_LIBS: usize = 16;
++
+ // https://github.com/ton-blockchain/ton/blob/59a8cf0ae5c3062d14ec4c89a04fee80b5fd05c1/crypto/block/block.tlb#L281
+ #[derive(Debug, Clone, PartialEq, TLB)]
+ pub struct StateInit {
+@@ -18,10 +28,37 @@ pub struct StateInit {
+     pub tick_tock: Option<TickTock>,
+     pub code: Option<TLBRef<TonCell>>,
+     pub data: Option<TLBRef<TonCell>>,
+-    #[tlb(adapter = "TLBHashMapE::<DictKeyAdapterTonHash, DictValAdapterTLB<_>>::new(256)")]
++    #[tlb(adapter = "StateInitLibs")]
+     pub library: HashMap<TonHash, SimpleLib>,
+ }
+ 
++/// `library:(HashmapE 256 SimpleLib)` that refuses to write more than the limit above.
++struct StateInitLibs;
++
++impl StateInitLibs {
++    fn dict() -> TLBHashMapE<DictKeyAdapterTonHash, DictValAdapterTLB<SimpleLib>> {
++        TLBHashMapE::new(256)
++    }
++
++    fn read(&self, parser: &mut CellParser) -> Result<HashMap<TonHash, SimpleLib>, TonCoreError> {
++        Self::dict().read(parser)
++    }
++
++    fn write(
++        &self,
++        builder: &mut CellBuilder,
++        libs: &HashMap<TonHash, SimpleLib>,
++    ) -> Result<(), TonCoreError> {
++        if libs.len() > STATE_INIT_MAX_WRITTEN_LIBS {
++            bail_ton_core_data!(
++                "StateInit with {} libraries can't be written: limit is {STATE_INIT_MAX_WRITTEN_LIBS}",
++                libs.len()
++            );
++        }
++        Self::dict().write(builder, libs)
++    }
++}
++
