++    fn test_state_init_reads_more_libs_than_it_writes() -> anyhow::Result<()> {
++        // chain data: _ split_depth:(Maybe (## 5)) special:(Maybe TickTock) code:(Maybe ^Cell)
++        // data:(Maybe ^Cell) library:(HashmapE 256 SimpleLib), written without the limit
++        let expected = state_init_with_libs(300)?;
++        let mut builder = TonCell::builder();
++        builder.write_num(&0b0011u8, 4)?;
++        builder.write_ref(TonCell::empty().clone())?;
++        builder.write_ref(TonCell::empty().clone())?;
++        StateInitLibs::dict().write(&mut builder, &expected.library)?;
++        let cell = builder.build()?;
++
++        let parsed = StateInit::from_cell(&cell)?;
++        assert_eq!(parsed, expected);
++        assert!(parsed.to_cell().is_err());
++        Ok(())
++    }
+ }
