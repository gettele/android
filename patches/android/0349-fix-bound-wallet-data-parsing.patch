++        for index in 0..count as u32 {
++            let mut builder = TonCell::builder();
++            builder.write_num(&index, 32)?;
++            let root = builder.build()?;
++            let lib = SimpleLib {
++                public: index % 2 == 0,
++                root: root.clone().into(),
++            };
++            assert!(
++                state_init
++                    .library
++                    .insert(root.hash()?.clone(), lib)
++                    .is_none()
++            );
++        }
++        Ok(state_init)
