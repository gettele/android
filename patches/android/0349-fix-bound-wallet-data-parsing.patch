++
++    #[test]
++    fn test_state_init_written_libs_limit() -> anyhow::Result<()> {
++        let at_limit = state_init_with_libs(STATE_INIT_MAX_WRITTEN_LIBS)?;
++        assert_eq!(StateInit::from_boc(at_limit.to_boc()?)?, at_limit);
++
++        let over_limit = state_init_with_libs(STATE_INIT_MAX_WRITTEN_LIBS + 1)?;
++        let err = over_limit.to_cell().unwrap_err().to_string();
++        assert!(err.contains("17 libraries can't be written"), "{err}");
++        assert!(over_limit.to_boc().is_err());
++        assert!(over_limit.cell_hash().is_err());
++
++        // the message that would carry it is refused as a whole, inline or by reference
++        let mut msg = Msg::new(CommonMsgInfoInt::default(), TonCell::empty().clone());
++        msg.init = Some(TLBEitherRef::new(over_limit.clone()));
++        assert!(msg.to_cell().is_err());
++        msg.init = Some(TLBEitherRef::new_with_layout(
++            over_limit.clone(),
++            EitherRefLayout::ToRef,
++        ));
++        assert!(msg.to_cell().is_err());
++        msg.init = Some(TLBEitherRef::new(at_limit));
++        assert_eq!(Msg::<TonCell>::from_cell(&msg.to_cell()?)?.init, msg.init);
++        Ok(())
++    }
++
