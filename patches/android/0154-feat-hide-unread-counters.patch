diff --git a/TMessagesProj/src/main/java/tele/helpers/TeleCounters.kt b/TMessagesProj/src/main/java/tele/helpers/TeleCounters.kt
new file mode 100644
index 000000000..c1bd471e6
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/TeleCounters.kt
@@ -0,0 +1,149 @@
+package tele.helpers
+
+import android.view.View
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.ChatObject
+import org.telegram.messenger.DialogObject
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.MessagesController
+import org.telegram.messenger.NotificationCenter
+import org.telegram.messenger.NotificationsController
+import org.telegram.messenger.R
+import org.telegram.messenger.UserConfig
+import org.telegram.messenger.Utilities
+import org.telegram.ui.ActionBar.BaseFragment
+import org.telegram.ui.Components.ItemOptions
+import tele.TeleConfig
+import tele.db.TeleDatabaseHelper
+
+// Hides unread counters by surface. Appearance only: read state, sorting and pushes stay stock.
+object TeleCounters {
+
+    private const val KEY_UNCOUNTED = "uncounted_accounts"
+    private const val ARCHIVE_FOLDER = 1
+
+    // user ids, not account slots: the same account keeps its mark when the slots move
+    @Volatile
+    private var uncountedIds: Set<Long>? = null
+
+    private fun on() = TeleConfig.HIDE_COUNTERS.value
+
+    @JvmStatic
+    fun hideFolders(): Boolean = on() && TeleConfig.HIDE_FOLDER_COUNTERS.value
+
+    @JvmStatic
+    fun hideApp(): Boolean = on() && TeleConfig.HIDE_APP_COUNTER.value
+
+    @JvmStatic
+    fun skipArchive(): Boolean = on() && TeleConfig.COUNTER_SKIP_ARCHIVE.value
+
+    @JvmStatic
+    fun appBadge(count: Int): Int = if (hideApp()) 0 else count
+
+    @JvmStatic
+    fun folderCounter(count: Int): Int = if (hideFolders()) 0 else count
+
+    private fun ids(): Set<Long> {
+        uncountedIds?.let { return it }
+        val loaded = parse(TeleDatabaseHelper.get(KEY_UNCOUNTED))
+        uncountedIds = loaded
+        return loaded
+    }
+
+    private fun parse(raw: String?): Set<Long> =
+        raw?.split(',')?.mapNotNull { it.trim().toLongOrNull() }?.filter { it != 0L }?.toSet() ?: emptySet()
+
+    @JvmStatic
+    fun preload() {
+        Utilities.globalQueue.postRunnable {
+            uncountedIds = parse(TeleDatabaseHelper.get(KEY_UNCOUNTED))
+            if (on()) refresh()
+        }
+    }
+
+    private fun userId(account: Int): Long = UserConfig.getInstance(account).getClientUserId()
+
+    // an account left out of the app count and of the account list counters
+    @JvmStatic
+    fun uncounted(account: Int): Boolean {
+        if (!on()) return false
+        val set = ids()
+        return set.isNotEmpty() && set.contains(userId(account))
+    }
+
+    @JvmStatic
+    fun accountCounter(account: Int, count: Int): Int = if (uncounted(account)) 0 else count
+
+    private fun setUncounted(account: Int, value: Boolean) {
+        val id = userId(account)
+        if (id == 0L) return
+        val next = HashSet(ids())
+        if (value) next.add(id) else next.remove(id)
+        uncountedIds = next
+        val raw = if (next.isEmpty()) null else next.joinToString(",")
+        Utilities.globalQueue.postRunnable { TeleDatabaseHelper.put(KEY_UNCOUNTED, raw) }
+        refresh()
+    }
+
+    // what the archive adds to the account badge, mirrors the stock branches of the total
+    @JvmStatic
+    fun archivedShare(account: Int, controller: NotificationsController): Int {
+        if (!skipArchive()) return 0
+        val messages = MessagesController.getInstance(account)
+        var share = 0
+        if (controller.showBadgeMuted) {
+            val dialogs = ArrayList(messages.getAllDialogs())
+            for (dialog in dialogs) {
+                if (dialog == null || dialog.folder_id != ARCHIVE_FOLDER) continue
+                if (DialogObject.isChatDialog(dialog.id)) {
+                    val chat = messages.getChat(-dialog.id)
+                    if (ChatObject.isNotInChat(chat) || ChatObject.isCommunity(chat)) continue
+                }
+                val unread = messages.getDialogUnreadCount(dialog)
+                share += if (controller.showBadgeMessages) unread else if (unread != 0) 1 else 0
+            }
+        } else {
+            val pushes = controller.tele_pushDialogs()
+            for (i in 0 until pushes.size()) {
+                val id = pushes.keyAt(i)
+                if (messages.dialogs_dict.get(id)?.folder_id != ARCHIVE_FOLDER) continue
+                share += when {
+                    !controller.showBadgeMessages -> 1
+                    messages.isCommunity(id) -> 0
+                    messages.isForum(id) -> 1
+                    else -> pushes.valueAt(i) ?: 0
+                }
+            }
+        }
+        return share
+    }
+
+    @JvmStatic
+    fun onToggled() = refresh()
+
+    // every surface re-reads its count: tabs, main tab, account list and the launcher badge
+    private fun refresh() {
+        AndroidUtilities.runOnUIThread {
+            for (account in 0 until UserConfig.MAX_ACCOUNT_COUNT) {
+                if (!UserConfig.getInstance(account).isClientActivated) continue
+                val center = NotificationCenter.getInstance(account)
+                center.postNotificationName(NotificationCenter.dialogsNeedReload)
+                center.postNotificationName(NotificationCenter.updateInterfaces, MessagesController.UPDATE_MASK_ALL)
+            }
+            NotificationsController.getInstance(UserConfig.selectedAccount).updateBadge()
+        }
+    }
+
+    // the account list long press: leave the account out of the counters
+    @JvmStatic
+    fun onAccountLongClick(fragment: BaseFragment, view: View, account: Int): Boolean {
+        if (!on() || userId(account) == 0L) return false
+        val counted = !uncounted(account)
+        ItemOptions.makeOptions(fragment, view)
+            .addChecked(!counted, LocaleController.getString(R.string.TeleUncountAccount)) {
+                setUncounted(account, counted)
+            }
+            .show()
+        return true
+    }
+}
