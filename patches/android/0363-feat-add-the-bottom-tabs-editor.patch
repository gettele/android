+import android.view.View
+import android.view.ViewGroup
+import android.widget.FrameLayout
+import android.widget.ImageView
+import android.widget.LinearLayout
+import android.widget.ScrollView
+import android.widget.TextView
+import androidx.recyclerview.widget.ItemTouchHelper
+import androidx.recyclerview.widget.LinearLayoutManager
+import androidx.recyclerview.widget.RecyclerView
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.DialogObject
+import org.telegram.messenger.FileLog
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.MessagesController
+import org.telegram.messenger.R
+import org.telegram.messenger.UserConfig
+import org.telegram.messenger.UserObject
+import org.telegram.tgnet.TLObject
+import org.telegram.ui.ActionBar.ActionBar
+import org.telegram.ui.ActionBar.AlertDialog
+import org.telegram.ui.ActionBar.BaseFragment
+import org.telegram.ui.ActionBar.BottomSheet
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Cells.HeaderCell
+import org.telegram.ui.Cells.TextCell
+import org.telegram.ui.Cells.TextInfoPrivacyCell
+import org.telegram.ui.Cells.TextSettingsCell
+import org.telegram.ui.DialogsActivity
+import org.telegram.ui.Components.AvatarDrawable
+import org.telegram.ui.Components.BackupImageView
+import org.telegram.ui.Components.BulletinFactory
+import org.telegram.ui.Components.ItemOptions
+import org.telegram.ui.Components.LayoutHelper
+import org.telegram.ui.Components.RLottieImageView
+import org.telegram.ui.Components.RecyclerListView
+import org.telegram.ui.Components.glass.GlassTabView
+import tele.TeleConfig
+import tele.TeleHooks
+import tele.helpers.MainTabsConfig
+import tele.helpers.TeleLowercase
+
+/** The editor of the bottom bar: the order of the tabs, the shortcuts, the icons and the labels. */
+class TeleTabsActivity : BaseFragment() {
+
+    private var listView: RecyclerListView? = null
+    private var adapter: Adapter? = null
+    private var touchHelper: ItemTouchHelper? = null
+    private val account = UserConfig.selectedAccount
+    private var slots = mutableListOf<MainTabsConfig.Slot>()
+    private var suppressNextEntryClick = false
+
+    override fun getListViewForSimpleGlass(): RecyclerListView? = listView
+
+    override fun isSupportEdgeToEdge(): Boolean = true
+
+    override fun onResume() {
+        super.onResume()
+        if (!TeleConfig.CUSTOM_MAIN_TABS.value) {
+            finishFragment()
+            return
+        }
+        reload()
+        adapter?.notifyDataSetChanged()
+    }
+
+    override fun createView(context: Context): View {
+        actionBar.setBackButtonImage(R.drawable.ic_ab_back)
+        actionBar.setAllowOverlayTitle(true)
+        actionBar.setTitle(lc("Edit tabs"))
+        actionBar.setActionBarMenuOnItemClick(object : ActionBar.ActionBarMenuOnItemClick() {
+            override fun onItemClick(id: Int) {
+                when (id) {
+                    -1 -> finishFragment()
+                    ID_RESET -> resetToDefault()
+                }
+            }
+        })
+        val more = actionBar.createMenu().addItem(ID_MORE, R.drawable.ic_ab_other)
+        more.addSubItem(ID_RESET, 0, lc("Reset to default"))
+
+        reload()
+
+        val frameLayout = FrameLayout(context)
+        frameLayout.setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundGray, resourceProvider))
+        fragmentView = frameLayout
+
+        val list = RecyclerListView(context)
+        list.setLayoutManager(LinearLayoutManager(context))
+        list.setVerticalScrollBarEnabled(false)
+        list.setClipToPadding(false)
+        listView = list
+        adapter = Adapter(context)
+        list.setAdapter(adapter)
+
+        touchHelper = ItemTouchHelper(object : ItemTouchHelper.Callback() {
+            override fun getMovementFlags(recyclerView: RecyclerView, viewHolder: RecyclerView.ViewHolder): Int {
+                val position = viewHolder.adapterPosition
+                if (position < 1 || position > slots.size || position == 1) {
+                    return 0
+                }
+                return makeMovementFlags(ItemTouchHelper.UP or ItemTouchHelper.DOWN, 0)
+            }
+
+            override fun onMove(recyclerView: RecyclerView, viewHolder: RecyclerView.ViewHolder, target: RecyclerView.ViewHolder): Boolean {
+                val from = viewHolder.adapterPosition - 1
+                val to = target.adapterPosition - 1
+                if (from < 1 || to < 1 || from >= slots.size || to >= slots.size) {
+                    return false
+                }
+                val slot = slots.removeAt(from)
+                slots.add(to, slot)
+                adapter?.notifyItemMoved(from + 1, to + 1)
+                return true
+            }
+
+            override fun onSwiped(viewHolder: RecyclerView.ViewHolder, direction: Int) {
+            }
+
+            override fun clearView(recyclerView: RecyclerView, viewHolder: RecyclerView.ViewHolder) {
+                super.clearView(recyclerView, viewHolder)
+                save()
+                listView?.postDelayed({ suppressNextEntryClick = false }, 300)
+            }
+        })
+        touchHelper?.attachToRecyclerView(list)
+
+        list.setOnItemClickListener { view, position ->
+            if (suppressNextEntryClick) {
+                suppressNextEntryClick = false
+                return@setOnItemClickListener
+            }
+            if (position in 1..slots.size) {
+                showSlotMenu(view, position - 1)
+            } else if (position == slots.size + 1) {
+                showAddMenu(view)
+            } else if (position == slots.size + 2) {
+                showLabelsDialog()
+            }
+        }
+
+        frameLayout.addView(list, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.MATCH_PARENT.toFloat()))
+        return fragmentView ?: frameLayout
+    }
+
+    private fun reload() {
+        slots = MainTabsConfig.slots(account).toMutableList()
+    }
+
+    /** Every change goes into the config at once; the bar rebuilds itself from the version bump. */
+    private fun save() {
+        MainTabsConfig.save(slots)
+    }
+
+    // the actions of a slot
+
+    private fun showSlotMenu(anchor: View, index: Int) {
+        val slot = slots.getOrNull(index) ?: return
+        val options = ItemOptions.makeOptions(this, anchor)
+        if (slot.isPage && slot.kind != MainTabsConfig.KIND_PROFILE) {
+            options.add(R.drawable.msg_edit, lc("Change icon")) { showIconSheet(slot) }
+        }
+        if (slot.kind != MainTabsConfig.KIND_CHATS) {
+            options.add(R.drawable.msg_delete, lc("Remove"), true) {
+                slots.removeAt(index)
+                save()
+                adapter?.notifyDataSetChanged()
+            }
+        }
+        options.setBlur(true)
+        options.translate(0f, -AndroidUtilities.dp(4f).toFloat())
+        options.setGravity(Gravity.LEFT)
+        val bg = Theme.createRoundRectDrawable(AndroidUtilities.dp(28f), Theme.getColor(Theme.key_windowBackgroundWhite, resourceProvider))
+        bg.paint.setShadowLayer(AndroidUtilities.dp(6f).toFloat(), 0f, AndroidUtilities.dp(1f).toFloat(), Theme.multAlpha(0xFF000000.toInt(), 0.15f))
+        options.setScrimViewBackground(bg)
+        options.show()
+    }
+
+    private fun showAddMenu(anchor: View) {
+        if (slots.size >= MainTabsConfig.MAX_SLOTS) {
+            bulletin(lc("The bar holds six tabs."))
+            return
+        }
+        val options = ItemOptions.makeOptions(this, anchor)
+        if (slots.none { it.kind == MainTabsConfig.KIND_SAVED }) {
+            options.add(R.drawable.msg_saved, lc("Saved messages")) { addSlot(MainTabsConfig.Slot(MainTabsConfig.KIND_SAVED)) }
+        }
+        if (slots.none { it.kind == MainTabsConfig.KIND_CONTACTS }) {
+            options.add(R.drawable.msg_contacts, lc("Contacts")) { addSlot(MainTabsConfig.Slot(MainTabsConfig.KIND_CONTACTS)) }
+        }
+        if (slots.none { it.kind == MainTabsConfig.KIND_CALLS }) {
+            options.add(R.drawable.msg_calls, lc("Calls")) { addSlot(MainTabsConfig.Slot(MainTabsConfig.KIND_CALLS)) }
+        }
+        if (slots.none { it.kind == MainTabsConfig.KIND_SETTINGS }) {
+            options.add(R.drawable.msg_settings, lc("Settings")) { addSlot(MainTabsConfig.Slot(MainTabsConfig.KIND_SETTINGS)) }
+        }
+        if (slots.none { it.kind == MainTabsConfig.KIND_PROFILE }) {
+            options.add(R.drawable.msg_openprofile, lc("Profile")) { addSlot(MainTabsConfig.Slot(MainTabsConfig.KIND_PROFILE)) }
+        }
+        options.addGapIf(options.getItemsCount() > 0)
+        options.add(R.drawable.msg_add, lc("Chat…")) { pickChat() }
+        options.setBlur(true)
+        options.translate(0f, -AndroidUtilities.dp(4f).toFloat())
+        val bg = Theme.createRoundRectDrawable(AndroidUtilities.dp(28f), Theme.getColor(Theme.key_windowBackgroundWhite, resourceProvider))
+        bg.paint.setShadowLayer(AndroidUtilities.dp(6f).toFloat(), 0f, AndroidUtilities.dp(1f).toFloat(), Theme.multAlpha(0xFF000000.toInt(), 0.15f))
+        options.setScrimViewBackground(bg)
+        options.show()
+    }
+
+    private fun addSlot(slot: MainTabsConfig.Slot) {
+        if (slots.size >= MainTabsConfig.MAX_SLOTS) {
+            bulletin(lc("The bar holds six tabs."))
+            return
+        }
+        if (slots.any { it.key == slot.key }) {
+            return
+        }
+        slots.add(slot)
+        save()
+        adapter?.notifyDataSetChanged()
+        listView?.layoutManager?.scrollToPosition(slots.size + 1)
+    }
+
+    private fun addChat(dialogId: Long) {
+        if (dialogId == 0L) {
+            return
+        }
+        val slot = MainTabsConfig.Slot(MainTabsConfig.chatKey(dialogId))
+        if (slots.any { it.key == slot.key }) {
+            bulletin(lc("This chat is already on the bar."))
+            return
+        }
+        addSlot(slot)
+    }
+
+    /** The stock choose-a-chat screen, as the draft picker opens it. */
+    private fun pickChat() {
+        if (slots.size >= MainTabsConfig.MAX_SLOTS) {
+            bulletin(lc("The bar holds six tabs."))
+            return
+        }
+        val args = Bundle()
+        args.putBoolean("onlySelect", true)
+        val picker = DialogsActivity(args)
+        picker.setDelegate { fragment, dids, _, _, _, _, _, topicsFragment ->
+            val dialogId = dids.firstOrNull()?.dialogId ?: return@setDelegate false
+            fragment.finishFragment()
+            topicsFragment?.removeSelfFromStack()
+            // the picker is still leaving the stack, the editor gets the result on top
+            AndroidUtilities.runOnUIThread({ addChat(dialogId) }, 250)
+            true
+        }
+        presentFragment(picker)
+    }
+
+    private fun setIcon(slot: MainTabsConfig.Slot, name: String) {
+        val index = slots.indexOfFirst { it.key == slot.key }
+        if (index < 0) {
+            return
+        }
+        slots[index] = MainTabsConfig.Slot(slot.kind, name)
+        save()
+        adapter?.notifyDataSetChanged()
+    }
+
+    private fun showIconSheet(slot: MainTabsConfig.Slot) {
+        val context = parentActivity ?: return
+        IconSheet(context, resourceProvider, MainTabsConfig.iconNameOf(slot)) { name ->
+            setIcon(slot, name)
+        }.show()
+    }
+
+    private fun showLabelsDialog() {
+        val labels = arrayOf(lc("All"), lc("Selected"), lc("Icons only"))
+        val builder = AlertDialog.Builder(parentActivity, resourceProvider)
+        builder.setTitle(lc("Labels"))
+        builder.setItems(labels) { _, which ->
+            val value = when (which) {
+                1 -> "selected"
+                2 -> "icons"
+                else -> "all"
+            }
+            TeleConfig.set(TeleConfig.MAIN_TABS_LABELS, value)
+            TeleHooks.onConfigChanged(TeleConfig.MAIN_TABS_LABELS)
+            adapter?.notifyDataSetChanged()
+        }
+        builder.setNegativeButton(LocaleController.getString(R.string.Cancel), null)
+        showDialog(builder.create())
+    }
+
+    private fun resetToDefault() {
+        MainTabsConfig.reset(account)
+        reload()
+        adapter?.notifyDataSetChanged()
+        BulletinFactory.of(this).createSimpleBulletin(R.raw.info, lc("The default tabs are back.")).show()
+    }
+
+    private fun bulletin(text: String) {
+        BulletinFactory.of(this).createSimpleBulletin(R.raw.error, text).show()
+    }
+
+    // the look of the slots
+
+    private fun titleOf(slot: MainTabsConfig.Slot): CharSequence = when (slot.kind) {
+        MainTabsConfig.KIND_CHATS -> LocaleController.getString(R.string.MainTabsChats)
+        MainTabsConfig.KIND_CONTACTS -> LocaleController.getString(R.string.MainTabsContacts)
+        MainTabsConfig.KIND_CALLS -> LocaleController.getString(R.string.MainTabsCalls)
+        MainTabsConfig.KIND_SETTINGS -> LocaleController.getString(R.string.Settings)
+        MainTabsConfig.KIND_PROFILE -> LocaleController.getString(R.string.MainTabsProfile)
+        MainTabsConfig.KIND_SAVED -> LocaleController.getString(R.string.SavedMessages)
+        else -> chatTitle(slot.dialogId)
+    }
+
+    private fun chatTitle(dialogId: Long): CharSequence {
+        if (dialogId == UserConfig.getInstance(account).clientUserId) {
+            return LocaleController.getString(R.string.SavedMessages)
+        }
+        if (DialogObject.isEncryptedDialog(dialogId)) {
+            val encryptedChat = MessagesController.getInstance(account).getEncryptedChat(DialogObject.getEncryptedChatId(dialogId))
+            if (encryptedChat != null) {
+                val user = MessagesController.getInstance(account).getUser(encryptedChat.user_id)
+                if (user != null) {
+                    return UserObject.getUserName(user)
+                }
+            }
+            return ""
+        }
+        return DialogObject.getName(account, dialogId)
+    }
+
+    private fun subtitleOf(slot: MainTabsConfig.Slot): CharSequence {
+        if (slot.isShortcut) {
+            return lc("Chat button")
+        }
+        val animation = animationByName(slot.iconName)
+        if (animation != null) {
+            return iconLabel(animation)
+        }
+        return lc("Page")
+    }
+
+    private fun pageAnimationOf(slot: MainTabsConfig.Slot): GlassTabView.TabAnimation? {
+        if (!slot.isPage || slot.kind == MainTabsConfig.KIND_PROFILE) {
+            return null
+        }
+        return animationByName(MainTabsConfig.iconNameOf(slot))
+    }
+
+    private fun animationByName(name: String): GlassTabView.TabAnimation? {
+        if (name.isEmpty()) {
+            return null
+        }
+        return try {
+            GlassTabView.TabAnimation.valueOf(name)
+        } catch (e: IllegalArgumentException) {
+            FileLog.e(e)
+            null
+        }
+    }
+
+    private fun iconLabel(animation: GlassTabView.TabAnimation): String {
+        val pretty = animation.name.lowercase().replace('_', ' ').replaceFirstChar { it.uppercase() }
+        return lc(pretty)
+    }
+
+    /** The filled frame of a tab animation, the way a selected tab shows it. */
+    private fun bindAnimationPreview(view: RLottieImageView, animation: GlassTabView.TabAnimation, selected: Boolean) {
+        val color = Theme.getColor(if (selected) Theme.key_glass_tabSelected else Theme.key_glass_tabUnselected, resourceProvider)
+        view.setColorFilter(PorterDuffColorFilter(color, PorterDuff.Mode.SRC_IN))
+        if (animation.iconStatic != -1) {
+            view.setImageResource(animation.iconStatic)
+            return
+        }
+        view.setAnimation(animation.iconToFilled, 24, 24)
+        val drawable = view.animatedDrawable ?: return
+        if (animation.endFrameMid != -1) {
+            drawable.setCurrentFrame(animation.endFrameMid, false)
+        } else {
+            drawable.setProgress(0.99f)
+        }
+    }
+
+    private fun setAvatar(image: BackupImageView, dialogId: Long) {
+        val drawable = AvatarDrawable()
+        if (dialogId == UserConfig.getInstance(account).clientUserId) {
+            drawable.setAvatarType(AvatarDrawable.AVATAR_TYPE_SAVED)
+            image.setImage(null, null, drawable, null)
+            return
+        }
+        var tlObject: TLObject? = null
+        if (DialogObject.isEncryptedDialog(dialogId)) {
+            val encryptedChat = MessagesController.getInstance(account).getEncryptedChat(DialogObject.getEncryptedChatId(dialogId))
+            if (encryptedChat != null) {
+                tlObject = MessagesController.getInstance(account).getUser(encryptedChat.user_id)
+            }
+        } else {
+            tlObject = MessagesController.getInstance(account).getUserOrChat(dialogId)
+        }
+        if (tlObject == null) {
+            drawable.setInfo(dialogId, "", "", null)
+            image.setImage(null, null, drawable, null)
+            return
+        }
+        drawable.setInfo(account, tlObject)
+        image.setForUserOrChat(tlObject, drawable)
+    }
+
+    private fun dialogIdOf(slot: MainTabsConfig.Slot): Long =
+        if (slot.kind == MainTabsConfig.KIND_SAVED) UserConfig.getInstance(account).clientUserId else slot.dialogId
+
+    private fun labelsValue(): String = when (MainTabsConfig.labelsMode()) {
+        MainTabsConfig.LABELS_SELECTED -> lc("Selected")
+        MainTabsConfig.LABELS_ICONS -> lc("Icons only")
+        else -> lc("All")
+    }
+
+    private inner class SlotCell(context: Context) : FrameLayout(context) {
+
+        val handle: ImageView
+        val icon = RLottieImageView(context)
+        val avatar = BackupImageView(context)
+        val title = TextView(context)
+        val subtitle = TextView(context)
+
+        init {
+            background = Theme.createSelectorDrawable(Theme.getColor(Theme.key_listSelector, resourceProvider), Theme.RIPPLE_MASK_ALL)
+
+            handle = ImageView(context)
+            handle.scaleType = ImageView.ScaleType.CENTER
+            handle.setImageResource(R.drawable.list_reorder)
+            handle.setColorFilter(PorterDuffColorFilter(Theme.getColor(Theme.key_stickers_menu, resourceProvider), PorterDuff.Mode.MULTIPLY))
+            handle.setOnTouchListener { _, event ->
+                when (event.actionMasked) {
+                    MotionEvent.ACTION_DOWN -> {
+                        suppressNextEntryClick = true
+                        listView?.findContainingViewHolder(this)?.let { touchHelper?.startDrag(it) }
+                        true
+                    }
+                    MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> {
+                        listView?.postDelayed({ suppressNextEntryClick = false }, 250)
+                        true
+                    }
+                    else -> false
+                }
+            }
+            addView(handle, FrameLayout.LayoutParams(AndroidUtilities.dp(48f), LayoutHelper.MATCH_PARENT, Gravity.LEFT or Gravity.CENTER_VERTICAL))
+
+            icon.scaleType = ImageView.ScaleType.FIT_CENTER
+            avatar.setRoundRadius(AndroidUtilities.dp(14f))
+            val preview = FrameLayout(context)
+            preview.addView(icon, FrameLayout.LayoutParams(AndroidUtilities.dp(28f), AndroidUtilities.dp(28f), Gravity.CENTER))
+            preview.addView(avatar, FrameLayout.LayoutParams(AndroidUtilities.dp(28f), AndroidUtilities.dp(28f), Gravity.CENTER))
+
+            title.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16f)
+            title.setSingleLine(true)
+            title.ellipsize = android.text.TextUtils.TruncateAt.END
+            subtitle.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13f)
+            subtitle.setSingleLine(true)
+            subtitle.ellipsize = android.text.TextUtils.TruncateAt.END
+
+            val texts = LinearLayout(context)
+            texts.orientation = LinearLayout.VERTICAL
+            texts.gravity = Gravity.CENTER_VERTICAL
+            texts.addView(title, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT))
+            texts.addView(subtitle, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT))
+
+            val body = LinearLayout(context)
+            body.orientation = LinearLayout.HORIZONTAL
+            body.gravity = Gravity.CENTER_VERTICAL
+            body.addView(preview, LinearLayout.LayoutParams(AndroidUtilities.dp(44f), AndroidUtilities.dp(44f)))
+            body.addView(texts, LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f))
+            addView(body, FrameLayout.LayoutParams(LayoutHelper.MATCH_PARENT, LayoutHelper.MATCH_PARENT, Gravity.CENTER_VERTICAL).apply {
+                leftMargin = AndroidUtilities.dp(44f)
+                rightMargin = AndroidUtilities.dp(16f)
+            })
+
+            layoutParams = RecyclerView.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, AndroidUtilities.dp(56f))
+        }
+
+        fun bind(slot: MainTabsConfig.Slot) {
+            title.text = titleOf(slot)
+            title.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText, resourceProvider))
+            subtitle.text = subtitleOf(slot)
+            subtitle.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2, resourceProvider))
+            val animation = pageAnimationOf(slot)
+            if (animation != null) {
+                avatar.visibility = GONE
+                icon.visibility = VISIBLE
+                bindAnimationPreview(icon, animation, false)
+            } else {
+                icon.visibility = GONE
+                avatar.visibility = VISIBLE
+                setAvatar(avatar, dialogIdOf(slot))
+            }
+        }
+    }
+
+    private inner class Adapter(private val context: Context) : RecyclerListView.SelectionAdapter() {
+
+        override fun getItemCount(): Int = slots.size + 4
+
+        override fun isEnabled(holder: RecyclerView.ViewHolder): Boolean =
+            holder.adapterPosition in 1..slots.size + 2
+
+        override fun onCreateViewHolder(parent: ViewGroup, viewType: Int): RecyclerView.ViewHolder {
+            val view: View = when (viewType) {
+                TYPE_HEADER -> HeaderCell(context)
+                TYPE_ADD -> TextCell(context)
+                TYPE_LABELS -> TextSettingsCell(context)
+                TYPE_SHADOW -> TextInfoPrivacyCell(context)
+                else -> SlotCell(context)
+            }
+            if (view.layoutParams == null) {
+                view.layoutParams = RecyclerView.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT)
+            }
+            return RecyclerListView.Holder(view)
+        }
+
+        override fun onBindViewHolder(holder: RecyclerView.ViewHolder, position: Int) {
+            when (holder.itemViewType) {
+                TYPE_HEADER -> (holder.itemView as HeaderCell).setText(lc("Tabs"))
+                TYPE_ADD -> (holder.itemView as TextCell).setTextAndIcon(lc("Add tab"), R.drawable.msg_add, false)
+                TYPE_LABELS -> (holder.itemView as TextSettingsCell).setTextAndValue(lc("Labels"), labelsValue(), true)
+                TYPE_SHADOW -> (holder.itemView as TextInfoPrivacyCell).setText(
+                    lc("Tap a tab to change its icon or remove it; drag the handle to reorder.")
+                )
+                else -> (holder.itemView as SlotCell).bind(slots[position - 1])
+            }
+        }
+
+        override fun getItemViewType(position: Int): Int = when (position) {
+            0 -> TYPE_HEADER
+            slots.size + 1 -> TYPE_ADD
+            slots.size + 2 -> TYPE_LABELS
+            slots.size + 3 -> TYPE_SHADOW
+            else -> TYPE_SLOT
+        }
+    }
+
+    /** The stock tab animations as a grid of filled previews. */
+    private inner class IconSheet(
+        context: Context,
+        private val provider: Theme.ResourcesProvider?,
+        current: String,
+        private val onPick: (String) -> Unit
+    ) : BottomSheet(context, true, provider) {
+
+        init {
+            fixNavigationBar()
+            setCanDismissWithSwipe(false)
+            val root = LinearLayout(context)
+            root.orientation = LinearLayout.VERTICAL
+
+            val handle = View(context)
+            handle.background = Theme.createRoundRectDrawable(
+                AndroidUtilities.dp(2f),
+                Theme.multAlpha(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText4, provider), 0.6f)
+            )
+            root.addView(handle, LayoutHelper.createLinear(36, 4, Gravity.CENTER_HORIZONTAL, 0, 8, 0, 0))
+
+            val titleView = TextView(context)
+            titleView.text = lc("Tab icon")
+            titleView.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 20f)
+            titleView.typeface = AndroidUtilities.bold()
+            titleView.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText, provider))
+            root.addView(titleView, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT, Gravity.START, 20, 10, 20, 6))
+
+            val grid = LinearLayout(context)
+            grid.orientation = LinearLayout.VERTICAL
+            val animations = GlassTabView.TabAnimation.values()
+            val columns = 4
+            var row: LinearLayout? = null
+            val selectedBackground = Theme.createRoundRectDrawable(
+                AndroidUtilities.dp(10f),
+                Theme.multAlpha(Theme.getColor(Theme.key_glass_tabSelected, provider), 0.13f)
+            )
+            for (animation in animations) {
+                if (row == null || row.childCount == columns) {
+                    row = LinearLayout(context)
+                    row.orientation = LinearLayout.HORIZONTAL
+                    grid.addView(row, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT))
+                }
+                val picked = animation.name == current
+                val cell = LinearLayout(context)
+                cell.orientation = LinearLayout.VERTICAL
+                cell.gravity = Gravity.CENTER
+                cell.setPadding(AndroidUtilities.dp(4f), AndroidUtilities.dp(8f), AndroidUtilities.dp(4f), AndroidUtilities.dp(8f))
+                if (picked) {
+                    cell.background = selectedBackground
+                }
+                val preview = RLottieImageView(context)
+                bindAnimationPreview(preview, animation, picked)
+                cell.addView(preview, LinearLayout.LayoutParams(AndroidUtilities.dp(30f), AndroidUtilities.dp(30f)))
+                val name = TextView(context)
+                name.text = iconLabel(animation)
+                name.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 11f)
+                name.setGravity(Gravity.CENTER)
+                name.setSingleLine(true)
+                name.setTextColor(Theme.getColor(
+                    if (picked) Theme.key_glass_tabSelectedText else Theme.key_windowBackgroundWhiteGrayText2, provider
+                ))
+                cell.addView(name, LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT))
+                cell.setOnClickListener {
+                    dismiss()
+                    onPick(animation.name)
+                }
+                row?.addView(cell, LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f))
+            }
+
+            root.addView(grid, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT))
+            val maxHeight = (AndroidUtilities.displaySize.y * 0.72f).toInt()
+            setCustomView(BoundedScrollView(context, maxHeight).also { scroll ->
+                scroll.addView(root, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT))
+            })
+        }
+
+    }
+
+    /** A scroll view that never grows past the height of the screen, so its content scrolls. */
+    private class BoundedScrollView(context: Context, private val maxHeight: Int) : ScrollView(context) {
+        override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
+            super.onMeasure(widthMeasureSpec, MeasureSpec.makeMeasureSpec(maxHeight, MeasureSpec.AT_MOST))
+        }
+    }
+
+    private fun lc(text: String): String = TeleLowercase.lc(text)
+
+    companion object {
+        private const val TYPE_HEADER = 0
+        private const val TYPE_SLOT = 1
+        private const val TYPE_ADD = 2
+        private const val TYPE_LABELS = 3
+        private const val TYPE_SHADOW = 4
+
+        private const val ID_MORE = 7301
+        private const val ID_RESET = 7302
+    }
+}
