+    private int teleLabelsMode;
+
+    /** tele: the labels of the custom bar - 0 every tab, 1 the selected tab only, 2 no tab. */
+    public void tele_setLabelsMode(int mode) {
+        if (teleLabelsMode == mode) {
+            return;
+        }
+        teleLabelsMode = mode;
+        teleApplyLabels();
+        requestLayout();
+    }
+
+    /** tele: the label of the selected-only mode follows the selection. */
+    public void tele_onSelectionChangedForLabels() {
+        if (teleLabelsMode != 1) {
+            return;
+        }
+        teleApplyLabels();
+    }
+
+    private boolean teleLabelShown() {
+        return teleLabelsMode == 0 || (teleLabelsMode == 1 && isTabSelected());
+    }
+
+    private void teleApplyLabels() {
+        final boolean shown = teleLabelShown();
+        textView.setVisibility(shown ? VISIBLE : INVISIBLE);
+        final float offset = shown ? 0 : dp(4);
+        imageView.setTranslationY(offset);
+        if (backupImageView != null) {
+            backupImageView.setTranslationY(offset);
+        }
+    }
+
     @Override
     public void setTextSizeDp(float textSizeDp) {
         final float px = dp(textSizeDp);
