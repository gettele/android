+            return R.string.MainTabsContacts;
+        } else if (tele.helpers.MainTabsConfig.KIND_CALLS.equals(kind)) {
+            return R.string.MainTabsCalls;
+        } else if (tele.helpers.MainTabsConfig.KIND_SETTINGS.equals(kind)) {
+            return R.string.Settings;
+        }
+        return R.string.MainTabsChats;
+    }
