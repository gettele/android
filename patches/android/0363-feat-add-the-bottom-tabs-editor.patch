+    private GlassTabView.TabAnimation teleAnimationOf(tele.helpers.MainTabsConfig.Slot slot) {
+        final String name = tele.helpers.MainTabsConfig.iconNameOf(slot);
+        if (name.isEmpty()) {
+            return GlassTabView.TabAnimation.CHATS;
+        }
+        try {
+            return GlassTabView.TabAnimation.valueOf(name);
+        } catch (IllegalArgumentException e) {
+            FileLog.e(e);
+            return GlassTabView.TabAnimation.CHATS;
+        }
+    }
+
+    private int teleTitleRes(String kind) {
