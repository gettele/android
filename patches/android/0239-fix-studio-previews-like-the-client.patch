index d4bb80ede..78c875ee1 100644
--- a/TMessagesProj/src/main/java/tele/helpers/GiftStudioCatalog.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/GiftStudioCatalog.kt
@@ -52,6 +52,27 @@ object GiftStudioCatalog {
         }
     }
 
+    /** The ids of the gifts of the catalog: the gift id to its name. */
+    @JvmStatic
+    fun requestIds(done: (Map<Long, String>) -> Unit) {
+        fetch("ids") { bytes ->
+            val result = LinkedHashMap<Long, String>()
+            try {
+                val json = org.json.JSONObject(String(bytes, Charsets.UTF_8))
+                val keys = json.keys()
+                while (keys.hasNext()) {
+                    val key = keys.next()
+                    val id = key.toLongOrNull()
+                    val name = json.optString(key)
+                    if (id != null && id != 0L && name.isNotEmpty()) result[id] = name
+                }
+            } catch (throwable: Throwable) {
+                FileLog.e(throwable)
+            }
+            done(result)
+        }
+    }
+
     /** The parts of one gift of the catalog, by the name of the gift. */
     @JvmStatic
     fun requestParts(gift: String, done: (CatalogParts) -> Unit) {
