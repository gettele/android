+        private val ring = Paint(Paint.ANTI_ALIAS_FLAG).also {
+            it.style = Paint.Style.STROKE
+            it.strokeWidth = AndroidUtilities.dp(2f).toFloat()
+            it.shader = LinearGradient(
+                0f, 0f, size.toFloat(), size.toFloat(),
+                Theme.getColor(Theme.key_stories_circle1),
+                Theme.getColor(Theme.key_stories_circle2),
+                Shader.TileMode.CLAMP
+            )
+        }
+
+        override fun onDraw(canvas: Canvas) {
+            val inset = ring.strokeWidth / 2f
+            canvas.drawCircle(width / 2f, height / 2f, minOf(width, height) / 2f - inset, ring)
+            val padding = (ring.strokeWidth + AndroidUtilities.dp(3f).toFloat()).toInt()
+            avatar.setBounds(padding, padding, width - padding, height - padding)
+            avatar.draw(canvas)
+        }
     }
 
