+++ b/TMessagesProj/src/main/java/tele/ui/TeleNameBadges.kt
@@ -0,0 +1,75 @@
+package tele.ui
+
+import android.graphics.PorterDuff
+import android.graphics.PorterDuffColorFilter
+import android.graphics.drawable.Drawable
+import android.text.SpannableStringBuilder
+import android.text.Spanned
+import android.view.View
+import android.widget.TextView
+import org.telegram.messenger.ApplicationLoader
+import org.telegram.messenger.R
+import org.telegram.tgnet.TLRPC
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Components.AnimatedEmojiDrawable
+import org.telegram.ui.Components.ColoredImageSpan
+import org.telegram.ui.Components.CombinedDrawable
+import tele.helpers.TeleBadges
+import java.util.WeakHashMap
+
+// tele badges drawn inside a name's text: bubbles (tele 0012) and the settings header
+object TeleNameBadges {
+    private val headerIcons = WeakHashMap<TextView, AnimatedEmojiDrawable.SwapAnimatedEmojiDrawable>()
+
+    private fun verifiedDrawable(): Drawable {
+        val res = ApplicationLoader.applicationContext.resources
+        val area = res.getDrawable(R.drawable.verified_area).mutate()
+        area.colorFilter = PorterDuffColorFilter(Theme.getColor(Theme.key_chats_verifiedBackground), PorterDuff.Mode.SRC_IN)
+        val check = res.getDrawable(R.drawable.verified_check).mutate()
+        check.colorFilter = PorterDuffColorFilter(Theme.getColor(Theme.key_chats_verifiedCheck), PorterDuff.Mode.SRC_IN)
+        return CombinedDrawable(area, check)
+    }
+
+    private fun SpannableStringBuilder.appendDrawable(drawable: Drawable, size: Int = 0): SpannableStringBuilder {
+        val span = ColoredImageSpan(drawable, ColoredImageSpan.ALIGN_CENTER)
+        span.recolorDrawable = false
+        if (size > 0) span.setSize(size)
+        return append("\u2060", span, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
+    }
+
+    @JvmStatic
+    fun withVerified(name: CharSequence): CharSequence =
+        SpannableStringBuilder(name).append(" ").appendDrawable(verifiedDrawable())
+
+    // the own account in settings: server icon before the name, server checkmark after it
+    @JvmStatic
+    fun ownName(view: TextView, account: Int, user: TLRPC.User?, name: CharSequence): CharSequence {
+        if (user == null) return name
+        val iconId = TeleBadges.iconDocumentId(account, user.id)
+        val checkmark = TeleBadges.hasCheckmark(account, user, null)
+        if (iconId == 0L && !checkmark) return name
+        val sb = SpannableStringBuilder()
+        if (iconId != 0L) {
+            val icon = headerIcon(view, account)
+            icon.set(iconId, false)
+            sb.appendDrawable(icon, (view.textSize * 1.15f).toInt()).append(" ")
+        }
+        sb.append(name)
+        if (checkmark) sb.append(" ").appendDrawable(verifiedDrawable())
+        return sb
+    }
+
+    private fun headerIcon(view: TextView, account: Int): AnimatedEmojiDrawable.SwapAnimatedEmojiDrawable {
+        headerIcons[view]?.let { return it }
+        val icon = AnimatedEmojiDrawable.SwapAnimatedEmojiDrawable(view, (view.textSize * 1.15f).toInt(), AnimatedEmojiDrawable.CACHE_TYPE_EMOJI_STATUS)
+        icon.setCurrentAccount(account)
+        icon.setColor(Theme.getColor(Theme.key_profile_verifiedBackground))
+        if (view.isAttachedToWindow) icon.attach()
+        view.addOnAttachStateChangeListener(object : View.OnAttachStateChangeListener {
+            override fun onViewAttachedToWindow(v: View) = icon.attach()
+            override fun onViewDetachedFromWindow(v: View) = icon.detach()
+        })
+        headerIcons[view] = icon
+        return icon
+    }
+}
