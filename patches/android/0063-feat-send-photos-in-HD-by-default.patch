@@ -233,6 +235,11 @@ class TeleSettingsActivity @JvmOverloads constructor(private val mode: String =
                 toggle("copy custom emoji id", TeleConfig.COPY_EMOJI_ID),
                 Row(TYPE_SHADOW)
             )
+            MODE_SENDING -> listOf(
+                Row(TYPE_HEADER, "sending"),
+                toggle("send photos in HD by default", TeleConfig.HD_PHOTOS),
+                Row(TYPE_SHADOW)
+            )
             MODE_MENU -> listOf(
                 Row(TYPE_HEADER, "message menu"),
                 Row(TYPE_LINK, title = "editor", mode = MODE_MENU),
@@ -254,6 +261,7 @@ class TeleSettingsActivity @JvmOverloads constructor(private val mode: String =
                 sectionLink("interface", MODE_INTERFACE, R.drawable.msg2_discussion),
                 sectionLink("privacy", MODE_PRIVACY, R.drawable.msg2_secret),
                 sectionLink("ids", MODE_IDS, R.drawable.msg2_data),
+                sectionLink("sending", MODE_SENDING, R.drawable.msg2_gif),
                 sectionLink("your data", MODE_DATA, R.drawable.msg2_link2),
                 Row(TYPE_SHADOW)
             )
