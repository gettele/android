From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Tue, 6 Oct 2026 19:54:12 +0300
Subject: [PATCH] feat: send photos in HD by default

HD photos become the default when no per-photo quality is picked.

Constraint: Per-photo HD toggle in stock UI keeps working

Confidence: high

Scope-risk: narrow

Not-tested: Manual send with and without toggle
---
 .../main/java/org/telegram/messenger/MediaController.java | 2 +-
 TMessagesProj/src/main/java/tele/TeleConfig.kt            | 2 ++
 .../src/main/java/tele/ui/settings/TeleSearch.kt          | 6 +++++-
 .../main/java/tele/ui/settings/TeleSettingsActivity.kt    | 8 ++++++++
 4 files changed, 16 insertions(+), 2 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/MediaController.java b/TMessagesProj/src/main/java/org/telegram/messenger/MediaController.java
index d8fa0bce3..d24b18f41 100644
--- a/TMessagesProj/src/main/java/org/telegram/messenger/MediaController.java
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/MediaController.java
@@ -515,7 +515,7 @@ public class MediaController implements AudioManager.OnAudioFocusChangeListener,
         public Boolean highQuality;
         public boolean isHighQuality() {
             if (highQuality == null)
-                return SharedConfig.photoHighQualityDefault;
+                return SharedConfig.photoHighQualityDefault || tele.TeleConfig.HD_PHOTOS.getValue();
             return highQuality;
         }
 
diff --git a/TMessagesProj/src/main/java/tele/TeleConfig.kt b/TMessagesProj/src/main/java/tele/TeleConfig.kt
index e1d545a70..12a7592bc 100644
--- a/TMessagesProj/src/main/java/tele/TeleConfig.kt
+++ b/TMessagesProj/src/main/java/tele/TeleConfig.kt
@@ -122,6 +122,8 @@ object TeleConfig {
     val NO_LINK_PREVIEWS = BoolItem("no_link_previews", false)
     @JvmField
     val LINK_PREVIEW_MODE = StringItem("link_preview_mode", "all")
+    @JvmField
+    val HD_PHOTOS = BoolItem("hd_photos", false)
 
     private var prefs: SharedPreferences? = null
 
diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt
index e8766e3b5..bcddb17ee 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt
@@ -11,6 +11,7 @@ object TeleSearch {
     private const val GUID_PRIVACY = 961
     private const val GUID_IDS = 972
     private const val GUID_DATA = 982
+    private const val GUID_SENDING = 992
 
     @JvmStatic
     fun appendAll(fragment: BaseFragment, stock: Array<ProfileActivity.SearchAdapter.SearchResult>): Array<ProfileActivity.SearchAdapter.SearchResult> =
@@ -80,7 +81,10 @@ object TeleSearch {
             section(GUID_DATA + 1, "local names for people", "your data", TeleSettingsActivity.MODE_DATA),
             section(GUID_DATA + 2, "username aliases", "your data", TeleSettingsActivity.MODE_DATA),
             screen(GUID_DATA + 3, "manage local names") { TeleNamesActivity(TeleNamesActivity.MODE_LOCAL) },
-            screen(GUID_DATA + 4, "manage aliases") { TeleNamesActivity(TeleNamesActivity.MODE_ALIAS) }
+            screen(GUID_DATA + 4, "manage aliases") { TeleNamesActivity(TeleNamesActivity.MODE_ALIAS) },
+
+            section(GUID_SENDING, "tele sending", "sending", TeleSettingsActivity.MODE_SENDING),
+            section(GUID_SENDING + 1, "send photos in HD by default", "sending", TeleSettingsActivity.MODE_SENDING)
         )
     }
 }
\ No newline at end of file
diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
