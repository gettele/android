         MODE_PRIVACY -> "tele · privacy"
         MODE_IDS -> "tele · ids"
         MODE_DATA -> "tele · your data"
+        MODE_SENDING -> "tele · sending"
         else -> "tele"
     }
 
@@ -155,6 +156,7 @@ class TeleSettingsActivity @JvmOverloads constructor(private val mode: String =
         const val MODE_DATA = "data"
         const val MODE_MENU = "menu"
