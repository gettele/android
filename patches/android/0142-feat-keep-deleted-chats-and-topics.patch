+            }
+            rowsOf(account).any.add(dialogId)
+        }.onFailure { FileLog.e(it) }
+    }
+
+    // the dialog is in the list again and the user is in the chat
+    private fun isBack(account: Int, dialogId: Long): Boolean = runCatching {
+        val controller = MessagesController.getInstance(account)
+        if (controller.dialogs_dict.get(dialogId) == null) return@runCatching false
+        if (dialogId > 0) return@runCatching true
+        val chat = controller.getChat(-dialogId) ?: return@runCatching false
+        !ChatObject.isNotInChat(chat)
+    }.getOrDefault(false)
+
+    /** The deleted chats of the account that are back in the chat list; main thread. */
+    @JvmStatic
+    fun backDialogs(account: Int): List<Long> = rowsOf(account).chats.filter { isBack(account, it) }
+
+    /** A chat that came back is a live chat again: no longer deleted, its messages are live too. */
+    @JvmStatic
+    fun releaseIfBack(account: Int, dialogId: Long) {
+        if (!rowsOf(account).chats.contains(dialogId) || !isBack(account, dialogId)) return
+        release(account, dialogId)
+    }
+
+    @JvmStatic
+    fun release(account: Int, dialogId: Long) {
+        // a user's chat keeps its messages: they stay deleted whatever happens to the chat
+        val ids = runCatching { TeleDatabaseHelper.removeDeletedChat(account, dialogId, dialogId < 0) }.onFailure { FileLog.e(it) }.getOrDefault(emptyList())
+        DeletedMessages.dropKeptInChat(account, dialogId, ids)
+        snapshots.remove(key(account, dialogId))
+        rowsOf(account).chats.remove(dialogId)
+    }
+
+    /** The user forgets a chat in the overview; its messages are forgotten by the caller. */
+    @JvmStatic
+    fun forgetChat(account: Int, dialogId: Long) {
+        runCatching { TeleDatabaseHelper.forgetDeletedChat(account, dialogId, null) }.onFailure { FileLog.e(it) }
+        snapshots.remove(key(account, dialogId))
+        val cache = rowsOf(account)
+        cache.chats.remove(dialogId)
+        cache.any.remove(dialogId)
+    }
+
+    @JvmStatic
+    fun forgetTopic(account: Int, dialogId: Long, topicId: Long) {
+        runCatching { TeleDatabaseHelper.forgetDeletedChat(account, dialogId, topicId) }.onFailure { FileLog.e(it) }
+    }
+
+    @JvmStatic
+    fun forgetAll(account: Int, dialogId: Long?) {
+        if (dialogId != null) {
+            forgetChat(account, dialogId)
+            return
+        }
+        for (id in rowsOf(account).any.toList()) forgetChat(account, id)
+    }
+
+    /** Rows left without a kept message go; the retention sweep and the overview call it. */
+    @JvmStatic
+    fun prune() {
+        runCatching { TeleDatabaseHelper.pruneDeletedChats() }.onFailure { FileLog.e(it) }
+        rows.clear()
+    }
+
+    class TopicInfo(val topicId: Long, val title: String, val topic: TLRPC.TL_forumTopic?)
+
+    /** A dialog with deleted chat info: [peer] is the chat as it was, [deleted] is set when the chat itself was deleted. */
+    class Info(val peer: TLObject?, val deleted: Boolean, val topics: MutableList<TopicInfo>)
+
+    /** The deleted chats and topics of the account by dialog. */
+    @JvmStatic
+    fun infos(account: Int): Map<Long, Info> {
+        val result = HashMap<Long, Info>()
+        val all = runCatching { TeleDatabaseHelper.getDeletedChats(account) }.onFailure { FileLog.e(it) }.getOrDefault(emptyList())
+        for (row in all) {
+            val info = result.getOrPut(row.dialogId) { Info(null, false, ArrayList()) }
+            if (row.topicId == 0L) {
+                result[row.dialogId] = Info(peerOf(row.dialogId, row.data), true, info.topics)
+            } else {
+                val topic = topicOf(row.data)
+                info.topics.add(TopicInfo(row.topicId, topic?.title ?: "", topic))
+            }
+        }
+        return result
+    }
+}
