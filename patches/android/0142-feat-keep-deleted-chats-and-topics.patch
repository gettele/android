diff --git a/TMessagesProj/src/main/java/tele/helpers/DeletedChats.kt b/TMessagesProj/src/main/java/tele/helpers/DeletedChats.kt
new file mode 100644
index 000000000..bcd27b0a7
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/DeletedChats.kt
@@ -0,0 +1,335 @@
+package tele.helpers
+
+import org.telegram.SQLite.SQLiteDatabase
+import org.telegram.messenger.ChatObject
+import org.telegram.messenger.DialogObject
+import org.telegram.messenger.FileLog
+import org.telegram.messenger.MessageObject
+import org.telegram.messenger.MessagesController
+import org.telegram.messenger.MessagesStorage
+import org.telegram.messenger.UserConfig
+import org.telegram.messenger.UserObject
+import org.telegram.tgnet.SerializedData
+import org.telegram.tgnet.TLObject
+import org.telegram.tgnet.TLRPC
+import tele.TeleConfig
+import tele.db.TeleDatabaseHelper
+import java.util.concurrent.ConcurrentHashMap
+
+/**
+ * Chats and forum topics that were deleted, left or taken away: their cached messages stay in the archive,
+ * next to the title and userpic they had, and the overview lists them marked as deleted.
+ */
+object DeletedChats {
+    private const val FRESH = 60_000L
+    private const val VIA_CHAT = 1
+    private const val VIA_TOPIC = 2
+    private const val GENERAL_TOPIC = 1L
+
+    private class Rows(val chats: MutableSet<Long>, val any: MutableSet<Long>)
+
+    private val rows = ConcurrentHashMap<Int, Rows>()
+
+    // what the stock code is about to do, told by its callers a moment before the storage gets to it
+    private val removed = ConcurrentHashMap<String, Long>()
+    private val ownTopics = ConcurrentHashMap<String, Long>()
+
+    // the last full copy of a chat the server turns into a stub without a userpic
+    private val snapshots = ConcurrentHashMap<String, ByteArray>()
+
+    private fun enabled(): Boolean = TeleConfig.KEEP_DELETED_MESSAGES.value && TeleConfig.KEEP_DELETED_CHATS.value
+
+    private fun now(): Int = (System.currentTimeMillis() / 1000L).toInt()
+
+    private fun key(account: Int, dialogId: Long) = "$account:$dialogId"
+
+    private fun topicKey(account: Int, dialogId: Long, topicId: Long) = "$account:$dialogId:$topicId"
+
+    private fun take(map: ConcurrentHashMap<String, Long>, key: String): Boolean {
+        val at = map.remove(key) ?: return false
+        return System.currentTimeMillis() - at < FRESH
+    }
+
+    private fun rowsOf(account: Int): Rows = rows[account] ?: synchronized(this) {
+        rows[account] ?: load(account).also { rows[account] = it }
+    }
+
+    private fun load(account: Int): Rows {
+        val chats = ConcurrentHashMap.newKeySet<Long>()
+        val any = ConcurrentHashMap.newKeySet<Long>()
+        runCatching {
+            for (row in TeleDatabaseHelper.getDeletedChats(account)) {
+                any.add(row.dialogId)
+                if (row.topicId == 0L) chats.add(row.dialogId)
+            }
+        }.onFailure { FileLog.e(it) }
+        return Rows(chats, any)
+    }
+
+    /** Whether a chat or topic of the dialog is kept as deleted. */
+    @JvmStatic
+    fun hasRows(account: Int, dialogId: Long): Boolean = rowsOf(account).any.contains(dialogId)
+
+    @JvmStatic
+    fun isDeletedChat(account: Int, dialogId: Long): Boolean = rowsOf(account).chats.contains(dialogId)
+
+    /** The chat is taken from the user (kicked, banned, deleted by its owner), not deleted by them. */
+    @JvmStatic
+    fun noteRemoved(account: Int, dialogId: Long) {
+        if (enabled()) removed[key(account, dialogId)] = System.currentTimeMillis()
+    }
+
+    /** The user deletes these topics themselves. */
+    @JvmStatic
+    fun noteOwnTopics(account: Int, chatId: Long, topicIds: List<Int>) {
+        if (!enabled()) return
+        val at = System.currentTimeMillis()
+        for (id in topicIds) ownTopics[topicKey(account, -chatId, id.toLong())] = at
+    }
+
+    /** The stock chat map is about to swap a chat for its forbidden stub. */
+    @JvmStatic
+    fun chatReplacing(account: Int, old: TLRPC.Chat?, new: TLRPC.Chat) {
+        if (old == null || !enabled() || !isStub(new) || isStub(old)) return
+        runCatching { snapshots[key(account, -old.id)] = serialize(old) }.onFailure { FileLog.e(it) }
+    }
+
+    private fun isStub(chat: TLRPC.Chat) = chat is TLRPC.TL_channelForbidden || chat is TLRPC.TL_chatForbidden
+
+    private fun serialize(obj: TLObject): ByteArray {
+        val stream = SerializedData(obj.getObjectSize())
+        try {
+            obj.serializeToStream(stream)
+            return stream.toByteArray()
+        } finally {
+            stream.cleanup()
+        }
+    }
+
+    /** The chat or user of a chat row. */
+    @JvmStatic
+    fun peerOf(dialogId: Long, data: ByteArray): TLObject? = runCatching {
+        val stream = SerializedData(data)
+        try {
+            val constructor = stream.readInt32(false)
+            if (dialogId < 0) TLRPC.Chat.TLdeserialize(stream, constructor, false) else TLRPC.User.TLdeserialize(stream, constructor, false)
+        } finally {
+            stream.cleanup()
+        }
+    }.getOrNull()
+
+    @JvmStatic
+    fun topicOf(data: ByteArray): TLRPC.TL_forumTopic? = runCatching {
+        val stream = SerializedData(data)
+        try {
+            TLRPC.TL_forumTopic.TLdeserialize(stream, stream.readInt32(false), false)
+        } finally {
+            stream.cleanup()
+        }
+    }.getOrNull()
+
+    @JvmStatic
+    fun titleOf(peer: TLObject?): String? = when (peer) {
+        is TLRPC.Chat -> peer.title
+        is TLRPC.User -> UserObject.getUserName(peer)
+        else -> null
+    }
+
+    /** The topic a message of a forum belongs to. */
+    @JvmStatic
+    fun topicIdOf(account: Int, message: TLRPC.Message): Long = MessageObject.getTopicId(account, message, MessagesStorage.FORUM_TYPE_CHAT)
+
+    private fun supported(account: Int, dialogId: Long, chat: TLRPC.Chat?, user: TLRPC.User?): Boolean {
+        if (dialogId == UserConfig.getInstance(account).clientUserId) return false
+        if (user != null && (UserObject.isReplyUser(user) || UserObject.isService(user.id))) return false
+        if (chat != null && (ChatObject.isMonoForum(chat) || ChatObject.isCommunity(chat))) return false
+        return true
+    }
+
+    /** The storage queue, right before a dialog is wiped for good: the cached messages and the chat itself go to the archive. */
+    @JvmStatic
+    fun archiveDialog(account: Int, db: SQLiteDatabase, dialogId: Long) {
+        val taken = take(removed, key(account, dialogId))
+        val snapshot = snapshots.remove(key(account, dialogId))
+        if (!enabled() || DialogObject.isEncryptedDialog(dialogId)) return
+        val own = !taken
+        if (own && !TeleConfig.KEEP_DELETED_OWN.value) return
+        val controller = MessagesController.getInstance(account)
+        val chat = if (dialogId < 0) controller.getChat(-dialogId) else null
+        val user = if (dialogId > 0) controller.getUser(dialogId) else null
+        if (!supported(account, dialogId, chat, user)) return
+        runCatching {
+            TeleDatabaseHelper.transaction { archiveMessages(account, db, dialogId, "SELECT mid, date, data FROM messages_v2 WHERE uid = $dialogId", own, VIA_CHAT) }
+            if (TeleDatabaseHelper.countDeletedMessages(account, dialogId) == 0) return
+            val data = snapshot ?: chat?.let { serialize(it) } ?: user?.let { serialize(it) } ?: storedPeer(db, dialogId) ?: return
+            val stamp = now()
+            TeleDatabaseHelper.transaction {
+                // a second delete of the same chat (leave, then delete) sees the stub, the first copy is the good one
+                TeleDatabaseHelper.putDeletedChat(account, TeleDatabaseHelper.DeletedChatRow(dialogId, 0, stamp, own, false, data), !isDeletedChat(account, dialogId))
+                if (dialogId < 0) {
+                    // the topics go along, so a deleted forum opens topic by topic
+                    val cursor = db.queryFinalized("SELECT topic_id, data FROM topics WHERE did = $dialogId")
+                    try {
+                        while (cursor.next()) {
+                            val topic = cursor.byteArrayValue(1) ?: continue
+                            TeleDatabaseHelper.putDeletedChat(account, TeleDatabaseHelper.DeletedChatRow(dialogId, cursor.longValue(0), stamp, own, true, topic), false)
+                        }
+                    } finally {
+                        cursor.dispose()
+                    }
+                }
+            }
+            val cache = rowsOf(account)
+            cache.chats.add(dialogId)
+            cache.any.add(dialogId)
+        }.onFailure { FileLog.e(it) }
+    }
+
+    /** The chat as the storage knows it, when nothing fresher is in memory. */
+    private fun storedPeer(db: SQLiteDatabase, dialogId: Long): ByteArray? {
+        val cursor = db.queryFinalized(if (dialogId < 0) "SELECT data FROM chats WHERE uid = ${-dialogId}" else "SELECT data FROM users WHERE uid = $dialogId")
+        try {
+            if (!cursor.next()) return null
+            return cursor.byteArrayValue(0)
+        } finally {
+            cursor.dispose()
+        }
+    }
+
+    private fun archiveMessages(account: Int, db: SQLiteDatabase, dialogId: Long, sql: String, own: Boolean, via: Int) {
+        val self = UserConfig.getInstance(account).clientUserId
+        val cursor = db.queryFinalized(sql)
+        try {
+            while (cursor.next()) {
+                val mid = cursor.intValue(0)
+                val date = cursor.intValue(1)
+                val data = cursor.byteBufferValue(2) ?: continue
+                val message = try {
+                    TLRPC.Message.TLdeserialize(data, data.readInt32(false), false)?.also { it.readAttachPath(data, self) }
+                } finally {
+                    data.reuse()
+                }
+                if (message == null) continue
+                message.id = mid
+                message.dialog_id = dialogId
+                message.date = date
+                DeletedMessages.archiveWithChat(account, message, own, via)
+            }
+        } finally {
+            cursor.dispose()
+        }
+    }
+
+    /** The storage queue, right before topics of a forum go: the messages and the topic itself go to the archive. */
+    @JvmStatic
+    fun archiveTopics(account: Int, db: SQLiteDatabase, dialogId: Long, topicIds: List<Long>) {
+        for (id in topicIds) archiveTopic(account, db, dialogId, id)
+    }
+
+    @JvmStatic
+    fun archiveTopic(account: Int, db: SQLiteDatabase, dialogId: Long, topicId: Long) {
+        val own = take(ownTopics, topicKey(account, dialogId, topicId))
+        if (!enabled() || dialogId >= 0 || topicId == GENERAL_TOPIC) return
+        if (own && !TeleConfig.KEEP_DELETED_OWN.value) return
+        val controller = MessagesController.getInstance(account)
+        val chat = controller.getChat(-dialogId)
+        if (!supported(account, dialogId, chat, null) || isDeletedChat(account, dialogId)) return
+        runCatching {
+            var found: ByteArray? = null
+            val cursor = db.queryFinalized("SELECT data FROM topics WHERE did = $dialogId AND topic_id = $topicId")
+            try {
+                if (cursor.next()) found = cursor.byteArrayValue(0)
+            } finally {
+                cursor.dispose()
+            }
+            val topic = found ?: return
+            TeleDatabaseHelper.transaction {
+                archiveMessages(account, db, dialogId, "SELECT mid, date, data FROM messages_v2 WHERE uid = $dialogId AND mid IN (SELECT mid FROM messages_topics WHERE uid = $dialogId AND topic_id = $topicId)", own, VIA_TOPIC)
