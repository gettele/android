                     .setColor(0xff11acfa);
 
+            if (tele.TeleConfig.STREAMER_MODE.getValue()) {
+                // the streamer mode hides the sender and the message of every notification
+                mBuilder.setContentTitle(LocaleController.getString(R.string.AppName));
+                mBuilder.setContentText("");
+                mBuilder.setStyle(new NotificationCompat.BigTextStyle().bigText(""));
+                mBuilder.setSubText(null);
+            }
