From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: test <test@example.com>
Date: Mon, 9 Nov 2026 21:45:02 +0300
Subject: [PATCH] fix: let scripts reach the player and the message menu

---
 TMessagesProj/src/main/assets/tele/scripting/runtime.js      | 2 ++
 .../src/main/java/org/telegram/ui/ChatActivity.java          | 5 ++++-
 TMessagesProj/src/main/java/tele/scripting/ScriptPlayer.kt   | 3 ++-
 3 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/TMessagesProj/src/main/assets/tele/scripting/runtime.js b/TMessagesProj/src/main/assets/tele/scripting/runtime.js
index 538db6844..5e7b1514c 100644
--- a/TMessagesProj/src/main/assets/tele/scripting/runtime.js
+++ b/TMessagesProj/src/main/assets/tele/scripting/runtime.js
@@ -566,6 +566,8 @@
 					throw new TeleError('not-found', `${id} isn't in tele's cache, pass an input peer or a username`);
 				}
 				return info.input;
+			} else if (peer !== null && typeof peer === 'object' && typeof peer.$b === 'string') {
+				return resolvePeer(BigInt(peer.$b));
 			} else if (peer !== null && typeof peer === 'object') {
 				if (peer.input?._) {
 					return peer.input;
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
index 12d7927b0..b26ca2f2d 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
@@ -827,6 +827,7 @@ public class ChatActivity extends BaseFragment implements
 
     private MessageObject selectedObjectToEditCaption;
     private MessageObject selectedObject;
+    private MessageObject tele_scriptActionMessage;
     private MessageObject.GroupedMessages selectedObjectGroup;
     private boolean forbidForwardingWithDismiss;
     public MessagePreviewParams messagePreviewParams;
@@ -35363,7 +35364,8 @@ public class ChatActivity extends BaseFragment implements
 
     private void processSelectedOption(int option) {
         if (option >= 9000 && option < 9100) {
-            final MessageObject target = selectedObject;
+            // the menu dismisses before the option arrives, and clears selectedObject: the message was kept
+            final MessageObject target = tele_scriptActionMessage != null ? tele_scriptActionMessage : selectedObject;
             if (target != null) {
                 tele.scripting.ScriptMessageActions.invoke(currentAccount, target, option - 9000);
             }
@@ -48690,6 +48692,7 @@ public class ChatActivity extends BaseFragment implements
             items.add(action.getText());
             options.add(9000 + i);
         }
+        tele_scriptActionMessage = teleActions.isEmpty() ? null : message;
 }
     private boolean showWelcomeMessageRevertOption(MessageObject messageObject) {
         return chatMode == MODE_DEFAULT && messageObject != null && messageObject.isWelcomeAnchored();
diff --git a/TMessagesProj/src/main/java/tele/scripting/ScriptPlayer.kt b/TMessagesProj/src/main/java/tele/scripting/ScriptPlayer.kt
index b491f87c9..8f8eb828d 100644
--- a/TMessagesProj/src/main/java/tele/scripting/ScriptPlayer.kt
+++ b/TMessagesProj/src/main/java/tele/scripting/ScriptPlayer.kt
@@ -66,7 +66,8 @@ object ScriptPlayer {
         if (listeners.none { it.first === runtime && it.second == id }) {
             listeners.add(runtime to id)
         }
-        ensureObserver()
+        // the notification centre is happy only on the main thread, and the script calls us on its own
+        AndroidUtilities.runOnUIThread { ensureObserver() }
     }
 
     @JvmStatic
