diff --git a/TMessagesProj/src/main/java/tele/helpers/LocalMute.kt b/TMessagesProj/src/main/java/tele/helpers/LocalMute.kt
new file mode 100644
index 000000000..a24f15f00
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/LocalMute.kt
@@ -0,0 +1,226 @@
+package tele.helpers
+
+import android.util.SparseArray
+import android.view.View
+import org.json.JSONArray
+import org.json.JSONObject
+import org.telegram.messenger.AccountInstance
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.DialogObject
+import org.telegram.messenger.FileLog
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.MessagesController
+import org.telegram.messenger.MessagesController.DialogFilter
+import org.telegram.messenger.MessagesStorage
+import org.telegram.messenger.NotificationCenter
+import org.telegram.messenger.NotificationsController
+import org.telegram.messenger.R
+import org.telegram.messenger.UserConfig
+import org.telegram.messenger.Utilities
+import org.telegram.ui.ActionBar.ActionBarMenuSubItem
+import tele.TeleConfig
+import tele.db.TeleDatabaseHelper
+
+/**
+ * Mutes that live only on this device: whole folders (every chat the folder takes counts as muted) and chats
+ * silenced completely (no notification of any kind). The server notify settings are never touched.
+ */
+object LocalMute {
+
+    private const val KEY = "mute_state"
+
+    private class State(val userId: Long) {
+        val folders = HashSet<Int>()
+        val silenced = HashSet<Long>()
+        @Volatile
+        var loaded = false
+    }
+
+    private val states = SparseArray<State>()
+
+    // null until the stored sets are read, which happens off the caller's thread
+    private fun state(account: Int): State? {
+        val userId = UserConfig.getInstance(account).getClientUserId()
+        if (userId == 0L) return null
+        synchronized(states) {
+            val known = states.get(account)
+            if (known != null && known.userId == userId) return if (known.loaded) known else null
+            val fresh = State(userId)
+            states.put(account, fresh)
+            Utilities.globalQueue.postRunnable {
+                load(fresh)
+                fresh.loaded = true
+                if (fresh.folders.isNotEmpty()) AndroidUtilities.runOnUIThread { refresh(account) }
+            }
+            return null
+        }
+    }
+
+    private fun key(userId: Long) = "$KEY:$userId"
+
+    private fun load(state: State) {
+        val raw = runCatching { TeleDatabaseHelper.get(key(state.userId)) }.getOrNull() ?: return
+        runCatching {
+            val json = JSONObject(raw)
+            synchronized(state) {
+                json.optJSONArray("f")?.let { for (i in 0 until it.length()) state.folders.add(it.getInt(i)) }
+                json.optJSONArray("s")?.let { for (i in 0 until it.length()) state.silenced.add(it.getLong(i)) }
+            }
+        }.onFailure { FileLog.e(it) }
+    }
+
+    private fun persist(state: State) {
+        val text = synchronized(state) {
+            JSONObject().put("f", JSONArray(state.folders.toList())).put("s", JSONArray(state.silenced.toList())).toString()
+        }
+        val key = key(state.userId)
+        Utilities.globalQueue.postRunnable { runCatching { TeleDatabaseHelper.put(key, text) }.onFailure { FileLog.e(it) } }
+    }
+
+    // the muted folders are matched with the stock rules, minus "exclude muted": that rule asks if the chat is muted
+    private class Copy(val origin: DialogFilter, val copy: DialogFilter)
+
+    private val copies = HashMap<Long, Copy>()
+
+    private fun copyOf(account: Int, filter: DialogFilter): DialogFilter {
+        val flags = filter.flags and MessagesController.DIALOG_FILTER_FLAG_EXCLUDE_MUTED.inv()
+        val key = (account.toLong() shl 32) or (filter.id.toLong() and 0xFFFFFFFFL)
+        synchronized(copies) {
+            val known = copies[key]
+            if (known != null && known.origin === filter && known.copy.flags == flags &&
+                known.copy.alwaysShow === filter.alwaysShow && known.copy.neverShow === filter.neverShow) {
+                return known.copy
+            }
+            val copy = DialogFilter()
+            copy.id = filter.id
+            copy.name = filter.name
+            copy.flags = flags
+            copy.color = -1
+            copy.alwaysShow = filter.alwaysShow
+            copy.neverShow = filter.neverShow
+            copy.pinnedDialogs = filter.pinnedDialogs
+            copies[key] = Copy(filter, copy)
+            return copy
+        }
+    }
+
+    /** True when a muted folder takes the chat: the chat counts as muted whatever its own setting says. */
+    @JvmStatic
+    fun mutedByFolder(account: Int, dialogId: Long): Boolean {
+        if (!TeleConfig.MUTE_FOLDERS.value) return false
+        val state = state(account) ?: return false
+        val ids = synchronized(state) {
+            if (state.folders.isEmpty()) return false
+            state.folders.toIntArray()
+        }
+        val controller = MessagesController.getInstance(account)
+        val dialog = controller.dialogs_dict.get(dialogId) ?: return false
+        var did = dialogId
+        if (DialogObject.isEncryptedDialog(did)) {
+            did = controller.getEncryptedChat(DialogObject.getEncryptedChatId(did))?.user_id ?: return false
+        }
+        val accountInstance = AccountInstance.getInstance(account)
+        for (id in ids) {
+            val filter = controller.dialogFiltersById.get(id) ?: continue
+            if (copyOf(account, filter).includesDialog(accountInstance, did, dialog)) return true
+        }
+        return false
+    }
+
+    @JvmStatic
+    fun isFolderMuted(account: Int, folderId: Int): Boolean {
+        val state = state(account) ?: return false
+        return synchronized(state) { folderId in state.folders }
+    }
+
+    @JvmStatic
+    fun folderMenuVisible(filter: DialogFilter?): Boolean = filter != null && filter.id != 0 && TeleConfig.MUTE_FOLDERS.value
+
+    /** UI thread: mutes or unmutes a folder; one folder unmuted doesn't unmute a chat another muted folder holds. */
+    @JvmStatic
+    fun toggleFolder(account: Int, folderId: Int) {
+        val state = state(account) ?: return
+        val muted = synchronized(state) {
+            if (!state.folders.remove(folderId)) state.folders.add(folderId)
+            folderId in state.folders
+        }
+        persist(state)
+        if (muted) clearNotifications(account, folderId)
+        refresh(account)
+    }
+
+    private fun clearNotifications(account: Int, folderId: Int) {
+        val controller = MessagesController.getInstance(account)
+        val filter = controller.dialogFiltersById.get(folderId) ?: return
+        val accountInstance = AccountInstance.getInstance(account)
+        val notifications = NotificationsController.getInstance(account)
+        for (d in ArrayList(controller.allDialogs)) {
+            var did = d.id
+            if (DialogObject.isEncryptedDialog(did)) {
+                did = controller.getEncryptedChat(DialogObject.getEncryptedChatId(did))?.user_id ?: continue
+            }
+            if (copyOf(account, filter).includesDialog(accountInstance, did, d)) notifications.removeNotificationsForDialog(d.id)
+        }
+    }
+
+    // the cells and the counters ask isDialogMuted again
+    private fun refresh(account: Int) {
+        MessagesStorage.getInstance(account).updateMutedDialogsFiltersCounters()
+        NotificationCenter.getInstance(account).postNotificationName(NotificationCenter.dialogsNeedReload)
+    }
+
+    @JvmStatic
+    fun onToggled() {
+        for (account in 0 until UserConfig.MAX_ACCOUNT_COUNT) {
+            if (UserConfig.getInstance(account).isClientActivated) refresh(account)
+        }
+    }
+
+    /** The folder is gone, so is its mute. */
+    @JvmStatic
+    fun forgetFolder(account: Int, folderId: Int) {
+        val state = state(account) ?: return
+        val changed = synchronized(state) { state.folders.remove(folderId) }
+        if (changed) persist(state)
+    }
+
+    /** Storage thread: mutes of folders that don't exist any more are dropped. */
+    @JvmStatic
+    fun pruneFolders(account: Int, valid: Set<Int>) {
+        val state = state(account) ?: return
+        val changed = synchronized(state) { state.folders.retainAll(valid) }
+        if (changed) persist(state)
+    }
+
+    /** True for a chat that must never notify: new messages, mentions and reactions included. */
+    @JvmStatic
+    fun isSilenced(account: Int, dialogId: Long): Boolean {
+        if (!TeleConfig.SILENCE_COMPLETELY.value) return false
+        val state = state(account) ?: return false
+        return synchronized(state) { dialogId in state.silenced }
+    }
+
+    @JvmStatic
+    fun toggleSilence(account: Int, dialogId: Long) {
+        val state = state(account) ?: return
+        val silenced = synchronized(state) {
+            if (!state.silenced.remove(dialogId)) state.silenced.add(dialogId)
+            dialogId in state.silenced
+        }
+        persist(state)
+        if (silenced) NotificationsController.getInstance(account).removeNotificationsForDialog(dialogId)
+    }
+
+    /** The row of the mute popup: a chat is silenced completely or not. */
+    @JvmStatic
+    fun updateSilenceItem(item: ActionBarMenuSubItem, account: Int, dialogId: Long, topicId: Long) {
+        val visible = TeleConfig.SILENCE_COMPLETELY.value && topicId == 0L && dialogId != 0L
+        item.visibility = if (visible) View.VISIBLE else View.GONE
+        if (!visible) return
+        val silenced = isSilenced(account, dialogId)
+        item.setTextAndIcon(
+            LocaleController.getString(if (silenced) R.string.TeleSilenceStop else R.string.TeleSilence),
+            R.drawable.msg_block
+        )
+    }
+}
