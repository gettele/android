+package tele.helpers
+
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.MediaDataController
+import org.telegram.messenger.UserConfig
+import org.telegram.ui.Components.ReactionsContainerLayout
+import org.telegram.ui.Components.Reactions.ReactionsLayoutInBubble.VisibleReaction
+import tele.TeleConfig
+import tele.db.TeleDatabaseHelper
+
+// tele 0235: the reactions you pin go first in the reaction strip, in the slots you chose
+object ReactionStrip {
+
+    const val MIN_COUNT = 4
+    const val MAX_COUNT = 12
+
+    private const val KEY = "reactions_order:"
+    private const val MAX_EMOJI_LENGTH = 32
+
+    // the slots of the pinned reactions per account, an empty id is a free slot; read once, kept in sync on write
+    private val cache = HashMap<Int, List<String>>()
+
+    private fun isCustom(id: String) = id.isNotEmpty() && id.all { it.isDigit() }
+
+    private fun parseOne(raw: String): String? {
+        val part = raw.trim()
+        if (part.isEmpty() || part.length > MAX_EMOJI_LENGTH || part.any { it.isWhitespace() }) return null
+        if (isCustom(part)) return part.toLongOrNull()?.takeIf { it > 0 }?.toString()
+        return part
+    }
+
+    fun parse(value: String?): List<String> {
+        if (value.isNullOrEmpty()) return emptyList()
+        val result = ArrayList<String>()
+        for (part in value.split(',')) {
+            val id = parseOne(part)
+            result.add(if (id != null && id !in result) id else "")
+        }
+        return trimmed(result)
+    }
+
+    fun serialize(list: List<String>): String = trimmed(list).joinToString(",")
+
+    fun trimmed(list: List<String>): List<String> {
+        var end = list.size
+        while (end > 0 && list[end - 1].isEmpty()) end--
+        return if (end == list.size) list else list.subList(0, end).toList()
+    }
+
+    @JvmStatic
+    fun pinned(account: Int): List<String> = synchronized(cache) {
+        cache.getOrPut(account) { parse(TeleDatabaseHelper.get(KEY + account)) }
+    }
+
+    fun setPinned(account: Int, list: List<String>) {
+        val fixed = parse(serialize(list))
+        synchronized(cache) { cache[account] = fixed }
+        TeleDatabaseHelper.put(KEY + account, fixed.takeIf { it.isNotEmpty() }?.let { serialize(it) })
+    }
+
+    fun pinnedCount(list: List<String>): Int = list.count { it.isNotEmpty() }
+
+    /** The count of reactions in the strip, 0 for the stock one. */
+    @JvmStatic
+    fun count(): Int = validCount(TeleConfig.REACTIONS_STRIP_COUNT.value)
+
+    fun validCount(value: String): Int =
+        value.toIntOrNull()?.takeIf { it in MIN_COUNT..MAX_COUNT } ?: 0
+
+    private fun supported(type: Int) =
+        type == ReactionsContainerLayout.TYPE_DEFAULT || type == ReactionsContainerLayout.TYPE_STORY
+
+    private fun matches(reaction: VisibleReaction, id: String): Boolean {
+        if (reaction.isStar || reaction.isEffect) return false
+        return if (isCustom(id)) reaction.documentId == id.toLong() else reaction.emojicon == id
+    }
+
+    fun idOf(reaction: VisibleReaction): String? = when {
+        reaction.isStar || reaction.isEffect -> null
+        reaction.documentId != 0L -> reaction.documentId.toString()
+        else -> reaction.emojicon?.takeIf { it.isNotEmpty() }
+    }
+
+    fun visible(id: String): VisibleReaction =
+        if (isCustom(id)) VisibleReaction.fromCustomEmoji(id.toLong()) else VisibleReaction.fromEmojicon(id)
+
+    /** The pinned reactions in their slots, the rest keep the chat's order. Only reactions the list allows are placed. */
+    fun order(list: List<VisibleReaction>, pins: List<String>, customAllowed: Boolean): List<VisibleReaction> {
+        if (pinnedCount(pins) == 0 || list.any { it.isEffect }) return list
+        val rest = ArrayList(list)
+        val starAt = rest.indexOfFirst { it.isStar }
+        val star = if (starAt >= 0) rest.removeAt(starAt) else null
+        val placed = arrayOfNulls<VisibleReaction>(pins.size)
+        for (i in pins.indices) {
+            val id = pins[i]
+            if (id.isEmpty()) continue
+            val at = rest.indexOfFirst { matches(it, id) }
+            if (at >= 0) {
+                placed[i] = rest.removeAt(at)
+            } else if (isCustom(id) && customAllowed) {
+                placed[i] = visible(id)
+            }
+        }
+        val merged = ArrayList<VisibleReaction>(list.size + pins.size)
+        var next = 0
+        for (reaction in placed) {
+            if (reaction != null) {
+                merged.add(reaction)
+            } else if (next < rest.size) {
+                merged.add(rest[next++])
+            }
+        }
+        while (next < rest.size) merged.add(rest[next++])
+        if (star != null) merged.add(minOf(starAt, merged.size), star)
+        return merged
+    }
+
+    /** The reactions of the strip, called when it fills; no pins or an unsupported strip give the same list back. */
+    @JvmStatic
+    fun apply(account: Int, type: Int, hitLimit: Boolean, allAvailable: Boolean, list: List<VisibleReaction>): List<VisibleReaction> {
+        if (hitLimit || !supported(type)) return list
+        val pins = pinned(account)
+        if (pins.isEmpty()) return list
+        val customAllowed = allAvailable && UserConfig.getInstance(account).isPremium
+        return order(list, pins, customAllowed)
+    }
+
+    /** The reactions shown before the expand button; the stock number when the count is auto. */
+    @JvmStatic
+    fun columns(stock: Int, type: Int): Int {
+        val count = count()
+        if (count == 0 || !supported(type)) return stock
+        // the strip, the premium button and the expand button have to fit the screen
+        val fit = (AndroidUtilities.displaySize.x - AndroidUtilities.dp(24f)) / AndroidUtilities.dp(36f) - 2
+        return count.coerceAtMost(fit).coerceAtLeast(1)
+    }
+
+    /** The reactions of a chat that allows all of them, as the strip lists them before pinning. */
+    fun base(account: Int): List<VisibleReaction> {
+        val data = MediaDataController.getInstance(account)
+        val premium = UserConfig.getInstance(account).isPremium
+        val result = LinkedHashSet<VisibleReaction>()
+        for (reaction in data.topReactions) {
+            val visible = VisibleReaction.fromTL(reaction)
+            if (premium || visible.documentId == 0L) result.add(visible)
+        }
+        if (premium) {
+            for (reaction in data.recentReactions) result.add(VisibleReaction.fromTL(reaction))
+        }
+        for (reaction in data.enabledReactionsList) result.add(VisibleReaction.fromEmojicon(reaction))
+        return result.toList()
+    }
+
+    /** The ids the editor shows, pinned first; a pinned custom emoji stays listed without Premium, only the strip skips it. */
+    fun shown(account: Int, pins: List<String>): List<String> =
+        order(base(account), pins, true).mapNotNull { idOf(it) }
+
+    private fun put(list: MutableList<String>, slot: Int, id: String) {
+        while (list.size <= slot) list.add("")
+        list[slot] = id
+    }
+
+    fun unpinned(pins: List<String>, id: String): List<String> =
+        trimmed(pins.map { if (it == id) "" else it })
+
+    fun pinnedAt(pins: List<String>, id: String, slot: Int): List<String> {
+        val result = unpinned(pins, id).toMutableList()
+        put(result, slot, id)
+        return result
+    }
+
+    fun appended(pins: List<String>, id: String): List<String> {
+        val without = unpinned(pins, id)
+        return pinnedAt(without, id, without.size)
+    }
+
+    fun replaced(account: Int, pins: List<String>, slot: Int, id: String): List<String> {
+        val current = shown(account, pins)
+        val base = if (slot < current.size) unpinned(pins, current[slot]) else pins
+        return pinnedAt(base, id, slot)
+    }
+
+    /** The pins after a reaction is dropped on a slot: it gets pinned there, the pinned ones keep their place. */
+    fun moved(account: Int, pins: List<String>, id: String, slot: Int): List<String> {
+        val current = shown(account, pins).toMutableList()
+        val from = current.indexOf(id)
+        if (from < 0) return pins
+        current.removeAt(from)
+        current.add(slot.coerceIn(0, current.size), id)
+        val result = ArrayList<String>()
+        for (i in current.indices) {
+            val value = current[i]
+            if (value == id || value in pins) put(result, i, value)
+        }
+        for (i in pins.indices) {
+            val value = pins[i]
+            if (value.isEmpty() || value in current) continue
+            var free = i
+            while (free < result.size && result[free].isNotEmpty()) free++
+            put(result, free, value)
+        }
+        return trimmed(result)
+    }
+}
