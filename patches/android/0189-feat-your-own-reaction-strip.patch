+package tele.ui.settings
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.PorterDuff
+import android.graphics.PorterDuffColorFilter
+import android.view.Gravity
+import android.view.MotionEvent
+import android.view.View
+import android.view.ViewGroup
+import android.widget.FrameLayout
+import android.widget.ImageView
+import android.widget.TextView
+import androidx.recyclerview.widget.ItemTouchHelper
+import androidx.recyclerview.widget.LinearLayoutManager
+import androidx.recyclerview.widget.RecyclerView
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.Emoji
+import org.telegram.messenger.LiteMode
+import org.telegram.messenger.MediaDataController
+import org.telegram.messenger.NotificationCenter
+import org.telegram.messenger.R
+import org.telegram.messenger.UserConfig
+import org.telegram.tgnet.TLRPC
+import org.telegram.tgnet.tl.TL_stars
+import org.telegram.ui.ActionBar.ActionBar
+import org.telegram.ui.ActionBar.AlertDialog
+import org.telegram.ui.ActionBar.BaseFragment
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Cells.HeaderCell
+import org.telegram.ui.Cells.TextInfoPrivacyCell
+import org.telegram.ui.Cells.TextSettingsCell
+import org.telegram.ui.Components.AnimatedEmojiDrawable
+import org.telegram.ui.Components.LayoutHelper
+import org.telegram.ui.Components.Reactions.ReactionsLayoutInBubble
+import org.telegram.ui.Components.RecyclerListView
+import org.telegram.ui.SelectAnimatedEmojiDialog
+import tele.TeleConfig
+import tele.TeleHooks
+import tele.helpers.ReactionStrip
+import tele.helpers.TeleLowercase
+
+/** The reactions of the message menu: the pinned ones in their slots and how many the strip shows. */
+class TeleReactionsActivity : BaseFragment(), NotificationCenter.NotificationCenterDelegate {
+
+    private var listView: RecyclerListView? = null
+    private var adapter: Adapter? = null
+    private var touchHelper: ItemTouchHelper? = null
+
+    private var pins: List<String> = emptyList()
+    private var shown: MutableList<String> = mutableListOf()
+    private var rows: List<Row> = emptyList()
+
+    private var dragId: String? = null
+    private var dragFrom = -1
+    private var dragTo = -1
+    private var picker: SelectAnimatedEmojiDialog.SelectAnimatedEmojiDialogWindow? = null
+
+    private class Row(val type: Int, val index: Int = 0)
+
+    override fun onFragmentCreate(): Boolean {
+        notificationCenter.addObserver(this, NotificationCenter.reactionsDidLoad)
+        notificationCenter.addObserver(this, NotificationCenter.currentUserPremiumStatusChanged)
+        return super.onFragmentCreate()
+    }
+
+    override fun onFragmentDestroy() {
+        super.onFragmentDestroy()
+        notificationCenter.removeObserver(this, NotificationCenter.reactionsDidLoad)
+        notificationCenter.removeObserver(this, NotificationCenter.currentUserPremiumStatusChanged)
+        picker?.dismiss()
+    }
+
+    override fun didReceivedNotification(id: Int, account: Int, vararg args: Any?) {
+        if (account != currentAccount || dragId != null) return
+        reload()
+    }
+
+    override fun createView(context: Context): View {
+        actionBar.setBackButtonImage(R.drawable.ic_ab_back)
+        actionBar.setAllowOverlayTitle(true)
+        actionBar.setTitle(lc("Reactions in the menu"))
+        actionBar.setActionBarMenuOnItemClick(object : ActionBar.ActionBarMenuOnItemClick() {
+            override fun onItemClick(id: Int) {
+                if (id == -1) finishFragment()
+            }
+        })
+
+        val frameLayout = FrameLayout(context)
+        frameLayout.setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundGray))
+        fragmentView = frameLayout
+
+        val list = RecyclerListView(context)
+        list.setLayoutManager(LinearLayoutManager(context))
+        list.setVerticalScrollBarEnabled(false)
+        listView = list
+        adapter = Adapter(context)
+        list.setAdapter(adapter)
+
+        touchHelper = ItemTouchHelper(object : ItemTouchHelper.Callback() {
+            override fun isLongPressDragEnabled(): Boolean = false
+
+            override fun getMovementFlags(recyclerView: RecyclerView, viewHolder: RecyclerView.ViewHolder): Int {
+                val row = rows.getOrNull(viewHolder.adapterPosition) ?: return 0
+                return if (row.type == TYPE_REACTION) makeMovementFlags(ItemTouchHelper.UP or ItemTouchHelper.DOWN, 0) else 0
+            }
+
+            override fun onMove(recyclerView: RecyclerView, viewHolder: RecyclerView.ViewHolder, target: RecyclerView.ViewHolder): Boolean {
+                val from = rows.getOrNull(viewHolder.adapterPosition) ?: return false
+                val to = rows.getOrNull(target.adapterPosition) ?: return false
+                if (from.type != TYPE_REACTION || to.type != TYPE_REACTION) return false
+                val id = shown.removeAt(from.index)
+                shown.add(to.index, id)
+                dragTo = to.index
+                adapter?.notifyItemMoved(viewHolder.adapterPosition, target.adapterPosition)
+                return true
+            }
+
+            override fun onSelectedChanged(viewHolder: RecyclerView.ViewHolder?, actionState: Int) {
+                super.onSelectedChanged(viewHolder, actionState)
+                if (actionState == ItemTouchHelper.ACTION_STATE_DRAG && viewHolder != null) {
+                    val row = rows.getOrNull(viewHolder.adapterPosition) ?: return
+                    dragId = shown.getOrNull(row.index)
+                    dragFrom = row.index
+                    dragTo = row.index
+                }
+            }
+
+            override fun onSwiped(viewHolder: RecyclerView.ViewHolder, direction: Int) {}
+
+            override fun clearView(recyclerView: RecyclerView, viewHolder: RecyclerView.ViewHolder) {
+                super.clearView(recyclerView, viewHolder)
+                finishDrag()
+            }
+        })
+        touchHelper?.attachToRecyclerView(list)
+
+        list.setOnItemClickListener { view, position ->
+            val row = rows.getOrNull(position) ?: return@setOnItemClickListener
+            when (row.type) {
+                TYPE_REACTION -> showReactionMenu(view, row.index)
+                TYPE_ADD -> pick(view) { id -> setPins(ReactionStrip.appended(pins, id)) }
+                TYPE_COUNT -> chooseCount()
+                TYPE_RESET -> {
+                    if (pins.isNotEmpty()) setPins(emptyList())
+                }
+            }
+        }
+
+        frameLayout.addView(list, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.MATCH_PARENT.toFloat()))
+        reload()
+        return fragmentView
+    }
+
+    private fun reload() {
+        pins = ReactionStrip.pinned(currentAccount)
+        shown = ReactionStrip.shown(currentAccount, pins).toMutableList()
+        rebuildRows()
+        adapter?.notifyDataSetChanged()
+    }
+
+    private fun rebuildRows() {
+        val list = ArrayList<Row>()
+        list.add(Row(TYPE_HEADER, 0))
+        for (i in shown.indices) list.add(Row(TYPE_REACTION, i))
+        list.add(Row(TYPE_ADD))
+        list.add(Row(TYPE_INFO, 0))
+        list.add(Row(TYPE_HEADER, 1))
+        list.add(Row(TYPE_COUNT))
+        list.add(Row(TYPE_INFO, 1))
+        list.add(Row(TYPE_RESET))
+        list.add(Row(TYPE_INFO, 2))
+        rows = list
+    }
+
+    private fun setPins(list: List<String>) {
+        ReactionStrip.setPinned(currentAccount, list)
+        reload()
+    }
+
+    /** The drop pins the reaction on its new slot; the list shows the result, not the raw drop. */
+    private fun finishDrag() {
+        val id = dragId
+        val from = dragFrom
+        val to = dragTo
+        dragId = null
+        dragFrom = -1
+        dragTo = -1
+        if (id != null && from != to) {
+            ReactionStrip.setPinned(currentAccount, ReactionStrip.moved(currentAccount, pins, id, to))
+        }
+        listView?.post { reload() }
+    }
+
+    private fun showReactionMenu(anchor: View, index: Int) {
+        val id = shown.getOrNull(index) ?: return
+        val pinned = id in pins
+        val items = if (pinned) {
+            arrayOf<CharSequence>(lc("Replace with another reaction"), lc("Unpin"))
+        } else {
+            arrayOf<CharSequence>(lc("Pin here"), lc("Replace with another reaction"))
+        }
+        val replace = if (pinned) 0 else 1
+        val builder = AlertDialog.Builder(parentActivity ?: return, resourceProvider)
+        builder.setItems(items) { _, which ->
+            when {
+                which == replace -> pick(anchor) { picked -> setPins(ReactionStrip.replaced(currentAccount, pins, index, picked)) }
+                pinned -> setPins(ReactionStrip.unpinned(pins, id))
+                else -> setPins(ReactionStrip.pinnedAt(pins, id, index))
+            }
+        }
+        showDialog(builder.create())
+    }
+
+    private fun chooseCount() {
+        val labels = ArrayList<CharSequence>()
+        labels.add(lc("Auto"))
+        for (n in ReactionStrip.MIN_COUNT..ReactionStrip.MAX_COUNT) labels.add(n.toString())
+        val builder = AlertDialog.Builder(parentActivity ?: return, resourceProvider)
+        builder.setTitle(lc("Shown in the strip"))
+        builder.setItems(labels.toTypedArray()) { _, which ->
+            val value = if (which == 0) "" else (ReactionStrip.MIN_COUNT + which - 1).toString()
+            if (value != TeleConfig.REACTIONS_STRIP_COUNT.value) {
+                TeleConfig.set(TeleConfig.REACTIONS_STRIP_COUNT, value)
+                TeleHooks.onConfigChanged(TeleConfig.REACTIONS_STRIP_COUNT)
+                adapter?.notifyDataSetChanged()
+            }
+        }
+        showDialog(builder.create())
+    }
+
+    /** The stock picker of the quick reaction: the reactions and the custom emoji. */
+    private fun pick(anchor: View, picked: (String) -> Unit) {
+        if (picker != null) return
+        val context = parentActivity ?: return
+        val window = arrayOfNulls<SelectAnimatedEmojiDialog.SelectAnimatedEmojiDialogWindow>(1)
+        val done = { id: String ->
+            window[0]?.dismiss()
+            picked(id)
+        }
+        val layout = object : SelectAnimatedEmojiDialog(this, context, false, null, TYPE_SET_DEFAULT_REACTION, null) {
+            override fun onEmojiSelected(view: View?, documentId: Long?, document: TLRPC.Document?, gift: TL_stars.TL_starGiftUnique?, until: Int?) {
+                if (documentId != null) done(documentId.toString())
+            }
+
+            override fun onReactionClick(emoji: ImageViewEmoji?, reaction: ReactionsLayoutInBubble.VisibleReaction?) {
+                val id = reaction?.let { ReactionStrip.idOf(it) } ?: return
+                done(id)
+            }
+        }
+        layout.setRecentReactions(ReactionStrip.base(currentAccount))
+        window[0] = object : SelectAnimatedEmojiDialog.SelectAnimatedEmojiDialogWindow(layout, LayoutHelper.WRAP_CONTENT, LayoutHelper.WRAP_CONTENT) {
+            override fun dismiss() {
+                super.dismiss()
+                picker = null
+            }
+        }
+        picker = window[0]
+        window[0]?.showAsDropDown(anchor, 0, -(anchor.height / 2) - AndroidUtilities.dp(16f), Gravity.TOP or Gravity.RIGHT)
+        window[0]?.dimBehind()
+    }
+
+    private fun countLabel(): String {
+        val count = ReactionStrip.count()
+        return if (count == 0) lc("Auto") else count.toString()
+    }
+
+    // the server titles come in the system language and are cached by a language-blind hash, so the emoji stands for the name
+    private fun title(id: String, paint: android.graphics.Paint.FontMetricsInt): CharSequence {
+        if (id.all { it.isDigit() }) return lc("Custom emoji")
+        return Emoji.replaceEmoji(id, paint, false)
+    }
+
+    private inner class ReactionRow(context: Context) : FrameLayout(context) {
+        private val titleView = TextView(context)
+        private val subtitleView = TextView(context)
+        private val handle = ImageView(context)
+        private val icon = AnimatedEmojiDrawable.SwapAnimatedEmojiDrawable(this, AndroidUtilities.dp(28f))
+        private var line = false
+
+        init {
+            setWillNotDraw(false)
+            setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundWhite))
+            titleView.setTextSize(android.util.TypedValue.COMPLEX_UNIT_DIP, 16f)
+            titleView.setSingleLine()
+            subtitleView.setTextSize(android.util.TypedValue.COMPLEX_UNIT_DIP, 13f)
+            subtitleView.setSingleLine()
+            addView(titleView, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT.toFloat(), Gravity.LEFT or Gravity.TOP, 72f, 8f, 64f, 0f))
+            addView(subtitleView, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT.toFloat(), Gravity.LEFT or Gravity.TOP, 72f, 31f, 64f, 0f))
+            handle.setFocusable(false)
+            handle.setScaleType(ImageView.ScaleType.CENTER)
+            handle.setImageResource(R.drawable.list_reorder)
+            handle.setColorFilter(PorterDuffColorFilter(Theme.getColor(Theme.key_stickers_menu), PorterDuff.Mode.MULTIPLY))
+            handle.setOnTouchListener { _, event ->
+                if (event.actionMasked == MotionEvent.ACTION_DOWN) {
+                    listView?.findContainingViewHolder(this)?.let { touchHelper?.startDrag(it) }
+                }
+                false
+            }
+            addView(handle, LayoutHelper.createFrame(48, 48f, Gravity.RIGHT or Gravity.CENTER_VERTICAL, 0f, 0f, 8f, 0f))
+        }
+
+        fun bind(id: String, pinned: Boolean, divider: Boolean) {
+            titleView.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
+            subtitleView.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2))
+            titleView.text = title(id, titleView.paint.fontMetricsInt)
+            val locked = id.all { it.isDigit() } && !UserConfig.getInstance(currentAccount).isPremium
+            val subtitle = if (locked) lc("Needs Telegram Premium") else if (pinned) lc("Pinned") else ""
+            subtitleView.text = subtitle
+            subtitleView.visibility = if (subtitle.isNotEmpty()) View.VISIBLE else View.GONE
+            // a reaction without a subtitle sits centered
+            (titleView.layoutParams as LayoutParams).topMargin = AndroidUtilities.dp(if (subtitle.isNotEmpty()) 8f else 16f)
+            line = divider
+            if (id.all { it.isDigit() }) {
+                icon.set(id.toLong(), false)
+            } else {
+                val reaction = MediaDataController.getInstance(currentAccount).reactionsMap[id]
+                if (reaction != null) icon.set(reaction.static_icon, false) else icon.set(null as TLRPC.Document?, false)
+            }
+            if (!LiteMode.isEnabled(LiteMode.FLAG_ANIMATED_EMOJI_REACTIONS)) {
+                (icon.drawable as? AnimatedEmojiDrawable)?.imageReceiver?.stopAnimation()
+            }
+            invalidate()
+        }
+
+        override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
+            super.onMeasure(
+                MeasureSpec.makeMeasureSpec(MeasureSpec.getSize(widthMeasureSpec), MeasureSpec.EXACTLY),
+                MeasureSpec.makeMeasureSpec(AndroidUtilities.dp(56f), MeasureSpec.EXACTLY)
+            )
+        }
+
+        override fun dispatchDraw(canvas: Canvas) {
+            super.dispatchDraw(canvas)
+            val size = AndroidUtilities.dp(28f)
+            val left = AndroidUtilities.dp(22f)
+            icon.setBounds(left, (height - size) / 2, left + size, (height + size) / 2)
+            icon.draw(canvas)
+            if (line) {
+                canvas.drawLine(AndroidUtilities.dp(72f).toFloat(), height - 1f, width.toFloat(), height - 1f, Theme.dividerPaint)
+            }
+        }
+
+        override fun onAttachedToWindow() {
+            super.onAttachedToWindow()
+            icon.attach()
+        }
+
+        override fun onDetachedFromWindow() {
+            super.onDetachedFromWindow()
+            icon.detach()
+        }
+    }
+
+    private inner class Adapter(private val context: Context) : RecyclerListView.SelectionAdapter() {
+
+        override fun getItemCount(): Int = rows.size
+
+        override fun isEnabled(holder: RecyclerView.ViewHolder): Boolean {
+            val type = rows.getOrNull(holder.adapterPosition)?.type ?: return false
+            return type == TYPE_REACTION || type == TYPE_ADD || type == TYPE_COUNT || type == TYPE_RESET
+        }
+
+        override fun getItemViewType(position: Int): Int = rows[position].type
+
+        override fun onCreateViewHolder(parent: ViewGroup, viewType: Int): RecyclerView.ViewHolder {
+            val view: View = when (viewType) {
+                TYPE_HEADER -> HeaderCell(context)
+                TYPE_INFO -> TextInfoPrivacyCell(context)
+                TYPE_REACTION -> ReactionRow(context)
+                else -> TextSettingsCell(context)
+            }
+            view.layoutParams = RecyclerView.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT)
+            return RecyclerListView.Holder(view)
+        }
+
+        override fun onBindViewHolder(holder: RecyclerView.ViewHolder, position: Int) {
+            val row = rows[position]
+            val view = holder.itemView
+            when (row.type) {
+                TYPE_HEADER -> (view as HeaderCell).setText(lc(if (row.index == 0) "Order" else "Shown in the strip"))
+                TYPE_INFO -> (view as TextInfoPrivacyCell).setText(
+                    when (row.index) {
+                        0 -> lc(
+                            if (UserConfig.getInstance(currentAccount).isPremium) "Tap a reaction to pin or replace it, drag the handle to move it. Pinned ones keep their place in every message menu, the rest keep the chat's order."
+                            else "Tap a reaction to pin or replace it, drag the handle to move it. Custom emoji reactions need Telegram Premium."
+                        )
+                        1 -> lc("How many reactions sit above the message menu. Auto keeps Telegram's number.")
+                        else -> ""
+                    }
+                )
+                TYPE_REACTION -> (view as ReactionRow).bind(shown[row.index], shown[row.index] in pins, true)
+                else -> {
+                    val cell = view as TextSettingsCell
+                    cell.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
+                    when (row.type) {
+                        TYPE_ADD -> cell.setText(lc("Pin a reaction"), false)
+                        TYPE_COUNT -> cell.setTextAndValue(lc("Reactions in the strip"), countLabel(), false)
+                        else -> {
+                            cell.setText(lc("Reset the order"), false)
+                            cell.setTextColor(Theme.getColor(Theme.key_text_RedRegular))
+                            cell.alpha = if (pins.isEmpty()) 0.5f else 1f
+                        }
+                    }
+                    if (row.type != TYPE_RESET) cell.alpha = 1f
+                }
+            }
+        }
+    }
+
+    private fun lc(text: String): String = TeleLowercase.lc(text)
+
+    companion object {
+        const val MODE_REACTIONS = "reactions_strip"
+
+        private const val TYPE_HEADER = 0
+        private const val TYPE_REACTION = 1
+        private const val TYPE_ADD = 2
+        private const val TYPE_INFO = 3
+        private const val TYPE_COUNT = 4
+        private const val TYPE_RESET = 5
+
+        @JvmStatic
+        fun summary(): String {
+            val count = ReactionStrip.validCount(TeleConfig.REACTIONS_STRIP_COUNT.value)
+            val pinned = ReactionStrip.pinnedCount(ReactionStrip.pinned(UserConfig.selectedAccount))
+            val shown = if (count == 0) "Auto" else count.toString()
+            return if (pinned > 0) "$shown, $pinned pinned" else shown
+        }
+    }
+}
