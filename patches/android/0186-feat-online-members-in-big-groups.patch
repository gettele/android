diff --git a/TMessagesProj/src/main/java/tele/helpers/GroupOnlines.kt b/TMessagesProj/src/main/java/tele/helpers/GroupOnlines.kt
new file mode 100644
index 000000000..078046048
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/GroupOnlines.kt
@@ -0,0 +1,12 @@
+package tele.helpers
+
+import org.telegram.tgnet.TLRPC
+import tele.TeleConfig
+
+/** Small groups with a hidden member list have no local count, so the server's one is used. */
+object GroupOnlines {
+
+    @JvmStatic
+    fun serverCount(info: TLRPC.ChatFull?): Boolean =
+        TeleConfig.ONLINE_IN_BIG_GROUPS.value && info is TLRPC.TL_channelFull && info.participants_count <= 200 && info.participants == null
+}
