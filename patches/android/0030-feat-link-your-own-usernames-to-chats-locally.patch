diff --git a/TMessagesProj/src/main/java/tele/helpers/Aliases.kt b/TMessagesProj/src/main/java/tele/helpers/Aliases.kt
new file mode 100644
index 000000000..2bb95300a
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/Aliases.kt
@@ -0,0 +1,173 @@
+package tele.helpers
+
+import org.json.JSONObject
+import org.telegram.tgnet.TLRPC
+import tele.TeleConfig
+import tele.db.TeleDatabaseHelper
+
+object Aliases {
+
+    private const val KEY = "username_aliases"
+    private const val MAX_LENGTH = 32
+    private val map = HashMap<String, Long>()
+    private var loaded = false
+
+    private fun entryKey(account: Int, alias: String) = "$account:${alias.lowercase()}"
+
+    private fun ensureLoaded(account: Int) {
+        if (loaded) return
+        loaded = true
+        TeleDatabaseHelper.get("$KEY:$account")?.let { raw ->
+            runCatching {
+                val json = JSONObject(raw)
+                for (k in json.keys()) {
+                    map[entryKey(account, k)] = json.getLong(k)
+                }
+            }
+        }
+    }
+
+    private fun save(account: Int) {
+        val json = JSONObject()
+        map.forEach { (key, id) ->
+            if (key.startsWith("$account:")) {
+                json.put(key.substring(account.toString().length + 1), id)
+            }
+        }
+        TeleDatabaseHelper.put("$KEY:$account", json.toString())
+    }
+
+    @JvmStatic
+    fun isValid(alias: String?): Boolean {
+        if (alias.isNullOrEmpty() || alias.length > MAX_LENGTH) return false
+        if (!alias[0].isLetter()) return false
+        return alias.all { it.isLetterOrDigit() || it == '_' }
+    }
+
+    @JvmStatic
+    fun dialogId(account: Int, alias: String?): Long {
+        if (alias.isNullOrEmpty() || !TeleConfig.USERNAME_ALIASES.value) return 0
+        synchronized(map) {
+            ensureLoaded(account)
+            return map[entryKey(account, alias)] ?: 0
+        }
+    }
+
+    @JvmStatic
+    fun set(account: Int, alias: String, dialogId: Long) {
+        synchronized(map) {
+            ensureLoaded(account)
+            map[entryKey(account, alias)] = dialogId
+            save(account)
+        }
+    }
+
+    @JvmStatic
+    fun remove(account: Int, alias: String) {
+        synchronized(map) {
+            ensureLoaded(account)
+            map.remove(entryKey(account, alias))
+            save(account)
+        }
+    }
+
+    @JvmStatic
+    fun aliasOf(account: Int, dialogId: Long): String? {
+        if (!TeleConfig.USERNAME_ALIASES.value) return null
+        synchronized(map) {
+            ensureLoaded(account)
+            val prefix = "$account:"
+            return map.entries.firstOrNull { it.value == dialogId && it.key.startsWith(prefix) }
+                ?.key?.substring(prefix.length)
+        }
+    }
+
+    @JvmStatic
+    fun replaceForSend(account: Int, message: Array<CharSequence?>, entities: MutableList<TLRPC.MessageEntity>?) {
+        if (!TeleConfig.USERNAME_ALIASES.value) return
+        val original = message[0] ?: return
+        val mentions = ArrayList<TLRPC.MessageEntity>()
+        var result: String? = null
+        var added = 0
+        val text = original.toString()
+        var i = 0
+        while (i < text.length) {
+            if (text[i] == '@' && (i == 0 || !isNameChar(text[i - 1]))) {
+                var j = i + 1
+                while (j < text.length && isNameChar(text[j])) j++
+                val alias = text.substring(i + 1, j)
+                val did = dialogId(account, alias)
+                if (did != 0L) {
+                    val shift = if (result == null) 0 else added
+                    if (did > 0) {
+                        mentions.add(TLRPC.TL_messageEntityMentionName().also {
+                            it.user_id = did
+                            it.offset = i + shift
+                            it.length = j - i
+                        })
+                    } else {
+                        val chat = org.telegram.messenger.MessagesController.getInstance(account).getChat(-did)
+                        val username = org.telegram.messenger.ChatObject.getPublicUsername(chat)
+                        if (username != null) {
+                            val replacement = "@$username"
+                            result = result ?: text
+                            result = result.substring(0, i + shift) + replacement + result.substring(j + shift)
+                            added += replacement.length - (j - i)
+                            mentions.add(TLRPC.TL_messageEntityMentionName().also {
+                                it.offset = i + shift
+                                it.length = replacement.length
+                                it.user_id = 0
+                            })
+                        }
+                    }
+                }
+                i = j
+            } else {
+                i++
+            }
+        }
+        if (mentions.isEmpty()) return
+        message[0] = result ?: original
+        entities?.addAll(mentions)
+    }
+
+    @JvmStatic
+    fun matchingPeers(account: Int, query: String): List<android.util.Pair<String, Long>> {
+        if (!TeleConfig.USERNAME_ALIASES.value || query.isEmpty()) return emptyList()
+        val q = query.lowercase()
+        val out = ArrayList<android.util.Pair<String, Long>>()
+        synchronized(map) {
+            ensureLoaded(account)
+            map.forEach { (key, id) ->
+                if (!key.startsWith("$account:")) return@forEach
+                val alias = key.substring(account.toString().length + 1)
+                if (alias.startsWith(q) && alias.length > q.length) {
+                    out.add(android.util.Pair(alias, id))
+                }
+            }
+        }
+        out.sortBy { it.first }
+        return out
+    }
+
+    @JvmStatic
+    fun findAll(text: CharSequence): List<String> {
+        val out = ArrayList<String>()
+        val value = text.toString()
+        var i = 0
+        while (i < value.length) {
+            if (value[i] == '@' && (i == 0 || !isNameChar(value[i - 1]))) {
+                var j = i + 1
+                while (j < value.length && isNameChar(value[j])) j++
+                val alias = value.substring(i + 1, j)
+                if (isValid(alias)) out.add(alias)
+                i = j
+            } else {
+                i++
+            }
+        }
+        return out
+    }
+
+    private fun isNameChar(c: Char) = c.isLetterOrDigit() || c == '_'
+}
