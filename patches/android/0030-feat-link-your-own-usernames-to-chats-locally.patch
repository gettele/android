+    private String teleAliasName(String url) {
+        String value = url;
+        final int at = value.indexOf('@');
+        if (at >= 0) {
+            value = value.substring(at + 1);
+        }
+        final int slash = value.indexOf('/');
+        if (slash > 0) {
+            value = value.substring(0, slash);
+        }
+        final int query = value.indexOf('?');
+        if (query > 0) {
+            value = value.substring(0, query);
+        }
+        return value;
+    }
+
+    private long teleAliasPeerForUrl(String url) {
+        final String name = teleAliasName(url).toLowerCase();
+        if (name.isEmpty() || !tele.helpers.Aliases.isValid(name)) {
+            return 0;
+        }
+        return tele.helpers.Aliases.dialogId(currentAccount, name);
+    }
