+    private void showTeleChatAliasDialog() {
+        final android.app.Activity activity = getParentActivity();
+        if (activity == null || currentChat == null) {
+            return;
+        }
+        final long did = getDialogId();
+        final String current = tele.helpers.Aliases.aliasOf(currentAccount, did);
+        android.widget.EditText input = new android.widget.EditText(activity);
+        input.setText(current);
+        input.setSingleLine(true);
+        input.setHint("@alias");
+        android.widget.FrameLayout container = new android.widget.FrameLayout(activity);
+        container.addView(input, new android.widget.FrameLayout.LayoutParams(
+                android.view.ViewGroup.LayoutParams.MATCH_PARENT, android.view.ViewGroup.LayoutParams.WRAP_CONTENT));
+        final int pad = AndroidUtilities.dp(20);
+        container.setPadding(pad, pad / 2, pad, 0);
+        org.telegram.ui.ActionBar.AlertDialog.Builder builder =
+                new org.telegram.ui.ActionBar.AlertDialog.Builder(activity, themeDelegate);
+        builder.setTitle("set an alias for me");
+        builder.setView(container);
+        builder.setPositiveButton(LocaleController.getString(R.string.Save), (di, w) -> {
+            final String alias = input.getText().toString().trim();
+            if (current != null) {
+                tele.helpers.Aliases.remove(currentAccount, current);
+            }
+            if (!alias.isEmpty()) {
+                if (!tele.helpers.Aliases.isValid(alias)) {
+                    android.widget.Toast.makeText(activity, "alias must be letters, digits and underscore, up to 32", android.widget.Toast.LENGTH_SHORT).show();
+                    return;
+                }
+                tele.helpers.Aliases.set(currentAccount, alias, did);
+            }
+        });
+        builder.setNegativeButton(LocaleController.getString(R.string.Cancel), null);
+        showDialog(builder.create());
+    }
