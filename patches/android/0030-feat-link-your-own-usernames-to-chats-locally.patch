@@ -0,0 +1,104 @@
+package tele.helpers
+
+import org.json.JSONObject
+import tele.TeleConfig
+import tele.db.TeleDatabaseHelper
+
+object Aliases {
+
+    private const val KEY = "username_aliases"
+    private const val MAX_LENGTH = 32
+    private val map = HashMap<String, Long>()
+    private var loaded = false
+
+    private fun entryKey(account: Int, alias: String) = "$account:${alias.lowercase()}"
+
+    private fun ensureLoaded(account: Int) {
+        if (loaded) return
+        loaded = true
+        TeleDatabaseHelper.get("$KEY:$account")?.let { raw ->
+            runCatching {
+                val json = JSONObject(raw)
+                for (k in json.keys()) {
+                    map[entryKey(account, k)] = json.getLong(k)
+                }
+            }
+        }
+    }
+
+    private fun save(account: Int) {
+        val json = JSONObject()
+        map.forEach { (key, id) ->
+            if (key.startsWith("$account:")) {
+                json.put(key.substring(account.toString().length + 1), id)
+            }
+        }
+        TeleDatabaseHelper.put("$KEY:$account", json.toString())
+    }
+
+    @JvmStatic
+    fun isValid(alias: String?): Boolean {
+        if (alias.isNullOrEmpty() || alias.length > MAX_LENGTH) return false
+        if (!alias[0].isLetter()) return false
+        return alias.all { it.isLetterOrDigit() || it == '_' }
+    }
+
+    @JvmStatic
+    fun dialogId(account: Int, alias: String?): Long {
+        if (alias.isNullOrEmpty() || !TeleConfig.USERNAME_ALIASES.value) return 0
+        synchronized(map) {
+            ensureLoaded(account)
+            return map[entryKey(account, alias)] ?: 0
+        }
+    }
+
+    @JvmStatic
+    fun set(account: Int, alias: String, dialogId: Long) {
+        synchronized(map) {
+            ensureLoaded(account)
+            map[entryKey(account, alias)] = dialogId
+            save(account)
+        }
+    }
+
+    @JvmStatic
+    fun remove(account: Int, alias: String) {
+        synchronized(map) {
+            ensureLoaded(account)
+            map.remove(entryKey(account, alias))
+            save(account)
+        }
+    }
+
+    @JvmStatic
+    fun aliasOf(account: Int, dialogId: Long): String? {
+        if (!TeleConfig.USERNAME_ALIASES.value) return null
+        synchronized(map) {
+            ensureLoaded(account)
+            val prefix = "$account:"
+            return map.entries.firstOrNull { it.value == dialogId && it.key.startsWith(prefix) }
+                ?.key?.substring(prefix.length)
+        }
+    }
+
+    @JvmStatic
+    fun findAll(text: CharSequence): List<String> {
+        val out = ArrayList<String>()
+        val value = text.toString()
+        var i = 0
+        while (i < value.length) {
+            if (value[i] == '@' && (i == 0 || !isNameChar(value[i - 1]))) {
+                var j = i + 1
+                while (j < value.length && isNameChar(value[j])) j++
+                val alias = value.substring(i + 1, j)
+                if (isValid(alias)) out.add(alias)
+                i = j
+            } else {
+                i++
+            }
+        }
+        return out
+    }
+
+    private fun isNameChar(c: Char) = c.isLetterOrDigit() || c == '_'
+}
