From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Tue, 20 Oct 2026 08:04:40 +0300
Subject: [PATCH 095/128] fix: make invisible stories follow the ghost list

---
 .../main/java/org/telegram/ui/Stories/StoriesController.java    | 2 +-
 .../src/main/java/org/telegram/ui/Stories/StoryViewer.java      | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Stories/StoriesController.java b/TMessagesProj/src/main/java/org/telegram/ui/Stories/StoriesController.java
index 945f57d4e..05bcd7fdc 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Stories/StoriesController.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Stories/StoriesController.java
@@ -1301,7 +1301,7 @@ public class StoriesController {
             if (!profile) {
                 storiesStorage.updateMaxReadId(dialogId, newReadId);
             }
-            if (!tele.TeleConfig.INVISIBLE_STORIES.getValue()) {
+            if (!tele.TeleConfig.INVISIBLE_STORIES.getValue() && !tele.helpers.PrivacyRules.ghosted(currentAccount, dialogId)) {
                 TL_stories.TL_stories_readStories req = new TL_stories.TL_stories_readStories();
                 req.peer = MessagesController.getInstance(currentAccount).getInputPeer(dialogId);
                 req.max_id = storyItem.id;
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Stories/StoryViewer.java b/TMessagesProj/src/main/java/org/telegram/ui/Stories/StoryViewer.java
index 1e327feb6..a6338ecf3 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Stories/StoryViewer.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Stories/StoryViewer.java
@@ -385,7 +385,7 @@ public class StoryViewer implements NotificationCenter.NotificationCenterDelegat
             doOnAnimationReadyRunnables.clear();
             return;
         }
-        if (tele.TeleConfig.INVISIBLE_STORIES.getValue() && storyItem != null && storyItem.media instanceof TLRPC.TL_messageMediaVideoStream) {
+        if ((tele.TeleConfig.INVISIBLE_STORIES.getValue() || (peerIds != null && !peerIds.isEmpty() && tele.helpers.PrivacyRules.ghosted(currentAccount, peerIds.get(0)))) && storyItem != null && storyItem.media instanceof TLRPC.TL_messageMediaVideoStream) {
             doOnAnimationReadyRunnables.clear();
             return;
         }
