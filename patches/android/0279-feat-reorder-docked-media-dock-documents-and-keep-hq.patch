+    /** Moves one tile one place left or right; the first and last tiles stay put. */
+    internal fun move(key: Key, item: Item, delta: Int) {
+        val tray = trays[key] ?: return
+        val from = tray.items.indexOf(item)
+        if (from < 0) return
+        val to = (from + delta).coerceIn(0, tray.items.size - 1)
+        if (from == to) return
+        tray.items.removeAt(from)
+        tray.items.add(to, item)
+        changed(key)
+    }
+
     internal fun clearTray(key: Key) {
         if (trays.remove(key) != null) changed(key)
     }
@@ -239,6 +254,45 @@ object DockedMedia {
         return true
     }
 
+    /** Documents from the file picker dock like photos: the caption goes to the field and the send button sends them. */
+    @JvmStatic
+    fun dockFiles(
+        fragment: ChatActivity,
+        files: List<String>,
+        caption: CharSequence?,
+        notify: Boolean,
+        scheduleDate: Int,
+        payStars: Long
+    ): Boolean {
+        if (!enabled() || fragment.chatActivityEnterView == null || fragment.chatMode != ChatActivity.MODE_DEFAULT) return false
+        if (fragment.chatActivityEnterView.isEditingMessage) return false
+        if (!notify || scheduleDate != 0 || payStars != 0L || files.isEmpty()) return false
+        if (fragment.messagesController.getSendPaidMessagesStars(fragment.dialogId) != 0L) return false
+        if (!fragment.checkSlowModeAlert()) return false
+        val key = keyOf(fragment)
+        ensureLoaded(key.account)
+        val tray = trays.getOrPut(key) { Tray() }
+        if (tray.items.none { !it.isSticker }) tray.date = (System.currentTimeMillis() / 1000L).toInt()
+        for (path in files) {
+            val file = File(path)
+            if (!file.isFile) continue
+            val item = Item()
+            item.path = file.absolutePath
+            item.fileName = file.name
+            item.size = file.length()
+            item.isFile = true
+            item.imageId = -(tray.items.size + 1)
+            tray.items.add(item)
+        }
+        if (tray.items.isEmpty()) {
+            trays.remove(key)
+            return false
+        }
+        if (!TextUtils.isEmpty(caption)) fragment.chatActivityEnterView.setFieldText(caption)
+        changed(key)
+        return true
+    }
+
     /** A finished file (a shot) joins the tray instead of being sent, like the desktop client's shot box. */
     @JvmStatic
     fun add(fragment: ChatActivity, entry: MediaController.PhotoEntry, asFile: Boolean): Boolean {
