+    @JvmStatic
+    fun cached(query: String): String? {
+        val entry = cache[query] ?: return null
+        if (System.currentTimeMillis() - entry.time > CACHE_LIFETIME) {
+            cache.remove(query)
+            return null
+        }
+        return entry.value
+    }
