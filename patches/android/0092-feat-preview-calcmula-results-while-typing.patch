diff --git a/TMessagesProj/src/main/java/tele/ui/CalcmulaPreview.kt b/TMessagesProj/src/main/java/tele/ui/CalcmulaPreview.kt
new file mode 100644
index 000000000..7bebb4080
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/ui/CalcmulaPreview.kt
@@ -0,0 +1,150 @@
+package tele.ui
+
+import android.content.Context
+import android.graphics.Typeface
+import android.text.Editable
+import android.text.TextUtils
+import android.text.TextWatcher
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.View
+import android.view.ViewGroup
+import android.widget.FrameLayout
+import android.widget.LinearLayout
+import android.widget.TextView
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.AndroidUtilities.dp
+import org.telegram.messenger.LiteMode
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.ChatActivity
+import org.telegram.ui.Components.ChatActivityEnterView
+import org.telegram.ui.Components.LayoutHelper
+import tele.TeleConfig
+import tele.helpers.Calcmula
+
+class CalcmulaPreview private constructor(
+    context: Context,
+    private val fragment: ChatActivity,
+    private val enterView: ChatActivityEnterView
+) : FrameLayout(context) {
+
+    private enum class State { VALUE, PENDING, ERROR }
+
+    private val title = TextView(context)
+    private val description = TextView(context)
+    private var currentQuery = ""
+    private var requestId = 0
+    private val debounce = Runnable { request() }
+
+    init {
+        visibility = GONE
+        elevation = dp(2f).toFloat()
+        background = Theme.createRoundRectDrawable(dp(12f), fragment.getThemedColor(Theme.key_chat_messagePanelBackground))
+        isClickable = true
+        setOnClickListener { if (allowed()) enterView.sendMessage() }
+
+        val badge = TextView(context)
+        badge.text = "="
+        badge.gravity = Gravity.CENTER
+        badge.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 20f)
+        badge.typeface = AndroidUtilities.bold()
+        badge.setTextColor(fragment.getThemedColor(Theme.key_featuredStickers_buttonText))
+        badge.background = Theme.createRoundRectDrawable(dp(8f), fragment.getThemedColor(Theme.key_featuredStickers_addButton))
+        addView(badge, LayoutHelper.createFrame(36, 36f, Gravity.LEFT or Gravity.CENTER_VERTICAL, 12f, 0f, 0f, 0f))
+
+        val texts = LinearLayout(context)
+        texts.orientation = LinearLayout.VERTICAL
+        title.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16f)
+        title.typeface = AndroidUtilities.bold()
+        title.isSingleLine = true
+        title.ellipsize = TextUtils.TruncateAt.END
+        description.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13f)
+        description.setTextColor(fragment.getThemedColor(Theme.key_chat_messagePanelHint))
+        description.isSingleLine = true
+        description.ellipsize = TextUtils.TruncateAt.END
+        texts.addView(title, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT))
+        texts.addView(description, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT))
+        addView(texts, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT.toFloat(), Gravity.CENTER_VERTICAL, 60f, 12f, 12f, 12f))
+
+        enterView.addTextChangedListener(object : TextWatcher {
+            override fun beforeTextChanged(s: CharSequence?, start: Int, count: Int, after: Int) = Unit
+            override fun onTextChanged(s: CharSequence?, start: Int, before: Int, count: Int) = Unit
+            override fun afterTextChanged(s: Editable?) = refresh(s)
+        })
+    }
+
+    private fun allowed(): Boolean =
+        TeleConfig.CALCMULA.value && TeleConfig.CALCMULA_PREVIEW.value &&
+            enterView.visibility == VISIBLE && !enterView.isEditingMessage && !enterView.isRecordingAudioVideo
+
+    private fun refresh(text: CharSequence?) {
+        val query = Calcmula.query(text)
+        if (query.isEmpty() || !allowed()) {
+            cancel()
+            return
+        }
+        if (query == currentQuery) return
+        currentQuery = query
+        requestId++
+        AndroidUtilities.cancelRunOnUIThread(debounce)
+        description.text = query.replace('\n', ' ')
+        val cached = Calcmula.cached(query)
+        if (cached != null) {
+            apply(cached, State.VALUE)
+            return
+        }
+        AndroidUtilities.runOnUIThread(debounce, 350)
+        if (visibility == VISIBLE) paint(State.PENDING)
+    }
+
+    private fun request() {
+        val id = requestId
+        Calcmula.compute(currentQuery) { result ->
+            if (id != requestId || !isAttachedToWindow) return@compute
+            if (result.value != null) apply(result.value, State.VALUE)
+            else apply((result.error ?: "unknown error").lowercase(), State.ERROR)
+        }
+    }
+
+    private fun apply(text: String, state: State) {
+        title.text = text
+        paint(state)
+        show(true)
+    }
+
+    private fun paint(state: State) {
+        val key = when (state) {
+            State.VALUE -> Theme.key_chat_messagePanelText
+            State.PENDING -> Theme.key_chat_messagePanelHint
+            State.ERROR -> Theme.key_text_RedRegular
+        }
+        title.setTextColor(fragment.getThemedColor(key))
+    }
+
+    private fun cancel() {
+        AndroidUtilities.cancelRunOnUIThread(debounce)
+        requestId++
+        currentQuery = ""
+        if (visibility == VISIBLE) show(false)
+    }
+
+    private fun show(visible: Boolean) {
+        AndroidUtilities.updateViewShow(this, visible, false, LiteMode.isEnabled(LiteMode.FLAG_CHAT_SCALE))
+    }
+
+    override fun onDetachedFromWindow() {
+        super.onDetachedFromWindow()
+        cancel()
+    }
+
+    companion object {
+        @JvmStatic
+        fun attach(fragment: ChatActivity, content: ViewGroup, enterView: ChatActivityEnterView, below: View?): CalcmulaPreview? {
+            if (!TeleConfig.CALCMULA.value || !TeleConfig.CALCMULA_PREVIEW.value) return null
+            val view = CalcmulaPreview(content.context, fragment, enterView)
+            val index = below?.let { content.indexOfChild(it) } ?: -1
+            content.addView(view, index, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT.toFloat(), Gravity.BOTTOM or Gravity.LEFT, 10f, 0f, 10f, 0f))
+            return view
+        }
+    }
+}
