 .../src/main/java/tele/TeleConfig.kt          |  2 ++
 .../tele/ui/settings/TeleSettingsActivity.kt  |  3 ++-
 .../src/main/res/values/strings_tele.xml      |  1 +
 6 files changed, 69 insertions(+), 1 deletion(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Cells/ChatMessageCell.java b/TMessagesProj/src/main/java/org/telegram/ui/Cells/ChatMessageCell.java
index 6b45401b4..dc2e01de5 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Cells/ChatMessageCell.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Cells/ChatMessageCell.java
@@ -1135,6 +1135,28 @@ public class ChatMessageCell extends BaseCell implements SeekBar.SeekBarDelegate
         return lastTouchY;
     }
 
+    public long tele_emojiIdAt(float x, float y) {
+        final long fromStack = tele_emojiIdIn(animatedEmojiStack, x, y);
+        if (fromStack != 0) {
+            return fromStack;
+        }
+        return tele_emojiIdIn(animatedEmojiDescriptionStack, x, y);
+    }
+
+    private long tele_emojiIdIn(AnimatedEmojiSpan.EmojiGroupedSpans spans, float x, float y) {
+        if (spans == null) {
+            return 0;
+        }
+        for (int i = 0; i < spans.holders.size(); i++) {
+            AnimatedEmojiSpan.AnimatedEmojiHolder holder = spans.holders.get(i);
+            final Rect bounds = holder.drawableBounds;
+            if (holder.span != null && bounds != null && bounds.contains((int) x, (int) y)) {
+                return holder.span.getDocumentId();
+            }
+        }
+        return 0;
+    }
+
     private boolean drawMediaCheckBox;
     private boolean drawSelectionBackground;
     private CheckBoxBase mediaCheckBox;
