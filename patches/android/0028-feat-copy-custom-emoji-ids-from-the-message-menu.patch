             Row(TYPE_TOGGLE, "show message id in the message menu", item = TeleConfig.MESSAGE_ID_MENU),
             Row(TYPE_TOGGLE, "show gift id", item = TeleConfig.SHOW_GIFT_IDS),
             Row(TYPE_TOGGLE, "show ids on regular gifts", item = TeleConfig.SHOW_REGULAR_GIFT_IDS)
