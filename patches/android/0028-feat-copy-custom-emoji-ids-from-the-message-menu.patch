     val SHOW_GIFT_IDS = BoolItem("show_gift_ids", false)
     @JvmField
     val SHOW_REGULAR_GIFT_IDS = BoolItem("show_regular_gift_ids", false)
+    @JvmField
+    val COPY_EMOJI_ID = BoolItem("copy_emoji_id", false)
 
     private var prefs: SharedPreferences? = null
 
