         MessageObject primaryMessage,
 
@@ -45905,6 +45915,14 @@ public class ChatActivity extends BaseFragment implements
         final boolean isEphemeral = message.isEphemeral();
         final boolean isEphemeralFromBot = isEphemeral && !message.isOut();
 
+        final long pressedEmojiId = tele_pressedEmojiId;
+        tele_pressedEmojiId = 0;
+        tele_menuEmojiId = pressedEmojiId;
+        if (tele.TeleConfig.COPY_EMOJI_ID.getValue() && pressedEmojiId != 0) {
+            items.add(0, "copy emoji ID");
