From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Sat, 3 Oct 2026 21:43:39 +0300
Subject: [PATCH] feat: copy custom emoji ids from the message menu

---
 .../telegram/ui/Cells/ChatMessageCell.java    | 22 +++++++++++++++++++
 .../java/org/telegram/ui/ChatActivity.java    | 18 +++++++++++++++
 .../src/main/java/tele/TeleConfig.kt          |  2 ++
 .../tele/ui/settings/TeleSettingsActivity.kt  |  1 +
 .../src/main/res/values/strings_tele.xml      |  1 +
 5 files changed, 44 insertions(+)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Cells/ChatMessageCell.java b/TMessagesProj/src/main/java/org/telegram/ui/Cells/ChatMessageCell.java
index 006e5ddcf..0aea5cb01 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Cells/ChatMessageCell.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Cells/ChatMessageCell.java
@@ -1135,6 +1135,28 @@ public class ChatMessageCell extends BaseCell implements SeekBar.SeekBarDelegate
         return lastTouchY;
     }
 
+    public long tele_emojiIdAt(float x, float y) {
+        final long fromStack = tele_emojiIdIn(animatedEmojiStack, x, y);
+        if (fromStack != 0) {
+            return fromStack;
+        }
+        return tele_emojiIdIn(animatedEmojiDescriptionStack, x, y);
+    }
+
+    private long tele_emojiIdIn(AnimatedEmojiSpan.EmojiGroupedSpans spans, float x, float y) {
+        if (spans == null) {
+            return 0;
+        }
+        for (int i = 0; i < spans.holders.size(); i++) {
+            AnimatedEmojiSpan.AnimatedEmojiHolder holder = spans.holders.get(i);
+            final Rect bounds = holder.drawableBounds;
+            if (holder.span != null && bounds != null && bounds.contains((int) x, (int) y)) {
+                return holder.span.getDocumentId();
+            }
+        }
+        return 0;
+    }
+
     private boolean drawMediaCheckBox;
     private boolean drawSelectionBackground;
     private CheckBoxBase mediaCheckBox;
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
index 0287054a7..d045f8092 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
@@ -1230,6 +1230,7 @@ public class ChatActivity extends BaseFragment implements
     public final static int OPTION_VIEW_IN_TOPIC = 32;
     public final static int tele_option_mark_viewed = 117;
     public final static int tele_option_copy_msg_id = 118;
+    public final static int tele_option_copy_emoji_id = 119;
     public final static int OPTION_ABOUT_REVENUE_SHARING_ADS = 33;
     public final static int OPTION_REPORT_AD = 34;
     public final static int OPTION_REMOVE_ADS = 35;
@@ -30731,6 +30732,7 @@ public class ChatActivity extends BaseFragment implements
             factCheckHint.hide(false);
         }
         FileLog.d("open menu msg_id=" + message.getId() + (message.getDocument() != null ? " doc_id=" + message.getDocument().id : ""));
+        tele_pressedEmojiId = v instanceof ChatMessageCell ? ((ChatMessageCell) v).tele_emojiIdAt(x, y) : 0;
         final int type = getMessageType(message);
         if (single) {
             boolean isGiveawayResultsMessage = false;
@@ -33396,6 +33398,11 @@ public class ChatActivity extends BaseFragment implements
                 BulletinFactory.of(this).createCopyBulletin(getString(R.string.TeleMessageIdCopied)).show();
                 break;
             }
+            case tele_option_copy_emoji_id: {
+                AndroidUtilities.addToClipboard(String.valueOf(tele_menuEmojiId));
+                BulletinFactory.of(this).createCopyBulletin(getString(R.string.TeleEmojiIdCopied)).show();
+                break;
+            }
             case OPTION_COPY: {
                 final TL_iv.RichMessage copyRichMessage = selectedObject.messageOwner != null ? selectedObject.messageOwner.rich_message : null;
                 if (selectedObject.isDice()) {
@@ -45697,6 +45704,9 @@ public class ChatActivity extends BaseFragment implements
         return -1;
     }
 
+    private long tele_pressedEmojiId;
+    private long tele_menuEmojiId;
+
     public void fillMessageMenu(
         MessageObject primaryMessage,
 
@@ -45710,6 +45720,14 @@ public class ChatActivity extends BaseFragment implements
         final boolean isEphemeral = message.isEphemeral();
         final boolean isEphemeralFromBot = isEphemeral && !message.isOut();
 
+        final long pressedEmojiId = tele_pressedEmojiId;
+        tele_pressedEmojiId = 0;
+        tele_menuEmojiId = pressedEmojiId;
+        if (tele.TeleConfig.COPY_EMOJI_ID.getValue() && pressedEmojiId != 0) {
+            items.add(0, "copy emoji ID");
+            options.add(0, tele_option_copy_emoji_id);
+            icons.add(0, R.drawable.msg_copy);
+        }
         if (tele.TeleConfig.MESSAGE_ID_MENU.getValue() && message.getId() > 0) {
             items.add(0, "ID: " + message.getId());
             options.add(0, tele_option_copy_msg_id);
diff --git a/TMessagesProj/src/main/java/tele/TeleConfig.kt b/TMessagesProj/src/main/java/tele/TeleConfig.kt
index c88fec42e..f42301d30 100644
