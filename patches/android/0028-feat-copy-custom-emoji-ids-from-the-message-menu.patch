From: tangenx <me@tangenx.dev>
Date: Sat, 3 Oct 2026 21:43:39 +0300
Subject: [PATCH] feat: copy custom emoji ids from the message menu

---
 .../telegram/ui/Cells/ChatMessageCell.java    | 44 +++++++++++++++++++
 .../java/org/telegram/ui/ChatActivity.java    | 18 ++++++++
 .../src/main/java/tele/TeleConfig.kt          |  2 +
 .../tele/ui/settings/TeleSettingsActivity.kt  |  1 +
 .../src/main/res/values/strings_tele.xml      |  1 +
 5 files changed, 66 insertions(+)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Cells/ChatMessageCell.java b/TMessagesProj/src/main/java/org/telegram/ui/Cells/ChatMessageCell.java
index 006e5ddcf..edddbf78b 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Cells/ChatMessageCell.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Cells/ChatMessageCell.java
@@ -1135,6 +1135,50 @@ public class ChatMessageCell extends BaseCell implements SeekBar.SeekBarDelegate
         return lastTouchY;
     }
 
+    public long tele_emojiIdAt(float x, float y) {
+        if (currentMessageObject == null || currentMessageObject.textLayoutBlocks == null) {
+            return 0;
+        }
+        long id = tele_emojiIdInLayout(currentMessageObject.messageText, currentMessageObject.textLayoutBlocks, textX, textY, currentMessageObject.textWidth, currentMessageObject.textHeight(transitionParams), x, y);
+        if (id == 0 && captionLayout != null && captionLayout.textLayoutBlocks != null) {
+            id = tele_emojiIdInLayout(currentCaption, captionLayout.textLayoutBlocks, captionX, captionY, captionLayout.textWidth, captionLayout.textHeight(transitionParams), x, y);
+        }
+        return id;
+    }
+
+    private long tele_emojiIdInLayout(CharSequence text, ArrayList<MessageObject.TextLayoutBlock> blocks, float offsetX, float offsetY, float width, float height, float x, float y) {
+        if (!(text instanceof Spannable)) {
+            return 0;
+        }
+        if (x < offsetX || y < offsetY || x > offsetX + width || y > offsetY + height) {
+            return 0;
+        }
+        int blockNum = 0;
+        for (int a = 0; a < blocks.size(); a++) {
+            if (blocks.get(a).textYOffset(blocks, transitionParams) > y - offsetY) {
+                break;
+            }
+            blockNum = a;
+        }
+        try {
+            MessageObject.TextLayoutBlock block = blocks.get(blockNum);
+            float bx = x - offsetX - (block.isRtl() ? currentMessageObject.textXOffset : 0);
+            float by = y - offsetY - block.textYOffset(blocks, transitionParams);
+            int line = block.textLayout.getLineForVertical((int) by);
+            int off = block.charactersOffset + block.textLayout.getOffsetForHorizontal(line, bx);
+            float left = block.textLayout.getLineLeft(line);
+            if (left <= bx && left + block.textLayout.getLineWidth(line) >= bx) {
+                CharacterStyle[] spans = ((Spannable) text).getSpans(off, off, AnimatedEmojiSpan.class);
+                if (spans.length > 0 && spans[0] instanceof AnimatedEmojiSpan) {
+                    return ((AnimatedEmojiSpan) spans[0]).getDocumentId();
+                }
+            }
+        } catch (Exception e) {
+            FileLog.e(e);
+        }
+        return 0;
+    }
+
     private boolean drawMediaCheckBox;
     private boolean drawSelectionBackground;
     private CheckBoxBase mediaCheckBox;
