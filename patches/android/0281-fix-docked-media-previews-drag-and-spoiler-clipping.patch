         scroll.setOnScrollChangeListener { _, _, _, _, _ -> invalidate() }
         row.orientation = LinearLayout.HORIZONTAL
         row.setPadding(0, 0, AndroidUtilities.dp(4f), 0)
+        setOnDragListener { _, event ->
+            when (event.action) {
+                android.view.DragEvent.ACTION_DRAG_STARTED -> event.localState is DockedMedia.Item
+                android.view.DragEvent.ACTION_DROP -> {
+                    val item = event.localState as? DockedMedia.Item
+                    if (item != null) {
+                        val localX = event.x - scroll.left + scroll.scrollX - row.left
+                        val target = dragTarget(localX)
+                        val from = DockedMedia.tray(key)?.items?.indexOf(item) ?: -1
+                        if (target >= 0 && target != from) {
+                            DockedMedia.moveTo(key, item, target)
+                        } else if (from >= 0) {
+                            val source = row.getChildAt(from)
+                            val left = if (source != null) scroll.left - scroll.scrollX + row.left + source.left else 0
+                            val right = if (source != null) left + source.width else 0
+                            if (localX < left - AndroidUtilities.dp(4f) && from > 0) {
+                                DockedMedia.moveTo(key, item, from - 1)
+                            } else if (localX > right + AndroidUtilities.dp(4f)) {
+                                DockedMedia.moveTo(key, item, from + 1)
+                            } else {
+                                AndroidUtilities.runOnUIThread {
+                                    (row.getChildAt(from) as? Tile)?.showMenuFromDrag()
+                                }
+                            }
+                        }
+                    }
+                    true
+                }
+                android.view.DragEvent.ACTION_DRAG_ENDED -> true
+                else -> true
+            }
+        }
         scroll.addView(row, ViewGroup.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.MATCH_PARENT))
         addView(scroll, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.MATCH_PARENT.toFloat(), Gravity.NO_GRAVITY, INSET, 0f, 0f, BAR_SPACE))
