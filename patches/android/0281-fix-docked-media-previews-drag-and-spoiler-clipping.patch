diff --git a/TMessagesProj/src/main/java/tele/helpers/DockedMedia.kt b/TMessagesProj/src/main/java/tele/helpers/DockedMedia.kt
index 32aa039c9..6da3f8bef 100644
--- a/TMessagesProj/src/main/java/tele/helpers/DockedMedia.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/DockedMedia.kt
@@ -132,6 +132,18 @@ object DockedMedia {
         changed(key)
     }
 
+    /** Moves one tile to an absolute position; the picked position is clamped to the tray. */
+    internal fun moveTo(key: Key, item: Item, target: Int) {
+        val tray = trays[key] ?: return
+        val from = tray.items.indexOf(item)
+        if (from < 0) return
+        val to = target.coerceIn(0, tray.items.size - 1)
+        if (from == to) return
+        tray.items.removeAt(from)
+        tray.items.add(to, item)
+        changed(key)
+    }
+
     /** Moves one tile one place left or right; the first and last tiles stay put. */
     internal fun move(key: Key, item: Item, delta: Int) {
         val tray = trays[key] ?: return
