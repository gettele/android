+    private fun dragTarget(x: Float): Int {
+        val tray = DockedMedia.tray(key) ?: return -1
+        for (i in 0 until minOf(row.childCount, tray.items.size)) {
+            val child = row.getChildAt(i)
+            if (x >= child.left && x <= child.right) return i
+        }
+        return -1
+    }
