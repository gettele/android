+package tele.helpers
+
+import android.graphics.Bitmap
+import android.graphics.BitmapFactory
+import android.graphics.Canvas
+import android.graphics.drawable.BitmapDrawable
+import org.json.JSONArray
+import org.json.JSONObject
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.ApplicationLoader
+import org.telegram.messenger.FileLog
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.R
+import org.telegram.messenger.UserConfig
+import org.telegram.messenger.Utilities
+import org.telegram.tgnet.TLRPC
+import org.telegram.ui.ActionBar.BaseFragment
+import org.telegram.ui.ActionBar.BottomSheet
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.ChatActivity
+import org.telegram.ui.Components.MotionBackgroundDrawable
+import org.telegram.ui.LaunchActivity
+import org.telegram.ui.WallpapersListActivity
+import tele.TeleConfig
+import tele.db.TeleDatabaseHelper
+import java.io.File
+import java.io.FileOutputStream
+
+/**
+ * Chat backgrounds that only this device shows. They never go to Telegram: a stored entry
+ * replaces the chat's own theme and wallpaper, an entry without a picture means "use my own
+ * default background" and hides the one the other side set.
+ */
+object LocalBackgrounds {
+
+    private const val FOLDER = "tele_backgrounds"
+    private const val JPEG_QUALITY = 90
+
+    class Entry(
+        @JvmField val none: Boolean,
+        val file: String?,
+        val colors: IntArray,
+        val rotation: Int,
+        val intensity: Int,
+        val motion: Boolean,
+        val average: Int
+    ) {
+        // built once: the chat compares wallpapers by path or id, a new object per call would restart the load
+        @Volatile
+        var wallpaper: TLRPC.WallPaper? = null
+    }
+
+    private class State {
+        val map = HashMap<Long, Entry>()
+        var loaded = false
+    }
+
+    private val states = arrayOfNulls<State>(UserConfig.MAX_ACCOUNT_COUNT)
+
+    private fun key(account: Int) = "local_backgrounds.$account"
+
+    @JvmStatic
+    fun enabled(): Boolean = TeleConfig.LOCAL_CHAT_BACKGROUNDS.value
+
+    @Synchronized
+    private fun state(account: Int): State {
+        var s = states[account]
+        if (s == null) {
+            s = State()
+            states[account] = s
+        }
+        if (!s.loaded) {
+            s.loaded = true
+            decode(TeleDatabaseHelper.get(key(account)), s.map)
+        }
+        return s
+    }
+
+    private fun decode(raw: String?, into: HashMap<Long, Entry>) {
+        if (raw.isNullOrEmpty()) return
+        runCatching {
+            val data = JSONObject(raw).getJSONObject("d")
+            for (dialog in data.keys()) {
+                val o = data.getJSONObject(dialog)
+                val colors = IntArray(4)
+                val array = o.optJSONArray("c")
+                if (array != null) for (i in 0 until minOf(4, array.length())) colors[i] = array.getInt(i)
+                into[dialog.toLong()] = Entry(
+                    o.optInt("n", 0) != 0,
+                    o.optString("f").ifEmpty { null },
+                    colors,
+                    o.optInt("r", 45),
+                    o.optInt("i", 0),
+                    o.optInt("m", 0) != 0,
+                    o.optInt("a", 0)
+                )
+            }
+        }.onFailure { FileLog.e(it) }
+    }
+
+    private fun encode(map: Map<Long, Entry>): String? {
+        if (map.isEmpty()) return null
+        val data = JSONObject()
+        for ((dialog, e) in map) {
+            val o = JSONObject()
+            if (e.none) {
+                o.put("n", 1)
+            } else {
+                if (e.file != null) o.put("f", e.file)
+                o.put("c", JSONArray().apply { e.colors.forEach { put(it) } })
+                o.put("r", e.rotation)
+                o.put("i", e.intensity)
+                o.put("m", if (e.motion) 1 else 0)
+                o.put("a", e.average)
+            }
+            data.put(dialog.toString(), o)
+        }
+        return JSONObject().put("v", 1).put("d", data).toString()
+    }
+
+    private fun folder(): File = ApplicationLoader.getFilesDirFixed(FOLDER)
+
+    @Synchronized
+    private fun entry(account: Int, dialogId: Long): Entry? {
+        if (account !in states.indices) return null
+        return state(account).map[dialogId]
+    }
+
+    /** Whether the chat shows a background of this device instead of its own. */
+    @JvmStatic
+    fun has(account: Int, dialogId: Long): Boolean = enabled() && entry(account, dialogId) != null
+
+    /** The wallpaper the chat draws; null for "my default background". */
+    @JvmStatic
+    fun wallpaper(account: Int, dialogId: Long): TLRPC.WallPaper? {
+        if (!enabled()) return null
+        val e = entry(account, dialogId) ?: return null
+        if (e.none) return null
+        e.wallpaper?.let { return it }
+        synchronized(e) {
+            e.wallpaper?.let { return it }
+            val built = build(e)
+            e.wallpaper = built
+            return built
+        }
+    }
+
+    private fun build(e: Entry): TLRPC.WallPaper {
+        val paper = TLRPC.TL_wallPaperNoFile()
+        val settings = TLRPC.TL_wallPaperSettings()
+        settings.motion = e.motion
+        settings.intensity = e.intensity
+        settings.background_color = e.colors[0]
+        settings.second_background_color = e.colors[1]
+        settings.third_background_color = e.colors[2]
+        settings.fourth_background_color = e.colors[3]
+        settings.rotation = e.rotation
+        paper.settings = settings
+        val path = e.file?.let { File(folder(), it).absolutePath }
+        paper.id = (path ?: e.colors.joinToString()).hashCode().toLong()
+        if (path != null) {
+            paper.uploadingImage = path
+            // a flat placeholder instead of the black one while the picture loads
+            val placeholder = Bitmap.createBitmap(20, 20, Bitmap.Config.ARGB_8888)
+            placeholder.eraseColor(e.average or (0xff shl 24))
+            paper.thumbDrawable = BitmapDrawable(ApplicationLoader.applicationContext.resources, placeholder)
+        }
+        return paper
+    }
+
+    @JvmStatic
+    fun all(account: Int): List<Pair<Long, Boolean>> = synchronized(this) {
+        state(account).map.entries.map { it.key to it.value.none }
+    }
+
+    @JvmStatic
+    fun count(account: Int): Int = synchronized(this) { state(account).map.size }
+
+    /** Puts the entry into memory at once and the storage off the main thread. */
+    private fun commit(account: Int, dialogId: Long, entry: Entry?, oldFile: String?) {
+        val json: String?
+        synchronized(this) {
+            val map = state(account).map
+            if (entry == null) map.remove(dialogId) else map[dialogId] = entry
+            json = encode(map)
+        }
+        Utilities.globalQueue.postRunnable {
+            TeleDatabaseHelper.put(key(account), json)
+            if (oldFile != null && oldFile != entry?.file) File(folder(), oldFile).delete()
+        }
+        AndroidUtilities.runOnUIThread { refreshChats(account, dialogId) }
+    }
+
+    @JvmStatic
+    fun reset(account: Int, dialogId: Long) {
+        val old = entry(account, dialogId) ?: return
+        commit(account, dialogId, null, old.file)
+    }
+
+    @JvmStatic
+    fun setDefault(account: Int, dialogId: Long) {
+        val old = entry(account, dialogId)
+        commit(account, dialogId, Entry(true, null, IntArray(4), 45, 0, false, 0), old?.file)
+    }
+
+    /** The toggle or a stored entry changed: the open chats redraw their background. */
+    @JvmStatic
+    fun onToggled() = refreshChats(-1, 0L)
+
+    // account -1 means every one, dialog 0 means every chat
+    private fun refreshChats(account: Int, dialogId: Long) {
+        val launch = LaunchActivity.instance ?: return
+        val layouts = listOfNotNull(launch.actionBarLayout, launch.rightActionBarLayout, launch.layersActionBarLayout)
+        for (layout in layouts) {
+            for (fragment in ArrayList(layout.fragmentStack)) {
+                if (fragment !is ChatActivity) continue
+                if (account >= 0 && fragment.currentAccount != account) continue
+                if (dialogId != 0L && fragment.dialogId != dialogId) continue
+                fragment.tele_refreshBackground()
+            }
+        }
+    }
+
+    /** The chat menu: pick between the chat's own background, the app one and a picture of your own. */
+    @JvmStatic
+    fun showMenu(fragment: BaseFragment, dialogId: Long) {
+        val activity = fragment.parentActivity ?: return
+        if (!enabled()) return
+        val account = fragment.currentAccount
+        val now = entry(account, dialogId)
+        val mark = " \u2713"
+        val items = arrayOf<CharSequence>(
+            LocaleController.getString(R.string.TeleBackgroundOwn) + if (now == null) mark else "",
+            LocaleController.getString(R.string.TeleBackgroundDefault) + if (now?.none == true) mark else "",
+            LocaleController.getString(R.string.TeleBackgroundChoose) + if (now != null && !now.none) mark else ""
+        )
+        val icons = intArrayOf(R.drawable.msg_reset, R.drawable.msg_clear, R.drawable.msg_background)
+        val builder = BottomSheet.Builder(activity)
+        builder.setTitle(LocaleController.getString(R.string.TeleBackgroundForMe), true)
+        builder.setItems(items, icons) { _, which ->
+            when (which) {
+                0 -> reset(account, dialogId)
+                1 -> setDefault(account, dialogId)
+                else -> choose(fragment, dialogId)
+            }
+        }
+        fragment.showDialog(builder.create())
+    }
+
+    private fun choose(fragment: BaseFragment, dialogId: Long) {
+        val list = WallpapersListActivity(WallpapersListActivity.TYPE_ALL, dialogId)
+        list.tele_setLocal(true)
+        fragment.presentFragment(list)
+    }
+
+    /**
+     * Keeps what the wallpaper preview built for a chat. The picture is copied off the main thread;
+     * [image] is the file the preview wrote, [pattern] tells that it is a pattern over the colors.
+     */
+    @JvmStatic
+    fun save(
+        fragment: BaseFragment,
+        dialogId: Long,
+        info: Theme.OverrideWallpaperInfo,
+        image: File?,
+        pattern: Boolean,
+        cleanup: Boolean
+    ) {
+        val account = fragment.currentAccount
+        closePickers()
+        val old = entry(account, dialogId)?.file
+        val colors = intArrayOf(info.color, info.gradientColor1, info.gradientColor2, info.gradientColor3)
+        val builtIn = Theme.DEFAULT_BACKGROUND_SLUG == info.slug || Theme.THEME_BACKGROUND_SLUG == info.slug
+        val noPicture = image == null && colors.all { it == 0 }
+        if (builtIn || noPicture) {
+            commit(account, dialogId, Entry(true, null, IntArray(4), 45, 0, false, 0), old)
+            if (cleanup) image?.let { Utilities.globalQueue.postRunnable { it.delete() } }
+            return
+        }
+        val rotation = info.rotation
+        val motion = info.isMotion
+        val dim = (info.intensity * 100).toInt().coerceIn(0, 100)
+        Utilities.globalQueue.postRunnable {
+            var name: String? = null
+            var average = 0
+            var intensity = 0
+            var keptColors = colors
+            if (image != null) {
+                val target = "${account}_${Math.abs(dialogId)}_${System.currentTimeMillis()}.jpg"
+                val file = File(folder(), target)
+                val ok = runCatching {
+                    if (pattern && colors[2] != 0) flatten(image, file, colors) else image.copyTo(file, true)
+                    average = averageColor(file)
+                    true
+                }.getOrElse { FileLog.e(it); false }
+                if (cleanup) image.delete()
+                if (!ok) {
+                    file.delete()
+                    AndroidUtilities.runOnUIThread { failed() }
+                    return@postRunnable
+                }
+                name = target
+                // a pattern carries its colors in the picture
+                if (pattern) keptColors = IntArray(4)
+                intensity = if (pattern) 0 else dim
+            }
+            val entry = Entry(false, name, keptColors, rotation, intensity, motion, average)
+            commit(account, dialogId, entry, old)
+        }
+    }
+
+    // a pattern over a moving gradient: the preview file only holds the pattern, so the colors go under it
+    private fun flatten(source: File, target: File, colors: IntArray) {
+        val pattern = BitmapFactory.decodeFile(source.absolutePath) ?: error("pattern")
+        val result = Bitmap.createBitmap(pattern.width, pattern.height, Bitmap.Config.ARGB_8888)
+        val canvas = Canvas(result)
+        val gradient = MotionBackgroundDrawable()
+        gradient.setColors(colors[0], colors[1], colors[2], colors[3])
+        gradient.setBounds(0, 0, result.width, result.height)
+        gradient.draw(canvas)
+        canvas.drawBitmap(pattern, 0f, 0f, null)
+        FileOutputStream(target).use { result.compress(Bitmap.CompressFormat.JPEG, JPEG_QUALITY, it) }
+        pattern.recycle()
+        result.recycle()
+    }
+
+    private fun averageColor(file: File): Int {
+        val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
+        BitmapFactory.decodeFile(file.absolutePath, bounds)
+        val options = BitmapFactory.Options().apply {
+            inSampleSize = maxOf(1, minOf(bounds.outWidth, bounds.outHeight) / 32)
+        }
+        val bitmap = BitmapFactory.decodeFile(file.absolutePath, options) ?: return 0
+        val one = Bitmap.createScaledBitmap(bitmap, 1, 1, true)
+        val color = one.getPixel(0, 0)
+        if (one !== bitmap) one.recycle()
+        bitmap.recycle()
+        return color
+    }
+
+    // the picker lists are of no use after a save: leave them so the chat shows again
+    private fun closePickers() {
+        AndroidUtilities.runOnUIThread {
+            val launch = LaunchActivity.instance ?: return@runOnUIThread
+            val layouts = listOfNotNull(launch.actionBarLayout, launch.rightActionBarLayout, launch.layersActionBarLayout)
+            for (layout in layouts) {
+                for (f in ArrayList(layout.fragmentStack)) {
+                    if (f is WallpapersListActivity && f.tele_isLocal()) f.removeSelfFromStack()
+                }
+            }
+        }
+    }
+
+    @JvmStatic
+    fun failed() {
+        android.widget.Toast.makeText(ApplicationLoader.applicationContext, R.string.TeleBackgroundFailed, android.widget.Toast.LENGTH_SHORT).show()
+    }
+}
