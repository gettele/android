+        // the same split by media kind as the server filters; used when the sender is the part the server filters
+        fun matches(message: TLRPC.Message): Boolean = when (this) {
+            PHOTO -> MessageObject.getMedia(message) is TLRPC.TL_messageMediaPhoto
+            VIDEO -> MessageObject.isVideoMessage(message) && !MessageObject.isRoundVideoMessage(message) &&
+                !MessageObject.isGifMessage(message) && !MessageObject.isNewGifMessage(message)
+            FILE -> MediaDataController.getMediaType(message) == MediaDataController.MEDIA_FILE
+            MUSIC -> MessageObject.isMusicMessage(message)
+            VOICE -> MessageObject.isVoiceMessage(message)
+            ROUND -> MessageObject.isRoundVideoMessage(message)
+            GIF -> MessageObject.isGifMessage(message) || MessageObject.isNewGifMessage(message)
+            LINK -> MediaDataController.getMediaType(message) == MediaDataController.MEDIA_URL ||
+                MessageObject.getMedia(message) is TLRPC.TL_messageMediaWebPage
+        }
+    }
 
