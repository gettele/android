+
+        internal fun filter(): TLRPC.MessagesFilter {
+            val kind = type
+            return if (kind != null && !released && !hashtag && TeleConfig.SEARCH_TYPES.value && !regexActive()) {
+                kind.filter()
+            } else {
+                TLRPC.TL_inputMessagesFilterEmpty()
+            }
+        }
+
+        // a sender and a type together: the server takes one of the two, the other one is checked here
+        private fun comboWanted() = TeleConfig.SEARCH_TYPES.value && !regexActive() && type != null && !hashtag && activity.tele_searchFrom() != 0L
+
+        private fun pickType(kind: Type) {
+            type = if (type == kind) null else kind
+            syncPanel()
+            AndroidUtilities.hideKeyboard(container)
+            rerunTyped()
+        }
+
+        // a chip changed: the sender and the query stay, only the results of the old filter go
+        private fun rerunTyped() {
+            if (comboWanted()) {
+                startCombo()
+                return
+            }
+            cancelCombo()
+            mode = Mode.NONE
+            activity.tele_runSearch(query, query.isEmpty() && type == null)
+        }
+
+        private fun cancelCombo() {
+            combo?.cancel()
+            combo = null
+            if (mode == Mode.COMBO) mode = Mode.NONE
+        }
+
+        private fun startCombo() {
+            val kind = type ?: return
+            cancelCombo()
+            activity.tele_runSearch(query, true)
+            NotificationCenter.getInstance(account).postNotificationName(NotificationCenter.chatSearchResultsLoading, guid)
+            val next = Combo(query, activity.tele_searchFrom(), kind, activity.tele_threadId())
+            combo = next
+            next.start()
+        }
+
+        private inner class Combo(val query: String, val from: Long, val kind: Type, val thread: Long) {
+            private val requests = IntArray(2)
+            private var peer: TLRPC.InputPeer? = null
+            private var fromPeer: TLRPC.InputPeer? = null
+            private var byFrom: TLRPC.messages_Messages? = null
+            private var byType: TLRPC.messages_Messages? = null
+            private var answered = 0
+            private var typeOnServer = false
+            private var offsetId = 0
+            private var pages = 0
+            private var batch = 0
+            private var cancelled = false
+            private var busy = true
+            private var first = true
+            private var firstNew = 0
+            private val found = ArrayList<MessageObject>()
+            private val ids = HashSet<Int>()
+
+            var full = false
+                private set
+
+            private fun alive() = !cancelled && !released && combo === this
+
+            private fun build(fromPeer: TLRPC.InputPeer?, filter: TLRPC.MessagesFilter, offset: Int): TLRPC.TL_messages_search {
+                val req = TLRPC.TL_messages_search()
+                req.peer = peer
+                req.q = query
+                req.filter = filter
+                req.limit = PAGE
+                req.offset_id = offset
+                if (fromPeer != null) {
+                    req.from_id = fromPeer
+                    req.flags = req.flags or 1
+                }
+                if (thread != 0L) {
+                    req.top_msg_id = thread.toInt()
+                    req.flags = req.flags or 2
+                }
+                return req
+            }
+
+            private fun send(req: TLRPC.TL_messages_search, done: (TLRPC.messages_Messages?) -> Unit): Int =
+                ConnectionsManager.getInstance(account).sendRequest(req, { response, _ ->
+                    AndroidUtilities.runOnUIThread { if (alive()) done(response as? TLRPC.messages_Messages) }
+                }, ConnectionsManager.RequestFlagFailOnServerErrors)
+
+            fun start() {
+                val controller = MessagesController.getInstance(account)
+                peer = controller.getInputPeer(dialogId)
+                fromPeer = controller.getInputPeer(from)
+                if (peer == null || fromPeer == null) {
+                    failed()
+                    return
+                }
+                requests[0] = send(build(fromPeer, TLRPC.TL_inputMessagesFilterEmpty(), 0)) { byFrom = it; probed() }
+                requests[1] = send(build(null, kind.filter(), 0)) { byType = it; probed() }
+            }
+
+            private fun count(res: TLRPC.messages_Messages) = if (isSlice(res)) res.count else res.messages.size
+
+            private fun isSlice(res: TLRPC.messages_Messages) = res is TLRPC.TL_messages_messagesSlice || res is TLRPC.TL_messages_channelMessages
+
+            // the narrower of the two answers is the one the server keeps filtering, fewer pages to read through
+            private fun probed() {
+                if (++answered < 2) return
+                val a = byFrom
+                val b = byType
+                val chosen = if (a != null && (b == null || count(a) <= count(b))) {
+                    typeOnServer = false
+                    a
+                } else if (b != null) {
+                    typeOnServer = true
+                    b
+                } else {
+                    failed()
+                    return
+                }
+                byFrom = null
+                byType = null
+                consume(chosen)
+            }
+
+            private fun page(res: TLRPC.messages_Messages?) {
+                if (res == null) {
+                    failed()
+                    return
+                }
+                consume(res)
+            }
+
+            private fun matches(message: TLRPC.Message) =
+                if (typeOnServer) DialogObject.getPeerDialogId(message.from_id) == from else kind.matches(message)
+
+            private fun consume(res: TLRPC.messages_Messages) {
+                MessagesStorage.getInstance(account).putUsersAndChats(res.users, res.chats, true, true)
+                MessagesController.getInstance(account).putUsers(res.users, false)
+                MessagesController.getInstance(account).putChats(res.chats, false)
+                offsetId = res.messages.lastOrNull()?.id ?: offsetId
+                full = res.messages.isEmpty() || !isSlice(res) || res.messages.size < PAGE
+                var matched = 0
+                for (message in res.messages) {
+                    if (message is TLRPC.TL_messageEmpty || message.action is TLRPC.TL_messageActionHistoryClear) continue
+                    if (!matches(message) || !ids.add(message.id)) continue
+                    val item = MessageObject(account, message, null, null, null, null, null, true, true, 0L, false, false, isSaved)
+                    if (item.hasValidGroupId()) item.isPrimaryGroupMessage = true
+                    item.setQuery(query, true)
+                    found.add(item)
+                    matched++
+                }
+                batch += matched
+                pages++
+                if (!full && batch < TARGET && pages < PAGES) {
+                    next()
+                } else {
+                    finish()
+                }
+            }
+
+            private fun next() {
+                val req = if (typeOnServer) build(null, kind.filter(), offsetId) else build(fromPeer, TLRPC.TL_inputMessagesFilterEmpty(), offsetId)
+                requests[0] = send(req) { page(it) }
+            }
+
+            private fun finish() {
+                busy = false
+                mode = Mode.COMBO
+                // the first batch moves to its first hit, a later one to the first hit it added
+                val index = if (first) 0 else firstNew
+                first = false
+                mdc.tele_portResults(guid, dialogId, query, ArrayList(found), index, found.size, full, true)
+            }
+
+            private fun failed() {
+                busy = false
+                if (combo === this) combo = null
+                mode = Mode.NONE
+                // no results and no spinner; the stock handling of an error does not show one either
+                mdc.tele_clearResults()
+                NotificationCenter.getInstance(account).postNotificationName(NotificationCenter.chatSearchResultsAvailable, guid, 0, 0, 0L, 0, -1, false)
+            }
+
+            fun more() {
+                if (cancelled || busy || full) return
+                busy = true
+                pages = 0
+                batch = 0
+                firstNew = found.size
+                next()
+            }
+
+            fun cancel() {
+                cancelled = true
+                for (id in requests) {
+                    if (id != 0) ConnectionsManager.getInstance(account).cancelRequest(id, true)
+                }
+            }
+        }
     }
 }
