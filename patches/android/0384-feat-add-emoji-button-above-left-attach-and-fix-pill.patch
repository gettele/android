+    private void tele_updateAiHintJoint() {
+        if (aiHint == null || aiButton == null) {
+            return;
+        }
+        final boolean aiOnRight = tele_outerEmojiVisible();
+        final float aiJointOffset = (aiOnRight && shownRichButton ? dp(36) : 0) + aiButton.getWidth() / 2f + dp(4);
+        aiHint.setJointPx(aiOnRight ? 1f : 0f, aiOnRight ? -aiJointOffset : aiJointOffset);
+    }
+
+    private void tele_updateAiButtonLayout() {
+        if (aiButton == null || !(aiButton.getLayoutParams() instanceof FrameLayout.LayoutParams)) {
+            return;
+        }
+        final FrameLayout.LayoutParams params = (FrameLayout.LayoutParams) aiButton.getLayoutParams();
+        final boolean onRight = tele_outerEmojiVisible();
+        final int targetGravity = Gravity.TOP | (onRight ? Gravity.RIGHT : Gravity.LEFT);
+        final int targetRight = onRight && shownRichButton ? dp(36) : 0;
+        if (params.gravity != targetGravity || params.rightMargin != targetRight) {
+            params.gravity = targetGravity;
+            params.rightMargin = targetRight;
+            aiButton.setLayoutParams(params);
+        }
+        tele_updateAiHintJoint();
+    }
