diff --git a/TMessagesProj/src/main/java/tele/helpers/VolumeControl.kt b/TMessagesProj/src/main/java/tele/helpers/VolumeControl.kt
new file mode 100644
index 000000000..804353d6b
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/VolumeControl.kt
@@ -0,0 +1,116 @@
+package tele.helpers
+
+import android.content.Context
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.MediaController
+import org.telegram.messenger.R
+import org.telegram.messenger.Utilities
+import java.util.WeakHashMap
+import org.telegram.ui.ActionBar.ActionBarMenuItem
+import org.telegram.ui.ActionBar.ActionBarMenuSlider
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.ActionBar.ThemeBind
+
+/** Inline per-media volume control: a speaker button whose popup is a slider scaling that media's software gain. */
+object VolumeControl {
+
+    @JvmStatic
+    fun enabled(): Boolean = tele.TeleConfig.INLINE_VOLUME_CONTROLS.value
+
+    /**
+     * Builds a ready-to-place volume button. [typeSupplier] resolves the media class when the popup
+     * opens or the value changes; [onApplied] runs after each change for hosts with their own player
+     * (MediaController-driven surfaces can leave it null, since [MediaVolumes.set] already refreshes).
+     */
+    @JvmStatic
+    fun createButton(
+        context: Context,
+        resourcesProvider: Theme.ResourcesProvider?,
+        iconColor: Int,
+        typeSupplier: IntSupplier,
+        onApplied: Utilities.Callback<Int>?
+    ): ActionBarMenuItem {
+        val button = ActionBarMenuItem(context, null, 0, iconColor, false, resourcesProvider)
+        button.setIcon(R.drawable.filled_sound_on)
+        attach(button, resourcesProvider, typeSupplier, onApplied)
+        return button
+    }
+
+    /** Wires the volume popup onto a button the host already created and themed itself. */
+    @JvmStatic
+    fun attach(
+        button: ActionBarMenuItem,
+        resourcesProvider: Theme.ResourcesProvider?,
+        typeSupplier: IntSupplier,
+        onApplied: Utilities.Callback<Int>?
+    ) {
+        val slider = VolumeSlider(button.context, resourcesProvider, typeSupplier, onApplied)
+        slider.setRoundRadiusDp(6f)
+        slider.setDrawShadow(true)
+        button.setLongClickEnabled(false)
+        button.setShowSubmenuByMove(false)
+        button.setAdditionalXOffset(AndroidUtilities.dp(8f))
+        button.setShowedFromBottom(true)
+        val open = Runnable {
+            slider.sync()
+            ThemeBind.backgroundColor(slider, Theme.key_actionBarDefaultSubmenuBackground, resourcesProvider)
+            slider.invalidateBlur(true)
+            button.redrawPopup(Theme.getColor(Theme.key_actionBarDefaultSubmenuBackground, resourcesProvider))
+            button.updateColor()
+            button.setDimMenu(.15f)
+            button.toggleSubMenu(slider, null)
+        }
+        button.setOnClickListener { open.run() }
+        button.setOnLongClickListener { open.run(); true }
+    }
+
+    /** The media class of whatever MediaController is playing, for shared mini/full players. */
+    @JvmStatic
+    fun playingType(): Int = MediaVolumes.forMessage(MediaController.getInstance().playingMessageObject)
+
+    /** Java-friendly supplier so call sites can pass a plain lambda. */
+    fun interface IntSupplier {
+        fun get(): Int
+    }
+
+    /**
+     * Mini-players outlive the settings page the toggle is flipped on, so they register here and
+     * re-read it at once instead of waiting for the next playback event.
+     */
+    private val liveRefreshers = java.util.Collections.newSetFromMap(WeakHashMap<Runnable, Boolean>())
+
+    @JvmStatic
+    fun track(refresh: Runnable) {
+        liveRefreshers.add(refresh)
+    }
+
+    @JvmStatic
+    fun onToggled() {
+        AndroidUtilities.runOnUIThread {
+            for (refresh in ArrayList(liveRefreshers)) refresh.run()
+        }
+    }
+
+    class VolumeSlider(
+        context: Context,
+        resourcesProvider: Theme.ResourcesProvider?,
+        private val typeSupplier: IntSupplier,
+        private val onApplied: Utilities.Callback<Int>?
+    ) : ActionBarMenuSlider(context, resourcesProvider) {
+
+        init {
+            minimumWidth = AndroidUtilities.dp(196f)
+            setOnValueChange { value, _ ->
+                val type = typeSupplier.get()
+                MediaVolumes.set(type, Math.round(value * 100f))
+                onApplied?.run(type)
+            }
+        }
+
+        fun sync() {
+            setValue(MediaVolumes.level(typeSupplier.get()) / 100f, false)
+        }
+
+        override fun getLeftStringValue(value: Float): String = "${Math.round(value * 100f)}%"
+    }
+}
