@@ -0,0 +1,48 @@
+package tele.helpers
+
+import org.telegram.messenger.MediaController
+import org.telegram.messenger.MessageObject
+import tele.IntItem
+import tele.TeleConfig
+
+/** Per-media software gain (desktop 0333): the system stream keeps its level, each media class scales its own. */
+object MediaVolumes {
+    const val MUSIC = 0
+    const val VIDEO = 1
+    const val VOICE = 2
+    const val ROUND = 3
+
+    @JvmStatic
+    fun item(type: Int): IntItem = when (type) {
+        MUSIC -> TeleConfig.MUSIC_VOLUME
+        VIDEO -> TeleConfig.VIDEO_VOLUME
+        VOICE -> TeleConfig.VOICE_VOLUME
+        else -> TeleConfig.ROUND_VOLUME
+    }
+
+    @JvmStatic
+    fun level(type: Int): Int = item(type).value.coerceIn(0, 100)
+
+    /** Stock plays at 100% and the multiplier never raises it. */
+    @JvmStatic
+    fun gain(type: Int): Float = level(type) / 100f
+
+    @JvmStatic
+    fun percent(type: Int): String = "${level(type)}%"
+
+    @JvmStatic
+    fun set(type: Int, value: Int) {
+        TeleConfig.set(item(type), value.coerceIn(0, 100))
+        MediaController.getInstance().tele_refreshVolume()
+    }
+
+    /** The document decides: a round video plays on the video player but has its own level. */
+    @JvmStatic
+    fun forMessage(message: MessageObject?): Int = when {
+        message == null -> VIDEO
+        message.isRoundVideo -> ROUND
+        message.isVoice -> VOICE
+        message.isMusic -> MUSIC
+        else -> VIDEO
+    }
+}
