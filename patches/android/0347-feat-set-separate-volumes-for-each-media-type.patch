+    private fun chooseVolume(type: Int, title: String) {
+        val activity = parentActivity ?: return
+        val holder = android.widget.LinearLayout(activity)
+        holder.orientation = android.widget.LinearLayout.VERTICAL
+        holder.setPadding(AndroidUtilities.dp(24f), AndroidUtilities.dp(4f), AndroidUtilities.dp(24f), 0)
+        val label = TextView(activity)
+        label.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16f)
+        label.setTextColor(Theme.getColor(Theme.key_dialogTextBlack, resourceProvider))
+        label.gravity = android.view.Gravity.CENTER
+        label.text = tele.helpers.MediaVolumes.percent(type)
+        holder.addView(label, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT))
+        val bar = SeekBarView(activity, resourceProvider)
+        bar.setProgress(tele.helpers.MediaVolumes.level(type) / 100f, false)
+        bar.setDelegate(object : SeekBarView.SeekBarViewDelegate {
+            override fun onSeekBarDrag(stop: Boolean, progress: Float) {
+                val level = Math.round(progress * 100f).coerceIn(0, 100)
+                label.text = "$level%"
+                tele.helpers.MediaVolumes.set(type, level)
+            }
+        })
+        holder.addView(bar, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, 44, 0f, 8f, 0f, 0f))
+        val builder = if (resourceProvider != null) AlertDialog.Builder(activity, resourceProvider) else AlertDialog.Builder(activity)
+        builder.setTitle(lc(title))
+        builder.setView(holder)
+        builder.setPositiveButton(LocaleController.getString(R.string.Done)) { _, _ -> refresh() }
+        showDialog(builder.create())
+    }
+
