diff --git a/TMessagesProj/src/main/java/tele/helpers/PeerId.kt b/TMessagesProj/src/main/java/tele/helpers/PeerId.kt
new file mode 100644
index 000000000..cd0cb9d85
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/PeerId.kt
@@ -0,0 +1,106 @@
+package tele.helpers
+
+import org.telegram.messenger.UserConfig
+import org.telegram.tgnet.ConnectionsManager
+import org.telegram.tgnet.TLRPC
+import tele.TeleConfig
+
+object PeerId {
+
+    private const val CHANNEL_SHIFT = 1000000000000L
+    private const val GROUP_SEPARATOR = ' '
+
+    @JvmStatic
+    fun format(account: Int, userId: Long, chatId: Long): String {
+        val id = botApiAdjusted(account, userId, chatId)
+        return if (TeleConfig.PEER_IDS_WITHOUT_SPACES.value) {
+            id.toString()
+        } else {
+            groupDigits(id)
+        }
+    }
+
+    @JvmStatic
+    fun dc(account: Int, userId: Long, chatId: Long): Int {
+        val messagesController = org.telegram.messenger.MessagesController.getInstance(account)
+        if (userId != 0L) {
+            if (userId == UserConfig.getInstance(account).clientUserId) {
+                return ConnectionsManager.getInstance(account).getCurrentDatacenterId()
+            }
+            val user = messagesController.getUser(userId) ?: return 0
+            return photoDc(user.photo)
+        }
+        val chat = messagesController.getChat(chatId) ?: return 0
+        return photoDc(chat.photo)
+    }
+
+    @JvmStatic
+    fun dcText(account: Int, userId: Long, chatId: Long): String {
+        val dc = dc(account, userId, chatId)
+        if (dc == 0) return ""
+        val location = when (dc) {
+            1, 3 -> "Miami"
+            2, 4 -> "Amsterdam"
+            5 -> "Singapore"
+            else -> ""
+        }
+        return if (location.isEmpty()) dc.toString() else "$dc, ${location.lowercase()}"
+    }
+
+    @JvmStatic
+    fun rowText(account: Int, userId: Long, chatId: Long): String {
+        val id = format(account, userId, chatId)
+        if (!TeleConfig.SHOW_DC.value || !TeleConfig.MERGE_ID_DC.value) {
+            return id
+        }
+        val dc = dcText(account, userId, chatId)
+        return if (dc.isEmpty()) id else "$id (DC$dc)"
+    }
+
+    @JvmStatic
+    fun showDcRow(): Boolean =
+        TeleConfig.SHOW_DC.value && !TeleConfig.MERGE_ID_DC.value
+
+    private fun botApiAdjusted(account: Int, userId: Long, chatId: Long): Long {
+        if (userId != 0L || chatId == 0L || !TeleConfig.BOT_API_PEER_IDS.value) {
+            return if (userId != 0L) userId else chatId
+        }
+        val chat = org.telegram.messenger.MessagesController.getInstance(account).getChat(chatId)
+            ?: return chatId
+        return if (org.telegram.messenger.ChatObject.isChannel(chat)) {
+            -(CHANNEL_SHIFT + chatId)
+        } else {
+            -chatId
+        }
+    }
+
+    private fun photoDc(photo: TLRPC.UserProfilePhoto?): Int {
+        if (photo == null) return 0
+        if (photo.dc_id != 0) return photo.dc_id
+        photo.photo_small?.let { if (it.dc_id != 0) return it.dc_id }
+        photo.photo_big?.let { if (it.dc_id != 0) return it.dc_id }
+        return 0
+    }
+
+    private fun photoDc(photo: TLRPC.ChatPhoto?): Int {
+        if (photo == null) return 0
+        if (photo.dc_id != 0) return photo.dc_id
+        photo.photo_small?.let { if (it.dc_id != 0) return it.dc_id }
+        photo.photo_big?.let { if (it.dc_id != 0) return it.dc_id }
+        return 0
+    }
+
+    private fun groupDigits(value: Long): String {
+        val digits = value.toString()
+        val sign = digits.startsWith("-")
+        val body = if (sign) digits.substring(1) else digits
+        val grouped = StringBuilder()
+        for ((index, c) in body.withIndex()) {
+            if (index != 0 && (body.length - index) % 3 == 0) {
+                grouped.append(GROUP_SEPARATOR)
+            }
+            grouped.append(c)
+        }
+        return if (sign) "-$grouped" else grouped.toString()
+    }
+}
