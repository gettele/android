+    @JvmStatic
+    fun all(account: Int): List<android.util.Pair<String, Long>> {
+        val out = ArrayList<android.util.Pair<String, Long>>()
+        synchronized(map) {
+            ensureLoaded(account)
+            val prefix = "$account:"
+            map.forEach { (key, id) ->
+                if (key.startsWith(prefix)) {
+                    out.add(android.util.Pair(key.substring(prefix.length), id))
+                }
+            }
+        }
+        out.sortBy { it.first }
+        return out
+    }
