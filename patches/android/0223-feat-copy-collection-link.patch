--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/GiftCollectionLink.kt
@@ -0,0 +1,24 @@
+package tele.helpers
+
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.MessagesController
+import org.telegram.messenger.R
+import org.telegram.ui.ActionBar.BaseFragment
+import org.telegram.ui.Components.BulletinFactory
+import tele.TeleConfig
+
+/** Copying the link of a gift collection next to the stock Share (desktop 0207). */
+object GiftCollectionLink {
+
+    @JvmStatic
+    fun enabled(): Boolean = TeleConfig.GIFT_COLLECTION_LINK.value
+
+    @JvmStatic
+    fun copy(currentAccount: Int, username: String, collectionId: Int, fragment: BaseFragment?) {
+        val link = MessagesController.getInstance(currentAccount).linkPrefix + "/" + username + "/c/" + collectionId
+        if (!AndroidUtilities.addToClipboard(link)) return
+        TeleToast.log("gift-collection-link", LocaleController.getString(R.string.LinkCopied), account = currentAccount)
+        BulletinFactory.of(fragment).createCopyLinkBulletin().show()
+    }
+}
