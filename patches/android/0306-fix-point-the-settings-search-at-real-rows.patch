@@ -461,8 +474,21 @@ object TeleSearch {
             section(1556, "Transaction links", "money", TeleSettingsActivity.MODE_MONEY, "Transaction links"),
             section(1557, "Copy transaction link", "money", TeleSettingsActivity.MODE_MONEY, "Transaction links"),
             section(1558, "Open in explorer", "money", TeleSettingsActivity.MODE_MONEY, "Transaction links"),
