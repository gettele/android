diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
index 956d8044e..2d3a1dd77 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
@@ -701,6 +701,14 @@ class TeleSettingsActivity @JvmOverloads constructor(private val mode: String =
     private fun pageRows(): List<Row> =
         if (canonicalMode(mode) == MODE_NEW) newRows(newState) else withGroups(buildRows(mode))
 
+    /** The rows a search can point at: the id the page jumps to and the title it shows. */
+    fun searchRows(): List<Pair<String, String>> =
+        withGroups(buildRows(mode)).mapNotNull { row ->
+            val title = row.title ?: return@mapNotNull null
+            if (row.type == TYPE_HEADER || row.type == TYPE_SHADOW || row.type == TYPE_CUSTOM) return@mapNotNull null
+            idOf(row)?.let { it to title }
+        }
+
     private fun setupNewPage() {
         actionBar.createMenu().addItem(SEARCH_ITEM, R.drawable.outline_header_search)
             .setIsSearchField(true, false)
