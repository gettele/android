     private fun entries(fragment: BaseFragment): Array<ProfileActivity.SearchAdapter.SearchResult> {
         val icon = R.drawable.tele_settings_icon
 
-        fun section(guid: Int, title: String, path: String, mode: String, jumpTo: String = title) =
-            ProfileActivity.SearchAdapter.SearchResult(guid, lc(title), "teleSearchRow", "tele", lc(path), icon) {
-                fragment.presentFragment(TeleSettingsActivity(mode, jumpTo))
-            }
+        val rowsByMode = HashMap<String, List<Pair<String, String>>>()
+        fun rowsOf(mode: String): List<Pair<String, String>> =
+            rowsByMode.getOrPut(mode) { TeleSettingsActivity(mode).searchRows() }
+        fun words(text: String): List<String> =
+            text.lowercase().split(Regex("[^a-z0-9]+")).filter { it.length > 2 }
+
+        // an alias is worth a row only when its target row exists and the alias brings a word the title does not have;
+        // a dead one would open the page and do nothing, and a redundant one would duplicate the row's own entry
+        fun section(guid: Int, title: String, path: String, mode: String, jumpTo: String? = null): ProfileActivity.SearchAdapter.SearchResult? {
+            val target = jumpTo ?: return null
+            if (rowsOf(mode).none { it.second == target }) return null
+            if (words(title).all { target.lowercase().contains(it) }) return null
+            return ProfileActivity.SearchAdapter.SearchResult(guid, lc(title), "teleSearchRow", "tele", lc(path), icon) {
+                fragment.presentFragment(TeleSettingsActivity(mode, target))
+            }.also { it.displayTitle = lc(target) }
+        }
 
         fun screen(guid: Int, title: String, factory: () -> BaseFragment) =
-            ProfileActivity.SearchAdapter.SearchResult(guid, lc(title), icon) { fragment.presentFragment(factory()) }
+            ProfileActivity.SearchAdapter.SearchResult(guid, lc(title), "tele", icon) { fragment.presentFragment(factory()) }
 
         val results = ArrayList<ProfileActivity.SearchAdapter.SearchResult>()
         results.add(screen(GUID_ROOT, "tele") { TeleSettingsActivity() })
