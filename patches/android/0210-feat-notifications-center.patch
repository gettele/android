+package tele.helpers
+
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.R
+import org.telegram.messenger.UserConfig
+import org.telegram.messenger.UserObject
+import org.telegram.tgnet.TLRPC
+import tele.db.TeleDatabaseHelper
+
+/** The small producers of the notification center: the ones that only need a call from the feature. */
+object TeleNoticeSources {
+
+    private const val UPDATE_TAG = "notices_update_tag"
+
+    /** An update of tele is downloading or ready: one entry for the tag, on every account. */
+    @JvmStatic
+    fun update(tag: String) {
+        if (!TeleNotices.enabled() || tag.isEmpty() || TeleDatabaseHelper.get(UPDATE_TAG) == tag) return
+        TeleDatabaseHelper.put(UPDATE_TAG, tag)
+        val build = tag.substringAfterLast("-tele.", tag)
+        val notice = TeleNotice(
+            kind = NoticeKind.UPDATE,
+            key = "update",
+            title = LocaleController.formatString(R.string.TeleNoticesUpdateTitle, build),
+            buttons = listOf(NoticeButton(LocaleController.getString(R.string.TeleNoticesWhatsNew), "${TeleUpdater.RELEASES}/tag/$tag"))
+        )
+        for (account in 0 until UserConfig.MAX_ACCOUNT_COUNT) {
+            if (UserConfig.getInstance(account).isClientActivated) TeleNotices.add(account, notice)
+        }
+    }
+
+    /** A crash report went to the server; [response] is its body, `Done <id>` on success. */
+    @JvmStatic
+    fun crashSent(response: String?) {
+        if (!TeleNotices.enabled()) return
+        val text = response.orEmpty().trim()
+        val id = if (text.startsWith("Done ")) text.substring(5).trim() else ""
+        val title = when {
+            id.isEmpty() -> LocaleController.getString(R.string.TeleNoticesCrashSent)
+            else -> LocaleController.formatString(R.string.TeleNoticesCrashSentId, id)
+        }
+        TeleNotices.add(UserConfig.selectedAccount, TeleNotice(kind = NoticeKind.CRASH, title = title))
+    }
+
+    /** A watched user came online. */
+    @JvmStatic
+    fun cameOnline(account: Int, user: TLRPC.User) {
+        if (!TeleNotices.enabled()) return
+        TeleNotices.add(account, TeleNotice(
+            kind = NoticeKind.ONLINE,
+            title = UserObject.getUserName(user),
+            text = LocaleController.getString(R.string.TeleNoticesCameOnline),
+            peer = user.id
+        ))
+    }
+}
diff --git a/TMessagesProj/src/main/java/tele/helpers/TeleNotices.kt b/TMessagesProj/src/main/java/tele/helpers/TeleNotices.kt
