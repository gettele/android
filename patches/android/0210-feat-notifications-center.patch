@@ -0,0 +1,62 @@
+package tele.ui
+
+import android.graphics.Canvas
+import android.graphics.ColorFilter
+import android.graphics.Paint
+import android.graphics.PixelFormat
+import android.graphics.RectF
+import android.graphics.drawable.Drawable
+import android.text.Spannable
+import android.text.SpannableStringBuilder
+import android.text.style.DynamicDrawableSpan
+import android.text.style.ImageSpan
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.ui.ActionBar.Theme
+
+/** An unread counter after the text of a settings row: a rounded pill with the number. */
+object TeleCountBadge {
+
+    private class Pill(private val label: String) : Drawable() {
+        private val bg = Paint(Paint.ANTI_ALIAS_FLAG)
+        private val fg = Paint(Paint.ANTI_ALIAS_FLAG)
+        private val rect = RectF()
+        private val width: Int
+        private val height = AndroidUtilities.dp(20f)
+
+        init {
+            bg.color = Theme.getColor(Theme.key_featuredStickers_unread)
+            fg.color = Theme.getColor(Theme.key_featuredStickers_buttonText)
+            fg.textSize = AndroidUtilities.dp(12f).toFloat()
+            fg.typeface = AndroidUtilities.bold()
+            fg.textAlign = Paint.Align.CENTER
+            width = maxOf(height, fg.measureText(label).toInt() + AndroidUtilities.dp(12f))
+            setBounds(0, 0, width, height)
+        }
+
+        override fun getIntrinsicWidth(): Int = width
+        override fun getIntrinsicHeight(): Int = height
+
+        override fun draw(canvas: Canvas) {
+            val bounds = bounds
+            rect.set(bounds)
+            canvas.drawRoundRect(rect, height / 2f, height / 2f, bg)
+            val baseline = bounds.centerY() - (fg.descent() + fg.ascent()) / 2f
+            canvas.drawText(label, bounds.exactCenterX(), baseline, fg)
+        }
+
+        override fun setAlpha(alpha: Int) {}
+        override fun setColorFilter(colorFilter: ColorFilter?) {}
+        @Deprecated("Deprecated in Java")
+        override fun getOpacity(): Int = PixelFormat.TRANSLUCENT
+    }
+
+    @JvmStatic
+    fun withCount(text: CharSequence, count: Int): CharSequence {
+        val label = if (count > 99) "99+" else count.toString()
+        val result = SpannableStringBuilder(text).append("  ")
+        val start = result.length
+        result.append(label)
+        result.setSpan(ImageSpan(Pill(label), DynamicDrawableSpan.ALIGN_BOTTOM), start, result.length, Spannable.SPAN_EXCLUSIVE_EXCLUSIVE)
+        return result
+    }
+}
diff --git a/TMessagesProj/src/main/java/tele/ui/TeleNoticeCell.kt b/TMessagesProj/src/main/java/tele/ui/TeleNoticeCell.kt
new file mode 100644
index 000000000..ecf756184
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/ui/TeleNoticeCell.kt
@@ -0,0 +1,133 @@
+package tele.ui
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Color
+import android.text.TextUtils
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.View
+import android.view.ViewGroup
+import android.widget.ImageView
+import android.widget.LinearLayout
+import android.widget.TextView
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.R
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Components.LayoutHelper
+import tele.helpers.NoticeButton
+import tele.helpers.NoticeTone
+import tele.helpers.TeleNotice
+import tele.helpers.TeleNotices
+
+private const val WRAP = ViewGroup.LayoutParams.WRAP_CONTENT
+private const val MATCH = ViewGroup.LayoutParams.MATCH_PARENT
+
+/**
+ * One entry of the notification center: the round icon of its kind, the title and the time on the
+ * first line, the text and up to two link buttons below. The extension points are
+ * [TeleNotices.registerText] for the text and the kind's [tele.helpers.NoticeKind.icon] and `color`.
+ */
+class TeleNoticeCell(context: Context) : LinearLayout(context) {
+
+    private val icon = ImageView(context)
+    private val title = TextView(context)
+    private val time = TextView(context)
+    private val text = TextView(context)
+    private val buttons = LinearLayout(context)
+
+    /** A tap on one of the buttons of the entry. */
+    var onButton: ((NoticeButton) -> Unit)? = null
+
+    init {
+        orientation = HORIZONTAL
+        setWillNotDraw(false)
+        setPadding(AndroidUtilities.dp(16f), AndroidUtilities.dp(10f), AndroidUtilities.dp(16f), AndroidUtilities.dp(10f))
+
+        icon.scaleType = ImageView.ScaleType.CENTER
+        addView(icon, LayoutHelper.createLinear(36, 36, Gravity.TOP, 0, 0, 12, 0))
+
+        val column = LinearLayout(context)
+        column.orientation = VERTICAL
+        addView(column, LinearLayout.LayoutParams(0, WRAP, 1f))
+
+        val header = LinearLayout(context)
+        header.orientation = HORIZONTAL
+        header.gravity = Gravity.CENTER_VERTICAL
+        title.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16f)
+        title.typeface = AndroidUtilities.bold()
+        title.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
+        title.isSingleLine = true
+        title.ellipsize = TextUtils.TruncateAt.END
+        header.addView(title, LinearLayout.LayoutParams(0, WRAP, 1f))
+        time.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13f)
+        time.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2))
+        header.addView(time, LinearLayout.LayoutParams(WRAP, WRAP).apply { leftMargin = AndroidUtilities.dp(8f) })
+        column.addView(header, LinearLayout.LayoutParams(MATCH, WRAP))
+
+        text.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15f)
+        text.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
+        column.addView(text, LinearLayout.LayoutParams(MATCH, WRAP).apply { topMargin = AndroidUtilities.dp(2f) })
+
+        buttons.orientation = HORIZONTAL
+        column.addView(buttons, LinearLayout.LayoutParams(MATCH, WRAP).apply { topMargin = AndroidUtilities.dp(6f) })
+    }
+
+    /** [fresh] entries were unread when the screen opened: they stay tinted until it closes. */
+    fun set(notice: TeleNotice, fresh: Boolean) {
+        setBackgroundColor(if (fresh) Theme.multAlpha(Theme.getColor(Theme.key_featuredStickers_addButton), 0.1f) else Theme.getColor(Theme.key_windowBackgroundWhite))
+        icon.background = Theme.createCircleDrawable(AndroidUtilities.dp(36f), color(notice))
+        icon.setImageResource(notice.kind.icon)
+        icon.setColorFilter(Color.WHITE)
+
+        title.text = notice.title
+        title.visibility = if (notice.title.isEmpty()) View.INVISIBLE else View.VISIBLE
+        val body = TeleNotices.textOf(notice)
+        text.text = body
+        text.visibility = if (body.isEmpty()) View.GONE else View.VISIBLE
+        refreshTime(notice)
+
+        buttons.removeAllViews()
+        buttons.visibility = if (notice.buttons.isEmpty()) View.GONE else View.VISIBLE
+        for (button in notice.buttons) {
+            val view = TextView(context)
+            view.text = button.text
+            view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14f)
+            view.typeface = AndroidUtilities.bold()
+            view.setTextColor(Theme.getColor(Theme.key_featuredStickers_addButton))
+            view.setPadding(AndroidUtilities.dp(12f), AndroidUtilities.dp(6f), AndroidUtilities.dp(12f), AndroidUtilities.dp(6f))
+            view.background = Theme.createRoundRectDrawable(AndroidUtilities.dp(16f), Theme.multAlpha(Theme.getColor(Theme.key_featuredStickers_addButton), 0.2f))
+            view.setOnClickListener { onButton?.invoke(button) }
+            buttons.addView(view, LinearLayout.LayoutParams(WRAP, WRAP).apply { rightMargin = AndroidUtilities.dp(6f) })
+        }
+    }
+
+    fun refreshTime(notice: TeleNotice) {
+        time.text = ago(notice.date)
+    }
+
+    private fun color(notice: TeleNotice): Int = when (notice.tone) {
+        NoticeTone.INFO -> 0xFF4A9EF0.toInt()
+        NoticeTone.SUCCESS -> 0xFF4DB86A.toInt()
+        NoticeTone.WARNING -> 0xFFF29E38.toInt()
+        NoticeTone.CRITICAL -> 0xFFE5574E.toInt()
+        NoticeTone.NONE -> notice.kind.color
+    }
+
+    override fun onDraw(canvas: Canvas) {
+        val left = if (LocaleController.isRTL) 0f else AndroidUtilities.dp(64f).toFloat()
+        val right = if (LocaleController.isRTL) (width - AndroidUtilities.dp(64f)).toFloat() else width.toFloat()
+        canvas.drawLine(left, height - 1f, right, height - 1f, Theme.dividerPaint)
+    }
+
+    private fun ago(date: Int): String {
+        val seconds = maxOf((System.currentTimeMillis() / 1000L).toInt() - date, 0)
+        return when {
+            seconds < 60 -> LocaleController.getString(R.string.TeleNoticesJustNow)
+            seconds < 3600 -> LocaleController.formatString(R.string.TeleNoticesMinutesAgo, seconds / 60)
+            seconds < 86400 -> LocaleController.formatString(R.string.TeleNoticesHoursAgo, seconds / 3600)
+            else -> LocaleController.formatDateChat(date.toLong())
+        }
+    }
+}
