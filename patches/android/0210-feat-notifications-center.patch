+++ b/TMessagesProj/src/main/java/tele/helpers/TeleNotices.kt
@@ -0,0 +1,348 @@
+package tele.helpers
+
+import org.json.JSONArray
+import org.json.JSONObject
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.DispatchQueue
+import org.telegram.messenger.FileLog
+import org.telegram.messenger.R
+import org.telegram.messenger.UserConfig
+import org.telegram.ui.ActionBar.BaseFragment
+import tele.TeleConfig
+import tele.db.TeleDatabaseHelper
+import java.util.concurrent.CopyOnWriteArrayList
+
+/**
+ * The kinds of the notification center (tele 0205). A kind with a [cap] has its own pool of that
+ * size; the others share [TeleNotices.MAX_SHARED]. [icon] and [color] are what the list draws.
+ */
+enum class NoticeKind(val id: String, val icon: Int, val color: Int, val cap: Int = 0) {
+    LIMIT("limit", R.drawable.msg_recent, 0xFFF29E38.toInt()),
+    SERVER("server", R.drawable.msg_info, 0xFF4A9EF0.toInt()),
+    TELE("tele", R.drawable.msg_notifications, 0xFF9A6BE8.toInt()),
+    UPDATE("update", R.drawable.msg_download, 0xFF4DB86A.toInt()),
+    CRASH("crash", R.drawable.msg_report, 0xFFE5574E.toInt()),
+    ONLINE("online", R.drawable.msg_online, 0xFF3FB6C7.toInt());
+
+    companion object {
+        @JvmStatic
+        fun of(id: String): NoticeKind? = values().firstOrNull { it.id == id }
+    }
+}
+
+enum class NoticeTone(val id: String) {
+    NONE(""),
+    INFO("info"),
+    SUCCESS("success"),
+    WARNING("warning"),
+    CRITICAL("critical");
+
+    companion object {
+        @JvmStatic
+        fun of(id: String): NoticeTone = values().firstOrNull { it.id == id } ?: NONE
+    }
+}
+
+data class NoticeButton(val text: String, val url: String)
+
+/**
+ * One entry. [id] is assigned by the store (per account, growing); [key] makes the entry
+ * replaceable: a notice with an existing key takes the place of the old one. [extra] is a JSON
+ * object for the fields of one kind (see [json]); the store never reads it.
+ */
+data class TeleNotice(
+    val kind: NoticeKind,
+    val title: String = "",
+    val text: String = "",
+    val tone: NoticeTone = NoticeTone.NONE,
+    /** Unix seconds; 0 means now. */
+    val date: Int = 0,
+    val key: String = "",
+    val rev: Int = 0,
+    val buttons: List<NoticeButton> = emptyList(),
+    /** The name of a cached picture of a server notice. */
+    val photo: String = "",
+    /** The dialog id (negative for chats) the entry opens on tap; 0 for none. */
+    val peer: Long = 0L,
+    val messageId: Int = 0,
+    val topicId: Long = 0L,
+    val extra: String = "",
+    val id: Long = 0L,
+    val unread: Boolean = true
+) {
+    /** The [extra] object; an empty one when there is none. */
+    fun json(): JSONObject = if (extra.isEmpty()) JSONObject() else runCatching { JSONObject(extra) }.getOrDefault(JSONObject())
+}
+
+/**
+ * The notification center: a per-account list of the notices of tele. It is a plain store with
+ * change listeners; the producers call [add], the screen of [tele.ui.settings.TeleNoticesActivity]
+ * reads [list]. Nothing is recorded while the master option is off.
+ *
+ * The lists live in memory (at most [MAX_SHARED] entries plus the pools of the capped kinds, 30
+ * days) and are written through to `tele_notices` on a background queue. Every method works from
+ * any thread; listeners run on the UI thread.
+ */
+object TeleNotices {
+
+    const val MAX_SHARED = 300
+    private const val MAX_AGE = 30 * 24 * 60 * 60
+
+    fun interface Listener {
+        fun onChanged(account: Int)
+    }
+
+    /** How a kind shows its text; a kind without one shows [TeleNotice.text]. UI thread. */
+    fun interface TextRenderer {
+        fun render(notice: TeleNotice): CharSequence
+    }
+
+    /** What a tap on an entry of a kind does; return false to leave it to the default. UI thread. */
+    fun interface Action {
+        fun open(fragment: BaseFragment, account: Int, notice: TeleNotice): Boolean
+    }
+
+    private class State {
+        var list = ArrayList<TeleNotice>()
+        var last = 0L
+        var unread = 0
+    }
+
+    private val lock = Any()
+    private val states = arrayOfNulls<State>(UserConfig.MAX_ACCOUNT_COUNT)
+    private val listeners = CopyOnWriteArrayList<Listener>()
+    private val renderers = HashMap<NoticeKind, TextRenderer>()
+    private val actions = HashMap<NoticeKind, Action>()
+    private val queue by lazy { DispatchQueue("teleNotices") }
+
+    @JvmStatic
+    fun enabled(): Boolean = TeleConfig.NOTICES.value
+
+    fun addListener(listener: Listener) {
+        listeners.add(listener)
+    }
+
+    fun removeListener(listener: Listener) {
+        listeners.remove(listener)
+    }
+
+    fun registerText(kind: NoticeKind, renderer: TextRenderer) {
+        renderers[kind] = renderer
+    }
+
+    fun registerAction(kind: NoticeKind, action: Action) {
+        actions[kind] = action
+    }
+
+    fun textOf(notice: TeleNotice): CharSequence = renderers[notice.kind]?.render(notice) ?: notice.text
+
+    /** Runs the action of the kind; false when the kind has none or it declined. */
+    fun open(fragment: BaseFragment, account: Int, notice: TeleNotice): Boolean =
+        actions[notice.kind]?.open(fragment, account, notice) == true
+
+    /**
+     * Adds an entry on top and returns its id, or 0 when the center is off. A notice with the key
+     * of an existing one replaces it and is unread again.
+     */
+    @JvmStatic
+    fun add(account: Int, notice: TeleNotice): Long {
+        if (!enabled() || account !in 0 until UserConfig.MAX_ACCOUNT_COUNT) return 0L
+        val id = synchronized(lock) {
+            val state = stateOf(account)
+            val id = ++state.last
+            val added = notice.copy(
+                id = id,
+                unread = true,
+                date = if (notice.date > 0) notice.date else now(),
+                buttons = notice.buttons.take(MAX_BUTTONS)
+            )
+            val removed = ArrayList<Long>()
+            if (added.key.isNotEmpty()) {
+                val old = state.list.firstOrNull { it.key == added.key }
+                if (old != null) {
+                    state.list.remove(old)
+                    removed.add(old.id)
+                }
+            }
+            state.list.add(0, added)
+            trim(state, removed)
+            state.unread = state.list.count { it.unread }
+            queue.postRunnable {
+                TeleDatabaseHelper.transaction {
+                    TeleDatabaseHelper.removeNotices(account, removed)
+                    if (removed.none { it == id }) TeleDatabaseHelper.putNotice(account, toRow(added))
+                }
+            }
+            id
+        }
+        changed(account)
+        return id
+    }
+
+    /** The entry with this key, or null. */
+    @JvmStatic
+    fun find(account: Int, key: String): TeleNotice? {
+        if (key.isEmpty() || account !in 0 until UserConfig.MAX_ACCOUNT_COUNT) return null
+        synchronized(lock) { return stateOf(account).list.firstOrNull { it.key == key } }
+    }
+
+    /** A snapshot of the entries, the newest first. */
+    @JvmStatic
+    fun list(account: Int): List<TeleNotice> {
+        if (account !in 0 until UserConfig.MAX_ACCOUNT_COUNT) return emptyList()
+        synchronized(lock) { return ArrayList(stateOf(account).list) }
+    }
+
+    @JvmStatic
+    fun unread(account: Int): Int {
+        if (account !in 0 until UserConfig.MAX_ACCOUNT_COUNT) return 0
+        synchronized(lock) { return stateOf(account).unread }
+    }
+
+    /** The unread entries of one kind, for the badges of a kind. */
+    @JvmStatic
+    fun unread(account: Int, kind: NoticeKind): Int {
+        if (account !in 0 until UserConfig.MAX_ACCOUNT_COUNT) return 0
+        synchronized(lock) { return stateOf(account).list.count { it.unread && it.kind == kind } }
+    }
+
+    /** Marks every entry read. */
+    @JvmStatic
+    fun markRead(account: Int) {
+        if (account !in 0 until UserConfig.MAX_ACCOUNT_COUNT) return
+        synchronized(lock) {
+            val state = stateOf(account)
+            if (state.unread == 0) return
+            state.list = ArrayList(state.list.map { if (it.unread) it.copy(unread = false) else it })
+            state.unread = 0
+            queue.postRunnable { TeleDatabaseHelper.markNoticesRead(account, null) }
+        }
+        changed(account)
+    }
+
+    @JvmStatic
+    fun markRead(account: Int, id: Long) {
+        if (update(account, id) { if (it.unread) it.copy(unread = false) else it }) changed(account)
+    }
+
+    /** Changes the text of an entry in place, like an edited message. */
+    @JvmStatic
+    fun setText(account: Int, id: Long, text: String) {
+        if (update(account, id) { if (it.text != text) it.copy(text = text) else it }) changed(account)
+    }
+
+    @JvmStatic
+    fun remove(account: Int, id: Long) {
+        synchronized(lock) {
+            val state = stateOf(account)
+            if (!state.list.removeAll { it.id == id }) return
+            state.unread = state.list.count { it.unread }
+            queue.postRunnable { TeleDatabaseHelper.removeNotices(account, listOf(id)) }
+        }
+        changed(account)
+    }
+
+    @JvmStatic
+    fun clear(account: Int) {
+        synchronized(lock) {
+            val state = stateOf(account)
+            if (state.list.isEmpty()) return
+            state.list = ArrayList()
+            state.unread = 0
+            queue.postRunnable { TeleDatabaseHelper.clearNotices(account) }
+        }
+        changed(account)
+    }
+
+    // returns whether the entry changed; the caller fires the listeners
+    private fun update(account: Int, id: Long, transform: (TeleNotice) -> TeleNotice): Boolean {
+        if (account !in 0 until UserConfig.MAX_ACCOUNT_COUNT) return false
+        synchronized(lock) {
+            val state = stateOf(account)
+            val index = state.list.indexOfFirst { it.id == id }
+            if (index < 0) return false
+            val old = state.list[index]
+            val updated = transform(old)
+            if (updated == old) return false
+            state.list[index] = updated
+            state.unread = state.list.count { it.unread }
+            queue.postRunnable { TeleDatabaseHelper.putNotice(account, toRow(updated)) }
+            return true
+        }
+    }
+
+    private fun changed(account: Int) {
+        AndroidUtilities.runOnUIThread { listeners.forEach { it.onChanged(account) } }
+    }
+
+    private fun now(): Int = (System.currentTimeMillis() / 1000L).toInt()
+
+    private fun stateOf(account: Int): State {
+        states[account]?.let { return it }
+        val state = State()
+        runCatching {
+            val old = now() - MAX_AGE
+            val rows = TeleDatabaseHelper.getNotices(account)
+            val dropped = ArrayList<Long>()
+            for (row in rows) {
+                val notice = fromRow(row)
+                state.last = maxOf(state.last, row.id)
+                if (notice == null || notice.date < old) dropped.add(row.id) else state.list.add(notice)
+            }
+            val removed = ArrayList<Long>()
+            trim(state, removed)
+            dropped.addAll(removed)
+            if (dropped.isNotEmpty()) queue.postRunnable { TeleDatabaseHelper.removeNotices(account, dropped) }
+        }.onFailure { FileLog.e(it) }
+        state.unread = state.list.count { it.unread }
+        states[account] = state
+        return state
+    }
+
+    // the oldest entries beyond the pool of their kind and the ones past the age go
+    private fun trim(state: State, removed: MutableList<Long>) {
+        val old = now() - MAX_AGE
+        val counts = HashMap<NoticeKind?, Int>()
+        val iterator = state.list.iterator()
+        while (iterator.hasNext()) {
+            val notice = iterator.next()
+            val pool = if (notice.kind.cap > 0) notice.kind else null
+            val limit = if (pool != null) pool.cap else MAX_SHARED
+            val count = counts[pool] ?: 0
+            if (count < limit && notice.date >= old) {
+                counts[pool] = count + 1
+            } else {
+                iterator.remove()
+                removed.add(notice.id)
+            }
+        }
+    }
+
+    private const val MAX_BUTTONS = 2
+
+    private fun toRow(notice: TeleNotice): TeleDatabaseHelper.NoticeRow {
+        val buttons = JSONArray()
+        for (button in notice.buttons) buttons.put(JSONArray().put(button.text).put(button.url))
+        return TeleDatabaseHelper.NoticeRow(
+            notice.id, notice.kind.id, notice.tone.id, notice.date, notice.key, notice.rev, notice.title, notice.text,
+            buttons.toString(), notice.photo, notice.peer, notice.messageId, notice.topicId, notice.extra, notice.unread
+        )
+    }
+
+    private fun fromRow(row: TeleDatabaseHelper.NoticeRow): TeleNotice? {
+        val kind = NoticeKind.of(row.kind) ?: return null
+        val buttons = ArrayList<NoticeButton>()
+        runCatching {
+            val array = JSONArray(row.buttons)
+            for (i in 0 until array.length()) {
+                val pair = array.getJSONArray(i)
+                buttons.add(NoticeButton(pair.getString(0), pair.getString(1)))
+            }
+        }
+        return TeleNotice(
+            kind = kind, title = row.title, text = row.text, tone = NoticeTone.of(row.tone), date = row.date, key = row.key,
+            rev = row.rev, buttons = buttons, photo = row.photo, peer = row.peer, messageId = row.messageId,
+            topicId = row.topicId, extra = row.extra, id = row.id, unread = row.unread
+        )
+    }
+}
