@@ -0,0 +1,264 @@
+package tele.ui.settings
+
+import android.content.Context
+import android.os.Bundle
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.View
+import android.view.ViewGroup
+import android.widget.HorizontalScrollView
+import android.widget.LinearLayout
+import android.widget.TextView
+import androidx.recyclerview.widget.LinearLayoutManager
+import androidx.recyclerview.widget.RecyclerView
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.R
+import org.telegram.messenger.UserConfig
+import org.telegram.messenger.browser.Browser
+import org.telegram.ui.ActionBar.ActionBar
+import org.telegram.ui.ActionBar.ActionBarMenuItem
+import org.telegram.ui.ActionBar.AlertDialog
+import org.telegram.ui.ActionBar.BaseFragment
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.ChatActivity
+import org.telegram.ui.Components.BulletinFactory
+import org.telegram.ui.Components.LayoutHelper
+import org.telegram.ui.Components.RecyclerListView
+import tele.helpers.NoticeKind
+import tele.helpers.TeleNotice
+import tele.helpers.TeleNotices
+import tele.ui.TeleNoticeCell
+
+/**
+ * The notification center of tele (tele 0205): the notices of the selected account, the newest
+ * first, filtered by a strip of chips. What it shows comes from [TeleNotices]; a kind changes how
+ * an entry looks or opens with [TeleNotices.registerText] and [TeleNotices.registerAction].
+ */
+class TeleNoticesActivity : BaseFragment() {
+
+    /** The chips of the strip; a kind that has a chip of its own leaves the shared one. */
+    private enum class Filter(val title: Int, val matches: (NoticeKind) -> Boolean) {
+        ALL(R.string.TeleNoticesFilterAll, { true }),
+        LIMITS(R.string.TeleNoticesFilterLimits, { it == NoticeKind.LIMIT }),
+        SERVER(R.string.TeleNoticesFilterServer, { it == NoticeKind.SERVER }),
+        TELE(R.string.TeleNoticesFilterTele, { it != NoticeKind.LIMIT && it != NoticeKind.SERVER })
+    }
+
+    private val account = UserConfig.selectedAccount
+    private var filter = Filter.ALL
+    private var shown: List<TeleNotice> = emptyList()
+    private var built = false
+    private val fresh = HashSet<Long>()
+    private var adapter: Adapter? = null
+    private var list: RecyclerListView? = null
+    private val listener = TeleNotices.Listener { target -> if (target == account) changed() }
+    private var clearItem: ActionBarMenuItem? = null
+
+    private var chips: LinearLayout? = null
+    private val timeTick = object : Runnable {
+        override fun run() {
+            val view = list ?: return
+            for (i in 0 until view.childCount) {
+                val cell = view.getChildAt(i) as? TeleNoticeCell ?: continue
+                val position = view.getChildAdapterPosition(cell)
+                shown.getOrNull(position)?.let { cell.refreshTime(it) }
+            }
+            AndroidUtilities.runOnUIThread(this, TIME_REFRESH)
+        }
+    }
+
+    override fun createView(context: Context): View {
+        actionBar.setBackButtonImage(R.drawable.ic_ab_back)
+        actionBar.setAllowOverlayTitle(true)
+        actionBar.setTitle(LocaleController.getString(R.string.TeleNotices))
+        actionBar.setActionBarMenuOnItemClick(object : ActionBar.ActionBarMenuOnItemClick() {
+            override fun onItemClick(id: Int) {
+                if (id == -1) finishFragment() else if (id == MENU_CLEAR) confirmClear()
+            }
+        })
+        clearItem = actionBar.createMenu().addItem(MENU_CLEAR, R.drawable.msg_delete)
+
+        val root = LinearLayout(context)
+        root.orientation = LinearLayout.VERTICAL
+        root.setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundWhite))
+        fragmentView = root
+
+        val scroll = HorizontalScrollView(context)
+        scroll.isHorizontalScrollBarEnabled = false
+        val strip = LinearLayout(context)
+        strip.setPadding(AndroidUtilities.dp(12f), AndroidUtilities.dp(8f), AndroidUtilities.dp(12f), AndroidUtilities.dp(8f))
+        scroll.addView(strip, ViewGroup.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT))
+        chips = strip
+        root.addView(scroll, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT))
+
+        val recycler = RecyclerListView(context)
+        recycler.layoutManager = LinearLayoutManager(context)
+        recycler.isVerticalScrollBarEnabled = false
+        adapter = Adapter(context)
+        recycler.adapter = adapter
+        recycler.setOnItemClickListener { _, position -> shown.getOrNull(position)?.let { open(it) } }
+        recycler.setOnItemLongClickListener { _, position ->
+            shown.getOrNull(position)?.let { showActions(it) }
+            true
+        }
+        list = recycler
+        root.addView(recycler, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, 0, 1f))
+
+        TeleNotices.addListener(listener)
+        updateChips()
+        changed()
+        return root
+    }
+
+    override fun onResume() {
+        super.onResume()
+        changed()
+        AndroidUtilities.cancelRunOnUIThread(timeTick)
+        AndroidUtilities.runOnUIThread(timeTick, TIME_REFRESH)
+    }
+
+    override fun onPause() {
+        super.onPause()
+        AndroidUtilities.cancelRunOnUIThread(timeTick)
+    }
+
+    override fun onFragmentDestroy() {
+        super.onFragmentDestroy()
+        TeleNotices.removeListener(listener)
+        AndroidUtilities.cancelRunOnUIThread(timeTick)
+    }
+
+    private fun changed() {
+        if (fragmentView == null) return
+        val all = TeleNotices.list(account)
+        var unread = false
+        for (notice in all) {
+            if (notice.unread) {
+                fresh.add(notice.id)
+                unread = true
+            }
+        }
+        val next = all.filter { filter.matches(it.kind) }
+        if (!built || next != shown) {
+            built = true
+            shown = next
+            adapter?.notifyDataSetChanged()
+        }
+        clearItem?.visibility = if (all.isEmpty()) View.GONE else View.VISIBLE
+        // the entries stay tinted for this visit, then count as read
+        if (unread) AndroidUtilities.runOnUIThread { TeleNotices.markRead(account) }
+    }
+
+    private fun updateChips() {
+        val strip = chips ?: return
+        strip.removeAllViews()
+        for (value in Filter.values()) {
+            val active = value == filter
+            val chip = TextView(strip.context)
+            chip.text = LocaleController.getString(value.title)
+            chip.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14f)
+            chip.gravity = Gravity.CENTER
+            chip.setPadding(AndroidUtilities.dp(14f), AndroidUtilities.dp(7f), AndroidUtilities.dp(14f), AndroidUtilities.dp(7f))
+            chip.setTextColor(Theme.getColor(if (active) Theme.key_featuredStickers_buttonText else Theme.key_windowBackgroundWhiteBlackText))
+            chip.background = Theme.createRoundRectDrawable(AndroidUtilities.dp(16f), Theme.getColor(if (active) Theme.key_featuredStickers_addButton else Theme.key_windowBackgroundGray))
+            chip.setOnClickListener {
+                if (filter != value) {
+                    filter = value
+                    built = false
+                    updateChips()
+                    changed()
+                }
+            }
+            strip.addView(chip, LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT).apply { rightMargin = AndroidUtilities.dp(8f) })
+        }
+    }
+
+    private fun open(notice: TeleNotice) {
+        if (TeleNotices.open(this, account, notice)) return
+        if (notice.peer != 0L) {
+            val args = Bundle()
+            if (notice.peer < 0) args.putLong("chat_id", -notice.peer) else args.putLong("user_id", notice.peer)
+            if (notice.messageId != 0) args.putInt("message_id", notice.messageId)
+            presentFragment(ChatActivity(args))
+        } else if (notice.kind == NoticeKind.UPDATE && notice.buttons.isNotEmpty()) {
+            openLink(notice.buttons[0].url)
+        }
+    }
+
+    // the stored links come from the server too: only the web and Telegram links open
+    private fun openLink(url: String) {
+        val context = parentActivity ?: return
+        if (url.startsWith("https://", true) || url.startsWith("http://", true) || url.startsWith("tg://", true)) {
+            Browser.openUrl(context, url)
+        }
+    }
+
+    private fun showActions(notice: TeleNotice) {
+        val activity = parentActivity ?: return
+        val labels = arrayOf<CharSequence>(LocaleController.getString(R.string.Copy), LocaleController.getString(R.string.Delete))
+        val dialog = AlertDialog.Builder(activity, resourceProvider)
+            .setTitle(notice.title.ifEmpty { null })
+            .setItems(labels) { _, which ->
+                if (which == 0) {
+                    val full = listOf(notice.title, TeleNotices.textOf(notice).toString()).filter { it.isNotEmpty() }.joinToString("\n")
+                    AndroidUtilities.addToClipboard(full)
+                    BulletinFactory.of(this).createCopyBulletin(LocaleController.getString(R.string.TextCopied)).show()
+                } else {
+                    TeleNotices.remove(account, notice.id)
+                }
+            }
+            .create()
+        showDialog(dialog)
+        dialog.setItemColor(1, Theme.getColor(Theme.key_text_RedBold), Theme.getColor(Theme.key_text_RedRegular))
+    }
+
+    private fun confirmClear() {
+        val activity = parentActivity ?: return
+        AlertDialog.Builder(activity, resourceProvider)
+            .setTitle(LocaleController.getString(R.string.TeleNotices))
+            .setMessage(LocaleController.getString(R.string.TeleNoticesClearAsk))
+            .setPositiveButton(LocaleController.getString(R.string.Clear)) { _, _ -> TeleNotices.clear(account) }
+            .setNegativeButton(LocaleController.getString(R.string.Cancel), null)
+            .show()
+    }
+
+    private inner class Adapter(private val context: Context) : RecyclerListView.SelectionAdapter() {
+        override fun getItemCount(): Int = maxOf(shown.size, 1)
+        override fun isEnabled(holder: RecyclerView.ViewHolder): Boolean = shown.isNotEmpty()
+        override fun getItemViewType(position: Int): Int = if (shown.isEmpty()) TYPE_EMPTY else TYPE_ENTRY
+
+        override fun onCreateViewHolder(parent: ViewGroup, viewType: Int): RecyclerView.ViewHolder {
+            val view: View = if (viewType == TYPE_EMPTY) {
+                TextView(context).apply {
+                    setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2))
+                    setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14f)
+                    gravity = Gravity.CENTER
+                    setPadding(AndroidUtilities.dp(32f), AndroidUtilities.dp(48f), AndroidUtilities.dp(32f), AndroidUtilities.dp(16f))
+                }
+            } else {
+                TeleNoticeCell(context).apply { onButton = { button -> openLink(button.url) } }
+            }
+            view.layoutParams = RecyclerView.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT)
+            return RecyclerListView.Holder(view)
+        }
+
+        override fun onBindViewHolder(holder: RecyclerView.ViewHolder, position: Int) {
+            if (getItemViewType(position) == TYPE_EMPTY) {
+                val empty = TeleNotices.list(account).isEmpty()
+                (holder.itemView as TextView).text = LocaleController.getString(if (empty) R.string.TeleNoticesEmpty else R.string.TeleNoticesNothing)
+                return
+            }
+            val notice = shown[position]
+            (holder.itemView as TeleNoticeCell).set(notice, fresh.contains(notice.id))
+        }
+    }
+
+    companion object {
+        const val MODE_NOTICES = "notices_list"
+        private const val MENU_CLEAR = 9640
+        private const val TYPE_EMPTY = 0
+        private const val TYPE_ENTRY = 1
+        private const val TIME_REFRESH = 30_000L
+    }
+}
