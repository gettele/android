+        val result = ArrayList<NoticeRow>()
+        db.rawQuery("SELECT id, kind, tone, date, key, rev, title, text, buttons, photo, peer, message_id, topic_id, extra, unread FROM tele_notices WHERE account = ? ORDER BY date DESC, id DESC", arrayOf(account.toString())).use { c ->
+            while (c.moveToNext()) {
+                result.add(NoticeRow(c.getLong(0), c.getString(1), c.getString(2), c.getInt(3), c.getString(4), c.getInt(5), c.getString(6), c.getString(7), c.getString(8), c.getString(9), c.getLong(10), c.getInt(11), c.getLong(12), c.getString(13), c.getInt(14) != 0))
+            }
+        }
+        return result
+    }
+
+    fun putNotice(account: Int, row: NoticeRow) {
+        val db = helper?.writableDatabase ?: return
+        val values = ContentValues().apply {
+            put("account", account)
+            put("id", row.id)
+            put("kind", row.kind)
+            put("tone", row.tone)
+            put("date", row.date)
+            put("key", row.key)
+            put("rev", row.rev)
+            put("title", row.title)
+            put("text", row.text)
+            put("buttons", row.buttons)
+            put("photo", row.photo)
+            put("peer", row.peer)
+            put("message_id", row.messageId)
+            put("topic_id", row.topicId)
+            put("extra", row.extra)
+            put("unread", if (row.unread) 1 else 0)
+        }
+        db.insertWithOnConflict("tele_notices", null, values, SQLiteDatabase.CONFLICT_REPLACE)
+    }
+
+    fun removeNotices(account: Int, ids: Collection<Long>) {
+        val db = helper?.writableDatabase ?: return
+        for (id in ids) db.delete("tele_notices", "account = ? AND id = ?", arrayOf(account.toString(), id.toString()))
+    }
+
+    fun markNoticesRead(account: Int, ids: Collection<Long>?) {
+        val db = helper?.writableDatabase ?: return
+        if (ids == null) {
+            db.execSQL("UPDATE tele_notices SET unread = 0 WHERE account = ?", arrayOf<Any>(account.toString()))
+            return
+        }
+        for (id in ids) db.execSQL("UPDATE tele_notices SET unread = 0 WHERE account = ? AND id = ?", arrayOf<Any>(account.toString(), id.toString()))
+    }
+
+    fun clearNotices(account: Int) {
+        val db = helper?.writableDatabase ?: return
+        db.delete("tele_notices", "account = ?", arrayOf(account.toString()))
+    }
