diff --git a/TMessagesProj/src/main/java/tele/helpers/TeleFloodWait.kt b/TMessagesProj/src/main/java/tele/helpers/TeleFloodWait.kt
new file mode 100644
index 000000000..14ce582b1
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/TeleFloodWait.kt
@@ -0,0 +1,321 @@
+package tele.helpers
+
+import android.os.SystemClock
+import android.widget.TextView
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.R
+import org.telegram.messenger.UserConfig
+import org.telegram.tgnet.ConnectionsManager
+import org.telegram.tgnet.TLRPC
+import org.telegram.tgnet.tl.TL_stars
+import org.telegram.tgnet.tl.TL_stories
+import org.telegram.ui.ActionBar.BaseFragment
+import org.telegram.ui.Cells.DialogsHintCell
+import org.telegram.ui.Components.Bulletin
+import org.telegram.ui.Components.BulletinFactory
+import org.telegram.ui.LaunchActivity
+import tele.TeleConfig
+import tele.ui.settings.TeleNoticesActivity
+import java.lang.ref.WeakReference
+
+/**
+ * The rate limits of Telegram (tele 0205): a countdown toast from [TOAST_FROM] seconds, a bar above
+ * the chat list from [BAR_FROM], and entries of the notification center. The events come from
+ * tgnet ([ConnectionsManager.onTeleFloodWait]), which only sends them while [enabled].
+ */
+object TeleFloodWait {
+
+    private const val TOAST_FROM = 5
+    private const val BAR_FROM = 60
+    private const val EXPIRY_TOAST_FROM = 30
+    private const val TOAST_DURATION = 10_000L
+    private const val EPISODE_GAP = 60_000L
+    private const val RESEND_SLACK = 1_000L
+    private const val TICK = 250L
+
+    private enum class Action(val limited: Int, val again: Int) {
+        SEND(R.string.TeleLimitSend, R.string.TeleAgainSend),
+        REACT(R.string.TeleLimitReact, R.string.TeleAgainReact),
+        JOIN(R.string.TeleLimitJoin, R.string.TeleAgainJoin),
+        SEARCH(R.string.TeleLimitSearch, R.string.TeleAgainSearch),
+        CONTACTS(R.string.TeleLimitContacts, R.string.TeleAgainContacts),
+        PAYMENT(R.string.TeleLimitPayment, R.string.TeleAgainPayment)
+    }
+
+    private class Limit(val account: Int, val action: Action, val episode: String, val started: Long) {
+        var deadline = 0L
+        val requests = HashSet<Int>()
+        var bulletin: Bulletin? = null
+        var label: TextView? = null
+        var shown = ""
+        var dismissed = false
+    }
+
+    private class Ended(val episode: String, val at: Long)
+
+    private class Host(val account: Int, val refresh: Runnable) {
+        var visible = false
+    }
+
+    // everything below runs on the UI thread
+    private val limits = ArrayList<Limit>()
+    private val ended = HashMap<String, Ended>()
+    private val hosts = ArrayList<Host>()
+    private val barCells = HashMap<Int, WeakReference<DialogsHintCell>>()
+    private var ticking = false
+    private val ticker = Runnable { tick() }
+
+    private val classes: List<Pair<Class<*>, Action>> by lazy {
+        listOf(
+            TLRPC.TL_messages_sendMessage::class.java to Action.SEND,
+            TLRPC.TL_messages_sendMedia::class.java to Action.SEND,
+            TLRPC.TL_messages_sendMultiMedia::class.java to Action.SEND,
+            TLRPC.TL_messages_forwardMessages::class.java to Action.SEND,
+            TLRPC.TL_messages_sendInlineBotResult::class.java to Action.SEND,
+            TLRPC.TL_messages_sendReaction::class.java to Action.REACT,
+            TLRPC.TL_messages_sendPaidReaction::class.java to Action.REACT,
+            TL_stories.TL_stories_sendReaction::class.java to Action.REACT,
+            TLRPC.TL_channels_joinChannel::class.java to Action.JOIN,
+            TLRPC.TL_messages_importChatInvite::class.java to Action.JOIN,
+            TLRPC.TL_contacts_search::class.java to Action.SEARCH,
+            TLRPC.TL_messages_search::class.java to Action.SEARCH,
+            TLRPC.TL_messages_searchGlobal::class.java to Action.SEARCH,
+            TLRPC.TL_contacts_resolveUsername::class.java to Action.SEARCH,
+            TLRPC.TL_contacts_importContacts::class.java to Action.CONTACTS,
+            TLRPC.TL_contacts_addContact::class.java to Action.CONTACTS,
+            TLRPC.TL_payments_getPaymentForm::class.java to Action.PAYMENT,
+            TLRPC.TL_payments_sendPaymentForm::class.java to Action.PAYMENT,
+            TL_stars.TL_payments_sendStarsForm::class.java to Action.PAYMENT
+        )
+    }
+
+    private fun classify(request: Class<*>?): Action? {
+        if (request == null) return null
+        return classes.firstOrNull { it.first.isAssignableFrom(request) }?.second
+    }
+
+    /** The toasts and the bar. */
+    private fun shown(): Boolean = TeleNotices.enabled() && TeleConfig.NOTICES_LIMITS.value
+
+    /** The entries of the center. */
+    private fun logged(): Boolean = TeleNotices.enabled() && TeleConfig.NOTICES_LIMITS.value
+
+    /** Whether tgnet should send the events; the Java side asks it before every request too. */
+    @JvmStatic
+    fun enabled(): Boolean = shown() || logged()
+
+    /** Tells every native connection about the option. Call it when an option of the center flips. */
+    @JvmStatic
+    fun refresh() {
+        val on = enabled()
+        for (account in 0 until UserConfig.MAX_ACCOUNT_COUNT) {
+            ConnectionsManager.native_setTeleFloodWait(account, on)
+        }
+        if (!on) AndroidUtilities.runOnUIThread { reset() }
+    }
+
+    /** Called by tgnet on its own thread: a request got a wait ([resent] false) or went out again. */
+    @JvmStatic
+    fun onEvent(account: Int, token: Int, seconds: Int, resent: Boolean, error: String?) {
+        if (!enabled() || account !in 0 until UserConfig.MAX_ACCOUNT_COUNT) return
+        val request = ConnectionsManager.getInstance(account).teleRequestClass(token)
+        AndroidUtilities.runOnUIThread {
+            if (resent) onResent(account, token) else onWait(account, token, request, seconds, error.orEmpty())
+        }
+    }
+
+    private fun onWait(account: Int, token: Int, request: Class<*>?, seconds: Int, error: String) {
+        if (!enabled() || seconds <= 0) return
+        val action = classify(request) ?: return
+        val key = key(account, action)
+        val now = SystemClock.elapsedRealtime()
+        val deadline = now + seconds * 1000L
+        var limit = limits.firstOrNull { it.account == account && it.action == action }
+        if (limit == null) {
+            val last = ended.remove(key)
+            val recent = last != null && now - last.at < EPISODE_GAP
+            limit = Limit(account, action, if (recent) last!!.episode else (System.currentTimeMillis() / 1000L).toString(), now)
+            limit.deadline = deadline
+            limits.add(limit)
+        } else if (deadline > limit.deadline) {
+            limit.deadline = deadline
+        }
+        limit.requests.add(token)
+        if (logged()) log(limit)
+        val total = limit.deadline - limit.started
+        if (shown() && total >= TOAST_FROM * 1000L) toast(limit, now)
+        if (shown() && total >= BAR_FROM * 1000L) notifyHosts()
+        startTicking()
+    }
+
+    private fun onResent(account: Int, token: Int) {
+        val limit = limits.firstOrNull { it.account == account && token in it.requests } ?: return
+        limit.requests.remove(token)
+        if (SystemClock.elapsedRealtime() + RESEND_SLACK >= limit.deadline) {
+            limits.remove(limit)
+            finish(limit)
+        }
+    }
+
+    private fun startTicking() {
+        if (!ticking) {
+            ticking = true
+            AndroidUtilities.runOnUIThread(ticker, TICK)
+        }
+    }
+
+    private fun tick() {
+        ticking = false
+        val now = SystemClock.elapsedRealtime()
+        val finished = ArrayList<Limit>()
+        val iterator = limits.iterator()
+        while (iterator.hasNext()) {
+            val limit = iterator.next()
+            if (now >= limit.deadline) {
+                finished.add(limit)
+                iterator.remove()
+                continue
+            }
+            val bulletin = limit.bulletin
+            val label = limit.label
+            if (bulletin != null && label != null && bulletin.isShowing) {
+                val text = countdown(limit, now)
+                if (limit.shown != text) {
+                    limit.shown = text
+                    label.text = text
+                }
+            }
+        }
+        for (limit in finished) finish(limit)
+        notifyHosts()
+        if (limits.isNotEmpty()) startTicking()
+    }
+
+    private fun finish(limit: Limit) {
+        ended[key(limit.account, limit.action)] = Ended(limit.episode, SystemClock.elapsedRealtime())
+        limit.bulletin?.let { if (it.isShowing) it.hide() }
+        notifyHosts()
+        val total = seconds(limit.deadline - limit.started)
+        if (logged()) {
+            TeleNotices.add(limit.account, TeleNotice(
+                kind = NoticeKind.LIMIT,
+                key = "limit-end:${limit.episode}:${limit.action.ordinal}",
+                title = LocaleController.getString(limit.action.again),
+                text = LocaleController.formatString(R.string.TeleLimitAfter, duration(total))
+            ))
+        }
+        if (shown() && total >= EXPIRY_TOAST_FROM && limit.account == UserConfig.selectedAccount && LaunchActivity.isActive) {
+            BulletinFactory.global().createSimpleBulletin(R.raw.timer_3, LocaleController.getString(limit.action.again)).show()
+        }
+    }
+
+    private fun log(limit: Limit) {
+        TeleNotices.add(limit.account, TeleNotice(
+            kind = NoticeKind.LIMIT,
+            key = "limit:${limit.episode}:${limit.action.ordinal}",
+            title = LocaleController.getString(limit.action.limited),
+            text = LocaleController.formatString(R.string.TeleLimitFor, duration(seconds(limit.deadline - limit.started)))
+        ))
+    }
+
+    private fun toast(limit: Limit, now: Long) {
+        if (limit.bulletin?.isShowing == true) return
+        if (limit.account != UserConfig.selectedAccount || !LaunchActivity.isActive) return
+        limit.shown = countdown(limit, now)
+        val bulletin = BulletinFactory.global().createSimpleBulletin(
+            R.raw.timer_3, limit.shown, 1, minOf(limit.deadline - now, TOAST_DURATION).toInt()
+        )
+        limit.bulletin = bulletin
+        limit.label = (bulletin.layout as? Bulletin.LottieLayout)?.textView
+        bulletin.show()
+    }
+
+    private fun reset() {
+        if (enabled()) return
+        for (limit in limits) limit.bulletin?.let { if (it.isShowing) it.hide() }
+        limits.clear()
+        ended.clear()
+        notifyHosts()
+    }
+
+    private fun key(account: Int, action: Action) = "$account:${action.ordinal}"
+
+    private fun seconds(ms: Long): Int = ((maxOf(ms, 0L) + 999L) / 1000L).toInt()
+
+    private fun countdown(limit: Limit, now: Long): String =
+        LocaleController.formatString(R.string.TeleLimitCountdown, LocaleController.getString(limit.action.limited), duration(seconds(limit.deadline - now)))
+
+    private fun duration(total: Int): String = when {
+        total >= 3600 -> {
+            val minutes = (total % 3600) / 60
+            if (minutes > 0) LocaleController.formatString(R.string.TeleDurationHM, total / 3600, minutes)
+            else LocaleController.formatString(R.string.TeleDurationH, total / 3600)
+        }
+        total >= 60 -> {
+            val rest = total % 60
+            if (rest > 0) LocaleController.formatString(R.string.TeleDurationMS, total / 60, rest)
+            else LocaleController.formatString(R.string.TeleDurationM, total / 60)
+        }
+        else -> LocaleController.formatString(R.string.TeleDurationS, total)
+    }
+
+    private class Bar(val title: String, val text: String)
+
+    private fun bar(account: Int): Bar? {
+        if (!shown()) return null
+        val now = SystemClock.elapsedRealtime()
+        val best = limits
+            .filter { it.account == account && !it.dismissed && it.deadline > now && it.deadline - it.started >= BAR_FROM * 1000L }
+            .maxByOrNull { it.deadline } ?: return null
+        return Bar(
+            LocaleController.getString(best.action.limited),
+            LocaleController.formatString(R.string.TeleLimitLeft, duration(seconds(best.deadline - now)))
+        )
+    }
+
+    @JvmStatic
+    fun hasBar(account: Int): Boolean = bar(account) != null
+
+    /** Fills the hint cell of the chat list with the longest wait; the caller checked [hasBar]. */
+    @JvmStatic
+    fun fillBar(cell: DialogsHintCell, fragment: BaseFragment, account: Int, refresh: Runnable) {
+        val bar = bar(account) ?: return
+        cell.setText(bar.title, bar.text, false, false)
+        cell.setOnClickListener { fragment.presentFragment(TeleNoticesActivity()) }
+        cell.setOnCloseListener {
+            for (limit in limits) if (limit.account == account) limit.dismissed = true
+            refresh.run()
+        }
+        barCells[account] = WeakReference(cell)
+    }
+
+    /** The chat list asks to be told when the bar appears or goes. UI thread. */
+    @JvmStatic
+    fun attachBar(account: Int, refresh: Runnable) {
+        if (hosts.any { it.refresh === refresh }) return
+        val host = Host(account, refresh)
+        host.visible = bar(account) != null
+        hosts.add(host)
+        if (host.visible) refresh.run()
+    }
+
+    @JvmStatic
+    fun detachBar(refresh: Runnable) {
+        hosts.removeAll { it.refresh === refresh }
+    }
+
+    // a bar that stays gets its text updated in place; one that appears or goes asks the list for a rebuild
+    private fun notifyHosts() {
+        for (host in ArrayList(hosts)) {
+            val bar = bar(host.account)
+            val visible = bar != null
+            if (visible != host.visible) {
+                host.visible = visible
+                host.refresh.run()
+            } else if (bar != null) {
+                barCells[host.account]?.get()?.messageView?.text = bar.text
+            }
+        }
+    }
+}
