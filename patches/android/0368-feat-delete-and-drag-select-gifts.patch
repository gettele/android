+    /** The same gifts the single-gift menu deletes: basic, not refunded, owned here (desktop 0340). */
+    private fun canDelete(selection: GiftSelection, gift: TL_stars.SavedStarGift): Boolean {
+        val base = gift.gift as? TL_stars.TL_starGift ?: return false
+        return !base.limited && base.availability_total <= 0 && !base.auction && !gift.refunded
+    }
+
+    private fun delete(selection: GiftSelection, fragment: BaseFragment?, context: Context, resourcesProvider: Theme.ResourcesProvider?) {
+        val gifts = selection.gifts
+        AlertDialog.Builder(context, resourcesProvider)
+            .setTitle(LocaleController.getString(R.string.Gift2DeleteOption))
+            .setMessage(LocaleController.formatPluralString("TeleGiftsDeleteConfirm", gifts.size))
+            .setPositiveButton(LocaleController.getString(R.string.Delete)) { _, _ ->
+                StarsLock.guard(fragment, "delete") {
+                    if (!selection.isBusy) runDelete(selection, fragment, gifts)
+                }
+            }
+            .setNegativeButton(LocaleController.getString(R.string.Cancel), null)
+            .makeRed(AlertDialog.BUTTON_POSITIVE)
+            .show()
+    }
+
+    private fun runDelete(selection: GiftSelection, fragment: BaseFragment?, gifts: List<TL_stars.SavedStarGift>) {
+        val account = selection.currentAccount
+        runBatch(
+            selection, fragment, "gifts-deleted", gifts,
+            LocaleController.formatPluralString("TeleGiftsDeleted", gifts.size),
+            { index, batch, done ->
+                val gift = gifts[index]
+                val request = TL_stars.deleteStarGift()
+                request.stargift = selection.list.getInput(gift)
+                batch.send(request) { res, err ->
+                    if (res is TLRPC.TL_boolTrue) {
+                        // counters first: the profile re-checks them when the list changes (gifts tab hides at 0)
+                        val dialogId = selection.dialogId
+                        if (dialogId >= 0) {
+                            MessagesController.getInstance(account).getUserFull(dialogId)?.let {
+                                it.stargifts_count = Math.max(0, it.stargifts_count - 1)
+                                if (it.stargifts_count <= 0) it.flags2 = it.flags2 and 256.inv()
+                            }
+                        } else {
+                            MessagesController.getInstance(account).getChatFull(-dialogId)?.let {
+                                it.stargifts_count = Math.max(0, it.stargifts_count - 1)
+                                if (it.stargifts_count <= 0) it.flags2 = it.flags2 and 262144.inv()
+                            }
+                        }
+                        StarsController.getInstance(account).removeProfileGiftLocally(dialogId, gift)
+                        selection.remove(gift)
+                        done(null)
+                    } else {
+                        done(GiftBatch.Failure.of(err, "DELETE_FAILED", false))
+                    }
+                }
+            }
+        )
+    }
 }
diff --git a/TMessagesProj/src/main/java/tele/helpers/GiftDragSelect.kt b/TMessagesProj/src/main/java/tele/helpers/GiftDragSelect.kt
new file mode 100644
index 000000000..2f2f1c6a6
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/GiftDragSelect.kt
@@ -0,0 +1,120 @@
+package tele.helpers
+
+import android.view.MotionEvent
+import android.view.View
+import android.view.ViewConfiguration
+import androidx.recyclerview.widget.RecyclerView
+import org.telegram.tgnet.tl.TL_stars
+import org.telegram.ui.Components.RecyclerListView
+import org.telegram.ui.Gifts.GiftSheet
+
+/**
+ * Drag-select of gifts (desktop 0340): while the selection is on, a long press on a gift starts a
+ * range drag instead of the menu. The anchor decides the mode — an unpicked gift selects the range,
+ * a picked one unpicks it; gifts outside the current range go back to how they were before the drag.
+ */
+class GiftDragSelect(
+    private val selection: GiftSelection,
+    private val list: RecyclerListView,
+    private val onChanged: Runnable
+) {
+
+    private var anchor = -1
+    private var select = true
+    private var enabled = false
+    private var from = -1
+    private var till = -1
+    private var startX = 0f
+    private var startY = 0f
+    private val before = HashSet<String>()
+    private val slop = ViewConfiguration.get(list.context).scaledTouchSlop
+
+    /** True from the long press on: the list must not scroll or click under the finger. */
+    val isDragging: Boolean get() = anchor >= 0
+
+    /** A long press on a gift while picking: takes the gesture over from the item menu. */
+    fun begin(view: View, position: Int, x: Float, y: Float): Boolean {
+        if (!selection.isActive || selection.isBusy) return false
+        val gift = giftOf(view) ?: return false
+        anchor = position
+        select = !selection.isSelected(gift)
+        before.clear()
+        for (picked in selection.gifts) before.add(GiftSelection.key(picked))
+        enabled = false
+        from = position
+        till = position + 1
+        startX = view.left + x
+        startY = view.top + y
+        // the pressed cell must not fire its click when the finger lifts
+        list.cancelClickRunnables(true)
+        return true
+    }
+
+    fun touch(event: MotionEvent) {
+        if (anchor < 0) return
+        when (event.actionMasked) {
+            MotionEvent.ACTION_MOVE -> {
+                if (!selection.isActive || selection.isBusy) {
+                    end()
+                    return
+                }
+                if (!enabled) {
+                    val dx = event.x - startX
+                    val dy = event.y - startY
+                    if (dx * dx + dy * dy <= slop * slop) return
+                    enabled = true
+                }
+                update(event.x, event.y)
+            }
+            MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> end()
+        }
+    }
+
+    fun end() {
+        anchor = -1
+        enabled = false
+        from = -1
+        till = -1
+        before.clear()
+    }
+
+    private fun update(x: Float, y: Float) {
+        val at = positionAt(x, y) ?: return
+        val newFrom = minOf(anchor, at)
+        val newTill = maxOf(anchor, at) + 1
+        if (newFrom == from && newTill == till) return
+        var changed = false
+        // gifts that left the range go back to their pre-drag state
+        for (i in from until till) {
+            if (i < newFrom || i >= newTill) {
+                val gift = giftAt(i) ?: continue
+                changed = selection.setSelected(gift, before.contains(GiftSelection.key(gift))) || changed
+            }
+        }
+        // gifts that entered it take the drag mode
+        for (i in newFrom until newTill) {
+            if (i < from || i >= till) {
+                val gift = giftAt(i) ?: continue
+                changed = selection.setSelected(gift, select) || changed
+            }
+        }
+        from = newFrom
+        till = newTill
+        if (changed) onChanged.run()
+    }
+
+    private fun positionAt(x: Float, y: Float): Int? {
+        val child = list.findChildViewUnder(x, y) ?: return null
+        if (giftOf(child) == null) return null
+        val position = list.getChildAdapterPosition(child)
+        return if (position == RecyclerView.NO_POSITION) null else position
+    }
+
+    private fun giftAt(position: Int): TL_stars.SavedStarGift? {
+        val child = list.findViewHolderForAdapterPosition(position)?.itemView ?: return null
+        return giftOf(child)
+    }
+
+    private fun giftOf(view: View): TL_stars.SavedStarGift? =
+        (view as? GiftSheet.GiftCell)?.getSavedGift()
+}
