+++ b/TMessagesProj/src/main/java/tele/helpers/GiftSelection.kt
@@ -93,6 +93,17 @@ class GiftSelection(
         return true
     }
 
+    /** Picks or unpicks a gift to [on]; false when nothing changed (not active, busy, or already so). */
+    fun setSelected(gift: TL_stars.SavedStarGift, on: Boolean): Boolean {
+        if (!isActive || isBusy) return false
+        val key = key(gift)
+        val had = selected.containsKey(key)
+        if (had == on) return false
+        if (on) selected[key] = gift else selected.remove(key)
+        fire()
+        return true
+    }
+
     fun remove(gift: TL_stars.SavedStarGift) {
         if (selected.remove(key(gift)) != null) fire()
     }
