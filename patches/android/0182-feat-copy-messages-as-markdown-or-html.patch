+package tele.helpers
+
+import android.text.Spanned
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.MessageObject
+import org.telegram.messenger.R
+import org.telegram.tgnet.TLRPC
+import org.telegram.ui.ChatActivity
+import org.telegram.ui.Components.BulletinFactory
+import org.telegram.ui.Components.QuoteSpan
+import org.telegram.ui.Components.TextStyleSpan
+import org.telegram.ui.Components.URLSpanReplacement
+import org.telegram.ui.Components.URLSpanUserMention
+import org.telegram.utils.code.highlight.CodeHighlighting
+import tele.TeleConfig
+
+// copies a message as Markdown or HTML source (tele 0139); the text and the entities are read, never changed
+object CopyMarkup {
+
+    // the order decides which of equal ranges opens first
+    private enum class Kind { QUOTE, PRE, INLINE, CODE }
+
+    private enum class Type { BOLD, ITALIC, UNDERLINE, STRIKE, SPOILER, CODE, PRE, QUOTE, LINK }
+
+    private class Span(val type: Type, val kind: Kind, var from: Int, var till: Int, val data: String) {
+        var open = ""
+        var close = ""
+
+        fun piece(from: Int, till: Int) = Span(type, kind, from, till, data)
+    }
+
+    private class Writer(private val html: Boolean) {
+        private val result = StringBuilder()
+        private var quote = 0
+        private var lineStart = true
+        private var breakPending = false
+
+        fun text(ch: Char) {
+            if (html) {
+                result.append(escape(ch, false))
+                return
+            }
+            flushBreak(ch)
+            put(ch)
+        }
+
+        fun markup(value: String) {
+            if (value.isEmpty()) return
+            if (html) {
+                result.append(value)
+                return
+            }
+            flushBreak(value[0])
+            value.forEach(::put)
+        }
+
+        fun ensureLine() {
+            breakPending = false
+            if (result.isNotEmpty() && !lineStart) put('\n')
+        }
+
+        fun requestBreak() {
+            breakPending = true
+        }
+
+        fun enterQuote() {
+            quote++
+        }
+
+        fun leaveQuote() {
+            quote--
+        }
+
+        fun result(): String = result.toString()
+
+        private fun flushBreak(next: Char) {
+            if (!breakPending) return
+            breakPending = false
+            if (next != '\n' && !lineStart) put('\n')
+        }
+
+        private fun put(ch: Char) {
+            if (lineStart && quote > 0) result.append(if (ch == '\n') ">" else "> ")
+            result.append(ch)
+            lineStart = ch == '\n'
+        }
+    }
+
+    private fun escape(ch: Char, attribute: Boolean): String = when {
+        ch == '&' -> "&amp;"
+        ch == '<' -> "&lt;"
+        ch == '>' -> "&gt;"
+        attribute && ch == '"' -> "&quot;"
+        else -> ch.toString()
+    }
+
+    private fun escape(text: String, attribute: Boolean): String {
+        val out = StringBuilder(text.length)
+        text.forEach { out.append(escape(it, attribute)) }
+        return out.toString()
+    }
+
+    private fun kindOf(type: Type) = when (type) {
+        Type.QUOTE -> Kind.QUOTE
+        Type.PRE -> Kind.PRE
+        Type.CODE -> Kind.CODE
+        else -> Kind.INLINE
+    }
+
+    private fun block(kind: Kind) = kind == Kind.QUOTE || kind == Kind.PRE
+
+    // anything but the listed entities stays plain text
+    private fun collect(text: String, entities: List<TLRPC.MessageEntity>): MutableList<Span> {
+        val size = text.length
+        val result = ArrayList<Span>()
+        for (entity in entities) {
+            var data = ""
+            val type = when (entity) {
+                is TLRPC.TL_messageEntityBold -> Type.BOLD
+                is TLRPC.TL_messageEntityItalic -> Type.ITALIC
+                is TLRPC.TL_messageEntityUnderline -> Type.UNDERLINE
+                is TLRPC.TL_messageEntityStrike -> Type.STRIKE
+                is TLRPC.TL_messageEntitySpoiler -> Type.SPOILER
+                is TLRPC.TL_messageEntityCode -> Type.CODE
+                is TLRPC.TL_messageEntityPre -> Type.PRE.also { data = entity.language ?: "" }
+                is TLRPC.TL_messageEntityBlockquote -> Type.QUOTE.also { data = if (entity.collapsed) "expandable" else "" }
+                is TLRPC.TL_messageEntityTextUrl -> Type.LINK.also { data = entity.url ?: "" }
+                is TLRPC.TL_messageEntityMentionName -> Type.LINK.also { data = if (entity.user_id != 0L) "tg://user?id=" + entity.user_id else "" }
+                is TLRPC.TL_inputMessageEntityMentionName -> Type.LINK.also {
+                    val id = entity.user_id?.user_id ?: 0L
+                    data = if (id != 0L) "tg://user?id=$id" else ""
+                }
+                else -> continue
+            }
+            if (type == Type.LINK && data.isEmpty()) continue
+            val from = entity.offset.coerceIn(0, size)
+            val till = (entity.offset + entity.length).coerceIn(0, size)
+            if (till > from) result.add(Span(type, kindOf(type), from, till, data))
+        }
+        return result
+    }
+
+    // cuts the inline ranges at the block edges, and at every line break for Markdown, which has no multi-line inline marks
+    private fun split(spans: List<Span>, text: String, html: Boolean): MutableList<Span> {
+        val cuts = sortedSetOf<Int>()
+        spans.forEach {
+            if (it.kind != Kind.INLINE) {
+                cuts.add(it.from)
+                cuts.add(it.till)
+            }
+        }
+        if (!html) {
+            text.forEachIndexed { i, ch ->
+                if (ch == '\n') {
+                    cuts.add(i)
+                    cuts.add(i + 1)
+                }
+            }
+        }
+        val result = ArrayList<Span>()
+        fun push(span: Span, start: Int, end: Int) {
+            var from = start
+            var till = end
+            if (!html) {
+                if (till - from == 1 && text[from] == '\n') return
+                if (span.kind == Kind.INLINE) {
+                    while (from < till && text[from].isWhitespace()) from++
+                    while (till > from && text[till - 1].isWhitespace()) till--
+                }
+            }
+            if (till > from) result.add(span.piece(from, till))
+        }
+        for (span in spans) {
+            if (block(span.kind)) {
+                result.add(span)
+                continue
+            }
+            var from = span.from
+            for (cut in cuts) {
+                if (cut > from && cut < span.till) {
+                    push(span, from, cut)
+                    from = cut
+                }
+            }
+            push(span, from, span.till)
+        }
+        return result
+    }
+
+    // marks inside code are text
+    private fun dropInsideCode(spans: List<Span>): MutableList<Span> {
+        val result = ArrayList<Span>(spans.size)
+        for (i in spans.indices) {
+            val span = spans[i]
+            if (span.kind == Kind.QUOTE) {
+                result.add(span)
+                continue
+            }
+            var inside = false
+            for (j in spans.indices) {
+                val code = spans[j]
+                if (j == i || (code.kind != Kind.CODE && code.kind != Kind.PRE) || code.from > span.from || code.till < span.till) continue
+                val same = code.from == span.from && code.till == span.till
+                if (same && ((span.kind == Kind.INLINE && code.kind == Kind.CODE) || (span.kind != Kind.INLINE && j > i))) continue
+                inside = true
+                break
+            }
+            if (!inside) result.add(span)
+        }
+        return result
+    }
+
+    private fun longestRun(text: String, from: Int, till: Int, ch: Char): Int {
+        var result = 0
+        var current = 0
+        for (i in from until till) {
+            current = if (text[i] == ch) current + 1 else 0
+            if (current > result) result = current
+        }
+        return result
+    }
+
+    private fun markdownUrl(url: String) = url.replace(" ", "%20").replace("(", "%28").replace(")", "%29")
+
+    private fun decorate(span: Span, text: String, html: Boolean) {
+        fun both(value: String) {
+            span.open = value
+            span.close = value
+        }
+        fun tag(name: String) {
+            span.open = "<$name>"
+            span.close = "</$name>"
+        }
+        fun simple(mark: String, name: String) = if (html) tag(name) else both(mark)
+        when (span.type) {
+            Type.BOLD -> simple("**", "b")
+            Type.ITALIC -> simple("_", "i")
+            Type.UNDERLINE -> simple("__", "u")
+            Type.STRIKE -> simple("~~", "s")
+            Type.SPOILER -> if (html) {
+                span.open = "<span class=\"tg-spoiler\">"
+                span.close = "</span>"
+            } else {
+                both("||")
+            }
+            Type.LINK -> if (html) {
+                span.open = "<a href=\"" + escape(span.data, true) + "\">"
+                span.close = "</a>"
+            } else {
+                span.open = "["
+                span.close = "](" + markdownUrl(span.data) + ")"
+            }
+            Type.CODE -> if (html) {
+                tag("code")
+            } else {
+                val fence = "`".repeat(longestRun(text, span.from, span.till, '`') + 1)
+                val pad = if (text[span.from] == '`' || text[span.till - 1] == '`') " " else ""
+                span.open = fence + pad
+                span.close = pad + fence
+            }
+            Type.PRE -> {
+                val language = span.data.trim()
+                if (html) {
+                    if (language.isEmpty()) {
+                        tag("pre")
+                    } else {
+                        span.open = "<pre><code class=\"language-" + escape(language, true) + "\">"
+                        span.close = "</code></pre>"
+                    }
+                } else {
+                    val fence = "`".repeat(maxOf(3, longestRun(text, span.from, span.till, '`') + 1))
+                    span.open = fence + language + "\n"
+                    span.close = fence
+                }
+            }
+            Type.QUOTE -> if (html) {
+                span.open = if (span.data.isEmpty()) "<blockquote>" else "<blockquote expandable>"
+                span.close = "</blockquote>"
+            }
+        }
+    }
+
+    private fun open(writer: Writer, span: Span, html: Boolean) {
+        if (!html) {
+            if (span.kind == Kind.QUOTE) {
+                writer.ensureLine()
+                writer.enterQuote()
+                return
+            } else if (span.kind == Kind.PRE) {
+                writer.ensureLine()
+            }
+        }
+        writer.markup(span.open)
+    }
+
+    private fun close(writer: Writer, span: Span, html: Boolean) {
+        if (!html) {
+            if (span.kind == Kind.QUOTE) {
+                writer.leaveQuote()
+                writer.requestBreak()
+                return
+            } else if (span.kind == Kind.PRE) {
+                writer.ensureLine()
+                writer.markup(span.close)
+                writer.requestBreak()
+                return
+            }
+        }
+        writer.markup(span.close)
+    }
+
+    private fun convert(text: String, entities: List<TLRPC.MessageEntity>?, html: Boolean): String {
+        val spans = dropInsideCode(split(collect(text, entities ?: emptyList()), text, html))
+            .sortedWith(compareBy<Span> { it.from }.thenByDescending { it.till }.thenBy { it.kind.ordinal })
+        spans.forEach { decorate(it, text, html) }
+
+        val writer = Writer(html)
+        val stack = ArrayList<Int>()
+        var next = 0
+        val size = text.length
+        for (position in 0..size) {
+            val ending = stack.indexOfFirst { spans[it].till == position }
+            if (ending >= 0) {
+                val reopen = ArrayList<Int>()
+                while (stack.size > ending) {
+                    val index = stack.removeAt(stack.size - 1)
+                    close(writer, spans[index], html)
+                    if (spans[index].till != position) reopen.add(index)
+                }
+                for (index in reopen.asReversed()) {
+                    open(writer, spans[index], html)
+                    stack.add(index)
+                }
+            }
+            while (next != spans.size && spans[next].from == position) {
+                open(writer, spans[next], html)
+                stack.add(next++)
+            }
+            if (position < size) writer.text(text[position])
+        }
+        return writer.result()
+    }
+
+    @JvmStatic
+    fun toMarkdown(text: String, entities: List<TLRPC.MessageEntity>?): String = convert(text, entities, false)
+
+    @JvmStatic
+    fun toHtml(text: String, entities: List<TLRPC.MessageEntity>?): String = convert(text, entities, true)
+
+    // the message, or the one message of an album that has the text
+    private fun source(message: MessageObject?, group: MessageObject.GroupedMessages?): MessageObject? {
+        if (message?.messageOwner == null || message.messageOwner.rich_message != null || message.isDice) return null
+        if (!message.messageOwner.message.isNullOrEmpty()) return message
+        val captions = group?.messages?.filter { !it.messageOwner?.message.isNullOrEmpty() && it.messageOwner.rich_message == null }
+        return captions?.singleOrNull()
+    }
+
+    // the copy item is only there when the stock one is, so protected messages stay protected
+    @JvmStatic
+    fun fillMenu(message: MessageObject?, group: MessageObject.GroupedMessages?, items: ArrayList<CharSequence>, icons: ArrayList<Int>, options: ArrayList<Int>) {
+        if (!TeleConfig.COPY_MARKDOWN_HTML.value) return
+        val copy = options.indexOf(ChatActivity.OPTION_COPY)
+        if (copy < 0 || source(message, group) == null) return
+        val at = copy + 1
+        items.add(at, TeleLowercase.lc(LocaleController.getString(R.string.TeleCopyMarkdown)))
+        icons.add(at, R.drawable.msg_copy)
+        options.add(at, ChatActivity.tele_option_copy_markdown)
+        items.add(at + 1, TeleLowercase.lc(LocaleController.getString(R.string.TeleCopyHtml)))
+        icons.add(at + 1, R.drawable.msg_copy)
+        options.add(at + 1, ChatActivity.tele_option_copy_html)
+    }
+
+    @JvmStatic
+    fun copyMessage(chat: ChatActivity, message: MessageObject?, group: MessageObject.GroupedMessages?, html: Boolean) {
+        val owner = source(message, group)?.messageOwner ?: return
+        val text = owner.message ?: return
+        done(chat, if (html) toHtml(text, owner.entities) else toMarkdown(text, owner.entities), html)
+    }
+
+    // the items stay in the menu and are hidden unless the feature is on, so toggling needs no restart
+    @JvmStatic
+    fun addSelectionItems(menu: android.view.Menu, markdownId: Int, htmlId: Int) {
+        menu.add(android.view.Menu.NONE, markdownId, 1, TeleLowercase.lc(LocaleController.getString(R.string.TeleCopyMarkdown)))
+        menu.add(android.view.Menu.NONE, htmlId, 1, TeleLowercase.lc(LocaleController.getString(R.string.TeleCopyHtml)))
+    }
+
+    @JvmStatic
+    fun prepareSelectionItems(menu: android.view.Menu, markdownId: Int, htmlId: Int, allowed: Boolean) {
+        val visible = allowed && TeleConfig.COPY_MARKDOWN_HTML.value
+        menu.findItem(markdownId)?.isVisible = visible
+        menu.findItem(htmlId)?.isVisible = visible
+    }
+
+    // a text selection in a message: the marks come from its spans
+    @JvmStatic
+    fun copySelection(selected: CharSequence?, html: Boolean): Boolean {
+        if (selected.isNullOrEmpty()) return false
+        val text = selected.toString()
+        val entities = if (selected is Spanned) entitiesOf(selected) else null
+        AndroidUtilities.addToClipboard(if (html) toHtml(text, entities) else toMarkdown(text, entities))
+        return true
+    }
+
+    private fun done(chat: ChatActivity, result: String, html: Boolean) {
+        AndroidUtilities.addToClipboard(result)
+        BulletinFactory.of(chat).createCopyBulletin(LocaleController.getString(if (html) R.string.TeleHtmlCopied else R.string.TeleMarkdownCopied)).show()
+    }
+
+    private fun entitiesOf(spanned: Spanned): List<TLRPC.MessageEntity> {
+        val size = spanned.length
+        val result = ArrayList<TLRPC.MessageEntity>()
+        fun add(entity: TLRPC.MessageEntity, span: Any) {
+            entity.offset = spanned.getSpanStart(span)
+            entity.length = minOf(spanned.getSpanEnd(span), size) - entity.offset
+            if (entity.offset >= 0 && entity.length > 0) result.add(entity)
+        }
+        fun styled(flags: Int, span: Any) {
+            if ((flags and (TextStyleSpan.FLAG_STYLE_SPOILER or TextStyleSpan.FLAG_STYLE_SPOILER_REVEALED)) != 0) add(TLRPC.TL_messageEntitySpoiler(), span)
+            if ((flags and TextStyleSpan.FLAG_STYLE_BOLD) != 0) add(TLRPC.TL_messageEntityBold(), span)
+            if ((flags and TextStyleSpan.FLAG_STYLE_ITALIC) != 0) add(TLRPC.TL_messageEntityItalic(), span)
+            if ((flags and TextStyleSpan.FLAG_STYLE_MONO) != 0) add(TLRPC.TL_messageEntityCode(), span)
+            if ((flags and TextStyleSpan.FLAG_STYLE_STRIKE) != 0) add(TLRPC.TL_messageEntityStrike(), span)
+            if ((flags and TextStyleSpan.FLAG_STYLE_UNDERLINE) != 0) add(TLRPC.TL_messageEntityUnderline(), span)
+        }
+        for (span in spanned.getSpans(0, size, TextStyleSpan::class.java)) {
+            styled(span.styleFlags, span)
+        }
+        for (span in spanned.getSpans(0, size, URLSpanReplacement::class.java)) {
+            val entity = TLRPC.TL_messageEntityTextUrl()
+            entity.url = span.url
+            add(entity, span)
+            span.textStyleRun?.let { styled(it.flags, span) }
+        }
+        for (span in spanned.getSpans(0, size, URLSpanUserMention::class.java)) {
+            val id = span.url?.toLongOrNull() ?: continue
+            val entity = TLRPC.TL_messageEntityMentionName()
+            entity.user_id = id
+            add(entity, span)
+        }
+        for (span in spanned.getSpans(0, size, CodeHighlighting.Span::class.java)) {
+            val entity = TLRPC.TL_messageEntityPre()
+            entity.language = span.lng
+            add(entity, span)
+        }
+        for (span in spanned.getSpans(0, size, QuoteSpan::class.java)) {
+            val entity = TLRPC.TL_messageEntityBlockquote()
+            entity.collapsed = span.isCollapsing
+            add(entity, span)
+        }
+        return result
+    }
+}
