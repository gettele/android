+            return false;
+        }
+        final TLRPC.User user = getCurrentUser();
+        final boolean allowed = user != null
+            ? !user.bot && !UserObject.isReplyUser(user) && !UserObject.isService(user.id)
+            : tele.TeleConfig.QUICK_REPLIES_IN_GROUPS.getValue() && currentChat != null && ChatObject.canSendMessages(currentChat);
+        if (!allowed) {
+            return false;
+        }
+        final QuickRepliesController.QuickReply reply = tele.helpers.QuickReplyByName.find(currentAccount, text);
+        if (reply == null) {
+            return false;
+        }
+        teleSendQuickReply(reply);
+        return true;
+    }
