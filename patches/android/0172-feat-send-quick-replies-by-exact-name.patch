+++ b/TMessagesProj/src/main/java/tele/helpers/QuickReplyByName.kt
@@ -0,0 +1,23 @@
+package tele.helpers
+
+import org.telegram.ui.Business.QuickRepliesController
+import tele.TeleConfig
+
+// "/name" typed in full and sent: the quick reply with exactly that name, never a prefix match
+object QuickReplyByName {
+
+    @JvmStatic
+    fun find(account: Int, text: CharSequence?): QuickRepliesController.QuickReply? {
+        if (!TeleConfig.QUICK_REPLIES_BY_NAME.value || text == null) {
+            return null
+        }
+        val trimmed = text.toString().trim()
+        if (trimmed.length < 2 || trimmed[0] != '/' || trimmed.any { it.isWhitespace() }) {
+            return null
+        }
+        val name = trimmed.substring(1)
+        return QuickRepliesController.getInstance(account).replies.firstOrNull {
+            !it.isSpecial() && it.getMessagesCount() > 0 && it.name?.equals(name, ignoreCase = true) == true
+        }
+    }
+}
