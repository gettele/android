diff --git a/TMessagesProj/src/main/java/tele/helpers/PinSets.kt b/TMessagesProj/src/main/java/tele/helpers/PinSets.kt
new file mode 100644
index 000000000..d09d674ee
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/PinSets.kt
@@ -0,0 +1,232 @@
+package tele.helpers
+
+import android.util.SparseArray
+import android.view.View
+import org.json.JSONArray
+import org.json.JSONObject
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.FileLog
+import org.telegram.messenger.MediaDataController
+import org.telegram.messenger.NotificationCenter
+import org.telegram.messenger.R
+import org.telegram.messenger.UserConfig
+import org.telegram.messenger.Utilities
+import org.telegram.tgnet.TLRPC
+import org.telegram.ui.ActionBar.BaseFragment
+import org.telegram.ui.Components.ItemOptions
+import tele.TeleConfig
+import tele.db.TeleDatabaseHelper
+
+/**
+ * Sticker and emoji sets pinned to the front of the panel tabs. The pins live in tele_kv per account and
+ * only reorder what the panel shows; the order the server keeps is never sent from here.
+ */
+object PinSets {
+    const val STICKERS = 0
+    const val EMOJI = 1
+    private const val KINDS = 2
+    private const val KEY = "pin_sets"
+    private const val MAX = 4096
+
+    private class State(val userId: Long) {
+        val lists = Array(KINDS) { ArrayList<Long>() }
+        var loaded = false
+        var loading = false
+    }
+
+    // the UI thread owns the states
+    private val states = SparseArray<State>()
+
+    @JvmStatic
+    fun enabled(): Boolean = TeleConfig.PIN_SETS.value
+
+    private fun type(kind: Int) = if (kind == EMOJI) MediaDataController.TYPE_EMOJIPACKS else MediaDataController.TYPE_IMAGE
+
+    private fun state(account: Int): State? {
+        val userId = UserConfig.getInstance(account).getClientUserId()
+        if (userId == 0L) return null
+        var s = states.get(account)
+        if (s == null || s.userId != userId) {
+            s = State(userId)
+            states.put(account, s)
+        }
+        if (!s.loaded && !s.loading) load(account, s)
+        return s
+    }
+
+    private fun load(account: Int, s: State) {
+        s.loading = true
+        val key = "$KEY:${s.userId}"
+        Utilities.globalQueue.postRunnable {
+            val raw = runCatching { TeleDatabaseHelper.get(key) }.onFailure { FileLog.e(it) }.getOrNull()
+            val read = Array(KINDS) { ArrayList<Long>() }
+            if (raw != null) {
+                runCatching {
+                    val json = JSONObject(raw)
+                    for (kind in 0 until KINDS) {
+                        val array = json.optJSONArray(if (kind == EMOJI) "e" else "s") ?: continue
+                        for (i in 0 until minOf(array.length(), MAX)) {
+                            val id = array.getLong(i)
+                            if (id !in read[kind]) read[kind].add(id)
+                        }
+                    }
+                }.onFailure { FileLog.e(it) }
+            }
+            AndroidUtilities.runOnUIThread {
+                if (states.get(account) !== s) return@runOnUIThread
+                // a pin made before the rows arrived is newer
+                for (kind in 0 until KINDS) {
+                    for (id in s.lists[kind]) if (id !in read[kind]) read[kind].add(id)
+                    s.lists[kind] = read[kind]
+                }
+                s.loaded = true
+                s.loading = false
+                if (enabled() && s.lists.any { it.isNotEmpty() }) notifyLists(account, STICKERS, EMOJI)
+            }
+        }
+    }
+
+    private fun persist(s: State) {
+        val json = JSONObject()
+        json.put("s", JSONArray(s.lists[STICKERS]))
+        json.put("e", JSONArray(s.lists[EMOJI]))
+        val text = json.toString()
+        val key = "$KEY:${s.userId}"
+        Utilities.globalQueue.postRunnable { runCatching { TeleDatabaseHelper.put(key, text) }.onFailure { FileLog.e(it) } }
+    }
+
+    // makes the panels rebuild their tabs from the sets, in the order below
+    private fun notifyLists(account: Int, vararg kinds: Int) {
+        val center = NotificationCenter.getInstance(account)
+        for (kind in kinds) center.postNotificationName(NotificationCenter.stickersDidLoad, type(kind), true)
+    }
+
+    @JvmStatic
+    fun onToggled() {
+        for (account in 0 until UserConfig.MAX_ACCOUNT_COUNT) {
+            if (!UserConfig.getInstance(account).isClientActivated) continue
+            if (enabled()) state(account)
+            notifyLists(account, STICKERS, EMOJI)
+        }
+    }
+
+    // the account logs out: its pins must not reach the next user of the slot
+    @JvmStatic
+    fun cleanup(account: Int) {
+        states.remove(account)
+    }
+
+    private fun installed(account: Int, kind: Int): List<TLRPC.TL_messages_stickerSet> =
+        MediaDataController.getInstance(account).getStickerSets(type(kind))
+
+    // the pinned ids that are installed, in the shown order
+    private fun shown(account: Int, kind: Int, s: State): List<Long> {
+        val ids = installed(account, kind).mapNotNull { it.set?.id }.toHashSet()
+        return s.lists[kind].filter { it in ids }
+    }
+
+    /** The sets with the pinned ones first; the same list when nothing is pinned. */
+    @JvmStatic
+    fun order(account: Int, kind: Int, sets: ArrayList<TLRPC.TL_messages_stickerSet>): ArrayList<TLRPC.TL_messages_stickerSet> {
+        if (!enabled()) return sets
+        val s = state(account) ?: return sets
+        if (!s.loaded || s.lists[kind].isEmpty()) return sets
+        val byId = HashMap<Long, TLRPC.TL_messages_stickerSet>()
+        for (set in sets) set.set?.let { byId.putIfAbsent(it.id, set) }
+        val head = s.lists[kind].mapNotNull { byId[it] }
+        if (head.isEmpty()) return sets
+        val pinned = head.map { it.set.id }.toHashSet()
+        val result = ArrayList<TLRPC.TL_messages_stickerSet>(sets.size)
+        result.addAll(head)
+        for (set in sets) if (set.set?.id !in pinned) result.add(set)
+        return result
+    }
+
+    /**
+     * A tab drag moved a set. The pinned ones only reorder among themselves, locally; the others reorder
+     * in the server list. Returns false when nothing is pinned and the stock reorder applies.
+     */
+    @JvmStatic
+    fun tabsMoved(account: Int, kind: Int, tabSets: List<TLRPC.TL_messages_stickerSet>, serverList: ArrayList<TLRPC.TL_messages_stickerSet>): Boolean {
+        if (!enabled()) return false
+        val s = state(account) ?: return false
+        if (!s.loaded) return false
+        val shownIds = shown(account, kind, s)
+        if (shownIds.isEmpty()) return false
+        val pinned = shownIds.toHashSet()
+
+        val tabPinned = tabSets.mapNotNull { it.set?.id }.filter { it in pinned }
+        val list = s.lists[kind]
+        var next = 0
+        for (i in list.indices) if (list[i] in pinned && next < tabPinned.size) list[i] = tabPinned[next++]
+        persist(s)
+
+        val tabOthers = tabSets.filter { it.set != null && it.set.id !in pinned }
+        val inServer = serverList.mapNotNull { it.set?.id }.toHashSet()
+        val others = tabOthers.filter { it.set.id in inServer }
+        val otherIds = others.map { it.set.id }.toHashSet()
+        val slots = serverList.indices.filter { i -> serverList[i].set?.id in otherIds }
+        for ((n, i) in slots.withIndex()) if (n < others.size) serverList[i] = others[n]
+        return true
+    }
+
+    /** The tab sets in the order the server keeps them, for the reorder request. */
+    @JvmStatic
+    fun serverOrder(account: Int, kind: Int, tabSets: ArrayList<TLRPC.TL_messages_stickerSet>): List<TLRPC.TL_messages_stickerSet> {
+        if (!enabled()) return tabSets
+        val s = state(account) ?: return tabSets
+        if (!s.loaded || shown(account, kind, s).isEmpty()) return tabSets
+        val index = HashMap<Long, Int>()
+        installed(account, kind).forEachIndexed { i, set -> set.set?.let { index[it.id] = i } }
+        // the sets the server list does not hold, like the group set, keep the front
+        return tabSets.sortedBy { set -> set.set?.let { index[it.id] } ?: -1 }
+    }
+
+    /** Pin menu of a set tab; false when the tab is no pinnable set. */
+    @JvmStatic
+    fun showMenu(fragment: BaseFragment?, anchor: View?, account: Int, kind: Int, setId: Long): Boolean {
+        if (fragment == null || anchor == null || setId == 0L || !enabled()) return false
+        val s = state(account) ?: return false
+        if (!s.loaded) return false
+        val list = shown(account, kind, s)
+        if (installed(account, kind).none { it.set?.id == setId }) return false
+        val index = list.indexOf(setId)
+        val pinned = index >= 0
+        val options = ItemOptions.makeOptions(fragment, anchor)
+        options.add(if (pinned) R.drawable.msg_unpin else R.drawable.msg_pin, TeleLowercase.lc(if (pinned) "Unpin" else "Pin")) {
+            toggle(account, kind, s, setId)
+        }
+        if (pinned && index > 0) {
+            options.add(R.drawable.msg_arrow_back, TeleLowercase.lc("Move left")) { move(account, kind, s, setId, -1) }
+        }
+        if (pinned && index + 1 < list.size) {
+            options.add(R.drawable.msg_arrow_forward, TeleLowercase.lc("Move right")) { move(account, kind, s, setId, 1) }
+        }
+        options.show()
+        return true
+    }
+
+    private fun toggle(account: Int, kind: Int, s: State, setId: Long) {
+        val list = s.lists[kind]
+        if (!list.remove(setId)) {
+            if (list.size >= MAX) return
+            list.add(setId)
+        }
+        persist(s)
+        notifyLists(account, kind)
+    }
+
+    private fun move(account: Int, kind: Int, s: State, setId: Long, delta: Int) {
+        val list = shown(account, kind, s)
+        val to = list.indexOf(setId) + delta
+        if (to !in list.indices || list.indexOf(setId) < 0) return
+        val pins = s.lists[kind]
+        val a = pins.indexOf(setId)
+        val b = pins.indexOf(list[to])
+        if (a < 0 || b < 0) return
+        pins[a] = list[to]
+        pins[b] = setId
+        persist(s)
+        notifyLists(account, kind)
+    }
+}
