From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Thu, 5 Nov 2026 02:53:52 +0300
Subject: [PATCH] fix: hide gif-as-video for inline results without a document

---
 .../src/main/java/org/telegram/ui/ChatActivity.java      | 4 ++--
 .../main/java/org/telegram/ui/Components/EmojiView.java  | 4 ++--
 .../main/java/org/telegram/ui/ContentPreviewViewer.java  | 4 ++--
 TMessagesProj/src/main/java/tele/helpers/GifVideo.kt     | 9 ++++++++-
 4 files changed, 14 insertions(+), 7 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
index 78114144b..f68b5d150 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
@@ -7593,8 +7593,8 @@ public class ChatActivity extends BaseFragment implements
             }
 
             @Override
-            public boolean canSendGifAsVideo() {
-                return true;
+            public boolean canSendGifAsVideo(Object gif) {
+                return tele.helpers.GifVideo.canSend(gif);
             }
 
             @Override
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Components/EmojiView.java b/TMessagesProj/src/main/java/org/telegram/ui/Components/EmojiView.java
index da88bcfe5..a5d2f3301 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Components/EmojiView.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Components/EmojiView.java
@@ -581,8 +581,8 @@ public class EmojiView extends FrameLayout implements
         }
 
         @Override
-        public boolean canSendGifAsVideo() {
-            return fragment instanceof ChatActivity;
+        public boolean canSendGifAsVideo(Object gif) {
+            return fragment instanceof ChatActivity && tele.helpers.GifVideo.canSend(gif);
         }
 
         @Override
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/ContentPreviewViewer.java b/TMessagesProj/src/main/java/org/telegram/ui/ContentPreviewViewer.java
index 0afee63c0..c0c4019ae 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/ContentPreviewViewer.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/ContentPreviewViewer.java
@@ -189,7 +189,7 @@ public class ContentPreviewViewer {
         default void attachGif(Object gif, Object parent) {
         }
 
-        default boolean canSendGifAsVideo() {
+        default boolean canSendGifAsVideo(Object gif) {
             return false;
         }
 
@@ -1082,7 +1082,7 @@ public class ContentPreviewViewer {
                     icons.add(R.drawable.input_notify_off);
                     actions.add(4);
                 }
-                if (delegate.canSendGifAsVideo()) {
+                if (delegate.canSendGifAsVideo(inlineResult != null ? inlineResult : currentDocument)) {
                     items.add(LocaleController.getString(R.string.TeleSendGifAsVideo));
                     icons.add(R.drawable.input_video);
                     actions.add(tele_action_gif_as_video);
diff --git a/TMessagesProj/src/main/java/tele/helpers/GifVideo.kt b/TMessagesProj/src/main/java/tele/helpers/GifVideo.kt
index 9ac802e6d..586072a95 100644
--- a/TMessagesProj/src/main/java/tele/helpers/GifVideo.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/GifVideo.kt
@@ -31,6 +31,13 @@ object GifVideo {
     private const val MAX_SIDE = 512
     private const val MAX_DURATION_MS = 60_000
 
+    @JvmStatic
+    fun canSend(gif: Any?): Boolean = when (gif) {
+        is TLRPC.Document -> true
+        is TLRPC.BotInlineResult -> gif.document != null
+        else -> false
+    }
+
     @JvmStatic
     fun send(fragment: ChatActivity, gif: Any?, parent: Any?): Boolean {
         val document = when (gif) {
@@ -83,7 +90,7 @@ object GifVideo {
     /** The menu item of a gif message: resend it as a video, into the docked strip when it is on. */
     @JvmStatic
     fun fillMenu(fragment: ChatActivity, message: MessageObject, items: ArrayList<CharSequence>, icons: ArrayList<Int>, options: ArrayList<Int>) {
-        if (!isGifMessage(message)) return
+        if (!isGifMessage(message) || message.document == null) return
         val at = options.indexOf(ChatActivity.OPTION_DELETE).let { if (it >= 0) it else options.size }
         items.add(at, LocaleController.getString(R.string.TeleSendGifAsVideo))
         icons.add(at, R.drawable.input_video)
