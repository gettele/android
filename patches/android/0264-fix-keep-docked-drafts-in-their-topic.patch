From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Thu, 5 Nov 2026 02:53:52 +0300
Subject: [PATCH] fix: keep docked drafts in their topic

---
 TMessagesProj/src/main/java/tele/helpers/DockedMedia.kt | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/TMessagesProj/src/main/java/tele/helpers/DockedMedia.kt b/TMessagesProj/src/main/java/tele/helpers/DockedMedia.kt
index c0881e09f..ca857a3ca 100644
--- a/TMessagesProj/src/main/java/tele/helpers/DockedMedia.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/DockedMedia.kt
@@ -692,7 +692,7 @@ object DockedMedia {
     fun keepsDraftLocal(account: Int, dialogId: Long, threadId: Long): Boolean {
         if (!enabled()) return false
         ensureLoaded(account)
-        return trays.any { (key, tray) -> key.account == account && key.dialogId == dialogId && tray.items.isNotEmpty() }
+        return trays.any { (key, tray) -> key.account == account && key.dialogId == dialogId && key.threadId == threadId && tray.items.isNotEmpty() }
     }
 
     @JvmStatic
