diff --git a/TMessagesProj/src/main/java/tele/helpers/CollectiblePrice.kt b/TMessagesProj/src/main/java/tele/helpers/CollectiblePrice.kt
new file mode 100644
index 000000000..b2a2aa7d0
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/CollectiblePrice.kt
@@ -0,0 +1,124 @@
+package tele.helpers
+
+import android.net.Uri
+import android.text.SpannableStringBuilder
+import android.widget.TextView
+import org.json.JSONObject
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.DispatchQueue
+import org.telegram.messenger.FileLog
+import org.telegram.tgnet.tl.TL_fragment
+import org.telegram.messenger.BillingController
+import tele.TeleConfig
+import java.io.ByteArrayOutputStream
+import java.math.BigDecimal
+import java.math.RoundingMode
+import java.net.HttpURLConnection
+import java.net.URL
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+import java.util.TimeZone
+import java.util.concurrent.ConcurrentHashMap
+
+object CollectiblePrice {
+    private const val ENDPOINT = "https://gram.rin.ms/v1/ton/price"
+    private const val TIMEOUT = 5_000
+    private const val MAX_BODY = 64 * 1024
+    private const val MAX_DIGITS = 18
+    private val PRICE = Regex("^\\d{1,12}(\\.\\d{1,18})?$")
+
+    private val queue by lazy { DispatchQueue("teleCollectiblePrice") }
+    private val prices = ConcurrentHashMap<Int, String>()
+    private val inFlight = ConcurrentHashMap<Int, Boolean>()
+
+    private fun applies(info: TL_fragment.TL_collectibleInfo) =
+        TeleConfig.PURCHASE_PRICE.value && info.crypto_currency == "TON" && info.purchase_date > 0
+
+    @JvmStatic
+    fun fiat(info: TL_fragment.TL_collectibleInfo, fallback: String): String {
+        if (!applies(info)) return fallback
+        val price = prices[info.purchase_date] ?: return fallback
+        return format(price, info.crypto_amount) ?: fallback
+    }
+
+    @JvmStatic
+    fun refresh(info: TL_fragment.TL_collectibleInfo, fallback: String, target: TextView) {
+        if (!applies(info) || prices.containsKey(info.purchase_date)) return
+        val date = info.purchase_date
+        if (inFlight.putIfAbsent(date, true) != null) return
+        val nano = info.crypto_amount
+        queue.postRunnable {
+            val price = try {
+                fetch(date)
+            } catch (e: Exception) {
+                FileLog.e("tele collectible price: ${e.message}")
+                null
+            }
+            val usd = price?.let { format(it, nano) }
+            if (usd != null) prices[date] = price
+            inFlight.remove(date)
+            if (usd == null) return@postRunnable
+            AndroidUtilities.runOnUIThread {
+                if (target.isAttachedToWindow) apply(target, fallback, usd)
+            }
+        }
+    }
+
+    private fun apply(target: TextView, fallback: String, usd: String) {
+        val text = target.text
+        target.text = if (fallback.isEmpty()) {
+            SpannableStringBuilder(text).append(" (").append(usd).append(")")
+        } else {
+            AndroidUtilities.replaceCharSequence(fallback, text, usd)
+        }
+    }
+
+    private fun format(price: String, nano: Long): String? {
+        if (!PRICE.matches(price)) return null
+        val cents = BigDecimal(price).multiply(BigDecimal.valueOf(nano)).movePointLeft(7).setScale(0, RoundingMode.HALF_UP)
+        if (cents.precision() > MAX_DIGITS) return null
+        return BillingController.getInstance().formatCurrency(cents.toLong(), "USD")
+    }
+
+    private fun fetch(date: Int): String? {
+        val formatter = SimpleDateFormat("yyyy-MM-dd'T'HH:mm:ss'Z'", Locale.US)
+        formatter.timeZone = TimeZone.getTimeZone("UTC")
+        val at = formatter.format(Date(date * 1000L))
+        val url = URL("$ENDPOINT?at=${Uri.encode(at)}&max_age_seconds=86400")
+        val connection = url.openConnection() as HttpURLConnection
+        try {
+            connection.connectTimeout = TIMEOUT
+            connection.readTimeout = TIMEOUT
+            connection.setRequestProperty("Accept", "application/json")
+            connection.setRequestProperty("User-Agent", "GramPricesClient/1.0")
+            val code = connection.responseCode
+            if (code != 200) {
+                val error = runCatching { JSONObject(String(readLimited(connection.errorStream) ?: ByteArray(0))).optString("code") }.getOrNull()
+                throw IllegalStateException("$code ${error.takeUnless { it.isNullOrEmpty() } ?: "malformed response"}")
+            }
+            val body = readLimited(connection.inputStream) ?: throw IllegalStateException("response is too large")
+            val data = JSONObject(String(body, Charsets.UTF_8)).optJSONObject("data") ?: throw IllegalStateException("malformed response")
+            val quote = data.optString("quote_currency")
+            if (quote != "USD" && quote != "USDT") throw IllegalStateException("unsupported quote currency")
+            return data.optString("price").takeIf { it.isNotEmpty() }
+        } finally {
+            connection.disconnect()
+        }
+    }
+
+    private fun readLimited(stream: java.io.InputStream?): ByteArray? {
+        if (stream == null) return null
+        val out = ByteArrayOutputStream()
+        stream.use { input ->
+            val buffer = ByteArray(8 * 1024)
+            while (true) {
+                val read = input.read(buffer)
+                if (read < 0) break
+                out.write(buffer, 0, read)
+                if (out.size() > MAX_BODY) return null
+            }
+        }
+        return out.toByteArray()
+    }
+}
