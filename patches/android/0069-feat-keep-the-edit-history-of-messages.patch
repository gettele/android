@@ -0,0 +1,44 @@
+package tele.helpers
+
+import org.telegram.messenger.UserConfig
+import org.telegram.tgnet.SerializedData
+import org.telegram.tgnet.TLRPC
+import tele.TeleConfig
+import tele.db.TeleDatabaseHelper
+import java.security.MessageDigest
+
+object MessageHistory {
+    data class Version(val message: TLRPC.Message, val editDate: Int, val original: Boolean)
+
+    @JvmStatic
+    fun archiveVersion(account: Int, message: TLRPC.Message, original: Boolean) {
+        if (!TeleConfig.EDIT_HISTORY.value || message.id <= 0) return
+        val stream = SerializedData(message.getObjectSize())
+        try {
+            message.serializeToStream(stream)
+            val data = stream.toByteArray()
+            val key = MessageDigest.getInstance("SHA-256").digest(data).joinToString("") { "%02x".format(it) }
+            TeleDatabaseHelper.putMessageVersion(account, message.dialog_id, message.id, message.edit_date.takeIf { it > 0 } ?: message.date, original, key, data)
+        } finally {
+            stream.cleanup()
+        }
+    }
+
+    @JvmStatic
+    fun getVersions(account: Int, dialogId: Long, messageId: Int): List<Version> {
+        return TeleDatabaseHelper.getMessageVersions(account, dialogId, messageId).mapNotNull { row ->
+            runCatching {
+                val stream = SerializedData(row.data)
+                try {
+                    val message = TLRPC.Message.TLdeserialize(stream, stream.readInt32(false), false) ?: return@runCatching null
+                    message.readAttachPath(stream, UserConfig.getInstance(account).clientUserId)
+                    message.dialog_id = dialogId
+                    Version(message, row.editDate, row.original)
+                } finally {
+                    stream.cleanup()
+                }
+            }.getOrNull()
+        }
+    }
+
+}
