+    /**
+     * One row says that the messages after the previous row up to [till] were read at [date];
+     * date 0 marks the edge where the log starts or rotates, the read time is unknown there.
+     */
+    fun addReadLog(account: Int, dialogId: Long, was: Int, till: Int, date: Int, maxEntries: Int, maxChats: Int) {
+        val db = helper?.writableDatabase ?: return
+        val args = arrayOf(account.toString(), dialogId.toString())
+        db.beginTransaction()
+        try {
+            var last = 0
+            var known = false
+            db.rawQuery("SELECT MAX(till) FROM tele_read_log WHERE account = ? AND dialog_id = ?", args).use {
+                if (it.moveToFirst() && !it.isNull(0)) {
+                    last = it.getInt(0)
+                    known = true
+                }
+            }
+            // an older update never rewrites the newer state
+            if (till <= last) return
+            if (!known) {
+                var chats = 0
+                db.rawQuery("SELECT COUNT(DISTINCT dialog_id) FROM tele_read_log WHERE account = ?", arrayOf(account.toString())).use { if (it.moveToFirst()) chats = it.getInt(0) }
+                if (chats >= maxChats) {
+                    db.execSQL("DELETE FROM tele_read_log WHERE account = ? AND dialog_id = (SELECT dialog_id FROM tele_read_log WHERE account = ? GROUP BY dialog_id ORDER BY MAX(date) ASC LIMIT 1)", arrayOf(account, account))
+                }
+            }
+            if (was > last) {
+                db.execSQL("INSERT OR IGNORE INTO tele_read_log (account, dialog_id, till, date) VALUES (?, ?, ?, 0)", arrayOf(account, dialogId, was))
+            }
+            db.execSQL("INSERT OR REPLACE INTO tele_read_log (account, dialog_id, till, date) VALUES (?, ?, ?, ?)", arrayOf(account, dialogId, till, date))
+            var count = 0
+            db.rawQuery("SELECT COUNT(*) FROM tele_read_log WHERE account = ? AND dialog_id = ?", args).use { if (it.moveToFirst()) count = it.getInt(0) }
+            if (count > maxEntries) {
+                // the dropped rows are replaced with one edge row, so the log stays at the limit
+                val drop = count - maxEntries + 1
+                var edge = 0
+                db.rawQuery("SELECT till FROM tele_read_log WHERE account = ? AND dialog_id = ? ORDER BY till ASC LIMIT 1 OFFSET ?", arrayOf(args[0], args[1], (drop - 1).toString())).use { if (it.moveToFirst()) edge = it.getInt(0) }
+                db.execSQL("DELETE FROM tele_read_log WHERE account = ? AND dialog_id = ? AND till <= ?", arrayOf(account, dialogId, edge))
+                db.execSQL("INSERT OR REPLACE INTO tele_read_log (account, dialog_id, till, date) VALUES (?, ?, ?, 0)", arrayOf(account, dialogId, edge))
+            }
+            db.setTransactionSuccessful()
+        } finally {
+            db.endTransaction()
+        }
+    }
+
+    /** The read time of the message, 0 when it is unknown. */
+    fun findReadLog(account: Int, dialogId: Long, messageId: Int): Int {
+        val db = helper?.readableDatabase ?: return 0
+        db.rawQuery("SELECT date FROM tele_read_log WHERE account = ? AND dialog_id = ? AND till >= ? ORDER BY till ASC LIMIT 1", arrayOf(account.toString(), dialogId.toString(), messageId.toString())).use {
+            if (it.moveToFirst()) return it.getInt(0)
+        }
+        return 0
+    }
+
