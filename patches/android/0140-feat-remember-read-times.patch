diff --git a/TMessagesProj/src/main/java/tele/helpers/ReadLog.kt b/TMessagesProj/src/main/java/tele/helpers/ReadLog.kt
new file mode 100644
index 000000000..ff1f8648a
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/ReadLog.kt
@@ -0,0 +1,52 @@
+package tele.helpers
+
+import org.telegram.messenger.DispatchQueue
+import org.telegram.messenger.MessagesController
+import org.telegram.messenger.UserObject
+import tele.TeleConfig
+import tele.db.TeleDatabaseHelper
+
+/**
+ * Remembers when the outgoing messages of private chats were read. The outbox read updates carry
+ * no time, so the time is the moment the update arrives; the updates replayed by the difference
+ * request are skipped because their moment is lost.
+ */
+object ReadLog {
+
+    // the limits of the desktop log
+    private const val MAX_ENTRIES = 200
+    private const val MAX_CHATS = 1000
+
+    // one queue keeps the updates of a chat in the order of their arrival
+    private val queue by lazy { DispatchQueue("teleReadLog") }
+
+    @JvmStatic
+    fun enabled() = TeleConfig.READ_LOG.value
+
+    private fun logged(account: Int, userId: Long): Boolean {
+        val user = MessagesController.getInstance(account).getUser(userId) ?: return false
+        return !user.bot && !UserObject.isUserSelf(user) && !UserObject.isService(userId)
+    }
+
+    /** [was] is the outbox read position before the update, [till] the one the update brings. */
+    @JvmStatic
+    fun onOutboxRead(account: Int, userId: Long, was: Int, till: Int, fromDifference: Boolean) {
+        if (!enabled() || fromDifference || till <= was || !logged(account, userId)) return
+        val date = org.telegram.tgnet.ConnectionsManager.getInstance(account).currentTime
+        queue.postRunnable { TeleDatabaseHelper.addReadLog(account, userId, was, till, date, MAX_ENTRIES, MAX_CHATS) }
+    }
+
+    /** Whether the private chat is the kind the log is kept for. */
+    @JvmStatic
+    fun available(account: Int, message: org.telegram.messenger.MessageObject): Boolean {
+        if (!enabled() || !message.isOutOwner || message.dialogId <= 0) return false
+        return logged(account, message.dialogId)
+    }
+
+    /** The logged read time of the message, 0 when there is none. It is one indexed read of a single row. */
+    @JvmStatic
+    fun date(account: Int, dialogId: Long, messageId: Int): Int {
+        if (!enabled() || dialogId <= 0 || messageId <= 0) return 0
+        return TeleDatabaseHelper.findReadLog(account, dialogId, messageId)
+    }
+}
