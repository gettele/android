         val messagesController = org.telegram.messenger.MessagesController.getInstance(account)
         if (userId != 0L) {
             if (userId == UserConfig.getInstance(account).clientUserId) {
@@ -36,15 +41,10 @@ object PeerId {
 
     @JvmStatic
     fun dcText(account: Int, userId: Long, chatId: Long): String {
-        val dc = dc(account, userId, chatId)
-        if (dc == 0) return ""
-        val location = when (dc) {
-            1, 3 -> "Miami"
-            2, 4 -> "Amsterdam"
-            5 -> "Singapore"
-            else -> ""
-        }
-        return if (location.isEmpty()) dc.toString() else "$dc, ${location.lowercase()}"
+        val info = PeerDc.info(account, userId, chatId)
+        if (info.dc == 0) return ""
+        val text = dcValue(info.dc)
+        return if (info.uncertain) "$text (${uncertainText()})" else text
     }
 
     @JvmStatic
@@ -53,10 +53,24 @@ object PeerId {
         if (!TeleConfig.SHOW_DC.value || !TeleConfig.MERGE_ID_DC.value) {
             return id
         }
-        val dc = dcText(account, userId, chatId)
-        return if (dc.isEmpty()) id else "$id (DC$dc)"
+        val info = PeerDc.info(account, userId, chatId)
+        if (info.dc == 0) return id
+        val suffix = if (info.uncertain) ", ${uncertainText()}" else ""
+        return "$id (DC${dcValue(info.dc)}$suffix)"
     }
 
+    private fun dcValue(dc: Int): String {
+        val location = when (dc) {
+            1, 3 -> "Miami"
+            2, 4 -> "Amsterdam"
+            5 -> "Singapore"
+            else -> ""
+        }
+        return if (location.isEmpty()) dc.toString() else "$dc, ${location.lowercase()}"
+    }
+
+    private fun uncertainText(): String = org.telegram.messenger.LocaleController.getString(org.telegram.messenger.R.string.TeleDcUncertain)
+
     // the clipboard gets the plain digits, whatever the row shows
     @JvmStatic
     fun copyText(account: Int, userId: Long, chatId: Long): String =
