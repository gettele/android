+    // the data center of a chat comes from the oldest photo of its history
+    private void loadTelePeerDc() {
+        if (teleDcHandle != null) {
+            teleDcHandle.cancel();
+            teleDcHandle = null;
+        }
+        if (userId != 0 || chatId == 0 || !tele.TeleConfig.SHOW_DC.getValue()) {
+            return;
+        }
+        teleDcHandle = tele.helpers.PeerDc.request(currentAccount, userId, chatId, info -> {
+            if (userId != 0 || chatId == 0) {
+                // the profile changed while the history was loading
+                return;
+            }
+            AndroidUtilities.runOnUIThread(() -> {
+                if (listAdapter == null) {
+                    return;
+                }
+                if (teleDcInfo != null && teleDcInfo.getDc() == info.getDc() && teleDcInfo.getUncertain() == info.getUncertain()) {
+                    // the row already shows this value, no redraw needed
+                    return;
+                }
+                teleDcInfo = info;
+                if (tele_idRow >= 0) {
+                    listAdapter.notifyItemChanged(tele_idRow);
+                }
+                if (tele_dcRow >= 0) {
+                    listAdapter.notifyItemChanged(tele_dcRow);
+                }
+            });
+        });
+    }
+
