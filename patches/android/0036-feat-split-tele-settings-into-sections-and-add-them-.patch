+            section(GUID_IDS + 2, "ids without spaces", "ids", TeleSettingsActivity.MODE_IDS),
+            section(GUID_IDS + 3, "bot api style ids", "ids", TeleSettingsActivity.MODE_IDS),
+            section(GUID_IDS + 4, "show data center", "ids", TeleSettingsActivity.MODE_IDS),
