+package tele.helpers
+
+import org.json.JSONArray
+import org.telegram.ui.ChatActivity
+import tele.db.TeleDatabaseHelper
+
+object MessageMenu {
+
+    class Item(val code: Int, val name: String)
+
+    @JvmStatic
+    val ALL: List<Item> = listOf(
+        Item(ChatActivity.OPTION_REPLY, "Reply"),
+        Item(ChatActivity.OPTION_COPY, "Copy"),
+        Item(ChatActivity.OPTION_FORWARD, "Forward"),
+        Item(ChatActivity.OPTION_EDIT, "Edit"),
+        Item(ChatActivity.OPTION_PIN, "Pin"),
+        Item(ChatActivity.OPTION_UNPIN, "Unpin"),
+        Item(ChatActivity.OPTION_DELETE, "Delete"),
+        Item(ChatActivity.OPTION_RETRY, "Retry"),
+        Item(ChatActivity.OPTION_CANCEL_SENDING, "Cancel sending"),
+        Item(ChatActivity.OPTION_SEND_NOW, "Send now"),
+        Item(ChatActivity.OPTION_EDIT_SCHEDULE_TIME, "Edit schedule time"),
+        Item(ChatActivity.OPTION_COPY_LINK, "Copy link"),
+        Item(ChatActivity.OPTION_TRANSLATE, "Translate"),
+        Item(ChatActivity.OPTION_VIEW_REPLIES_OR_THREAD, "View replies/thread"),
+        Item(ChatActivity.OPTION_VIEW_IN_TOPIC, "View in topic"),
+        Item(ChatActivity.OPTION_VIEW_STATISTICS, "View statistics"),
+        Item(ChatActivity.OPTION_SAVE_TO_GALLERY, "Save to gallery"),
+        Item(ChatActivity.OPTION_SAVE_TO_GALLERY2, "Save to gallery (media)"),
+        Item(ChatActivity.OPTION_SAVE_TO_DOWNLOADS_OR_MUSIC, "Save to downloads/music"),
+        Item(ChatActivity.OPTION_SHARE, "Share"),
+        Item(ChatActivity.OPTION_ADD_TO_GIFS, "Save to GIFs"),
+        Item(ChatActivity.OPTION_ADD_TO_STICKERS_OR_MASKS, "Add to stickers/masks"),
+        Item(ChatActivity.OPTION_ADD_STICKER_TO_FAVORITES, "Add to favorites"),
+        Item(ChatActivity.OPTION_DELETE_STICKER_FROM_FAVORITES, "Remove from favorites"),
+        Item(ChatActivity.OPTION_APPLY_LOCALIZATION_OR_THEME, "Apply file"),
+        Item(ChatActivity.OPTION_ADD_CONTACT, "Add contact"),
+        Item(ChatActivity.OPTION_COPY_PHONE_NUMBER, "Copy phone number"),
+        Item(ChatActivity.OPTION_CALL, "Call"),
+        Item(ChatActivity.OPTION_CALL_AGAIN, "Call again"),
+        Item(ChatActivity.OPTION_RATE_CALL, "Rate call"),
+        Item(ChatActivity.OPTION_REPORT_CHAT, "Report"),
+        Item(ChatActivity.OPTION_REPORT_AD, "Report ad"),
+        Item(ChatActivity.OPTION_HIDE_SPONSORED_MESSAGE, "Hide ad"),
+        Item(ChatActivity.OPTION_ABOUT_REVENUE_SHARING_ADS, "About revenue sharing"),
+        Item(ChatActivity.OPTION_REMOVE_ADS, "Remove ads"),
+        Item(ChatActivity.OPTION_GIFT, "Send a gift"),
+        Item(ChatActivity.OPTION_UNVOTE, "Unvote"),
+        Item(ChatActivity.OPTION_STOP_POLL_OR_QUIZ, "Stop poll"),
+        Item(ChatActivity.OPTION_EDIT_TODO, "Edit checklist"),
+        Item(ChatActivity.OPTION_ADD_TO_TODO, "Add tasks"),
+        Item(ChatActivity.OPTION_FACT_CHECK, "Edit fact check"),
+        Item(ChatActivity.OPTION_WELCOME_REVERT, "Revert welcome"),
+        Item(ChatActivity.tele_option_copy_msg_id, "copy message id"),
+        Item(ChatActivity.tele_option_copy_emoji_id, "copy emoji id"),
+        Item(ChatActivity.tele_option_mark_viewed, "mark as viewed")
+    )
+
+    private const val KEY = "message_menu_hidden"
+
+    private fun load(): MutableSet<Int>? {
+        val raw = TeleDatabaseHelper.get(KEY) ?: return null
+        val out = mutableSetOf<Int>()
+        runCatching {
+            val array = JSONArray(raw)
+            for (i in 0 until array.length()) {
+                out.add(array.getInt(i))
+            }
+        }
+        return out
+    }
+
+    private fun save(hidden: MutableSet<Int>) {
+        if (hidden.isEmpty()) {
+            TeleDatabaseHelper.put(KEY, null)
+        } else {
+            val array = JSONArray()
+            hidden.forEach { array.put(it) }
+            TeleDatabaseHelper.put(KEY, array.toString())
+        }
+    }
+
+    @JvmStatic
+    fun isHidden(code: Int): Boolean = load()?.contains(code) ?: false
+
+    @JvmStatic
+    fun setHidden(code: Int, hidden: Boolean) {
+        val set = load() ?: mutableSetOf()
+        if (hidden) {
+            set.add(code)
+        } else {
+            set.remove(code)
+        }
+        save(set)
+    }
+
+    @JvmStatic
+    fun filter(items: ArrayList<CharSequence>, icons: ArrayList<Int>, options: ArrayList<Int>) {
+        val hidden = load() ?: return
+        if (hidden.isEmpty()) return
+        for (i in options.indices.reversed()) {
+            if (options[i] in hidden) {
+                items.removeAt(i)
+                icons.removeAt(i)
+                options.removeAt(i)
+            }
+        }
+    }
+}
