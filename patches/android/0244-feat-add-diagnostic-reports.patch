diff --git a/TMessagesProj/src/main/java/tele/helpers/TeleFreeze.kt b/TMessagesProj/src/main/java/tele/helpers/TeleFreeze.kt
new file mode 100644
index 000000000..6b9ed0ce9
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/TeleFreeze.kt
@@ -0,0 +1,119 @@
+package tele.helpers
+
+import android.content.Context
+import android.os.Build
+import android.os.Handler
+import android.os.Looper
+import android.os.SystemClock
+import org.telegram.messenger.ApplicationLoader
+import org.telegram.messenger.BuildVars
+import org.telegram.messenger.FileLog
+import tele.TeleBuild
+import tele.TeleConfig
+import java.io.File
+import java.util.concurrent.atomic.AtomicBoolean
+import java.util.concurrent.atomic.AtomicLong
+
+/**
+ * Watches the main thread from the outside: when it stops ticking for longer than the threshold, a
+ * small marker is left for the next start, which turns it into a diagnostic report.
+ */
+object TeleFreeze {
+
+    private const val FILE = "tele_freeze.txt"
+    private const val THRESHOLD_MS = 15_000L
+    private const val TICK_MS = 1_000L
+
+    private val beat = AtomicLong(0)
+    private val reported = AtomicBoolean(false)
+    private var started = false
+    private var thread: Thread? = null
+    private val handler by lazy { Handler(Looper.getMainLooper()) }
+    private val tick = object : Runnable {
+        override fun run() {
+            beat.set(SystemClock.elapsedRealtime())
+            // the main thread is alive again: the next episode may be reported
+            reported.set(false)
+            handler.postDelayed(this, TICK_MS)
+        }
+    }
+
+    @JvmStatic
+    fun markerFile(context: Context = ApplicationLoader.applicationContext): File =
+        File(context.filesDir, FILE)
+
+    @JvmStatic
+    fun hasMarker(context: Context = ApplicationLoader.applicationContext): Boolean =
+        markerFile(context).exists() && markerFile(context).length() > 0
+
+    /** The freeze of the last run in seconds, or 0 when the marker is missing or broken. */
+    @JvmStatic
+    fun lastedSeconds(context: Context = ApplicationLoader.applicationContext): Int {
+        if (!hasMarker(context)) return 0
+        val text = runCatching { markerFile(context).readText() }.getOrNull() ?: return 0
+        val match = Regex("freeze (\\d+) s").find(text) ?: return 0
+        return match.groupValues[1].toIntOrNull() ?: 0
+    }
+
+    @JvmStatic
+    fun clear(context: Context = ApplicationLoader.applicationContext) {
+        runCatching { markerFile(context).delete() }
+    }
+
+    @JvmStatic
+    fun start() {
+        if (started || !TeleConfig.DIAG_FREEZE.value) return
+        started = true
+        beat.set(SystemClock.elapsedRealtime())
+        handler.post(tick)
+        thread = Thread({ loop() }, "tele-freeze").apply {
+            isDaemon = true
+            start()
+        }
+    }
+
+    @JvmStatic
+    fun stop() {
+        started = false
+        handler.removeCallbacks(tick)
+        thread?.interrupt()
+        thread = null
+    }
+
+    private fun loop() {
+        while (started) {
+            try {
+                Thread.sleep(TICK_MS)
+            } catch (e: InterruptedException) {
+                return
+            }
+            val gap = SystemClock.elapsedRealtime() - beat.get()
+            if (gap > THRESHOLD_MS && reported.compareAndSet(false, true)) {
+                write(gap)
+            }
+        }
+    }
+
+    private fun write(gapMs: Long) {
+        try {
+            val context = ApplicationLoader.applicationContext
+            val file = markerFile(context)
+            val tmp = File(context.filesDir, "$FILE.tmp")
+            val seconds = gapMs / 1000L
+            val text = buildString {
+                appendLine("Tele-Note: freeze $seconds s")
+                appendLine("start=${SystemClock.elapsedRealtime() - gapMs}")
+                appendLine("Version: ${BuildVars.BUILD_VERSION_STRING}")
+                appendLine("tele: ${TeleBuild.BUILD}")
+                appendLine("Device: ${Build.MANUFACTURER} ${Build.MODEL}, android ${Build.VERSION.RELEASE}")
+            }
+            tmp.writeText(text)
+            if (!tmp.renameTo(file)) {
+                file.delete()
+                tmp.renameTo(file)
+            }
+        } catch (e: Throwable) {
+            FileLog.e(e)
+        }
+    }
+}
