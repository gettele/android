+    /**
+     * A run that ended without our handler: a caught freeze or an exit the system remembers. The
+     * report carries only the note, never account data.
+     */
+    @JvmStatic
+    fun prepareDiagnostics(context: Context = ApplicationLoader.applicationContext) {
+        if (!collecting()) return
+        if (hasPending(context) || hasDiagnostics(context)) return
+        if (TeleConfig.DIAG_FREEZE.value) {
+            val seconds = TeleFreeze.lastedSeconds(context)
+            if (seconds > 0) {
+                writeDiagnostics(context, "freeze " + seconds + " s", "the interface stopped for " + seconds + " s")
+                TeleFreeze.clear(context)
+                return
+            }
+        }
+        if (!TeleConfig.DIAG_NO_DUMP.value) return
+        val reason = lastExit(context) ?: return
+        TeleConfig.set(TeleConfig.DIAG_LAST_EXIT, reason.stamp)
+        writeDiagnostics(context, reason.note, reason.description)
+    }
+
+    private class Exit(@JvmField val stamp: String, @JvmField val note: String, @JvmField val description: String)
+
+    private fun lastExit(context: Context): Exit? {
+        if (Build.VERSION.SDK_INT < 30) return null
+        val manager = context.getSystemService(Context.ACTIVITY_SERVICE) as ActivityManager
+        val infos = runCatching {
+            manager.getHistoricalProcessExitReasons(context.packageName, 0, 5)
+        }.getOrNull() ?: return null
+        // a normal stop (the user swiped the app away, android reclaimed it) is not worth a report:
+        // only the endings that leave no dump of their own are, and the newest of them wins
+        for (info in infos) {
+            if (info.timestamp <= 0) continue
+            val note = when (info.reason) {
+                ApplicationExitInfo.REASON_CRASH, ApplicationExitInfo.REASON_CRASH_NATIVE -> "crash without a dump"
+                ApplicationExitInfo.REASON_ANR -> "freeze killed by the system"
+                ApplicationExitInfo.REASON_LOW_MEMORY -> "out of memory"
+                ApplicationExitInfo.REASON_SIGNALED -> "killed by a signal"
+                else -> continue
+            }
+            val stamp = info.timestamp.toString()
+            if (stamp == TeleConfig.DIAG_LAST_EXIT.value) return null
+            val description = runCatching { info.description.orEmpty() }.getOrDefault("")
+            return Exit(stamp, note, description)
+        }
+        return null
+    }
+
+    private fun writeDiagnostics(context: Context, note: String, description: String) {
+        val report = buildString {
+            appendLine("platform: Android")
+            appendLine("Version: ${BuildVars.BUILD_VERSION_STRING} (${versionCode(context)})")
+            appendLine("tele: ${TeleBuild.BUILD}")
+            appendLine("Device: ${Build.MANUFACTURER} ${Build.MODEL}, android ${Build.VERSION.RELEASE} (sdk ${Build.VERSION.SDK_INT})")
+            appendLine(memory(context))
+            appendLine("Tele-Note: $note")
+            if (description.isNotEmpty()) appendLine("exit: $description")
+        }
+        runCatching { diagFile(context).writeText(report) }
+    }
