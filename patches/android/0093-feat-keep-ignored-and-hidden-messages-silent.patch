From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Tue, 20 Oct 2026 08:04:34 +0300
Subject: [PATCH 093/128] feat: keep ignored and hidden messages silent

---
 .../org/telegram/messenger/NotificationsController.java   | 5 +++++
 TMessagesProj/src/main/java/tele/TeleConfig.kt            | 8 ++++++++
 2 files changed, 13 insertions(+)

diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/NotificationsController.java b/TMessagesProj/src/main/java/org/telegram/messenger/NotificationsController.java
index f279e00cc..5c0644d03 100644
--- a/TMessagesProj/src/main/java/org/telegram/messenger/NotificationsController.java
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/NotificationsController.java
@@ -1125,6 +1125,11 @@ public class NotificationsController extends BaseController implements Notificat
 
             for (int a = 0; a < messageObjects.size(); a++) {
                 MessageObject messageObject = messageObjects.get(a);
+                if (messageObject != null && tele.TeleConfig.MUTE_IGNORED.getValue() &&
+                        tele.helpers.PrivacyRules.isMuted(currentAccount, messageObject.getDialogId(), messageObject)) {
+                    // the message stays in the history, but it never notifies
+                    continue;
+                }
                 if (messageObject.messageOwner != null && (messageObject.isImportedForward() ||
                         messageObject.messageOwner.action instanceof TLRPC.TL_messageActionSetMessagesTTL ||
                         messageObject.messageOwner.silent && (messageObject.messageOwner.action instanceof TLRPC.TL_messageActionContactSignUp || messageObject.messageOwner.action instanceof TLRPC.TL_messageActionUserJoined)) ||
diff --git a/TMessagesProj/src/main/java/tele/TeleConfig.kt b/TMessagesProj/src/main/java/tele/TeleConfig.kt
index 208acfe4d..5b6ec3c7d 100644
--- a/TMessagesProj/src/main/java/tele/TeleConfig.kt
+++ b/TMessagesProj/src/main/java/tele/TeleConfig.kt
@@ -79,6 +79,14 @@ object TeleConfig {
     @JvmField
     val GHOST_SCHEDULE = BoolItem("ghost_schedule", false)
     @JvmField
+    val GHOST_SCHEDULED_MESSAGES = BoolItem("ghost_scheduled_messages", false)
+    @JvmField
+    val MUTE_IGNORED = BoolItem("mute_ignored", false)
+    @JvmField
+    val LAST_SEEN_RESTORE = BoolItem("last_seen_restore", false)
+    @JvmField
+    val STREAMER_MODE = BoolItem("streamer_mode", false)
+    @JvmField
     val HIDDEN_WORDS = BoolItem("hidden_words", false)
     @JvmField
     val NEVER_BLOCK_SCREENSHOTS = BoolItem("never_block_screenshots", false)
