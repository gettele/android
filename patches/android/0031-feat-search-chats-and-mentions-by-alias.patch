                 final long did = match.second;
diff --git a/TMessagesProj/src/main/java/tele/helpers/Aliases.kt b/TMessagesProj/src/main/java/tele/helpers/Aliases.kt
index 015fa2aef..962290d86 100644
--- a/TMessagesProj/src/main/java/tele/helpers/Aliases.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/Aliases.kt
@@ -135,7 +135,8 @@ object Aliases {
     }
 
     @JvmStatic
-    fun matchingPeers(account: Int, query: String): List<android.util.Pair<String, Long>> {
+    @JvmOverloads
+    fun matchingPeers(account: Int, query: String, anywhere: Boolean = false): List<android.util.Pair<String, Long>> {
         if (!TeleConfig.USERNAME_ALIASES.value || query.isEmpty()) return emptyList()
         val q = query.lowercase()
         val out = ArrayList<android.util.Pair<String, Long>>()
@@ -144,7 +145,7 @@ object Aliases {
             map.forEach { (key, id) ->
                 if (!key.startsWith("$account:")) return@forEach
                 val alias = key.substring(account.toString().length + 1)
-                if (alias.startsWith(q) && alias.length > q.length) {
+                if (if (anywhere) alias.contains(q) else alias.startsWith(q) && alias.length > q.length) {
                     out.add(android.util.Pair(alias, id))
                 }
             }
@@ -153,6 +154,37 @@ object Aliases {
         return out
     }
 
+    @JvmStatic
+    fun addToLocalSearch(account: Int, query: String, result: ArrayList<Any>, names: ArrayList<CharSequence>) {
+        if (!TeleConfig.USERNAME_ALIASES.value || query.isEmpty()) return
+        val matches = matchingPeers(account, query, true)
+        if (matches.isEmpty()) return
+        val present = HashSet<Long>()
+        for (obj in result) {
+            if (obj is TLRPC.User) present.add(obj.id)
+            if (obj is TLRPC.Chat) present.add(-obj.id)
+        }
+        val controller = org.telegram.messenger.MessagesController.getInstance(account)
+        for (match in matches) {
+            val alias = match.first
+            val did = match.second
+            if (present.contains(did)) continue
+            if (did > 0) {
+                val user = controller.getUser(did) ?: continue
+                result.add(user)
+                names.add(org.telegram.messenger.AndroidUtilities.generateSearchName(
+                    org.telegram.messenger.ContactsController.formatName(user.first_name, user.last_name),
+                    "@$alias",
+                    "@$query"
+                ))
+            } else {
+                val chat = controller.getChat(-did) ?: continue
+                result.add(chat)
+                names.add(org.telegram.messenger.AndroidUtilities.generateSearchName(chat.title, "@$alias", "@$query"))
+            }
+        }
+    }
+
     @JvmStatic
     fun findAll(text: CharSequence): List<String> {
