+package tele.ui
+
+import android.content.Context
+import android.graphics.PorterDuff
+import android.graphics.PorterDuffColorFilter
+import android.text.Editable
+import android.text.TextUtils
+import android.text.TextWatcher
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.View
+import android.view.ViewGroup
+import android.widget.FrameLayout
+import android.widget.ImageView
+import android.widget.LinearLayout
+import android.widget.TextView
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.AndroidUtilities.dp
+import org.telegram.messenger.LiteMode
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.R
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.ChatActivity
+import org.telegram.ui.Components.ChatActivityEnterView
+import org.telegram.ui.Components.LayoutHelper
+
+/** The "Editing draft" bar above the field of a chat; the X gives the draft up. */
+class TeleDraftEditBar private constructor(
+    context: Context,
+    private val fragment: ChatActivity,
+    enterView: ChatActivityEnterView
+) : FrameLayout(context) {
+
+    private val subtitle = TextView(context)
+    private var shown = false
+
+    init {
+        visibility = GONE
+        elevation = dp(2f).toFloat()
+        background = Theme.createRoundRectDrawable(dp(12f), fragment.getThemedColor(Theme.key_chat_messagePanelBackground))
+        isClickable = true
+
+        val icon = ImageView(context)
+        icon.scaleType = ImageView.ScaleType.CENTER
+        icon.setImageResource(R.drawable.msg_edit)
+        icon.colorFilter = PorterDuffColorFilter(fragment.getThemedColor(Theme.key_chat_replyPanelIcons), PorterDuff.Mode.MULTIPLY)
+        addView(icon, LayoutHelper.createFrame(36, 36f, Gravity.LEFT or Gravity.CENTER_VERTICAL, 8f, 0f, 0f, 0f))
+
+        val texts = LinearLayout(context)
+        texts.orientation = LinearLayout.VERTICAL
+        val title = TextView(context)
+        title.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14f)
+        title.typeface = AndroidUtilities.bold()
+        title.setTextColor(fragment.getThemedColor(Theme.key_chat_replyPanelName))
+        title.isSingleLine = true
+        title.ellipsize = TextUtils.TruncateAt.END
+        title.text = LocaleController.getString(R.string.TeleDraftEditing)
+        subtitle.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13f)
+        subtitle.setTextColor(fragment.getThemedColor(Theme.key_chat_messagePanelHint))
+        subtitle.isSingleLine = true
+        subtitle.ellipsize = TextUtils.TruncateAt.END
+        texts.addView(title, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT))
+        texts.addView(subtitle, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT))
+        addView(texts, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT.toFloat(), Gravity.CENTER_VERTICAL, 50f, 6f, 44f, 6f))
+
+        val close = ImageView(context)
+        close.scaleType = ImageView.ScaleType.CENTER
+        close.setImageResource(R.drawable.input_clear)
+        close.colorFilter = PorterDuffColorFilter(fragment.getThemedColor(Theme.key_chat_replyPanelClose), PorterDuff.Mode.MULTIPLY)
+        close.background = Theme.createSelectorDrawable(fragment.getThemedColor(Theme.key_listSelector), Theme.RIPPLE_MASK_CIRCLE_20DP, dp(18f))
+        close.contentDescription = LocaleController.getString(R.string.TeleDraftEditCancel)
+        close.setOnClickListener { fragment.teleDraftEditing()?.cancel() }
+        addView(close, LayoutHelper.createFrame(40, 40f, Gravity.RIGHT or Gravity.CENTER_VERTICAL, 0f, 0f, 4f, 0f))
+
+        // editing a sent message takes the field over, the bar has to step aside
+        enterView.addTextChangedListener(object : TextWatcher {
+            override fun beforeTextChanged(s: CharSequence?, start: Int, count: Int, after: Int) = Unit
+            override fun onTextChanged(s: CharSequence?, start: Int, before: Int, count: Int) = Unit
+            override fun afterTextChanged(s: Editable?) = update()
+        })
+    }
+
+    /** The height the bar takes above the field, 0 while hidden. */
+    fun occupied(): Float = if (shown) dp(48f + 6f).toFloat() else 0f
+
+    fun update() {
+        val show = fragment.teleEditingDraft()
+        if (show) {
+            subtitle.text = fragment.teleDraftEditing()?.subtitle() ?: ""
+        }
+        if (shown != show) {
+            shown = show
+            AndroidUtilities.updateViewShow(this, show, false, isAttachedToWindow && LiteMode.isEnabled(LiteMode.FLAG_CHAT_SCALE))
+            fragment.teleDraftBarChanged()
+        }
+    }
+
+    companion object {
+        @JvmStatic
+        fun attach(fragment: ChatActivity, content: ViewGroup, enterView: ChatActivityEnterView, below: View?): TeleDraftEditBar? {
+            if (fragment.chatMode != ChatActivity.MODE_DEFAULT) return null
+            val view = TeleDraftEditBar(content.context, fragment, enterView)
+            val index = below?.let { content.indexOfChild(it) } ?: -1
+            content.addView(view, index, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, 48f, Gravity.BOTTOM or Gravity.LEFT, 10f, 0f, 10f, 0f))
+            return view
+        }
+    }
+}
