+import org.telegram.ui.Components.LayoutHelper
+
+/** A row of the chat list for the tele archives: userpic, name and time on top, a preview and counters below. */
+class TeleChatRow(context: Context) : FrameLayout(context) {
+    val avatar = BackupImageView(context)
+    val name = TextView(context)
+    val time = TextView(context)
+    val preview = TextView(context)
+    /** The muted counter, left of the main one. */
+    val secondary = TextView(context)
+    val counter = TextView(context)
+
+    init {
+        setWillNotDraw(false)
+        avatar.setRoundRadius(AndroidUtilities.dp(28f))
+        addView(avatar, LayoutHelper.createFrame(56, 56f, Gravity.LEFT or Gravity.CENTER_VERTICAL, 10f, 0f, 0f, 0f))
+
+        val top = LinearLayout(context)
+        top.orientation = LinearLayout.HORIZONTAL
+        name.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16f)
+        name.typeface = AndroidUtilities.bold()
+        name.setTextColor(Theme.getColor(Theme.key_chats_name))
+        name.isSingleLine = true
+        name.ellipsize = TextUtils.TruncateAt.END
+        top.addView(name, LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f))
+        time.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13f)
+        time.setTextColor(Theme.getColor(Theme.key_chats_date))
+        top.addView(time, LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT).apply { leftMargin = AndroidUtilities.dp(8f) })
+        addView(top, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT.toFloat(), Gravity.TOP, 78f, 12f, 14f, 0f))
+
+        val bottom = LinearLayout(context)
+        bottom.orientation = LinearLayout.HORIZONTAL
+        bottom.gravity = Gravity.CENTER_VERTICAL
+        preview.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15f)
+        preview.setTextColor(Theme.getColor(Theme.key_chats_message))
+        preview.isSingleLine = true
+        preview.ellipsize = TextUtils.TruncateAt.END
+        bottom.addView(preview, LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f))
+        for (badge in listOf(secondary, counter)) {
+            badge.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13f)
+            badge.typeface = AndroidUtilities.bold()
+            badge.gravity = Gravity.CENTER
+            badge.minWidth = AndroidUtilities.dp(23f)
+            badge.setPadding(AndroidUtilities.dp(7f), 0, AndroidUtilities.dp(7f), 0)
+            bottom.addView(badge, LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, AndroidUtilities.dp(23f)).apply { leftMargin = AndroidUtilities.dp(6f) })
+        }
+        counter.setTextColor(Theme.getColor(Theme.key_chats_unreadCounterText))
+        counter.background = Theme.createRoundRectDrawable(AndroidUtilities.dp(11.5f), Theme.getColor(Theme.key_chats_unreadCounter))
+        secondary.setTextColor(Theme.getColor(Theme.key_chats_unreadCounterText))
+        secondary.background = Theme.createRoundRectDrawable(AndroidUtilities.dp(11.5f), Theme.getColor(Theme.key_chats_unreadCounterMuted))
+        addView(bottom, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT.toFloat(), Gravity.TOP, 78f, 38f, 14f, 0f))
+    }
+
+    /** The userpic of a chat, the bookmark for Saved Messages. */
+    fun setPeer(account: Int, dialogId: Long) {
+        val controller = MessagesController.getInstance(account)
+        val user = if (dialogId > 0) controller.getUser(dialogId) else null
+        val chat = if (dialogId < 0) controller.getChat(-dialogId) else null
+        when {
+            user != null && UserObject.isUserSelf(user) -> avatar.setImageDrawable(AvatarDrawable().apply { setAvatarType(AvatarDrawable.AVATAR_TYPE_SAVED) })
+            user != null -> avatar.setForUserOrChat(user, AvatarDrawable(user))
+            chat != null -> avatar.setForUserOrChat(chat, AvatarDrawable(chat))
+            else -> avatar.setImageDrawable(AvatarDrawable())
+        }
+    }
+
+    override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
+        super.onMeasure(widthMeasureSpec, MeasureSpec.makeMeasureSpec(AndroidUtilities.dp(72f), MeasureSpec.EXACTLY))
+    }
+
+    // the divider of the chat list starts under the text, not the userpic
+    override fun onDraw(canvas: Canvas) {
+        val left = if (LocaleController.isRTL) 0f else AndroidUtilities.dp(78f).toFloat()
+        val right = if (LocaleController.isRTL) (width - AndroidUtilities.dp(78f)).toFloat() else width.toFloat()
+        canvas.drawLine(left, height - 1f, right, height - 1f, Theme.dividerPaint)
+    }
+}
