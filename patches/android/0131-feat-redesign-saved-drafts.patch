+                height = retriever.extractMetadata(android.media.MediaMetadataRetriever.METADATA_KEY_VIDEO_HEIGHT)?.toIntOrNull() ?: 0
+                val rotation = retriever.extractMetadata(android.media.MediaMetadataRetriever.METADATA_KEY_VIDEO_ROTATION)?.toIntOrNull() ?: 0
+                if (rotation == 90 || rotation == 270) {
+                    val swap = width
+                    width = height
+                    height = swap
+                }
+                duration = ((retriever.extractMetadata(android.media.MediaMetadataRetriever.METADATA_KEY_DURATION)?.toLongOrNull() ?: 0L) / 1000L).toInt()
+            } catch (e: Exception) {
+                FileLog.e(e)
+            } finally {
+                try {
+                    retriever.release()
+                } catch (ignore: Exception) {
+                }
+            }
