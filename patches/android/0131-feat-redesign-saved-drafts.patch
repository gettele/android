diff --git a/TMessagesProj/src/main/java/tele/helpers/DraftDiscards.kt b/TMessagesProj/src/main/java/tele/helpers/DraftDiscards.kt
new file mode 100644
index 000000000..4513192f6
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/DraftDiscards.kt
@@ -0,0 +1,142 @@
+package tele.helpers
+
+import android.text.SpannableStringBuilder
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.MediaDataController
+import org.telegram.messenger.MessageObject
+import org.telegram.messenger.NotificationCenter
+import org.telegram.tgnet.TLRPC
+import org.telegram.ui.ChatActivity
+
+/**
+ * Keeps a long text that left the field of a chat as a discarded draft, a port of the desktop capture:
+ * a meaningful text that is mostly lost and not sent within the next moments.
+ */
+class DraftDiscards(private val chat: ChatActivity) : NotificationCenter.NotificationCenterDelegate {
+
+    private class Snapshot(val text: String, val draft: TLRPC.TL_draftMessage, val reply: TLRPC.Message?)
+
+    private class Pending(val snapshot: Snapshot, val at: Long)
+
+    private val account = chat.currentAccount
+    private val dialogId = chat.dialogId
+    private val topicId = chat.topicId.toInt()
+    private var previous: Snapshot? = null
+    private val pending = ArrayList<Pending>()
+    private val snapshotRunnable = Runnable { takeSnapshot() }
+    private val pendingRunnable = Runnable { checkPending() }
+
+    init {
+        NotificationCenter.getInstance(account).addObserver(this, NotificationCenter.didReceiveNewMessages)
+        open.add(key(account, dialogId, topicId))
+    }
+
+    /** Forgets the text in the field: a text the app puts there itself is no loss. */
+    fun reset() {
+        previous = null
+        AndroidUtilities.cancelRunOnUIThread(snapshotRunnable)
+    }
+
+    private fun fieldText(): String? = chat.chatActivityEnterView?.editField?.text?.toString()
+
+    private fun editing(): Boolean = chat.chatActivityEnterView?.isEditingMessage == true
+
+    fun onTextChanged() {
+        if (editing()) {
+            // the edits of a sent message are not drafts
+            previous = null
+            AndroidUtilities.cancelRunOnUIThread(snapshotRunnable)
+            return
+        }
+        val current = fieldText() ?: return
+        val was = previous
+        if (was != null && lost(was.text, current)) {
+            pending.add(Pending(was, System.currentTimeMillis()))
+            previous = null
+            AndroidUtilities.cancelRunOnUIThread(pendingRunnable)
+            AndroidUtilities.runOnUIThread(pendingRunnable, PENDING_DELAY)
+        }
+        AndroidUtilities.cancelRunOnUIThread(snapshotRunnable)
+        if (meaningful(current)) {
+            AndroidUtilities.runOnUIThread(snapshotRunnable, SNAPSHOT_DELAY)
+        } else {
+            previous = null
+        }
+    }
+
+    // the reply and the link preview go with the text, so they are read a moment after typing
+    private fun takeSnapshot() {
+        if (editing()) return
+        val enterView = chat.chatActivityEnterView ?: return
+        val field = enterView.editField ?: return
+        val text = field.text?.toString() ?: return
+        if (!meaningful(text)) return
+        val chars = arrayOf<CharSequence>(SpannableStringBuilder(field.text))
+        val entities = MediaDataController.getInstance(account).getEntities(chars, true)
+        val reply = enterView.replyingMessageObject?.messageOwner
+        previous = Snapshot(text, SavedDrafts.buildDraftMessage(chars[0], entities, reply, enterView.webPage), reply)
+    }
+
+    private fun checkPending() {
+        val current = fieldText()?.let(::normalized)
+        val list = ArrayList(pending)
+        pending.clear()
+        for (entry in list) {
+            if (SavedDrafts.sentSince(dialogId, entry.at - SENT_WINDOW)) continue
+            // the text came back: undone or typed again
+            if (current != null && !editing() && current.contains(normalized(entry.snapshot.text))) continue
+            SavedDrafts.saveDiscarded(account, dialogId, topicId, entry.snapshot.draft, entry.snapshot.reply)
+        }
+    }
+
+    override fun didReceivedNotification(id: Int, account: Int, vararg args: Any?) {
+        if (id != NotificationCenter.didReceiveNewMessages) return
+        val targetDialog = args.getOrNull(0) as? Long ?: return
+        @Suppress("UNCHECKED_CAST")
+        val messages = args.getOrNull(1) as? ArrayList<MessageObject> ?: return
+        if (messages.any { it.isOut && it.isSending }) SavedDrafts.noteSent(targetDialog)
+    }
+
+    fun destroy() {
+        open.remove(key(account, dialogId, topicId))
+        NotificationCenter.getInstance(account).removeObserver(this, NotificationCenter.didReceiveNewMessages)
+        AndroidUtilities.cancelRunOnUIThread(snapshotRunnable)
+        AndroidUtilities.cancelRunOnUIThread(pendingRunnable)
+        // leaving the chat right after clearing the field still keeps the text
+        if (pending.isNotEmpty()) checkPending()
+    }
+
+    companion object {
+        // the chats whose field is shown: their losses are seen by the field, not by the cloud draft
+        private val open = HashSet<String>()
+
+        private fun key(account: Int, dialogId: Long, topicId: Int) = "$account:$dialogId:$topicId"
+
+        @JvmStatic
+        fun isOpen(account: Int, dialogId: Long, topicId: Int): Boolean = key(account, dialogId, topicId) in open
+
+        private const val MIN_LENGTH = 30
+        private const val SNAPSHOT_DELAY = 300L
+        private const val PENDING_DELAY = 1500L
+        private const val SENT_WINDOW = 2000L
+
+        private fun normalized(text: String) = text.trim().replace(Regex("\\s+"), " ")
+
+        @JvmStatic
+        fun meaningful(text: String) = text.trim().length > MIN_LENGTH
+
+        /** At least half of a meaningful text is gone and the rest does not hold it. */
+        @JvmStatic
+        fun lost(was: String, now: String): Boolean {
+            if (!meaningful(was)) return false
+            val before = normalized(was)
+            val after = normalized(now)
+            var prefix = 0
+            val limit = minOf(before.length, after.length)
+            while (prefix < limit && before[prefix] == after[prefix]) prefix++
+            var suffix = 0
+            while (suffix < limit - prefix && before[before.length - 1 - suffix] == after[after.length - 1 - suffix]) suffix++
+            return (prefix + suffix) * 2 < before.length && !after.contains(before)
+        }
+    }
+}
diff --git a/TMessagesProj/src/main/java/tele/helpers/DraftEditing.kt b/TMessagesProj/src/main/java/tele/helpers/DraftEditing.kt
new file mode 100644
index 000000000..89635ad1a
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/DraftEditing.kt
@@ -0,0 +1,157 @@
+package tele.helpers
+
+import android.text.SpannableStringBuilder
+import android.text.TextUtils
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.MessageObject
+import org.telegram.messenger.R
+import org.telegram.ui.ChatActivity
+
+/**
+ * A saved draft being edited in the field of a chat, a port of the desktop editing flow:
+ * the field and the reply are borrowed from the draft and the previous ones come back afterwards.
+ * Leaving the chat just drops the state: the field keeps whatever it holds, like a regular draft.
+ */
+class DraftEditing(private val chat: ChatActivity) {
+
+    private val account = chat.currentAccount
+    private val dialogId = chat.dialogId
+    private val topicId = chat.topicId.toInt()
+
+    var draft: SavedDrafts.Draft? = null
+        private set
+    private var beforeText: CharSequence? = null
+    private var beforeReply: MessageObject? = null
+    private var bypass = false
+
+    val active: Boolean get() = draft != null
+
+    /** Takes the draft into the field; the draft record stays until the edit is saved. */
+    fun start(next: SavedDrafts.Draft) {
+        val enter = chat.chatActivityEnterView ?: return
+        if (next.dialogId != dialogId || next.topicId != topicId) return
+        if (draft?.id == next.id) return
+        if (active) finish(draft?.files?.isNotEmpty() == true)
+        beforeText = enter.editField?.text?.let { SpannableStringBuilder(it) }
+        beforeReply = enter.replyingMessageObject
+        draft = next
+        open.add(key(account, dialogId, topicId))
+        // the text the app puts into the field is not a loss
+        chat.teleDiscards()?.reset()
+        if (next.replyMessage == null && beforeReply != null) chat.hideFieldPanel(true)
+        chat.teleLoadDraft(next)
+        chat.teleDraftEditChanged()
+    }
+
+    /** Ends the edit and brings the previous field and reply back. */
+    fun finish(clearFiles: Boolean) {
+        if (draft == null) return
+        val enter = chat.chatActivityEnterView
+        // the tray is cleared while the edit still counts, so that it is not taken for a discard
+        if (clearFiles) {
+            DockedMedia.clear(chat)
+            chat.chatAttachAlert?.photoLayout?.clearSelectedPhotos()
+        }
+        val text = beforeText
+        val reply = beforeReply
+        forget()
+        if (enter != null) {
+            chat.teleDiscards()?.reset()
+            enter.setFieldText(text ?: "", true, true)
+            if (reply != null) {
+                chat.showFieldPanelForReply(reply)
+            } else if (enter.replyingMessageObject != null) {
+                chat.hideFieldPanel(true)
+            }
+        }
+        chat.teleDraftEditChanged()
+    }
+
+    /** The X of the bar: the draft stays as it was saved. */
+    fun cancel() {
+        finish(draft?.files?.isNotEmpty() == true)
+    }
+
+    fun destroy() {
+        forget()
+    }
+
+    private fun forget() {
+        draft = null
+        beforeText = null
+        beforeReply = null
+        open.remove(key(account, dialogId, topicId))
+    }
+
+    /** Drops the edit when the draft was deleted meanwhile; the field keeps its text. */
+    fun validate() {
+        val current = draft ?: return
+        val fresh = SavedDrafts.find(account, current.id)
+        if (fresh == null) {
+            forget()
+            chat.teleDraftEditChanged()
+        } else {
+            draft = fresh
+        }
+    }
+
+    /** Sending while editing saves the field into the draft instead; true when it did. */
+    fun intercept(): Boolean {
+        val enter = chat.chatActivityEnterView ?: return false
+        if (!active || bypass || enter.isEditingMessage) return false
+        validate()
+        if (!active) return false
+        return chat.teleSaveDraftFromField(false)
+    }
+
+    /** A real send that removes the draft once the field is empty; true when a dialog was shown. */
+    fun sendThrough(notify: Boolean, scheduleDate: Int, repeat: Int): Boolean {
+        val id = draft?.id ?: return false
+        val enter = chat.chatActivityEnterView ?: return false
+        bypass = true
+        val shown = try {
+            enter.teleSendThrough(notify, scheduleDate, repeat)
+        } finally {
+            bypass = false
+        }
+        // the field is cleared a moment after a send, and not at all when something blocked it
+        AndroidUtilities.runOnUIThread({ removeAfterSend(id) }, SEND_CHECK_DELAY)
+        return shown
+    }
+
+    private fun removeAfterSend(id: Long) {
+        if (draft?.id != id || !fieldEmpty()) return
+        // the record goes, the files stay for the upload
+        SavedDrafts.removeRecord(account, id)
+        finish(false)
+    }
+
+    private fun fieldEmpty(): Boolean {
+        val enter = chat.chatActivityEnterView ?: return false
+        if (!TextUtils.isEmpty(enter.editField?.text)) return false
+        if (DockedMedia.draftEntries(chat).isNotEmpty()) return false
+        val selected = chat.chatAttachAlert?.photoLayout?.selectedPhotos
+        return selected == null || selected.isEmpty()
+    }
+
+    /** The first line of the text, else the file count, for the bar. */
+    fun subtitle(): String {
+        val current = draft ?: return ""
+        current.name?.let { return it }
+        current.text.lineSequence().map { it.trim().replace(Regex("\\s+"), " ") }.firstOrNull { it.isNotEmpty() }?.let { return it }
+        return LocaleController.formatString(R.string.TeleDraftFiles, current.files.size)
+    }
+
+    companion object {
+        private const val SEND_CHECK_DELAY = 450L
+
+        // the chats whose field shows an edited draft
+        private val open = HashSet<String>()
+
+        private fun key(account: Int, dialogId: Long, topicId: Int) = "$account:$dialogId:$topicId"
+
+        @JvmStatic
+        fun isEditing(account: Int, dialogId: Long, topicId: Int): Boolean = key(account, dialogId, topicId) in open
+    }
+}
diff --git a/TMessagesProj/src/main/java/tele/helpers/DraftMessages.kt b/TMessagesProj/src/main/java/tele/helpers/DraftMessages.kt
new file mode 100644
index 000000000..c671a0e83
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/DraftMessages.kt
@@ -0,0 +1,146 @@
+package tele.helpers
+
+import android.provider.MediaStore
+import org.telegram.messenger.ImageLoader
+import org.telegram.messenger.MessageObject
+import org.telegram.messenger.MessagesController
+import org.telegram.messenger.SendMessagesHelper
+import org.telegram.messenger.UserConfig
+import org.telegram.messenger.Utilities
+import org.telegram.tgnet.TLRPC
+
+/** Turns a saved draft into the outgoing bubbles it would send, like a message that is being sent. */
+object DraftMessages {
+
+    // the local media of a stored file is made once per session, it costs a decode and a write
+    private val photos = HashMap<String, TLRPC.TL_photo>()
+    private val videos = HashMap<String, TLRPC.TL_document>()
+
+    private var nextId = 1
+
+    /** Builds off the main thread: the media sizes are written to the cache like for sending. */
+    @JvmStatic
+    fun build(account: Int, draft: SavedDrafts.Draft, emptyText: String): List<ShotEntry> {
+        val files = draft.files.filter { SavedDrafts.storedFile(it.storedName).exists() }
+        val reply = draft.replyMessage?.let { MessageObject(account, it, false, false) }
+        if (files.isEmpty()) {
+            val message = base(account, draft)
+            message.message = draft.text.ifEmpty { emptyText }
+            if (draft.text.isNotEmpty()) message.entities = draft.message.entities
+            withReply(message, reply)
+            return listOf(ShotEntry(MessageObject(account, message, reply, true, true), null))
+        }
+        val medias = files.map { media(account, it) }
+        // an album holds photos and videos only, like the one that is sent
+        val visual = medias.count { isVisual(it) }
+        val groupId = if (visual > 1) Utilities.random.nextLong() else 0L
+        val objects = ArrayList<MessageObject>(files.size)
+        val grouped = ArrayList<MessageObject>()
+        files.forEachIndexed { index, file ->
+            val message = base(account, draft)
+            message.media = medias[index]
+            message.attachPath = SavedDrafts.storedFile(file.storedName).absolutePath
+            if (index == 0) {
+                // the caption goes with the first file, as the album is sent
+                message.message = draft.text
+                message.entities = draft.message.entities
+                withReply(message, reply)
+            }
+            val inGroup = groupId != 0L && isVisual(medias[index])
+            if (inGroup) {
+                message.grouped_id = groupId
+                message.flags = message.flags or 131072
+            }
+            val obj = MessageObject(account, message, if (index == 0) reply else null, true, true)
+            objects.add(obj)
+            if (inGroup) grouped.add(obj)
+        }
+        if (groupId == 0L) return objects.map { ShotEntry(it, null) }
+        val group = MessageObject.GroupedMessages()
+        group.groupId = groupId
+        group.messages.addAll(grouped)
+        group.calculate()
+        return objects.map { ShotEntry(it, if (it in grouped) group else null) }
+    }
+
+    private fun isVisual(media: TLRPC.MessageMedia): Boolean =
+        media is TLRPC.TL_messageMediaPhoto || media.document?.mime_type?.startsWith("video/") == true
+
+    private fun base(account: Int, draft: SavedDrafts.Draft): TLRPC.TL_message {
+        val message = TLRPC.TL_message()
+        message.id = nextId++
+        message.out = true
+        message.from_id = TLRPC.TL_peerUser().apply { user_id = UserConfig.getInstance(account).getClientUserId() }
+        message.flags = message.flags or TLRPC.MESSAGE_FLAG_HAS_FROM_ID
+        message.peer_id = MessagesController.getInstance(account).getPeer(draft.dialogId)
+        message.dialog_id = draft.dialogId
+        message.date = draft.edited
+        message.message = ""
+        message.media = TLRPC.TL_messageMediaEmpty()
+        return message
+    }
+
+    private fun withReply(message: TLRPC.TL_message, reply: MessageObject?) {
+        reply ?: return
+        message.reply_to = TLRPC.TL_messageReplyHeader().apply {
+            reply_to_msg_id = reply.id
+            flags = flags or 16
+        }
+        message.flags = message.flags or TLRPC.MESSAGE_FLAG_REPLY
+    }
+
+    private fun media(account: Int, file: SavedDrafts.StoredFile): TLRPC.MessageMedia {
+        val path = SavedDrafts.storedFile(file.storedName).absolutePath
+        if (!file.isVideo) {
+            val photo = synchronized(photos) { photos[file.storedName] }
+                ?: SendMessagesHelper.getInstance(account).generatePhotoSizes(path, null)?.also { synchronized(photos) { photos[file.storedName] = it } }
+            if (photo != null) {
+                return TLRPC.TL_messageMediaPhoto().apply {
+                    this.photo = photo
+                    flags = flags or 1
+                    spoiler = file.spoiler
+                }
+            }
+            // an image that can't be decoded still shows, as a file
+            return TLRPC.TL_messageMediaDocument().apply {
+                document = TLRPC.TL_document().apply {
+                    file_reference = ByteArray(0)
+                    mime_type = "application/octet-stream"
+                    size = file.size
+                    attributes.add(TLRPC.TL_documentAttributeFilename().apply { file_name = file.fileName })
+                }
+                flags = flags or 1
+            }
+        }
+        val document = synchronized(videos) { videos[file.storedName] } ?: video(path, file).also { synchronized(videos) { videos[file.storedName] = it } }
+        return TLRPC.TL_messageMediaDocument().apply {
+            this.document = document
+            flags = flags or 1
+            spoiler = file.spoiler
+        }
+    }
+
+    // the same document a video gets before its upload
+    private fun video(path: String, file: SavedDrafts.StoredFile): TLRPC.TL_document {
+        val document = TLRPC.TL_document()
+        document.file_reference = ByteArray(0)
+        document.mime_type = "video/mp4"
+        document.size = file.size
+        val thumb = SendMessagesHelper.createVideoThumbnail(path, MediaStore.Video.Thumbnails.MINI_KIND)
+        val size = thumb?.let { ImageLoader.scaleAndSaveImage(it, 320f, 320f, 80, false) }
+        if (size != null) {
+            document.thumbs.add(size)
+            document.flags = document.flags or 1
+        }
+        val attribute = TLRPC.TL_documentAttributeVideo()
+        attribute.supports_streaming = true
+        SendMessagesHelper.fillVideoAttribute(path, attribute, null)
+        if (attribute.w == 0 || attribute.h == 0) {
+            attribute.w = file.width
+            attribute.h = file.height
+        }
+        if (attribute.duration == 0.0) attribute.duration = file.duration.toDouble()
+        document.attributes.add(attribute)
+        return document
+    }
+}
diff --git a/TMessagesProj/src/main/java/tele/helpers/DraftReplaced.kt b/TMessagesProj/src/main/java/tele/helpers/DraftReplaced.kt
new file mode 100644
index 000000000..34f103af8
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/DraftReplaced.kt
@@ -0,0 +1,24 @@
+package tele.helpers
+
+import org.telegram.messenger.MediaDataController
+import org.telegram.tgnet.TLRPC
+
+/** A draft that came from the server over the local one: the replaced text is kept as a discarded draft. */
+object DraftReplaced {
+
+    @JvmStatic
+    fun onCloud(controller: MediaDataController, account: Int, dialogId: Long, threadId: Long, replacement: TLRPC.DraftMessage?) {
+        if (threadId < Int.MIN_VALUE || threadId > Int.MAX_VALUE) return
+        val topicId = threadId.toInt()
+        val existing = controller.getDraft(dialogId, threadId) as? TLRPC.TL_draftMessage ?: return
+        if (existing === replacement) return
+        val was = existing.message ?: return
+        if (!DraftDiscards.meaningful(was)) return
+        val now = (replacement as? TLRPC.TL_draftMessage)?.message ?: ""
+        if (!DraftDiscards.lost(was, now)) return
+        // an open field sees its own loss, and a send is not a discard
+        if (DraftDiscards.isOpen(account, dialogId, topicId)) return
+        if (SavedDrafts.sentSince(dialogId, System.currentTimeMillis() - 2000L)) return
+        SavedDrafts.saveDiscarded(account, dialogId, topicId, existing, controller.getDraftMessage(dialogId, threadId))
+    }
+}
diff --git a/TMessagesProj/src/main/java/tele/helpers/DraftSender.kt b/TMessagesProj/src/main/java/tele/helpers/DraftSender.kt
new file mode 100644
index 000000000..c6c1e23f8
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/DraftSender.kt
@@ -0,0 +1,147 @@
+package tele.helpers
+
+import org.telegram.messenger.AccountInstance
+import org.telegram.messenger.ChatObject
+import org.telegram.messenger.DialogObject
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.MessageObject
+import org.telegram.messenger.MessagesController
+import org.telegram.messenger.R
+import org.telegram.messenger.SendMessageChatArguments
+import org.telegram.messenger.SendMessagesHelper
+import org.telegram.messenger.UserObject
+import org.telegram.ui.ActionBar.BaseFragment
+import org.telegram.ui.ChatActivity
+import org.telegram.tgnet.TLRPC
+import org.telegram.ui.Components.BulletinFactory
+
+/** Sends saved drafts from outside their chat: to the same chat, or to another one. */
+object DraftSender {
+
+    private const val ALBUM_SIZE = 10
+
+    /** Oldest edit first, the order the drafts go out in. */
+    @JvmStatic
+    fun oldestFirst(drafts: List<SavedDrafts.Draft>): List<SavedDrafts.Draft> =
+        drafts.sortedWith(compareBy({ it.edited }, { it.created }))
+
+    /** The reply the draft keeps for the target: only in the chat it was written in. */
+    @JvmStatic
+    fun replyFor(account: Int, draft: SavedDrafts.Draft, dialogId: Long, topicId: Int): MessageObject? {
+        val reply = draft.replyMessage ?: return null
+        if (draft.dialogId != dialogId || draft.topicId != topicId) return null
+        // a reply to the topic root is how a plain message of the topic looks
+        if (topicId != 0 && reply.id == topicId) return null
+        return MessageObject(account, reply, false, false)
+    }
+
+    /**
+     * Sends the drafts one by one, oldest first, stopping at the first one the chat refuses.
+     * Returns how many went out; the sent ones are dropped from the list when [deleteAfter] is set.
+     */
+    @JvmStatic
+    fun sendAll(fragment: BaseFragment, account: Int, drafts: List<SavedDrafts.Draft>, dialogId: Long, topicId: Int, notify: Boolean, scheduleDate: Int, deleteAfter: Boolean): Int {
+        var sent = 0
+        for (draft in oldestFirst(drafts)) {
+            if (!send(fragment, account, draft, dialogId, topicId, notify, scheduleDate)) break
+            sent++
+            // the files stay: they may still be uploading, cleanOrphans removes them later
+            if (deleteAfter) SavedDrafts.removeRecord(account, draft.id)
+        }
+        return sent
+    }
+
+    /** Sends one draft; false after a bulletin when the chat does not take it. */
+    @JvmStatic
+    fun send(fragment: BaseFragment, account: Int, draft: SavedDrafts.Draft, dialogId: Long, topicId: Int, notify: Boolean, scheduleDate: Int): Boolean {
+        val controller = MessagesController.getInstance(account)
+        val files = draft.files.map { SavedDrafts.storedFile(it.storedName) to it }.filter { it.first.exists() }
+        val text = draft.text
+        if (text.isBlank() && files.isEmpty()) return refuse(fragment, R.string.TeleDraftNothingToSend)
+
+        var chat: TLRPC.Chat? = null
+        if (DialogObject.isEncryptedDialog(dialogId)) return refuse(fragment, R.string.TeleDraftChatUnavailable)
+        if (dialogId > 0) {
+            val user = controller.getUser(dialogId)
+            if (user == null || UserObject.isDeleted(user)) return refuse(fragment, R.string.TeleDraftChatUnavailable)
+            if (controller.blockePeers.indexOfKey(dialogId) >= 0) return refuse(fragment, R.string.TeleDraftCantSend)
+        } else {
+            chat = controller.getChat(-dialogId)
+            if (chat == null || chat is TLRPC.TL_chatForbidden || chat is TLRPC.TL_channelForbidden || chat.deactivated) return refuse(fragment, R.string.TeleDraftChatUnavailable)
+            if (!ChatObject.canSendMessages(chat) || ChatObject.isChannelAndNotMegaGroup(chat) && !ChatObject.canPost(chat)) {
+                return refuse(fragment, R.string.TeleDraftCantSend)
+            }
+            if (files.isEmpty() && !ChatObject.canSendPlain(chat)) return refuse(fragment, R.string.TeleDraftCantSend)
+            for ((_, file) in files) {
+                if (if (file.isVideo) !ChatObject.canSendVideo(chat) else !ChatObject.canSendPhoto(chat)) return refuse(fragment, R.string.TeleDraftCantSend)
+            }
+        }
+        if (controller.getSendPaidMessagesStars(dialogId) > 0) return refuse(fragment, R.string.TeleDraftChargesStars)
+
+        var root: MessageObject? = null
+        if (topicId != 0) {
+            if (chat == null || !ChatObject.isForum(chat) || ChatObject.isMonoForum(chat)) return refuse(fragment, R.string.TeleDraftChatUnavailable)
+            // the General topic is a plain send, the others reply to their first message
+            if (topicId != 1) {
+                val start = controller.topicsController.findTopic(-dialogId, topicId.toLong())?.topicStartMessage
+                    ?: return refuse(fragment, R.string.TeleDraftChatUnavailable)
+                root = MessageObject(account, start, false, false)
+                root.isTopicMainMessage = true
+            }
+        }
+        val reply = replyFor(account, draft, dialogId, topicId)
+        val replyTo = reply ?: root
+
+        val maxText = controller.maxMessageLength
+        val entities = draft.message.entities
+        val helper = SendMessagesHelper.getInstance(account)
+        val captionFits = text.length <= controller.captionMaxLengthLimit
+        if (files.isEmpty() || (!captionFits && text.isNotBlank())) {
+            if (text.length > maxText) return refuse(fragment, R.string.TeleDraftTooLong)
+            helper.sendMessage(
+                SendMessagesHelper.SendMessageParams.of(
+                    text, dialogId, replyTo, root, null, true, if (entities.isEmpty()) null else ArrayList(entities),
+                    null, null, notify, scheduleDate, 0, null, false
+                )
+            )
+        }
+        if (files.isNotEmpty()) {
+            val now = System.currentTimeMillis()
+            val infos = ArrayList<SendMessagesHelper.SendingMediaInfo>(files.size)
+            for ((file, stored) in files) {
+                // a sent draft may lose its record while the upload still reads the file
+                file.setLastModified(now)
+                val info = SendMessagesHelper.SendingMediaInfo()
+                info.path = file.absolutePath
+                info.isVideo = stored.isVideo
+                info.ttl = stored.ttl
+                info.hasMediaSpoilers = stored.spoiler
+                infos.add(info)
+            }
+            if (captionFits && text.isNotBlank()) {
+                infos[0].caption = text
+                infos[0].entities = if (entities.isEmpty()) null else ArrayList(entities)
+                infos[0].updateStickersOrder = SendMessagesHelper.checkUpdateStickersOrder(text)
+            }
+            val group = infos.none { it.ttl > 0 }
+            val account2 = AccountInstance.getInstance(account)
+            var start = 0
+            while (start < infos.size) {
+                val end = minOf(infos.size, start + ALBUM_SIZE)
+                SendMessagesHelper.prepareSendingMedia(
+                    account2, ArrayList(infos.subList(start, end)), dialogId, replyTo, root, null, null,
+                    false, group, null, notify, scheduleDate, 0, ChatActivity.MODE_DEFAULT, start == 0 && infos[0].updateStickersOrder,
+                    null, SendMessageChatArguments.EMPTY, 0, false, 0, 0, null
+                )
+                start = end
+            }
+        }
+        SavedDrafts.noteSent(dialogId)
+        return true
+    }
+
+    private fun refuse(fragment: BaseFragment, text: Int): Boolean {
+        BulletinFactory.of(fragment).createErrorBulletin(LocaleController.getString(text)).show()
+        return false
+    }
+}
