+        val activity = parentActivity ?: return
+        val ordered = DraftSender.oldestFirst(drafts)
+        if (ordered.isEmpty()) return
+        val text = Theme.getColor(Theme.key_dialogTextBlack, resourceProvider)
+        val gray = Theme.getColor(Theme.key_dialogTextGray2, resourceProvider)
+
+        val container = LinearLayout(activity)
+        container.orientation = LinearLayout.VERTICAL
+        container.setPadding(AndroidUtilities.dp(24f), 0, AndroidUtilities.dp(24f), 0)
+        fun line(value: CharSequence, color: Int) {
+            val view = TextView(activity)
+            view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15f)
+            view.setTextColor(color)
+            view.text = value
+            container.addView(view, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT).apply { topMargin = AndroidUtilities.dp(4f) })
+        }
+        if (ordered.size > 1) line(LocaleController.getString(R.string.TeleDraftSendOrder), gray)
+        line(LocaleController.formatString(R.string.TeleDraftSendTo, TeleDraftsActivity.chatTitle(account, targetDialogId, targetTopicId)), text)
+        if (ordered.size == 1) {
+            val reply = DraftSender.replyFor(account, ordered[0], targetDialogId, targetTopicId)?.messageText
+            if (!reply.isNullOrBlank()) line(LocaleController.formatString(R.string.TeleDraftSendReply, reply.toString().take(80)), gray)
+        }
+        val present = ordered.sumOf { draft -> draft.files.count { SavedDrafts.storedFile(it.storedName).exists() } }
+        val missing = ordered.sumOf { draft -> draft.files.count { !SavedDrafts.storedFile(it.storedName).exists() } }
+        if (present > 0) line(LocaleController.formatString(R.string.TeleDraftFiles, present), text)
+        if (missing > 0) line(LocaleController.formatString(R.string.TeleDraftFilesMissing, missing), Theme.getColor(Theme.key_text_RedRegular, resourceProvider))
+
+        fun checkbox(label: String, checked: Boolean): CheckBoxCell {
+            val cell = CheckBoxCell(activity, 1, resourceProvider)
+            cell.setText(label, "", checked, false)
+            cell.setOnClickListener { cell.setChecked(!cell.isChecked, true) }
+            container.addView(cell, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, AndroidUtilities.dp(48f)).apply { topMargin = AndroidUtilities.dp(4f) })
+            return cell
+        }
+        // Saved Messages has nobody to keep quiet for
+        val toSelf = targetDialogId == UserConfig.getInstance(account).getClientUserId()
+        val silent = if (toSelf) null else checkbox(LocaleController.getString(R.string.SendWithoutSound), false)
+        val delete = checkbox(LocaleController.getString(if (ordered.size == 1) R.string.TeleDraftDeleteAfter else R.string.TeleDraftsDeleteAfter), true)
+
+        val title = if (ordered.size == 1) LocaleController.getString(R.string.TeleDraftSendTitle) else LocaleController.formatString(R.string.TeleDraftsSendTitle, ordered.size)
+        showDialog(
+            AlertDialog.Builder(activity, resourceProvider)
+                .setTitle(title)
+                .setView(container)
+                .setPositiveButton(LocaleController.getString(R.string.Send)) { _, _ ->
+                    performSend(ordered, targetDialogId, targetTopicId, !(silent?.isChecked ?: false), 0, delete.isChecked)
+                }
+                .setNeutralButton(LocaleController.getString(R.string.Schedule)) { _, _ ->
+                    val deleteAfter = delete.isChecked
+                    AlertsCreator.createScheduleDatePickerDialog(activity, targetDialogId, AlertsCreator.ScheduleDatePickerDelegate { notify, date, _ ->
+                        performSend(ordered, targetDialogId, targetTopicId, notify, date, deleteAfter)
+                    }, resourceProvider)
+                }
+                .setNegativeButton(LocaleController.getString(R.string.Cancel), null)
+                .create()
+        )
+    }
+
+    private fun performSend(drafts: List<SavedDrafts.Draft>, targetDialogId: Long, targetTopicId: Int, notify: Boolean, scheduleDate: Int, deleteAfter: Boolean) {
+        val sent = DraftSender.sendAll(this, account, drafts, targetDialogId, targetTopicId, notify, scheduleDate, deleteAfter)
+        if (sent == 0) return
+        selected.clear()
+        reload()
+        val text = LocaleController.getString(if (sent == 1) R.string.TeleDraftSent else R.string.TeleDraftsSent)
+        BulletinFactory.of(this).createSimpleBulletin(R.raw.contact_check, text).show()
+    }
+
+    // the bar at the bottom: a draft is written here and kept, not sent
+
+    private fun composeBar(context: Context): View {
+        val bar = LinearLayout(context)
+        bar.orientation = LinearLayout.HORIZONTAL
+        bar.gravity = Gravity.BOTTOM
+        bar.setBackgroundColor(Theme.getColor(Theme.key_chat_messagePanelBackground, resourceProvider))
+
+        val icons = Theme.getColor(Theme.key_chat_messagePanelIcons, resourceProvider)
+        fun button(icon: Int, color: Int, description: String, onClick: () -> Unit): ImageView {
+            val view = ImageView(context)
+            view.scaleType = ImageView.ScaleType.CENTER
+            view.setImageResource(icon)
+            view.colorFilter = PorterDuffColorFilter(color, PorterDuff.Mode.SRC_IN)
+            view.background = Theme.createSelectorDrawable(color and 0x1FFFFFFF, Theme.RIPPLE_MASK_CIRCLE_20DP)
+            view.contentDescription = description
+            view.setOnClickListener { onClick() }
+            return view
+        }
+        val size = AndroidUtilities.dp(48f)
+        bar.addView(button(R.drawable.input_attach, icons, LocaleController.getString(R.string.TeleDraftAttach)) { pickFiles() }, LinearLayout.LayoutParams(size, size))
+
+        val input = EditTextCaption(context, resourceProvider)
+        input.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 18f)
+        input.setTextColor(Theme.getColor(Theme.key_chat_messagePanelText, resourceProvider))
+        input.setHintTextColor(Theme.getColor(Theme.key_chat_messagePanelHint, resourceProvider))
+        input.setCursorColor(Theme.getColor(Theme.key_chat_messagePanelCursor, resourceProvider))
+        input.hint = LocaleController.getString(R.string.TeleDraftWrite)
+        input.background = null
+        input.inputType = InputType.TYPE_CLASS_TEXT or InputType.TYPE_TEXT_FLAG_CAP_SENTENCES or InputType.TYPE_TEXT_FLAG_MULTI_LINE or InputType.TYPE_TEXT_FLAG_AUTO_CORRECT
+        input.isSingleLine = false
+        input.maxLines = 6
+        input.gravity = Gravity.CENTER_VERTICAL
+        input.minHeight = size
+        input.setPadding(AndroidUtilities.dp(4f), AndroidUtilities.dp(11f), AndroidUtilities.dp(4f), AndroidUtilities.dp(11f))
+        field = input
+        bar.addView(input, LinearLayout.LayoutParams(0, ViewGroup.LayoutParams.WRAP_CONTENT, 1f))
+
+        val save = button(R.drawable.input_done, Theme.getColor(Theme.key_chat_messagePanelSend, resourceProvider), LocaleController.getString(R.string.TeleDraftSave)) { saveText() }
+        save.alpha = DIM_ALPHA
+        saveButton = save
+        bar.addView(save, LinearLayout.LayoutParams(size, size))
+        input.addTextChangedListener(object : TextWatcher {
+            override fun beforeTextChanged(s: CharSequence?, start: Int, count: Int, after: Int) = Unit
+            override fun onTextChanged(s: CharSequence?, start: Int, before: Int, count: Int) = Unit
+            override fun afterTextChanged(s: Editable?) {
+                save.alpha = if (s.isNullOrBlank()) DIM_ALPHA else 1f
+            }
+        })
+        return bar
+    }
+
+    private fun saveText() {
+        val input = field ?: return
+        val text = input.textToUse
+        if (text.isBlank()) return
+        val chars = arrayOf<CharSequence>(SpannableStringBuilder(text))
+        val entities = MediaDataController.getInstance(account).getEntities(chars, true)
+        val message = SavedDrafts.buildDraftMessage(chars[0], entities, null)
+        input.setText("")
+        store(message, emptyList())
+    }
+
+    private fun store(message: org.telegram.tgnet.TLRPC.TL_draftMessage, files: List<SavedDrafts.StoredFile>) {
+        val account = account
+        val dialogId = dialogId
+        val topicId = topicId
+        Utilities.globalQueue.postRunnable {
+            SavedDrafts.save(account, dialogId, topicId, message, files, null)
+            AndroidUtilities.runOnUIThread { reload() }
+        }
+    }
+
+    private fun pickFiles() {
+        val intent = Intent(Intent.ACTION_GET_CONTENT)
+        intent.type = "*/*"
+        intent.putExtra(Intent.EXTRA_MIME_TYPES, arrayOf("image/*", "video/*"))
+        intent.putExtra(Intent.EXTRA_ALLOW_MULTIPLE, true)
+        intent.addCategory(Intent.CATEGORY_OPENABLE)
+        startActivityForResult(intent, REQUEST_PICK)
+    }
+
+    override fun onActivityResultFragment(requestCode: Int, resultCode: Int, data: Intent?) {
+        if (requestCode != REQUEST_PICK || resultCode != android.app.Activity.RESULT_OK || data == null) return
+        val uris = ArrayList<android.net.Uri>()
+        val clip = data.clipData
+        if (clip != null) {
+            for (i in 0 until clip.itemCount) clip.getItemAt(i).uri?.let { uris.add(it) }
+        } else {
+            data.data?.let { uris.add(it) }
+        }
+        if (uris.isEmpty()) return
+        val input = field
+        val chars = arrayOf<CharSequence>(SpannableStringBuilder(input?.textToUse ?: ""))
+        val entities = MediaDataController.getInstance(account).getEntities(chars, true)
+        val message = SavedDrafts.buildDraftMessage(chars[0], entities, null)
+        input?.setText("")
+        val account = account
+        val dialogId = dialogId
+        val topicId = topicId
+        Utilities.globalQueue.postRunnable {
+            val files = uris.mapNotNull { SavedDrafts.importUri(ApplicationLoader.applicationContext, it) }
+            if (files.isNotEmpty()) SavedDrafts.save(account, dialogId, topicId, message, files, null)
+            AndroidUtilities.runOnUIThread { reload() }
+        }
+    }
+
+    private fun flags(): ShotFlags {
+        val chat = if (dialogId < 0) MessagesController.getInstance(account).getChat(-dialogId) else null
+        val megagroup = chat != null && ChatObject.isChannel(chat) && chat.megagroup
+        return ShotFlags(
+            isChat = chat != null,
+            isBot = false,
+            isBotForum = false,
+            isMegagroup = megagroup,
+            isForum = ChatObject.isForum(chat),
+            isMonoForum = ChatObject.isMonoForum(chat),
+            isSavedChat = false,
+            isRepliesChat = false,
+            hasDiscussion = false,
+            senderIsChat = chat != null,
+            senderIsSelfOrReplies = false
+        )
+    }
+
+    /** A draft row; the stock selection colour lies under the bubbles of a chosen one. */
+    private class DraftFrame(context: Context) : FrameLayout(context) {
+        private var chosen: Boolean? = null
+
+        fun setChosen(value: Boolean) {
+            if (chosen == value) return
+            chosen = value
+            background = if (value) ColorDrawable(Theme.getColor(Theme.key_chat_selectedBackground)) else null
+        }
+    }
+
+    private inner class Adapter(private val context: Context) : RecyclerListView.SelectionAdapter() {
+        private val flags by lazy { flags() }
+
+        override fun getItemCount(): Int = rows.size
+
+        override fun isEnabled(holder: RecyclerView.ViewHolder): Boolean = holder.itemViewType == TYPE_DRAFT
+
+        override fun getItemViewType(position: Int): Int = if (rows[position] is Row.Draft) TYPE_DRAFT else TYPE_LABEL
+
+        override fun onCreateViewHolder(parent: ViewGroup, viewType: Int): RecyclerView.ViewHolder {
+            val view: View = if (viewType == TYPE_LABEL) {
+                FrameLayout(context).apply {
+                    val label = TextView(context)
+                    label.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13f)
+                    label.typeface = AndroidUtilities.bold()
+                    label.setTextColor(Theme.getColor(Theme.key_chat_serviceText, resourceProvider))
+                    label.gravity = Gravity.CENTER
+                    label.maxLines = 2
+                    label.ellipsize = TextUtils.TruncateAt.END
+                    label.setPadding(AndroidUtilities.dp(10f), AndroidUtilities.dp(4f), AndroidUtilities.dp(10f), AndroidUtilities.dp(4f))
+                    label.background = Theme.createRoundRectDrawable(AndroidUtilities.dp(13f), Theme.getColor(Theme.key_chat_serviceBackground, resourceProvider))
+                    addView(label, LayoutHelper.createFrame(LayoutHelper.WRAP_CONTENT, LayoutHelper.WRAP_CONTENT.toFloat(), Gravity.CENTER, 24f, 10f, 24f, 6f))
+                }
+            } else {
+                DraftFrame(context)
+            }
+            view.layoutParams = RecyclerView.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT)
+            return RecyclerListView.Holder(view)
+        }
+
+        override fun onBindViewHolder(holder: RecyclerView.ViewHolder, position: Int) {
+            when (val row = rows[position]) {
+                is Row.Label -> ((holder.itemView as FrameLayout).getChildAt(0) as TextView).text = row.text
+                is Row.Draft -> {
+                    val frame = holder.itemView as DraftFrame
+                    frame.removeAllViews()
+                    // a fresh column per bind: it rebuilds its cells for the entries anyway
+                    val column = ShotColumn(context, account, resourceProvider, flags)
+                    column.bind(row.entries, tele.helpers.ShotOptions(hidden = 0))
+                    frame.addView(column, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT.toFloat()))
+                    frame.alpha = if (row.draft.discarded) DISCARDED_ALPHA else 1f
+                    frame.setChosen(row.draft.id in selected)
+                }
+            }
+        }
+    }
+
+    companion object {
+        private const val ARG_DIALOG_ID = "dialog_id"
+        private const val ARG_TOPIC_ID = "topic_id"
+        private const val MENU_CLEAR = 1
+        private const val MENU_SEND_SELECTED = 2
+        private const val MENU_DELETE_SELECTED = 3
+        private const val REQUEST_PICK = 4721
+        private const val TYPE_LABEL = 0
+        private const val TYPE_DRAFT = 1
+        private const val DISCARDED_ALPHA = 0.5f
+        private const val DIM_ALPHA = 0.4f
+
+        @JvmStatic
+        fun of(dialogId: Long, topicId: Int): TeleDraftsChatActivity = TeleDraftsChatActivity().apply {
+            arguments = Bundle().apply {
+                putLong(ARG_DIALOG_ID, dialogId)
+                putInt(ARG_TOPIC_ID, topicId)
+            }
+        }
+    }
+}
