--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleDraftsChatActivity.kt
@@ -0,0 +1,320 @@
+package tele.ui.settings
+
+import android.content.Context
+import android.graphics.Canvas
+import android.os.Bundle
+import android.text.TextUtils
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.View
+import android.view.ViewGroup
+import android.widget.FrameLayout
+import android.widget.TextView
+import androidx.recyclerview.widget.LinearLayoutManager
+import androidx.recyclerview.widget.RecyclerView
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.ChatObject
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.MessagesController
+import org.telegram.messenger.R
+import org.telegram.messenger.UserConfig
+import org.telegram.messenger.Utilities
+import org.telegram.ui.ActionBar.ActionBar
+import org.telegram.ui.ActionBar.AlertDialog
+import org.telegram.ui.ActionBar.BaseFragment
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.ChatActivity
+import org.telegram.ui.Components.BulletinFactory
+import org.telegram.ui.Components.EditTextBoldCursor
+import org.telegram.ui.Components.Forum.ForumUtilities
+import org.telegram.ui.Components.LayoutHelper
+import org.telegram.ui.Components.RecyclerListView
+import org.telegram.ui.Components.SizeNotifierFrameLayout
+import tele.helpers.DraftMessages
+import tele.helpers.SavedDrafts
+import tele.helpers.ShotEntry
+import tele.ui.ShotColumn
+import tele.ui.ShotFlags
+
+/** The drafts of one chat as outgoing bubbles, the saved ones first and the discarded ones faded below. */
+class TeleDraftsChatActivity : BaseFragment() {
+
+    private val account get() = UserConfig.selectedAccount
+    private val dialogId get() = arguments.getLong(ARG_DIALOG_ID)
+    private val topicId get() = arguments.getInt(ARG_TOPIC_ID)
+
+    private sealed class Row {
+        class Label(val text: String) : Row()
+        class Draft(val draft: SavedDrafts.Draft, val entries: List<ShotEntry>) : Row()
+    }
+
+    private var rows: List<Row> = emptyList()
+    private var adapter: Adapter? = null
+    private var listView: RecyclerListView? = null
+    private var generation = 0
+
+    override fun createView(context: Context): View {
+        actionBar.setBackButtonImage(R.drawable.ic_ab_back)
+        actionBar.setAllowOverlayTitle(true)
+        actionBar.setTitle(LocaleController.getString(R.string.TeleDrafts))
+        actionBar.setSubtitle(TeleDraftsActivity.chatTitle(account, dialogId, topicId))
+        actionBar.setActionBarMenuOnItemClick(object : ActionBar.ActionBarMenuOnItemClick() {
+            override fun onItemClick(id: Int) {
+                if (id == -1) finishFragment() else if (id == MENU_CLEAR) confirmClear()
+            }
+        })
+        actionBar.createMenu().addItem(MENU_CLEAR, R.drawable.msg_delete)
+
+        val root = SizeNotifierFrameLayout(context)
+        root.setBackgroundImage(Theme.getCachedWallpaperNonBlocking(), Theme.isWallpaperMotion())
+        actionBar.setAddToContainer(false)
+        actionBar.setCastShadows(false)
+        fragmentView = root
+
+        val list = RecyclerListView(context)
+        val layoutManager = LinearLayoutManager(context)
+        layoutManager.stackFromEnd = true
+        list.layoutManager = layoutManager
+        list.isVerticalScrollBarEnabled = false
+        adapter = Adapter(context)
+        list.adapter = adapter
+        list.setOnItemClickListener { _, position ->
+            (rows.getOrNull(position) as? Row.Draft)?.let { showActions(it.draft) }
+        }
+        listView = list
+        root.addView(list, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.MATCH_PARENT.toFloat()))
+        list.setPadding(0, AndroidUtilities.statusBarHeight + ActionBar.getCurrentActionBarHeight(), 0, AndroidUtilities.dp(8f))
+        list.clipToPadding = false
+        root.addView(actionBar, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT.toFloat()))
+        return fragmentView
+    }
+
+    override fun onResume() {
+        super.onResume()
+        reload()
+    }
+
+    /** The bubbles are built off the main thread: a photo gets its local sizes like before an upload. */
+    private fun reload() {
+        val current = ++generation
+        val account = account
+        val dialogId = dialogId
+        val topicId = topicId
+        val emptyText = LocaleController.getString(R.string.TeleDraftEmpty)
+        Utilities.globalQueue.postRunnable {
+            SavedDrafts.prune(account)
+            val chat = SavedDrafts.chat(account, dialogId, topicId)
+            val result = ArrayList<Row>()
+            // oldest first, so the newest sits by the bottom like in a chat
+            for (draft in chat.saved.reversed()) addDraft(result, account, draft, emptyText)
+            if (chat.discarded.isNotEmpty()) {
+                result.add(Row.Label(LocaleController.getString(R.string.TeleDraftsDiscardedHeader)))
+                for (draft in chat.discarded.reversed()) addDraft(result, account, draft, emptyText)
+            }
+            if (result.isEmpty()) result.add(Row.Label(LocaleController.getString(R.string.TeleDraftsChatEmpty)))
+            AndroidUtilities.runOnUIThread {
+                if (current != generation) return@runOnUIThread
+                rows = result
+                adapter?.notifyDataSetChanged()
+                listView?.scrollToPosition(maxOf(0, result.size - 1))
+            }
+        }
+    }
+
+    private fun addDraft(result: ArrayList<Row>, account: Int, draft: SavedDrafts.Draft, emptyText: String) {
+        val notes = ArrayList<String>()
+        draft.name?.let { notes.add(it) }
+        val missing = draft.files.count { !SavedDrafts.storedFile(it.storedName).exists() }
+        if (missing > 0) notes.add(LocaleController.formatString(R.string.TeleDraftFilesMissing, missing))
+        if (notes.isNotEmpty()) result.add(Row.Label(notes.joinToString(" \u00B7 ")))
+        result.add(Row.Draft(draft, DraftMessages.build(account, draft, emptyText)))
+    }
+
+    private fun showActions(draft: SavedDrafts.Draft) {
+        val activity = parentActivity ?: return
+        val labels = ArrayList<String>()
+        val actions = ArrayList<() -> Unit>()
+        fun add(label: String, action: () -> Unit) {
+            labels.add(label)
+            actions.add(action)
+        }
+        if (draft.discarded) {
+            add(LocaleController.getString(R.string.TeleDraftRestore)) { insert(draft) }
+            add(LocaleController.getString(R.string.TeleDraftKeep)) {
+                SavedDrafts.keep(account, draft.id)
+                reload()
+            }
+        } else {
+            add(LocaleController.getString(R.string.TeleInsertDraft)) { insert(draft) }
+            add(LocaleController.getString(R.string.TeleDraftDuplicate)) {
+                SavedDrafts.duplicate(account, draft.id)
+                reload()
+            }
+            add(LocaleController.getString(R.string.TeleDraftRename)) { rename(draft) }
+        }
+        if (draft.text.isNotEmpty()) {
+            add(LocaleController.getString(R.string.Copy)) {
+                AndroidUtilities.addToClipboard(SavedDrafts.toFieldText(draft))
+                BulletinFactory.of(this).createCopyBulletin(LocaleController.getString(R.string.TextCopied)).show()
+            }
+        }
+        add(LocaleController.getString(R.string.Delete)) {
+            if (draft.discarded) {
+                SavedDrafts.remove(account, draft.id)
+                reload()
+            } else {
+                AlertDialog.Builder(activity, resourceProvider)
+                    .setTitle(LocaleController.getString(R.string.TeleDeleteDraft))
+                    .setMessage(draft.name ?: draft.text.take(80))
+                    .setPositiveButton(LocaleController.getString(R.string.Delete)) { _, _ ->
+                        SavedDrafts.remove(account, draft.id)
+                        reload()
+                    }
+                    .setNegativeButton(LocaleController.getString(R.string.Cancel), null)
+                    .show()
+            }
+        }
+        val dialog = AlertDialog.Builder(activity, resourceProvider)
+            .setItems(labels.toTypedArray()) { _, which -> actions[which]() }
+            .create()
+        showDialog(dialog)
+        dialog.setItemColor(labels.size - 1, Theme.getColor(Theme.key_text_RedBold), Theme.getColor(Theme.key_text_RedRegular))
+    }
+
+    private fun rename(draft: SavedDrafts.Draft) {
+        val activity = parentActivity ?: return
+        val field = EditTextBoldCursor(activity)
+        field.setSingleLine(true)
+        field.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 17f)
+        field.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText, resourceProvider))
+        field.setHintTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteHintText, resourceProvider))
+        field.setBackgroundDrawable(null)
+        field.setLineColors(
+            Theme.getColor(Theme.key_windowBackgroundWhiteInputField, resourceProvider),
+            Theme.getColor(Theme.key_windowBackgroundWhiteInputFieldActivated, resourceProvider),
+            Theme.getColor(Theme.key_text_RedRegular, resourceProvider)
+        )
+        field.hint = LocaleController.getString(R.string.TeleDraftName)
+        field.setText(draft.name.orEmpty())
+        val container = FrameLayout(activity)
+        container.setPadding(AndroidUtilities.dp(20f), AndroidUtilities.dp(8f), AndroidUtilities.dp(20f), 0)
+        container.addView(field, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, 44f))
+        showDialog(
+            AlertDialog.Builder(activity, resourceProvider)
+                .setTitle(LocaleController.getString(R.string.TeleDraftRename))
+                .setView(container)
+                .setPositiveButton(LocaleController.getString(R.string.Save)) { _, _ ->
+                    SavedDrafts.rename(account, draft.id, field.text.toString())
+                    reload()
+                }
+                .setNegativeButton(LocaleController.getString(R.string.Cancel), null)
+                .create()
+        )
+    }
+
+    /** Puts the draft into the field of its chat: the chat under this screen if it is that one. */
+    private fun insert(draft: SavedDrafts.Draft) {
+        val stack = parentLayout?.fragmentStack
+        val previous = stack?.getOrNull(stack.size - 2) as? ChatActivity
+        if (previous != null && previous.dialogId == draft.dialogId && previous.topicId.toInt() == draft.topicId && previous.chatMode == ChatActivity.MODE_DEFAULT) {
+            finishFragment()
+            previous.teleInsertSavedDraft(draft.id)
+            return
+        }
+        TeleDraftsActivity.openChat(this, account, draft)
+    }
+
+    private fun confirmClear() {
+        val activity = parentActivity ?: return
+        AlertDialog.Builder(activity, resourceProvider)
+            .setTitle(LocaleController.getString(R.string.TeleDrafts))
+            .setMessage(LocaleController.getString(R.string.TeleDeleteChatDrafts))
+            .setPositiveButton(LocaleController.getString(R.string.Delete)) { _, _ ->
+                SavedDrafts.removeThread(account, dialogId, topicId)
+                reload()
+            }
+            .setNegativeButton(LocaleController.getString(R.string.Cancel), null)
+            .show()
+    }
+
+    private fun flags(): ShotFlags {
+        val chat = if (dialogId < 0) MessagesController.getInstance(account).getChat(-dialogId) else null
+        val megagroup = chat != null && ChatObject.isChannel(chat) && chat.megagroup
+        return ShotFlags(
+            isChat = chat != null,
+            isBot = false,
+            isBotForum = false,
+            isMegagroup = megagroup,
+            isForum = ChatObject.isForum(chat),
+            isMonoForum = ChatObject.isMonoForum(chat),
+            isSavedChat = false,
+            isRepliesChat = false,
+            hasDiscussion = false,
+            senderIsChat = chat != null,
+            senderIsSelfOrReplies = false
+        )
+    }
+
+    private inner class Adapter(private val context: Context) : RecyclerListView.SelectionAdapter() {
+        private val flags by lazy { flags() }
+
+        override fun getItemCount(): Int = rows.size
+
+        override fun isEnabled(holder: RecyclerView.ViewHolder): Boolean = holder.itemViewType == TYPE_DRAFT
+
+        override fun getItemViewType(position: Int): Int = if (rows[position] is Row.Draft) TYPE_DRAFT else TYPE_LABEL
+
+        override fun onCreateViewHolder(parent: ViewGroup, viewType: Int): RecyclerView.ViewHolder {
+            val view: View = if (viewType == TYPE_LABEL) {
+                FrameLayout(context).apply {
+                    val label = TextView(context)
+                    label.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13f)
+                    label.typeface = AndroidUtilities.bold()
+                    label.setTextColor(Theme.getColor(Theme.key_chat_serviceText, resourceProvider))
+                    label.gravity = Gravity.CENTER
+                    label.maxLines = 2
+                    label.ellipsize = TextUtils.TruncateAt.END
+                    label.setPadding(AndroidUtilities.dp(10f), AndroidUtilities.dp(4f), AndroidUtilities.dp(10f), AndroidUtilities.dp(4f))
+                    label.background = Theme.createRoundRectDrawable(AndroidUtilities.dp(13f), Theme.getColor(Theme.key_chat_serviceBackground, resourceProvider))
+                    addView(label, LayoutHelper.createFrame(LayoutHelper.WRAP_CONTENT, LayoutHelper.WRAP_CONTENT.toFloat(), Gravity.CENTER, 24f, 10f, 24f, 6f))
+                }
+            } else {
+                FrameLayout(context)
+            }
+            view.layoutParams = RecyclerView.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT)
+            return RecyclerListView.Holder(view)
+        }
+
+        override fun onBindViewHolder(holder: RecyclerView.ViewHolder, position: Int) {
+            when (val row = rows[position]) {
+                is Row.Label -> ((holder.itemView as FrameLayout).getChildAt(0) as TextView).text = row.text
+                is Row.Draft -> {
+                    val frame = holder.itemView as FrameLayout
+                    frame.removeAllViews()
+                    // a fresh column per bind: it rebuilds its cells for the entries anyway
+                    val column = ShotColumn(context, account, resourceProvider, flags)
+                    column.bind(row.entries, tele.helpers.ShotOptions(hidden = 0))
+                    frame.addView(column, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT.toFloat()))
+                    frame.alpha = if (row.draft.discarded) DISCARDED_ALPHA else 1f
+                }
+            }
+        }
+    }
+
+    companion object {
+        private const val ARG_DIALOG_ID = "dialog_id"
+        private const val ARG_TOPIC_ID = "topic_id"
+        private const val MENU_CLEAR = 1
+        private const val TYPE_LABEL = 0
+        private const val TYPE_DRAFT = 1
+        private const val DISCARDED_ALPHA = 0.5f
+
+        @JvmStatic
+        fun of(dialogId: Long, topicId: Int): TeleDraftsChatActivity = TeleDraftsChatActivity().apply {
+            arguments = Bundle().apply {
+                putLong(ARG_DIALOG_ID, dialogId)
+                putInt(ARG_TOPIC_ID, topicId)
+            }
+        }
+    }
+}
