diff --git a/TMessagesProj/src/main/java/tele/helpers/DraftDiscards.kt b/TMessagesProj/src/main/java/tele/helpers/DraftDiscards.kt
new file mode 100644
index 000000000..6e8ddc340
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/DraftDiscards.kt
@@ -0,0 +1,124 @@
+package tele.helpers
+
+import android.text.SpannableStringBuilder
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.MediaDataController
+import org.telegram.messenger.MessageObject
+import org.telegram.messenger.NotificationCenter
+import org.telegram.tgnet.TLRPC
+import org.telegram.ui.ChatActivity
+
+/**
+ * Keeps a long text that left the field of a chat as a discarded draft, a port of the desktop capture:
+ * a meaningful text that is mostly lost and not sent within the next moments.
+ */
+class DraftDiscards(private val chat: ChatActivity) : NotificationCenter.NotificationCenterDelegate {
+
+    private class Snapshot(val text: String, val draft: TLRPC.TL_draftMessage, val reply: TLRPC.Message?)
+
+    private class Pending(val snapshot: Snapshot, val at: Long)
+
+    private val account = chat.currentAccount
+    private val dialogId = chat.dialogId
+    private val topicId = chat.topicId.toInt()
+    private var previous: Snapshot? = null
+    private val pending = ArrayList<Pending>()
+    private val snapshotRunnable = Runnable { takeSnapshot() }
+    private val pendingRunnable = Runnable { checkPending() }
+
+    init {
+        NotificationCenter.getInstance(account).addObserver(this, NotificationCenter.didReceiveNewMessages)
+    }
+
+    private fun fieldText(): String? = chat.chatActivityEnterView?.editField?.text?.toString()
+
+    private fun editing(): Boolean = chat.chatActivityEnterView?.isEditingMessage == true
+
+    fun onTextChanged() {
+        if (editing()) {
+            // the edits of a sent message are not drafts
+            previous = null
+            AndroidUtilities.cancelRunOnUIThread(snapshotRunnable)
+            return
+        }
+        val current = fieldText() ?: return
+        val was = previous
+        if (was != null && lost(was.text, current)) {
+            pending.add(Pending(was, System.currentTimeMillis()))
+            previous = null
+            AndroidUtilities.cancelRunOnUIThread(pendingRunnable)
+            AndroidUtilities.runOnUIThread(pendingRunnable, PENDING_DELAY)
+        }
+        AndroidUtilities.cancelRunOnUIThread(snapshotRunnable)
+        if (meaningful(current)) {
+            AndroidUtilities.runOnUIThread(snapshotRunnable, SNAPSHOT_DELAY)
+        } else {
+            previous = null
+        }
+    }
+
+    // the reply and the link preview go with the text, so they are read a moment after typing
+    private fun takeSnapshot() {
+        if (editing()) return
+        val enterView = chat.chatActivityEnterView ?: return
+        val field = enterView.editField ?: return
+        val text = field.text?.toString() ?: return
+        if (!meaningful(text)) return
+        val chars = arrayOf<CharSequence>(SpannableStringBuilder(field.text))
+        val entities = MediaDataController.getInstance(account).getEntities(chars, true)
+        val reply = enterView.replyingMessageObject?.messageOwner
+        previous = Snapshot(text, SavedDrafts.buildDraftMessage(chars[0], entities, reply, enterView.webPage), reply)
+    }
+
+    private fun checkPending() {
+        val current = fieldText()?.let(::normalized)
+        val list = ArrayList(pending)
+        pending.clear()
+        for (entry in list) {
+            if (SavedDrafts.sentSince(dialogId, entry.at - SENT_WINDOW)) continue
+            // the text came back: undone or typed again
+            if (current != null && !editing() && current.contains(normalized(entry.snapshot.text))) continue
+            SavedDrafts.saveDiscarded(account, dialogId, topicId, entry.snapshot.draft, entry.snapshot.reply)
+        }
+    }
+
+    override fun didReceivedNotification(id: Int, account: Int, vararg args: Any?) {
+        if (id != NotificationCenter.didReceiveNewMessages) return
+        val targetDialog = args.getOrNull(0) as? Long ?: return
+        @Suppress("UNCHECKED_CAST")
+        val messages = args.getOrNull(1) as? ArrayList<MessageObject> ?: return
+        if (messages.any { it.isOut && it.isSending }) SavedDrafts.noteSent(targetDialog)
+    }
+
+    fun destroy() {
+        NotificationCenter.getInstance(account).removeObserver(this, NotificationCenter.didReceiveNewMessages)
+        AndroidUtilities.cancelRunOnUIThread(snapshotRunnable)
+        AndroidUtilities.cancelRunOnUIThread(pendingRunnable)
+        // leaving the chat right after clearing the field still keeps the text
+        if (pending.isNotEmpty()) checkPending()
+    }
+
+    companion object {
+        private const val MIN_LENGTH = 30
+        private const val SNAPSHOT_DELAY = 300L
+        private const val PENDING_DELAY = 1500L
+        private const val SENT_WINDOW = 2000L
+
+        private fun normalized(text: String) = text.trim().replace(Regex("\\s+"), " ")
+
+        private fun meaningful(text: String) = text.trim().length > MIN_LENGTH
+
+        /** At least half of a meaningful text is gone and the rest does not hold it. */
+        private fun lost(was: String, now: String): Boolean {
+            if (!meaningful(was)) return false
+            val before = normalized(was)
+            val after = normalized(now)
+            var prefix = 0
+            val limit = minOf(before.length, after.length)
+            while (prefix < limit && before[prefix] == after[prefix]) prefix++
+            var suffix = 0
+            while (suffix < limit - prefix && before[before.length - 1 - suffix] == after[after.length - 1 - suffix]) suffix++
+            return (prefix + suffix) * 2 < before.length && !after.contains(before)
+        }
+    }
+}
