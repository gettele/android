diff --git a/TMessagesProj/src/main/java/tele/helpers/TeleAccounts.kt b/TMessagesProj/src/main/java/tele/helpers/TeleAccounts.kt
new file mode 100644
index 000000000..8b9909ff6
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/TeleAccounts.kt
@@ -0,0 +1,100 @@
+package tele.helpers
+
+import android.content.Context
+import org.telegram.messenger.ApplicationLoader
+import org.telegram.messenger.UserConfig
+import org.telegram.tgnet.ConnectionsManager
+import tele.db.TeleDatabaseHelper
+import tele.scripting.Scripts
+import java.util.concurrent.atomic.AtomicLongArray
+
+object TeleAccounts {
+    private val generations = AtomicLongArray(UserConfig.MAX_ACCOUNT_COUNT)
+    private val owners = arrayOfNulls<String>(UserConfig.MAX_ACCOUNT_COUNT)
+    private var initialized = false
+    private val clearing = BooleanArray(UserConfig.MAX_ACCOUNT_COUNT)
+    private val prefs get() = ApplicationLoader.applicationContext.getSharedPreferences("tele_account_owners", Context.MODE_PRIVATE)
+
+    fun identity(account: Int): String {
+        val id = UserConfig.getInstance(account).clientUserId
+        if (id == 0L) return ""
+        return (if (ConnectionsManager.getInstance(account).isTestBackend) "test:" else "prod:") + id
+    }
+
+    @JvmStatic
+    @Synchronized
+    fun init() {
+        if (initialized) return
+        initialized = true
+        for (account in 0 until UserConfig.MAX_ACCOUNT_COUNT) {
+            UserConfig.getInstance(account).loadConfig()
+            ensure(account)
+        }
+    }
+
+    @JvmStatic
+    @Synchronized
+    fun ensure(account: Int): Boolean {
+        if (!initialized || account !in owners.indices || clearing[account]) return false
+        val owner = identity(account)
+        if (owners[account] == owner) return owner.isNotEmpty()
+        val stored = prefs.getString(account.toString(), null)
+        if (stored != owner) {
+            if (stored != null || owner.isEmpty()) clear(account)
+            else Scripts.onLogout(account)
+            if (!prefs.edit().putString(account.toString(), owner).commit()) return false
+        }
+        owners[account] = owner
+        return owner.isNotEmpty()
+    }
+
+    @JvmStatic
+    fun generation(account: Int): Long = generations.get(account)
+
+    @JvmStatic
+    fun isCurrent(account: Int, generation: Long): Boolean =
+        generations.get(account) == generation && owners[account]?.let { it.isNotEmpty() && it == identity(account) } == true
+
+    @JvmStatic
+    @Synchronized
+    fun onLogout(account: Int) {
+        if (!initialized) return
+        owners[account] = ""
+        clear(account)
+        check(prefs.edit().putString(account.toString(), "").commit())
+    }
+
+    private fun clear(account: Int) {
+        clearing[account] = true
+        try {
+        generations.incrementAndGet(account)
+        Scripts.onLogout(account)
+        LastSeenPeek.onLogout(account)
+        PrivacyRules.onAccountRemoved(account)
+        DeletedMessages.onLogout(account)
+        DeletedChats.onLogout(account)
+        RecoveredPosts.onLogout(account)
+        Bookmarks.onLogout(account)
+        ReturnPoint.onLogout(account)
+        DockedMedia.onLogout(account)
+        SavedDrafts.onLogout(account)
+        Aliases.onLogout(account)
+        FolderIcons.onLogout(account)
+        ObservedActivity.onLogout(account)
+        ReactionStrip.onLogout(account)
+        TeleChat.onLogout(account)
+        TeleNotices.onLogout(account)
+        PastLimit.onLogout(account)
+        LocalBackgrounds.onLogout(account)
+        OnlineNotify.onLogout(account)
+        GhostPending.onLogout(account)
+        LocalPins.onLogout(account)
+        TeleSilent.onLogout(account)
+        TeleServerNotices.onLogout(account)
+        TeleMtp.onLogout(account)
+        TeleDatabaseHelper.clearAccount(account)
+        } finally {
+            clearing[account] = false
+        }
+    }
+}
