diff --git a/TMessagesProj/src/main/java/tele/helpers/BoundedRegex.kt b/TMessagesProj/src/main/java/tele/helpers/BoundedRegex.kt
new file mode 100644
index 000000000..e86404cc3
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/BoundedRegex.kt
@@ -0,0 +1,85 @@
+package tele.helpers
+
+import java.util.regex.Pattern
+
+/**
+ * Runs user-supplied patterns over incoming text under one shared budget per message.
+ * A hostile rule can spend at most [TIME_NANOS] and [MAX_READS] reads, then the match fails open.
+ */
+internal object BoundedRegex {
+
+    const val TIME_NANOS = 8_000_000L
+    const val MAX_READS = 100_000
+
+    // a timeout check per 256 reads keeps the guard cheap and the overshoot small
+    private const val CHECK_MASK = 0xFF
+
+    private class Exceeded : RuntimeException(null, null, false, false)
+
+    /** One budget is shared by every rule applied to the same message text. */
+    class Budget internal constructor() {
+        private val start = System.nanoTime()
+        private var reads = 0
+        private var failed = false
+
+        internal fun tick() {
+            if ((++reads and CHECK_MASK) != 0) return
+            check()
+        }
+
+        internal fun check() {
+            if (failed) throw Exceeded()
+            if (reads > MAX_READS || System.nanoTime() - start >= TIME_NANOS) {
+                failed = true
+                throw Exceeded()
+            }
+        }
+
+        internal fun abort() {
+            failed = true
+        }
+
+        fun expired(): Boolean =
+            failed || reads > MAX_READS || System.nanoTime() - start >= TIME_NANOS
+    }
+
+    fun newBudget(): Budget = Budget()
+
+    fun find(pattern: Pattern, text: CharSequence, budget: Budget): Boolean {
+        if (budget.expired()) return false
+        return try {
+            pattern.matcher(Guarded(text, 0, text.length, budget)).find()
+        } catch (e: Exceeded) {
+            false
+        } catch (e: StackOverflowError) {
+            budget.abort()
+            false
+        }
+    }
+
+    // every get() counts against the shared budget; sub sequences keep the same guard
+    private class Guarded(
+        private val text: CharSequence,
+        private val offset: Int,
+        override val length: Int,
+        private val budget: Budget
+    ) : CharSequence {
+
+        override fun get(index: Int): Char {
+            if (index < 0 || index >= length) {
+                throw IndexOutOfBoundsException("index $index, length $length")
+            }
+            budget.tick()
+            return text[offset + index]
+        }
+
+        override fun subSequence(startIndex: Int, endIndex: Int): CharSequence {
+            if (startIndex < 0 || endIndex > length || startIndex > endIndex) {
+                throw IndexOutOfBoundsException("start $startIndex, end $endIndex, length $length")
+            }
+            return Guarded(text, offset + startIndex, endIndex - startIndex, budget)
+        }
+
+        override fun toString(): String = text.subSequence(offset, offset + length).toString()
+    }
+}
