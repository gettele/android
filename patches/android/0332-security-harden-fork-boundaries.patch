diff --git a/TMessagesProj/src/main/java/tele/scripting/ScriptReplies.kt b/TMessagesProj/src/main/java/tele/scripting/ScriptReplies.kt
new file mode 100644
index 000000000..5afbda2da
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/scripting/ScriptReplies.kt
@@ -0,0 +1,63 @@
+package tele.scripting
+
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicInteger
+
+internal class ScriptReplies<T : Any> {
+    internal class Pending<T : Any>(val owner: ScriptRuntime) {
+        val latch = CountDownLatch(1)
+        var answer: T? = null
+        var closed = false
+    }
+
+    private val tokens = AtomicInteger(1)
+    private val pending = ConcurrentHashMap<Int, Pending<T>>()
+
+    fun open(owner: ScriptRuntime): Int {
+        while (true) {
+            val token = tokens.getAndIncrement()
+            if (pending.putIfAbsent(token, Pending(owner)) == null) return token
+        }
+    }
+
+    fun answer(owner: ScriptRuntime, token: Int, value: T): Boolean {
+        val request = pending[token] ?: return false
+        synchronized(request) {
+            if (request.owner !== owner || !owner.isRunning() || request.closed || request.answer != null) return false
+            request.answer = value
+            request.latch.countDown()
+            return true
+        }
+    }
+
+    fun await(token: Int, timeout: Long): T? {
+        val request = pending[token] ?: return null
+        try {
+            request.latch.await(timeout, TimeUnit.MILLISECONDS)
+            synchronized(request) {
+                return if (!request.closed && request.owner.isRunning()) request.answer else null
+            }
+        } catch (e: InterruptedException) {
+            Thread.currentThread().interrupt()
+            return null
+        } finally {
+            close(token)
+        }
+    }
+
+    fun close(token: Int) {
+        val request = pending.remove(token) ?: return
+        synchronized(request) {
+            request.closed = true
+            request.latch.countDown()
+        }
+    }
+
+    fun cancel(owner: ScriptRuntime) {
+        for ((token, request) in pending) {
+            if (request.owner === owner) close(token)
+        }
+    }
+}
