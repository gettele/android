+            val rows = ArrayList<Row>()
+            val pages = SECTIONS.filter { "tele/${it.first}" in fresh }
+            if (pages.isNotEmpty()) {
+                rows.add(Row(TYPE_HEADER, "new pages"))
+                pages.forEach { rows.add(sectionLink(it.second, it.first, it.third)) }
+                rows.add(Row(TYPE_SHADOW))
+            }
+            for ((mode, title) in SECTIONS.map { it.first to it.second } + (MODE_ROOT to "tele")) {
+                val picked = buildRows(mode).filter { (it.type == TYPE_TOGGLE || it.type == TYPE_VALUE) && it.item?.key in fresh }
+                if (picked.isEmpty()) continue
+                rows.add(Row(TYPE_HEADER, title))
+                rows.addAll(picked)
+                rows.add(link("open $title", mode))
+                rows.add(Row(TYPE_SHADOW))
+            }
+            return rows
+        }
+
