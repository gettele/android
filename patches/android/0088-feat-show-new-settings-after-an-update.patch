+package tele.helpers
+
+import android.graphics.PorterDuff
+import android.graphics.PorterDuffColorFilter
+import android.text.SpannableString
+import android.text.SpannableStringBuilder
+import android.text.Spanned
+import android.text.style.DynamicDrawableSpan
+import android.text.style.ImageSpan
+import org.json.JSONArray
+import org.json.JSONObject
+import org.telegram.messenger.ApplicationLoader
+import org.telegram.messenger.R
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Components.CombinedDrawable
+import tele.TeleBuild
+import tele.TeleConfig
+import tele.ui.settings.TeleSettingsActivity
+
+// settings this device hasn't seen before (tele 0112): collected once per launch against the stored known list
+object TeleNewSettings {
+    private var started = false
+    private val fresh = ArrayList<String>()
+    private var seen = false
+
+    // UI thread
+    @JvmStatic
+    fun fresh(): List<String> {
+        if (!started) {
+            started = true
+            compute()
+        }
+        return fresh
+    }
+
+    private fun compute() {
+        val current = TeleSettingsActivity.settingIds()
+        val stored = runCatching { JSONObject(TeleConfig.KNOWN_SETTINGS.value) }.getOrNull()
+        val known = stored?.optJSONArray("known")
+        if (known != null) {
+            val knownIds = HashSet<String>()
+            for (i in 0 until known.length()) knownIds.add(known.optString(i))
+            val previous = HashSet<String>()
+            if (!stored.optBoolean("seen")) {
+                val list = stored.optJSONArray("new") ?: JSONArray()
+                for (i in 0 until list.length()) previous.add(list.optString(i))
+            }
+            current.filterTo(fresh) { it !in knownIds || it in previous }
+        }
+        write(current, false)
+    }
+
+    private fun write(current: List<String>, seen: Boolean) {
+        TeleConfig.set(TeleConfig.KNOWN_SETTINGS, JSONObject()
+            .put("known", JSONArray(current))
+            .put("new", JSONArray(fresh))
+            .put("seen", seen)
+            .toString())
+    }
+
+    @JvmStatic
+    fun isSeen(): Boolean = seen
+
+    @JvmStatic
+    fun markSeen() {
+        if (seen || fresh().isEmpty()) return
+        seen = true
+        write(TeleSettingsActivity.settingIds(), true)
+    }
+
+    @JvmStatic
+    fun title(): String = if (TeleBuild.BUILD > 0) "new in tele ${TeleBuild.BUILD}" else "new in tele"
+
+    // the stock "NEW" pill of folder settings
+    @JvmStatic
+    fun withBadge(text: CharSequence): CharSequence {
+        val res = ApplicationLoader.applicationContext.resources
+        val bg = res.getDrawable(R.drawable.msg_other_new_filled).mutate()
+        val label = res.getDrawable(R.drawable.msg_other_new_filled_text).mutate()
+        bg.colorFilter = PorterDuffColorFilter(Theme.getColor(Theme.key_featuredStickers_unread), PorterDuff.Mode.MULTIPLY)
+        label.colorFilter = PorterDuffColorFilter(Theme.getColor(Theme.key_featuredStickers_buttonText), PorterDuff.Mode.MULTIPLY)
+        val drawable = CombinedDrawable(bg, label)
+        drawable.setBounds(0, 0, drawable.intrinsicWidth, drawable.intrinsicHeight)
+        val badge = SpannableString("NEW")
+        badge.setSpan(ImageSpan(drawable, DynamicDrawableSpan.ALIGN_BOTTOM), 0, badge.length, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
+        return SpannableStringBuilder(text).append("  ").append(badge)
+    }
+}
