From: =?UTF-8?q?t=CE=B1ngenx?= <me@tangenx.dev>
Date: Thu, 1 Oct 2026 19:44:54 +0300
Subject: [PATCH] debloat: hide call buttons

---
 .../main/java/org/telegram/ui/ChatActivity.java    | 14 +++++++++-----
 .../main/java/org/telegram/ui/ProfileActivity.java | 11 +++++------
 TMessagesProj/src/main/java/tele/TeleConfig.kt     |  2 ++
 .../java/tele/ui/settings/TeleSettingsActivity.kt  |  3 ++-
 4 files changed, 18 insertions(+), 12 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
index 9dff55323..7fef811c0 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
@@ -201,6 +201,7 @@ import org.telegram.messenger.utils.tlutils.TLKeyboardHelper;
 import org.telegram.messenger.utils.tlutils.TlUtils;
 import org.telegram.messenger.voip.VoIPService;
 import org.telegram.tgnet.ConnectionsManager;
+import tele.TeleConfig;
 import org.telegram.tgnet.TLObject;
 import org.telegram.tgnet.TLRPC;
 import org.telegram.tgnet.tl.TL_account;
@@ -4309,7 +4310,7 @@ public class ChatActivity extends BaseFragment implements
                 audioCallIconItem = menu.lazilyAddItem(call, R.drawable.call, themeDelegate);
                 audioCallIconItem.setContentDescription(LocaleController.getString(R.string.Call));
                 userFull = getMessagesController().getUserFull(currentUser.id);
-                if (userFull != null && userFull.phone_calls_available) {
+                if (userFull != null && userFull.phone_calls_available && !TeleConfig.HIDE_CALL_BUTTONS.getValue()) {
                     showAudioCallAsIcon = !inPreviewMode;
                     audioCallIconItem.setVisibility(View.VISIBLE);
                 } else {
@@ -4448,7 +4449,10 @@ public class ChatActivity extends BaseFragment implements
             if (currentUser != null && chatMode != MODE_SAVED) {
                 headerItem.lazilyAddSubItem(call, R.drawable.msg_callback, LocaleController.getString(R.string.Call));
                 headerItem.lazilyAddSubItem(video_call, R.drawable.msg_videocall, LocaleController.getString(R.string.VideoCall));
-                if (userFull != null && userFull.phone_calls_available) {
+                if (TeleConfig.HIDE_CALL_BUTTONS.getValue()) {
+                    headerItem.hideSubItem(call);
+                    headerItem.hideSubItem(video_call);
+                } else if (userFull != null && userFull.phone_calls_available) {
                     headerItem.showSubItem(call);
                     if (userFull.video_calls_available) {
                         headerItem.showSubItem(video_call);
@@ -24051,8 +24055,8 @@ public class ChatActivity extends BaseFragment implements
                     }
                 }
                 if (headerItem != null) {
-                    showAudioCallAsIcon = userInfo.phone_calls_available && !inPreviewMode;
-                    if (userInfo.phone_calls_available) {
+                    showAudioCallAsIcon = userInfo.phone_calls_available && !inPreviewMode && !TeleConfig.HIDE_CALL_BUTTONS.getValue();
+                    if (userInfo.phone_calls_available && !TeleConfig.HIDE_CALL_BUTTONS.getValue()) {
                         if (showAudioCallAsIcon) {
                             if (audioCallIconItem != null) {
                                 View item = audioCallIconItem.createView();
@@ -29796,7 +29800,7 @@ public class ChatActivity extends BaseFragment implements
         super.setInPreviewMode(value);
         if (currentUser != null && audioCallIconItem != null) {
             TLRPC.UserFull userFull = getMessagesController().getUserFull(currentUser.id);
-            if (userFull != null && userFull.phone_calls_available) {
+            if (userFull != null && userFull.phone_calls_available && !TeleConfig.HIDE_CALL_BUTTONS.getValue()) {
                 showAudioCallAsIcon = !inPreviewMode;
                 audioCallIconItem.setVisibility(View.VISIBLE);
             } else {
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/ProfileActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/ProfileActivity.java
index 21e77f956..0a9d0b109 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/ProfileActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/ProfileActivity.java
@@ -168,6 +168,7 @@ import org.telegram.messenger.UserObject;
 import org.telegram.messenger.Utilities;
 import org.telegram.messenger.browser.Browser;
 import org.telegram.tgnet.ConnectionsManager;
+import tele.TeleConfig;
 import org.telegram.tgnet.SerializedData;
 import org.telegram.tgnet.TLObject;
 import org.telegram.tgnet.TLRPC;
@@ -7435,7 +7436,7 @@ public class ProfileActivity extends BaseFragment implements NotificationCenter.
             o.setScrimViewBackground(listView.getClipBackground(view));
             o.setLongPressSelectionEnabled(false);
             if (position == phoneRow) {
-                if (userInfo != null && userInfo.phone_calls_available) {
+                if (userInfo != null && userInfo.phone_calls_available && !TeleConfig.HIDE_CALL_BUTTONS.getValue()) {
                     o.add(R.drawable.msg_calls, getString(R.string.CallViaTelegram), () -> {
                         if (getParentActivity() == null) return;
                         VoIPHelper.startCall(user, false, userInfo != null && userInfo.video_calls_available, getParentActivity(), userInfo, getAccountInstance());
@@ -11343,16 +11344,14 @@ public class ProfileActivity extends BaseFragment implements NotificationCenter.
             if (avatarBig == null) {
                 if (vectorAvatar != null) {
                     avatarImage.setImageDrawable(vectorAvatarThumbDrawable);
+                } else if (TeleConfig.STATIC_AVATARS.getValue()) {
+                    avatarImage.setImage(imageLocation, "100_100", thumbLocation, "50_50", avatarDrawable, user);
                 } else if (videoThumbLocation != null && !user.photo.personal) {
                     avatarImage.getImageReceiver().setVideoThumbIsSame(true);
                     avatarImage.setImage(videoThumbLocation, "avatar", imageLocation, "50_50", thumbLocation, "50_50", avatarDrawable, user);
                 } else {
                     avatarImage.setImage(videoLocation, ImageLoader.AUTOPLAY_FILTER, imageLocation, "100_100", thumbLocation, "50_50", avatarDrawable, user);
                 }
-            }
-
-            if (thumbLocation != null && setAvatarRow != -1 || thumbLocation == null && setAvatarRow == -1) {
-                updateListAnimated(false);
                 needLayout(true);
             }
             if (imageLocation != null && (prevLoadedImageLocation == null || imageLocation.photoId != prevLoadedImageLocation.photoId)) {
@@ -12127,7 +12126,7 @@ public class ProfileActivity extends BaseFragment implements NotificationCenter.
                     editItemVisible = true;
                 }
 
-                if (userInfo != null && userInfo.phone_calls_available) {
+                if (userInfo != null && userInfo.phone_calls_available && !TeleConfig.HIDE_CALL_BUTTONS.getValue()) {
                     callItemVisible = true;
                     videoCallItemVisible = userInfo.video_calls_available;
                 }
diff --git a/TMessagesProj/src/main/java/tele/TeleConfig.kt b/TMessagesProj/src/main/java/tele/TeleConfig.kt
index 79d59f26b..ac859d13c 100644
--- a/TMessagesProj/src/main/java/tele/TeleConfig.kt
+++ b/TMessagesProj/src/main/java/tele/TeleConfig.kt
@@ -46,6 +46,8 @@ object TeleConfig {
     val SHOW_SECONDS = BoolItem("show_seconds", false)
     @JvmField
     val HIDE_ALL_CHATS_FOLDER = BoolItem("hide_all_chats_folder", false)
+    @JvmField
+    val HIDE_CALL_BUTTONS = BoolItem("hide_call_buttons", false)
 
     private var prefs: SharedPreferences? = null
 
diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
index 486e62a75..af759a16f 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
@@ -68,7 +68,8 @@ class TeleSettingsActivity : BaseFragment() {
             Row(TYPE_SHADOW),
             Row(TYPE_HEADER, "interface"),
             Row(TYPE_TOGGLE, "show seconds in message times", item = TeleConfig.SHOW_SECONDS),
-            Row(TYPE_TOGGLE, "hide the all chats folder", item = TeleConfig.HIDE_ALL_CHATS_FOLDER)
+            Row(TYPE_TOGGLE, "hide the all chats folder", item = TeleConfig.HIDE_ALL_CHATS_FOLDER),
+            Row(TYPE_TOGGLE, "hide call buttons", item = TeleConfig.HIDE_CALL_BUTTONS)
         )
 
         override fun getItemCount(): Int = rows.size
