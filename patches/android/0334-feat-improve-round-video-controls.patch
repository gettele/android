diff --git a/TMessagesProj/src/main/java/tele/helpers/RoundZoom.kt b/TMessagesProj/src/main/java/tele/helpers/RoundZoom.kt
new file mode 100644
index 000000000..613e5ead2
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/RoundZoom.kt
@@ -0,0 +1,705 @@
+package tele.helpers
+
+import android.animation.ValueAnimator
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.RectF
+import android.graphics.Typeface
+import android.view.Gravity
+import android.view.HapticFeedbackConstants
+import android.view.MotionEvent
+import android.view.View
+import android.view.ViewConfiguration
+import android.view.animation.DecelerateInterpolator
+import android.widget.FrameLayout
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Components.blur3.BlurredBackgroundDrawableViewFactory
+import org.telegram.ui.Components.blur3.drawable.BlurredBackgroundDrawable
+import org.telegram.ui.Components.blur3.drawable.color.BlurredBackgroundColorProvider
+import tele.TeleConfig
+import java.util.Locale
+import kotlin.math.abs
+import kotlin.math.ceil
+import kotlin.math.max
+import kotlin.math.min
+import kotlin.math.roundToInt
+
+/**
+ * Round-video lens picker: a row of round glass lens buttons directly under the preview, and a
+ * wide zoom ruler that is shown only while a press is held. Stops come from
+ * [RoundZoomLenses], so no lens is offered unless the active camera can actually reach it.
+ */
+class RoundZoomView(context: Context, private val host: Host) : View(context) {
+
+    interface Host {
+        fun isFrontCamera(): Boolean
+        fun supportsLensStops(): Boolean
+        fun rearCameraId(): String?
+        fun minZoomRatio(): Float
+        fun maxZoomRatio(): Float
+        fun currentZoomRatio(): Float
+        fun applyZoomRatio(ratio: Float)
+        fun isZoomAvailable(): Boolean
+    }
+
+    companion object {
+        private const val BUTTON_DP = 44f
+        private const val BUTTON_GAP_DP = 8f
+        private const val HEIGHT_DP = 88f
+        private const val MAX_WIDTH_DP = 320f
+        private const val GLASS_INSET_DP = 4f
+        private const val RULER_GLASS_TOP_DP = 30f
+        private const val TRACK_TOP_DP = 58f
+        private const val LABEL_ROW_1_DP = 72f
+        private const val LABEL_ROW_2_DP = 82f
+        private const val BUBBLE_HEIGHT_DP = 28f
+        private const val THUMB_RADIUS_DP = 5.5f
+        private const val STOP_TOLERANCE = 0.045f
+
+        @JvmStatic
+        fun attach(parent: FrameLayout, host: Host): RoundZoomView {
+            val view = RoundZoomView(parent.context, host)
+            val width = min(
+                parent.resources.displayMetrics.widthPixels - AndroidUtilities.dp(32f),
+                AndroidUtilities.dp(MAX_WIDTH_DP)
+            ).coerceAtLeast(AndroidUtilities.dp(220f))
+            val params = FrameLayout.LayoutParams(
+                width,
+                AndroidUtilities.dp(HEIGHT_DP),
+                Gravity.TOP or Gravity.CENTER_HORIZONTAL
+            )
+            params.topMargin = AndroidUtilities.dp(8f)
+            parent.addView(view, params)
+            return view
+        }
+
+        @JvmStatic
+        fun formatRatio(ratio: Float): String {
+            val rounded = ratio.roundToInt()
+            return if (abs(ratio - rounded) < 0.08f) {
+                "${rounded}×"
+            } else {
+                String.format(Locale.US, "%.1f×", ratio)
+            }
+        }
+
+        private fun niceStep(raw: Float): Float {
+            val candidates = floatArrayOf(.05f, .1f, .2f, .25f, .5f, 1f, 2f, 2.5f, 5f, 10f)
+            for (candidate in candidates) {
+                if (candidate >= raw) return candidate
+            }
+            return raw
+        }
+    }
+
+    private val density = resources.displayMetrics.density
+    private val touchSlop = ViewConfiguration.get(context).scaledTouchSlop
+    private val buttonSize = dp(BUTTON_DP)
+    private val buttonGap = dp(BUTTON_GAP_DP)
+    private val textPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        textAlign = Paint.Align.CENTER
+        typeface = Typeface.create("sans-serif-medium", Typeface.NORMAL)
+    }
+    private val trackPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        strokeCap = Paint.Cap.ROUND
+        strokeWidth = dp(1.5f)
+    }
+    private val fillPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        strokeCap = Paint.Cap.ROUND
+        strokeWidth = dp(1.5f)
+    }
+    private val tickPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        strokeCap = Paint.Cap.ROUND
+    }
+    private val fallbackPaint = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val fallbackStroke = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        style = Paint.Style.STROKE
+        strokeWidth = dp(0.66f)
+    }
+    private val activeFill = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val rect = RectF()
+
+    private var factory: BlurredBackgroundDrawableViewFactory? = null
+    private val buttonGlass = ArrayList<BlurredBackgroundDrawable?>()
+    private var rulerGlass: BlurredBackgroundDrawable? = null
+    private val bubblePaint = Paint(Paint.ANTI_ALIAS_FLAG)
+
+    /** The controls float over the dark camera preview, not over the chat theme. */
+    private val recordingColorProvider = object : BlurredBackgroundColorProvider {
+        override fun getShadowColor(): Int = 0x66000000
+        override fun getBackgroundColor(): Int = 0x66000000
+        override fun getStrokeColorTop(): Int = 0x33FFFFFF
+        override fun getStrokeColorBottom(): Int = 0x1AFFFFFF
+        override fun getOutlineColor(): Int = 0x24FFFFFF
+        override fun getOutlineWidth(): Float = dp(0.66f)
+    }
+
+    private var available = false
+    private var hostOpen = false
+    private var expanded = false
+    private var expansion = 0f
+    private var expansionAnimator: ValueAnimator? = null
+    private var front = true
+    private var minRatio = 1f
+    private var maxRatio = 1f
+    private var stops = FloatArray(0)
+    private var currentRatio = 1f
+    private var pressed = false
+    private var dragging = false
+    private var longPressFired = false
+    private var downX = 0f
+    private var downY = 0f
+    private var lastHapticStop = -1
+
+    private var anchor: View? = null
+    private var anchorBottomInset = 0
+    private val anchorLayoutListener = View.OnLayoutChangeListener { _, _, _, _, _, _, _, _, _ ->
+        positionUnderAnchor()
+    }
+
+    private val autoCollapseRunnable = Runnable { setExpanded(false) }
+    private val longPressRunnable = Runnable {
+        if (!pressed) return@Runnable
+        longPressFired = true
+        openExpanded()
+    }
+
+    init {
+        isClickable = false
+        isFocusable = false
+        visibility = INVISIBLE
+    }
+
+    @Suppress("UNUSED_PARAMETER")
+    fun setGlassBackground(
+        factory: BlurredBackgroundDrawableViewFactory?,
+        provider: BlurredBackgroundColorProvider?
+    ) {
+        this.factory = factory
+        buttonGlass.clear()
+        rulerGlass = null
+        if (factory != null) {
+            rulerGlass = factory.create(this, recordingColorProvider).apply {
+                setPadding(dp(1f).roundToInt())
+                setRadius(dp(26f))
+            }
+            rebuildButtonGlass()
+        }
+        invalidate()
+    }
+
+    fun setAnchor(anchor: View, bottomInsetDp: Int) {
+        this.anchor?.removeOnLayoutChangeListener(anchorLayoutListener)
+        this.anchor = anchor
+        this.anchorBottomInset = AndroidUtilities.dp(bottomInsetDp.toFloat())
+        anchor.addOnLayoutChangeListener(anchorLayoutListener)
+        positionUnderAnchor()
+    }
+
+    fun setHostOpen(open: Boolean) {
+        hostOpen = open
+        if (!open) {
+            pressed = false
+            dragging = false
+            longPressFired = false
+            removeCallbacks(longPressRunnable)
+            setExpanded(false)
+        }
+        applyAlpha(animate = open)
+    }
+
+    fun refresh() {
+        val wantAvailable = TeleConfig.ROUND_ZOOM.value && host.isZoomAvailable()
+        val wasAvailable = available
+        available = wantAvailable
+        if (!available) {
+            if (wasAvailable) setExpanded(false)
+            applyAlpha(animate = false)
+            return
+        }
+
+        val newFront = host.isFrontCamera()
+        val newMin = host.minZoomRatio().coerceAtLeast(0.1f)
+        val newMax = max(newMin, host.maxZoomRatio())
+        val rawStops = if (newFront || !host.supportsLensStops()) {
+            FloatArray(0)
+        } else {
+            RoundZoomLenses.rearLensStops(host.rearCameraId(), newMax, newMin)
+        }
+        val newStops = rawStops.filter { it in newMin..newMax }.distinct().toFloatArray()
+
+        val stopsChanged = !newStops.contentEquals(stops)
+        if (newFront != front || abs(newMax - maxRatio) > 0.001f || stopsChanged
+            || abs(newMin - minRatio) > 0.001f
+        ) {
+            front = newFront
+            minRatio = newMin
+            maxRatio = newMax
+            stops = if (newStops.size < 2) FloatArray(0) else newStops
+            currentRatio = currentRatio.coerceIn(minRatio, maxRatio)
+            if (stopsChanged) {
+                rebuildButtonGlass()
+                setExpanded(false)
+            }
+        }
+        currentRatio = host.currentZoomRatio().coerceIn(minRatio, maxRatio)
+        if (!wasAvailable) applyAlpha(animate = false)
+        invalidate()
+    }
+
+    fun syncRatio(ratio: Float) {
+        if (!available) return
+        val clamped = ratio.coerceIn(minRatio, maxRatio)
+        if (abs(clamped - currentRatio) < 0.001f) return
+        currentRatio = clamped
+        invalidate()
+    }
+
+    private fun applyAlpha(animate: Boolean) {
+        val target = if (available && hostOpen) 1f else 0f
+        animate().cancel()
+        if (animate) {
+            animate().alpha(target).setDuration(160L).start()
+        } else {
+            alpha = target
+        }
+        visibility = if (available) VISIBLE else INVISIBLE
+        if (target == 0f) setExpanded(false)
+    }
+
+    private fun rebuildButtonGlass() {
+        val count = buttonCount()
+        while (buttonGlass.size > count) {
+            buttonGlass.removeAt(buttonGlass.size - 1)
+        }
+        while (buttonGlass.size < count) {
+            buttonGlass.add(factory?.create(this, recordingColorProvider)?.apply {
+                setPadding(dp(GLASS_INSET_DP).roundToInt())
+                setRadius(dp(BUTTON_DP / 2f - GLASS_INSET_DP))
+            })
+        }
+    }
+
+    private fun buttonCount(): Int = if (stops.isEmpty()) 1 else stops.size
+
+    private fun rowWidth(): Float {
+        val count = buttonCount()
+        return count * buttonSize + (count - 1) * buttonGap
+    }
+
+    private fun buttonLeft(index: Int): Float {
+        return (width - rowWidth()) / 2f + index * (buttonSize + buttonGap)
+    }
+
+    private fun setExpanded(value: Boolean) {
+        if (expanded == value) return
+        expanded = value
+        removeCallbacks(autoCollapseRunnable)
+        expansionAnimator?.cancel()
+        expansionAnimator = ValueAnimator.ofFloat(expansion, if (value) 1f else 0f).apply {
+            duration = if (value) 180L else 140L
+            interpolator = DecelerateInterpolator()
+            addUpdateListener { animation ->
+                expansion = animation.animatedValue as Float
+                invalidate()
+            }
+            start()
+        }
+        invalidate()
+    }
+
+    private fun openExpanded() {
+        if (!expanded) setExpanded(true)
+        removeCallbacks(autoCollapseRunnable)
+    }
+
+    private fun haptic(constant: Int) {
+        performHapticFeedback(constant)
+    }
+
+    private fun stopsIndex(value: Float): Int {
+        var best = -1
+        var distance = Float.MAX_VALUE
+        for (i in stops.indices) {
+            val d = abs(stops[i] - value)
+            if (d < distance) {
+                distance = d
+                best = i
+            }
+        }
+        return best
+    }
+
+    private fun valueToX(value: Float): Float {
+        val start = dp(18f)
+        val end = width - dp(18f)
+        val fraction = if (maxRatio <= minRatio) 0f else (value - minRatio) / (maxRatio - minRatio)
+        return start + (end - start) * fraction.coerceIn(0f, 1f)
+    }
+
+    private fun xToValue(x: Float): Float {
+        val start = dp(18f)
+        val end = width - dp(18f)
+        if (end <= start) return minRatio
+        val fraction = ((x - start) / (end - start)).coerceIn(0f, 1f)
+        return minRatio + (maxRatio - minRatio) * fraction
+    }
+
+    private fun updateRatioFromX(x: Float) {
+        if (!available) return
+        currentRatio = xToValue(x)
+        host.applyZoomRatio(currentRatio)
+        val index = stopsIndex(currentRatio)
+        if (index >= 0 && index != lastHapticStop) {
+            val span = (maxRatio - minRatio).coerceAtLeast(0.001f)
+            if (abs(stops[index] - currentRatio) < span * STOP_TOLERANCE) {
+                lastHapticStop = index
+                haptic(HapticFeedbackConstants.CLOCK_TICK)
+            }
+        }
+        invalidate()
+    }
+
+    private fun applyStop(value: Float) {
+        currentRatio = value.coerceIn(minRatio, maxRatio)
+        host.applyZoomRatio(currentRatio)
+        lastHapticStop = stopsIndex(currentRatio)
+        haptic(HapticFeedbackConstants.CLOCK_TICK)
+        invalidate()
+    }
+
+    private fun snapToStop() {
+        if (stops.isEmpty()) return
+        val index = stopsIndex(currentRatio)
+        if (index < 0) return
+        val value = stops[index]
+        if (abs(value - currentRatio) < (maxRatio - minRatio) * 0.08f) {
+            currentRatio = value
+            host.applyZoomRatio(value)
+            invalidate()
+        }
+    }
+
+    private fun stopAt(x: Float): Int {
+        if (stops.isEmpty()) return -1
+        val left = buttonLeft(0)
+        val index = ((x - left) / (buttonSize + buttonGap)).toInt()
+        if (index !in stops.indices) return -1
+        val buttonLeft = buttonLeft(index)
+        return if (x in buttonLeft..(buttonLeft + buttonSize)) index else -1
+    }
+
+    private fun inButtonRow(x: Float, y: Float): Boolean {
+        if (y < 0f || y > buttonSize) return false
+        val left = (width - rowWidth()) / 2f
+        return x >= left && x <= left + rowWidth()
+    }
+
+    override fun onTouchEvent(event: MotionEvent): Boolean {
+        if (!available || !hostOpen || !isEnabled) return false
+        when (event.actionMasked) {
+            MotionEvent.ACTION_DOWN -> {
+                if (!expanded && !inButtonRow(event.x, event.y)) return false
+                pressed = true
+                dragging = false
+                longPressFired = false
+                downX = event.x
+                downY = event.y
+                lastHapticStop = stopsIndex(currentRatio)
+                removeCallbacks(autoCollapseRunnable)
+                if (!expanded) {
+                    postDelayed(
+                        longPressRunnable,
+                        ViewConfiguration.getLongPressTimeout().toLong()
+                    )
+                }
+                return true
+            }
+            MotionEvent.ACTION_MOVE -> {
+                if (!pressed) return false
+                if (longPressFired || dragging) {
+                    updateRatioFromX(event.x)
+                } else if (abs(event.x - downX) > touchSlop
+                    || abs(event.y - downY) > touchSlop
+                ) {
+                    dragging = true
+                    removeCallbacks(longPressRunnable)
+                    openExpanded()
+                    updateRatioFromX(event.x)
+                }
+                return true
+            }
+            MotionEvent.ACTION_UP -> {
+                if (!pressed) return false
+                pressed = false
+                removeCallbacks(longPressRunnable)
+                if (longPressFired || dragging) {
+                    updateRatioFromX(event.x)
+                    snapToStop()
+                    setExpanded(false)
+                } else if (expanded) {
+                    snapToStop()
+                    setExpanded(false)
+                } else if (stops.isNotEmpty()) {
+                    val index = stopAt(event.x)
+                    if (index >= 0) applyStop(stops[index])
+                } else {
+                    openExpanded()
+                    postDelayed(autoCollapseRunnable, 1200L)
+                }
+                dragging = false
+                longPressFired = false
+                return true
+            }
+            MotionEvent.ACTION_CANCEL -> {
+                pressed = false
+                dragging = false
+                longPressFired = false
+                removeCallbacks(longPressRunnable)
+                setExpanded(false)
+                return true
+            }
+        }
+        return false
+    }
+
+    override fun onDraw(canvas: Canvas) {
+        super.onDraw(canvas)
+        if (width <= 0 || height <= 0) return
+        updateColors()
+
+        val collapsedAlpha = 1f - expansion
+        if (collapsedAlpha > 0.001f) {
+            canvas.saveLayerAlpha(0f, 0f, width.toFloat(), buttonSize, (255 * collapsedAlpha).toInt())
+            drawButtonRow(canvas, collapsedAlpha)
+            canvas.restore()
+        }
+        if (expansion > 0.001f) {
+            drawRuler(canvas)
+        }
+    }
+
+    private fun drawButtonRow(canvas: Canvas, collapsedAlpha: Float) {
+        val active = if (stops.isEmpty()) 0 else stopsIndex(currentRatio)
+        val activeTolerance = if (stops.isEmpty()) Float.MAX_VALUE else 0.06f
+        for (i in 0 until buttonCount()) {
+            val left = buttonLeft(i)
+            val top = 0f
+            val right = left + buttonSize
+            drawGlass(canvas, buttonGlass.getOrNull(i), left, top, right, buttonSize)
+            val isActive = if (stops.isEmpty()) true else {
+                i == active && abs(stops[i] - currentRatio) <= activeTolerance
+            }
+            if (isActive) {
+                activeFill.color = 0x2EFFFFFF
+                canvas.drawCircle(
+                    (left + right) / 2f,
+                    (top + buttonSize) / 2f,
+                    buttonSize / 2f - dp(GLASS_INSET_DP),
+                    activeFill
+                )
+            }
+            val label = if (stops.isEmpty()) {
+                formatRatio(currentRatio)
+            } else {
+                formatRatio(stops[i])
+            }
+            textPaint.color = textColor()
+            textPaint.textSize = dp(11f)
+            textPaint.typeface = Typeface.create(
+                "sans-serif-medium",
+                if (isActive) Typeface.BOLD else Typeface.NORMAL
+            )
+            textPaint.alpha = if (isActive) 255 else (collapsedAlpha * 205).toInt()
+            val baseline = (top + buttonSize - (textPaint.ascent() + textPaint.descent())) / 2f
+            canvas.drawText(label, (left + right) / 2f, baseline, textPaint)
+            textPaint.alpha = 255
+        }
+    }
+
+    private fun drawRuler(canvas: Canvas) {
+        val half = width / 2f * (0.62f + 0.38f * expansion)
+        canvas.save()
+        canvas.clipRect(width / 2f - half, 0f, width / 2f + half, height.toFloat())
+        canvas.saveLayerAlpha(0f, 0f, width.toFloat(), height.toFloat(), (255 * expansion).toInt())
+
+        val glassTop = dp(RULER_GLASS_TOP_DP)
+        drawGlass(canvas, rulerGlass, 0f, glassTop, width.toFloat(), height.toFloat())
+        if (rulerGlass == null) {
+            rect.set(0f, glassTop, width.toFloat(), height.toFloat())
+            canvas.drawRoundRect(rect, dp(26f), dp(26f), fallbackPaint)
+            canvas.drawRoundRect(rect, dp(26f), dp(26f), fallbackStroke)
+        }
+
+        val left = dp(18f)
+        val right = width - dp(18f)
+        val trackY = dp(TRACK_TOP_DP)
+        val trackColor = 0x66FFFFFF
+        val strongColor = textColor()
+
+        trackPaint.color = trackColor
+        canvas.drawLine(left, trackY, right, trackY, trackPaint)
+
+        val currentX = valueToX(currentRatio)
+        fillPaint.color = strongColor
+        canvas.drawLine(left, trackY, currentX, trackY, fillPaint)
+
+        drawMinorTicks(canvas, left, right, trackY, trackColor)
+
+        tickPaint.strokeWidth = dp(1.5f)
+        val lastRight = floatArrayOf(-Float.MAX_VALUE, -Float.MAX_VALUE)
+        for (stop in stops) {
+            val x = valueToX(stop)
+            val isActive = abs(stop - currentRatio) <= STOP_TOLERANCE
+            tickPaint.color = if (isActive) strongColor else trackColor
+            canvas.drawLine(x, trackY - dp(5f), x, trackY + dp(5f), tickPaint)
+
+            val label = formatRatio(stop)
+            textPaint.color = strongColor
+            textPaint.textSize = dp(10f)
+            textPaint.typeface = Typeface.create(
+                "sans-serif-medium",
+                if (isActive) Typeface.BOLD else Typeface.NORMAL
+            )
+            textPaint.alpha = if (isActive) 255 else 200
+            val halfText = textPaint.measureText(label) / 2f
+            var row = 0
+            if (x - halfText < lastRight[0] + dp(2f)) row = 1
+            if (row == 1 && x - halfText < lastRight[1] + dp(2f)) {
+                row = 0
+            }
+            lastRight[row] = max(lastRight[row], x + halfText)
+            val centerY = dp(if (row == 0) LABEL_ROW_1_DP else LABEL_ROW_2_DP)
+            val baseline = centerY - (textPaint.ascent() + textPaint.descent()) / 2f
+            canvas.drawText(label, x, baseline, textPaint)
+            textPaint.alpha = 255
+        }
+
+        tickPaint.strokeWidth = dp(2f)
+        tickPaint.color = accentColor()
+        canvas.drawCircle(currentX, trackY, dp(THUMB_RADIUS_DP), tickPaint)
+        fillPaint.color = Color.WHITE
+        canvas.drawCircle(currentX, trackY, dp(THUMB_RADIUS_DP - 1.6f), fillPaint)
+
+        drawCurrentBubble(canvas, currentX)
+
+        canvas.restore()
+        canvas.restore()
+    }
+
+    private fun drawMinorTicks(
+        canvas: Canvas,
+        left: Float,
+        right: Float,
+        trackY: Float,
+        color: Int
+    ) {
+        val span = (maxRatio - minRatio).coerceAtLeast(0.001f)
+        val pxSpan = (right - left).coerceAtLeast(1f)
+        val step = niceStep(span / (pxSpan / dp(10f)))
+        var value = ceil(minRatio / step) * step
+        tickPaint.color = color
+        tickPaint.strokeWidth = dp(1f)
+        var guard = 0
+        while (value <= maxRatio + 0.0001f && guard < 200) {
+            val x = valueToX(value)
+            val major = abs(value - value.roundToInt()) < 0.001f
+            val height = dp(if (major) 6f else 3.5f)
+            canvas.drawLine(x, trackY - height, x, trackY + height, tickPaint)
+            value += step
+            guard++
+        }
+    }
+
+    private fun drawCurrentBubble(canvas: Canvas, currentX: Float) {
+        val bubbleAlpha = ((expansion - 0.45f) / 0.55f).coerceIn(0f, 1f)
+        if (bubbleAlpha <= 0.001f) return
+        val label = formatRatio(currentRatio)
+        textPaint.typeface = Typeface.create("sans-serif-medium", Typeface.BOLD)
+        textPaint.textSize = dp(12f)
+        textPaint.alpha = 255
+        val bubbleWidth = max(dp(46f), textPaint.measureText(label) + dp(16f))
+        val bubbleHeight = dp(BUBBLE_HEIGHT_DP)
+        val halfWidth = bubbleWidth / 2f
+        val centerX = currentX.coerceIn(halfWidth + dp(2f), width - halfWidth - dp(2f))
+        val top = dp(1f)
+        canvas.saveLayerAlpha(
+            0f,
+            0f,
+            width.toFloat(),
+            bubbleHeight + dp(2f),
+            (255 * bubbleAlpha).toInt()
+        )
+        rect.set(centerX - halfWidth, top, centerX + halfWidth, top + bubbleHeight)
+        bubblePaint.color = accentColor()
+        canvas.drawRoundRect(rect, dp(14f), dp(14f), bubblePaint)
+        textPaint.color = Color.WHITE
+        textPaint.typeface = Typeface.create("sans-serif-medium", Typeface.BOLD)
+        val baseline = (top + bubbleHeight - (textPaint.ascent() + textPaint.descent())) / 2f
+        canvas.drawText(label, centerX, baseline, textPaint)
+        canvas.restore()
+    }
+
+    private fun drawGlass(
+        canvas: Canvas,
+        drawable: BlurredBackgroundDrawable?,
+        left: Float,
+        top: Float,
+        right: Float,
+        bottom: Float
+    ) {
+        if (drawable != null) {
+            drawable.alpha = 255
+            drawable.setBounds(
+                left.roundToInt(),
+                top.roundToInt(),
+                right.roundToInt(),
+                bottom.roundToInt()
+            )
+            drawable.draw(canvas)
+        }
+    }
+
+    private fun updateColors() {
+        fallbackPaint.color = 0x66000000
+        fallbackStroke.color = 0x33FFFFFF
+    }
+
+    private fun textColor(): Int {
+        return Color.WHITE
+    }
+
+    private fun accentColor(): Int {
+        val color = Theme.getColor(Theme.key_chat_messagePanelVoiceBackground)
+        return if (color == 0) 0xFF3390EC.toInt() else color
+    }
+
+    private fun positionUnderAnchor() {
+        val anchor = anchor ?: return
+        val params = layoutParams as? FrameLayout.LayoutParams ?: return
+        val top = (anchor.top + anchor.height - anchorBottomInset + dp(6f)).roundToInt()
+        if (params.topMargin != top) {
+            params.topMargin = top
+            requestLayout()
+        }
+    }
+
+    override fun onAttachedToWindow() {
+        super.onAttachedToWindow()
+        anchor?.addOnLayoutChangeListener(anchorLayoutListener)
+        positionUnderAnchor()
+    }
+
+    override fun onDetachedFromWindow() {
+        removeCallbacks(longPressRunnable)
+        removeCallbacks(autoCollapseRunnable)
+        expansionAnimator?.cancel()
+        anchor?.removeOnLayoutChangeListener(anchorLayoutListener)
+        super.onDetachedFromWindow()
+    }
+
+    private fun dp(value: Float): Float = value * density
+}
diff --git a/TMessagesProj/src/main/java/tele/helpers/RoundZoomLenses.kt b/TMessagesProj/src/main/java/tele/helpers/RoundZoomLenses.kt
new file mode 100644
index 000000000..1fba58e7a
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/RoundZoomLenses.kt
@@ -0,0 +1,197 @@
+package tele.helpers
+
+import android.content.Context
+import android.hardware.camera2.CameraCharacteristics
+import android.hardware.camera2.CameraManager
+import android.os.Build
+import android.util.SizeF
+import org.telegram.messenger.ApplicationLoader
+import kotlin.math.abs
+import kotlin.math.hypot
+
+/**
+ * Maps the lenses a Camera2 logical camera can actually reach onto zoom-ratio stops.
+ *
+ * Focal lengths are compared as equivalent focal lengths (focal / sensor diagonal), otherwise a
+ * smaller ultra-wide sensor looks like a longer lens and every ratio is wrong.
+ */
+object RoundZoomLenses {
+
+    /** One selectable ratio and the physical camera behind it, when the device names it. */
+    data class LensRoute(val ratio: Float, val physicalId: String? = null)
+
+    private const val RANGE_EPSILON = 0.02f
+    private const val DUPLICATE_RATIO = 0.015f
+
+    private val routeCache = HashMap<String, List<LensRoute>>()
+
+    @JvmStatic
+    fun rearLensStops(cameraId: String?, maxRatio: Float, minRatio: Float): FloatArray {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.R) return FloatArray(0)
+        if (maxRatio <= 1.001f && minRatio >= 0.999f) return FloatArray(0)
+        val routes = routesFor(cameraId, maxRatio, minRatio)
+        if (routes.size < 2) return FloatArray(0)
+        return routes.map { it.ratio }.sorted().toFloatArray()
+    }
+
+    /** Number of distinct lenses the logical camera exposes; used to pick the richest rear camera. */
+    @JvmStatic
+    fun lensCoverage(cameraId: String?): Int {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.R || cameraId == null) return 0
+        return routesFor(cameraId, Float.MAX_VALUE, 0f).size
+    }
+
+    /** Best accessible rear logical camera, preferring one that reaches the most lenses. */
+    @JvmStatic
+    fun bestRearCameraId(preferredId: String?): String? {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.R) return preferredId
+        val manager = cameraManager() ?: return preferredId
+        val ids = try {
+            manager.cameraIdList
+        } catch (_: Throwable) {
+            return preferredId
+        }
+        if (preferredId != null && ids.contains(preferredId)) {
+            return preferredId
+        }
+        var bestId: String? = null
+        var bestCoverage = -1
+        var bestFlash = false
+        for (id in ids) {
+            try {
+                val characteristics = manager.getCameraCharacteristics(id)
+                if (characteristics.get(CameraCharacteristics.LENS_FACING)
+                    != CameraCharacteristics.LENS_FACING_BACK
+                ) continue
+                val coverage = lensCoverage(id)
+                val flash = characteristics.get(CameraCharacteristics.FLASH_INFO_AVAILABLE) == true
+                if (coverage > bestCoverage || (coverage == bestCoverage && flash && !bestFlash)) {
+                    bestId = id
+                    bestCoverage = coverage
+                    bestFlash = flash
+                }
+            } catch (_: Throwable) {
+            }
+        }
+        return bestId ?: preferredId
+    }
+
+    @JvmStatic
+    fun routesFor(cameraId: String?, maxRatio: Float, minRatio: Float): List<LensRoute> {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.R) return emptyList()
+        val id = cameraId ?: bestRearCameraId(null) ?: return emptyList()
+        val key = "$id|$minRatio|$maxRatio"
+        synchronized(routeCache) {
+            routeCache[key]?.let { return it }
+        }
+        val routes = computeRoutes(id, maxRatio, minRatio)
+        synchronized(routeCache) {
+            routeCache[key] = routes
+        }
+        return routes
+    }
+
+    private fun computeRoutes(cameraId: String, maxRatio: Float, minRatio: Float): List<LensRoute> {
+        val manager = cameraManager() ?: return emptyList()
+        val id = cameraId
+        return try {
+            val characteristics = manager.getCameraCharacteristics(id) ?: return emptyList()
+            if (characteristics.get(CameraCharacteristics.LENS_FACING)
+                != CameraCharacteristics.LENS_FACING_BACK
+            ) return emptyList()
+            val range = characteristics.get(CameraCharacteristics.CONTROL_ZOOM_RATIO_RANGE)
+                ?: return emptyList()
+            val lower = maxOf(range.lower, minRatio)
+            val upper = minOf(range.upper, maxRatio)
+            if (upper <= lower) return emptyList()
+
+            val reference = referenceEquivalentFocus(manager, characteristics)
+                ?: return emptyList()
+
+            val factors = ArrayList<LensRoute>()
+            fun add(focal: Float, sensor: SizeF?, physicalId: String?) {
+                if (focal <= 0f || sensor == null) return
+                val diagonal = hypot(sensor.width, sensor.height)
+                if (diagonal <= 0f) return
+                val equivalent = focal / diagonal
+                if (equivalent <= 0f) return
+                var factor = equivalent / reference
+                if (factor < lower - RANGE_EPSILON || factor > upper + RANGE_EPSILON) return
+                factor = factor.coerceIn(lower, upper)
+                if (abs(factor - 1f) < 0.005f) factor = 1f
+                for (existing in factors) {
+                    if (abs(existing.ratio - factor) <= DUPLICATE_RATIO) return
+                }
+                factors.add(LensRoute(factor, physicalId))
+            }
+
+            val physicalIds = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
+                characteristics.physicalCameraIds
+            } else {
+                emptySet()
+            }
+            for (physicalId in physicalIds) {
+                try {
+                    val physical = manager.getCameraCharacteristics(physicalId) ?: continue
+                    val sensor = physicalSize(physical)
+                    physical.get(CameraCharacteristics.LENS_INFO_AVAILABLE_FOCAL_LENGTHS)
+                        ?.forEach { add(it, sensor, physicalId) }
+                } catch (_: Throwable) {
+                }
+            }
+            if (factors.size < 2) emptyList() else factors.sortedBy { it.ratio }
+        } catch (_: Throwable) {
+            emptyList()
+        }
+    }
+
+    /**
+     * Equivalent focus of the main (largest-sensor) lens; the logical camera's own focal list is
+     * only a fallback because its sensor size describes the wide lens, not every listed focal.
+     */
+    private fun referenceEquivalentFocus(
+        manager: CameraManager,
+        characteristics: CameraCharacteristics
+    ): Float? {
+        val physicalIds = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
+            characteristics.physicalCameraIds
+        } else {
+            emptySet()
+        }
+        var best: Pair<Float, Float>? = null
+        for (physicalId in physicalIds) {
+            try {
+                val physical = manager.getCameraCharacteristics(physicalId) ?: continue
+                val sensor = physicalSize(physical) ?: continue
+                val focal = physical.get(CameraCharacteristics.LENS_INFO_AVAILABLE_FOCAL_LENGTHS)
+                    ?.firstOrNull() ?: continue
+                if (focal <= 0f) continue
+                val diagonal = hypot(sensor.width, sensor.height)
+                if (diagonal <= 0f) continue
+                if (best == null || diagonal > best.second) {
+                    best = (focal / diagonal) to diagonal
+                }
+            } catch (_: Throwable) {
+            }
+        }
+        if (best != null) return best.first
+        val logicalSensor = physicalSize(characteristics) ?: return null
+        val logicalFocal = characteristics.get(
+            CameraCharacteristics.LENS_INFO_AVAILABLE_FOCAL_LENGTHS
+        )?.firstOrNull() ?: return null
+        if (logicalFocal <= 0f) return null
+        val diagonal = hypot(logicalSensor.width, logicalSensor.height)
+        return if (diagonal > 0f) logicalFocal / diagonal else null
+    }
+
+    private fun physicalSize(characteristics: CameraCharacteristics): SizeF? {
+        val size = characteristics.get(CameraCharacteristics.SENSOR_INFO_PHYSICAL_SIZE)
+            ?: return null
+        return if (size.width > 0f && size.height > 0f) size else null
+    }
+
+    private fun cameraManager(): CameraManager? {
+        val context = ApplicationLoader.applicationContext ?: return null
+        return context.getSystemService(Context.CAMERA_SERVICE) as? CameraManager
+    }
+}
