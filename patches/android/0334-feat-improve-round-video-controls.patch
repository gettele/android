+import kotlin.math.min
+import kotlin.math.roundToInt
+
+/**
+ * Round-video zoom: lens stops for the rear camera when Camera2 exposes a reliable zoom-ratio
+ * range for its physical lenses, a continuous rail everywhere else. The view is a glass pill that
+ * expands under a long press; dragging it changes the zoom and ticks at the lens stops.
+ */
+class RoundZoomView(context: Context, private val host: Host) : View(context) {
+
+    interface Host {
+        fun isFrontCamera(): Boolean
+        fun supportsLensStops(): Boolean
+        fun rearCameraId(): String?
+        fun maxZoomRatio(): Float
+        fun currentZoomRatio(): Float
+        fun applyZoomRatio(ratio: Float)
+        fun isZoomAvailable(): Boolean
+    }
+
+    companion object {
+        private const val COLLAPSED_DP = 50
+        private const val EXPANDED_DP = 168
+        private const val HEIGHT_DP = 38
+        private const val MIN_STOP_GAP = 1.12f
+
+        @JvmStatic
+        fun attach(parent: FrameLayout, host: Host): RoundZoomView {
+            val view = RoundZoomView(parent.context, host)
+            val params = FrameLayout.LayoutParams(
+                AndroidUtilities.dp(COLLAPSED_DP.toFloat()),
+                AndroidUtilities.dp(HEIGHT_DP.toFloat()),
+                Gravity.END or Gravity.BOTTOM
+            )
+            params.marginEnd = AndroidUtilities.dp(10f)
+            params.bottomMargin = AndroidUtilities.dp(10f)
+            parent.addView(view, params)
+            return view
+        }
+
+        @JvmStatic
+        fun rearLensStops(maxRatio: Float, preferredId: String?): FloatArray {
+            if (Build.VERSION.SDK_INT < Build.VERSION_CODES.R || maxRatio <= 1.01f) {
+                return FloatArray(0)
+            }
+            return try {
+                val context = ApplicationLoader.applicationContext ?: return FloatArray(0)
+                val manager = context.getSystemService(Context.CAMERA_SERVICE) as? CameraManager
+                    ?: return FloatArray(0)
+                var id = preferredId
+                if (id == null) {
+                    var fallback: String? = null
+                    var withFlash: String? = null
+                    for (candidateId in manager.cameraIdList) {
+                        val candidate = manager.getCameraCharacteristics(candidateId) ?: continue
+                        if (candidate.get(CameraCharacteristics.LENS_FACING)
+                            != CameraCharacteristics.LENS_FACING_BACK
+                        ) continue
+                        if (fallback == null) fallback = candidateId
+                        if (withFlash == null
+                            && candidate.get(CameraCharacteristics.FLASH_INFO_AVAILABLE) == true
+                        ) withFlash = candidateId
+                    }
+                    id = withFlash ?: fallback ?: return FloatArray(0)
+                }
+                val characteristics = manager.getCameraCharacteristics(id) ?: return FloatArray(0)
+                if (characteristics.get(CameraCharacteristics.LENS_FACING)
+                    != CameraCharacteristics.LENS_FACING_BACK
+                ) return FloatArray(0)
+                val range = characteristics.get(CameraCharacteristics.CONTROL_ZOOM_RATIO_RANGE)
+                    ?: return FloatArray(0)
+                val physical = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
+                    characteristics.physicalCameraIds
+                } else {
+                    emptySet()
+                }
+                if (physical.isEmpty()) return FloatArray(0)
+                val reference = characteristics
+                    .get(CameraCharacteristics.LENS_INFO_AVAILABLE_FOCAL_LENGTHS)
+                    ?.firstOrNull() ?: return FloatArray(0)
+                if (reference <= 0f) return FloatArray(0)
+                val factors = ArrayList<Float>()
+                fun add(focal: Float) {
+                    if (focal <= 0f) return
+                    val factor = focal / reference
+                    if (factor < 0.4f || factor > maxRatio + 0.001f) return
+                    if (factor < range.lower - 0.001f || factor > range.upper + 0.001f) return
+                    for (existing in factors) {
+                        if (abs(existing - factor) < 0.08f) return
+                    }
+                    factors.add(factor)
+                }
+                add(reference)
+                for (physicalId in physical) {
+                    val physicalCharacteristics =
+                        manager.getCameraCharacteristics(physicalId) ?: continue
+                    physicalCharacteristics
+                        .get(CameraCharacteristics.LENS_INFO_AVAILABLE_FOCAL_LENGTHS)
+                        ?.forEach { add(it) }
+                }
+                factors.sort()
+                if (factors.size < 2) return FloatArray(0)
+                val separated = ArrayList<Float>(factors.size)
+                for (factor in factors) {
+                    if (separated.isEmpty()
+                        || factor / separated[separated.size - 1] >= MIN_STOP_GAP
+                    ) {
+                        separated.add(factor)
+                    }
+                }
+                if (separated.size < 2) FloatArray(0) else separated.toFloatArray()
+            } catch (_: Throwable) {
+                FloatArray(0)
+            }
+        }
+
+        @JvmStatic
+        fun formatRatio(ratio: Float): String {
+            val rounded = ratio.roundToInt()
+            return if (abs(ratio - rounded) < 0.08f) {
+                "${rounded}×"
+            } else {
+                String.format(Locale.US, "%.1f×", ratio)
+            }
+        }
+    }
+
+    private val density = resources.displayMetrics.density
+    private val touchSlop = ViewConfiguration.get(context).scaledTouchSlop
+    private val labelPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        color = textColor()
+        textAlign = Paint.Align.CENTER
+        typeface = Typeface.create("sans-serif-medium", Typeface.NORMAL)
+    }
+    private val trackPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        strokeCap = Paint.Cap.ROUND
+        color = 0x55FFFFFF
+    }
+    private val fillPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        strokeCap = Paint.Cap.ROUND
+        color = 0xFFFFFFFF.toInt()
+    }
+    private val tickPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+        strokeCap = Paint.Cap.ROUND
+        color = 0x99FFFFFF.toInt()
+    }
+    private val rail = RectF()
+    private val fallbackBackground = GradientDrawable()
+
+    private var available = false
+    private var hostOpen = false
+    private var expanded = false
+    private var expansion = 0f
+    private var expansionAnimator: ValueAnimator? = null
+    private var front = true
+    private var minRatio = 1f
+    private var maxRatio = 1f
+    private var stops = FloatArray(0)
+    private var currentRatio = 1f
+    private var pressed = false
+    private var dragging = false
+    private var dragFromCollapsed = false
+    private var longPressFired = false
+    private var downX = 0f
+    private var downY = 0f
+    private var dragStartX = 0f
+    private var dragStartRatio = 1f
+    private var lastHapticStop = -1
+
+    private val collapseRunnable = Runnable { setExpanded(false) }
+    private val longPressRunnable = Runnable {
+        if (!pressed || dragging) return@Runnable
+        longPressFired = true
+        dragging = true
+        dragStartX = downX
+        dragStartRatio = currentRatio
+        setExpanded(true)
+        haptic(HapticFeedbackConstants.LONG_PRESS)
+    }
+
+    init {
+        isClickable = true
+        isFocusable = false
+        visibility = INVISIBLE
+        updateFallbackBackground()
+    }
+
+    private fun textColor(): Int = if (Theme.isCurrentThemeDark()) Color.WHITE else Color.BLACK
+
+    private fun updateFallbackBackground() {
+        val dark = Theme.isCurrentThemeDark()
+        fallbackBackground.shape = GradientDrawable.RECTANGLE
+        fallbackBackground.cornerRadius = AndroidUtilities.dp(HEIGHT_DP / 2f).toFloat()
+        fallbackBackground.setColor(if (dark) 0x66000000 else 0x66FFFFFF)
+        fallbackBackground.setStroke(AndroidUtilities.dp(0.66f), if (dark) 0x33FFFFFF else 0x33000000)
+    }
+
+    fun setGlassBackground(
+        factory: BlurredBackgroundDrawableViewFactory?,
+        provider: BlurredBackgroundColorProvider?
+    ) {
+        if (factory == null) {
+            background = fallbackBackground
+            return
+        }
+        val drawable = factory.create(this, provider)
+        drawable.setPadding(AndroidUtilities.dp(6f))
+        drawable.setRadius(AndroidUtilities.dp(HEIGHT_DP / 2f).toFloat())
+        background = drawable
+    }
+
+    fun setHostOpen(open: Boolean) {
+        hostOpen = open
+        applyAlpha(animate = open)
+    }
+
+    fun refresh() {
+        val wantAvailable = TeleConfig.ROUND_ZOOM.value && host.isZoomAvailable()
+        val wasAvailable = available
+        available = wantAvailable
+        if (!available) {
+            if (wasAvailable) setExpanded(false)
+            applyAlpha(animate = false)
+            return
+        }
+        val newFront = host.isFrontCamera()
+        val newMax = host.maxZoomRatio().coerceAtLeast(1f)
+        val newStops = if (newFront || !host.supportsLensStops()) {
+            FloatArray(0)
+        } else {
+            rearLensStops(newMax, host.rearCameraId())
+        }
+        val newMin = if (newStops.isEmpty()) 1f else min(1f, newStops[0])
+        if (newFront != front || abs(newMax - maxRatio) > 0.001f
+            || !newStops.contentEquals(stops)
+        ) {
+            front = newFront
+            maxRatio = newMax
+            minRatio = newMin.coerceAtMost(newMax)
+            stops = newStops.filter { it in minRatio..maxRatio }.toFloatArray()
+            if (stops.size < 2) stops = FloatArray(0)
+            currentRatio = currentRatio.coerceIn(minRatio, maxRatio)
+            setExpanded(false)
+            applyCollapsedWidth()
+        }
+        currentRatio = host.currentZoomRatio().coerceIn(minRatio, maxRatio)
+        if (!wasAvailable) applyAlpha(animate = false)
+        invalidate()
+    }
+
+    fun syncRatio(ratio: Float) {
+        if (!available) return
+        val clamped = ratio.coerceIn(minRatio, maxRatio)
+        if (abs(clamped - currentRatio) < 0.001f) return
+        currentRatio = clamped
+        invalidate()
+    }
+
+    private fun applyAlpha(animate: Boolean) {
+        val target = if (available && hostOpen) 1f else 0f
+        animate().cancel()
+        if (animate) {
+            animate().alpha(target).setDuration(160L).start()
+        } else {
+            alpha = target
+        }
+        visibility = if (available) VISIBLE else INVISIBLE
+    }
+
+    private fun setExpanded(value: Boolean) {
+        if (expanded == value) {
+            if (value) scheduleCollapse()
+            return
+        }
+        expanded = value
+        removeCallbacks(collapseRunnable)
+        if (value) scheduleCollapse()
+        expansionAnimator?.cancel()
+        if (!value) {
+            expansion = 0f
+            applyCollapsedWidth()
+            invalidate()
+            return
+        }
+        updateViewWidth()
+        expansionAnimator = ValueAnimator.ofFloat(expansion, 1f)
+        expansionAnimator?.apply {
+            duration = 180L
+            interpolator = DecelerateInterpolator()
+            addUpdateListener { animation ->
+                expansion = animation.animatedValue as Float
+                invalidate()
+            }
+            start()
+        }
+    }
+
+    private fun collapsedWidthPx(): Int {
+        if (stops.isEmpty()) {
+            return AndroidUtilities.dp(COLLAPSED_DP.toFloat())
+        }
+        val unit = AndroidUtilities.dp(34f)
+        return (AndroidUtilities.dp(18f) + stops.size * unit)
+            .coerceIn(AndroidUtilities.dp(COLLAPSED_DP.toFloat()), AndroidUtilities.dp(210f))
+    }
+
+    private fun applyCollapsedWidth() {
+        if (expanded) return
+        layoutParams.width = collapsedWidthPx()
+        requestLayout()
+    }
+
+    private fun updateViewWidth() {
+        if (!expanded) return
+        val widthDp = if (stops.isEmpty()) {
+            EXPANDED_DP
+        } else {
+            max(EXPANDED_DP, 40 + stops.size * 44).coerceAtMost(240)
+        }
+        layoutParams.width = AndroidUtilities.dp(widthDp.toFloat())
+        requestLayout()
+    }
+
+    private fun scheduleCollapse() {
+        removeCallbacks(collapseRunnable)
+        if (expanded && !pressed) postDelayed(collapseRunnable, 1600L)
+    }
+
+    private fun haptic(constant: Int) {
+        performHapticFeedback(constant)
+    }
+
+    private fun stopsIndex(value: Float): Int {
+        var best = -1
+        var distance = Float.MAX_VALUE
+        for (i in stops.indices) {
+            val d = abs(stops[i] - value)
+            if (d < distance) {
+                distance = d
+                best = i
+            }
+        }
+        return best
+    }
+
+    private fun valueToX(value: Float): Float {
+        val start = paddingLeft + dp(16f)
+        val end = width - paddingRight - dp(16f)
+        val fraction = if (maxRatio <= minRatio) 0f else (value - minRatio) / (maxRatio - minRatio)
+        return start + (end - start) * fraction
+    }
+
+    private fun xToValue(x: Float): Float {
+        val start = paddingLeft + dp(16f)
+        val end = width - paddingRight - dp(16f)
+        if (end <= start) return minRatio
+        val fraction = ((x - start) / (end - start)).coerceIn(0f, 1f)
+        return minRatio + (maxRatio - minRatio) * fraction
+    }
+
+    private fun updateRatioFromX(x: Float) {
+        if (!available) return
+        val value = xToValue(x)
+        currentRatio = value
+        host.applyZoomRatio(value)
+        val index = stopsIndex(value)
+        if (index >= 0 && index != lastHapticStop) {
+            val distance = abs(stops[index] - value)
+            val span = (maxRatio - minRatio).coerceAtLeast(0.001f)
+            if (distance < span * 0.05f) {
+                lastHapticStop = index
+                haptic(HapticFeedbackConstants.CLOCK_TICK)
+            }
+        }
+        invalidate()
+    }
+
+    private fun updateRatioFromDrag(x: Float) {
+        if (!available) return
+        val span = (maxRatio - minRatio).coerceAtLeast(0.001f)
+        val value = (dragStartRatio + (x - dragStartX) / dp(120f) * span)
+            .coerceIn(minRatio, maxRatio)
+        currentRatio = value
+        host.applyZoomRatio(value)
+        val index = stopsIndex(value)
+        if (index >= 0 && index != lastHapticStop) {
+            val distance = abs(stops[index] - value)
+            if (distance < span * 0.05f) {
+                lastHapticStop = index
+                haptic(HapticFeedbackConstants.CLOCK_TICK)
+            }
+        }
+        invalidate()
+    }
+
+    private fun collapsedStopAt(x: Float): Int {
+        if (stops.isEmpty()) return -1
+        val cell = width.toFloat() / stops.size
+        if (cell <= 0f) return -1
+        return (x / cell).toInt().coerceIn(0, stops.size - 1)
+    }
+
+    private fun applyStop(value: Float) {
+        currentRatio = value.coerceIn(minRatio, maxRatio)
+        host.applyZoomRatio(currentRatio)
+        lastHapticStop = stopsIndex(currentRatio)
+        haptic(HapticFeedbackConstants.CLOCK_TICK)
+        invalidate()
+    }
+
+    private fun snapToStop() {
+        if (stops.isEmpty()) return
+        val index = stopsIndex(currentRatio)
+        if (index < 0) return
+        val value = stops[index]
+        if (abs(value - currentRatio) < (maxRatio - minRatio) * 0.12f) {
+            currentRatio = value
+            host.applyZoomRatio(value)
+            invalidate()
+        }
+    }
+
+    override fun onTouchEvent(event: MotionEvent): Boolean {
+        if (!available || !hostOpen || !isEnabled) return false
+        when (event.actionMasked) {
+            MotionEvent.ACTION_DOWN -> {
+                pressed = true
+                dragging = false
+                dragFromCollapsed = false
+                longPressFired = false
+                downX = event.x
+                downY = event.y
+                dragStartX = event.x
+                dragStartRatio = currentRatio
+                lastHapticStop = stopsIndex(currentRatio)
+                removeCallbacks(collapseRunnable)
+                postDelayed(longPressRunnable, ViewConfiguration.getLongPressTimeout().toLong())
+                return true
+            }
+            MotionEvent.ACTION_MOVE -> {
+                if (!pressed) return false
+                if (longPressFired) {
+                    updateRatioFromDrag(event.x)
+                } else if (!dragging
+                    && (abs(event.x - downX) > touchSlop || abs(event.y - downY) > touchSlop)
+                ) {
+                    dragging = true
+                    removeCallbacks(longPressRunnable)
+                    if (!expanded) {
+                        dragFromCollapsed = true
+                        dragStartX = downX
+                        dragStartRatio = currentRatio
+                        setExpanded(true)
+                    }
+                    if (dragFromCollapsed) {
+                        updateRatioFromDrag(event.x)
+                    } else {
+                        updateRatioFromX(event.x)
+                    }
+                } else if (dragging) {
+                    if (dragFromCollapsed) {
+                        updateRatioFromDrag(event.x)
+                    } else {
+                        updateRatioFromX(event.x)
+                    }
+                }
+                return true
+            }
+            MotionEvent.ACTION_UP -> {
+                if (!pressed) return false
+                pressed = false
+                removeCallbacks(longPressRunnable)
+                if (longPressFired) {
+                    snapToStop()
+                    setExpanded(false)
+                } else if (dragging) {
+                    if (dragFromCollapsed) {
+                        updateRatioFromDrag(event.x)
+                    } else {
+                        updateRatioFromX(event.x)
+                    }
+                    snapToStop()
+                    setExpanded(false)
+                } else if (expanded) {
+                    updateRatioFromX(event.x)
+                    snapToStop()
+                    setExpanded(false)
+                } else if (stops.isNotEmpty()) {
+                    val stop = collapsedStopAt(event.x)
+                    if (stop >= 0 && stopsIndex(currentRatio) == stop) {
+                        setExpanded(true)
+                    } else if (stop >= 0) {
+                        applyStop(stops[stop])
+                    } else {
+                        setExpanded(true)
+                    }
+                } else {
+                    setExpanded(true)
+                }
+                dragging = false
+                dragFromCollapsed = false
+                longPressFired = false
+                return true
+            }
+            MotionEvent.ACTION_CANCEL -> {
+                pressed = false
+                dragging = false
+                dragFromCollapsed = false
+                longPressFired = false
+                removeCallbacks(longPressRunnable)
+                setExpanded(false)
+                return true
+            }
+        }
+        return false
+    }
+
+    override fun onDraw(canvas: Canvas) {
+        super.onDraw(canvas)
+        if (width <= 0 || height <= 0) return
+        labelPaint.color = textColor()
+        tickPaint.color = if (Theme.isCurrentThemeDark()) 0x99FFFFFF.toInt() else 0x99000000.toInt()
+        trackPaint.color = if (Theme.isCurrentThemeDark()) 0x55FFFFFF else 0x55000000
+        fillPaint.color = textColor()
+
+        val collapsedFactor = 1f - expansion
+        val centerY = height / 2f
+        if (collapsedFactor > 0.001f) {
+            canvas.saveLayerAlpha(0f, 0f, width.toFloat(), height.toFloat(), (255 * collapsedFactor).toInt())
+            if (stops.isEmpty()) {
+                labelPaint.textSize = dp(13f)
+                labelPaint.typeface = Typeface.create("sans-serif-medium", Typeface.BOLD)
+                val y = centerY - (labelPaint.ascent() + labelPaint.descent()) / 2f
+                canvas.drawText(formatRatio(currentRatio), width / 2f, y, labelPaint)
+            } else {
+                val active = stopsIndex(currentRatio)
+                val cell = width.toFloat() / stops.size
+                for (i in stops.indices) {
+                    labelPaint.typeface = Typeface.create(
+                        "sans-serif-medium",
+                        if (i == active) Typeface.BOLD else Typeface.NORMAL
+                    )
+                    labelPaint.textSize = dp(if (i == active) 13f else 11.5f)
+                    labelPaint.alpha = if (i == active) 255 else 190
+                    val y = centerY - (labelPaint.ascent() + labelPaint.descent()) / 2f
+                    canvas.drawText(
+                        formatRatio(stops[i]),
+                        cell * (i + 0.5f),
+                        y,
+                        labelPaint
+                    )
+                }
+                labelPaint.alpha = 255
+            }
+            canvas.restore()
+        }
+        if (expansion <= 0.001f) return
+
+        canvas.saveLayerAlpha(0f, 0f, width.toFloat(), height.toFloat(), (255 * expansion).toInt())
+        val start = paddingLeft + dp(16f)
+        val end = width - paddingRight - dp(16f)
+        val trackY = height * 0.34f
+        rail.set(start, trackY - dp(1.5f), end, trackY + dp(1.5f))
+        canvas.drawRoundRect(rail, dp(2f), dp(2f), trackPaint)
+        val currentX = valueToX(currentRatio)
+        rail.set(start, trackY - dp(1.5f), max(start, currentX), trackY + dp(1.5f))
+        canvas.drawRoundRect(rail, dp(2f), dp(2f), fillPaint)
+
+        labelPaint.textSize = dp(11f)
+        if (stops.isEmpty()) {
+            tickPaint.strokeWidth = dp(2f)
+            canvas.drawCircle(currentX, trackY, dp(6f), tickPaint)
+            canvas.drawCircle(currentX, trackY, dp(4.5f), fillPaint)
+            labelPaint.typeface = Typeface.create("sans-serif-medium", Typeface.BOLD)
+            labelPaint.textSize = dp(12f)
+            val label = formatRatio(currentRatio)
+            canvas.drawText(
+                label,
+                width / 2f,
+                height * 0.8f - (labelPaint.ascent() + labelPaint.descent()) / 2f,
+                labelPaint
+            )
+        } else {
+            tickPaint.strokeWidth = dp(1.5f)
+            for (i in stops.indices) {
+                val stop = stops[i]
+                val x = valueToX(stop)
+                val active = abs(stop - currentRatio) < 0.001f
+                    || abs(stop - currentRatio) < (maxRatio - minRatio) * 0.02f
+                labelPaint.typeface = Typeface.create(
+                    "sans-serif-medium",
+                    if (active) Typeface.BOLD else Typeface.NORMAL
+                )
+                labelPaint.textSize = dp(if (active) 12f else 11f)
+                labelPaint.alpha = if (active) 255 else 190
+                canvas.drawText(
+                    formatRatio(stop),
+                    x,
+                    height * 0.82f - (labelPaint.ascent() + labelPaint.descent()) / 2f,
+                    labelPaint
+                )
+                canvas.drawLine(x, trackY - dp(5f), x, trackY + dp(5f), tickPaint)
+            }
+            labelPaint.alpha = 255
+        }
+        canvas.restore()
+    }
+
+    private fun dp(value: Float): Float = value * density
+}
