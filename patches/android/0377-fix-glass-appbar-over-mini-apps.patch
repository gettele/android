 import java.util.Locale
 import tele.helpers.TeleLowercase
 
@@ -150,10 +155,50 @@ class TeleMiniAppFragment(args: Bundle) : BaseFragment(args), MainTabsActivity.T
             }
         })
 
+        val glass = getBaseSimpleGlass()
+        glass.setViews(frame, actionBar, resourceProvider)
+        glass.setCapture { canvas, position ->
+            val web1 = container ?: return@setCapture
+            if (ViewPositionWatcher.computeRectInParent(web1, frame, captureRect)) {
+                canvas.save()
+                canvas.translate(captureRect.left, captureRect.top)
+                web1.draw(canvas)
+                canvas.restore()
+            }
+        }
+        actionBar?.setBackground(glass.createActionBarFadeDrawable(actionBar))
+        web.setWebViewScrollListener { _, dx, dy -> glassEngine.onScrolled(dx, dy) }
+        ViewCompat.setOnApplyWindowInsetsListener(frame) { view, insets -> onInsetsInternal(view, insets) }
+        applyWebTopInset()
+
         fragmentView = frame
         return frame
     }
 
+    private val captureRect = android.graphics.RectF()
+    private var webTopInset = 0
+
+    override fun isSupportEdgeToEdge(): Boolean = true
+
+    override fun onInsets(left: Int, top: Int, right: Int, bottom: Int) {
+        webTopInset = top + ActionBar.getCurrentActionBarHeight()
+        applyWebTopInset()
+        container?.reportSafeInsets(Rect(left, webTopInset, right, 0), 0)
+    }
+
+    private fun applyWebTopInset() {
+        val web = container ?: return
+        val params = web.layoutParams as? FrameLayout.LayoutParams ?: return
+        if (params.topMargin != webTopInset) {
+            params.topMargin = webTopInset
+            web.layoutParams = params
+        }
+    }
+
+    override fun getGlassSource(): GlassSourceRenderNode? = getBaseSimpleGlass().glassSource
+
+    override fun getFrostedGlassSource(): GlassSourceRenderNode? = getBaseSimpleGlass().frostedGlassSource
+
     private fun newContainer(context: Context): BotWebViewContainer {
         val web = object : BotWebViewContainer(context, resourceProvider, Theme.getColor(Theme.key_windowBackgroundWhite, resourceProvider), true) {
             override fun onTitleChanged(title: String?) {
