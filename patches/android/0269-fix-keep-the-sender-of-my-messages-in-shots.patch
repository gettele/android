From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Thu, 5 Nov 2026 05:14:37 +0300
Subject: [PATCH] fix: keep the sender of my messages in shots

---
 .../src/main/java/tele/helpers/ShotMessages.kt      | 13 ++++++++++---
 1 file changed, 10 insertions(+), 3 deletions(-)

diff --git a/TMessagesProj/src/main/java/tele/helpers/ShotMessages.kt b/TMessagesProj/src/main/java/tele/helpers/ShotMessages.kt
index b7538e180..099834df5 100644
--- a/TMessagesProj/src/main/java/tele/helpers/ShotMessages.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/ShotMessages.kt
@@ -2,6 +2,7 @@ package tele.helpers
 
 import org.telegram.messenger.LocaleController
 import org.telegram.messenger.MessageObject
+import org.telegram.messenger.UserConfig
 import org.telegram.tgnet.TLObject
 import org.telegram.tgnet.TLRPC
 import java.util.Calendar
@@ -48,7 +49,7 @@ object ShotMessages {
                 val count = skipped[original.id] ?: 0
                 if (count > 0) result.add(ShotEntry(skippedObject(account, count), null))
             }
-            val copy = copyOf(original, options)
+            val copy = copyOf(original, options, account)
             val replyTo = if (options.shows(ShotPart.REPLIES)) original.replyMessageObject else null
             val message = ShotMessageObject.create(account, copy, replyTo, options.incoming)
             if (options.hidden and ShotPart.INFO.bit != 0) message.notime = true
@@ -74,7 +75,7 @@ object ShotMessages {
         return result
     }
 
-    private fun copyOf(original: MessageObject, options: ShotOptions): TLRPC.Message {
+    private fun copyOf(original: MessageObject, options: ShotOptions, account: Int): TLRPC.Message {
         val source = original.messageOwner
         val copy = runCatching { TLObject.deepCopy(source, TLRPC.Message::TLdeserialize) }.getOrNull() ?: source
         if (copy !== source) {
@@ -93,7 +94,13 @@ object ShotMessages {
             copy.replyMessage = source.replyMessage
             copy.send_state = 0
         }
-        if (options.incoming) copy.out = false
+        if (options.incoming) {
+            copy.out = false
+            if (copy.from_id == null && original.sendAsPeer == null && copy.fwd_from == null) {
+                copy.from_id = TLRPC.TL_peerUser().apply { user_id = UserConfig.getInstance(account).getClientUserId() }
+                copy.flags = copy.flags or 1
+            }
+        }
         if (!options.shows(ShotPart.REPLIES)) {
             copy.reply_to = null
             copy.replyMessage = null
