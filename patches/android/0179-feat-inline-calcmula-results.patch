@@ -166,6 +187,89 @@ class CalcmulaPreview private constructor(
         showSuggestion(result.suggestion?.takeIf { suggestions }, result.suggestionValue)
     }
 
+    private fun inlineAllowed(): Boolean =
+        TeleConfig.CALCMULA.value && TeleConfig.CALCMULA_INLINE_RESULT.value &&
+            enterView.visibility == VISIBLE && !enterView.isRecordingAudioVideo
+
+    private fun triggerInline(s: Editable, at: Int) {
+        if (!inlineAllowed()) return
+        val text = s.toString()
+        // the whole message is a calculation already
+        if (text.startsWith("= ") || (at < text.length && text[at] != '\n')) return
+        var start = at - 1
+        while (start > 0 && !Character.isWhitespace(text[start - 1])) start--
+        val token = text.substring(start, at - 1)
+        if (!evaluable(token) || inCode(s, start, at)) return
+        inlineAnchor = at
+        inlineText = text
+        inlineToken = token
+        inlineId++
+        // the cursor settles after the change, so even a cached result waits a tick
+        AndroidUtilities.runOnUIThread(inlineRequest, if (Calcmula.cached(token)?.value != null) 0 else INLINE_DELAY)
+    }
+
+    private fun requestInline() {
+        val id = inlineId
+        if (inlineAnchor < 0 || !inlineAllowed()) {
+            dismissInline()
+            return
+        }
+        Calcmula.compute(inlineToken) { result ->
+            if (id == inlineId && isAttachedToWindow) applyInline(result)
+        }
+    }
+
+    private fun applyInline(result: Calcmula.Result) {
+        val value = result.value?.replace('\n', ' ')?.trim().orEmpty()
+        if (value.isEmpty() || value == inlineToken || !inlineAllowed() || !inlineValid()) {
+            dismissInline()
+            return
+        }
+        inlineValue = value
+        inlineShown = true
+        showSuggestion(null)
+        mainRow.foreground = Theme.createSelectorDrawable(fragment.getThemedColor(Theme.key_listSelector), Theme.RIPPLE_MASK_ALL)
+        description.text = "$inlineToken ="
+        apply(value, State.VALUE)
+    }
+
+    private fun inlineValid(): Boolean {
+        val field = enterView.editField ?: return false
+        return inlineAnchor >= 0 && field.selectionStart == inlineAnchor && field.selectionEnd == inlineAnchor &&
+            field.text?.toString() == inlineText
+    }
+
+    private fun insertInline() {
+        val field = enterView.editField
+        val value = inlineValue
+        val at = inlineAnchor
+        val valid = inlineValid()
+        dismissInline()
+        if (!valid || field == null || value.isEmpty()) return
+        field.text?.insert(at, value)
+        field.setSelection(at + value.length)
+    }
+
+    private fun dismissInline() {
+        AndroidUtilities.cancelRunOnUIThread(inlineRequest)
+        inlineId++
+        inlineAnchor = -1
+        if (inlineShown) {
+            inlineShown = false
+            mainRow.foreground = null
+            show(false)
+        }
+    }
+
+    // called by the chat when the cursor or the selection moves
+    fun onSelectionChanged() {
+        if (inlineAnchor < 0) return
+        // the cursor of a typed character settles right after the change
+        AndroidUtilities.runOnUIThread {
+            if (inlineAnchor >= 0 && !inlineValid()) dismissInline()
+        }
+    }
+
     private fun suggestionShown(): Boolean = suggestionRow.visibility == VISIBLE
 
     private fun showSuggestion(expression: String?, value: String? = null) {
@@ -200,6 +304,7 @@ class CalcmulaPreview private constructor(
     }
 
     private fun cancel() {
