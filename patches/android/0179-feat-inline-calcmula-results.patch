         AndroidUtilities.cancelRunOnUIThread(debounce)
         requestId++
         currentQuery = ""
@@ -219,11 +324,41 @@ class CalcmulaPreview private constructor(
     companion object {
         @JvmStatic
         fun attach(fragment: ChatActivity, content: ViewGroup, enterView: ChatActivityEnterView, below: View?): CalcmulaPreview? {
-            if (!TeleConfig.CALCMULA.value || !TeleConfig.CALCMULA_PREVIEW.value) return null
+            if (!TeleConfig.CALCMULA.value || !(TeleConfig.CALCMULA_PREVIEW.value || TeleConfig.CALCMULA_INLINE_RESULT.value)) return null
             val view = CalcmulaPreview(content.context, fragment, enterView)
             val index = below?.let { content.indexOfChild(it) } ?: -1
             content.addView(view, index, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT.toFloat(), Gravity.BOTTOM or Gravity.LEFT, 10f, 0f, 10f, 0f))
             return view
         }
+
+        private const val INLINE_DELAY = 250L
+        private const val MAX_TOKEN = 100
+        private const val OPERATORS = "+-*/^%()!\u00D7\u00F7\u2212"
+
+        private fun plainNumber(token: String): Boolean {
+            val from = if (token.isNotEmpty() && (token[0] == '-' || token[0] == '+')) 1 else 0
+            for (i in from until token.length) {
+                val ch = token[i]
+                if (!Character.isDigit(ch) && ch != '.' && ch != ',') return false
+            }
+            return true
+        }
+
+        // a calculation has a word or number and an operator, a bare number or a link is not one
+        private fun evaluable(token: String): Boolean {
+            if (token.isEmpty() || token.length > MAX_TOKEN || token.contains("://") || plainNumber(token)) return false
+            var word = false
+            var operation = false
+            for (ch in token) {
+                if (ch == '=' || ch == '@' || ch == '\uFFFC') return false
+                if (Character.isLetterOrDigit(ch)) word = true else if (OPERATORS.indexOf(ch) >= 0) operation = true
+            }
+            return word && operation
+        }
+
+        private fun inCode(text: Editable, from: Int, till: Int): Boolean {
+            val mask = TextStyleSpan.FLAG_STYLE_MONO or TextStyleSpan.FLAG_STYLE_CODE
+            return text.getSpans(from, till, TextStyleSpan::class.java).any { it.styleFlags and mask != 0 }
+        }
     }
 }
