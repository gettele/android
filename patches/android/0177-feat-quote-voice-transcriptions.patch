         }
-        val credit = if (replying.id != mo.id) senderName(activity, mo) else null
-        if (!append(activity, enter, quoteBody(activity, enter, quote), credit)) {
+        val sameTarget = replying != null && replying.id == mo.id
+        val credit = if (active && !sameTarget) senderName(activity, mo) else null
+        if (!append(activity, enter, body, credit)) {
             return true
         }
+        if (!active) {
+            // the reply moves to the quoted message, later quotes then append
+            activity.showFieldPanelForReply(mo)
+            activity.tele_quoteReplyId = mo.id
+        }
         if (activity.actionBar != null && activity.actionBar.isActionModeShowed) {
             activity.clearSelectionMode()
         }
@@ -49,6 +81,23 @@ object MultiQuote {
         return true
     }
 
+    private fun transcriptionBody(activity: ChatActivity, text: CharSequence?): CharSequence? {
+        var plain = text?.toString() ?: return null
+        val max = MessagesController.getInstance(activity.currentAccount).quoteLengthMax
+        if (plain.length > max) {
+            plain = plain.substring(0, max)
+        }
+        // a selection can cut a surrogate pair at its edges
+        if (plain.isNotEmpty() && Character.isLowSurrogate(plain[0])) {
+            plain = plain.substring(1)
+        }
+        if (plain.isNotEmpty() && Character.isHighSurrogate(plain[plain.length - 1])) {
+            plain = plain.substring(0, plain.length - 1)
+        }
+        plain = plain.trim()
+        return if (plain.isEmpty()) null else plain
+    }
+
