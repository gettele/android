 import tele.TeleConfig
 
 // A reply keeps one server quote; more quotes go into the field as blockquotes (desktop 0210, 0211)
 object MultiQuote {
 
+    /** Transcription text is not part of the message, so it can only be quoted into the field. */
+    @JvmStatic
+    fun canQuoteTranscription(activity: ChatActivity?, enter: ChatActivityEnterView?, mo: MessageObject?): Boolean {
+        if (!TeleConfig.MULTI_QUOTE.value || activity == null || enter == null || mo == null) {
+            return false
+        }
+        val owner = mo.messageOwner ?: return false
+        return enter.visibility == View.VISIBLE &&
+            activity.editingMessageObject == null &&
+            mo.isVoiceTranscriptionOpen &&
+            owner.voiceTranscriptionFinal &&
+            !owner.voiceTranscription.isNullOrEmpty() &&
+            !TranscribeButton.isTranscribing(mo)
+    }
+
     /** True when the quote was handled here; false leaves the stock reply-with-quote path. */
     @JvmStatic
     fun onQuote(activity: ChatActivity?, enter: ChatActivityEnterView?, mo: MessageObject?, start: Int, end: Int, text: CharSequence?): Boolean {
@@ -31,17 +47,33 @@ object MultiQuote {
             return false
         }
         val replying = enter.replyingMessageObject
-        if (replying == null || activity.replyQuote == null) {
-            return false
-        }
-        val quote = ChatActivity.ReplyQuote.from(mo, start, end)
-        if (quote?.text == null) {
-            return false
+        val active = replying != null && (activity.replyQuote != null || activity.tele_quoteReplyId == replying.id)
+        val body: CharSequence
+        if (mo.isVoiceTranscriptionOpen) {
+            if (!canQuoteTranscription(activity, enter, mo)) {
+                return true
+            }
+            body = transcriptionBody(activity, text) ?: return true
+        } else {
