+package tele.ui.settings
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.PorterDuff
+import android.graphics.PorterDuffColorFilter
+import android.graphics.drawable.Drawable
+import android.text.TextUtils
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.View
+import android.widget.FrameLayout
+import android.widget.LinearLayout
+import android.widget.TextView
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.R
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Components.LayoutHelper
+import org.telegram.ui.Components.Switch
+
+/**
+ * The row of a parent toggle: the title, the description, the counter of the enabled children and the arrow.
+ *
+ * The stock cell draws the counter over the title and the switch, here the counter stands in its own
+ * column before the switch, so a long title never covers it.
+ */
+class TeleGroupCell(context: Context) : FrameLayout(context) {
+
+    private val titleView = TextView(context)
+    private val valueView = TextView(context)
+    private val counterView = TextView(context)
+    private val arrowView = View(context)
+    private val checkBox = Switch(context)
+
+    private var needDivider = true
+
+    /** The title of the parent is tapped. */
+    var onExpand: (() -> Unit)? = null
+
+    /** The switch of the parent is tapped. */
+    var onValue: ((Boolean) -> Unit)? = null
+
+    var checked: Boolean
+        get() = checkBox.isChecked
+        set(value) {
+            checkBox.setChecked(value, false)
+        }
+
+    init {
+        titleView.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
+        titleView.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16f)
+        titleView.setMaxLines(1)
+        titleView.setSingleLine(true)
+        titleView.setGravity((if (isRtl()) Gravity.RIGHT else Gravity.LEFT) or Gravity.CENTER_VERTICAL)
+        titleView.setEllipsize(TextUtils.TruncateAt.END)
+        addView(
+            titleView,
+            LayoutHelper.createFrame(
+                LayoutHelper.WRAP_CONTENT,
+                LayoutHelper.WRAP_CONTENT.toFloat(),
+                if (isRtl()) Gravity.RIGHT else Gravity.LEFT or Gravity.TOP,
+                if (isRtl()) 130f else 21f,
+                10f,
+                if (isRtl()) 21f else 130f,
+                0f
+            )
+        )
+
+        valueView.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2))
+        valueView.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13f)
+        valueView.setMaxLines(2)
+        valueView.setEllipsize(TextUtils.TruncateAt.END)
+        valueView.setGravity((if (isRtl()) Gravity.RIGHT else Gravity.LEFT) or Gravity.TOP)
+        addView(
+            valueView,
+            LayoutHelper.createFrame(
+                LayoutHelper.MATCH_PARENT,
+                LayoutHelper.WRAP_CONTENT.toFloat(),
+                if (isRtl()) Gravity.RIGHT else Gravity.LEFT or Gravity.TOP,
+                if (isRtl()) 130f else 21f,
+                35f,
+                if (isRtl()) 21f else 130f,
+                0f
+            )
+        )
+
+        counterView.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2))
+        counterView.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15f)
+        counterView.setMaxLines(1)
+        counterView.setSingleLine(true)
+        counterView.setGravity(Gravity.CENTER)
+
+        val arrowDrawable: Drawable = context.resources.getDrawable(R.drawable.arrow_more).mutate()
+        arrowDrawable.setColorFilter(PorterDuffColorFilter(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2), PorterDuff.Mode.MULTIPLY))
+        arrowView.setBackground(arrowDrawable)
+
+        val counterBox = LinearLayout(context)
+        counterBox.orientation = LinearLayout.HORIZONTAL
+        counterBox.gravity = Gravity.CENTER_VERTICAL
+        counterBox.addView(counterView, LayoutHelper.createLinear(LayoutHelper.WRAP_CONTENT, LayoutHelper.WRAP_CONTENT, Gravity.CENTER_VERTICAL))
+        counterBox.addView(arrowView, LayoutHelper.createLinear(16, 16, Gravity.CENTER_VERTICAL))
+        counterBox.setPadding(0, 0, AndroidUtilities.dp(8f), 0)
+        addView(
+            counterBox,
+            LayoutHelper.createFrame(
+                LayoutHelper.WRAP_CONTENT,
+                LayoutHelper.WRAP_CONTENT.toFloat(),
+                Gravity.RIGHT or Gravity.TOP,
+                0f,
+                11f,
+                66f,
+                0f
+            )
+        )
+
+        checkBox.setDrawIconType(0)
+        checkBox.setColors(Theme.key_switchTrack, Theme.key_switchTrackChecked, Theme.key_windowBackgroundWhite, Theme.key_windowBackgroundWhite)
+        addView(
+            checkBox,
+            LayoutHelper.createFrame(37, 40f, Gravity.RIGHT or Gravity.CENTER_VERTICAL, 22f, 0f, 22f, 0f)
+        )
+
+        titleView.setOnClickListener { onExpand?.invoke() }
+        valueView.setOnClickListener { onExpand?.invoke() }
+        counterBox.setOnClickListener { onExpand?.invoke() }
+        arrowView.setOnClickListener { onExpand?.invoke() }
+        checkBox.setOnClickListener { onValue?.invoke(!checked) }
+    }
+
+    private fun isRtl(): Boolean = LocaleController.isRTL
+
+    fun setText(text: CharSequence, value: CharSequence?, counter: CharSequence, isChecked: Boolean, isCollapsed: Boolean, divider: Boolean) {
+        titleView.text = text
+        if (value.isNullOrEmpty()) {
+            valueView.visibility = View.GONE
+        } else {
+            valueView.visibility = View.VISIBLE
+            valueView.text = value
+        }
+        counterView.text = counter
+        counterView.visibility = if (counter.isEmpty()) View.GONE else View.VISIBLE
+        arrowView.visibility = if (counter.isEmpty()) View.GONE else View.VISIBLE
+        arrowView.animate().cancel()
+        arrowView.rotation = if (isCollapsed) 0f else 180f
+        checkBox.setChecked(isChecked, false)
+        needDivider = divider
+        setWillNotDraw(!divider)
+        invalidate()
+    }
+
+    override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
+        super.onMeasure(
+            MeasureSpec.makeMeasureSpec(MeasureSpec.getSize(widthMeasureSpec), MeasureSpec.EXACTLY),
+            MeasureSpec.makeMeasureSpec(AndroidUtilities.dp(64f), MeasureSpec.EXACTLY)
+        )
+    }
+
+    override fun onDraw(canvas: Canvas) {
+        if (needDivider) {
+            canvas.drawLine(
+                if (isRtl()) 0f else AndroidUtilities.dp(20f).toFloat(),
+                getMeasuredHeight() - 1f,
+                getMeasuredWidth() - (if (isRtl()) AndroidUtilities.dp(20f).toFloat() else 0f),
+                getMeasuredHeight() - 1f,
+                Theme.dividerPaint
+            )
+        }
+    }
+}
