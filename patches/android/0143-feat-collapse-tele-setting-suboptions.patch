@@ -311,6 +449,38 @@ class TeleSettingsActivity @JvmOverloads constructor(private val mode: String =
 
 
     companion object {
+
+        /** The parent toggles with their children: the children are shown when the group is expanded. */
+        private val GROUPS = mapOf(
+            TeleConfig.KEEP_DELETED_MESSAGES.key to listOf(
+                TeleConfig.KEEP_SELF_DELETED_MESSAGES.key,
+                TeleConfig.DELETED_MARKER.key,
+                TeleConfig.DELETED_REPLY.key
+            ),
+            TeleConfig.SHOW_PEER_ID.key to listOf(
+                TeleConfig.PEER_IDS_WITHOUT_SPACES.key,
+                TeleConfig.BOT_API_PEER_IDS.key,
+                TeleConfig.SHOW_DC.key,
+                TeleConfig.MERGE_ID_DC.key
+            ),
+            TeleConfig.QUEUE_BEHIND_MEDIA.key to listOf(
+                TeleConfig.SEND_OLDER_REPLIES.key,
+                TeleConfig.DOUBLE_ENTER_SEND.key
+            ),
+            TeleConfig.CALCMULA.key to listOf(
+                TeleConfig.CALCMULA_PREVIEW.key
+            )
+        )
+
+        init {
+            // the groups are built once: a group can't hold itself and the parents can't be nested
+            for ((parent, children) in GROUPS) {
+                check(parent !in children) { "the group $parent holds itself" }
+                for (child in children) {
+                    check(child !in GROUPS) { "the group $parent holds the group $child" }
+                }
+            }
+        }
         const val MODE_ROOT = "root"
