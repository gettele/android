+++ b/TMessagesProj/src/main/java/tele/helpers/StickerFormats.kt
@@ -0,0 +1,213 @@
+package tele.helpers
+
+import java.text.Collator
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.MediaDataController
+import org.telegram.messenger.R
+import org.telegram.messenger.Utilities
+import org.telegram.tgnet.TLRPC
+import org.telegram.ui.ActionBar.AlertDialog
+import org.telegram.ui.ActionBar.BaseFragment
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Components.AnimatedEmojiDrawable
+import org.telegram.ui.Components.ItemOptions
+import tele.TeleConfig
+
+/**
+ * Sticker and emoji formats for the set lists and the panel search. The format comes from what a document
+ * carries (mime type, attributes), nothing is downloaded, and the sets and documents are never changed.
+ */
+object StickerFormats {
+    const val ALL = 0
+    const val STATIC = 1
+    const val ANIMATED = 2
+    const val VIDEO = 3
+    const val MIXED = 4
+    const val UNKNOWN = 5
+
+    const val SORT_UPSTREAM = 0
+    const val SORT_FORMAT = 1
+    const val SORT_NAME = 2
+    const val SORT_COUNT = 3
+
+    private const val MIME_TGS = "application/x-tgsticker"
+    private const val MIME_WEBM = "video/webm"
+
+    @JvmStatic
+    fun enabled(): Boolean = TeleConfig.STICKER_FORMATS.value
+
+    @JvmStatic
+    fun documentFormat(document: TLRPC.Document?): Int {
+        if (document == null) return UNKNOWN
+        val mime = document.mime_type?.lowercase()
+        if (mime != null) {
+            if (mime == MIME_TGS) return ANIMATED
+            if (mime == MIME_WEBM) return VIDEO
+            if (mime.startsWith("image/")) return STATIC
+        }
+        val attributes = document.attributes
+        if (attributes != null) {
+            for (attribute in attributes) {
+                if (attribute is TLRPC.TL_documentAttributeVideo) return VIDEO
+            }
+        }
+        return UNKNOWN
+    }
+
+    /** The format all the known documents share, MIXED when they differ, UNKNOWN when none is known. */
+    @JvmStatic
+    fun setFormat(documents: List<TLRPC.Document>?): Int {
+        var result = UNKNOWN
+        if (documents == null) return result
+        for (document in documents) {
+            val format = documentFormat(document)
+            if (format == UNKNOWN) continue
+            if (result == UNKNOWN) result = format else if (result != format) return MIXED
+        }
+        return result
+    }
+
+    @JvmStatic
+    fun matches(filter: Int, format: Int): Boolean = filter == ALL || filter == format
+
+    /** The documents of the format; the same list when the filter is off. */
+    @JvmStatic
+    fun filterDocuments(filter: Int, documents: ArrayList<TLRPC.Document>): ArrayList<TLRPC.Document> {
+        if (filter == ALL) return documents
+        val result = ArrayList<TLRPC.Document>(documents.size)
+        for (document in documents) if (documentFormat(document) == filter) result.add(document)
+        return result
+    }
+
+    @JvmStatic
+    fun hasAny(filter: Int, lists: List<List<TLRPC.Document>>): Boolean {
+        if (filter == ALL) return lists.isNotEmpty()
+        return lists.any { list -> list.any { documentFormat(it) == filter } }
+    }
+
+    @JvmStatic
+    fun hasDocuments(filter: Int, documents: List<TLRPC.Document>): Boolean =
+        if (filter == ALL) documents.isNotEmpty() else documents.any { documentFormat(it) == filter }
+
+    /** The emoji search results of the format: the plain emoji go, they have no document. */
+    @JvmStatic
+    fun filterKeywords(
+        account: Int,
+        filter: Int,
+        results: ArrayList<MediaDataController.KeywordResult>
+    ): ArrayList<MediaDataController.KeywordResult> {
+        if (filter == ALL) return results
+        val result = ArrayList<MediaDataController.KeywordResult>(results.size)
+        for (item in results) {
+            val emoji = item.emoji ?: continue
+            if (!emoji.startsWith("animated_")) continue
+            val id = emoji.substring(9).toLongOrNull() ?: continue
+            if (documentFormat(AnimatedEmojiDrawable.findDocument(account, id)) == filter) result.add(item)
+        }
+        return result
+    }
+
+    @JvmStatic
+    fun name(format: Int): String = TeleLowercase.lc(
+        when (format) {
+            STATIC -> "Static"
+            ANIMATED -> "Animated"
+            VIDEO -> "Video"
+            MIXED -> "Mixed"
+            else -> "All"
+        }
+    )
+
+    private fun sortName(sort: Int, emoji: Boolean): String = TeleLowercase.lc(
+        when (sort) {
+            SORT_FORMAT -> "Format"
+            SORT_NAME -> "Name"
+            SORT_COUNT -> if (emoji) "Emoji count" else "Sticker count"
+            else -> "Upstream order"
+        }
+    )
+
+    @JvmStatic
+    fun formatLabel(): String = TeleLowercase.lc("Format")
+
+    @JvmStatic
+    fun sortLabel(): String = TeleLowercase.lc("Sort")
+
+    @JvmStatic
+    fun removeLabel(): String = TeleLowercase.lc("Remove all shown")
+
+    @JvmStatic
+    fun sortValue(sort: Int, emoji: Boolean): String = sortName(sort, emoji)
+
+    private fun rank(format: Int) = when (format) {
+        STATIC -> 0
+        ANIMATED -> 1
+        VIDEO -> 2
+        MIXED -> 3
+        else -> 4
+    }
+
+    /** The sets of the format in the order; a new list. */
+    @JvmStatic
+    fun view(sets: List<TLRPC.TL_messages_stickerSet>, filter: Int, sort: Int): ArrayList<TLRPC.TL_messages_stickerSet> {
+        val result = ArrayList<TLRPC.TL_messages_stickerSet>(sets.size)
+        for (set in sets) if (matches(filter, setFormat(set.documents))) result.add(set)
+        if (sort == SORT_UPSTREAM) return result
+        val collator = Collator.getInstance()
+        fun title(set: TLRPC.TL_messages_stickerSet) = (set.set?.title ?: "").lowercase()
+        val byName = Comparator<TLRPC.TL_messages_stickerSet> { a, b -> collator.compare(title(a), title(b)) }
+        val comparator = when (sort) {
+            SORT_FORMAT -> Comparator<TLRPC.TL_messages_stickerSet> { a, b -> rank(setFormat(a.documents)).compareTo(rank(setFormat(b.documents))) }.then(byName)
+            SORT_COUNT -> Comparator<TLRPC.TL_messages_stickerSet> { a, b -> (b.documents?.size ?: 0).compareTo(a.documents?.size ?: 0) }.then(byName)
+            else -> byName
+        }
+        result.sortWith(comparator)
+        return result
+    }
+
+    @JvmStatic
+    fun showFormatMenu(fragment: BaseFragment, anchor: android.view.View, current: Int, withMixed: Boolean, picked: Utilities.Callback<Int>) {
+        val options = ItemOptions.makeOptions(fragment, anchor)
+        val formats = if (withMixed) intArrayOf(ALL, STATIC, ANIMATED, VIDEO, MIXED) else intArrayOf(ALL, STATIC, ANIMATED, VIDEO)
+        for (format in formats) options.addChecked(current == format, name(format)) { picked.run(format) }
+        options.show()
+    }
+
+    @JvmStatic
+    fun showSortMenu(fragment: BaseFragment, anchor: android.view.View, current: Int, emoji: Boolean, picked: Utilities.Callback<Int>) {
+        val options = ItemOptions.makeOptions(fragment, anchor)
+        for (sort in intArrayOf(SORT_UPSTREAM, SORT_FORMAT, SORT_NAME, SORT_COUNT)) {
+            options.addChecked(current == sort, sortName(sort, emoji)) { picked.run(sort) }
+        }
+        options.show()
+    }
+
+    /** Archives the shown sticker sets, removes the shown emoji sets, after a confirm. */
+    @JvmStatic
+    fun confirmRemove(fragment: BaseFragment, account: Int, type: Int, sets: List<TLRPC.TL_messages_stickerSet>) {
+        val activity = fragment.parentActivity ?: return
+        val list = ArrayList<TLRPC.StickerSet>()
+        for (set in sets) set.set?.let { list.add(it) }
+        if (list.isEmpty()) return
+        val remove = type == MediaDataController.TYPE_EMOJIPACKS
+        val count = list.size
+        val builder = AlertDialog.Builder(activity)
+        val label = LocaleController.formatPluralString("StickerSets", count)
+        if (remove) {
+            builder.setTitle(LocaleController.formatString(R.string.DeleteStickerSetsAlertTitle, label))
+            builder.setMessage(LocaleController.formatString(R.string.DeleteStickersAlertMessage, count))
+        } else {
+            builder.setTitle(LocaleController.formatString(R.string.ArchiveStickerSetsAlertTitle, label))
+            builder.setMessage(LocaleController.formatString(R.string.ArchiveStickersAlertMessage, count))
+        }
+        builder.setPositiveButton(LocaleController.getString(if (remove) R.string.Delete else R.string.Archive)) { _, _ ->
+            MediaDataController.getInstance(account).toggleStickerSets(list, type, if (remove) 0 else 1, fragment, true)
+        }
+        builder.setNegativeButton(LocaleController.getString(R.string.Cancel), null)
+        val dialog = builder.create()
+        fragment.showDialog(dialog)
+        if (remove) {
+            (dialog.getButton(AlertDialog.BUTTON_POSITIVE) as? android.widget.TextView)?.setTextColor(Theme.getColor(Theme.key_text_RedBold))
+        }
+    }
+}
