+package tele.helpers
+
+import android.content.Context
+import android.graphics.PorterDuff
+import android.graphics.PorterDuffColorFilter
+import android.view.View
+import android.widget.ImageView
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.R
+import org.telegram.messenger.Utilities
+import org.telegram.ui.ActionBar.BaseFragment
+import org.telegram.ui.ActionBar.Theme
+
+/** The format filter of the panel search, next to the clear button; shown while a query is typed. */
+class StickerSearchButton(
+    context: Context,
+    private val fragment: BaseFragment?,
+    private val color: Int,
+    private val activeColor: Int,
+    // the format changed while the query stays
+    private val changed: Runnable,
+    // the button shows or hides, for the room it takes in the field
+    private val shown: Utilities.Callback<Boolean>
+) : ImageView(context) {
+
+    private var format = StickerFormats.ALL
+    private var visible = false
+
+    init {
+        scaleType = ScaleType.CENTER
+        setImageResource(R.drawable.menu_tag_filter)
+        background = Theme.createSelectorDrawable(Theme.getColor(Theme.key_listSelector), Theme.RIPPLE_MASK_CIRCLE_20DP, AndroidUtilities.dp(15f))
+        contentDescription = StickerFormats.formatLabel()
+        visibility = GONE
+        applyColor()
+        setOnClickListener {
+            val owner = fragment ?: return@setOnClickListener
+            StickerFormats.showFormatMenu(owner, this, format, false) { picked ->
+                if (picked != format) {
+                    format = picked
+                    applyColor()
+                    changed.run()
+                }
+            }
+        }
+    }
+
+    private fun applyColor() {
+        colorFilter = PorterDuffColorFilter(if (format != StickerFormats.ALL) activeColor else color, PorterDuff.Mode.MULTIPLY)
+    }
+
+    /** The format to filter by; ALL while the option is off. */
+    fun searchFormat(): Int = if (StickerFormats.enabled() && visible) format else StickerFormats.ALL
+
+    /** Called as the query changes; leaving the search resets the format. */
+    fun sync(searching: Boolean) {
+        val show = StickerFormats.enabled() && fragment != null && searching
+        if (!show && format != StickerFormats.ALL) {
+            format = StickerFormats.ALL
+            applyColor()
+        }
+        if (show == visible) return
+        visible = show
+        visibility = if (show) VISIBLE else GONE
+        shown.run(show)
+    }
+}
