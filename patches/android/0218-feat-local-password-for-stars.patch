diff --git a/TMessagesProj/src/main/java/tele/ui/StarsLockUi.kt b/TMessagesProj/src/main/java/tele/ui/StarsLockUi.kt
new file mode 100644
index 000000000..44e6e2ab4
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/ui/StarsLockUi.kt
@@ -0,0 +1,322 @@
+package tele.ui
+
+import android.app.Activity
+import android.content.DialogInterface
+import android.graphics.Typeface
+import android.text.InputType
+import android.util.TypedValue
+import android.view.View
+import android.view.inputmethod.EditorInfo
+import android.widget.LinearLayout
+import android.widget.TextView
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.R
+import org.telegram.ui.ActionBar.AlertDialog
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Components.EditTextBoldCursor
+import tele.helpers.StarsLock
+import tele.helpers.TeleLowercase
+
+// the dialogs of the local password: the prompt, the setup and the two ways to forget it
+object StarsLockUi {
+
+    private fun lc(text: String): String = TeleLowercase.lc(text)
+
+    private fun dp(value: Float): Int = AndroidUtilities.dp(value)
+
+    private fun field(host: Activity, resources: Theme.ResourcesProvider?, hint: String, ime: Int): EditTextBoldCursor {
+        val color = { key: Int -> Theme.getColor(key, resources) }
+        val input = EditTextBoldCursor(host)
+        input.hint = hint
+        input.inputType = InputType.TYPE_CLASS_TEXT or InputType.TYPE_TEXT_VARIATION_PASSWORD
+        // the password variation switches the font to monospace
+        input.typeface = Typeface.DEFAULT
+        input.setSingleLine(true)
+        input.imeOptions = ime
+        input.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 17f)
+        input.setTextColor(color(Theme.key_dialogTextBlack))
+        input.setHintTextColor(color(Theme.key_dialogTextHint))
+        input.setBackgroundDrawable(null)
+        input.setLineColors(color(Theme.key_dialogInputField), color(Theme.key_dialogInputFieldActivated), color(Theme.key_text_RedBold))
+        input.setCursorColor(color(Theme.key_dialogTextBlack))
+        input.setCursorSize(dp(20f))
+        input.setCursorWidth(1.5f)
+        return input
+    }
+
+    private fun column(host: Activity): LinearLayout {
+        val box = LinearLayout(host)
+        box.orientation = LinearLayout.VERTICAL
+        box.setPadding(dp(24f), dp(4f), dp(24f), 0)
+        return box
+    }
+
+    private fun LinearLayout.addField(input: EditTextBoldCursor) {
+        addView(input, LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, dp(44f)))
+    }
+
+    private fun errorView(host: Activity, resources: Theme.ResourcesProvider?): TextView {
+        val view = TextView(host)
+        view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14f)
+        view.setTextColor(Theme.getColor(Theme.key_text_RedBold, resources))
+        view.setPadding(0, dp(8f), 0, 0)
+        view.visibility = View.GONE
+        return view
+    }
+
+    private fun TextView.fail(text: String) {
+        this.text = lc(text)
+        visibility = View.VISIBLE
+    }
+
+    private fun linkView(host: Activity, resources: Theme.ResourcesProvider?, text: String, onClick: () -> Unit): TextView {
+        val view = TextView(host)
+        view.text = lc(text)
+        view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14f)
+        view.setTextColor(Theme.getColor(Theme.key_dialogTextLink, resources))
+        view.setPadding(0, dp(12f), 0, dp(4f))
+        view.setOnClickListener { onClick() }
+        return view
+    }
+
+    private fun shake(view: View) {
+        AndroidUtilities.shakeViewSpring(view, 2.5f)
+    }
+
+    private fun focusLater(dialog: AlertDialog, input: EditTextBoldCursor) {
+        dialog.setOnShowListener {
+            AndroidUtilities.runOnUIThread({
+                input.requestFocus()
+                AndroidUtilities.showKeyboard(input)
+            }, 100)
+        }
+    }
+
+    private fun EditTextBoldCursor.onDone(action: () -> Unit) {
+        setOnEditorActionListener { _, actionId, _ ->
+            if (actionId == EditorInfo.IME_ACTION_DONE) {
+                action()
+                true
+            } else {
+                false
+            }
+        }
+    }
+
+    private fun EditTextBoldCursor.value(): String = text?.toString().orEmpty()
+
+    /** Asks for the password before an action; [StarsLock.resolve] gets the answer. */
+    fun prompt(host: Activity, resources: Theme.ResourcesProvider?, current: Int): AlertDialog {
+        val input = field(host, resources, lc("Password"), EditorInfo.IME_ACTION_DONE)
+        val error = errorView(host, resources)
+        val box = column(host)
+        box.addField(input)
+        box.addView(error)
+        box.addView(linkView(host, resources, "Forgot password?") { StarsLock.reset(host, resources) })
+
+        val builder = AlertDialog.Builder(host, resources)
+        builder.setTitle(lc("Local password"))
+        builder.setView(box)
+        builder.setPositiveButton(LocaleController.getString(R.string.Continue)) { _, _ -> }
+        builder.setNegativeButton(LocaleController.getString(R.string.Cancel), null)
+        val dialog = builder.create()
+        var checking = false
+        var closed = false
+        val submit = {
+            if (!checking) {
+                val typed = input.value()
+                if (typed.isEmpty()) {
+                    shake(input)
+                } else {
+                    checking = true
+                    StarsLock.verify(typed) { ok ->
+                        checking = false
+                        if (ok) {
+                            closed = true
+                            dialog.dismiss()
+                            StarsLock.resolve(current, true)
+                        } else {
+                            shake(input)
+                            input.setText("")
+                            error.fail("Wrong password.")
+                        }
+                    }
+                }
+            }
+        }
+        input.onDone(submit)
+        focusLater(dialog, input)
+        dialog.setOnDismissListener {
+            if (!closed) StarsLock.resolve(current, false)
+        }
+        dialog.show()
+        dialog.getButton(DialogInterface.BUTTON_POSITIVE)?.setOnClickListener { submit() }
+        return dialog
+    }
+
+    /** Sets, changes or removes the password. */
+    fun openSetup(host: Activity, resources: Theme.ResourcesProvider?) {
+        val set = StarsLock.isSet()
+        val currentInput = if (set) field(host, resources, lc("Current password"), EditorInfo.IME_ACTION_NEXT) else null
+        val password = field(host, resources, lc(if (set) "New password" else "Password"), EditorInfo.IME_ACTION_NEXT)
+        val repeat = field(host, resources, lc("Repeat password"), EditorInfo.IME_ACTION_DONE)
+        val error = errorView(host, resources)
+        val box = column(host)
+        if (currentInput != null) {
+            box.addField(currentInput)
+            box.addView(linkView(host, resources, "Forgot password?") { StarsLock.reset(host, resources) })
+        }
+        box.addField(password)
+        box.addField(repeat)
+        box.addView(error)
+
+        val builder = AlertDialog.Builder(host, resources)
+        builder.setTitle(lc("Local password"))
+        builder.setView(box)
+        builder.setPositiveButton(LocaleController.getString(R.string.Save)) { _, _ -> }
+        builder.setNegativeButton(LocaleController.getString(R.string.Cancel), null)
+        if (set) builder.setNeutralButton(lc("Remove")) { _, _ -> }
+        val dialog = builder.create()
+        var busy = false
+
+        // the current password is checked before a change or a removal
+        fun withCurrent(next: () -> Unit) {
+            if (currentInput == null) {
+                next()
+                return
+            }
+            StarsLock.verify(currentInput.value()) { ok ->
+                if (ok) {
+                    next()
+                } else {
+                    busy = false
+                    shake(currentInput)
+                    error.fail("Wrong password.")
+                }
+            }
+        }
+
+        val save = {
+            if (!busy) {
+                val value = password.value()
+                if (value.isEmpty()) {
+                    shake(password)
+                } else if (repeat.value() != value) {
+                    shake(repeat)
+                    error.fail("Passwords don't match.")
+                } else {
+                    busy = true
+                    withCurrent {
+                        StarsLock.save(value) {
+                            dialog.dismiss()
+                            StarsLock.toast("stars-lock-saved", if (set) "Local password changed." else "Local password set.")
+                        }
+                    }
+                }
+            }
+        }
+        val remove = {
+            if (!busy) {
+                busy = true
+                withCurrent {
+                    StarsLock.clear()
+                    dialog.dismiss()
+                    StarsLock.toast("stars-lock-removed", "Local password removed.")
+                }
+            }
+        }
+        currentInput?.onDone { password.requestFocus() }
+        password.onDone { repeat.requestFocus() }
+        repeat.onDone(save)
+        focusLater(dialog, currentInput ?: password)
+        dialog.show()
+        dialog.getButton(DialogInterface.BUTTON_POSITIVE)?.setOnClickListener { save() }
+        dialog.getButton(DialogInterface.BUTTON_NEUTRAL)?.setOnClickListener { remove() }
+    }
+
+    /** The account has a cloud password: it is the proof to drop the local one. */
+    fun resetWithCloud(host: Activity, resources: Theme.ResourcesProvider?, account: Int, hint: String) {
+        // the hint is the user's own text
+        val input = field(host, resources, hint.ifBlank { lc("Cloud password") }, EditorInfo.IME_ACTION_DONE)
+        val error = errorView(host, resources)
+        val box = column(host)
+        box.addField(input)
+        box.addView(error)
+
+        val builder = AlertDialog.Builder(host, resources)
+        builder.setTitle(lc("Reset local password"))
+        builder.setMessage(lc("Enter the cloud password of your Telegram account."))
+        builder.setView(box)
+        builder.setPositiveButton(lc("Reset")) { _, _ -> }
+        builder.setNegativeButton(LocaleController.getString(R.string.Cancel), null)
+        val dialog = builder.create()
+        var checking = false
+        val submit = {
+            if (!checking) {
+                val typed = input.value()
+                if (typed.isEmpty()) {
+                    shake(input)
+                } else {
+                    checking = true
+                    StarsLock.checkCloud(account, typed) { problem ->
+                        checking = false
+                        if (problem == null) {
+                            StarsLock.clear()
+                            dialog.dismiss()
+                            StarsLock.toast("stars-lock-removed", "Local password removed.")
+                        } else {
+                            shake(input)
+                            input.selectAll()
+                            error.fail(
+                                when {
+                                    problem == "PASSWORD_HASH_INVALID" -> "Wrong password."
+                                    problem.startsWith("FLOOD_WAIT") -> "Too many tries, try again later."
+                                    else -> problem
+                                }
+                            )
+                        }
+                    }
+                }
+            }
+        }
+        input.onDone(submit)
+        focusLater(dialog, input)
+        dialog.show()
+        dialog.getButton(DialogInterface.BUTTON_POSITIVE)?.setOnClickListener { submit() }
+    }
+
+    /** No cloud password to ask: the reset waits a few seconds so a stray tap can't drop the protection. */
+    fun resetWithCountdown(host: Activity, resources: Theme.ResourcesProvider?) {
+        val builder = AlertDialog.Builder(host, resources)
+        builder.setTitle(lc("Reset local password"))
+        builder.setMessage(lc("Gifts and stars stop asking for a password."))
+        builder.setPositiveButton(lc("Reset")) { _, _ -> }
+        builder.setNegativeButton(LocaleController.getString(R.string.Cancel), null)
+        val dialog = builder.create()
+        dialog.show()
+        val button = dialog.getButton(DialogInterface.BUTTON_POSITIVE)
+        var left = StarsLock.countdown()
+        val render = {
+            (button as? TextView)?.text = if (left > 0) lc("Reset ($left)") else lc("Reset")
+            button?.isEnabled = left == 0
+        }
+        val tick = object : Runnable {
+            override fun run() {
+                if (!dialog.isShowing) return
+                left--
+                render()
+                if (left > 0) AndroidUtilities.runOnUIThread(this, 1000)
+            }
+        }
+        render()
+        AndroidUtilities.runOnUIThread(tick, 1000)
+        button?.setOnClickListener {
+            if (left == 0) {
+                StarsLock.clear()
+                dialog.dismiss()
+                StarsLock.toast("stars-lock-removed", "Local password removed.")
+            }
+        }
+    }
+}
