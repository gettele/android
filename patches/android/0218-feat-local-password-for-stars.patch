@@ -0,0 +1,395 @@
+package tele.helpers
+
+import android.app.Activity
+import android.content.Context
+import android.os.Looper
+import android.os.SystemClock
+import android.util.Base64
+import androidx.biometric.BiometricManager
+import androidx.biometric.BiometricPrompt
+import androidx.core.content.ContextCompat
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.FileLog
+import org.telegram.messenger.R
+import org.telegram.messenger.SRPHelper
+import org.telegram.messenger.UserConfig
+import org.telegram.messenger.Utilities
+import org.telegram.tgnet.ConnectionsManager
+import org.telegram.tgnet.TLRPC
+import org.telegram.tgnet.tl.TL_account
+import org.telegram.ui.ActionBar.AlertDialog
+import org.telegram.ui.ActionBar.BaseFragment
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Components.BulletinFactory
+import org.telegram.ui.LaunchActivity
+import org.telegram.ui.TwoStepVerificationActivity
+import tele.BoolItem
+import tele.TeleConfig
+import tele.ui.StarsLockUi
+import java.security.MessageDigest
+import java.security.SecureRandom
+
+/**
+ * The local password of the stars and gift actions (tele 0187/0217): kept on this device, asked before
+ * Stars are spent or a gift leaves the account. Without a password nothing changes. UI thread only.
+ *
+ * Stock code wraps the spending call: [guard] runs it at once or after the unlock, [intercept] re-runs
+ * the whole method after the unlock, so the stock call stays as it was.
+ */
+object StarsLock {
+
+    const val TRANSFER = "transfer"
+    const val CONVERT = "convert"
+    const val SELL = "sell"
+    const val UPGRADE = "upgrade"
+    const val BUY = "buy"
+    const val SEND = "send_gift"
+    const val REACTIONS = "paid_reactions"
+    const val PAID_MEDIA = "paid_media"
+    const val SUBSCRIPTIONS = "subscriptions"
+
+    // the unlock holds for a minute, like the desktop client
+    private const val GRACE_MS = 60_000L
+    private const val HASH_PREFIX = "pbkdf2-sha512"
+    private const val ITERATIONS = 100_000
+    private const val SALT_SIZE = 16
+
+    /** action id -> its on/off option */
+    private val options: Map<String, BoolItem> = mapOf(
+        TRANSFER to TeleConfig.LOCAL_PASSWORD_TRANSFER,
+        CONVERT to TeleConfig.LOCAL_PASSWORD_CONVERT,
+        SELL to TeleConfig.LOCAL_PASSWORD_SELL,
+        UPGRADE to TeleConfig.LOCAL_PASSWORD_UPGRADE,
+        BUY to TeleConfig.LOCAL_PASSWORD_BUY,
+        SEND to TeleConfig.LOCAL_PASSWORD_SEND,
+        REACTIONS to TeleConfig.LOCAL_PASSWORD_REACTIONS,
+        PAID_MEDIA to TeleConfig.LOCAL_PASSWORD_PAID_MEDIA,
+        SUBSCRIPTIONS to TeleConfig.LOCAL_PASSWORD_SUBSCRIPTIONS
+    )
+
+    // the desktop names and the loose spellings of the other tasks reach the same action
+    private val aliases: Map<String, String> = HashMap<String, String>().also { map ->
+        fun add(id: String, vararg names: String) {
+            map[id.filter { it.isLetterOrDigit() }] = id
+            names.forEach { map[it] = id }
+        }
+        add(TRANSFER, "transfergift", "transfergifts")
+        add(CONVERT, "convertgift", "convertgifts", "convertstars")
+        add(SELL, "sellgift", "sellgifts", "unlist", "resell")
+        add(UPGRADE, "upgradegift", "upgradegifts")
+        add(BUY, "buygift", "buygifts", "buyresale", "resale", "auction", "bid", "offer")
+        add(SEND, "sendgift", "sendgifts", "send", "gift", "gifts")
+        add(REACTIONS, "reactions", "reaction", "paidreaction")
+        add(PAID_MEDIA, "media")
+        add(SUBSCRIPTIONS, "subscription")
+    }
+
+    private class Waiter(val done: Runnable?, val cancelled: Runnable?)
+
+    private val waiters = ArrayList<Waiter>()
+    private val listeners = ArrayList<Runnable>()
+    private var unlockedAt = 0L
+    private var asking = false
+    private var generation = 0
+    private var prompt: AlertDialog? = null
+
+    /** The action's own id, or null for a name this build doesn't know: those are protected too. */
+    private fun actionId(action: String): String? =
+        aliases[action.lowercase().filter { it.isLetterOrDigit() }]
+
+    @JvmStatic
+    fun isSet(): Boolean = TeleConfig.LOCAL_PASSWORD_HASH.value.isNotEmpty()
+
+    /** The options of the protected actions: turning one off asks for the password first. */
+    @JvmStatic
+    fun isProtectedOption(item: Any?): Boolean = item != null && options.values.any { it === item }
+
+    private fun unlocked(): Boolean = unlockedAt != 0L && SystemClock.elapsedRealtime() - unlockedAt < GRACE_MS
+
+    /** Whether the action has to ask right now. */
+    @JvmStatic
+    fun needed(action: String): Boolean {
+        if (!isSet() || unlocked()) return false
+        val id = actionId(action) ?: return true
+        return options[id]?.value != false
+    }
+
+    /** Runs [onAllowed] at once when the action needs no password, else after the unlock; nothing runs when it is cancelled. */
+    @JvmStatic
+    fun guard(fragment: BaseFragment?, action: String, onAllowed: Runnable) {
+        guard(fragment, action, onAllowed, null)
+    }
+
+    @JvmStatic
+    fun guard(fragment: BaseFragment?, action: String, onAllowed: Runnable, onCancelled: Runnable?) {
+        guard(fragment?.parentActivity, fragment?.resourceProvider, action, onAllowed, onCancelled)
+    }
+
+    @JvmStatic
+    fun guard(context: Context?, resources: Theme.ResourcesProvider?, action: String, onAllowed: Runnable) {
+        guard(context, resources, action, onAllowed, null)
+    }
+
+    @JvmStatic
+    fun guard(context: Context?, resources: Theme.ResourcesProvider?, action: String, onAllowed: Runnable, onCancelled: Runnable?) {
+        if (!needed(action)) {
+            onAllowed.run()
+            return
+        }
+        ask(context, resources, onAllowed, onCancelled)
+    }
+
+    /** For a method that starts with this call: true when it has to wait, [retry] then runs it again after the unlock. */
+    @JvmStatic
+    fun intercept(fragment: BaseFragment?, action: String, retry: Runnable, onCancelled: Runnable?): Boolean =
+        intercept(fragment?.parentActivity, fragment?.resourceProvider, action, retry, onCancelled)
+
+    @JvmStatic
+    fun intercept(context: Context?, resources: Theme.ResourcesProvider?, action: String, retry: Runnable, onCancelled: Runnable?): Boolean {
+        if (!needed(action)) return false
+        ask(context, resources, retry, onCancelled)
+        return true
+    }
+
+    /** Any change of the protection asks for the password once one is set. */
+    @JvmStatic
+    fun confirm(context: Context?, resources: Theme.ResourcesProvider?, onAllowed: Runnable) {
+        if (!isSet() || unlocked()) {
+            onAllowed.run()
+            return
+        }
+        ask(context, resources, onAllowed, null)
+    }
+
+    @JvmStatic
+    fun addListener(listener: Runnable) {
+        if (!listeners.contains(listener)) listeners.add(listener)
+    }
+
+    @JvmStatic
+    fun removeListener(listener: Runnable) {
+        listeners.remove(listener)
+    }
+
+    private fun changed() {
+        listeners.toList().forEach { it.run() }
+    }
+
+    private fun ask(context: Context?, resources: Theme.ResourcesProvider?, done: Runnable?, cancelled: Runnable?) {
+        if (Looper.myLooper() != Looper.getMainLooper()) {
+            AndroidUtilities.runOnUIThread { ask(context, resources, done, cancelled) }
+            return
+        }
+        val host = (context?.let { AndroidUtilities.findActivity(it) } ?: LaunchActivity.instance)
+        if (host == null) {
+            // no window to ask in: the action doesn't go through
+            cancelled?.run()
+            return
+        }
+        waiters.add(Waiter(done, cancelled))
+        if (asking) return
+        asking = true
+        val current = ++generation
+        if (!askBiometric(host, current, resources)) showPassword(host, resources, current)
+    }
+
+    private fun showPassword(host: Activity, resources: Theme.ResourcesProvider?, current: Int) {
+        if (!asking || current != generation) return
+        prompt = StarsLockUi.prompt(host, resources, current)
+    }
+
+    /** The unlock of the prompt [current]: the waiting actions run, or are dropped when it was cancelled. */
+    internal fun resolve(current: Int, success: Boolean) {
+        if (!asking || current != generation) return
+        asking = false
+        prompt = null
+        if (success) unlockedAt = SystemClock.elapsedRealtime()
+        val list = ArrayList(waiters)
+        waiters.clear()
+        for (waiter in list) {
+            try {
+                (if (success) waiter.done else waiter.cancelled)?.run()
+            } catch (e: Throwable) {
+                FileLog.e(e)
+            }
+        }
+    }
+
+    // ---- biometrics ----
+
+    @JvmStatic
+    fun biometricAvailable(): Boolean {
+        val activity = LaunchActivity.instance ?: return false
+        return try {
+            BiometricManager.from(activity).canAuthenticate(BiometricManager.Authenticators.BIOMETRIC_STRONG) ==
+                BiometricManager.BIOMETRIC_SUCCESS
+        } catch (e: Exception) {
+            FileLog.e(e)
+            false
+        }
+    }
+
+    /** True when the system prompt took over; the password prompt follows when the user picks it. */
+    private fun askBiometric(host: Activity, current: Int, resources: Theme.ResourcesProvider?): Boolean {
+        if (!TeleConfig.LOCAL_PASSWORD_BIOMETRIC.value || !isSet()) return false
+        val activity = LaunchActivity.instance ?: return false
+        if (activity.isFinishing || !biometricAvailable()) return false
+        return try {
+            val callback = object : BiometricPrompt.AuthenticationCallback() {
+                override fun onAuthenticationSucceeded(result: BiometricPrompt.AuthenticationResult) {
+                    resolve(current, true)
+                }
+
+                override fun onAuthenticationError(errorCode: Int, errString: CharSequence) {
+                    when (errorCode) {
+                        BiometricPrompt.ERROR_USER_CANCELED, BiometricPrompt.ERROR_CANCELED -> resolve(current, false)
+                        else -> showPassword(host, resources, current)
+                    }
+                }
+            }
+            val info = BiometricPrompt.PromptInfo.Builder()
+                .setTitle(TeleLowercase.lc("Local password"))
+                .setNegativeButtonText(TeleLowercase.lc("Use password"))
+                .setAllowedAuthenticators(BiometricManager.Authenticators.BIOMETRIC_STRONG)
+                .build()
+            BiometricPrompt(activity, ContextCompat.getMainExecutor(activity), callback).authenticate(info)
+            true
+        } catch (e: Exception) {
+            FileLog.e(e)
+            false
+        }
+    }
+
+    // ---- the password ----
+
+    private fun matches(password: ByteArray, stored: String): Boolean {
+        val parts = stored.split('$')
+        if (parts.size != 4 || parts[0] != HASH_PREFIX || parts[1].toIntOrNull() != ITERATIONS) return false
+        return try {
+            val salt = Base64.decode(parts[2], Base64.NO_WRAP)
+            val expected = Base64.decode(parts[3], Base64.NO_WRAP)
+            expected.isNotEmpty() && MessageDigest.isEqual(Utilities.computePBKDF2(password, salt), expected)
+        } catch (e: IllegalArgumentException) {
+            false
+        }
+    }
+
+    /** Checks the typed password off the UI thread; [done] runs on it. */
+    internal fun verify(password: String, done: (Boolean) -> Unit) {
+        val stored = TeleConfig.LOCAL_PASSWORD_HASH.value
+        if (password.isEmpty() || stored.isEmpty()) {
+            done(false)
+            return
+        }
+        val bytes = password.toByteArray(Charsets.UTF_8)
+        Utilities.globalQueue.postRunnable {
+            val ok = matches(bytes, stored)
+            AndroidUtilities.runOnUIThread { done(ok) }
+        }
+    }
+
+    /** Saves the new password: a fresh salt and a PBKDF2-HMAC-SHA512 hash, the same kdf Telegram uses for the cloud password. */
+    internal fun save(password: String, done: () -> Unit) {
+        val bytes = password.toByteArray(Charsets.UTF_8)
+        Utilities.globalQueue.postRunnable {
+            val salt = ByteArray(SALT_SIZE).also { SecureRandom().nextBytes(it) }
+            val hash = Utilities.computePBKDF2(bytes, salt)
+            val stored = listOf(
+                HASH_PREFIX,
+                ITERATIONS.toString(),
+                Base64.encodeToString(salt, Base64.NO_WRAP),
+                Base64.encodeToString(hash, Base64.NO_WRAP)
+            ).joinToString("$")
+            AndroidUtilities.runOnUIThread {
+                TeleConfig.set(TeleConfig.LOCAL_PASSWORD_HASH, stored)
+                // the new password is asked once before the next protected action
+                unlockedAt = 0L
+                changed()
+                done()
+            }
+        }
+    }
+
+    /** Removes the password; a prompt that is open is cancelled, the user starts the action again. */
+    internal fun clear() {
+        TeleConfig.set(TeleConfig.LOCAL_PASSWORD_HASH, "")
+        unlockedAt = 0L
+        prompt?.dismiss()
+        changed()
+    }
+
+    // ---- reset ----
+
+    private const val COUNTDOWN = 10
+
+    internal fun countdown(): Int = COUNTDOWN
+
+    /** The "forgot the password" flow: the cloud password when the account has one, else a 10 seconds wait. */
+    internal fun reset(host: Activity, resources: Theme.ResourcesProvider?) {
+        val account = UserConfig.selectedAccount
+        val progress = AlertDialog(host, AlertDialog.ALERT_TYPE_SPINNER)
+        progress.showDelayed(300)
+        ConnectionsManager.getInstance(account).sendRequest(TL_account.getPassword(), { response, error ->
+            AndroidUtilities.runOnUIThread {
+                progress.dismiss()
+                if (response is TL_account.Password) {
+                    if (response.has_password) {
+                        StarsLockUi.resetWithCloud(host, resources, account, response.hint.orEmpty())
+                    } else {
+                        StarsLockUi.resetWithCountdown(host, resources)
+                    }
+                } else {
+                    toast("stars-lock-reset-failed", error?.text ?: "Could not check the cloud password.", true)
+                }
+            }
+        }, ConnectionsManager.RequestFlagFailOnServerErrors)
+    }
+
+    /** Checks the cloud password of [account] through SRP; [done] gets null on success or the error text. */
+    internal fun checkCloud(account: Int, password: String, done: (String?) -> Unit) {
+        fun attempt(retry: Boolean) {
+            val connections = ConnectionsManager.getInstance(account)
+            connections.sendRequest(TL_account.getPassword(), { response, error ->
+                AndroidUtilities.runOnUIThread {
+                    val state = response as? TL_account.Password
+                    if (state == null) {
+                        done(error?.text ?: "REQUEST_FAILED")
+                        return@runOnUIThread
+                    }
+                    if (!TwoStepVerificationActivity.canHandleCurrentPassword(state, false)) {
+                        done("ALGO_INVALID")
+                        return@runOnUIThread
+                    }
+                    val bytes = AndroidUtilities.getStringBytes(password)
+                    Utilities.globalQueue.postRunnable {
+                        val algo = state.current_algo as? TLRPC.TL_passwordKdfAlgoSHA256SHA256PBKDF2HMACSHA512iter100000SHA256ModPow
+                        val request = TL_account.getPasswordSettings()
+                        if (algo != null) {
+                            request.password = SRPHelper.startCheck(SRPHelper.getX(bytes, algo), state.srp_id, state.srp_B, algo)
+                        }
+                        if (request.password == null) {
+                            AndroidUtilities.runOnUIThread { done(if (algo == null) "PASSWORD_HASH_INVALID" else "ALGO_INVALID") }
+                            return@postRunnable
+                        }
+                        connections.sendRequest(request, { _, checkError ->
+                            AndroidUtilities.runOnUIThread {
+                                when {
+                                    checkError == null -> done(null)
+                                    retry && "SRP_ID_INVALID" == checkError.text -> attempt(false)
+                                    else -> done(checkError.text)
+                                }
+                            }
+                        }, ConnectionsManager.RequestFlagFailOnServerErrors)
+                    }
+                }
+            }, ConnectionsManager.RequestFlagFailOnServerErrors)
+        }
+        attempt(true)
+    }
+
+    internal fun toast(site: String, text: String, error: Boolean = false) {
+        val shown = TeleLowercase.lc(text)
+        TeleToast.log(site, shown)
+        BulletinFactory.global().createSimpleBulletin(if (error) R.raw.error else R.raw.info, shown).show()
+    }
+}
