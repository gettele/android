+import tele.helpers.SavedDrafts
+
+class TeleDraftsActivity : BaseFragment() {
+    private val account get() = UserConfig.selectedAccount
+    private var drafts: List<SavedDrafts.Draft> = emptyList()
+    private var adapter: Adapter? = null
+
+    private fun reload() {
+        drafts = SavedDrafts.get(account)
+        adapter?.notifyDataSetChanged()
+    }
+
+    override fun createView(context: Context): View {
+        actionBar.setBackButtonImage(R.drawable.ic_ab_back)
+        actionBar.setAllowOverlayTitle(true)
+        actionBar.setTitle(LocaleController.getString(R.string.TeleSavedDrafts))
+        actionBar.setActionBarMenuOnItemClick(object : ActionBar.ActionBarMenuOnItemClick() {
+            override fun onItemClick(id: Int) {
+                if (id == -1) finishFragment()
+            }
+        })
+        reload()
+        val container = FrameLayout(context)
+        container.setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundGray))
+        fragmentView = container
+        val list = RecyclerListView(context)
+        val layoutManager = LinearLayoutManager(context)
+        list.setLayoutManager(layoutManager)
+        list.setVerticalScrollBarEnabled(false)
+        adapter = Adapter(context)
+        list.adapter = adapter
+        list.setOnItemClickListener { _, position ->
+            drafts.getOrNull(position)?.let { insertDraft(it) }
+        }
+        list.setOnItemLongClickListener { _, position ->
+            drafts.getOrNull(position)?.let { confirmDelete(it) }
+            true
+        }
+        container.addView(list, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.MATCH_PARENT.toFloat()))
+        return container
+    }
+
+    private fun insertDraft(draft: SavedDrafts.Draft) {
+        val args = android.os.Bundle()
+        args.putLong("tele_draft_id", draft.id)
+        if (draft.dialogId < 0) {
+            val chat = MessagesController.getInstance(account).getChat(-draft.dialogId)
+            if (draft.topicId != 0 && chat != null && ChatObject.isForum(chat)) {
+                val topic = MessagesController.getInstance(account).getTopicsController().findTopic(-draft.dialogId, draft.topicId.toLong())
+                if (topic != null) {
+                    val chatActivity = ForumUtilities.getChatActivityForTopic(this, -draft.dialogId, topic, 0, args)
+                    if (chatActivity != null) {
+                        presentFragment(chatActivity)
+                        return
+                    }
+                }
+            }
+            args.putLong("chat_id", -draft.dialogId)
+        } else {
+            args.putLong("user_id", draft.dialogId)
+        }
+        presentFragment(org.telegram.ui.ChatActivity(args))
+    }
+
+    private fun confirmDelete(draft: SavedDrafts.Draft) {
+        AlertDialog.Builder(context, resourceProvider)
+            .setTitle(LocaleController.getString(R.string.TeleDeleteDraft))
+            .setMessage(draft.text.take(80))
+            .setPositiveButton(LocaleController.getString(R.string.Delete)) { _, _ ->
+                SavedDrafts.remove(account, draft.id)
+                reload()
+            }
+            .setNegativeButton(LocaleController.getString(R.string.Cancel), null)
+            .show()
+    }
+
+    private fun peerTitle(id: Long): String {
+        val controller = MessagesController.getInstance(account)
+        if (id > 0) {
+            val user = controller.getUser(id)
+            if (user != null) return ContactsController.formatName(user.first_name, user.last_name)
+        } else if (id < 0) {
+            val chat = controller.getChat(-id)
+            if (chat != null) return chat.title
+        }
+        return "id $id"
+    }
+
+    private inner class Adapter(private val context: Context) : RecyclerListView.SelectionAdapter() {
+        override fun getItemCount(): Int = maxOf(drafts.size, 1)
+        override fun isEnabled(holder: RecyclerView.ViewHolder): Boolean = drafts.isNotEmpty()
+
+        override fun getItemViewType(position: Int): Int = if (drafts.isEmpty()) TYPE_EMPTY else TYPE_DRAFT
+
+        override fun onCreateViewHolder(parent: ViewGroup, viewType: Int): RecyclerView.ViewHolder {
+            val view: View = when (viewType) {
+                TYPE_EMPTY -> TextView(context).apply {
+                    setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2))
+                    textSize = 14f
+                    setPadding(AndroidUtilities.dp(16f), AndroidUtilities.dp(12f), AndroidUtilities.dp(16f), AndroidUtilities.dp(4f))
+                }
+                else -> LinearLayout(context).apply {
+                    orientation = LinearLayout.VERTICAL
+                    setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundWhite))
+                    setPadding(AndroidUtilities.dp(16f), AndroidUtilities.dp(10f), AndroidUtilities.dp(16f), AndroidUtilities.dp(10f))
+                    addView(TextView(context).apply {
+                        tag = TITLE_TAG
+                        setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
+                        textSize = 16f
+                        maxLines = 2
+                        ellipsize = android.text.TextUtils.TruncateAt.END
+                    }, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT))
+                    addView(TextView(context).apply {
+                        tag = SUBTITLE_TAG
+                        setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2))
+                        textSize = 13f
+                    }, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT).apply {
+                        topMargin = AndroidUtilities.dp(2f)
+                    })
+                }
+            }
+            view.layoutParams = RecyclerView.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT)
+            return RecyclerListView.Holder(view)
+        }
+
+        override fun onBindViewHolder(holder: RecyclerView.ViewHolder, position: Int) {
+            if (getItemViewType(position) == TYPE_EMPTY) {
+                (holder.itemView as TextView).text = LocaleController.getString(R.string.TeleNoSavedDrafts)
+                return
+            }
+            val draft = drafts[position]
+            val title = holder.itemView.findViewWithTag<TextView>(TITLE_TAG)
+            val subtitle = holder.itemView.findViewWithTag<TextView>(SUBTITLE_TAG)
+            title.text = draft.text.ifBlank { LocaleController.getString(R.string.TeleInsertDraft) }
+            title.setTypeface(Typeface.DEFAULT, Typeface.NORMAL)
+            val fileCount = draft.files.size
+            var subtitleText = peerTitle(draft.dialogId)
+            if (draft.topicId != 0) subtitleText += " · topic ${draft.topicId}"
+            if (fileCount > 0) subtitleText += " · ${LocaleController.formatString(R.string.TeleDraftFiles, fileCount)}"
+            subtitleText += " · ${LocaleController.formatDateChat(draft.created.toLong())}"
+            subtitle.text = subtitleText
+        }
+    }
+
+    companion object {
+        const val MODE_DRAFTS = "saved_drafts"
+        private const val TYPE_EMPTY = 0
+        private const val TYPE_DRAFT = 1
+        private const val TITLE_TAG = 2
+        private const val SUBTITLE_TAG = 3
+    }
+}
