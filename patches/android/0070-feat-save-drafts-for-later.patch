diff --git a/TMessagesProj/src/main/java/tele/helpers/SavedDrafts.kt b/TMessagesProj/src/main/java/tele/helpers/SavedDrafts.kt
new file mode 100644
index 000000000..8d6371773
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/SavedDrafts.kt
@@ -0,0 +1,219 @@
+package tele.helpers
+
+import android.text.SpannableStringBuilder
+import org.telegram.messenger.ApplicationLoader
+import org.telegram.messenger.FileLog
+import org.telegram.messenger.MediaController
+import org.telegram.messenger.MediaDataController
+import org.telegram.messenger.Utilities
+import org.telegram.tgnet.SerializedData
+import org.telegram.tgnet.TLRPC
+import org.telegram.ui.Components.ChatActivityEnterView
+import tele.db.TeleDatabaseHelper
+import java.io.File
+import java.io.FileInputStream
+import java.io.FileOutputStream
+
+object SavedDrafts {
+    private const val MAGIC = 0x53445654
+    private const val VERSION = 1
+
+    class Draft @JvmOverloads constructor(@JvmField val id: Long, @JvmField val dialogId: Long, @JvmField val topicId: Int, @JvmField val created: Int, @JvmField val edited: Int, @JvmField val message: TLRPC.DraftMessage, @JvmField val files: List<StoredFile>, @JvmField val replyMessage: TLRPC.Message? = null) {
+        val text: String get() = message.message ?: ""
+    }
+
+    class StoredFile(val storedName: String, val fileName: String, val isVideo: Boolean, val spoiler: Boolean, val ttl: Int, val width: Int, val height: Int, val size: Long, val duration: Int, val orientation: Int)
+
+    fun draftsDirectory(): File {
+        val dir = File(ApplicationLoader.getFilesDirFixed(), "tele_drafts")
+        if (!dir.exists()) dir.mkdirs()
+        return dir
+    }
+
+    fun copyFile(source: File): String? {
+        val name = Utilities.random.nextLong().toString(16) + "_" + source.name.takeLast(60)
+        val target = File(draftsDirectory(), name)
+        return try {
+            FileInputStream(source).use { input ->
+                FileOutputStream(target).use { output -> input.copyTo(output) }
+            }
+            name
+        } catch (e: Exception) {
+            FileLog.e(e)
+            null
+        }
+    }
+
+    fun storedFile(name: String): File = File(draftsDirectory(), name)
+
+    fun deleteStoredFiles(names: List<String>) {
+        for (name in names) {
+            val file = storedFile(name)
+            if (file.exists()) file.delete()
+        }
+    }
+
+    @JvmStatic
+    fun save(account: Int, dialogId: Long, topicId: Int, draftMessage: TLRPC.DraftMessage, files: List<StoredFile>, replyMessage: TLRPC.Message?): Long {
+        val id = Utilities.random.nextLong()
+        val now = (System.currentTimeMillis() / 1000L).toInt()
+        val stream = SerializedData()
+        try {
+            stream.writeInt32(MAGIC)
+            stream.writeInt32(VERSION)
+            draftMessage.serializeToStream(stream)
+            stream.writeInt32(files.size)
+            for (file in files) {
+                stream.writeString(file.storedName)
+                stream.writeString(file.fileName)
+                stream.writeBool(file.isVideo)
+                stream.writeBool(file.spoiler)
+                stream.writeInt32(file.ttl)
+                stream.writeInt32(file.width)
+                stream.writeInt32(file.height)
+                stream.writeInt64(file.size)
+                stream.writeInt32(file.duration)
+                stream.writeInt32(file.orientation)
+            }
+            stream.writeBool(replyMessage != null)
+            if (replyMessage != null) {
+                replyMessage.serializeToStream(stream)
+            }
+            TeleDatabaseHelper.putDraft(account, dialogId, topicId, id, now, now, stream.toByteArray())
+        } finally {
+            stream.cleanup()
+        }
+        return id
+    }
+
+    private fun deserialize(row: TeleDatabaseHelper.ArchivedDraft): Draft? {
+        return runCatching {
+            val stream = SerializedData(row.data)
+            try {
+                if (stream.readInt32(false) != MAGIC) return@runCatching null
+                stream.readInt32(false)
+                val message = TLRPC.DraftMessage.TLdeserialize(stream, stream.readInt32(false), false) as? TLRPC.TL_draftMessage ?: return@runCatching null
+                val count = stream.readInt32(false)
+                val files = ArrayList<StoredFile>(count)
+                for (i in 0 until count) {
+                    val storedName = stream.readString(false) ?: continue
+                    val fileName = stream.readString(false) ?: ""
+                    val isVideo = stream.readBool(false)
+                    val spoiler = stream.readBool(false)
+                    val ttl = stream.readInt32(false)
+                    val width = stream.readInt32(false)
+                    val height = stream.readInt32(false)
+                    val size = stream.readInt64(false)
+                    val duration = stream.readInt32(false)
+                    val orientation = stream.readInt32(false)
+                    files.add(StoredFile(storedName, fileName, isVideo, spoiler, ttl, width, height, size, duration, orientation))
+                }
+                var replyMessage: TLRPC.Message? = null
+                if (stream.readBool(false)) {
+                    replyMessage = TLRPC.Message.TLdeserialize(stream, stream.readInt32(false), false)
+                }
+                Draft(row.id, row.dialogId, row.topicId, row.created, row.edited, message, files, replyMessage)
+            } finally {
+                stream.cleanup()
+            }
+        }.getOrNull()
+    }
+
+    @JvmStatic
+    fun get(account: Int, dialogId: Long? = null, topicId: Int = 0): List<Draft> {
+        return TeleDatabaseHelper.getDrafts(account, dialogId, topicId).mapNotNull { deserialize(it) }
+    }
+
+    @JvmStatic
+    fun find(account: Int, id: Long): Draft? {
+        return get(account).firstOrNull { it.id == id }
+    }
+
+    @JvmStatic
+    fun remove(account: Int, id: Long) {
+        val draft = find(account, id)
+        TeleDatabaseHelper.removeDraft(account, id)
+        if (draft != null) {
+            deleteStoredFiles(draft.files.map { it.storedName })
+        }
+    }
+
+    @JvmStatic
+    fun removeAll(account: Int, dialogId: Long? = null) {
+        val drafts = get(account, dialogId)
+        TeleDatabaseHelper.removeDrafts(account, dialogId)
+        deleteStoredFiles(drafts.flatMap { draft -> draft.files.map { it.storedName } })
+    }
+
+    @JvmStatic
+    fun count(account: Int): Int = TeleDatabaseHelper.countDrafts(account)
+
+    fun buildDraftMessage(text: CharSequence, entities: ArrayList<TLRPC.MessageEntity>?, replyMessage: TLRPC.Message?): TLRPC.TL_draftMessage {
+        val draft = TLRPC.TL_draftMessage()
+        draft.message = text.toString()
+        draft.entities = entities ?: ArrayList()
+        draft.flags = draft.flags or 1
+        draft.date = (System.currentTimeMillis() / 1000L).toInt()
+        if (replyMessage != null) {
+            val reply = TLRPC.TL_inputReplyToMessage()
+            reply.reply_to_msg_id = replyMessage.id
+            draft.reply_to = reply
+            draft.flags = draft.flags or 4
+        }
+        return draft
+    }
+
+    fun buildDraftMessage(text: CharSequence, entities: ArrayList<TLRPC.MessageEntity>?, replyMessage: TLRPC.Message?, webPage: TLRPC.WebPage?): TLRPC.TL_draftMessage {
+        val draft = buildDraftMessage(text, entities, replyMessage)
+        if (webPage != null) {
+            draft.media = TLRPC.TL_inputMediaWebPage().apply {
+                url = webPage.url
+            }
+        }
+        return draft
+    }
+
+    @JvmStatic
+    fun copyAttachedFiles(entries: List<MediaController.PhotoEntry>): List<StoredFile> {
+        val result = ArrayList<StoredFile>()
+        for (entry in entries) {
+            val source = entry.path?.let(::File)?.takeIf { it.exists() } ?: entry.imagePath?.let(::File)?.takeIf { it.exists() }
+                ?: continue
+            val storedName = copyFile(source) ?: continue
+            result.add(StoredFile(storedName, source.name, entry.isVideo, entry.hasSpoiler, entry.ttl, entry.width, entry.height, entry.size, entry.duration, entry.orientation))
+        }
+        return result
+    }
+
+    @JvmStatic
+    fun toFieldText(draft: Draft): CharSequence {
+        if (draft.message.entities.isEmpty()) {
+            return draft.text
+        }
+        val builder = SpannableStringBuilder.valueOf(draft.text)
+        MediaDataController.addTextStyleRuns(draft.message.entities, draft.text, builder)
+        return builder
+    }
+
+    @JvmStatic
+    fun toPhotoEntries(draft: Draft): List<MediaController.PhotoEntry> {
+        val result = ArrayList<MediaController.PhotoEntry>(draft.files.size)
+        for (file in draft.files) {
+            val path = storedFile(file.storedName).absolutePath
+            val entry = MediaController.PhotoEntry(0, 0, 0, path, if (file.isVideo) file.duration else file.orientation, file.isVideo, file.width, file.height, file.size)
+            entry.hasSpoiler = file.spoiler
+            entry.ttl = file.ttl
+            result.add(entry)
+        }
+        return result
+    }
+
+    @JvmStatic
+    fun captureFromField(account: Int, enterView: ChatActivityEnterView, replyMessage: TLRPC.Message?, webPage: TLRPC.WebPage?, hasFiles: Boolean): TLRPC.TL_draftMessage? {
+        val text = enterView.getEditField()?.getTextToUse() ?: return null
+        if (text.isBlank() && !hasFiles) return null
+        val chars = arrayOf<CharSequence>(SpannableStringBuilder(text))
+        val entities = MediaDataController.getInstance(account).getEntities(chars, true)
+        return buildDraftMessage(chars[0], entities, replyMessage, webPage)
+    }
+}
