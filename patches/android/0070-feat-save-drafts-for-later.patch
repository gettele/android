+    public void teleSaveDraftFromField() {
+        if (chatActivityEnterView == null) {
+            return;
+        }
+        TLRPC.Message replyMessage = null;
+        MessageObject replyObject = chatActivityEnterView.getReplyingMessageObject();
+        if (replyObject != null && replyObject.messageOwner != null) {
+            replyMessage = replyObject.messageOwner;
+        }
+        ArrayList<MediaController.PhotoEntry> photoEntries = new ArrayList<>();
+        if (chatAttachAlert != null) {
+            HashMap<Object, Object> selected = chatAttachAlert.getPhotoLayout().getSelectedPhotos();
+            ArrayList<Object> order = chatAttachAlert.getPhotoLayout().getSelectedPhotosOrder();
+            if (selected != null && order != null) {
+                for (Object key : order) {
+                    Object value = selected.get(key);
+                    if (value instanceof MediaController.PhotoEntry) {
+                        photoEntries.add((MediaController.PhotoEntry) value);
+                    }
+                }
+            }
+        }
+        TLRPC.TL_draftMessage draftMessage = tele.helpers.SavedDrafts.captureFromField(currentAccount, chatActivityEnterView, replyMessage, chatActivityEnterView.getWebPage(), !photoEntries.isEmpty());
+        if (draftMessage == null) {
+            return;
+        }
+        final TLRPC.TL_draftMessage finalDraft = draftMessage;
+        final ArrayList<MediaController.PhotoEntry> entries = photoEntries;
+        final TLRPC.Message finalReplyMessage = replyMessage;
+        Utilities.globalQueue.postRunnable(() -> {
+            List<tele.helpers.SavedDrafts.StoredFile> files = tele.helpers.SavedDrafts.copyAttachedFiles(entries);
+            tele.helpers.SavedDrafts.save(currentAccount, getDialogId(), (int) getTopicId(), finalDraft, files, finalReplyMessage);
+            AndroidUtilities.runOnUIThread(() -> BulletinFactory.of(this).createSimpleBulletin(R.raw.contact_check, LocaleController.getString(R.string.TeleDraftSaved)).show());
+        });
+    }
+
+    private void teleInsertDraft(tele.helpers.SavedDrafts.Draft draft) {
+        if (draft == null || chatActivityEnterView == null) {
+            return;
+        }
+        chatActivityEnterView.setFieldText(tele.helpers.SavedDrafts.toFieldText(draft), true, true);
+        if (draft.replyMessage != null) {
+            MessageObject replyObject = new MessageObject(currentAccount, draft.replyMessage, getMessagesController().getUsers(), false, false);
+            showFieldPanelForReply(replyObject);
+        }
+    }
+
