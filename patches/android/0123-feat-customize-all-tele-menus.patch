@@ -0,0 +1,498 @@
+package tele.helpers
+
+import tele.Item
+import tele.db.TeleDatabaseHelper
+
+/** The kinds of the menus the tele client can rearrange. */
+enum class TeleMenuKind(val id: String, val title: String) {
+    MESSAGE("message", "Message menu"),
+    CHAT("chat", "Chat menu"),
+    CHAT_ROW("chat-row", "Chat list menu"),
+    FOLDER("folder", "Folder menu"),
+    PROFILE("profile", "Profile menu"),
+    SEND("send", "Send menu"),
+    FIELD("field", "Message field menu")
+}
+
+/** One entry of a menu layout. */
+sealed class TeleMenuEntry {
+
+    /** A menu item with its stable key. The numeric option code is only the input of the migration. */
+    data class Item(
+        val key: String,
+        val label: String,
+        val code: Int,
+        val gate: tele.Item<*>? = null
+    ) : TeleMenuEntry()
+
+    /** A separator between the items. */
+    data class Separator(val style: Style, var enabled: Boolean = true) : TeleMenuEntry() {
+        enum class Style { AUTO, THIN, THICK }
+    }
+
+    /** A nested menu with its own items. */
+    data class Submenu(var title: String, val entries: MutableList<TeleMenuEntry>, var enabled: Boolean = true) : TeleMenuEntry()
+}
+
+/**
+ * The layout of the menus: the order, the hidden items, the separators and the submenus.
+ *
+ * The layout is stored as plain text, one line per menu: `message=reply,copy,|,view_as_tl`.
+ * A hidden item starts with `-`, a separator is `|`, `|-` or `|=` and a submenu is
+ * `[Title#icon:item1,item2]`.
+ */
+object TeleMenuLayout {
+    const val RUNTIME_SEPARATOR = Int.MIN_VALUE
+    const val RUNTIME_SUBMENU = Int.MIN_VALUE + 1
+
+    /** The submenus of the last applied layout: the number of rows after each top-level title row. */
+    private val submenuChildCounts = ArrayList<Int>()
+
+    @JvmStatic
+    fun hasRuntimeSubmenu(options: List<Int>): Boolean = options.contains(RUNTIME_SUBMENU)
+
+    @JvmStatic
+    fun runtimeSubmenuCounts(): List<Int> = submenuChildCounts.toList()
+
+    private const val KEY_PREFIX = "tele_menu_"
+    private const val MIGRATED_KEY = "tele_menu_migrated"
+    private const val MAX_LAYOUT_LENGTH = 64 * 1024
+    private const val MAX_FULL_LENGTH = 256 * 1024
+    private const val MAX_ITEMS = 512
+    private const val MAX_DEPTH = 8
+    private const val MAX_TITLE = 64
+
+    /** The icons a submenu can use. */
+    val SUBMENU_ICONS = listOf("", "tele", "tools", "copy", "edit", "share", "star")
+
+    /** The registry of the items of a menu. */
+    fun registry(kind: TeleMenuKind): List<TeleMenuEntry.Item> = when (kind) {
+        TeleMenuKind.MESSAGE -> MessageMenu.ALL.map { TeleMenuEntry.Item(it.key, it.name, it.code, it.gate) }
+        else -> emptyList()
+    }
+
+    fun item(kind: TeleMenuKind, key: String): TeleMenuEntry.Item? =
+        registry(kind).firstOrNull { it.key == key }
+
+    /** The key of an item by its option code. */
+    fun keyOf(kind: TeleMenuKind, code: Int): String? =
+        registry(kind).firstOrNull { it.code == code }?.key
+
+    // the storage
+
+    private fun storageKey(kind: TeleMenuKind, account: Int) = "$KEY_PREFIX${kind.id}:$account"
+
+    fun load(kind: TeleMenuKind, account: Int): String? {
+        migrate(kind, account)
+        return TeleDatabaseHelper.get(storageKey(kind, account))
+    }
+
+    fun save(kind: TeleMenuKind, account: Int, layout: String) {
+        if (layout.isEmpty()) {
+            TeleDatabaseHelper.put(storageKey(kind, account), null)
+        } else {
+            TeleDatabaseHelper.put(storageKey(kind, account), layout)
+        }
+    }
+
+    /**
+     * Moves the old hidden list and order of the message menu into the layout.
+     * The old keys stay untouched until the migration is known to work.
+     */
+    private fun migrate(kind: TeleMenuKind, account: Int) {
+        if (kind != TeleMenuKind.MESSAGE) return
+        if (TeleDatabaseHelper.get(MIGRATED_KEY) != null) return
+        val hidden = MessageMenu.hiddenCodes()
+        val order = MessageMenu.orderedCodes()
+        if (hidden.isEmpty() && order.isEmpty()) {
+            TeleDatabaseHelper.put(MIGRATED_KEY, "1")
+            return
+        }
+        val layout = ArrayList<String>()
+        for (code in order) {
+            val key = keyOf(kind, code) ?: continue
+            layout.add(if (hidden.contains(code)) "-$key" else key)
+        }
+        for (item in registry(kind)) {
+            if (order.contains(item.code)) continue
+            if (hidden.contains(item.code)) continue
+            layout.add(item.key)
+        }
+        save(kind, account, layout.joinToString(","))
+        TeleDatabaseHelper.put(MIGRATED_KEY, "1")
+    }
+
+    // the presets
+
+    /** The safe order: the stock items first, the tele items at the end. */
+    fun preset(kind: TeleMenuKind, name: String): String = when (kind) {
+        TeleMenuKind.MESSAGE -> when (name) {
+            // the stock order without the tele items
+            "upstream" -> messagePreset(hidden = teleKeys(), stockFirst = true)
+            // only the safe minimum, the rest stays hidden
+            "minimal" -> messagePreset(hidden = minimalHidden(), stockFirst = true)
+            // everything the menu knows
+            "power" -> messagePreset(hidden = emptySet(), stockFirst = false)
+            else -> messagePreset(hidden = emptySet(), stockFirst = false)
+        }
+        else -> ""
+    }
+
+    private fun minimalHidden(): Set<String> {
+        val keep = setOf("reply", "copy", "forward", "edit", "delete")
+        return registry(TeleMenuKind.MESSAGE).filter { !keep.contains(it.key) }.map { it.key }.toSet()
+    }
+
+    /** The keys of the items the tele client adds. */
+    private fun teleKeys(): Set<String> {
+        return registry(TeleMenuKind.MESSAGE).filter { it.code >= FIRST_TELE_CODE }.map { it.key }.toSet()
+    }
+
+    private fun messagePreset(hidden: Set<String>, stockFirst: Boolean): String {
+        val items = registry(TeleMenuKind.MESSAGE)
+        val tele = items.filter { it.code >= FIRST_TELE_CODE }
+        val stock = items.filter { it.code < FIRST_TELE_CODE }
+        val ordered = if (stockFirst) stock + tele else items
+        val parts = ArrayList<String>()
+        for (item in ordered) {
+            parts.add(if (hidden.contains(item.key)) "-${item.key}" else item.key)
+        }
+        return parts.joinToString(",")
+    }
+
+    /** The tele items live in their own range of the option codes. */
+    private const val FIRST_TELE_CODE = 118
+
+    // the resolver
+
+    /**
+     * The layout of a menu: the stored one, or the default preset when nothing is stored.
+     * The items that are not in the layout yet go to the end.
+     */
+    fun resolve(kind: TeleMenuKind, account: Int): List<TeleMenuEntry> {
+        val stored = load(kind, account)
+        val parsed = if (stored.isNullOrEmpty()) {
+            parse(preset(kind, "default"), kind)
+        } else {
+            parse(stored, kind)
+        } ?: return emptyList()
+        return normalize(parsed.entries, kind, parsed.hidden)
+    }
+
+    /** Adds missing registry items at the root while preserving hidden items in their submenu. */
+    fun normalize(entries: List<TeleMenuEntry>, kind: TeleMenuKind, hidden: Set<String> = emptySet(), addMissing: Boolean = true): List<TeleMenuEntry> {
+        val seen = HashSet<String>()
+        val result = normalizeEntries(entries, kind, seen)
+        if (!addMissing) return result
+        val complete = ArrayList(result)
+        for (item in registry(kind)) {
+            if (seen.add(item.key)) complete.add(item)
+        }
+        return complete
+    }
+
+    private fun normalizeEntries(entries: List<TeleMenuEntry>, kind: TeleMenuKind, seen: MutableSet<String>): List<TeleMenuEntry> {
+        val known = registry(kind).map { it.key }.toSet()
+        val result = ArrayList<TeleMenuEntry>()
+        for (entry in entries) {
+            when (entry) {
+                is TeleMenuEntry.Item -> if (known.contains(entry.key) && seen.add(entry.key)) result.add(entry)
+                is TeleMenuEntry.Separator -> result.add(entry)
+                is TeleMenuEntry.Submenu -> result.add(entry.copy(entries = normalizeEntries(entry.entries, kind, seen).toMutableList()))
+            }
+        }
+        return result
+    }
+    /** The items that are hidden in the layout. */
+    fun hiddenKeys(kind: TeleMenuKind, account: Int): Set<String> {
+        val stored = load(kind, account) ?: return emptySet()
+        val hidden = HashSet<String>()
+        for (part in stored.split(',')) {
+            val token = part.trim()
+            if (token.startsWith("-")) hidden.add(token.substring(1).trim())
+        }
+        return hidden
+    }
+
+    // the runtime
+
+    /**
+     * Applies the layout to the items of a menu: the order of the layout wins,
+     * the items that are not in the layout keep their place at the end.
+     */
+    fun apply(kind: TeleMenuKind, account: Int, items: ArrayList<CharSequence>, icons: ArrayList<Int>, options: ArrayList<Int>) {
+        submenuChildCounts.clear()
+        val stored = load(kind, account)
+        if (stored.isNullOrEmpty()) return
+        val layout = resolve(kind, account)
+        val hidden = hiddenKeys(kind, account)
+        val disabledSubmenuKeys = HashSet<String>()
+        fun collectDisabled(entries: List<TeleMenuEntry>, enabled: Boolean) {
+            for (entry in entries) {
+                when (entry) {
+                    is TeleMenuEntry.Item -> if (!enabled) disabledSubmenuKeys.add(entry.key)
+                    is TeleMenuEntry.Separator -> Unit
+                    is TeleMenuEntry.Submenu -> collectDisabled(entry.entries, enabled && entry.enabled)
+                }
+            }
+        }
+        collectDisabled(layout, true)
+        val sortedItems = ArrayList<CharSequence>(items.size)
+        val sortedIcons = ArrayList<Int>(items.size)
+        val sortedOptions = ArrayList<Int>(items.size)
+        val used = HashSet<Int>()
+        fun addIndex(index: Int) {
+            if (index !in options.indices || !used.add(index)) return
+            val key = keyOf(kind, options[index]) ?: return
+            if (hidden.contains(key) || key in disabledSubmenuKeys) return
+            sortedItems.add(items[index])
+            sortedIcons.add(icons[index])
+            sortedOptions.add(options[index])
+        }
+        fun addKey(key: String) {
+            for (index in options.indices) {
+                if (keyOf(kind, options[index]) == key) {
+                    addIndex(index)
+                    return
+                }
+            }
+        }
+        fun addEntries(entries: List<TeleMenuEntry>, depth: Int) {
+            for (entry in entries) {
+                when (entry) {
+                    is TeleMenuEntry.Item -> addKey(entry.key)
+                    is TeleMenuEntry.Separator -> if (entry.enabled && sortedItems.isNotEmpty() && sortedOptions.lastOrNull() != RUNTIME_SEPARATOR) {
+                        sortedItems.add("")
+                        sortedIcons.add(0)
+                        sortedOptions.add(RUNTIME_SEPARATOR)
+                    }
+                    is TeleMenuEntry.Submenu -> if (entry.enabled) {
+                        val before = sortedItems.size
+                        addEntries(entry.entries, depth + 1)
+                        if (sortedItems.size > before) {
+                            sortedItems.add(before, entry.title)
+                            sortedIcons.add(before, 0)
+                            sortedOptions.add(before, RUNTIME_SUBMENU)
+                            if (depth == 0) submenuChildCounts.add(sortedItems.size - before)
+                        }
+                    }
+                }
+            }
+        }
+        addEntries(layout, 0)
+        for (index in options.indices) addIndex(index)
+        items.clear(); items.addAll(sortedItems)
+        icons.clear(); icons.addAll(sortedIcons)
+        options.clear(); options.addAll(sortedOptions)
+    }
+
+    // the text format
+
+    /** A parsed layout with the keys of the hidden items. */
+    data class Parsed(val entries: List<TeleMenuEntry>, val hidden: Set<String>)
+
+    /** Parses one layout line, returns null when the text is damaged. */
+    fun parse(text: String, kind: TeleMenuKind): Parsed? {
+        if (text.length > MAX_LAYOUT_LENGTH) return null
+        val hidden = HashSet<String>()
+        val entries = parseEntries(text, kind, 0, hidden) ?: return null
+        return Parsed(entries, hidden)
+    }
+
+    private fun parseEntries(text: String, kind: TeleMenuKind, depth: Int, hidden: HashSet<String>): List<TeleMenuEntry>? {
+        if (depth > MAX_DEPTH) return null
+        val out = ArrayList<TeleMenuEntry>()
+        for (token in splitTokens(text)) {
+            if (token.isEmpty()) continue
+            when {
+                token == "|" -> out.add(TeleMenuEntry.Separator(TeleMenuEntry.Separator.Style.AUTO))
+                token == "|-" -> out.add(TeleMenuEntry.Separator(TeleMenuEntry.Separator.Style.THIN))
+                token == "|=" -> out.add(TeleMenuEntry.Separator(TeleMenuEntry.Separator.Style.THICK))
+                token.startsWith("-[") || token.startsWith("[") -> {
+                    val disabled = token.startsWith("-")
+                    val submenuToken = if (disabled) token.substring(1) else token
+                    val submenu = parseSubmenu(submenuToken, kind, depth, hidden)?.apply { enabled = !disabled } ?: return null
+                    out.add(submenu)
+                }
+                else -> {
+                    val isHidden = token.startsWith("-")
+                    val key = if (isHidden) token.substring(1) else token
+                    if (!isValidKey(key)) return null
+                    val item = item(kind, key) ?: return null
+                    if (isHidden) hidden.add(key)
+                    out.add(item)
+                }
+            }
+            if (out.size > MAX_ITEMS) return null
+        }
+        return out
+    }
+
+    private fun parseSubmenu(token: String, kind: TeleMenuKind, depth: Int, hidden: HashSet<String>): TeleMenuEntry.Submenu? {
+        if (!token.endsWith("]")) return null
+        val body = token.substring(1, token.length - 1)
+        val colon = body.indexOf(':')
+        if (colon < 0) return null
+        var title = body.substring(0, colon)
+        var icon = ""
+        val hash = title.indexOf('#')
+        if (hash >= 0) {
+            icon = title.substring(hash + 1)
+            title = title.substring(0, hash)
+        }
+        title = unescape(title)
+        if (title.isEmpty() || title.length > MAX_TITLE) return null
+        if (!SUBMENU_ICONS.contains(icon)) return null
+        val children = parseEntries(body.substring(colon + 1), kind, depth + 1, hidden) ?: return null
+        return TeleMenuEntry.Submenu(title, children.toMutableList())
+    }
+
+    /** Splits the tokens of a layout, keeping the submenus together. */
+    private fun splitTokens(text: String): List<String> {
+        val out = ArrayList<String>()
+        val current = StringBuilder()
+        var depth = 0
+        var escaped = false
+        for (c in text) {
+            if (escaped) {
+                current.append(c)
+                escaped = false
+                continue
+            }
+            when (c) {
+                '\\' -> {
+                    current.append(c)
+                    escaped = true
+                }
+                '[' -> {
+                    depth++
+                    current.append(c)
+                }
+                ']' -> {
+                    depth--
+                    if (depth < 0) return emptyList()
+                    current.append(c)
+                }
+                ',' -> {
+                    if (depth == 0) {
+                        out.add(current.toString().trim())
+                        current.setLength(0)
+                    } else {
+                        current.append(c)
+                    }
+                }
+                else -> current.append(c)
+            }
+        }
+        if (depth != 0) return emptyList()
+        out.add(current.toString().trim())
+        return out
+    }
+
+    private fun isValidKey(key: String): Boolean {
+        if (key.isEmpty()) return false
+        for (c in key) {
+            if (!(c in 'a'..'z' || c in '0'..'9' || c == '_' || c == '.')) return false
+        }
+        return true
+    }
+
+    private fun escapeTitle(title: String): String {
+        val out = StringBuilder()
+        for (c in title) {
+            if (c == '\\' || c == ',' || c == ':' || c == '[' || c == ']' || c == '#' || c == '|' || c == '\n' || c == '\r') {
+                out.append('\\')
+            }
+            out.append(c)
+        }
+        return out.toString()
+    }
+
+    private fun unescape(title: String): String {
+        val out = StringBuilder()
+        var escaped = false
+        for (c in title) {
+            if (escaped) {
+                out.append(c)
+                escaped = false
+                continue
+            }
+            if (c == '\\') {
+                escaped = true
+                continue
+            }
+            out.append(c)
+        }
+        return out.toString()
+    }
+
+    /** Serializes a layout back to its text form. */
+    fun serialize(entries: List<TeleMenuEntry>, hidden: Set<String> = emptySet()): String = serializeEntries(entries, hidden)
+
+    private fun serializeEntries(entries: List<TeleMenuEntry>, hidden: Set<String>): String {
+        val parts = ArrayList<String>()
+        for (entry in entries) {
+            when (entry) {
+                is TeleMenuEntry.Item -> parts.add(if (hidden.contains(entry.key)) "-${entry.key}" else entry.key)
+                is TeleMenuEntry.Separator -> {
+                    if (!entry.enabled) continue
+                    parts.add(when (entry.style) {
+                        TeleMenuEntry.Separator.Style.AUTO -> "|"
+                        TeleMenuEntry.Separator.Style.THIN -> "|-"
+                        TeleMenuEntry.Separator.Style.THICK -> "|="
+                    })
+                }
+                is TeleMenuEntry.Submenu -> {
+                    val encoded = "[${escapeTitle(entry.title)}:${serializeEntries(entry.entries, hidden)}]"
+                    parts.add(if (entry.enabled) encoded else "-$encoded")
+                }
+            }
+        }
+        return parts.joinToString(",")
+    }
+
+    /** The full export of all the menus. */
+    fun exportAll(account: Int): String {
+        val lines = ArrayList<String>()
+        for (kind in TeleMenuKind.values()) {
+            val layout = load(kind, account) ?: preset(kind, "default")
+            if (layout.isEmpty()) continue
+            lines.add("${kind.id}=$layout")
+        }
+        val text = lines.joinToString("\n")
+        return if (text.length <= MAX_FULL_LENGTH) text else ""
+    }
+
+    /** Parses a full export: one line per menu. */
+    fun importAll(text: String, account: Int): Boolean {
+        if (text.length > MAX_FULL_LENGTH) return false
+        val lines = text.split('\n').map { it.trim() }.filter { it.isNotEmpty() }
+        if (lines.isEmpty()) return false
+        val seen = HashSet<String>()
+        for (line in lines) {
+            val separator = line.indexOf('=')
+            if (separator <= 0) return false
+            val id = line.substring(0, separator)
+            val layout = line.substring(separator + 1)
+            val kind = TeleMenuKind.values().firstOrNull { it.id == id } ?: return false
+            if (!seen.add(kind.id)) return false
+            val parsed = parse(layout, kind) ?: return false
+            save(kind, account, serialize(parsed.entries, parsed.hidden))
+        }
+        return true
+    }
+
+    /** Parses one layout without a menu prefix, for the current menu. */
+    fun importSingle(text: String, kind: TeleMenuKind, account: Int): Boolean {
+        val trimmed = text.trim()
+        if (trimmed.isEmpty()) return false
+        val prefix = "${kind.id}="
+        if (trimmed.startsWith(prefix)) {
+            return importAll(trimmed, account)
+        }
+        if (trimmed.contains('=')) return false
+        val parsed = parse(trimmed, kind) ?: return false
+        save(kind, account, serialize(parsed.entries, parsed.hidden))
+        return true
+    }
+}
