+package tele.helpers
+
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.FileLoader
+import org.telegram.messenger.MessageObject
+import org.telegram.messenger.UserConfig
+import org.telegram.messenger.Utilities
+import org.telegram.tgnet.SerializedData
+import org.telegram.tgnet.TLRPC
+import tele.TeleConfig
+import tele.db.TeleDatabaseHelper
+import java.io.File
+import java.util.concurrent.atomic.AtomicBoolean
+
+/** Drops the kept deleted messages and the edit versions that outlived the chosen period. */
+object DeletedRetention {
+    private const val DAY = 24 * 60 * 60L
+    private const val BATCH = 200
+    private const val PAUSE = 300L
+    private const val TICK = 60 * 60 * 1000L
+    private val running = AtomicBoolean(false)
+
+    /** The period in seconds, 0 is forever. */
+    @JvmStatic
+    fun seconds(): Long = when (TeleConfig.DELETED_RETENTION.value) {
+        "1" -> DAY
+        "7" -> 7 * DAY
+        "30" -> 30 * DAY
+        else -> 0L
+    }
+
+    /** Sweeps shortly after the start and then every hour. */
+    @JvmStatic
+    fun start() {
+        Utilities.globalQueue.postRunnable(object : Runnable {
+            override fun run() {
+                sweep()
+                Utilities.globalQueue.postRunnable(this, TICK)
+            }
+        }, 30_000)
+    }
+
+    @JvmStatic
+    fun sweep() {
+        if (seconds() == 0L || !running.compareAndSet(false, true)) return
+        Utilities.globalQueue.postRunnable { step() }
+    }
+
+    private fun step() {
+        val period = seconds()
+        if (period == 0L) {
+            running.set(false)
+            return
+        }
+        val cutoff = (System.currentTimeMillis() / 1000L - period).toInt()
+        val edits = try {
+            TeleDatabaseHelper.deleteExpiredEdits(cutoff, BATCH)
+        } catch (e: Exception) {
+            0
+        }
+        val expired = try {
+            TeleDatabaseHelper.getExpiredDeleted(cutoff, BATCH)
+        } catch (e: Exception) {
+            emptyList()
+        }
+        if (expired.isEmpty() && edits < BATCH) {
+            running.set(false)
+            return
+        }
+        AndroidUtilities.runOnUIThread {
+            for ((account, rows) in expired.groupBy { it.account }) {
+                val active = account in 0 until UserConfig.MAX_ACCOUNT_COUNT && UserConfig.getInstance(account).isClientActivated
+                for ((dialogId, ids) in rows.groupBy { it.dialogId }) {
+                    if (active) DeletedMessages.purge(account, dialogId, ids.map { it.messageId })
+                    else for (row in ids) TeleDatabaseHelper.removeDeletedMessage(account, dialogId, row.messageId)
+                }
+            }
+            Utilities.globalQueue.postRunnable({ step() }, PAUSE)
+        }
+    }
+}
+
+/** The files the cache cleaners must leave: the media of the kept deleted messages, from tele.db. */
+object KeptMedia {
+    private const val TTL = 5_000L
+    private const val BATCH = 100
+    private val lock = Any()
+    private var names: Set<String> = emptySet()
+    private var loadedAt = 0L
+
+    /** For the cleaners: runs on their background threads. */
+    @JvmStatic
+    fun isProtected(file: File?): Boolean {
+        if (file == null) return false
+        val name = file.name
+        val base = if (name.startsWith("q_")) name.substring(2) else name
+        val set = snapshot()
+        return set.contains(name) || set.contains(base)
+    }
+
+    private fun snapshot(): Set<String> = synchronized(lock) {
+        val now = System.currentTimeMillis()
+        if (now - loadedAt > TTL) {
+            names = try {
+                fill()
+                val all = HashSet<String>()
+                for (row in TeleDatabaseHelper.getAllMediaNames()) all.addAll(row.split('\n'))
+                all
+            } catch (e: Exception) {
+                names
+            }
+            loadedAt = System.currentTimeMillis()
+        }
+        names
+    }
+
+    // the rows archived before the names were kept, or replaced since
+    private fun fill() {
+        while (true) {
+            val pending = TeleDatabaseHelper.getMediaPending(BATCH)
+            if (pending.isEmpty()) return
+            for (row in pending) {
+                TeleDatabaseHelper.setMediaNames(row.account, row.dialogId, row.messageId, namesOf(row.data))
+            }
+            if (pending.size < BATCH) return
+        }
+    }
+
+    private fun namesOf(data: ByteArray): String {
+        val stream = SerializedData(data)
+        try {
+            val message = TLRPC.Message.TLdeserialize(stream, stream.readInt32(false), false) ?: return ""
+            val result = LinkedHashSet<String>()
+            MessageObject.getPhoto(message)?.sizes?.forEach { add(result, FileLoader.getAttachFileName(it)) }
+            MessageObject.getDocument(message)?.let { document ->
+                add(result, FileLoader.getAttachFileName(document))
+                document.thumbs?.forEach { add(result, FileLoader.getAttachFileName(it)) }
+            }
+            return result.joinToString("\n")
+        } catch (e: Exception) {
+            return ""
+        } finally {
+            stream.cleanup()
+        }
+    }
+
+    private fun add(result: MutableSet<String>, name: String?) {
+        if (!name.isNullOrEmpty()) result.add(name)
+    }
+}
