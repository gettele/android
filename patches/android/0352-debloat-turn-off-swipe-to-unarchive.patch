From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: test <test@example.com>
Date: Sun, 15 Nov 2026 16:58:34 +0300
Subject: [PATCH] debloat: turn off swipe to unarchive

---
 .../src/main/java/org/telegram/ui/DialogsActivity.java         | 3 +++
 TMessagesProj/src/main/java/tele/TeleConfig.kt                 | 2 ++
 TMessagesProj/src/main/java/tele/helpers/TeleTextRu.kt         | 1 +
 TMessagesProj/src/main/java/tele/helpers/TeleTextUk.kt         | 1 +
 TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt     | 3 ++-
 .../src/main/java/tele/ui/settings/TeleSettingsActivity.kt     | 1 +
 6 files changed, 10 insertions(+), 1 deletion(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/DialogsActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/DialogsActivity.java
index c67a2408e..8decc9043 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/DialogsActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/DialogsActivity.java
@@ -2447,6 +2447,9 @@ public class DialogsActivity extends BaseFragment implements NotificationCenter.
             if (waitingForDialogsAnimationEnd(parentPage) || parentLayout != null && parentLayout.isInPreviewMode() || rightSlidingDialogContainer.hasFragment() || communityId != 0) {
                 return 0;
             }
+            if (isArchive() && !actionBar.isActionModeShowed(null) && tele.TeleConfig.NO_SWIPE_TO_UNARCHIVE.getValue()) {
+                return 0;
+            }
             if (swipingFolder && swipeFolderBack) {
                 if (viewHolder.itemView instanceof DialogCell) {
                     ((DialogCell) viewHolder.itemView).swipeCanceled = true;
diff --git a/TMessagesProj/src/main/java/tele/TeleConfig.kt b/TMessagesProj/src/main/java/tele/TeleConfig.kt
index 5bc547a37..49dea3f8b 100644
--- a/TMessagesProj/src/main/java/tele/TeleConfig.kt
+++ b/TMessagesProj/src/main/java/tele/TeleConfig.kt
@@ -524,6 +524,8 @@ object TeleConfig {
     val COMPOSER_AUTOPAIRS = BoolItem("composer_autopairs", false)
     @JvmField
     val COMPOSER_AUTOINDENT = BoolItem("composer_autoindent", false)
+    @JvmField
+    val NO_SWIPE_TO_UNARCHIVE = BoolItem("no_swipe_to_unarchive", false)
 
     private var prefs: SharedPreferences? = null
 
diff --git a/TMessagesProj/src/main/java/tele/helpers/TeleTextRu.kt b/TMessagesProj/src/main/java/tele/helpers/TeleTextRu.kt
index 80f6e34c7..31214d265 100644
--- a/TMessagesProj/src/main/java/tele/helpers/TeleTextRu.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/TeleTextRu.kt
@@ -1710,5 +1710,6 @@ object TeleTextRu {
         "Saved messages row in the chat list" to "Строка «Избранное» в списке чатов",
         "Long-press the row to hide it above the list or remove it; pull down to bring it back." to "Удерживайте строку, чтобы скрыть её над списком или убрать; потяните вниз, чтобы вернуть.",
         "Hide from chat list" to "Убрать из списка чатов",
+        "Turn off swipe to unarchive" to "Отключить смахивание для разархивации",
     )
 }
diff --git a/TMessagesProj/src/main/java/tele/helpers/TeleTextUk.kt b/TMessagesProj/src/main/java/tele/helpers/TeleTextUk.kt
index 902fb1396..8f65ba555 100644
--- a/TMessagesProj/src/main/java/tele/helpers/TeleTextUk.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/TeleTextUk.kt
@@ -1710,5 +1710,6 @@ object TeleTextUk {
         "Saved messages row in the chat list" to "Рядок «Збережене» у списку чатів",
         "Long-press the row to hide it above the list or remove it; pull down to bring it back." to "Утримуйте рядок, щоб сховати його над списком або прибрати; потягніть униз, щоб повернути.",
         "Hide from chat list" to "Прибрати зі списку чатів",
+        "Turn off swipe to unarchive" to "Вимкнути змахування для розархівування",
     )
 }
diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt
index 9b95350a8..dbef5d5e8 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt
@@ -485,7 +485,8 @@ object TeleSearch {
             section(1571, "Hide messages in a screenshot", "menus", TeleSettingsActivity.MODE_MENUS, "Customize chat screenshots"),
             section(1572, "Cut text from a screenshot", "menus", TeleSettingsActivity.MODE_MENUS, "Customize chat screenshots"),
             section(1632, "self chat", "chats", TeleSettingsActivity.MODE_CHATS, "Saved messages row in the chat list"),
-            section(1633, "top of the list", "chats", TeleSettingsActivity.MODE_CHATS, "Saved messages row in the chat list")
+            section(1633, "top of the list", "chats", TeleSettingsActivity.MODE_CHATS, "Saved messages row in the chat list"),
+            section(1634, "Archived chats swipe", "chats", TeleSettingsActivity.MODE_CHATS, "Turn off swipe to unarchive")
         ))
         // a page button and the screen it opens are the same result: the one with the page path wins
         val pageTitles = results.filter { it.path != null && it.path.size > 1 }.map { it.searchTitle.lowercase() }.toHashSet()
diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
index 6e5c5fbe3..05e59d077 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
@@ -1510,6 +1510,7 @@ class TeleSettingsActivity @JvmOverloads constructor(private val mode: String =
                 toggle("Jump to the first message", TeleConfig.JUMP_TO_FIRST),
                 toggle("Move chats instantly", TeleConfig.INSTANT_CHAT_MOVE),
                 toggle("Hide message previews", TeleConfig.HIDE_LIST_PREVIEWS),
+                toggle("Turn off swipe to unarchive", TeleConfig.NO_SWIPE_TO_UNARCHIVE),
                 Row(TYPE_SHADOW),
                 Row(TYPE_HEADER, "Chats and profiles"),
                 toggle("Show names instead of phone numbers in chat headers", TeleConfig.NAME_INSTEAD_OF_PHONE),
