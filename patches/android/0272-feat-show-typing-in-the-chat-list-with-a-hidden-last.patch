From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Thu, 5 Nov 2026 17:48:02 +0300
Subject: [PATCH] feat: show typing in the chat list with a hidden last seen

---
 .../java/org/telegram/messenger/MessagesController.java     | 2 +-
 TMessagesProj/src/main/java/tele/TeleConfig.kt              | 2 ++
 TMessagesProj/src/main/java/tele/TeleHooks.kt               | 6 ++++++
 .../src/main/java/tele/helpers/TeleSettingsLinks.kt         | 1 +
 TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt  | 3 +++
 .../src/main/java/tele/ui/settings/TeleSettingsActivity.kt  | 4 ++++
 6 files changed, 17 insertions(+), 1 deletion(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/MessagesController.java b/TMessagesProj/src/main/java/org/telegram/messenger/MessagesController.java
index 85c4e2cc1..a727d27e2 100644
--- a/TMessagesProj/src/main/java/org/telegram/messenger/MessagesController.java
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/MessagesController.java
@@ -22000,7 +22000,7 @@ public class MessagesController extends BaseController implements NotificationCe
     public CharSequence getPrintingString(long dialogId, long threadId, boolean isDialog) {
         if (isDialog && DialogObject.isUserDialog(dialogId)) {
             TLRPC.User user = getUser(dialogId);
-            if (user != null && user.status != null && user.status.expires < 0) {
+            if (user != null && user.status != null && user.status.expires < 0 && !(TeleConfig.TYPING_HIDDEN_LAST_SEEN.getValue() && !user.bot)) {
                 return null;
             }
         }
diff --git a/TMessagesProj/src/main/java/tele/TeleConfig.kt b/TMessagesProj/src/main/java/tele/TeleConfig.kt
index bfd72bb92..932cdab0b 100644
--- a/TMessagesProj/src/main/java/tele/TeleConfig.kt
+++ b/TMessagesProj/src/main/java/tele/TeleConfig.kt
@@ -98,6 +98,8 @@ object TeleConfig {
     @JvmField
     val LAST_SEEN_RESTORE = BoolItem("last_seen_restore", false)
     @JvmField
+    val TYPING_HIDDEN_LAST_SEEN = BoolItem("typing_hidden_last_seen", false)
+    @JvmField
     val STREAMER_MODE = BoolItem("streamer_mode", false)
     @JvmField
     val HIDDEN_WORDS = BoolItem("hidden_words", false)
diff --git a/TMessagesProj/src/main/java/tele/TeleHooks.kt b/TMessagesProj/src/main/java/tele/TeleHooks.kt
index 51cd6abd0..7ec168bc5 100644
--- a/TMessagesProj/src/main/java/tele/TeleHooks.kt
+++ b/TMessagesProj/src/main/java/tele/TeleHooks.kt
@@ -179,6 +179,12 @@ object TeleHooks {
         if (item === TeleConfig.ONLINE_NOTIFY) {
             tele.helpers.OnlineNotify.onToggled()
         }
+        if (item === TeleConfig.TYPING_HIDDEN_LAST_SEEN) {
+            for (account in 0 until UserConfig.MAX_ACCOUNT_COUNT) {
+                AccountInstance.getInstance(account).getNotificationCenter()
+                    .postNotificationName(NotificationCenter.updateInterfaces, MessagesController.UPDATE_MASK_STATUS)
+            }
+        }
         if (item === TeleConfig.NOTICES || item === TeleConfig.NOTICES_LIMITS || item === TeleConfig.NOTICES_LOG_LIMITS) {
             tele.helpers.TeleFloodWait.refresh()
         }
diff --git a/TMessagesProj/src/main/java/tele/helpers/TeleSettingsLinks.kt b/TMessagesProj/src/main/java/tele/helpers/TeleSettingsLinks.kt
index 9856365ed..ab4155582 100644
--- a/TMessagesProj/src/main/java/tele/helpers/TeleSettingsLinks.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/TeleSettingsLinks.kt
@@ -87,6 +87,7 @@ object TeleSettingsLinks {
         "tele-hide-ignored" to optionId(TeleConfig.IGNORE_USERS.key),
         "tele-ignore-in-menu" to optionId(TeleConfig.IGNORE_BUTTON.key),
         "tele-peek-last-seen" to optionId(TeleConfig.LAST_SEEN_RESTORE.key),
+        "tele-typing-hidden-last-seen" to optionId(TeleConfig.TYPING_HIDDEN_LAST_SEEN.key),
         "tele-hide-phone-in-profile" to optionId(TeleConfig.HIDE_PHONE_IN_PROFILES.key),
         "tele-server-url" to optionId(TeleConfig.TELE_SERVER_URL.key),
         "tele-stars-tools" to optionId(TeleConfig.STAR_TRANSACTIONS.key),
diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt
index f4779fe45..0ec630d6f 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt
@@ -124,6 +124,9 @@ object TeleSearch {
             section(1117, "Mute ignored messages", "privacy", TeleSettingsActivity.MODE_PRIVACY),
             section(1118, "Show waiting messages in the chat", "privacy", TeleSettingsActivity.MODE_PRIVACY),
             section(1119, "Peek at hidden last seen", "privacy", TeleSettingsActivity.MODE_PRIVACY),
+            section(1626, "Typing in the chat list with a hidden last seen", "profiles and ids", TeleSettingsActivity.MODE_PROFILES_IDS),
+            section(1627, "Typing with a hidden last seen", "profiles and ids", TeleSettingsActivity.MODE_PROFILES_IDS, "Typing in the chat list with a hidden last seen"),
+            section(1628, "Last seen typing", "profiles and ids", TeleSettingsActivity.MODE_PROFILES_IDS, "Typing in the chat list with a hidden last seen"),
             section(1618, "Streamer mode", "privacy", TeleSettingsActivity.MODE_PRIVACY),
             section(1619, "Ghost mode", "privacy", TeleSettingsActivity.MODE_PRIVACY),
             section(1620, "Hide the messages completely", "privacy", TeleSettingsActivity.MODE_PRIVACY),
diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
index 7ed9eedae..899594b50 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
@@ -1138,6 +1138,7 @@ class TeleSettingsActivity @JvmOverloads constructor(private val mode: String =
             "Hide messages by words" to "Hide incoming messages matching a word or regex.",
             "Mute ignored messages" to "No notifications from ignored people.",
             "Peek at hidden last seen" to "Briefly reveal a hidden last seen; they can tell.",
+            "Typing in the chat list with a hidden last seen" to "Shows typing, recording and sticker picking in the chat list even when their last seen is hidden.",
             "Streamer mode" to "Block screen capture and hide notification previews.",
             "Hide phone numbers in profiles" to "No phone number row in profiles.",
             "Message bookmarks" to "Bookmark messages and step through them. Stored locally.",
@@ -1608,6 +1609,9 @@ class TeleSettingsActivity @JvmOverloads constructor(private val mode: String =
                 toggle("Id and dc in one row", TeleConfig.MERGE_ID_DC),
                 Row(TYPE_CUSTOM, mode = "ids_preview", parent = TeleConfig.SHOW_PEER_ID),
                 Row(TYPE_SHADOW),
+                Row(TYPE_HEADER, "Last seen"),
+                toggle("Typing in the chat list with a hidden last seen", TeleConfig.TYPING_HIDDEN_LAST_SEEN),
+                Row(TYPE_SHADOW),
                 Row(TYPE_HEADER, "Media viewer"),
                 toggle("Show when media was uploaded", TeleConfig.MEDIA_UPLOAD_DATE),
                 Row(TYPE_SHADOW),
