diff --git a/TMessagesProj/src/main/java/tele/helpers/OnlineNotify.kt b/TMessagesProj/src/main/java/tele/helpers/OnlineNotify.kt
new file mode 100644
index 000000000..ff39ce290
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/OnlineNotify.kt
@@ -0,0 +1,210 @@
+package tele.helpers
+
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import android.app.PendingIntent
+import android.content.Context
+import android.content.Intent
+import android.os.Build
+import android.os.Process
+import android.os.SystemClock
+import androidx.core.app.NotificationCompat
+import androidx.core.app.NotificationManagerCompat
+import org.json.JSONArray
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.ApplicationLoader
+import org.telegram.messenger.BuildVars
+import org.telegram.messenger.FileLog
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.MessagesController
+import org.telegram.messenger.R
+import org.telegram.messenger.UserConfig
+import org.telegram.messenger.UserObject
+import org.telegram.tgnet.ConnectionsManager
+import org.telegram.tgnet.TLRPC
+import org.telegram.ui.LaunchActivity
+import tele.TeleConfig
+import tele.db.TeleDatabaseHelper
+
+/**
+ * A local notification when a watched person comes online. The watch list is kept per account in
+ * tele_kv. The connection stays alive through the stock keep-alive service, see [keepAlive].
+ */
+object OnlineNotify {
+
+    private const val KEY = "online_notify_users"
+    private const val CHANNEL = "tele_online"
+    private const val MAX_USERS = 65536
+    private const val COOLDOWN_MS = 10 * 60 * 1000L
+
+    // users loaded from the server right after the start are not "came online" events
+    private const val START_GRACE_MS = 30 * 1000L
+
+    private val lock = Any()
+    private val watched = arrayOfNulls<LinkedHashSet<Long>>(UserConfig.MAX_ACCOUNT_COUNT)
+    private val notified = HashMap<String, Long>()
+
+    @JvmStatic
+    fun enabled(): Boolean = TeleConfig.ONLINE_NOTIFY.value
+
+    /** Desktop skips yourself, bots and service users. */
+    @JvmStatic
+    fun canWatch(user: TLRPC.User?): Boolean =
+        user != null && !user.self && !user.bot && !UserObject.isDeleted(user) &&
+            !UserObject.isService(user.id) && user.id > 0
+
+    @JvmStatic
+    fun isWatched(account: Int, userId: Long): Boolean = synchronized(lock) { set(account).contains(userId) }
+
+    @JvmStatic
+    fun list(account: Int): List<Long> = synchronized(lock) { set(account).toList() }
+
+    @JvmStatic
+    fun count(account: Int): Int = synchronized(lock) { set(account).size }
+
+    @JvmStatic
+    fun setWatched(account: Int, ids: Collection<Long>) {
+        synchronized(lock) {
+            val next = LinkedHashSet<Long>()
+            for (id in ids) {
+                if (id > 0 && next.size < MAX_USERS) next.add(id)
+            }
+            watched[account] = next
+            save(account, next)
+        }
+        refreshService()
+    }
+
+    @JvmStatic
+    fun setWatched(account: Int, userId: Long, on: Boolean) {
+        synchronized(lock) {
+            val current = set(account)
+            if (on) {
+                if (userId <= 0 || current.size >= MAX_USERS || !current.add(userId)) return
+            } else if (!current.remove(userId)) {
+                return
+            }
+            save(account, current)
+        }
+        refreshService()
+    }
+
+    /** The stock keep-alive service is wanted while somebody is watched. */
+    @JvmStatic
+    fun keepAlive(): Boolean {
+        if (!enabled()) return false
+        for (account in 0 until UserConfig.MAX_ACCOUNT_COUNT) {
+            if (UserConfig.getInstance(account).isClientActivated && count(account) > 0) return true
+        }
+        return false
+    }
+
+    @JvmStatic
+    fun onToggled() = refreshService()
+
+    private fun refreshService() {
+        // the stock decision starts or stops the service, with the watch list taken into account
+        AndroidUtilities.runOnUIThread { ApplicationLoader.startPushService() }
+    }
+
+    /** A status update arrived: [user] still holds the previous status. */
+    @JvmStatic
+    fun onUserStatus(account: Int, user: TLRPC.User?, newStatus: TLRPC.UserStatus?) {
+        if (!enabled() || user == null) return
+        transition(account, user, user.status, newStatus)
+    }
+
+    /** The user object was replaced by a loaded one. */
+    @JvmStatic
+    fun onUserLoaded(account: Int, user: TLRPC.User?, oldUser: TLRPC.User?) {
+        if (!enabled() || user == null || oldUser == null || oldUser.status == null) return
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.N && SystemClock.elapsedRealtime() - Process.getStartElapsedRealtime() < START_GRACE_MS) return
+        transition(account, user, oldUser.status, user.status)
+    }
+
+    private fun transition(account: Int, user: TLRPC.User, old: TLRPC.UserStatus?, new: TLRPC.UserStatus?) {
+        val now = ConnectionsManager.getInstance(account).currentTime
+        // only a switch from not online to online counts
+        if (!online(new, now) || online(old, now)) return
+        if (!canWatch(user) || !isWatched(account, user.id)) return
+        val key = "$account:${user.id}"
+        val ms = SystemClock.elapsedRealtime()
+        synchronized(lock) {
+            val last = notified[key]
+            if (last != null && ms - last < COOLDOWN_MS) return
+            notified[key] = ms
+        }
+        log("account $account user ${user.id} online")
+        show(account, user)
+    }
+
+    private fun online(status: TLRPC.UserStatus?, now: Int): Boolean =
+        status is TLRPC.TL_userStatusOnline && status.expires > now
+
+    private fun show(account: Int, user: TLRPC.User) {
+        val context = ApplicationLoader.applicationContext ?: return
+        // without the system permission there is nothing to show
+        if (!NotificationManagerCompat.from(context).areNotificationsEnabled()) return
+        val manager = context.getSystemService(Context.NOTIFICATION_SERVICE) as NotificationManager
+        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O && manager.getNotificationChannel(CHANNEL) == null) {
+            manager.createNotificationChannel(NotificationChannel(
+                CHANNEL, LocaleController.getString(R.string.TeleOnlineChannel), NotificationManager.IMPORTANCE_DEFAULT))
+        }
+        // the name is hidden when the stock notifications hide the previews
+        val preview = MessagesController.getNotificationsSettings(account).getBoolean("EnablePreviewAll", true)
+        val text = if (preview) {
+            LocaleController.formatString(R.string.TeleOnlineText, UserObject.getUserName(user))
+        } else {
+            LocaleController.getString(R.string.TeleOnlineHidden)
+        }
+        val intent = Intent(context, LaunchActivity::class.java)
+        intent.action = "com.tmessages.openchat" + Math.random() + Integer.MAX_VALUE
+        intent.flags = Intent.FLAG_ACTIVITY_CLEAR_TOP
+        intent.addCategory(Intent.CATEGORY_LAUNCHER)
+        intent.putExtra("userId", user.id)
+        intent.putExtra("currentAccount", account)
+        val id = "$KEY:$account:${user.id}".hashCode()
+        val content = PendingIntent.getActivity(context, id, intent, PendingIntent.FLAG_IMMUTABLE or PendingIntent.FLAG_UPDATE_CURRENT)
+        val notification = NotificationCompat.Builder(context, CHANNEL)
+            .setSmallIcon(R.drawable.tele_stat_notification)
+            .setContentTitle(LocaleController.getString(R.string.AppName))
+            .setContentText(text)
+            .setCategory(NotificationCompat.CATEGORY_STATUS)
+            .setAutoCancel(true)
+            .setContentIntent(content)
+            .build()
+        manager.notify(id, notification)
+    }
+
+    private fun set(account: Int): LinkedHashSet<Long> {
+        var current = watched[account]
+        if (current == null) {
+            current = load(account)
+            watched[account] = current
+        }
+        return current
+    }
+
+    private fun load(account: Int): LinkedHashSet<Long> {
+        val result = LinkedHashSet<Long>()
+        val raw = TeleDatabaseHelper.get("$KEY:$account") ?: return result
+        runCatching {
+            val array = JSONArray(raw)
+            for (i in 0 until array.length()) {
+                val id = array.optLong(i, 0L)
+                if (id > 0 && result.size < MAX_USERS) result.add(id)
+            }
+        }
+        return result
+    }
+
+    private fun save(account: Int, ids: Set<Long>) {
+        val array = JSONArray()
+        for (id in ids) array.put(id)
+        TeleDatabaseHelper.put("$KEY:$account", array.toString())
+    }
+
+    private fun log(text: String) {
+        if (BuildVars.LOGS_ENABLED) FileLog.d("TeleOnline: $text")
+    }
+}
