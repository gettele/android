From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Sat, 7 Nov 2026 12:02:22 +0300
Subject: [PATCH] fix: stop the name badge icons from leaking chats

---
 .../src/main/java/tele/ui/TeleNameBadges.kt   | 28 +++++++++++++++----
 1 file changed, 22 insertions(+), 6 deletions(-)

diff --git a/TMessagesProj/src/main/java/tele/ui/TeleNameBadges.kt b/TMessagesProj/src/main/java/tele/ui/TeleNameBadges.kt
index 004cab89f..fc316aecb 100644
--- a/TMessagesProj/src/main/java/tele/ui/TeleNameBadges.kt
+++ b/TMessagesProj/src/main/java/tele/ui/TeleNameBadges.kt
@@ -72,10 +72,19 @@ object TeleNameBadges {
         val icon = AnimatedEmojiDrawable.SwapAnimatedEmojiDrawable(view, (view.textSize * 1.15f).toInt(), AnimatedEmojiDrawable.CACHE_TYPE_EMOJI_STATUS)
         icon.setCurrentAccount(account)
         icon.setColor(Theme.getColor(Theme.key_profile_verifiedBackground))
-        if (view.isAttachedToWindow) icon.attach()
+        if (view.isAttachedToWindow) icon.attach() else icon.setParentView(null)
         view.addOnAttachStateChangeListener(object : View.OnAttachStateChangeListener {
-            override fun onViewAttachedToWindow(v: View) = icon.attach()
-            override fun onViewDetachedFromWindow(v: View) = icon.detach()
+            override fun onViewAttachedToWindow(v: View) {
+                icon.attach()
+                icon.setParentView(v)
+            }
+
+            override fun onViewDetachedFromWindow(v: View) {
+                icon.detach()
+                // the drawable holds the view as its invalidation parent; clearing it breaks the
+                // weak-map value -> key reference that would otherwise pin the view forever
+                icon.setParentView(null)
+            }
         })
         headerIcons[view] = icon
         return icon
@@ -211,11 +220,18 @@ object TeleNameBadges {
             cellIcons[view] = it
             view.addOnAttachStateChangeListener(object : View.OnAttachStateChangeListener {
                 override fun onViewAttachedToWindow(v: View) {
-                    cellIcons[v]?.forEach { icon -> icon?.attach() }
+                    cellIcons[v]?.forEach { icon ->
+                        icon?.attach()
+                        icon?.setParentView(v)
+                    }
                 }
 
                 override fun onViewDetachedFromWindow(v: View) {
-                    cellIcons[v]?.forEach { icon -> icon?.detach() }
+                    cellIcons[v]?.forEach { icon ->
+                        icon?.detach()
+                        // see headerIcon: the drawable must not keep its own weak-map key alive
+                        icon?.setParentView(null)
+                    }
                 }
             })
         }
@@ -226,7 +242,7 @@ object TeleNameBadges {
         val icon = AnimatedEmojiDrawable.SwapAnimatedEmojiDrawable(view, size, AnimatedEmojiDrawable.CACHE_TYPE_EMOJI_STATUS)
         icon.setCurrentAccount(account)
         icon.setColor(Theme.getColor(Theme.key_chats_verifiedBackground))
-        if (view.isAttachedToWindow) icon.attach()
+        if (view.isAttachedToWindow) icon.attach() else icon.setParentView(null)
         slots[slot] = icon
         return icon
     }
