index 000000000..aa4aabd21
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/ui/TeleMenuGap.kt
@@ -0,0 +1,35 @@
+package tele.ui
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.drawable.Drawable
+import android.widget.FrameLayout
+import org.telegram.messenger.R
+import org.telegram.ui.ActionBar.Theme
+
+/** The stock thick menu gap, but not a GapView so the menu's item animation moves it with the rows. */
+class TeleMenuGap(context: Context, resourcesProvider: Theme.ResourcesProvider?) : FrameLayout(context) {
+
+    private val shadow: Drawable? = Theme.getThemedDrawable(
+        context,
+        R.drawable.greydivider,
+        Theme.getColor(Theme.key_windowBackgroundGrayShadow, resourcesProvider)
+    )
+
+    init {
+        setBackgroundColor(Theme.getColor(Theme.key_actionBarDefaultSubmenuSeparator, resourcesProvider))
+    }
+
+    fun setColor(color: Int): TeleMenuGap {
+        setBackgroundColor(color)
+        return this
+    }
+
+    override fun onDraw(canvas: Canvas) {
+        super.onDraw(canvas)
+        shadow?.let {
+            it.setBounds(0, 0, width, height)
+            it.draw(canvas)
+        }
+    }
+}
