                 return;
             }
-            teleOpenDialog(dialogId);
+            teleOpenShortcut(slot);
         });
         tab.setOnLongClickListener(v -> teleOpenShortcutMenu(v, slot));
         return tab;
     }
 
+    private void teleOpenShortcut(tele.helpers.MainTabsConfig.Slot slot) {
+        if (tele.helpers.MainTabsConfig.KIND_NEW_MESSAGE.equals(slot.getKind())) {
+            final Bundle args = new Bundle();
+            args.putBoolean("destroyAfterSelect", true);
+            presentFragment(new ContactsActivity(args));
+        } else if (tele.helpers.MainTabsConfig.KIND_CAMERA.equals(slot.getKind())) {
+            teleOpenCameraChat();
+        } else if (tele.helpers.MainTabsConfig.KIND_CONTACTS_SAVED.equals(slot.getKind())) {
+            presentFragment(new ContactsActivity(new Bundle()));
+        } else {
+            teleOpenDialog(teleDialogIdOf(slot));
+        }
+    }
+
     private long teleDialogIdOf(tele.helpers.MainTabsConfig.Slot slot) {
         if (tele.helpers.MainTabsConfig.KIND_SAVED.equals(slot.getKind())) {
             return getUserConfig().getClientUserId();
