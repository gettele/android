-            tab.setCounter(null, true, true);
+        final boolean show = Build.VERSION.SDK_INT >= 23 && UserConfig.getInstance(currentAccount).syncContacts && !hasPermission && MessagesController.getGlobalNotificationsSettings().getBoolean("askAboutContacts2", true);
+        if (tab != null) {
+            tab.setCounter(show ? "!" : null, true, true);
+        }
+        if (shortcut != null) {
+            shortcut.setCounter(show ? "!" : null, true, true);
         }
     }
 
