             return;
         }
         final boolean hasPermission = Build.VERSION.SDK_INT >= 23 && ContactsController.hasContactsPermission();
         if (hasPermission) {
             MessagesController.getGlobalNotificationsSettings().edit().putBoolean("askAboutContacts2", true).apply();
