From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: test <test@example.com>
Date: Wed, 11 Nov 2026 17:16:10 +0300
Subject: [PATCH] fix: backport quickjs suspension guards

---
 TMessagesProj/jni/third_party/quickjs-ng/quickjs.c | 14 +++++++++++---
 .../ios/Sources/CQuickJS/quickjs/quickjs.c         | 14 +++++++++++---
 2 files changed, 22 insertions(+), 6 deletions(-)

diff --git a/TMessagesProj/jni/third_party/quickjs-ng/quickjs.c b/TMessagesProj/jni/third_party/quickjs-ng/quickjs.c
index 6ca030b9f..225c567b9 100644
--- a/TMessagesProj/jni/third_party/quickjs-ng/quickjs.c
+++ b/TMessagesProj/jni/third_party/quickjs-ng/quickjs.c
@@ -20855,17 +20855,23 @@ static JSValue JS_CallInternal(JSContext *caller_ctx, JSValueConst func_obj,
 
         CASE(OP_await):
             ret_val = js_int32(FUNC_RET_AWAIT);
-            goto done_generator;
+            goto generator_exit;
         CASE(OP_yield):
             ret_val = js_int32(FUNC_RET_YIELD);
-            goto done_generator;
+            goto generator_exit;
         CASE(OP_yield_star):
         CASE(OP_async_yield_star):
             ret_val = js_int32(FUNC_RET_YIELD_STAR);
-            goto done_generator;
+            goto generator_exit;
         CASE(OP_return_async):
         CASE(OP_initial_yield):
             ret_val = JS_UNDEFINED;
+        generator_exit:
+            /* A normal frame must close its stack-backed variable references. */
+            if (unlikely(b->func_kind == JS_FUNC_NORMAL)) {
+                JS_ThrowInternalError(ctx, "suspending opcode in a normal function");
+                goto exception;
+            }
             goto done_generator;
 
         CASE(OP_nop):
@@ -29107,6 +29113,8 @@ static __exception int js_parse_for_in_of(JSParseState *s, int label_name,
     bool is_await_using = false;
     if (tok == TOK_AWAIT) {
         int u;
+        if (!(s->cur_func->func_kind & JS_FUNC_ASYNC))
+            return js_parse_error(s, "await using declaration is only valid in async functions");
         if (next_token(s))
             return -1;
         u = is_using(s, false);
diff --git a/TMessagesProj/jni/twidget/widget-sandbox/packages/ios/Sources/CQuickJS/quickjs/quickjs.c b/TMessagesProj/jni/twidget/widget-sandbox/packages/ios/Sources/CQuickJS/quickjs/quickjs.c
index 63d8487cc..83afccd1f 100644
--- a/TMessagesProj/jni/twidget/widget-sandbox/packages/ios/Sources/CQuickJS/quickjs/quickjs.c
+++ b/TMessagesProj/jni/twidget/widget-sandbox/packages/ios/Sources/CQuickJS/quickjs/quickjs.c
@@ -21588,17 +21588,23 @@ static JSValue JS_CallInternal(JSContext *caller_ctx, JSValueConst func_obj,
 
         CASE(OP_await):
             ret_val = js_int32(FUNC_RET_AWAIT);
-            goto done_generator;
+            goto generator_exit;
         CASE(OP_yield):
             ret_val = js_int32(FUNC_RET_YIELD);
-            goto done_generator;
+            goto generator_exit;
         CASE(OP_yield_star):
         CASE(OP_async_yield_star):
             ret_val = js_int32(FUNC_RET_YIELD_STAR);
-            goto done_generator;
+            goto generator_exit;
         CASE(OP_return_async):
         CASE(OP_initial_yield):
             ret_val = JS_UNDEFINED;
+        generator_exit:
+            /* A normal frame must close its stack-backed variable references. */
+            if (unlikely(b->func_kind == JS_FUNC_NORMAL)) {
+                JS_ThrowInternalError(ctx, "suspending opcode in a normal function");
+                goto exception;
+            }
             goto done_generator;
 
         CASE(OP_nop):
@@ -29841,6 +29847,8 @@ static __exception int js_parse_for_in_of(JSParseState *s, int label_name,
     bool is_await_using = false;
     if (tok == TOK_AWAIT) {
         int u;
+        if (!(s->cur_func->func_kind & JS_FUNC_ASYNC))
+            return js_parse_error(s, "await using declaration is only valid in async functions");
         if (next_token(s))
             return -1;
         u = is_using(s, false);
