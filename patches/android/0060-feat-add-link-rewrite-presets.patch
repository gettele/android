-            val target = if (rule.random && rule.to.size > 1) rule.to[(url.hashCode() and 0x7fffffff) % rule.to.size] else rule.to.first()
+            val target = if (rule.random && rule.to.size > 1) rule.to[kotlin.random.Random.nextInt(rule.to.size)] else rule.to.first()
             val hostEnd = hostStart + host.length
             return url.substring(0, hostStart) + prefix + target + url.substring(hostEnd)
