+++ b/TMessagesProj/src/main/java/tele/helpers/TeleUsernames.kt
@@ -0,0 +1,95 @@
+package tele.helpers
+
+import org.telegram.tgnet.ConnectionsManager
+import org.telegram.tgnet.TLRPC
+import tele.TeleConfig
+
+// tele server usernames (tele 0093): extra @aliases shown next to a peer's real usernames and resolved to them
+object TeleUsernames {
+    private class Alias(val alias: String, val position: Int)
+    private class Index(val source: TeleBadges.ServerData, val targets: Map<String, String>, val aliases: Map<String, List<Alias>>)
+
+    private val usernamePattern = Regex("[A-Za-z][A-Za-z0-9_]*")
+
+    @Volatile
+    private var cached: Index? = null
+
+    private fun index(account: Int): Index? {
+        if (!TeleConfig.SERVER_USERNAMES.value || ConnectionsManager.getInstance(account).isTestBackend()) return null
+        val data = TeleBadges.current() ?: return null
+        cached?.let { if (it.source === data) return it }
+        val targets = HashMap<String, String>()
+        val aliases = HashMap<String, MutableList<Alias>>()
+        for ((alias, entry) in data.usernames) {
+            if (!usernamePattern.matches(alias) || !usernamePattern.matches(entry.username) || alias.equals(entry.username, true)) continue
+            targets[alias.lowercase()] = entry.username
+            aliases.getOrPut(entry.username.lowercase()) { ArrayList() }.add(Alias(alias, entry.position ?: -1))
+        }
+        // a target that is itself an alias would make resolving recurse
+        targets.entries.removeAll { targets.containsKey(it.value.lowercase()) }
+        aliases.values.forEach { list -> list.sortBy { it.position } }
+        return Index(data, targets, aliases).also { cached = it }
+    }
+
+    // real username behind a server alias; local aliases (0072) take precedence
+    @JvmStatic
+    fun target(account: Int, username: String?): String? {
+        if (username.isNullOrEmpty() || Aliases.dialogId(account, username) != 0L) return null
+        return index(account)?.targets?.get(username.lowercase())
+    }
+
+    // server aliases starting with the query whose real username belongs to a loaded peer; for @-mention suggestions
+    @JvmStatic
+    fun matchingPeers(account: Int, query: String?): List<android.util.Pair<String, Long>> {
+        if (query.isNullOrEmpty()) return emptyList()
+        val index = index(account) ?: return emptyList()
+        val q = query.lowercase()
+        val controller = org.telegram.messenger.MessagesController.getInstance(account)
+        val out = ArrayList<android.util.Pair<String, Long>>()
+        for ((alias, target) in index.targets) {
+            if (!alias.startsWith(q) || Aliases.dialogId(account, alias) != 0L) continue
+            val did = when (val peer = controller.getUserOrChat(target)) {
+                is TLRPC.User -> peer.id
+                is TLRPC.Chat -> -peer.id
+                else -> continue
+            }
+            out.add(android.util.Pair(alias, did))
+        }
+        out.sortBy { it.first }
+        return out
+    }
+
+    // peer usernames with server aliases inserted at their feed positions, primary first; null when nothing applies
+    @JvmStatic
+    fun withServerUsernames(account: Int, primary: String?, usernames: List<TLRPC.TL_username?>?): ArrayList<TLRPC.TL_username>? {
+        val index = index(account) ?: return null
+        val result = ArrayList<TLRPC.TL_username>()
+        if (!primary.isNullOrEmpty()) {
+            result.add(usernames?.firstOrNull { it?.username.equals(primary, true) } ?: username(primary))
+        }
+        usernames?.forEach { u ->
+            if (u != null && u.active && !u.username.isNullOrEmpty() && result.none { it.username.equals(u.username, true) }) result.add(u)
+        }
+        val found = result.flatMap { index.aliases[it.username.lowercase()].orEmpty() }.sortedBy { it.position }
+        var added = false
+        var last = -1
+        for (a in found) {
+            if (result.any { it.username.equals(a.alias, true) } || Aliases.dialogId(account, a.alias) != 0L) continue
+            added = true
+            if (a.position < 0) {
+                result.add(username(a.alias))
+                continue
+            }
+            val at = maxOf(minOf(a.position, result.size), last + 1)
+            result.add(at, username(a.alias))
+            last = at
+        }
+        return if (added) result else null
+    }
+
+    private fun username(name: String) = TLRPC.TL_username().apply {
+        username = name
+        active = true
+        editable = true
+    }
+}
