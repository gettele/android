+    private fun mentionForAlias(account: Int, alias: String, offset: Int): Pair<TLRPC.MessageEntity, String>? {
+        val did = dialogId(account, alias)
+        if (did != 0L) return mentionFor(account, did, offset, alias.length + 1)
+        val target = TeleUsernames.target(account, alias) ?: return null
+        return Pair(TLRPC.TL_messageEntityMention().also {
+            it.offset = offset
+            it.length = target.length + 1
+        }, "@$target")
+    }
+
+    // formatting must cover the whole token; code, links and other text-bound entities keep it untouched
+    private fun replaceable(entities: List<TLRPC.MessageEntity>?, from: Int, till: Int): Boolean {
+        entities ?: return true
+        for (e in entities) {
+            val start = e.offset
+            val end = e.offset + e.length
+            if (end <= from || start >= till) continue
+            if (keepsText(e) || start > from || end < till) return false
+        }
+        return true
+    }
+
+    private fun keepsText(e: TLRPC.MessageEntity) =
+        e is TLRPC.TL_messageEntityCode || e is TLRPC.TL_messageEntityPre || e is TLRPC.TL_messageEntityUrl ||
+            e is TLRPC.TL_messageEntityTextUrl || e is TLRPC.TL_messageEntityEmail || e is TLRPC.TL_messageEntityMention ||
+            e is TLRPC.TL_messageEntityMentionName || e is TLRPC.TL_inputMessageEntityMentionName ||
+            e is TLRPC.TL_messageEntityBotCommand || e is TLRPC.TL_messageEntityHashtag || e is TLRPC.TL_messageEntityCashtag ||
+            e is TLRPC.TL_messageEntityCustomEmoji || e is TLRPC.TL_messageEntityPhone || e is TLRPC.TL_messageEntityBankCard
+
+    private fun shiftEntities(entities: List<TLRPC.MessageEntity>?, from: Int, till: Int, delta: Int) {
+        if (entities == null || delta == 0) return
+        for (e in entities) {
+            if (e.offset >= till) {
+                e.offset += delta
+            } else if (e.offset <= from && e.offset + e.length >= till) {
+                e.length += delta
+            }
+        }
+    }
