From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Wed, 4 Nov 2026 01:04:09 +0300
Subject: [PATCH] feat: give script menus icons

---
 .../main/java/org/telegram/ui/ChatActivity.java  |  2 +-
 .../src/main/java/tele/scripting/ScriptMenu.kt   | 16 ++++++++++++++++
 2 files changed, 17 insertions(+), 1 deletion(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
index d168ae717..503592a6e 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
@@ -47851,7 +47851,7 @@ public class ChatActivity extends BaseFragment implements
                 final tele.scripting.ScriptMenuItem tele_item = tele_script_items.get(tele_i);
                 items.add(0, tele_item.text);
                 options.add(0, tele_option_script_base + tele_i);
-                icons.add(0, 0);
+                icons.add(0, tele.scripting.ScriptMenu.iconRes(tele_item.icon));
                 tele_scriptMenuItems.add(tele_item);
             }
         }
diff --git a/TMessagesProj/src/main/java/tele/scripting/ScriptMenu.kt b/TMessagesProj/src/main/java/tele/scripting/ScriptMenu.kt
index d3cbea16b..868923ac7 100644
--- a/TMessagesProj/src/main/java/tele/scripting/ScriptMenu.kt
+++ b/TMessagesProj/src/main/java/tele/scripting/ScriptMenu.kt
@@ -63,4 +63,20 @@ object ScriptMenu {
         val runtime = Scripts.runtime(account, scriptId) ?: return false
         return runtime.dispatch(callbackId, "menu", JSONArray().put(context))
     }
+
+    @JvmStatic
+    fun iconRes(name: String?): Int = when (name?.lowercase()) {
+        "copy" -> org.telegram.messenger.R.drawable.msg_copy
+        "delete" -> org.telegram.messenger.R.drawable.msg_delete
+        "edit" -> org.telegram.messenger.R.drawable.msg_edit
+        "info" -> org.telegram.messenger.R.drawable.msg_info
+        "link" -> org.telegram.messenger.R.drawable.msg_link
+        "message" -> org.telegram.messenger.R.drawable.msg_message
+        "search" -> org.telegram.messenger.R.drawable.msg_search
+        "settings" -> org.telegram.messenger.R.drawable.msg_settings
+        "star" -> org.telegram.messenger.R.drawable.msg_fave
+        "stats" -> org.telegram.messenger.R.drawable.msg_stats
+        "forward" -> org.telegram.messenger.R.drawable.msg_forward
+        else -> 0
+    }
 }
