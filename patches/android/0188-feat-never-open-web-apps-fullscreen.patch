index f5a1e2afe..661641ecc 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt
@@ -275,6 +275,8 @@ object TeleSearch {
             section(1353, "Online count with a hidden member list", "chats", TeleSettingsActivity.MODE_CHATS, "Show online members in big groups"),
             section(1354, "Hide and show the pinned bar", "menus", TeleSettingsActivity.MODE_MENUS),
             section(1355, "Hide pinned messages from the chat menu", "menus", TeleSettingsActivity.MODE_MENUS, "Hide and show the pinned bar"),
+            section(1356, "Never open web apps in fullscreen", "bots", TeleSettingsActivity.MODE_BOTS),
+            section(1357, "Mini apps without fullscreen", "bots", TeleSettingsActivity.MODE_BOTS, "Never open web apps in fullscreen"),
             section(1337, "Count typed emoji in recent emoji", "sending", TeleSettingsActivity.MODE_SENDING),
             section(1338, "Recent emoji from the keyboard", "sending", TeleSettingsActivity.MODE_SENDING, "Count typed emoji in recent emoji"),
             section(1335, "Rewrite only the link preview", "privacy", TeleSettingsActivity.MODE_PRIVACY),
diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
index 44d614d35..7ca24fd9a 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
@@ -804,6 +804,7 @@ class TeleSettingsActivity @JvmOverloads constructor(private val mode: String =
             "Show sticker captions" to "Captions show under stickers and in previews.",
             "Send stickers with captions" to "Text in the field goes out as the caption of a sticker.",
             "Hide and show the pinned bar" to "Adds it to the chat menu when you can't pin messages there.",
+            "Never open web apps in fullscreen" to "Mini apps always open in a window; fullscreen requests are refused.",
             "Show online members in big groups" to "Also when the member list is hidden; the count comes from the server.",
             "Mention several people in a row" to "Long-press a person in the mention list to add them and pick the next one.",
         )
@@ -1120,6 +1121,9 @@ class TeleSettingsActivity @JvmOverloads constructor(private val mode: String =
                 Row(TYPE_HEADER, "Bot buttons"),
                 toggle("Show bot button payloads on long press", TeleConfig.BOT_BUTTON_PAYLOADS),
                 Row(TYPE_SHADOW),
+                Row(TYPE_HEADER, "Mini apps"),
+                toggle("Never open web apps in fullscreen", TeleConfig.WEBAPPS_NO_FULLSCREEN),
+                Row(TYPE_SHADOW),
                 Row(TYPE_HEADER, "Inline results"),
                 toggle("Inline results without via", TeleConfig.INLINE_NO_VIA),
                 Row(TYPE_SHADOW)
