From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Sun, 25 Oct 2026 08:40:54 +0300
Subject: [PATCH 188/194] feat: never open web apps fullscreen

---
 .../src/main/java/org/telegram/ui/bots/BotWebViewSheet.java   | 4 ++++
 TMessagesProj/src/main/java/tele/TeleConfig.kt                | 2 ++
 TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt    | 2 ++
 .../src/main/java/tele/ui/settings/TeleSettingsActivity.kt    | 4 ++++
 4 files changed, 12 insertions(+)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/bots/BotWebViewSheet.java b/TMessagesProj/src/main/java/org/telegram/ui/bots/BotWebViewSheet.java
index e72cb292f..b40fa1fc3 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/bots/BotWebViewSheet.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/bots/BotWebViewSheet.java
@@ -844,6 +844,9 @@ public class BotWebViewSheet extends Dialog implements NotificationCenter.Notifi
 
             @Override
             public String onFullscreenRequested(boolean fullscreen, boolean blur) {
+                if (fullscreen && tele.TeleConfig.WEBAPPS_NO_FULLSCREEN.getValue()) {
+                    return "UNSUPPORTED";
+                }
                 if (BotWebViewSheet.this.fullscreen == fullscreen) {
                     if (BotWebViewSheet.this.fullscreen)
                         return "ALREADY_FULLSCREEN";
@@ -2273,6 +2276,7 @@ public class BotWebViewSheet extends Dialog implements NotificationCenter.Notifi
         setFullscreen(fullscreen, animated, fullscreenBlur);
     }
     public void setFullscreen(boolean fullscreen, boolean animated, boolean blur) {
+        if (fullscreen && tele.TeleConfig.WEBAPPS_NO_FULLSCREEN.getValue()) return;
         if (this.fullscreen == fullscreen) return;
         this.fullscreen = fullscreen;
         this.fullscreenBlur = blur && !MessagesController.getInstance(currentAccount).disableBotFullscreenBlur && SharedConfig.getDevicePerformanceClass() >= SharedConfig.PERFORMANCE_CLASS_HIGH;
diff --git a/TMessagesProj/src/main/java/tele/TeleConfig.kt b/TMessagesProj/src/main/java/tele/TeleConfig.kt
index 01fb3af4b..1f9d35acc 100644
--- a/TMessagesProj/src/main/java/tele/TeleConfig.kt
+++ b/TMessagesProj/src/main/java/tele/TeleConfig.kt
@@ -295,6 +295,8 @@ object TeleConfig {
     @JvmField
     val HIDE_BOT_EDITED_LABEL = BoolItem("hide_bot_edited_label", false)
     @JvmField
+    val WEBAPPS_NO_FULLSCREEN = BoolItem("webapps_no_fullscreen", false)
+    @JvmField
     val SHOW_START_PARAMETER = BoolItem("show_start_parameter", false)
     @JvmField
     val TITLE_TEMPLATE = StringItem("title_template", "tele {build}")
