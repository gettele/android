+    private fun namesOf(message: TLRPC.Message): String {
+        val result = LinkedHashSet<String>()
+        MessageObject.getPhoto(message)?.sizes?.forEach { add(result, FileLoader.getAttachFileName(it)) }
+        MessageObject.getDocument(message)?.let { document ->
+            add(result, FileLoader.getAttachFileName(document))
+            document.thumbs?.forEach { add(result, FileLoader.getAttachFileName(it)) }
+        }
+        return result.joinToString("\n")
+    }
+
     private fun add(result: MutableSet<String>, name: String?) {
         if (!name.isNullOrEmpty()) result.add(name)
     }
+
+    private fun cacheDir(): File? = FileLoader.getDirectory(FileLoader.MEDIA_DIR_CACHE)
+
+    private fun keptDir() = File(ApplicationLoader.getFilesDirFixed(), "tele_kept")
+
+    private fun usable(name: String) = name.isNotEmpty() && '/' !in name && !name.endsWith(PART)
+
+    private fun copyFile(from: File, to: File) {
+        val part = File(to.parentFile, to.name + PART)
+        part.parentFile?.mkdirs()
+        from.copyTo(part, true)
+        if (!part.renameTo(to)) part.delete()
+    }
+
+    // only the cache directory is cleared by the system, the media directories are app files
+    private fun copy(list: List<String>) {
+        val cache = cacheDir() ?: return
+        val dir = keptDir()
+        var total = dir.listFiles()?.sumOf { it.length() } ?: 0L
+        for (name in list) {
+            if (!usable(name)) continue
+            for (variant in arrayOf(name, "q_$name")) {
+                val from = File(cache, variant)
+                val to = File(dir, variant)
+                if (!from.isFile || to.exists()) continue
+                val size = from.length()
+                if (size > COPY_LIMIT || total + size > COPY_LIMIT) continue
+                copyFile(from, to)
+                total += size
+            }
+        }
+    }
+
+    private fun restore() {
+        val cache = cacheDir() ?: return
+        for (file in keptDir().listFiles() ?: return) {
+            if (!usable(file.name)) continue
+            val to = File(cache, file.name)
+            if (!to.exists()) copyFile(file, to)
+        }
+    }
+
+    private fun collect() {
+        val files = keptDir().listFiles() ?: return
+        val keep = snapshot(true)
+        for (file in files) {
+            if (!usable(file.name) || !covers(keep, file.name)) file.delete()
+        }
+    }
 }
