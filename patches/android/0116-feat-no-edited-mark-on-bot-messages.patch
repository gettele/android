 TMessagesProj/src/main/java/tele/TeleConfig.kt         |  2 ++
 TMessagesProj/src/main/java/tele/TeleHooks.kt          | 10 ++++++++++
 .../src/main/java/tele/ui/settings/TeleSearch.kt       |  1 +
 .../main/java/tele/ui/settings/TeleSettingsActivity.kt |  2 ++
 5 files changed, 18 insertions(+)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Cells/ChatMessageCell.java b/TMessagesProj/src/main/java/org/telegram/ui/Cells/ChatMessageCell.java
index b8ae48bb9..1f73bb972 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Cells/ChatMessageCell.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Cells/ChatMessageCell.java
@@ -18514,6 +18514,9 @@ public class ChatMessageCell extends BaseCell implements SeekBar.SeekBarDelegate
             edited = false;
         } else if (currentPosition == null || currentMessagesGroup == null || currentMessagesGroup.messages.isEmpty()) {
             edited = (messageObject.messageOwner.flags & TLRPC.MESSAGE_FLAG_EDITED) != 0 || messageObject.isEditing();
+            if (edited && tele.TeleConfig.HIDE_BOT_EDITED_LABEL.getValue() && tele.TeleHooks.isBotMessage(currentAccount, messageObject)) {
+                edited = false;
+            }
         } else {
             edited = false;
             hasReplies = currentMessagesGroup.messages.get(0).hasReplies();
diff --git a/TMessagesProj/src/main/java/tele/TeleConfig.kt b/TMessagesProj/src/main/java/tele/TeleConfig.kt
