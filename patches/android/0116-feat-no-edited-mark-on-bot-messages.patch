--- a/TMessagesProj/src/main/java/tele/TeleConfig.kt
+++ b/TMessagesProj/src/main/java/tele/TeleConfig.kt
@@ -212,6 +212,8 @@ object TeleConfig {
     val HIDE_PHONE_IN_PROFILES = BoolItem("hide_phone_in_profiles", false)
     @JvmField
     val REDUCE_MOTION = BoolItem("reduce_motion", false)
+    @JvmField
+    val HIDE_BOT_EDITED_LABEL = BoolItem("hide_bot_edited_label", false)
 
     private var prefs: SharedPreferences? = null
 
diff --git a/TMessagesProj/src/main/java/tele/TeleHooks.kt b/TMessagesProj/src/main/java/tele/TeleHooks.kt
index 7742b9c2f..ea4cda0c3 100644
--- a/TMessagesProj/src/main/java/tele/TeleHooks.kt
+++ b/TMessagesProj/src/main/java/tele/TeleHooks.kt
@@ -52,6 +52,16 @@ object TeleHooks {
             (if (is24Hour) cloud24 else cloud12) ?: ""
         }
 
+    // a message of a bot, sent by the bot itself or through another one
+    @JvmStatic
+    fun isBotMessage(account: Int, message: MessageObject?): Boolean {
+        val owner = message?.messageOwner ?: return false
+        if (owner.via_bot_id != 0L) return true
+        val fromId = (owner.from_id as? TLRPC.TL_peerUser)?.user_id ?: 0L
+        if (fromId == 0L) return false
+        return MessagesController.getInstance(account).getUser(fromId)?.bot == true
+    }
+
     // a service message shows its own time when the seconds are on
     @JvmStatic
     fun withServiceTime(message: MessageObject?, text: CharSequence?): CharSequence? {
