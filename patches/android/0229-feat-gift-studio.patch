@@ -0,0 +1,398 @@
+package tele.ui
+
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.Canvas
+import android.graphics.LinearGradient
+import android.graphics.Paint
+import android.graphics.RectF
+import android.graphics.Shader
+import android.graphics.Typeface
+import android.text.TextPaint
+import android.text.TextUtils
+import android.view.View
+import android.widget.FrameLayout
+import android.widget.LinearLayout
+import android.widget.TextView
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.ImageLocation
+import org.telegram.messenger.ImageReceiver
+import org.telegram.messenger.LocaleController
+import org.telegram.tgnet.tl.TL_stars
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Components.LayoutHelper
+import org.telegram.ui.Gifts.GiftSheet
+import org.telegram.ui.Stars.StarsIntroActivity
+import tele.helpers.GiftStudio
+
+/**
+ * The preview of the gift studio (desktop 0197): the same gift in four layouts, like the desktop
+ * client. Cover is the big card, Tile and Card are the compact card with the table of the parts,
+ * and Sticker is only the model on nothing. The picture is drawn on a canvas, so the preview and
+ * the saved file are the same picture.
+ */
+class TeleGiftPreview(
+    private val context: Context,
+    private val account: Int,
+    private val resourcesProvider: Theme.ResourcesProvider?
+) {
+
+    /** The layout of the preview, like the desktop client. */
+    enum class Layout(val id: Int) {
+        Cover(0), Tile(1), Sticker(2), Card(3);
+
+        companion object {
+            fun of(id: Int): Layout = entries.firstOrNull { it.id == id } ?: Cover
+        }
+    }
+
+    /** The parts of the gift, chosen in the studio. */
+    class Parts(
+        @JvmField var title: String = "",
+        @JvmField var number: String = "",
+        @JvmField var subtitle: String = "",
+        @JvmField var model: GiftStudio.Part? = null,
+        @JvmField var backdrop: GiftStudio.Part? = null,
+        @JvmField var symbol: GiftStudio.Part? = null
+    )
+
+    /** The canvas of the preview; a save draws it into a bitmap of the same size. */
+    private inner class CanvasView(context: Context) : View(context) {
+        // the lottie frames are decoded in the background, so the canvas is redrawn while they run
+        private val tick: Runnable = Runnable {
+            if (renderer.animating()) {
+                invalidate()
+                postDelayed(tick, 1000L / 30L)
+            }
+        }
+
+        override fun onAttachedToWindow() {
+            super.onAttachedToWindow()
+            removeCallbacks(tick)
+            post(tick)
+        }
+
+        override fun onDetachedFromWindow() {
+            super.onDetachedFromWindow()
+            removeCallbacks(tick)
+        }
+
+        override fun onDraw(canvas: Canvas) {
+            renderer.draw(canvas, width, height)
+        }
+    }
+
+    /** Draws the gift parts on a canvas in the chosen layout. */
+    private inner class Renderer {
+        private val modelReceiver = ImageReceiver()
+        private val symbolReceiver = ImageReceiver()
+
+        init {
+            modelReceiver.setDelegate(ImageReceiver.ImageReceiverDelegate { receiver, _, _, _ ->
+                if (receiver == modelReceiver) view.invalidate()
+            })
+            symbolReceiver.setDelegate(ImageReceiver.ImageReceiverDelegate { receiver, _, _, _ ->
+                if (receiver == symbolReceiver) view.invalidate()
+            })
+        }
+
+        fun setModel(part: GiftStudio.Part?, gift: TL_stars.StarGift) {
+            modelReceiver.onDetachedFromWindow()
+            val document = part?.document ?: gift.getDocument()
+            if (document != null) {
+                modelReceiver.setImage(ImageLocation.getForDocument(document), "80_80", null, null, null, 0)
+            } else {
+                val path = part?.localPath ?: modelFile(gift)
+                // a .tgs of the catalog is a lottie animation, drawn on its own
+                val drawable = lottieOf(path)
+                if (drawable != null) {
+                    lottieModel = drawable
+                    drawable.start()
+                } else if (path != null) {
+                    modelReceiver.setImage(ImageLocation.getForPath(path), "80_80", null, null, null, 0)
+                } else {
+                    modelReceiver.clearImage()
+                }
+            }
+        }
+
+        fun setSymbol(part: GiftStudio.Part?, gift: TL_stars.StarGift) {
+            symbolReceiver.onDetachedFromWindow()
+            val document = part?.document
+            if (document != null) {
+                symbolReceiver.setImage(ImageLocation.getForDocument(document), "80_80", null, null, null, 0)
+            } else {
+                val path = symbolFile(gift)
+                val drawable = lottieOf(path)
+                if (drawable != null) {
+                    lottieSymbol = drawable
+                    drawable.start()
+                } else if (path != null) {
+                    symbolReceiver.setImage(ImageLocation.getForPath(path), "80_80", null, null, null, 0)
+                } else {
+                    symbolReceiver.clearImage()
+                }
+            }
+        }
+
+        /** The .tgs of a model of the catalog, downloaded by the studio. */
+        private fun modelFile(gift: TL_stars.StarGift): String? = studio?.modelFile(gift)
+
+        private var lottieModel: org.telegram.ui.Components.RLottieDrawable? = null
+        private var lottieSymbol: org.telegram.ui.Components.RLottieDrawable? = null
+
+        /** The lottie of a .tgs file, the way Telegram itself loads a gift model. */
+        private fun lottieOf(path: String?): org.telegram.ui.Components.RLottieDrawable? {
+            if (path == null || !path.endsWith(".tgs")) return null
+            val file = java.io.File(path)
+            if (!file.exists()) return null
+            val json = org.telegram.messenger.ImageLoader.decompressGzip(file) ?: return null
+            // null cache options: the stock path for a lottie that just draws
+            val drawable = org.telegram.ui.Components.RLottieDrawable(
+                file, json, 256, 256, null, true, null, 0, false
+            )
+            drawable.setAutoRepeat(1)
+            // without an attached view the first frame is decoded only on demand
+            drawable.setAllowDecodeSingleFrame(true)
+            return drawable
+        }
+
+        /** The .tgs of a symbol of the catalog, downloaded by the studio. */
+        private fun symbolFile(gift: TL_stars.StarGift): String? = studio?.symbolFile(gift)
+
+        fun release() {
+            modelReceiver.onDetachedFromWindow()
+            symbolReceiver.onDetachedFromWindow()
+            lottieModel?.stop()
+            lottieSymbol?.stop()
+        }
+
+        /** A lottie of the catalog is still running, so the canvas has to be redrawn. */
+        fun animating(): Boolean = lottieModel?.isRunning == true || lottieSymbol?.isRunning == true
+
+        fun draw(canvas: Canvas, width: Int, height: Int) {
+            val side = Math.min(width, height).toFloat()
+            when (layout) {
+                Layout.Sticker -> drawSticker(canvas, width, height, side)
+                Layout.Cover -> drawCover(canvas, width, height, side)
+                Layout.Tile, Layout.Card -> drawCard(canvas, width, height, side)
+            }
+        }
+
+        /** Sticker: only the model, on nothing. */
+        private fun drawSticker(canvas: Canvas, width: Int, height: Int, side: Float) {
+            val size = side * 0.9f
+            val left = (width - size) / 2f
+            val top = (height - size) / 2f
+            modelReceiver.setImageCoords(left, top, size, size)
+            modelReceiver.draw(canvas)
+            lottieModel?.setBounds(left.toInt(), top.toInt(), (left + size).toInt(), (top + size).toInt())
+            lottieModel?.draw(canvas)
+        }
+
+        /** Cover: the big card with the backdrop, the model, the symbol and the texts. */
+        private fun drawCover(canvas: Canvas, width: Int, height: Int, side: Float) {
+            drawBackdrop(canvas, 0f, 0f, width.toFloat(), height.toFloat())
+            // the model takes the free space above the texts: the card is taller than it is wide
+            val textTop = height * 0.8f
+            val modelSide = Math.min(
+                width * 0.72f,
+                textTop - height * 0.08f
+            )
+            modelReceiver.setImageCoords(
+                (width - modelSide) / 2f, height * 0.08f, modelSide, modelSide
+            )
+            modelReceiver.draw(canvas)
+            val left = (width - modelSide) / 2f
+            val top = height * 0.08f
+            lottieModel?.setBounds(left.toInt(), top.toInt(), (left + modelSide).toInt(), (top + modelSide).toInt())
+            lottieModel?.draw(canvas)
+            // the symbol sits between the model and the texts, so the texts stay readable
+            val symbolSide = side * 0.2f
+            val symbolTop = Math.min(
+                top + modelSide + AndroidUtilities.dp(4f),
+                textTop - symbolSide - AndroidUtilities.dp(4f)
+            )
+            symbolReceiver.setImageCoords(
+                (width - symbolSide) / 2f, symbolTop, symbolSide, symbolSide
+            )
+            symbolReceiver.draw(canvas)
+            val symbolLeft = (width - symbolSide) / 2f
+            lottieSymbol?.setBounds(symbolLeft.toInt(), symbolTop.toInt(), (symbolLeft + symbolSide).toInt(), (symbolTop + symbolSide).toInt())
+            lottieSymbol?.draw(canvas)
+            drawTexts(canvas, width, height)
+        }
+
+        /** Tile and Card: the compact card with the table of the parts. */
+        private fun drawCard(canvas: Canvas, width: Int, height: Int, side: Float) {
+            val radius = AndroidUtilities.dp(24f).toFloat()
+            val rect = RectF(0f, 0f, width.toFloat(), height.toFloat())
+            drawBackdrop(canvas, 0f, 0f, width.toFloat(), height.toFloat())
+            if (layout == Layout.Card) {
+                // the card is a flat box, so the backdrop is a rounded rectangle in it
+                cardPaint.shader = LinearGradient(
+                    0f, 0f, width.toFloat(), height.toFloat(),
+                    backdropColors(), null, Shader.TileMode.CLAMP
+                )
+                canvas.drawRoundRect(rect, radius, radius, cardPaint)
+                cardPaint.shader = null
+            }
+            val modelSide = Math.min(width, height) * 0.5f
+            modelReceiver.setImageCoords(
+                (width - modelSide) / 2f, height * 0.08f, modelSide, modelSide
+            )
+            modelReceiver.draw(canvas)
+            val left = (width - modelSide) / 2f
+            val top = height * 0.08f
+            lottieModel?.setBounds(left.toInt(), top.toInt(), (left + modelSide).toInt(), (top + modelSide).toInt())
+            lottieModel?.draw(canvas)
+            val textTop = height * 0.08f + modelSide + AndroidUtilities.dp(16f)
+            titlePaint.textSize = side * 0.075f
+            titlePaint.typeface = Typeface.DEFAULT_BOLD
+            canvas.drawText(
+                TextUtils.ellipsize(cardName(), titlePaint, width * 0.86f, TextUtils.TruncateAt.END).toString(),
+                width * 0.07f, textTop, titlePaint
+            )
+            var y = textTop + AndroidUtilities.dp(18f)
+            for (row in rows()) {
+                rowPaint.textSize = side * 0.055f
+                canvas.drawText(
+                    TextUtils.ellipsize(row, rowPaint, width * 0.86f, TextUtils.TruncateAt.END).toString(),
+                    width * 0.07f, y, rowPaint
+                )
+                y += AndroidUtilities.dp(16f)
+            }
+        }
+
+        /** The gradient of the backdrop of the gift. */
+        private fun backdropColors(): IntArray {
+            val backdrop = parts.backdrop
+            if (backdrop == null || backdrop.centerColor == 0 && backdrop.edgeColor == 0) {
+                return intArrayOf(0xFF8E6CF0.toInt(), 0xFF3C2A8C.toInt())
+            }
+            val center = backdrop.centerColor.takeIf { it != 0 } ?: 0xFF8E6CF0.toInt()
+            val edge = backdrop.edgeColor.takeIf { it != 0 } ?: 0xFF3C2A8C.toInt()
+            return intArrayOf(center or 0xFF000000.toInt(), edge or 0xFF000000.toInt())
+        }
+
+        private fun drawBackdrop(canvas: Canvas, left: Float, top: Float, right: Float, bottom: Float) {
+            cardPaint.shader = LinearGradient(
+                left, top, right, bottom, backdropColors(), null, Shader.TileMode.CLAMP
+            )
+            canvas.drawRoundRect(
+                RectF(left, top, right, bottom),
+                AndroidUtilities.dp(24f).toFloat(), AndroidUtilities.dp(24f).toFloat(), cardPaint
+            )
+            cardPaint.shader = null
+        }
+
+        private fun cardName(): String = GiftStudio.cardTitle(parts.title, parts.number)
+
+        private fun rows(): List<String> = GiftStudio.rowsOf(parts.model, parts.symbol, parts.backdrop)
+
+        private fun drawTexts(canvas: Canvas, width: Int, height: Int) {
+            titlePaint.textSize = AndroidUtilities.dp(20f).toFloat()
+            titlePaint.typeface = Typeface.DEFAULT_BOLD
+            canvas.drawText(
+                TextUtils.ellipsize(cardName(), titlePaint, width * 0.86f, TextUtils.TruncateAt.END).toString(),
+                width * 0.07f, height * 0.94f, titlePaint
+            )
+            if (parts.subtitle.isNotEmpty()) {
+                rowPaint.textSize = AndroidUtilities.dp(14f).toFloat()
+                canvas.drawText(
+                    TextUtils.ellipsize(parts.subtitle, rowPaint, width * 0.86f, TextUtils.TruncateAt.END).toString(),
+                    width * 0.07f, height * 0.88f, rowPaint
+                )
+            }
+        }
+    }
+
+    private val column = LinearLayout(context).apply {
+        orientation = LinearLayout.VERTICAL
+        gravity = android.view.Gravity.CENTER_HORIZONTAL
+    }
+    private val cardPaint = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val titlePaint = TextPaint(Paint.ANTI_ALIAS_FLAG).apply {
+        color = Theme.getColor(Theme.key_windowBackgroundWhiteBlackText, resourcesProvider)
+    }
+    private val rowPaint = TextPaint(Paint.ANTI_ALIAS_FLAG).apply {
+        color = Theme.getColor(Theme.key_windowBackgroundWhiteGrayText, resourcesProvider)
+    }
+
+    private val renderer = Renderer()
+    private val canvasView = CanvasView(context)
+
+    private var layout = Layout.Cover
+    private var parts = Parts()
+    private var currentGift: TL_stars.StarGift? = null
+    private var view: View = canvasView
+
+    /** The studio of the preview, so it can ask the .tgs of the catalog. */
+    private var studio: Studio? = null
+
+    /** The studio gives the .tgs of the catalog for a model and a symbol. */
+    interface Studio {
+        fun modelFile(gift: TL_stars.StarGift): String?
+        fun symbolFile(gift: TL_stars.StarGift): String?
+    }
+
+    init {
+        column.addView(canvasView, LinearLayout.LayoutParams(LayoutHelper.MATCH_PARENT, AndroidUtilities.dp(340f)))
+    }
+
+    /** The studio of the preview, so the model of the catalog can be drawn. */
+    fun setStudio(value: Studio) {
+        studio = value
+        currentGift?.let { show(it) }
+    }
+
+    /** The view to put on the screen. */
+    fun view(): View = column
+
+    /** The layout chosen now. */
+    fun currentLayout(): Layout = layout
+
+    /** The chosen layout. */
+    fun setLayout(value: Layout) {
+        if (layout == value) return
+        layout = value
+        currentGift?.let { show(it) }
+    }
+
+    /** The parts chosen in the studio. */
+    fun setParts(value: Parts) {
+        parts = value
+        currentGift?.let { show(it) }
+    }
+
+    /** The gift of the studio, null when there is nothing to show. */
+    fun remember(gift: TL_stars.StarGift?) {
+        currentGift = gift
+        if (gift == null) {
+            renderer.release()
+            canvasView.invalidate()
+            return
+        }
+        show(gift)
+    }
+
+    private fun show(gift: TL_stars.StarGift) {
+        renderer.setModel(parts.model, gift)
+        renderer.setSymbol(parts.symbol, gift)
+        canvasView.invalidate()
+    }
+
+    /** Draws the preview into a bitmap of this size; null when there is no gift. */
+    fun bitmap(width: Int, height: Int): Bitmap? {
+        val gift = currentGift ?: return null
+        val bitmap = Bitmap.createBitmap(width, height, Bitmap.Config.ARGB_8888)
+        val canvas = Canvas(bitmap)
+        renderer.draw(canvas, width, height)
+        return bitmap
+    }
+
+    /** Frees the images of the preview. */
+    fun release() {
+        renderer.release()
+    }
+}
