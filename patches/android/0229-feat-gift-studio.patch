@@ -0,0 +1,312 @@
+package tele.helpers
+
+import android.content.ContentValues
+import android.content.Context
+import android.content.Intent
+import android.graphics.Bitmap
+import android.media.MediaCodec
+import android.media.MediaCodecInfo
+import android.media.MediaFormat
+import android.media.MediaMuxer
+import android.net.Uri
+import android.os.Environment
+import android.provider.MediaStore
+import androidx.core.content.FileProvider
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.ApplicationLoader
+import org.telegram.messenger.FileLog
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.R
+import java.io.File
+import java.io.FileOutputStream
+import java.nio.ByteBuffer
+
+/**
+ * The export of the gift studio (desktop 0197): the picture of the gift is saved as a PNG or
+ * encoded as a video. The name of the file has no username and no id of the owner in it.
+ */
+object GiftStudioExport {
+
+    /** The formats the studio can write. */
+    enum class Format(val mime: String, val extension: String) {
+        PNG("image/png", "png"),
+        MP4("video/mp4", "mp4")
+    }
+
+    private const val VIDEO_FPS = 30
+    private const val VIDEO_FRAMES = 240
+
+    /** The name of the file of the gift: the parts of it and the number, nothing private. */
+    @JvmStatic
+    fun fileName(title: String?, number: String?, format: Format): String {
+        val safeTitle = sanitize(title)
+        val safeNumber = sanitize(number)
+        val base = when {
+            safeTitle.isEmpty() && safeNumber.isEmpty() -> "gift"
+            safeNumber.isEmpty() -> safeTitle
+            safeTitle.isEmpty() -> safeNumber
+            else -> "$safeTitle $safeNumber"
+        }
+        return "$base.${format.extension}"
+    }
+
+    private fun sanitize(value: String?): String {
+        if (value.isNullOrEmpty()) return ""
+        val builder = StringBuilder()
+        for (character in value) {
+            if (character.isLetterOrDigit() || character == ' ' || character == '-' || character == '_') {
+                builder.append(character)
+            }
+            if (builder.length >= 48) break
+        }
+        return builder.toString().trim()
+    }
+
+    /** The picture of the gift as a PNG in the pictures of the device. */
+    @JvmStatic
+    fun savePng(bitmap: Bitmap, name: String): Uri? {
+        val values = ContentValues()
+        values.put(MediaStore.MediaColumns.DISPLAY_NAME, name)
+        values.put(MediaStore.MediaColumns.MIME_TYPE, "image/png")
+        values.put(
+            MediaStore.MediaColumns.RELATIVE_PATH,
+            Environment.DIRECTORY_PICTURES + File.separator + "tele" + File.separator
+        )
+        val uri = ApplicationLoader.applicationContext.contentResolver
+            .insert(MediaStore.Images.Media.getContentUri(MediaStore.VOLUME_EXTERNAL_PRIMARY), values)
+            ?: return null
+        val output = ApplicationLoader.applicationContext.contentResolver.openOutputStream(uri)
+            ?: return null
+        output.use {
+            if (!bitmap.compress(Bitmap.CompressFormat.PNG, 100, it)) {
+                throw IllegalStateException("the picture could not be written")
+            }
+        }
+        return uri
+    }
+
+    /** The frames of the gift as a video in the movies of the device. */
+    @JvmStatic
+    fun saveVideo(name: String, frames: List<Bitmap>): Uri? {
+        val file = File(ApplicationLoader.getFilesDirFixed("cache/tele-gift-studio"), name)
+        file.parentFile?.mkdirs()
+        if (!encodeVideo(file, frames)) return null
+        val values = ContentValues()
+        values.put(MediaStore.MediaColumns.DISPLAY_NAME, name)
+        values.put(MediaStore.MediaColumns.MIME_TYPE, "video/mp4")
+        values.put(
+            MediaStore.MediaColumns.RELATIVE_PATH,
+            Environment.DIRECTORY_MOVIES + File.separator + "tele" + File.separator
+        )
+        val uri = ApplicationLoader.applicationContext.contentResolver
+            .insert(MediaStore.Video.Media.getContentUri(MediaStore.VOLUME_EXTERNAL_PRIMARY), values)
+            ?: return null
+        val output = ApplicationLoader.applicationContext.contentResolver.openOutputStream(uri)
+            ?: return null
+        output.use {
+            file.inputStream().use { input -> AndroidUtilities.copyFile(input, it) }
+        }
+        file.delete()
+        return uri
+    }
+
+    /** The frames as a video file; false when the device has no encoder. */
+    private fun encodeVideo(file: File, frames: List<Bitmap>): Boolean {
+        if (frames.isEmpty()) return false
+        val width = frames[0].width
+        val height = frames[0].height
+        if (width % 2 != 0 || height % 2 != 0) return false
+        // the encoders of the devices differ in the layout of the pixels
+        val candidates = intArrayOf(
+            MediaCodecInfo.CodecCapabilities.COLOR_FormatYUV420Flexible,
+            MediaCodecInfo.CodecCapabilities.COLOR_FormatYUV420SemiPlanar,
+            MediaCodecInfo.CodecCapabilities.COLOR_FormatYUV420Planar
+        )
+        for (candidate in candidates) {
+            if (encode(file, frames, width, height, candidate)) return true
+            file.delete()
+        }
+        return false
+    }
+
+    /** The frames as a video in the given layout of the pixels of the encoder. */
+    private fun encode(file: File, frames: List<Bitmap>, width: Int, height: Int, colorFormat: Int): Boolean {
+        var codec: MediaCodec? = null
+        var muxer: MediaMuxer? = null
+        var track = -1
+        var started = false
+        try {
+            val format = MediaFormat.createVideoFormat("video/avc", width, height)
+            format.setInteger(MediaFormat.KEY_COLOR_FORMAT, colorFormat)
+            format.setInteger(MediaFormat.KEY_BIT_RATE, width * height * 4)
+            format.setInteger(MediaFormat.KEY_FRAME_RATE, VIDEO_FPS)
+            format.setInteger(MediaFormat.KEY_I_FRAME_INTERVAL, 1)
+            codec = MediaCodec.createEncoderByType("video/avc")
+            codec.configure(format, null, null, MediaCodec.CONFIGURE_FLAG_ENCODE)
+            codec.start()
+            muxer = MediaMuxer(file.absolutePath, MediaMuxer.OutputFormat.MUXER_OUTPUT_MPEG_4)
+            val info = MediaCodec.BufferInfo()
+            var presentation = 0L
+            var sent = 0
+            var done = false
+            while (!done) {
+                if (sent < frames.size) {
+                    val input = codec.dequeueInputBuffer(10000)
+                    if (input >= 0) {
+                        val image = codec.getInputImage(input)
+                        if (image != null) {
+                            fillImage(image, frames[sent], width, height)
+                            codec.queueInputBuffer(input, 0, width * height * 3 / 2, presentation, 0)
+                        } else {
+                            val buffer = codec.getInputBuffer(input)
+                            if (buffer != null) {
+                                buffer.clear()
+                                buffer.put(toYuv420(frames[sent], width, height))
+                                codec.queueInputBuffer(input, 0, width * height * 3 / 2, presentation, 0)
+                            }
+                        }
+                        presentation += 1_000_000L / VIDEO_FPS
+                        sent++
+                    }
+                } else {
+                    val input = codec.dequeueInputBuffer(10000)
+                    if (input >= 0) {
+                        codec.queueInputBuffer(
+                            input, 0, 0, presentation,
+                            MediaCodec.BUFFER_FLAG_END_OF_STREAM
+                        )
+                    }
+                }
+                while (true) {
+                    val output = codec.dequeueOutputBuffer(info, 10000)
+                    if (output == MediaCodec.INFO_OUTPUT_FORMAT_CHANGED) {
+                        track = muxer.addTrack(codec.outputFormat)
+                        muxer.start()
+                        started = true
+                        continue
+                    }
+                    if (output < 0) break
+                    val buffer = codec.getOutputBuffer(output)
+                    if (buffer != null && info.size > 0 && started) {
+                        buffer.position(info.offset)
+                        buffer.limit(info.offset + info.size)
+                        muxer.writeSampleData(track, buffer, info)
+                    }
+                    codec.releaseOutputBuffer(output, false)
+                    if (info.flags and MediaCodec.BUFFER_FLAG_END_OF_STREAM != 0) {
+                        done = true
+                        break
+                    }
+                }
+            }
+        } catch (throwable: Throwable) {
+            FileLog.e("tele gift studio video: " + throwable.message)
+            return false
+        } finally {
+            try {
+                codec?.stop()
+            } catch (ignore: Throwable) {
+            }
+            codec?.release()
+            if (started) {
+                try {
+                    muxer?.stop()
+                } catch (ignore: Throwable) {
+                }
+            }
+            muxer?.release()
+        }
+        return file.length() > 0
+    }
+
+    /** The pixels of the picture in the planes of the buffer of the encoder, at any strides. */
+    private fun fillImage(image: android.media.Image, bitmap: Bitmap, width: Int, height: Int) {
+        val pixels = IntArray(width * height)
+        bitmap.getPixels(pixels, 0, width, 0, 0, width, height)
+        val yPlane = image.planes[0]
+        val uPlane = image.planes[1]
+        val vPlane = image.planes[2]
+        val yBuffer = yPlane.buffer
+        val uBuffer = uPlane.buffer
+        val vBuffer = vPlane.buffer
+        for (row in 0 until height) {
+            var yIndex = row * yPlane.rowStride
+            for (column in 0 until width) {
+                val color = pixels[row * width + column]
+                val red = (color shr 16) and 0xFF
+                val green = (color shr 8) and 0xFF
+                val blue = color and 0xFF
+                val y = (((66 * red + 129 * green + 25 * blue + 128) shr 8) + 16).coerceIn(0, 255)
+                yBuffer.put(yIndex, y.toByte())
+                yIndex++
+                if (row % 2 == 0 && column % 2 == 0) {
+                    val u = (((-38 * red - 74 * green + 112 * blue + 128) shr 8) + 128).coerceIn(0, 255)
+                    val v = (((112 * red - 94 * green - 18 * blue + 128) shr 8) + 128).coerceIn(0, 255)
+                    uBuffer.put((row / 2) * uPlane.rowStride + (column / 2) * uPlane.pixelStride, u.toByte())
+                    vBuffer.put((row / 2) * vPlane.rowStride + (column / 2) * vPlane.pixelStride, v.toByte())
+                }
+            }
+        }
+    }
+
+    /** The pixels of the picture as the yuv420 the encoder of the device takes. */
+    private fun toYuv420(bitmap: Bitmap, width: Int, height: Int): ByteArray {
+        val pixels = IntArray(width * height)
+        bitmap.getPixels(pixels, 0, width, 0, 0, width, height)
+        val result = ByteArray(width * height * 3 / 2)
+        var yIndex = 0
+        var uIndex = width * height
+        var vIndex = uIndex + width * height / 4
+        for (row in 0 until height) {
+            for (column in 0 until width) {
+                val color = pixels[row * width + column]
+                val red = (color shr 16) and 0xFF
+                val green = (color shr 8) and 0xFF
+                val blue = color and 0xFF
+                val y = ((66 * red + 129 * green + 25 * blue + 128) shr 8) + 16
+                val u = ((-38 * red - 74 * green + 112 * blue + 128) shr 8) + 128
+                val v = ((112 * red - 94 * green - 18 * blue + 128) shr 8) + 128
+                result[yIndex++] = y.coerceIn(0, 255).toByte()
+                if (row % 2 == 0 && column % 2 == 0) {
+                    result[uIndex++] = u.coerceIn(0, 255).toByte()
+                    result[vIndex++] = v.coerceIn(0, 255).toByte()
+                }
+            }
+        }
+        return result
+    }
+
+    /** The uri of a file to share. */
+    @JvmStatic
+    fun shareUri(context: Context, file: File): Uri {
+        return FileProvider.getUriForFile(
+            context,
+            ApplicationLoader.getApplicationId() + ".provider",
+            file
+        )
+    }
+
+    /** The intent that shares a file. */
+    @JvmStatic
+    fun shareIntent(uri: Uri, mime: String): Intent {
+        return Intent(Intent.ACTION_SEND)
+            .setType(mime)
+            .putExtra(Intent.EXTRA_STREAM, uri)
+            .addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
+    }
+
+    @JvmStatic
+    fun savedText(): String = LocaleController.getString(R.string.TeleGiftStudioSaved)
+
+    /** The bytes of a bitmap, as a png. */
+    @JvmStatic
+    fun pngBytes(bitmap: Bitmap): ByteArray {
+        val stream = java.io.ByteArrayOutputStream()
+        bitmap.compress(Bitmap.CompressFormat.PNG, 100, stream)
+        return stream.toByteArray()
+    }
+
+    /** How many frames a video of the studio has. */
+    @JvmStatic
+    fun videoFrames(): Int = VIDEO_FRAMES
+}
