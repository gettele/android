@@ -0,0 +1,843 @@
+package tele.ui
+
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.Path
+import android.graphics.PorterDuff
+import android.graphics.PorterDuffColorFilter
+import android.graphics.PorterDuffXfermode
+import android.graphics.RadialGradient
+import android.graphics.RectF
+import android.graphics.Shader
+import android.graphics.Typeface
+import android.graphics.drawable.BitmapDrawable
+import android.graphics.drawable.Drawable
+import android.text.TextPaint
+import android.text.TextUtils
+import android.view.View
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.ImageLoader
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.R
+import org.telegram.ui.Components.RLottieDrawable
+import tele.helpers.GiftStudioCatalog
+import java.io.File
+
+/**
+ * The preview of the gift studio (desktop 0197). The layout is built as a scene in the design
+ * coordinates of the desktop client: the fixed pattern points, the gradient with the center and the
+ * radius of the desktop, then everything is scaled to the canvas. The preview and the saved picture
+ * are the same drawing, so a save at a bigger size is the same picture, not a stretched one.
+ */
+class TeleGiftPreview(
+    private val context: Context,
+    private val account: Int,
+    private val resourcesProvider: org.telegram.ui.ActionBar.Theme.ResourcesProvider? = null
+) {
+
+    /** The layouts of the studio, like the desktop client. */
+    enum class Layout { Cover, Tile, Sticker, Card }
+
+    // the gift and its parts
+    var giftName: String = ""
+        private set
+    var title: String = ""
+    var number: String = ""
+    var model: GiftStudioCatalog.Part? = null
+        private set
+    var backdrop: GiftStudioCatalog.Backdrop? = null
+        private set
+    var symbol: GiftStudioCatalog.Part? = null
+        private set
+
+    var layout: Layout = Layout.Cover
+        private set
+
+    // the picture of the gift
+    private var modelLottie: RLottieDrawable? = null
+    private var modelBitmap: Bitmap? = null
+    private var symbolDrawable: BitmapDrawable? = null
+    private val symbolBitmaps = HashMap<Int, Bitmap>()
+
+    // the player
+    var playing: Boolean = true
+        private set
+    private var frame = 0
+    private var ticker: Runnable? = null
+
+    /** Called with the shown frame and the total count, so the player follows the animation. */
+    var onFrameChanged: ((Int, Int) -> Unit)? = null
+
+    private val view = CanvasView(context)
+
+    private val paint = Paint(Paint.ANTI_ALIAS_FLAG or Paint.FILTER_BITMAP_FLAG)
+    private val symbolPaint = Paint(Paint.ANTI_ALIAS_FLAG or Paint.FILTER_BITMAP_FLAG)
+    private val titlePaint = TextPaint(Paint.ANTI_ALIAS_FLAG).apply {
+        typeface = Typeface.DEFAULT_BOLD
+        color = Color.WHITE
+    }
+    private val subtitlePaint = TextPaint(Paint.ANTI_ALIAS_FLAG).apply {
+        color = Color.WHITE
+    }
+    private val labelPaint = TextPaint(Paint.ANTI_ALIAS_FLAG).apply {
+        color = 0x99FFFFFF.toInt()
+    }
+    private val valuePaint = TextPaint(Paint.ANTI_ALIAS_FLAG).apply {
+        typeface = Typeface.DEFAULT_BOLD
+        color = Color.WHITE
+    }
+    private val ribbonPaint = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val ribbonTextPaint = TextPaint(Paint.ANTI_ALIAS_FLAG).apply {
+        typeface = Typeface.DEFAULT_BOLD
+        color = Color.WHITE
+    }
+    private val buttonPaint = Paint(Paint.ANTI_ALIAS_FLAG)
+
+    private inner class CanvasView(context: Context) : View(context) {
+        override fun onDraw(canvas: Canvas) {
+            draw(canvas, width.toFloat(), height.toFloat())
+        }
+
+        override fun onAttachedToWindow() {
+            super.onAttachedToWindow()
+            if (playing) startTick()
+        }
+
+        override fun onDetachedFromWindow() {
+            super.onDetachedFromWindow()
+            pauseTick()
+        }
+    }
+
+    /** The view of the preview. */
+    fun view(): View = view
+
+    /** A gift of the catalog: its name, then the parts are chosen one by one. */
+    fun setGift(name: String) {
+        giftName = name
+        if (title.isEmpty()) title = name
+        modelLottie?.let { it.stop(); it.recycle(false) }
+        modelLottie = null
+        modelBitmap = null
+        symbolDrawable = null
+        symbolBitmaps.clear()
+        redraw()
+    }
+
+    fun setLayout(value: Layout) {
+        if (layout == value) return
+        layout = value
+        redraw()
+    }
+
+    fun applyTitle(value: String) {
+        title = value
+        redraw()
+    }
+
+    fun applyNumber(value: String) {
+        number = value
+        redraw()
+    }
+
+    /** The model of the gift: its .tgs is read from the catalog and played as an animation. */
+    fun setModel(part: GiftStudioCatalog.Part?) {
+        model = part
+        modelLottie?.let { it.stop(); it.recycle(false) }
+        modelLottie = null
+        modelBitmap = null
+        frame = 0
+        redraw()
+        if (part != null && giftName.isNotEmpty()) {
+            loadModel(part.name)
+        }
+    }
+
+    /** The symbol of the gift: its picture is the pattern of the card. */
+    fun setSymbol(part: GiftStudioCatalog.Part?) {
+        symbol = part
+        symbolDrawable = null
+        symbolBitmaps.clear()
+        redraw()
+        if (part != null && giftName.isNotEmpty()) {
+            GiftStudioCatalog.symbolPng(giftName, part.name, 128) { bitmap ->
+                if (bitmap != null && symbol?.name == part.name) {
+                    symbolDrawable = BitmapDrawable(context.resources, bitmap)
+                    symbolBitmaps.clear()
+                    redraw()
+                }
+            }
+        }
+    }
+
+    fun setBackdrop(part: GiftStudioCatalog.Backdrop?) {
+        backdrop = part
+        symbolBitmaps.clear()
+        redraw()
+    }
+
+    private fun loadModel(name: String) {
+        val request = giftName
+        GiftStudioCatalog.modelTgs(request, name) { bytes ->
+            if (bytes.isEmpty() || model?.name != name) return@modelTgs
+            val file = cacheFile(request, name, bytes)
+            val json = if (file != null) runCatching { ImageLoader.decompressGzip(file) }.getOrNull() else null
+            val lottie = if (file != null && !json.isNullOrEmpty()) {
+                runCatching {
+                    RLottieDrawable(file, json, 256, 256, null, false, null, 0, false).also {
+                        it.setAutoRepeat(1)
+                        it.setAllowDecodeSingleFrame(true)
+                    }
+                }.getOrNull()
+            } else null
+            if (lottie != null) {
+                modelLottie = lottie
+                frame = 0
+                if (playing) startTick() else lottie.setCurrentFrame(0, false)
+                redraw()
+                notifyFrame()
+            } else {
+                GiftStudioCatalog.modelPng(request, name, 256) { bitmap ->
+                    if (bitmap != null && model?.name == name) {
+                        modelBitmap = bitmap
+                        redraw()
+                    }
+                }
+            }
+        }
+    }
+
+    private fun cacheFile(gift: String, name: String, bytes: ByteArray): File? {
+        return runCatching {
+            val dir = File(org.telegram.messenger.ApplicationLoader.getFilesDirFixed(), "tele_gift_studio")
+            dir.mkdirs()
+            val file = File(dir, "model_" + (gift + "/" + name).hashCode().toUInt().toString(16) + ".tgs")
+            if (!file.exists() || file.length().toInt() != bytes.size) file.writeBytes(bytes)
+            file
+        }.getOrNull()
+    }
+
+    /** How many frames the model of the gift has. */
+    fun frames(): Int = modelLottie?.framesCount ?: 1
+
+    /** The frame shown now. */
+    fun frame(): Int = frame
+
+    /** Shows a frame; the player stops while the frame is chosen by hand. */
+    fun setFrame(value: Int) {
+        val lottie = modelLottie ?: return
+        frame = value.coerceIn(0, lottie.framesCount - 1)
+        lottie.setCurrentFrame(frame, false)
+        redraw()
+        notifyFrame()
+    }
+
+    fun setPlaying(value: Boolean) {
+        playing = value
+        if (value) {
+            startTick()
+        } else {
+            pauseTick()
+            modelLottie?.let { it.setCurrentFrame(frame, false) }
+        }
+        redraw()
+    }
+
+    private fun startTick() {
+        pauseTick()
+        val lottie = modelLottie ?: return
+        val total = lottie.framesCount.coerceAtLeast(1)
+        val duration = lottie.duration.coerceAtLeast(1L)
+        // the .tgs has its own frame rate: a fixed 30 fps made a 60 fps gift play at half speed
+        val interval = (duration / total).coerceIn(8L, 66L)
+        val start = System.currentTimeMillis() - frame * duration / total
+        val runnable = object : Runnable {
+            override fun run() {
+                val animation = modelLottie ?: return
+                if (!playing) return
+                val elapsed = System.currentTimeMillis() - start
+                val shown = (elapsed * total / duration % total).toInt()
+                if (shown != frame) {
+                    frame = shown
+                    animation.setCurrentFrame(frame, false)
+                    view.invalidate()
+                    onFrameChanged?.invoke(frame, total)
+                }
+                view.postDelayed(this, interval)
+            }
+        }
+        ticker = runnable
+        view.postDelayed(runnable, interval)
+    }
+
+    private fun pauseTick() {
+        ticker?.let { view.removeCallbacks(it) }
+        ticker = null
+    }
+
+    private fun notifyFrame() {
+        onFrameChanged?.invoke(frame, frames())
+    }
+
+    private fun redraw() {
+        view.invalidate()
+    }
+
+    /** Frees the animation of the preview. */
+    fun release() {
+        pauseTick()
+        modelLottie?.stop()
+        modelLottie?.recycle(false)
+        modelLottie = null
+    }
+
+    // ---- scene of the desktop client ----
+
+    private class Placed(val cx: Float, val cy: Float, val side: Float, val alpha: Float)
+
+    private class Scene(
+        val designWidth: Float,
+        val designHeight: Float,
+        /** design units to pixels */
+        val k: Float,
+        val originX: Float,
+        val originY: Float,
+        val clip: RectF?,
+        val radius: Float,
+        val background: RectF,
+        val gradientX: Float,
+        val gradientY: Float,
+        val gradientRadius: Float,
+        val symbols: List<Placed>,
+        val model: RectF
+    )
+
+    /** Where the parts of the card go, so the texts and its height never disagree. */
+    private class CardLayout(
+        val titleBaseline: Float,
+        val nameBaseline: Float,
+        val tableBaseline: Float,
+        val buttonTop: Float,
+        val height: Float
+    )
+
+    private fun cardLayout(): CardLayout {
+        val titleBaseline = CARD_STICKER_TOP + CARD_STICKER + 12f + TITLE_FONT
+        val nameBaseline = titleBaseline + 6f + NAME_FONT
+        val tableBaseline = nameBaseline + 8f + ROW_FONT
+        val rows = rows().size
+        val tableBottom = tableBaseline + (rows - 1).coerceAtLeast(0) * ROW_HEIGHT
+        val buttonTop = tableBottom + 10f
+        return CardLayout(
+            titleBaseline, nameBaseline, tableBaseline, buttonTop,
+            buttonTop + BUTTON_HEIGHT + 20f
+        )
+    }
+
+    /** The height of the card of the desktop: the sticker, the texts, the table and the button. */
+    private fun cardHeight(): Float = cardLayout().height
+
+    /** The height of the view of this layout for the given width, the padding included. */
+    fun heightFor(layout: Layout, width: Int): Int {
+        val pad = padding()
+        return when (layout) {
+            Layout.Cover -> (width * COVER_HEIGHT / COVER_WIDTH).toInt()
+            Layout.Sticker -> width
+            Layout.Tile -> (width - 2 * pad).coerceAtLeast(1) + 2 * pad
+            Layout.Card -> {
+                val unit = (width - 2 * pad).toFloat() / CARD_WIDTH
+                (cardHeight() * unit + 2 * pad).toInt() + 1
+            }
+        }
+    }
+
+    private fun padding(): Int = AndroidUtilities.dp(16f)
+
+    private fun scene(width: Float, height: Float): Scene {
+        return when (layout) {
+            Layout.Cover -> coverScene(width, height)
+            Layout.Tile -> boxedScene(
+                width, height,
+                designWidth = TILE_SIDE, designHeight = TILE_SIDE,
+                radius = TILE_RADIUS,
+                modelSlot = RectF(
+                    (TILE_SIDE - TILE_STICKER) / 2f, (TILE_SIDE - TILE_STICKER) / 2f,
+                    (TILE_SIDE + TILE_STICKER) / 2f, (TILE_SIDE + TILE_STICKER) / 2f
+                ),
+                points = PATTERN_SMALL,
+                pattern = RectF(-TILE_SIDE / 3f, 0f, TILE_SIDE * 4f / 3f, TILE_SIDE),
+                gradientRadius = TILE_SIDE / 2f
+            )
+            Layout.Card -> {
+                val cardH = cardHeight()
+                val shift = CARD_WIDTH / 12f
+                boxedScene(
+                    width, height,
+                    designWidth = CARD_WIDTH, designHeight = cardH,
+                    radius = CARD_RADIUS,
+                    modelSlot = RectF(
+                        (CARD_WIDTH - CARD_STICKER) / 2f, CARD_STICKER_TOP,
+                        (CARD_WIDTH + CARD_STICKER) / 2f, CARD_STICKER_TOP + CARD_STICKER
+                    ),
+                    points = PATTERN_BIG,
+                    pattern = RectF(-shift, -shift, CARD_WIDTH + shift, cardH + shift),
+                    gradientRadius = cardH / 2f
+                )
+            }
+            Layout.Sticker -> {
+                val side = Math.min(width, height)
+                Scene(
+                    designWidth = side, designHeight = side, k = 1f,
+                    originX = 0f, originY = 0f, clip = null, radius = 0f,
+                    background = RectF(),
+                    gradientX = 0f, gradientY = 0f, gradientRadius = 0f,
+                    symbols = emptyList(),
+                    model = RectF(0f, 0f, side, side)
+                )
+            }
+        }
+    }
+
+    /** The tile and the card: a design rectangle centered in the canvas, scaled to fit. */
+    private fun boxedScene(
+        width: Float,
+        height: Float,
+        designWidth: Float,
+        designHeight: Float,
+        radius: Float,
+        modelSlot: RectF,
+        points: Array<FloatArray>,
+        pattern: RectF,
+        gradientRadius: Float
+    ): Scene {
+        val pad = padding().toFloat()
+        val k = Math.min((width - 2f * pad) / designWidth, (height - 2f * pad) / designHeight)
+        val originX = (width - designWidth * k) / 2f
+        val originY = (height - designHeight * k) / 2f
+        val symbols = ArrayList<Placed>()
+        for (point in points) {
+            // int() as in the desktop client
+            val cx = pattern.left + (point[0] * pattern.width()).toInt()
+            val cy = pattern.top + (point[1] * pattern.height()).toInt()
+            symbols.add(Placed(cx, cy, SYMBOL * point[2], point[3]))
+        }
+        return Scene(
+            designWidth, designHeight, k, originX, originY,
+            clip = RectF(0f, 0f, designWidth, designHeight), radius = radius,
+            background = RectF(0f, 0f, designWidth, designHeight),
+            gradientX = designWidth / 2f, gradientY = designHeight / 2f,
+            gradientRadius = gradientRadius,
+            symbols = symbols,
+            model = modelSlot
+        )
+    }
+
+    /** The cover: the design is wider than tall, the model sits in its middle. */
+    private fun coverScene(width: Float, height: Float): Scene {
+        val unit = Math.min(width, height) / COVER_HEIGHT
+        val middle = (MODEL_TOP + COVER_HEIGHT - COVER_BOTTOM) / 2f
+        val originX = width / 2f - unit * COVER_WIDTH / 2f
+        val originY = height / 2f - unit * middle
+        val visible = RectF(
+            -originX / unit, -originY / unit,
+            (width - originX) / unit, (height - originY) / unit
+        )
+        val symbols = ArrayList<Placed>()
+        val add = { x: Float, y: Float, scale: Float, alpha: Float ->
+            val side = SYMBOL * scale
+            val rect = RectF(x - side / 2f, y - side / 2f, x + side / 2f, y + side / 2f)
+            if (RectF.intersects(rect, visible)) {
+                symbols.add(Placed(x, y, side, alpha))
+            }
+        }
+        for (point in PATTERN_BIG) {
+            add(
+                (point[0] * COVER_WIDTH).toInt().toFloat(),
+                (point[1] * SUBTITLE_TOP).toInt().toFloat(),
+                point[2], point[3]
+            )
+        }
+        val cover = RectF(0f, 0f, COVER_WIDTH, COVER_HEIGHT)
+        if (!cover.contains(visible)) {
+            // a canvas wider than the design gets the rings of the desktop client
+            generateRings(
+                centerX = COVER_WIDTH / 2f,
+                centerY = MODEL_TOP + MODEL_SIDE / 2f,
+                start = COVER_WIDTH * 0.5f,
+                step = COVER_WIDTH * 0.17f,
+                spacing = COVER_WIDTH * 0.16f,
+                ratio = 0.6f,
+                visible = visible,
+                exclude = cover,
+                add = add
+            )
+        }
+        val modelCenterX = COVER_WIDTH / 2f
+        val modelCenterY = MODEL_TOP + MODEL_SIDE / 2f
+        return Scene(
+            COVER_WIDTH, COVER_HEIGHT, unit, originX, originY,
+            clip = null, radius = 0f,
+            background = visible,
+            gradientX = (width / 2f - originX) / unit,
+            gradientY = (height / 2f - originY) / unit,
+            gradientRadius = COVER_HEIGHT / 2f,
+            symbols = symbols,
+            model = RectF(
+                modelCenterX - MODEL_SIDE / 2f, modelCenterY - MODEL_SIDE / 2f,
+                modelCenterX + MODEL_SIDE / 2f, modelCenterY + MODEL_SIDE / 2f
+            )
+        )
+    }
+
+    private fun insideEllipse(x: Float, y: Float, a: Float, b: Float): Boolean {
+        if (a <= 0f || b <= 0f) return false
+        return (x / a) * (x / a) + (y / b) * (y / b) <= 1f
+    }
+
+    private fun perimeter(a: Float, b: Float): Float {
+        return (Math.PI * (3.0 * (a + b) - Math.sqrt((3.0 * a + b) * (a + 3.0 * b)))).toFloat()
+    }
+
+    /** The rings of symbols the desktop client draws when the canvas is wider than the design. */
+    private fun generateRings(
+        centerX: Float,
+        centerY: Float,
+        start: Float,
+        step: Float,
+        spacing: Float,
+        ratio: Float,
+        visible: RectF,
+        exclude: RectF,
+        add: (Float, Float, Float, Float) -> Unit
+    ) {
+        if (step <= 0f || spacing <= 0f) return
+        val corners = arrayOf(
+            visible.left - centerX to visible.top - centerY,
+            visible.right - centerX to visible.top - centerY,
+            visible.left - centerX to visible.bottom - centerY,
+            visible.right - centerX to visible.bottom - centerY
+        )
+        for (ring in 0 until 400) {
+            val a = start + step * ring
+            val b = a * ratio
+            val enclosed = corners.all { insideEllipse(it.first, it.second, a - SYMBOL, b - SYMBOL) }
+            if (enclosed) break
+            val count = Math.max(6, Math.round(perimeter(a, b) / spacing))
+            val angleStep = (2.0 * Math.PI / count).toFloat()
+            val shift = if (ring % 2 == 1) angleStep / 2f else 0f
+            for (index in 0 until count) {
+                val angle = shift + index * angleStep
+                val x = centerX + a * Math.cos(angle.toDouble()).toFloat()
+                val y = centerY + b * Math.sin(angle.toDouble()).toFloat()
+                if (!exclude.contains(x, y)) {
+                    val large = index % 2 != 0
+                    add(x, y, if (large) 0.85f else 0.7f, if (large) 0.3f else 0.2f)
+                }
+            }
+        }
+    }
+
+    // ---- drawing ----
+
+    private fun draw(canvas: Canvas, width: Float, height: Float) {
+        if (width <= 0f || height <= 0f) return
+        val scene = scene(width, height)
+        if (layout == Layout.Sticker) {
+            drawModel(canvas, scene)
+            return
+        }
+        // the background and the pattern in the design coordinates
+        canvas.save()
+        canvas.translate(scene.originX, scene.originY)
+        canvas.scale(scene.k, scene.k)
+        if (scene.clip != null) {
+            canvas.clipPath(
+                Path().apply {
+                    addRoundRect(scene.clip, scene.radius, scene.radius, Path.Direction.CW)
+                }
+            )
+        }
+        paint.alpha = 255
+        paint.shader = RadialGradient(
+            scene.gradientX, scene.gradientY, scene.gradientRadius,
+            backdrop?.center ?: 0xFF6E7BD9.toInt(),
+            backdrop?.edge ?: 0xFF3B3F8F.toInt(),
+            Shader.TileMode.CLAMP
+        )
+        canvas.drawRect(scene.background, paint)
+        paint.shader = null
+        canvas.restore()
+
+        // the symbols as tinted pictures, at the size of the canvas
+        for (placed in scene.symbols) {
+            val px = Math.max(Math.round(placed.side * scene.k), 1)
+            val bitmap = symbolBitmap(px) ?: break
+            symbolPaint.alpha = (placed.alpha * 255f).toInt().coerceIn(0, 255)
+            val left = scene.originX + (placed.cx - placed.side / 2f) * scene.k
+            val top = scene.originY + (placed.cy - placed.side / 2f) * scene.k
+            canvas.drawBitmap(
+                bitmap, null,
+                RectF(left, top, left + placed.side * scene.k, top + placed.side * scene.k),
+                symbolPaint
+            )
+        }
+        symbolPaint.alpha = 255
+
+        // the model at the size of the canvas, so it is not blurred
+        drawModel(canvas, scene)
+
+        // the texts and the ribbon of the layout
+        canvas.save()
+        canvas.translate(scene.originX, scene.originY)
+        canvas.scale(scene.k, scene.k)
+        if (scene.clip != null) {
+            canvas.clipPath(
+                Path().apply {
+                    addRoundRect(scene.clip, scene.radius, scene.radius, Path.Direction.CW)
+                }
+            )
+        }
+        when (layout) {
+            Layout.Cover -> drawCoverTexts(canvas, scene)
+            Layout.Card -> drawCardTexts(canvas, scene)
+            else -> {}
+        }
+        canvas.restore()
+    }
+
+    /** The model of the gift at the shown frame, in the pixels of the canvas. */
+    private fun drawModel(canvas: Canvas, scene: Scene) {
+        val rect = scene.model
+        val left = (scene.originX + rect.left * scene.k).toInt()
+        val top = (scene.originY + rect.top * scene.k).toInt()
+        val right = (scene.originX + rect.right * scene.k).toInt()
+        val bottom = (scene.originY + rect.bottom * scene.k).toInt()
+        val lottie = modelLottie
+        if (lottie != null) {
+            lottie.setBounds(left, top, right, bottom)
+            lottie.draw(canvas)
+            return
+        }
+        val bitmap = modelBitmap ?: return
+        canvas.drawBitmap(bitmap, null, RectF(left.toFloat(), top.toFloat(), right.toFloat(), bottom.toFloat()), paint)
+    }
+
+    /** The picture of the symbol of the given size, filled with the color of the pattern. */
+    private fun symbolBitmap(px: Int): Bitmap? {
+        val drawable = symbolDrawable ?: return null
+        symbolBitmaps[px]?.let { return it }
+        val bitmap = Bitmap.createBitmap(px, px, Bitmap.Config.ARGB_8888)
+        val canvas = Canvas(bitmap)
+        drawable.setBounds(0, 0, px, px)
+        drawable.alpha = 255
+        drawable.colorFilter = null
+        drawable.draw(canvas)
+        val tint = Paint(Paint.ANTI_ALIAS_FLAG)
+        tint.xfermode = PorterDuffXfermode(PorterDuff.Mode.SRC_IN)
+        tint.color = backdrop?.pattern ?: 0xFFFFFFFF.toInt()
+        canvas.drawRect(0f, 0f, px.toFloat(), px.toFloat(), tint)
+        symbolBitmaps[px] = bitmap
+        return bitmap
+    }
+
+    private fun textColor(): Int = backdrop?.text ?: Color.WHITE
+
+    /** The cover: the title and the model name at the bottom, as the desktop client draws them. */
+    private fun drawCoverTexts(canvas: Canvas, scene: Scene) {
+        val width = scene.designWidth
+        val color = textColor()
+        titlePaint.textSize = 20f
+        subtitlePaint.textSize = 15f
+        val headline = headline()
+        val subtitle = listOfNotNull(model?.name).joinToString("")
+        var baseline = SUBTITLE_TOP.toFloat()
+        if (headline.isNotEmpty()) {
+            titlePaint.color = Color.WHITE
+            val line = elide(headline, titlePaint, width * 0.86f)
+            canvas.drawText(line, (width - titlePaint.measureText(line)) / 2f, baseline - 10f, titlePaint)
+        }
+        if (subtitle.isNotEmpty()) {
+            subtitlePaint.color = color
+            val line = elide(subtitle, subtitlePaint, width * 0.86f)
+            canvas.drawText(line, (width - subtitlePaint.measureText(line)) / 2f, baseline + 14f, subtitlePaint)
+        }
+    }
+
+    /** The card: "Saved Gift", the name, the table of the parts and the View button. */
+    private fun drawCardTexts(canvas: Canvas, scene: Scene) {
+        val width = scene.designWidth
+        val color = textColor()
+        titlePaint.textSize = TITLE_FONT
+        titlePaint.color = Color.WHITE
+        subtitlePaint.textSize = NAME_FONT
+        subtitlePaint.color = color
+        labelPaint.textSize = ROW_FONT
+        labelPaint.color = color
+        valuePaint.textSize = ROW_FONT
+        valuePaint.color = Color.WHITE
+
+        val layout = cardLayout()
+        val saved = LocaleController.getString(R.string.Gift2ActionSelfTitle)
+        canvas.drawText(saved, (width - titlePaint.measureText(saved)) / 2f, layout.titleBaseline, titlePaint)
+        val headline = elide(headline(), subtitlePaint, width - 40f)
+        canvas.drawText(
+            headline, (width - subtitlePaint.measureText(headline)) / 2f,
+            layout.nameBaseline, subtitlePaint
+        )
+
+        val rows = rows()
+        var maxLabel = 0f
+        var maxValue = 0f
+        for ((label, value) in rows) {
+            maxLabel = Math.max(maxLabel, labelPaint.measureText(label))
+            maxValue = Math.max(maxValue, valuePaint.measureText(value))
+        }
+        val left = 20f
+        val inner = width - 40f
+        val skip = 14f
+        val valueLeft = left + maxLabel * (inner - skip) / Math.max(1f, maxLabel + maxValue) + skip
+        var line = layout.tableBaseline
+        for ((label, value) in rows) {
+            canvas.drawText(label, valueLeft - skip - labelPaint.measureText(label), line, labelPaint)
+            canvas.drawText(value, valueLeft, line, valuePaint)
+            line += ROW_HEIGHT
+        }
+        drawViewButton(canvas, layout.buttonTop)
+        drawRibbon(canvas, scene)
+    }
+
+    private fun drawViewButton(canvas: Canvas, top: Float) {
+        val text = "View"
+        valuePaint.textSize = ROW_FONT + 1f
+        val width = valuePaint.measureText(text) + 40f
+        val left = (CARD_WIDTH - width) / 2f
+        val rect = RectF(left, top, left + width, top + BUTTON_HEIGHT)
+        buttonPaint.color = withAlpha(backdrop?.pattern ?: 0x33444444, 0.45f)
+        canvas.drawRoundRect(rect, BUTTON_HEIGHT / 2f, BUTTON_HEIGHT / 2f, buttonPaint)
+        valuePaint.color = Color.WHITE
+        canvas.drawText(text, (CARD_WIDTH - valuePaint.measureText(text)) / 2f, top + BUTTON_HEIGHT * 0.68f, valuePaint)
+    }
+
+    /** The ribbon of the card: the word "gift" on the right corner, as the desktop badge. */
+    private fun drawRibbon(canvas: Canvas, scene: Scene) {
+        val text = "gift"
+        ribbonTextPaint.textSize = 13f
+        ribbonTextPaint.color = textColor()
+        val textWidth = ribbonTextPaint.measureText(text) + 28f
+        val height = 22f
+        val skip = (textWidth / Math.sqrt(2.0)).toFloat()
+        val size = textWidth + 30f
+        val card = scene.clip ?: return
+        canvas.save()
+        canvas.translate(card.right - size, card.top)
+        canvas.translate(size - skip, 0f)
+        canvas.rotate(45f)
+        val band = RectF(-textWidth * 5f, 0f, textWidth * 7f, height)
+        ribbonPaint.color = backdrop?.edge ?: 0xFF3B3F8F.toInt()
+        canvas.drawRect(band, ribbonPaint)
+        ribbonPaint.color = withAlpha(backdrop?.pattern ?: 0xFF652852.toInt(), 0.5f)
+        canvas.drawRect(band, ribbonPaint)
+        canvas.drawText(text, 14f, height * 0.72f, ribbonTextPaint)
+        canvas.restore()
+    }
+
+    private fun headline(): String {
+        val parts = ArrayList<String>()
+        if (title.isNotEmpty()) parts.add(title)
+        if (number.isNotEmpty()) parts.add("#$number")
+        return parts.joinToString(" ")
+    }
+
+    private fun rows(): List<Pair<String, String>> {
+        val result = ArrayList<Pair<String, String>>()
+        model?.let { result.add("Model" to it.name) }
+        symbol?.let { result.add("Symbol" to it.name) }
+        backdrop?.let { result.add("Backdrop" to it.name) }
+        val odds = odds(model?.permille ?: 0, backdrop?.permille ?: 0)
+        if (odds.isNotEmpty()) result.add("Rarity" to odds)
+        return result
+    }
+
+    private fun odds(modelPermille: Int, backdropPermille: Int): String {
+        if (modelPermille <= 0 || backdropPermille <= 0) return ""
+        val value = 1_000_000.0 / (modelPermille.toDouble() * backdropPermille)
+        return "1 in " + String.format(java.util.Locale.US, "%,d", Math.round(value))
+    }
+
+    private fun elide(text: String, paint: TextPaint, width: Float): String {
+        return TextUtils.ellipsize(text, paint, width, TextUtils.TruncateAt.END).toString()
+    }
+
+    private fun withAlpha(color: Int, alpha: Float): Int {
+        return (color and 0x00FFFFFF) or ((Color.alpha(color) * alpha).toInt() shl 24)
+    }
+
+    /**
+     * Draws the preview into a bitmap of this size: the same picture, only bigger. The drawing is
+     * scaled as a whole, so every unit of the design grows with it and nothing moves aside.
+     */
+    fun bitmap(width: Int, height: Int): Bitmap {
+        val bitmap = Bitmap.createBitmap(width, height, Bitmap.Config.ARGB_8888)
+        val canvas = Canvas(bitmap)
+        draw(canvas, width.toFloat(), height.toFloat())
+        return bitmap
+    }
+
+    companion object {
