+package tele.helpers
+
+import org.telegram.messenger.R
+import org.telegram.tgnet.tl.TL_stars
+import org.telegram.ui.ActionBar.BaseFragment
+import org.telegram.ui.Components.ItemOptions
+import tele.TeleConfig
+import tele.ui.TeleGiftStudioActivity
+
+/**
+ * The entry of the gift studio (desktop 0197). The rows are only there when the setting is on, so
+ * the stock menus stay the same without it.
+ */
+object GiftStudioMenu {
+
+    /** The id of the row of the menu of the studio. */
+    const val ID_OPEN = 9690
+
+    @JvmStatic
+    fun enabled(): Boolean = TeleConfig.GIFT_STUDIO.value
+
+    /** Adds the row of the studio to the menu of a gift. */
+    @JvmStatic
+    fun addAction(
+        options: ItemOptions,
+        fragment: BaseFragment?,
+        account: Int,
+        dialogId: Long,
+        gift: TL_stars.SavedStarGift
+    ) {
+        if (!enabled()) return
+        options.add(R.drawable.filled_gift_simple, "Open in gift studio") {
+            options.dismiss()
+            fragment?.presentFragment(TeleGiftStudioActivity(account, dialogId, gift))
+        }
+    }
+
+    /** The studio in the main menu of the chat list, like the desktop client. */
+    @JvmStatic
+    fun addMainMenuItem(fragment: BaseFragment, options: ItemOptions) {
+        if (!enabled()) return
+        val account = org.telegram.messenger.UserConfig.selectedAccount
+        options.add(R.drawable.filled_gift_simple, "Gift studio") {
+            options.dismiss()
+            fragment.presentFragment(TeleGiftStudioActivity(account, 0L, null))
+        }
+    }
+}
