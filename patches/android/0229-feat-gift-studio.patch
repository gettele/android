+                    else -> saveVideo()
+                }
+            }
+            .show()
+    }
+
+    /** The height of a picture of this layout for the given width. */
+    private fun layoutHeight(layout: TeleGiftPreview.Layout, width: Int): Int {
+        return preview.heightFor(layout, width).coerceAtLeast(1)
+    }
+
+    private fun savePng(width: Int) {
+        val height = layoutHeight(preview.layout, width)
+        val bitmap = try {
+            preview.bitmap(width, height)
+        } catch (throwable: Throwable) {
+            org.telegram.messenger.FileLog.e(throwable)
+            null
+        }
+        if (bitmap == null) {
+            showError()
+            return
+        }
+        try {
+            val name = GiftStudioExport.fileName(titleOverride ?: giftName, number.ifEmpty { null }, GiftStudioExport.Format.PNG)
+            val uri = GiftStudioExport.savePng(bitmap, name)
+            bitmap.recycle()
+            if (uri == null) {
+                showError()
+                return
+            }
+            showSaved()
+        } catch (throwable: Throwable) {
+            org.telegram.messenger.FileLog.e(throwable)
+            showError()
+        }
+    }
+
+    /** The picture as a video: its own frames, drawn one by one. */
+    private fun saveVideo() {
+        val width = 540
+        val height = layoutHeight(preview.layout, width) and 1.inv() // the encoder needs even sides
+        val total = preview.frames()
+        val wasPlaying = preview.playing
+        preview.setPlaying(false)
+        val frames = ArrayList<Bitmap>()
+        val step = Math.max(1, Math.ceil(total / GiftStudioExport.videoFrames().toDouble()).toInt())
+        for (index in 0 until total step step) {
+            preview.setFrame(index)
+            frames.add(preview.bitmap(width, Math.max(2, height)))
+        }
+        preview.setPlaying(wasPlaying)
+        if (frames.isEmpty()) {
+            showError()
+            return
+        }
+        val name = GiftStudioExport.fileName(titleOverride ?: giftName, number.ifEmpty { null }, GiftStudioExport.Format.MP4)
+        val uri = GiftStudioExport.saveVideo(name, frames)
+        for (frame in frames) frame.recycle()
+        if (uri == null) {
+            showError()
+            return
+        }
+        showSaved()
+    }
+
+    /** The credit line of the catalog: the channel is a blue tag, the rest stays gray. */
+    private fun creditSpan(text: String): SpannableString {
+        val span = SpannableString(text)
+        val start = text.indexOf(GiftStudioCatalog.CREDIT)
+        if (start < 0) return span
+        val end = start + GiftStudioCatalog.CREDIT.length
+        val blue = Theme.getColor(Theme.key_windowBackgroundWhiteBlueText)
+        span.setSpan(ForegroundColorSpan(blue), start, end, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
+        span.setSpan(object : ClickableSpan() {
+            override fun onClick(widget: View) {
+                Browser.openUrl(getParentActivity(), GiftStudioCatalog.CREDIT_URL)
+            }
+
+            override fun updateDrawState(ds: android.text.TextPaint) {
+                ds.setColor(blue)
+                ds.isUnderlineText = false
+            }
+        }, start, end, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
+        return span
+    }
+
+    /** Every layout as its own picture, so all four can be compared at once. */
+    private fun saveAll() {
+        val kind = preview.layout
+        val width = 1080
+        var failed = false
+        for (layout in TeleGiftPreview.Layout.entries) {
+            preview.setLayout(layout)
+            val height = layoutHeight(layout, width)
+            val bitmap = runCatching { preview.bitmap(width, height) }.getOrNull()
+            if (bitmap == null) {
+                failed = true
+                continue
+            }
+            val name = GiftStudioExport.fileName(
+                (titleOverride ?: giftName) + " " + layout.name,
+                number.ifEmpty { null },
+                GiftStudioExport.Format.PNG
+            )
+            if (GiftStudioExport.savePng(bitmap, name) == null) failed = true
+            bitmap.recycle()
+        }
+        preview.setLayout(kind)
+        setRow(layoutRow, "Layout", kind.name)
+        if (failed) showError() else showSaved()
+    }
+
+    /** The code of the studio: the same format the desktop client copies and reads. */
+    private fun code(): String {
+        val builder = StringBuilder("tele_giftstudio?")
+        val add = { key: String, value: String ->
+            if (value.isNotEmpty()) builder.append(key).append('=').append(Uri.encode(value)).append('&')
+        }
+        add("c", giftName)
+        add("m", model?.name ?: "")
+        add("b", backdrop?.name ?: "")
+        add("s", symbol?.name ?: "")
+        add("t", titleOverride ?: "")
+        add("n", number)
+        if (preview.layout != TeleGiftPreview.Layout.Cover) add("l", preview.layout.name.lowercase())
+        builder.setLength(builder.length - 1)
+        return builder.toString()
+    }
+
+    private fun copyCode() {
+        if (giftName.isEmpty()) return
+        AndroidUtilities.addToClipboard(code())
+        val text = lc("Studio code copied")
+        BulletinFactory.of(this).createSimpleBulletin(R.raw.copy, text).show()
+    }
+
+    private fun loadCode() {
+        val context = parentActivity ?: context
+        val input = EditTextBoldCursor(context)
+        input.hint = "tele_giftstudio?c=…"
+        input.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16f)
+        input.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText, resourceProvider))
+        input.setCursorColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText, resourceProvider))
+        input.setHintTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteHintText, resourceProvider))
+        input.setHintColor(Theme.getColor(Theme.key_windowBackgroundWhiteHintText, resourceProvider))
+        input.setBackground(null)
+        input.setPadding(AndroidUtilities.dp(23f), 0, AndroidUtilities.dp(23f), 0)
+        input.isSingleLine = true
+        val frame = FrameLayout(context)
+        frame.addView(input, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, 48f))
+        AlertDialog.Builder(context, resourceProvider)
+            .setTitle(lc("Load studio code"))
+            .setView(frame)
+            .setPositiveButton(LocaleController.getString(R.string.Done)) { _, _ -> parseCode(input.text.toString()) }
+            .setNegativeButton(LocaleController.getString(R.string.Cancel), null)
+            .show()
+    }
+
+    private fun parseCode(text: String) {
+        val marker = text.indexOf("tele_giftstudio?")
+        if (marker < 0) {
+            showError()
+            return
+        }
+        val uri = runCatching { Uri.parse(text.substring(marker)) }.getOrNull()
+        if (uri == null) {
+            showError()
+            return
+        }
+        val name = uri.getQueryParameter("c").orEmpty()
+        if (name.isEmpty()) {
+            showError()
+            return
+        }
+        val modelName = uri.getQueryParameter("m").orEmpty()
+        val backdropName = uri.getQueryParameter("b").orEmpty()
+        val symbolName = uri.getQueryParameter("s").orEmpty()
+        val title = uri.getQueryParameter("t").orEmpty()
+        val numberValue = uri.getQueryParameter("n").orEmpty()
+        val layoutName = uri.getQueryParameter("l").orEmpty()
+        titleOverride = title.ifEmpty { null }
+        number = numberValue
+        TeleGiftPreview.Layout.entries.firstOrNull { it.name.equals(layoutName, true) }?.let { preview.setLayout(it) }
+        if (name == giftName && giftMeta != null) {
+            applyLoadedParts(modelName, backdropName, symbolName)
+        } else {
+            GiftStudioCatalog.requestGift(name) { meta ->
+                giftName = name
+                preview.setGift(name)
+                giftMeta = meta
+                preview.applyTitle(titleOverride ?: name)
+                preview.applyNumber(number)
+                collectionValue?.text = name
+                setRow(titleRow, "Title", titleOverride ?: name)
+                setRow(numberRow, "Number", number)
+                applyLoadedParts(modelName, backdropName, symbolName)
+            }
+        }
+        setRow(layoutRow, "Layout", preview.layout.name)
+    }
+
+    private fun applyLoadedParts(modelName: String, backdropName: String, symbolName: String) {
+        val meta = giftMeta
+        model = meta?.models?.firstOrNull { it.name == modelName } ?: meta?.models?.firstOrNull()
+        backdrop = meta?.backdrops?.firstOrNull { it.name == backdropName } ?: meta?.backdrops?.firstOrNull()
+        symbol = meta?.symbols?.firstOrNull { it.name == symbolName } ?: meta?.symbols?.firstOrNull()
+        applyParts()
+    }
+
+    private fun showSaved() {
+        val text = GiftStudioExport.savedText()
+        BulletinFactory.of(this).createSimpleBulletin(R.raw.info, text).show()
+    }
+
+    private fun showError() {
+        val text = LocaleController.getString(R.string.TeleGiftStudioError)
+        BulletinFactory.of(this).createSimpleBulletin(R.raw.error, text).show()
+    }
+
+    override fun onFragmentDestroy() {
+        super.onFragmentDestroy()
+        preview.release()
+    }
+}
diff --git a/TMessagesProj/src/main/java/tele/ui/TeleStudioPartsList.kt b/TMessagesProj/src/main/java/tele/ui/TeleStudioPartsList.kt
new file mode 100644
index 000000000..3cd3d02b4
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/ui/TeleStudioPartsList.kt
@@ -0,0 +1,228 @@
+package tele.ui
+
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.Canvas
+import android.graphics.Paint
+import android.graphics.RadialGradient
+import android.graphics.RectF
+import android.graphics.Shader
+import android.text.TextUtils
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.View
+import android.view.ViewGroup
+import android.widget.FrameLayout
+import android.widget.ImageView
+import android.widget.LinearLayout
+import android.widget.TextView
+import androidx.recyclerview.widget.LinearLayoutManager
+import androidx.recyclerview.widget.RecyclerView
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.R
+import org.telegram.ui.ActionBar.AlertDialog
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Components.EditTextBoldCursor
+import org.telegram.ui.Components.LayoutHelper
+import org.telegram.ui.Components.RecyclerListView
+import tele.helpers.GiftStudioCatalog
+
+/**
+ * The list of the parts of the studio (desktop 0197): every row shows the picture of the part on
+ * the left, so the choice is seen before it is made. The pictures come from the catalog, so a row
+ * is the part itself, not a card of some other gift.
+ */
+class TeleStudioPartsList(private val context: Context) {
+
+    /**
+     * One row of the list: a gift, a model, a backdrop or a symbol of the catalog. The picture of
+     * the row is chosen by the fields: the gift picture, the model, the symbol or the colors.
+     */
+    class Row(
+        @JvmField val name: String,
+        @JvmField val subtitle: String = "",
+        @JvmField val rarity: String = "",
+        /** The gift of the collection: its own picture is shown. */
+        @JvmField val gift: String? = null,
+        /** The gift the model or the symbol belongs to. */
+        @JvmField val owner: String? = null,
+        @JvmField val model: String? = null,
+        @JvmField val backdrop: GiftStudioCatalog.Backdrop? = null,
+        @JvmField val symbol: String? = null
+    )
+
+    /** The dialog of the parts: a search line on top, then the rows; a pick closes the dialog. */
+    fun create(title: String, rows: List<Row>, onPick: (Row) -> Unit): AlertDialog {
+        var dialog: AlertDialog? = null
+        val view = build(rows) { row ->
+            onPick(row)
+            dialog?.dismiss()
+        }
+        dialog = AlertDialog.Builder(context)
+            .setTitle(title)
+            .setNegativeButton(LocaleController.getString(R.string.Cancel), null)
+            .setView(view)
+            .create()
+        return dialog
+    }
+
+    /** The list of the rows with a search line; the search narrows the rows by their names. */
+    private fun build(rows: List<Row>, onPick: (Row) -> Unit): View {
+        val container = LinearLayout(context)
+        container.orientation = LinearLayout.VERTICAL
+        val search = EditTextBoldCursor(context)
+        search.hint = LocaleController.getString(R.string.Search)
+        search.setBackground(null)
+        search.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16f)
+        search.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
+        // the hint of EditTextBoldCursor follows its own field, so both ways are set
+        search.setHintTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteHintText))
+        search.setHintColor(Theme.getColor(Theme.key_windowBackgroundWhiteHintText))
+        search.setCursorColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
+        search.setLineColors(
+            Theme.getColor(Theme.key_dialogInputField),
+            Theme.getColor(Theme.key_dialogInputFieldActivated),
+            Theme.getColor(Theme.key_text_RedBold)
+        )
+        search.setCursorSize(AndroidUtilities.dp(20f))
+        search.setCursorWidth(1.5f)
+        search.setSingleLine(true)
+        container.addView(search, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, 36, Gravity.TOP, 24, 6, 24, 6))
+        val list = RecyclerListView(context)
+        list.layoutManager = LinearLayoutManager(context, LinearLayoutManager.VERTICAL, false)
+        val adapter = Adapter(rows)
+        list.adapter = adapter
+        list.setOnItemClickListener(object : RecyclerListView.OnItemClickListener {
+            override fun onItemClick(view: View?, position: Int) {
+                val row = adapter.rowAt(position) ?: return
+                onPick(row)
+            }
+        })
+        container.addView(list, LinearLayout.LayoutParams(LayoutHelper.MATCH_PARENT, 400))
+        search.addTextChangedListener(object : android.text.TextWatcher {
+            override fun beforeTextChanged(s: CharSequence?, start: Int, count: Int, after: Int) {}
+            override fun onTextChanged(s: CharSequence?, start: Int, before: Int, count: Int) {}
+            override fun afterTextChanged(s: android.text.Editable?) {
+                val query = s?.toString()?.trim()?.lowercase().orEmpty()
+                adapter.submit(if (query.isEmpty()) rows else rows.filter { it.name.lowercase().contains(query) })
+            }
+        })
+        return container
+    }
+
+    /** The holder of a row: the base one is abstract. */
+    private class Holder(view: View) : RecyclerView.ViewHolder(view)
+
+    private inner class Adapter(private val all: List<Row>) : RecyclerListView.SelectionAdapter() {
+
+        private val rows = ArrayList<Row>().apply { addAll(all) }
+
+        fun submit(list: List<Row>) {
+            rows.clear()
+            rows.addAll(list)
+            notifyDataSetChanged()
+        }
+
+        fun rowAt(position: Int): Row? = rows.getOrNull(position)
+
+        override fun getItemCount(): Int = rows.size
+
+        override fun isEnabled(item: RecyclerView.ViewHolder): Boolean = true
+
+        override fun onCreateViewHolder(parent: ViewGroup, viewType: Int): RecyclerView.ViewHolder {
+            val row = RowView(context)
+            row.layoutParams = RecyclerView.LayoutParams(RecyclerView.LayoutParams.MATCH_PARENT, AndroidUtilities.dp(56f))
+            return Holder(row)
+        }
+
+        override fun onBindViewHolder(holder: RecyclerView.ViewHolder, position: Int) {
+            val row = rows.getOrNull(position) ?: return
+            (holder.itemView as RowView).set(row)
+        }
+    }
+
+    /** One row: the picture of the part on the left, its name, its subtitle and its rarity. */
+    private class RowView(context: Context) : LinearLayout(context) {
+
+        private val picture = FrameLayout(context)
+        private val image = ImageView(context)
+        private val name = TextView(context)
+        private val subtitle = TextView(context)
+        private val rarity = TextView(context)
+
+        init {
+            orientation = HORIZONTAL
+            gravity = Gravity.CENTER_VERTICAL
+            setPadding(AndroidUtilities.dp(16f), 0, AndroidUtilities.dp(16f), 0)
+            image.scaleType = ImageView.ScaleType.FIT_CENTER
+            image.setPadding(AndroidUtilities.dp(4f), AndroidUtilities.dp(4f), AndroidUtilities.dp(4f), AndroidUtilities.dp(4f))
+            picture.addView(image, FrameLayout.LayoutParams(LayoutHelper.MATCH_PARENT, LayoutHelper.MATCH_PARENT))
+            addView(picture, LayoutHelper.createLinear(44f, 44f, Gravity.CENTER_VERTICAL, 0f, 0f, 12f, 0f))
+            val texts = LinearLayout(context)
+            texts.orientation = VERTICAL
+            name.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15f)
+            name.setTextColor(Theme.getColor(Theme.key_dialogTextBlack))
+            name.maxLines = 1
+            name.ellipsize = TextUtils.TruncateAt.END
+            texts.addView(name)
+            subtitle.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13f)
+            subtitle.setTextColor(Theme.getColor(Theme.key_dialogTextGray3))
+            subtitle.maxLines = 1
+            subtitle.ellipsize = TextUtils.TruncateAt.END
+            texts.addView(subtitle)
+            addView(texts, LayoutHelper.createLinear(0, LayoutHelper.WRAP_CONTENT, 1f, Gravity.CENTER_VERTICAL, 0, 0, 8, 0))
+            rarity.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13f)
+            rarity.setTextColor(Theme.getColor(Theme.key_dialogTextGray2))
+            addView(rarity, LayoutHelper.createLinear(LayoutHelper.WRAP_CONTENT, LayoutHelper.WRAP_CONTENT, Gravity.CENTER_VERTICAL))
+        }
+
+        fun set(row: Row) {
+            name.text = row.name
+            subtitle.text = row.subtitle
+            subtitle.visibility = if (row.subtitle.isEmpty()) GONE else VISIBLE
+            rarity.text = row.rarity
+            image.setImageDrawable(null)
+            image.visibility = VISIBLE
+            val backdrop = row.backdrop
+            if (backdrop != null) {
+                image.visibility = GONE
+                picture.background = BackdropSwatch(backdrop)
+                return
+            }
+            picture.background = null
+            val tag = row.name
+            image.tag = tag
+            val done: (Bitmap?) -> Unit = { bitmap ->
+                if (image.tag == tag && bitmap != null) image.setImageBitmap(bitmap)
+            }
+            when {
+                row.gift != null -> GiftStudioCatalog.giftPng(row.gift, 128, done)
+                row.owner != null && row.model != null -> GiftStudioCatalog.modelPng(row.owner, row.model, 128, done)
+                row.owner != null && row.symbol != null -> GiftStudioCatalog.symbolPng(row.owner, row.symbol, 128, done)
+            }
+        }
+
+        /** The colors of a backdrop: its center and its edge, as its own card shows them. */
+        private class BackdropSwatch(private val backdrop: GiftStudioCatalog.Backdrop) : android.graphics.drawable.Drawable() {
+            private val paint = Paint(Paint.ANTI_ALIAS_FLAG)
+            private val rect = RectF()
+
+            override fun draw(canvas: Canvas) {
+                rect.set(bounds)
+                paint.shader = RadialGradient(
+                    rect.centerX(), rect.centerY(), Math.max(rect.width(), rect.height()) * 0.62f,
+                    intArrayOf(backdrop.center, backdrop.center, backdrop.edge),
+                    floatArrayOf(0f, 0.45f, 1f), Shader.TileMode.CLAMP
+                )
+                val radius = AndroidUtilities.dp(10f).toFloat()
+                canvas.drawRoundRect(rect, radius, radius, paint)
+                paint.shader = null
+            }
+
+            override fun setAlpha(alpha: Int) {}
+            override fun setColorFilter(colorFilter: android.graphics.ColorFilter?) {}
+            override fun getOpacity(): Int = android.graphics.PixelFormat.TRANSLUCENT
+        }
+    }
+}
