+package tele.ui
+
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.Canvas
+import android.graphics.Paint
+import android.graphics.RectF
+import android.view.Gravity
+import android.view.View
+import android.view.ViewGroup
+import android.widget.FrameLayout
+import android.widget.LinearLayout
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.R
+import org.telegram.tgnet.tl.TL_stars
+import org.telegram.ui.ActionBar.ActionBar
+import org.telegram.ui.ActionBar.AlertDialog
+import org.telegram.ui.ActionBar.BaseFragment
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Cells.TextSettingsCell
+import org.telegram.ui.Components.BulletinFactory
+import org.telegram.ui.Components.LayoutHelper
+import org.telegram.ui.Stars.StarsController
+import tele.TeleConfig
+import tele.helpers.GiftStudio
+import tele.helpers.GiftStudioCatalog
+import tele.helpers.GiftStudioModels
+import tele.helpers.GiftStudioExport
+import tele.helpers.GiftStudioRenderer
+import tele.helpers.TeleLowercase
+import tele.helpers.TeleToast
+
+/**
+ * The gift studio (desktop 0197): a gift is built of a model, a backdrop and a symbol and the
+ * result is exported as a picture. The parts come from the gifts of the account, so nothing is
+ * asked of a third party.
+ */
+class TeleGiftStudioActivity @JvmOverloads constructor(
+    private val account: Int,
+    private val dialogId: Long,
+    private val initial: TL_stars.SavedStarGift? = null
+) : BaseFragment() {
+
+    private var giftPreview: TeleGiftPreview? = null
+    private var layoutRow: TextSettingsCell? = null
+    private var collectionCard: org.telegram.ui.Gifts.GiftSheet.GiftCell? = null
+    private var usedCatalogGift: String? = null
+    private var catalogRow: TextSettingsCell? = null
+    private var collectionRow: TextSettingsCell? = null
+    private var modelRow: TextSettingsCell? = null
+    private var backdropRow: TextSettingsCell? = null
+    private var symbolRow: TextSettingsCell? = null
+    private var rarityRow: TextSettingsCell? = null
+    private var saveRow: TextSettingsCell? = null
+    private var videoRow: TextSettingsCell? = null
+    private var moreRow: TextSettingsCell? = null
+    private var pillRow: RarityPillView? = null
+    private val partsList by lazy { TeleStudioPartsList(parentActivity ?: context, account, resourceProvider) }
+
+    private val gifts = ArrayList<TL_stars.StarGift>()
+    private var parts: GiftStudio.Parts = GiftStudio.Parts(emptyList(), emptyList(), emptyList())
+    private var gift: TL_stars.StarGift? = null
+    private var useCatalog = false
+    private var catalogParts: GiftStudio.Parts? = null
+    private var model: GiftStudio.Part? = null
+    private var backdrop: GiftStudio.Part? = null
+    private var symbol: GiftStudio.Part? = null
+    private var generation = 0
+
+    override fun createView(context: Context): View {
+        actionBar.setBackButtonImage(R.drawable.ic_ab_back)
+        actionBar.setAllowOverlayTitle(true)
+        actionBar.setTitle(lc("Gift studio"))
+        actionBar.setActionBarMenuOnItemClick(object : ActionBar.ActionBarMenuOnItemClick() {
+            override fun onItemClick(id: Int) {
+                if (id == -1) finishFragment()
+            }
+        })
+
+        val container = LinearLayout(context)
+        container.orientation = LinearLayout.VERTICAL
+        container.setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundGray))
+
+        giftPreview = TeleGiftPreview(context, account, resourceProvider)
+        giftPreview?.setStudio(object : TeleGiftPreview.Studio {
+            override fun modelFile(gift: TL_stars.StarGift): String? = catalogModelFile
+            override fun symbolFile(gift: TL_stars.StarGift): String? = catalogSymbolFile
+        })
+        container.addView(giftPreview?.view(), LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, AndroidUtilities.dp(340f)))
+        layoutRow = addRow(container, "Layout") { chooseLayout() }
+        collectionRow = addRowWithCard(container, "Collection") { chooseCollection() }
+        modelRow = addRow(container, "Model") { chooseModel() }
+        backdropRow = addRow(container, "Backdrop") { chooseBackdrop() }
+        symbolRow = addRow(container, "Symbol") { chooseSymbol() }
+        if (TeleConfig.GIFT_STUDIO_MODELS.value) {
+            moreRow = addRow(container, "More models") { chooseMoreModels() }
+        }
+        rarityRow = addRow(container, "Rarity") {}
+        rarityRow?.isEnabled = false
+        val pill = RarityPillView(context)
+        pillRow = pill
+        container.addView(pill, LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT))
+
+        saveRow = addRow(container, "Save as a picture") { savePng() }
+        if (TeleConfig.GIFT_STUDIO_VIDEO.value) {
+            videoRow = addRow(container, "Save as a video") { saveVideo() }
+        }
+
+        fragmentView = container
+        load()
+        return container
+    }
+
+    private fun lc(text: String): String = TeleLowercase.lc(text)
+
+    private fun addRow(container: LinearLayout, title: String, action: () -> Unit): TextSettingsCell {
+        val cell = TextSettingsCell(container.context)
+        cell.setText(lc(title), false)
+        cell.setOnClickListener { action() }
+        container.addView(cell, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT))
+        return cell
+    }
+
+    /** A row with the card of the gift on the left, like the desktop client shows it. */
+    private fun addRowWithCard(container: LinearLayout, title: String, action: () -> Unit): TextSettingsCell {
+        val cell = TextSettingsCell(container.context)
+        cell.setText(lc(title), false)
+        cell.setOnClickListener { action() }
+        val card = org.telegram.ui.Gifts.GiftSheet.GiftCell(container.context, account, resourceProvider)
+        card.setImageSize(44)
+        collectionCard = card
+        cell.addView(card, LayoutHelper.createFrame(44f, 44f, Gravity.CENTER_VERTICAL or Gravity.LEFT, 12f, 0f, 0f, 0f))
+        container.addView(cell, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, AndroidUtilities.dp(56f)))
+        return cell
+    }
+
+    private fun load() {
+        val stars = StarsController.getInstance(account)
+        val found = ArrayList<TL_stars.StarGift>()
+        for (gift in stars.gifts) {
+            found.add(gift)
+        }
+        if (dialogId != 0L) {
+            val list = stars.getProfileGiftsList(dialogId, false)
+            if (list != null) {
+                for (saved in list.gifts) {
+                    if (saved.gift is TL_stars.TL_starGiftUnique) found.add(saved.gift)
+                }
+            }
+        }
+        gifts.clear()
+        gifts.addAll(found)
+        parts = GiftStudio.collectParts(found)
+        val first = found.firstOrNull()
+        if (first != null) select(first)
+        val initialGift = initial?.gift
+        if (initialGift != null) {
+            found.add(initialGift)
+            parts = GiftStudio.collectParts(found)
+            select(initialGift)
+        }
+        // the parts come from the catalog, so the pickers never need the gifts of the account
+        loadCatalog()
+    }
+
+    /** The parts of the first gift of the catalog; the pickers use them with the gifts of the account. */
+    private fun loadCatalog() {
+        GiftStudioCatalog.requestGifts { giftsOfCatalog ->
+            if (giftsOfCatalog.isEmpty()) {
+                update()
+                return@requestGifts
+            }
+            val gift = giftsOfCatalog.first()
+            usedCatalogGift = gift
+            GiftStudioCatalog.requestParts(gift) { found ->
+                catalogParts = GiftStudio.Parts(
+                    found.models.map { GiftStudio.Part(it.name, it.permille, null, 0, 0, 0, 0, 0, null, it.tier) },
+                    found.backdrops.map {
+                        GiftStudio.Part(it.name, it.permille, null, 0, it.centerColor, it.edgeColor, it.patternColor, it.textColor, null, it.tier)
+                    },
+                    found.symbols.map { GiftStudio.Part(it.name, it.permille, null, 0, 0, 0, 0, 0, null, it.tier) }
+                )
+                // without a gift of this account the studio still has something to build
+                if (this.gift == null) buildVirtualGift()
+                update()
+            }
+        }
+    }
+
+    /**
+     * A gift of the catalog when the account has none of its own: the model is the .tgs of the
+     * catalog and the rest of the parts are the first of every kind, so the preview draws something.
+     */
+    private fun buildVirtualGift() {
+        val parts = catalogParts ?: return
+        val nameOfCatalog = usedCatalogGift ?: return
+        val model = parts.models.firstOrNull() ?: return
+        val backdrop = parts.backdrops.firstOrNull()
+        val symbol = parts.symbols.firstOrNull()
+        val virtual = org.telegram.tgnet.tl.TL_stars.StarGift()
+        virtual.title = nameOfCatalog
+        virtual.limited = false
+        virtual.can_upgrade = false
+        val attributes = ArrayList<org.telegram.tgnet.tl.TL_stars.StarGiftAttribute>()
+        val modelAttribute = org.telegram.tgnet.tl.TL_stars.starGiftAttributeModel()
+        modelAttribute.name = model.name
+        attributes.add(modelAttribute)
+        if (backdrop != null) {
+            val backdropAttribute = org.telegram.tgnet.tl.TL_stars.starGiftAttributeBackdrop()
+            backdropAttribute.name = backdrop.name
+            backdropAttribute.backdrop_id = backdrop.backdropId
+            backdropAttribute.center_color = backdrop.centerColor
+            backdropAttribute.edge_color = backdrop.edgeColor
+            backdropAttribute.pattern_color = backdrop.patternColor
+            backdropAttribute.text_color = backdrop.textColor
+            attributes.add(backdropAttribute)
+        }
+        if (symbol != null) {
+            val patternAttribute = org.telegram.tgnet.tl.TL_stars.starGiftAttributePattern()
+            patternAttribute.name = symbol.name
+            attributes.add(patternAttribute)
+        }
+        virtual.attributes = attributes
+        gifts.add(virtual)
+        this.model = model
+        this.backdrop = backdrop
+        this.symbol = symbol
+        this.gift = virtual
+        // the model and the symbol of the catalog are .tgs files, so the preview draws them
+        val name = nameOfCatalog
+        downloadCatalogTgs(name, model.name, "model") { file ->
+            catalogModelFile = file
+            giftPreview?.remember(virtual)
+        }
+        downloadCatalogTgs(name, symbol?.name ?: "", "symbol") { file ->
+            catalogSymbolFile = file
+            giftPreview?.remember(virtual)
+        }
+        giftPreview?.remember(virtual)
+    }
+
+    private var catalogModelFile: String? = null
+    private var catalogSymbolFile: String? = null
+
+    /** Downloads the .tgs of a part of the catalog into the fork storage and gives its path. */
+    private fun downloadCatalogTgs(gift: String, part: String, kind: String, done: (String?) -> Unit) {
+        if (part.isEmpty()) {
+            done(null)
+            return
+        }
+        val target = java.io.File(
+            org.telegram.messenger.ApplicationLoader.getFilesDirFixed(),
+            "tele_gift_studio_${kind}_$part.tgs"
+        )
+        if (target.exists()) {
+            done(target.absolutePath)
+            return
+        }
+        val save = { bytes: ByteArray ->
+            if (bytes.isEmpty()) {
+                done(null)
+            } else {
+                try {
+                    java.io.FileOutputStream(target).use { it.write(bytes) }
+                } catch (throwable: Throwable) {
+                    org.telegram.messenger.FileLog.e(throwable)
+                }
+                done(target.absolutePath)
+            }
+        }
+        if (kind == "model") {
+            GiftStudioCatalog.requestModelTgs(gift, part, save)
+        } else {
+            GiftStudioCatalog.requestSymbolTgs(gift, part, save)
+        }
+    }
+
+    private fun select(gift: TL_stars.StarGift) {
+        this.gift = gift
+        val own = if (gift is TL_stars.TL_starGiftUnique) {
+            GiftStudio.partsOf(gift)
+        } else {
+            GiftStudio.partsOfRegularGift(gift)
+        }
+        model = own.models.firstOrNull() ?: models().firstOrNull()
+        backdrop = own.backdrops.firstOrNull() ?: backdrops().firstOrNull()
+        symbol = own.symbols.firstOrNull() ?: symbols().firstOrNull()
+        update()
+    }
+
+    /** The layout of the preview, like the desktop client. */
+    private fun chooseLayout() {
+        val layouts = arrayOf("Cover", "Tile", "Sticker", "Card")
+        val builder = AlertDialog.Builder(parentActivity, resourceProvider)
+            .setTitle(lc("Layout"))
+            .setItems(layouts) { _, which ->
+                giftPreview?.setLayout(TeleGiftPreview.Layout.entries[which])
+            }
+        builder.show()
+    }
+
+    private fun update() {
+        val gift = gift
+        collectionRow?.setValue(gift?.title ?: "", true)
+        modelRow?.setValue(model?.name ?: "", true)
+        backdropRow?.setValue(backdrop?.name ?: "", true)
+        symbolRow?.setValue(symbol?.name ?: "", true)
+        val modelPart = model
+        val modelTier = modelPart?.tier ?: GiftStudio.Tier.DEFAULT
+        val modelPermille = modelPart?.permille ?: 0
+        val backdropPermille = backdrop?.permille ?: 0
+        // a tier of the catalog is the rarity of the gift, so its value is negative
+        val rarityValue = if (modelTier != GiftStudio.Tier.DEFAULT) modelTier.value else modelPermille
+        val odds = GiftStudio.rarityOdds(rarityValue, backdropPermille)
+        val chance = GiftStudio.rarityChance(rarityValue, backdropPermille)
+        rarityRow?.setValue(
+            when {
+                odds.isEmpty() -> lc("unknown")
+                chance.isEmpty() -> odds
+                else -> "$odds ($chance)"
+            },
+            true
+        )
+        pillRow?.setPart(modelPart)
+        giftPreview?.setParts(
+            TeleGiftPreview.Parts(
+                title = gift?.title ?: "",
+                number = gift?.num?.takeIf { it > 0 }?.let { "#$it" } ?: "",
+                subtitle = listOfNotNull(model?.name, backdrop?.name, symbol?.name).joinToString(" · "),
+                model = model,
+                backdrop = backdrop,
+                symbol = symbol
+            )
+        )
+        val built = gift?.let { GiftStudio.giftWithParts(it, model, backdrop, symbol) }
+        if (built != null) {
+            collectionCard?.setStarsGift(built, false, false, false, false, false)
+        } else {
+            collectionCard?.hidePrice()
+        }
+    }
+
+    private fun chooseCollection() {
+        val rows = gifts.map { gift ->
+            TeleStudioPartsList.Row(GiftStudio.Part(gift.title ?: "", 0, gift.getDocument(), 0, 0, 0, 0, 0, null, GiftStudio.Tier.DEFAULT), gift, gift.title ?: "")
+        }
+        showDialog(partsList.dialog(lc("Collection"), rows, null, { part ->
+            val gift = gifts.firstOrNull { it.title == part.name }
+            if (gift != null) select(gift)
+        }, {}))
+    }
+
+    private fun choosePart(title: String, list: List<GiftStudio.Part>, apply: (GiftStudio.Part?) -> Unit) {
+        val rows = TeleStudioPartsList.rowsOf(list, gifts)
+        showDialog(partsList.dialog(lc(title), rows, null, { part -> apply(part) }, {}))
+    }
+
+    /** The parts of the catalog are added to the parts of the gifts of the account. */
+    private fun models(): List<GiftStudio.Part> = parts.models + (catalogParts?.models ?: emptyList())
+
+    private fun backdrops(): List<GiftStudio.Part> = parts.backdrops + (catalogParts?.backdrops ?: emptyList())
+
+    private fun symbols(): List<GiftStudio.Part> = parts.symbols + (catalogParts?.symbols ?: emptyList())
+
+    private fun chooseModel() {
+        choosePart("Model", models()) {
+            model = it
+            update()
+        }
+    }
+
+    private fun chooseBackdrop() {
+        choosePart("Backdrop", backdrops()) {
+            backdrop = it
+            update()
+        }
+    }
+
+    private fun chooseSymbol() {
+        choosePart("Symbol", symbols()) {
+            symbol = it
+            update()
+        }
+    }
+
+    private fun chooseMoreModels() {
+        val items = ArrayList<String>()
+        val actions = ArrayList<() -> Unit>()
+        for (gift in gifts) {
+            if (gift === this.gift) continue
+            val own = GiftStudio.partsOf(gift)
+            for (part in own.models) {
+                items.add(part.name)
+                actions.add {
+                    model = part
+                    update()
+                }
+            }
+        }
+        for (custom in GiftStudioModels.list()) {
+            items.add(custom.key)
+            actions.add {
+                model = GiftStudio.Part(custom.key, 0, null, 0, 0, 0, 0, 0, GiftStudioModels.fileFor(custom.id).absolutePath, GiftStudio.Tier.DEFAULT)
+                update()
+            }
+        }
+        if (items.isEmpty()) return
+        val builder = AlertDialog.Builder(parentActivity, resourceProvider)
+            .setTitle(lc("More models"))
+            .setItems(items.toTypedArray()) { _, which -> actions[which]() }
+        builder.show()
+    }
+
+    private fun savePng() {
+        val size = GiftStudioRenderer.exportSize(1)
+        val bitmap = giftPreview?.bitmap(size, size)
+        if (bitmap == null) {
+            showError()
+            return
+        }
+        try {
+            val name = GiftStudioExport.fileName(gift?.title, gift?.num?.takeIf { it > 0 }?.let { "#$it" }, GiftStudioExport.Format.PNG)
+            val uri = GiftStudioExport.savePng(bitmap, name)
+            if (uri == null) {
+                showError()
+                return
+            }
+            showSaved()
+        } catch (throwable: Throwable) {
+            org.telegram.messenger.FileLog.e(throwable)
+            showError()
+        }
+    }
+
+    private fun saveVideo() {
+        val size = GiftStudioRenderer.exportSize(1)
+        val frames = ArrayList<Bitmap>()
+        for (index in 0 until GiftStudioExport.videoFrames()) {
+            val frame = giftPreview?.bitmap(size, size)
+            if (frame != null) frames.add(frame)
+        }
+        if (frames.isEmpty()) {
+            showError()
+            return
+        }
+        val name = GiftStudioExport.fileName(gift?.title, gift?.num?.takeIf { it > 0 }?.let { "#$it" }, GiftStudioExport.Format.MP4)
+        val uri = GiftStudioExport.saveVideo(name, frames)
+        for (frame in frames) frame.recycle()
+        if (uri == null) {
+            showError()
+            return
+        }
+        showSaved()
+    }
+
+    private fun showSaved() {
+        val text = GiftStudioExport.savedText()
+        TeleToast.log("gift-studio-saved", text, account = account)
+        BulletinFactory.of(this).createSimpleBulletin(R.raw.info, text).show()
+    }
+
+    private fun showError() {
+        val text = LocaleController.getString(R.string.TeleGiftStudioError)
+        TeleToast.log("gift-studio-error", text, account = account)
+        BulletinFactory.of(this).createSimpleBulletin(R.raw.error, text).show()
+    }
+
+    override fun onFragmentDestroy() {
+        super.onFragmentDestroy()
+        giftPreview?.release()
+        giftPreview = null
+    }
+
+}
