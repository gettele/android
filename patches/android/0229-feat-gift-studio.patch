+        if (name.isNotEmpty()) {
+            GiftStudioCatalog.giftPng(name, 128) { bitmap ->
+                if (picture?.tag == tag && bitmap != null) picture.setImageBitmap(bitmap)
+            }
+        } else {
+            picture?.setImageDrawable(null)
+        }
+        GiftStudioCatalog.requestGift(name) { meta ->
+            if (giftName != name) return@requestGift
+            giftMeta = meta
+            model = meta?.models?.firstOrNull { it.name == initialModel } ?: meta?.models?.firstOrNull()
+            backdrop = meta?.backdrops?.firstOrNull { it.name == initialBackdrop } ?: meta?.backdrops?.firstOrNull()
