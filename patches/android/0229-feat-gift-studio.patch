new file mode 100644
index 000000000..dd1bfe4da
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/ui/TeleStudioPartsList.kt
@@ -0,0 +1,174 @@
+package tele.ui
+
+import android.content.Context
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.View
+import android.view.ViewGroup
+import android.widget.LinearLayout
+import android.widget.TextView
+import androidx.recyclerview.widget.LinearLayoutManager
+import androidx.recyclerview.widget.RecyclerView
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.R
+import org.telegram.tgnet.tl.TL_stars
+import org.telegram.ui.ActionBar.AlertDialog
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Components.LayoutHelper
+import org.telegram.ui.Components.RecyclerListView
+import org.telegram.ui.Gifts.GiftSheet
+import tele.helpers.GiftStudio
+
+/**
+ * The list of the parts of the studio (desktop 0197): every row shows the card of the gift on the
+ * left, so the choice is seen before it is made. The card is the stock one of Telegram.
+ */
+class TeleStudioPartsList(
+    private val context: Context,
+    private val account: Int,
+    private val resourcesProvider: Theme.ResourcesProvider?
+) {
+
+    /** One row of the list: a part with the gift it belongs to. */
+    class Row(
+        @JvmField val part: GiftStudio.Part,
+        @JvmField val gift: TL_stars.StarGift?,
+        @JvmField val title: String
+    )
+
+    /**
+     * The dialog of the parts, every row with the card of the gift of the part. The caller shows it.
+     *
+     * [onPick] is called with the chosen part, [onCancel] when the list is closed without a choice.
+     */
+    fun dialog(
+        title: String,
+        rows: List<Row>,
+        selected: GiftStudio.Part?,
+        onPick: (GiftStudio.Part) -> Unit,
+        onCancel: () -> Unit
+    ): AlertDialog {
+        // an empty list still opens, so the row of the setting is never dead
+        val list = if (rows.isEmpty()) emptyList(context, resourcesProvider) else partsList(context, resourcesProvider, rows, selected, onPick)
+        return AlertDialog.Builder(context, resourcesProvider)
+            .setTitle(title)
+            .setView(list)
+            .setNegativeButton(LocaleController.getString(R.string.Cancel)) { _, _ -> onCancel() }
+            .create()
+    }
+
+    /** The list of the parts. */
+    private fun partsList(
+        context: Context,
+        resourcesProvider: Theme.ResourcesProvider?,
+        rows: List<Row>,
+        selected: GiftStudio.Part?,
+        onPick: (GiftStudio.Part) -> Unit
+    ): RecyclerListView {
+        val list = RecyclerListView(context)
+        list.layoutManager = LinearLayoutManager(context)
+        list.adapter = Adapter(rows, selected)
+        list.setOnItemClickListener { _, position ->
+            rows.getOrNull(position)?.let { onPick(it.part) }
+        }
+        return list
+    }
+
+    /** A list that only says there is nothing to pick yet. */
+    private fun emptyList(context: Context, resourcesProvider: Theme.ResourcesProvider?): View {
+        val text = TextView(context)
+        text.setText(LocaleController.getString(R.string.TeleGiftStudioNoParts))
+        text.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14f)
+        text.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2, resourcesProvider))
+        text.setPadding(AndroidUtilities.dp(32f), AndroidUtilities.dp(48f), AndroidUtilities.dp(32f), AndroidUtilities.dp(48f))
+        return text
+    }
+
+    private inner class Adapter(
+        private val rows: List<Row>,
+        private val selected: GiftStudio.Part?
+    ) : RecyclerListView.SelectionAdapter() {
+
+        override fun getItemCount(): Int = rows.size
+
+        override fun isEnabled(holder: RecyclerView.ViewHolder): Boolean = true
+
+        override fun onCreateViewHolder(parent: ViewGroup, viewType: Int): RecyclerView.ViewHolder {
+            return Holder(RowView(context, account, resourcesProvider))
+        }
+
+        override fun onBindViewHolder(holder: RecyclerView.ViewHolder, position: Int) {
+            val row = rows[position]
+            (holder.itemView as RowView).set(row, row.part === selected)
+        }
+    }
+
+    private class Holder(val row: RowView) : RecyclerView.ViewHolder(row)
+
+    /** One row: the card of the gift on the left and the name of the part on the right. */
+    private class RowView(
+        context: Context,
+        account: Int,
+        resourcesProvider: Theme.ResourcesProvider?
+    ) : LinearLayout(context) {
+
+        private val cell: GiftSheet.GiftCell
+        private val nameView: TextView
+        private val chanceView: TextView
+
+        init {
+            orientation = HORIZONTAL
+            gravity = Gravity.CENTER_VERTICAL
+            setPadding(AndroidUtilities.dp(12f), AndroidUtilities.dp(6f), AndroidUtilities.dp(16f), AndroidUtilities.dp(6f))
+            cell = GiftSheet.GiftCell(context, account, resourcesProvider)
+            cell.setImageSize(52)
+            addView(cell, LayoutHelper.createLinear(52, 52))
+            val text = LinearLayout(context)
+            text.orientation = VERTICAL
+            nameView = TextView(context)
+            nameView.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16f)
+            nameView.setTextColor(Theme.getColor(Theme.key_dialogTextBlack, resourcesProvider))
+            chanceView = TextView(context)
+            chanceView.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13f)
+            chanceView.setTextColor(Theme.getColor(Theme.key_dialogTextGray2, resourcesProvider))
+            text.addView(nameView, LayoutHelper.createLinear(LayoutHelper.WRAP_CONTENT, LayoutHelper.WRAP_CONTENT))
+            text.addView(chanceView, LayoutHelper.createLinear(LayoutHelper.WRAP_CONTENT, LayoutHelper.WRAP_CONTENT))
+            addView(text, LayoutHelper.createLinear(0, LayoutHelper.WRAP_CONTENT, 1f))
+        }
+
+        fun set(row: Row, selected: Boolean) {
+            nameView.text = row.title
+            chanceView.text = GiftStudio.rarityOdds(row.part.permille, 1000)
+            chanceView.visibility = if (chanceView.text.isEmpty()) GONE else VISIBLE
+            // the card of the gift the part belongs to
+            val gift = row.gift
+            if (gift != null) {
+                cell.setStarsGift(gift, false, false, false, false, false)
+            }
+            alpha = if (selected) 1f else 0.85f
+        }
+    }
+
+    companion object {
+        /** The rows of the parts of one kind, with the gift of every part. */
+        @JvmStatic
+        fun rowsOf(parts: List<GiftStudio.Part>, gifts: List<TL_stars.StarGift>): List<Row> {
+            val result = ArrayList<Row>()
+            for (part in parts) {
+                val gift = gifts.firstOrNull { gift ->
+                    gift.attributes.any { attribute ->
+                        when (attribute) {
+                            is TL_stars.starGiftAttributeModel -> attribute.name == part.name
+                            is TL_stars.starGiftAttributeBackdrop -> attribute.name == part.name
+                            is TL_stars.starGiftAttributePattern -> attribute.name == part.name
+                            else -> false
+                        }
+                    }
+                }
+                result.add(Row(part, gift, part.name))
+            }
+            return result
+        }
+    }
+}
