+        private const val BUTTON_HEIGHT = 30f
+
+        private const val FADED = 0.2f
+        private const val OPAQUE = 0.3f
+
+        /** The points of the desktop client: x and y of the design, the scale and the opacity. */
+        private val PATTERN_BIG = pattern(0.70f, 0.85f)
+        private val PATTERN_SMALL = pattern(0.45f, 0.55f)
+
+        /** The two lists of the desktop client: the same points at a different scale. */
+        private fun pattern(small: Float, large: Float): Array<FloatArray> = arrayOf(
+            floatArrayOf(0.500f, 0.066f, small, FADED),
+            floatArrayOf(0.177f, 0.168f, small, FADED),
