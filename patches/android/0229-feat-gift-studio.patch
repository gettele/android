diff --git a/TMessagesProj/src/main/java/tele/helpers/GiftStudio.kt b/TMessagesProj/src/main/java/tele/helpers/GiftStudio.kt
new file mode 100644
index 000000000..d8eb0a5ec
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/GiftStudio.kt
@@ -0,0 +1,294 @@
+package tele.helpers
+
+import org.telegram.tgnet.TLRPC
+import org.telegram.tgnet.tl.TL_stars
+import java.util.Locale
+
+/**
+ * The parts a gift is built of in the gift studio (desktop 0197): the model, the backdrop and the
+ * symbol. The parts come from the gifts of the account, so no third party is asked for them.
+ */
+object GiftStudio {
+
+    /** The tier of a part of the catalog (desktop 0248). */
+    enum class Tier(val value: Int, val color: Int) {
+        DEFAULT(0, 0),
+        UNCOMMON(-1, 0xFF40A920.toInt()),
+        RARE(-2, 0xFF11AABE.toInt()),
+        EPIC(-3, 0xFF955CDB.toInt()),
+        LEGENDARY(-4, 0xFFBF7600.toInt());
+
+        companion object {
+            /** The tier of a name of the catalog; [DEFAULT] when the name is unknown. */
+            @JvmStatic
+            fun of(name: String?): Tier {
+                return when (name?.trim()?.lowercase()) {
+                    "uncommon" -> UNCOMMON
+                    "rare" -> RARE
+                    "epic" -> EPIC
+                    "legendary" -> LEGENDARY
+                    else -> DEFAULT
+                }
+            }
+        }
+    }
+
+    /** One value of a part: a model, a backdrop or a symbol. */
+    class Part(
+        @JvmField val name: String,
+        @JvmField val permille: Int,
+        @JvmField val document: TLRPC.Document?,
+        @JvmField val backdropId: Int,
+        @JvmField val centerColor: Int,
+        @JvmField val edgeColor: Int,
+        @JvmField val patternColor: Int,
+        @JvmField val textColor: Int,
+        /** The file of a custom model of the device; empty for the models of Telegram. */
+        @JvmField val localPath: String? = null,
+        /** The tier of the part of the catalog; [Tier.DEFAULT] when it has none. */
+        @JvmField val tier: Tier = Tier.DEFAULT
+    )
+
+    /** The parts of a gift. */
+    class Parts(
+        @JvmField val models: List<Part>,
+        @JvmField val backdrops: List<Part>,
+        @JvmField val symbols: List<Part>
+    )
+
+    /** The rarity of a part in percent; empty when the part has no rarity. */
+    @JvmStatic
+    fun rarityText(permille: Int): String {
+        if (permille <= 0) return ""
+        val percent = permille / 10.0
+        if (percent < 0.1) return "<0.1%"
+        return String.format(Locale.US, "%.1f%%", percent)
+    }
+
+    /** The name of the tier of a part; empty when the part has no tier. */
+    @JvmStatic
+    fun tierText(tier: Tier): String {
+        return when (tier) {
+            Tier.UNCOMMON -> org.telegram.messenger.LocaleController.getString(org.telegram.messenger.R.string.TeleGiftStudioRarityUncommon)
+            Tier.RARE -> org.telegram.messenger.LocaleController.getString(org.telegram.messenger.R.string.TeleGiftStudioRarityRare)
+            Tier.EPIC -> org.telegram.messenger.LocaleController.getString(org.telegram.messenger.R.string.TeleGiftStudioRarityEpic)
+            Tier.LEGENDARY -> org.telegram.messenger.LocaleController.getString(org.telegram.messenger.R.string.TeleGiftStudioRarityLegendary)
+            Tier.DEFAULT -> ""
+        }
+    }
+
+    /** The value of the rarity of a part: the tier when it has one, the permille otherwise. */
+    @JvmStatic
+    fun rarityValue(part: Part): Int {
+        if (part.tier != Tier.DEFAULT) return part.tier.value
+        return part.permille
+    }
+
+    /** The tier of an attribute of Telegram; [Tier.DEFAULT] when it has none. */
+    @JvmStatic
+    fun tierOf(attribute: TL_stars.StarGiftAttribute): Tier {
+        val rarity = attribute.rarity ?: return Tier.DEFAULT
+        return when (rarity) {
+            is TL_stars.TL_starGiftAttributeRarityUncommon -> Tier.UNCOMMON
+            is TL_stars.TL_starGiftAttributeRarityRare -> Tier.RARE
+            is TL_stars.TL_starGiftAttributeRarityEpic -> Tier.EPIC
+            is TL_stars.TL_starGiftAttributeRarityLegendary -> Tier.LEGENDARY
+            else -> Tier.DEFAULT
+        }
+    }
+
+    /** The tier of a value of a rarity; [Tier.DEFAULT] when the value is not a tier. */
+    @JvmStatic
+    fun tierOf(value: Int): Tier {
+        for (tier in Tier.values()) {
+            if (tier != Tier.DEFAULT && tier.value == value) return tier
+        }
+        return Tier.DEFAULT
+    }
+
+    /** The color of the pill of the rarity; empty when the part has no tier. */
+    @JvmStatic
+    fun rarityColor(tier: Tier): Int {
+        if (tier == Tier.DEFAULT) return 0
+        return tier.color
+    }
+
+    /** How rare the model and the backdrop together are. */
+    @JvmStatic
+    fun rarityOdds(modelPermille: Int, backdropPermille: Int): String {
+        if (modelPermille < 0) {
+            // the value of a tier is negative, so the tier of the model is the rarity of the gift
+            val tier = tierOf(modelPermille)
+            return if (tier == Tier.DEFAULT) "" else tierText(tier)
+        }
+        if (modelPermille <= 0 || backdropPermille <= 0) return ""
+        val odds = 1000000.0 / (modelPermille.toDouble() * backdropPermille)
+        return "1 in " + String.format(Locale.US, "%,d", odds.toLong())
+    }
+
+    /** The chance of the model and the backdrop together, in percent. */
+    @JvmStatic
+    fun rarityChance(modelPermille: Int, backdropPermille: Int): String {
+        if (modelPermille < 0) return ""
+        if (modelPermille <= 0 || backdropPermille <= 0) return ""
+        val percent = modelPermille * backdropPermille / 10000.0
+        var text = if (percent >= 1.0) {
+            String.format(Locale.US, "%.2f%%", percent)
+        } else {
+            String.format(Locale.US, "%.3f%%", percent)
+        }
+        while (text.endsWith("0")) text = text.dropLast(1)
+        if (text.endsWith(".")) text = text.dropLast(1)
+        return text
+    }
+
+    /** The parts of the gifts: every model, backdrop and symbol among them. */
+    @JvmStatic
+    fun partsOfRegularGift(gift: TL_stars.StarGift): Parts {
+        val own = partsOf(gift)
+        return Parts(
+            listOf(GiftStudio.Part(
+                gift.title ?: "Original", 0, gift.getDocument(), 0, 0, 0, 0, 0, null, Tier.DEFAULT
+            )) + own.models,
+            own.backdrops,
+            own.symbols
+        )
+    }
+
+    /** The parts of the gifts: every model, backdrop and symbol among them. */
+    @JvmStatic
+    fun collectParts(gifts: List<TL_stars.StarGift>): Parts {
+        val models = LinkedHashMap<String, Part>()
+        val backdrops = LinkedHashMap<String, Part>()
+        val symbols = LinkedHashMap<String, Part>()
+        for (gift in gifts) {
+            for (attribute in gift.attributes) {
+                if (attribute is TL_stars.starGiftAttributeModel) {
+                    val name = attribute.name ?: continue
+                    models[name] = Part(name, attribute.getRarityPermille(), attribute.document, 0, 0, 0, 0, 0, null, tierOf(attribute))
+                } else if (attribute is TL_stars.starGiftAttributeBackdrop) {
+                    val name = attribute.name ?: continue
+                    backdrops[name] = Part(
+                        name, attribute.getRarityPermille(), null, attribute.backdrop_id,
+                        attribute.center_color, attribute.edge_color, attribute.pattern_color, attribute.text_color,
+                        null, tierOf(attribute)
+                    )
+                } else if (attribute is TL_stars.starGiftAttributePattern) {
+                    val name = attribute.name ?: continue
+                    symbols[name] = Part(name, attribute.getRarityPermille(), attribute.document, 0, 0, 0, 0, 0, null, tierOf(attribute))
+                }
+            }
+        }
+        return Parts(models.values.toList(), backdrops.values.toList(), symbols.values.toList())
+    }
+
+    /** The parts of one gift: its own model, backdrop and symbol. */
+    @JvmStatic
+    fun partsOf(gift: TL_stars.StarGift): Parts {
+        var model: Part? = null
+        var backdrop: Part? = null
+        var symbol: Part? = null
+        for (attribute in gift.attributes) {
+            if (attribute is TL_stars.starGiftAttributeModel) {
+                val name = attribute.name ?: continue
+                model = Part(name, attribute.getRarityPermille(), attribute.document, 0, 0, 0, 0, 0, null, tierOf(attribute))
+            } else if (attribute is TL_stars.starGiftAttributeBackdrop) {
+                val name = attribute.name ?: continue
+                backdrop = Part(
+                    name, attribute.getRarityPermille(), null, attribute.backdrop_id,
+                    attribute.center_color, attribute.edge_color, attribute.pattern_color, attribute.text_color,
+                    null, tierOf(attribute)
+                )
+            } else if (attribute is TL_stars.starGiftAttributePattern) {
+                val name = attribute.name ?: continue
+                symbol = Part(name, attribute.getRarityPermille(), attribute.document, 0, 0, 0, 0, 0, null, tierOf(attribute))
+            }
+        }
+        return Parts(
+            listOfNotNull(model),
+            listOfNotNull(backdrop),
+            listOfNotNull(symbol)
+        )
+    }
+
+    /**
+     * A copy of the gift with the chosen attributes, so the stock card shows what will be exported.
+     * The attributes are the sample ones of the server's preview of the gift, so they carry real
+     * documents and the card draws them the way Telegram draws a gift.
+     */
+    @JvmStatic
+    fun giftWithAttributes(
+        gift: TL_stars.StarGift,
+        model: TL_stars.starGiftAttributeModel?,
+        backdrop: TL_stars.starGiftAttributeBackdrop?,
+        symbol: TL_stars.starGiftAttributePattern?
+    ): TL_stars.StarGift {
+        val copy = TL_stars.StarGift()
+        copy.id = gift.id
+        copy.gift_id = gift.gift_id
+        copy.title = gift.title
+        copy.num = gift.num
+        copy.slug = gift.slug
+        copy.flags = gift.flags
+        copy.limited = gift.limited
+        copy.sticker = model?.document ?: gift.getDocument()
+        copy.availability_issued = gift.availability_issued
+        copy.availability_total = gift.availability_total
+        val attributes = ArrayList<TL_stars.StarGiftAttribute>()
+        model?.let { attributes.add(it) }
+        backdrop?.let { attributes.add(it) }
+        symbol?.let { attributes.add(it) }
+        copy.attributes = attributes
+        return copy
+    }
+
+    /** The name of a card: the title and the number of the gift together. */
+    @JvmStatic
+    fun cardTitle(title: String, number: String): String {
+        val parts = ArrayList<String>()
+        if (title.isNotEmpty()) parts.add(title)
+        if (number.isNotEmpty()) parts.add(number)
+        return parts.joinToString(" ")
+    }
+
+    /** The rows of the table of a card: model, symbol, backdrop and the rarity, as desktop shows them. */
+    @JvmStatic
+    fun rowsOf(
+        model: TL_stars.starGiftAttributeModel?,
+        symbol: TL_stars.starGiftAttributePattern?,
+        backdrop: TL_stars.starGiftAttributeBackdrop?
+    ): List<String> {
+        val rows = ArrayList<String>()
+        if (model != null) rows.add("Model " + model.name)
+        if (symbol != null) rows.add("Symbol " + symbol.name)
+        if (backdrop != null) rows.add("Backdrop " + backdrop.name)
+        val odds = rarityOdds(model?.getRarityPermille() ?: 0, backdrop?.getRarityPermille() ?: 0)
+        if (odds.isNotEmpty()) rows.add("Rarity " + odds)
+        return rows
+    }
+
+    /** The document of a part: the chosen one, else the one of the gift keeps the card drawing. */
+    @JvmStatic
+    fun backdropDocument(part: Part?, gift: TL_stars.StarGift): TLRPC.Document? {
+        part?.document?.let { return it }
+        return gift.getDocument()
+    }
+
+    /** The rarity of a part as the server sends it: the permille, or the tier of the catalog. */
+    @JvmStatic
+    fun rarityOf(part: Part): TL_stars.StarGiftAttributeRarity? {
+        if (part.tier != Tier.DEFAULT) {
+            return when (part.tier) {
+                Tier.UNCOMMON -> TL_stars.TL_starGiftAttributeRarityUncommon()
+                Tier.RARE -> TL_stars.TL_starGiftAttributeRarityRare()
+                Tier.EPIC -> TL_stars.TL_starGiftAttributeRarityEpic()
+                Tier.LEGENDARY -> TL_stars.TL_starGiftAttributeRarityLegendary()
+                else -> null
+            }
+        }
+        if (part.permille <= 0) return null
+        val rarity = TL_stars.TL_starGiftAttributeRarity()
+        rarity.permille = part.permille
+        return rarity
+    }
+}
diff --git a/TMessagesProj/src/main/java/tele/helpers/GiftStudioCatalog.kt b/TMessagesProj/src/main/java/tele/helpers/GiftStudioCatalog.kt
new file mode 100644
index 000000000..2ef45bc1b
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/GiftStudioCatalog.kt
@@ -0,0 +1,297 @@
+package tele.helpers
+
+import android.graphics.Bitmap
+import android.graphics.BitmapFactory
+import android.os.Handler
+import android.os.Looper
+import org.json.JSONObject
+import org.telegram.messenger.ApplicationLoader
+import org.telegram.messenger.FileLog
+import java.io.File
+import java.net.HttpURLConnection
+import java.net.URL
+
+/**
+ * The catalog of the gift studio (desktop 0197): gifts, their models, backdrops and symbols come
+ * from api.changes.tg, which is free and needs no account. Every asset is kept on the device, so a
+ * preview is drawn once and then read from the disk.
+ *
+ * The service asks for a visible credit: the studio shows "@GiftChanges" under its rows.
+ */
+object GiftStudioCatalog {
+
+    /** The channel the service asks to be named. */
+    const val CREDIT = "@GiftChanges"
+    const val CREDIT_URL = "https://t.me/GiftChanges"
+
+    private const val HOST = "https://api.changes.tg/"
+    private const val TIMEOUT = 20_000
+    private const val MAX_SIZE = 8 * 1024 * 1024
+
+    /** One model or symbol of a gift. */
+    class Part(@JvmField val name: String, @JvmField val permille: Int)
+
+    /** One backdrop of a gift: its name, its rarity and its four colors. */
+    class Backdrop(
+        @JvmField val name: String,
+        @JvmField val permille: Int,
+        @JvmField val center: Int,
+        @JvmField val edge: Int,
+        @JvmField val pattern: Int,
+        @JvmField val text: Int
+    )
+
+    /** One gift of the catalog with everything the studio draws. */
+    class Gift(
+        @JvmField val name: String,
+        @JvmField val id: Long,
+        @JvmField val models: List<Part>,
+        @JvmField val backdrops: List<Backdrop>,
+        @JvmField val symbols: List<Part>
+    )
+
+    /** The names of the gifts of the catalog, the most known first. */
+    @JvmStatic
+    fun requestGiftNames(done: (List<String>) -> Unit) {
+        fetchCached("gifts") { bytes ->
+            val result = ArrayList<String>()
+            runCatching {
+                val array = org.json.JSONArray(String(bytes, Charsets.UTF_8))
+                for (i in 0 until array.length()) {
+                    val name = array.optString(i)
+                    if (name.isNotEmpty()) result.add(name)
+                }
+            }.onFailure { FileLog.e(it) }
+            done(result)
+        }
+    }
+
+    /** The ids of the gifts of the catalog: the gift id to its name. */
+    @JvmStatic
+    fun requestIds(done: (Map<Long, String>) -> Unit) {
+        fetchCached("ids") { bytes ->
+            val result = LinkedHashMap<Long, String>()
+            runCatching {
+                val json = JSONObject(String(bytes, Charsets.UTF_8))
+                val keys = json.keys()
+                val names = ArrayList<Pair<Long, String>>()
+                while (keys.hasNext()) {
+                    val key = keys.next()
+                    val id = key.toLongOrNull() ?: continue
+                    val name = json.optString(key)
+                    if (id != 0L && name.isNotEmpty()) names.add(id to name)
+                }
+                // a stable order: the map of json has none
+                names.sortedBy { it.second.lowercase() }.forEach { result[it.first] = it.second }
+            }.onFailure { FileLog.e(it) }
+            done(result)
+        }
+    }
+
+    /** One gift with its parts; the parts keep their order of the catalog, the rarest last. */
+    @JvmStatic
+    fun requestGift(name: String, done: (Gift?) -> Unit) {
+        val segment = encode(name)
+        var models: List<Part> = emptyList()
+        var backdrops: List<Backdrop> = emptyList()
+        var symbols: List<Part> = emptyList()
+        var id = 0L
+        var left = 4
+        val check = {
+            left--
+            if (left == 0) {
+                done(
+                    if (models.isEmpty() && backdrops.isEmpty() && symbols.isEmpty()) null
+                    else Gift(name, id, models, backdrops, symbols)
+                )
+            }
+        }
+        fetchCached("gift/$segment") { bytes ->
+            runCatching {
+                val json = JSONObject(String(bytes, Charsets.UTF_8))
+                val gift = json.optJSONObject("gift")
+                if (gift != null) id = gift.optString("id").toLongOrNull() ?: gift.optLong("id")
+            }.onFailure { FileLog.e(it) }
+            check()
+        }
+        fetchCached("models/$segment?sorted") { bytes ->
+            models = parts(bytes)
+            check()
+        }
+        fetchCached("backdrops/$segment?sorted") { bytes ->
+            backdrops = backdrops(bytes)
+            check()
+        }
+        fetchCached("symbols/$segment?sorted") { bytes ->
+            symbols = parts(bytes)
+            check()
+        }
+    }
+
+    private fun parts(bytes: ByteArray): List<Part> {
+        val result = ArrayList<Part>()
+        runCatching {
+            val array = org.json.JSONArray(String(bytes, Charsets.UTF_8))
+            for (i in 0 until array.length()) {
+                val item = array.optJSONObject(i) ?: continue
+                val name = item.optString("name")
+                if (name.isNotEmpty()) result.add(Part(name, item.optInt("rarityPermille")))
+            }
+        }.onFailure { FileLog.e(it) }
+        return result
+    }
+
+    private fun backdrops(bytes: ByteArray): List<Backdrop> {
+        val result = ArrayList<Backdrop>()
+        runCatching {
+            val array = org.json.JSONArray(String(bytes, Charsets.UTF_8))
+            for (i in 0 until array.length()) {
+                val item = array.optJSONObject(i) ?: continue
+                val name = item.optString("name")
+                if (name.isEmpty()) continue
+                result.add(
+                    Backdrop(
+                        name,
+                        item.optInt("rarityPermille"),
+                        item.optInt("centerColor") or 0xFF000000.toInt(),
+                        item.optInt("edgeColor") or 0xFF000000.toInt(),
+                        item.optInt("patternColor") or 0xFF000000.toInt(),
+                        item.optInt("textColor") or 0xFF000000.toInt()
+                    )
+                )
+            }
+        }.onFailure { FileLog.e(it) }
+        return result
+    }
+
+    /** The .tgs of a model, kept on the device after the first download. */
+    @JvmStatic
+    fun modelTgs(gift: String, model: String, done: (ByteArray) -> Unit) {
+        asset("model", gift, model, ".tgs", done)
+    }
+
+    /** The .tgs of a symbol, kept on the device after the first download. */
+    @JvmStatic
+    fun symbolTgs(gift: String, symbol: String, done: (ByteArray) -> Unit) {
+        asset("symbol", gift, symbol, ".tgs", done)
+    }
+
+    /** The picture of a symbol, used as the pattern of the card. */
+    @JvmStatic
+    fun symbolPng(gift: String, symbol: String, size: Int, done: (Bitmap?) -> Unit) {
+        png("symbol", gift, symbol, size, done)
+    }
+
+    /** The picture of a model. */
+    @JvmStatic
+    fun modelPng(gift: String, model: String, size: Int, done: (Bitmap?) -> Unit) {
+        png("model", gift, model, size, done)
+    }
+
+    /** The picture of the gift itself, as the catalog shows it. */
+    @JvmStatic
+    fun giftPng(gift: String, size: Int, done: (Bitmap?) -> Unit) {
+        png("original", gift, null, size, done)
+    }
+
+    private fun png(kind: String, gift: String, name: String?, size: Int, done: (Bitmap?) -> Unit) {
+        val ext = ".png?size=$size"
+        asset(kind, gift, name ?: "", ext) { bytes ->
+            if (bytes.isEmpty()) {
+                done(null)
+                return@asset
+            }
+            done(runCatching { BitmapFactory.decodeByteArray(bytes, 0, bytes.size) }.getOrNull())
+        }
+    }
+
+    private fun cacheDir(): File = File(ApplicationLoader.getFilesDirFixed(), "tele_gift_studio")
+
+    /**
+     * A path of the catalog whose answer is kept on the device: the parts of a gift do not change,
+     * so a failed request falls back to the last answer instead of an empty studio.
+     */
+    private fun fetchCached(path: String, done: (ByteArray) -> Unit) {
+        val file = File(cacheDir(), "meta_" + path.hashCode().toUInt().toString(16) + ".json")
+        val cached = if (file.exists() && file.length() > 0) {
+            runCatching { file.readBytes() }.getOrNull()
+        } else null
+        fetch(path) { bytes ->
+            if (bytes.isNotEmpty()) {
+                runCatching {
+                    cacheDir().mkdirs()
+                    file.writeBytes(bytes)
+                }.onFailure { FileLog.e(it) }
+                done(bytes)
+            } else {
+                done(cached ?: ByteArray(0))
+            }
+        }
+    }
+
+    private fun assetFile(kind: String, gift: String, name: String, ext: String): File {
+        val hash = (gift + "/" + name + ext).hashCode().toUInt().toString(16)
+        return File(cacheDir(), kind + "_" + hash + ext.substringBefore('?'))
+    }
+
+    /** A file of the catalog: the disk first, then the network. */
+    private fun asset(kind: String, gift: String, name: String, ext: String, done: (ByteArray) -> Unit) {
+        val file = assetFile(kind, gift, name, ext)
+        if (file.exists() && file.length() > 0) {
+            done(runCatching { file.readBytes() }.getOrDefault(ByteArray(0)))
+            return
+        }
+        val path = if (name.isEmpty()) kind + "/" + encode(gift) + ext else kind + "/" + encode(gift) + "/" + encode(name) + ext
+        fetch(path) { bytes ->
+            if (bytes.isNotEmpty()) {
+                runCatching {
+                    cacheDir().mkdirs()
+                    file.writeBytes(bytes)
+                }.onFailure { FileLog.e(it) }
+            }
+            done(bytes)
+        }
+    }
+
+    private fun encode(value: String): String =
+        java.net.URLEncoder.encode(value, "UTF-8").replace("+", "%20")
+
+    /** A public path of the catalog; the answer comes back on the main thread. */
+    private fun fetch(path: String, done: (ByteArray) -> Unit) {
+        val handler = Handler(Looper.getMainLooper())
+        Thread {
+            var bytes = ByteArray(0)
+            var connection: HttpURLConnection? = null
+            try {
+                connection = (URL(HOST + path).openConnection() as HttpURLConnection).apply {
+                    connectTimeout = TIMEOUT
+                    readTimeout = TIMEOUT
+                    instanceFollowRedirects = true
+                    requestMethod = "GET"
+                    setRequestProperty("User-Agent", "tele-android")
+                }
+                if (connection.responseCode == 200) {
+                    // a chunked answer has no content length, so the limit is checked while reading
+                    connection.inputStream.use { input ->
+                        val buffer = java.io.ByteArrayOutputStream(16 * 1024)
+                        val chunk = ByteArray(16 * 1024)
+                        while (true) {
+                            val read = input.read(chunk)
+                            if (read < 0) break
+                            buffer.write(chunk, 0, read)
+                            if (buffer.size() > MAX_SIZE) return@use
+                        }
+                        bytes = buffer.toByteArray()
+                    }
+                } else {
+                    FileLog.d("tele gift studio catalog: " + path + " status " + connection.responseCode)
+                }
+            } catch (throwable: Throwable) {
+                FileLog.e("tele gift studio catalog: " + path + " " + throwable.message)
+            } finally {
+                connection?.disconnect()
+            }
+            handler.post { done(bytes) }
+        }.start()
+    }
+}
diff --git a/TMessagesProj/src/main/java/tele/helpers/GiftStudioExport.kt b/TMessagesProj/src/main/java/tele/helpers/GiftStudioExport.kt
