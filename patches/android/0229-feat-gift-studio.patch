diff --git a/TMessagesProj/src/main/java/tele/helpers/GiftStudio.kt b/TMessagesProj/src/main/java/tele/helpers/GiftStudio.kt
new file mode 100644
index 000000000..931c4a010
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/GiftStudio.kt
@@ -0,0 +1,194 @@
+package tele.helpers
+
+import org.telegram.tgnet.TLRPC
+import org.telegram.tgnet.tl.TL_stars
+import java.util.Locale
+
+/**
+ * The parts a gift is built of in the gift studio (desktop 0197): the model, the backdrop and the
+ * symbol. The parts come from the gifts of the account, so no third party is asked for them.
+ */
+object GiftStudio {
+
+    /** One value of a part: a model, a backdrop or a symbol. */
+    class Part(
+        @JvmField val name: String,
+        @JvmField val permille: Int,
+        @JvmField val document: TLRPC.Document?,
+        @JvmField val backdropId: Int,
+        @JvmField val centerColor: Int,
+        @JvmField val edgeColor: Int,
+        @JvmField val patternColor: Int,
+        @JvmField val textColor: Int
+    )
+
+    /** The parts of a gift. */
+    class Parts(
+        @JvmField val models: List<Part>,
+        @JvmField val backdrops: List<Part>,
+        @JvmField val symbols: List<Part>
+    )
+
+    /** The rarity of a part in percent; empty when the part has no rarity. */
+    @JvmStatic
+    fun rarityText(permille: Int): String {
+        if (permille <= 0) return ""
+        if (permille < 10) return "<0.1%"
+        return String.format(Locale.US, "%.1f%%", permille / 10.0)
+    }
+
+    /** How rare the model and the backdrop together are. */
+    @JvmStatic
+    fun rarityOdds(modelPermille: Int, backdropPermille: Int): String {
+        if (modelPermille <= 0 || backdropPermille <= 0) return ""
+        val odds = 1000000.0 / (modelPermille.toDouble() * backdropPermille)
+        return "1 in " + String.format(Locale.US, "%,d", odds.toLong())
+    }
+
+    /** The chance of the model and the backdrop together, in percent. */
+    @JvmStatic
+    fun rarityChance(modelPermille: Int, backdropPermille: Int): String {
+        if (modelPermille <= 0 || backdropPermille <= 0) return ""
+        val percent = modelPermille * backdropPermille / 10000.0
+        var text = if (percent >= 1.0) {
+            String.format(Locale.US, "%.2f%%", percent)
+        } else {
+            String.format(Locale.US, "%.3f%%", percent)
+        }
+        while (text.endsWith("0")) text = text.dropLast(1)
+        if (text.endsWith(".")) text = text.dropLast(1)
+        return text
+    }
+
+    /** The parts of the gifts: every model, backdrop and symbol among them. */
+    @JvmStatic
+    fun collectParts(gifts: List<TL_stars.StarGift>): Parts {
+        val models = LinkedHashMap<String, Part>()
+        val backdrops = LinkedHashMap<String, Part>()
+        val symbols = LinkedHashMap<String, Part>()
+        for (gift in gifts) {
+            for (attribute in gift.attributes) {
+                if (attribute is TL_stars.starGiftAttributeModel) {
+                    val name = attribute.name ?: continue
+                    models[name] = Part(name, attribute.getRarityPermille(), attribute.document, 0, 0, 0, 0, 0)
+                } else if (attribute is TL_stars.starGiftAttributeBackdrop) {
+                    val name = attribute.name ?: continue
+                    backdrops[name] = Part(
+                        name, attribute.getRarityPermille(), null, attribute.backdrop_id,
+                        attribute.center_color, attribute.edge_color, attribute.pattern_color, attribute.text_color
+                    )
+                } else if (attribute is TL_stars.starGiftAttributePattern) {
+                    val name = attribute.name ?: continue
+                    symbols[name] = Part(name, attribute.getRarityPermille(), attribute.document, 0, 0, 0, 0, 0)
+                }
+            }
+        }
+        return Parts(models.values.toList(), backdrops.values.toList(), symbols.values.toList())
+    }
+
+    /** The parts of one gift: its own model, backdrop and symbol. */
+    @JvmStatic
+    fun partsOf(gift: TL_stars.StarGift): Parts {
+        var model: Part? = null
+        var backdrop: Part? = null
+        var symbol: Part? = null
+        for (attribute in gift.attributes) {
+            if (attribute is TL_stars.starGiftAttributeModel) {
+                val name = attribute.name ?: continue
+                model = Part(name, attribute.getRarityPermille(), attribute.document, 0, 0, 0, 0, 0)
+            } else if (attribute is TL_stars.starGiftAttributeBackdrop) {
+                val name = attribute.name ?: continue
+                backdrop = Part(
+                    name, attribute.getRarityPermille(), null, attribute.backdrop_id,
+                    attribute.center_color, attribute.edge_color, attribute.pattern_color, attribute.text_color
+                )
+            } else if (attribute is TL_stars.starGiftAttributePattern) {
+                val name = attribute.name ?: continue
+                symbol = Part(name, attribute.getRarityPermille(), attribute.document, 0, 0, 0, 0, 0)
+            }
+        }
+        return Parts(
+            listOfNotNull(model),
+            listOfNotNull(backdrop),
+            listOfNotNull(symbol)
+        )
+    }
+
+    /**
+     * A copy of the gift with the chosen parts, so the stock card shows what will be exported.
+     * The copy is only for the picture: the original gift is never touched.
+     */
+    @JvmStatic
+    fun giftWithParts(
+        gift: TL_stars.StarGift,
+        model: Part?,
+        backdrop: Part?,
+        symbol: Part?
+    ): TL_stars.StarGift {
+        val copy = TL_stars.StarGift()
+        copy.id = gift.id
+        copy.gift_id = gift.gift_id
+        copy.title = gift.title
+        copy.num = gift.num
+        copy.slug = gift.slug
+        copy.limited = gift.limited
+        copy.flags = gift.flags
+        copy.availability_issued = gift.availability_issued
+        copy.availability_total = gift.availability_total
+        copy.sticker = model?.document ?: gift.getDocument()
+        val attributes = ArrayList<TL_stars.StarGiftAttribute>()
+        for (attribute in gift.attributes) {
+            when (attribute) {
+                is TL_stars.starGiftAttributeModel -> if (model == null) attributes.add(attribute)
+                is TL_stars.starGiftAttributeBackdrop -> if (backdrop == null) attributes.add(attribute)
+                is TL_stars.starGiftAttributePattern -> if (symbol == null) attributes.add(attribute)
+                else -> attributes.add(attribute)
+            }
+        }
+        if (model != null) {
+            val attribute = TL_stars.starGiftAttributeModel()
+            attribute.name = model.name
+            attribute.document = model.document
+            attribute.rarity = rarityOf(model)
+            attributes.add(attribute)
+        }
+        if (backdrop != null) {
+            val attribute = TL_stars.starGiftAttributeBackdrop()
+            attribute.name = backdrop.name
+            attribute.backdrop_id = backdrop.backdropId
+            attribute.center_color = backdrop.centerColor
+            attribute.edge_color = backdrop.edgeColor
+            attribute.pattern_color = backdrop.patternColor
+            attribute.text_color = backdrop.textColor
+            attribute.rarity = rarityOf(backdrop)
+            attributes.add(attribute)
+        }
+        if (symbol != null) {
+            val attribute = TL_stars.starGiftAttributePattern()
+            attribute.name = symbol.name
+            attribute.document = symbol.document
+            attribute.rarity = rarityOf(symbol)
+            attributes.add(attribute)
+        }
+        copy.attributes = attributes
+        return copy
+    }
+
+    /** The rarity of a part as the server sends it: the permille, or the tier of the catalog. */
+    @JvmStatic
+    fun rarityOf(part: Part): TL_stars.StarGiftAttributeRarity? {
+        if (part.tier != Tier.DEFAULT) {
+            return when (part.tier) {
+                Tier.UNCOMMON -> TL_stars.TL_starGiftAttributeRarityUncommon()
+                Tier.RARE -> TL_stars.TL_starGiftAttributeRarityRare()
+                Tier.EPIC -> TL_stars.TL_starGiftAttributeRarityEpic()
+                Tier.LEGENDARY -> TL_stars.TL_starGiftAttributeRarityLegendary()
+                else -> null
+            }
+        }
+        if (part.permille <= 0) return null
+        val rarity = TL_stars.TL_starGiftAttributeRarity()
+        rarity.permille = part.permille
+        return rarity
+    }
+}
diff --git a/TMessagesProj/src/main/java/tele/helpers/GiftStudioCatalog.kt b/TMessagesProj/src/main/java/tele/helpers/GiftStudioCatalog.kt
new file mode 100644
index 000000000..af65099f7
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/GiftStudioCatalog.kt
@@ -0,0 +1,161 @@
+package tele.helpers
+
+import android.os.Handler
+import android.os.Looper
+import org.telegram.messenger.FileLog
+import tele.TeleConfig
+import java.net.HttpURLConnection
+import java.net.URL
+
+/**
+ * The catalog of the gift studio (desktop 0197): the parts of the gifts of a third party. The
+ * request is only made when the setting is on, and it never carries anything of the account.
+ */
+object GiftStudioCatalog {
+
+    private const val HOST = "https://api.changes.tg/"
+    private const val TIMEOUT = 20_000
+    private const val MAX_SIZE = 4 * 1024 * 1024
+
+    /** The parts of a gift of the catalog. */
+    class CatalogParts(
+        @JvmField val models: List<CatalogItem>,
+        @JvmField val backdrops: List<CatalogItem>,
+        @JvmField val symbols: List<CatalogItem>
+    )
+
+    /** One part of the catalog. */
+    class CatalogItem(
+        @JvmField val name: String,
+        @JvmField val permille: Int,
+        @JvmField val tier: String,
+        @JvmField val centerColor: Int,
+        @JvmField val edgeColor: Int,
+        @JvmField val patternColor: Int,
+        @JvmField val textColor: Int
+    )
+
+    /** The name of the gift collection of the catalog. */
+    class CatalogGift(
+        @JvmField val slug: String,
+        @JvmField val title: String
+    )
+
+    /** The setting is off: the studio never asks the third party. */
+    @JvmStatic
+    fun enabled(): Boolean = TeleConfig.GIFT_STUDIO_EXTERNAL_CATALOG.value
+
+    /** The gifts of the catalog; empty when the setting is off or the request failed. */
+    @JvmStatic
+    fun requestGifts(done: (List<CatalogGift>) -> Unit) {
+        if (!enabled()) {
+            done(emptyList())
+            return
+        }
+        fetch("gifts") { bytes ->
+            val result = ArrayList<CatalogGift>()
+            for (item in parseArray(bytes)) {
+                val slug = item.optString("slug")
+                if (slug.isEmpty()) continue
+                result.add(CatalogGift(slug, item.optString("title", slug)))
+            }
+            done(result)
+        }
+    }
+
+    /** The parts of one gift of the catalog. */
+    @JvmStatic
+    fun requestParts(slug: String, done: (CatalogParts) -> Unit) {
+        if (!enabled()) {
+            done(CatalogParts(emptyList(), emptyList(), emptyList()))
+            return
+        }
+        val models = ArrayList<CatalogItem>()
+        val backdrops = ArrayList<CatalogItem>()
+        val symbols = ArrayList<CatalogItem>()
+        var left = 3
+        val check = {
+            left--
+            if (left == 0) {
+                done(CatalogParts(models, backdrops, symbols))
+            }
+        }
+        fetch("models/$slug?sorted") { bytes ->
+            for (item in parseArray(bytes)) {
+                models.add(CatalogItem(
+                    item.optString("name"), item.optInt("rarityPermille"),
+                    item.optString("rarityTier"), 0, 0, 0, 0
+                ))
+            }
+            check()
+        }
+        fetch("backdrops/$slug?sorted") { bytes ->
+            for (item in parseArray(bytes)) {
+                backdrops.add(CatalogItem(
+                    item.optString("name"), item.optInt("rarityPermille"),
+                    item.optString("rarityTier"),
+                    item.optInt("centerColor"), item.optInt("edgeColor"),
+                    item.optInt("patternColor"), item.optInt("textColor")
+                ))
+            }
+            check()
+        }
+        fetch("symbols/$slug?sorted") { bytes ->
+            for (item in parseArray(bytes)) {
+                symbols.add(CatalogItem(
+                    item.optString("name"), item.optInt("rarityPermille"),
+                    item.optString("rarityTier"), 0, 0, 0, 0
+                ))
+            }
+            check()
+        }
+    }
+
+    private fun parseArray(bytes: ByteArray): List<org.json.JSONObject> {
+        val result = ArrayList<org.json.JSONObject>()
+        try {
+            val array = org.json.JSONArray(String(bytes, Charsets.UTF_8))
+            for (index in 0 until array.length()) {
+                val item = array.optJSONObject(index) ?: continue
+                result.add(item)
+            }
+        } catch (throwable: Throwable) {
+            FileLog.e("tele gift studio catalog: " + throwable.message)
+        }
+        return result
+    }
+
+    /** The bytes of a path of the catalog; the request is made off the main thread. */
+    private fun fetch(path: String, done: (ByteArray) -> Unit) {
+        if (!enabled()) {
+            done(ByteArray(0))
+            return
+        }
+        val handler = Handler(Looper.getMainLooper())
+        Thread {
+            var bytes = ByteArray(0)
+            var connection: HttpURLConnection? = null
+            try {
+                connection = (URL(HOST + path).openConnection() as HttpURLConnection).apply {
+                    connectTimeout = TIMEOUT
+                    readTimeout = TIMEOUT
+                    instanceFollowRedirects = true
+                    requestMethod = "GET"
+                }
+                if (connection.responseCode != 200) {
+                    FileLog.d("tele gift studio catalog: " + path + " status " + connection.responseCode)
+                } else {
+                    val length = connection.contentLength
+                    if (length in 0..MAX_SIZE) {
+                        bytes = connection.inputStream.use { it.readBytes() }
+                    }
+                }
+            } catch (throwable: Throwable) {
+                FileLog.e("tele gift studio catalog: " + throwable.message)
+            } finally {
+                connection?.disconnect()
+            }
+            handler.post { done(bytes) }
+        }.start()
+    }
+}
diff --git a/TMessagesProj/src/main/java/tele/helpers/GiftStudioExport.kt b/TMessagesProj/src/main/java/tele/helpers/GiftStudioExport.kt
new file mode 100644
index 000000000..4b7f0394f
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/GiftStudioExport.kt
@@ -0,0 +1,264 @@
+package tele.helpers
+
+import android.content.ContentValues
+import android.content.Context
+import android.content.Intent
+import android.graphics.Bitmap
+import android.media.MediaCodec
+import android.media.MediaCodecInfo
+import android.media.MediaFormat
+import android.media.MediaMuxer
+import android.net.Uri
+import android.os.Environment
+import android.provider.MediaStore
+import androidx.core.content.FileProvider
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.ApplicationLoader
+import org.telegram.messenger.FileLog
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.R
+import java.io.File
+import java.io.FileOutputStream
+import java.nio.ByteBuffer
+
+/**
+ * The export of the gift studio (desktop 0197): the picture of the gift is saved as a PNG or
+ * encoded as a video. The name of the file has no username and no id of the owner in it.
+ */
+object GiftStudioExport {
+
+    /** The formats the studio can write. */
+    enum class Format(val mime: String, val extension: String) {
+        PNG("image/png", "png"),
+        MP4("video/mp4", "mp4")
+    }
+
+    private const val VIDEO_FPS = 30
+    private const val VIDEO_FRAMES = 90
+
+    /** The name of the file of the gift: the parts of it and the number, nothing private. */
+    @JvmStatic
+    fun fileName(title: String?, number: String?, format: Format): String {
+        val safeTitle = sanitize(title)
+        val safeNumber = sanitize(number)
+        val base = when {
+            safeTitle.isEmpty() && safeNumber.isEmpty() -> "gift"
+            safeNumber.isEmpty() -> safeTitle
+            safeTitle.isEmpty() -> safeNumber
+            else -> "$safeTitle $safeNumber"
+        }
+        return "$base.${format.extension}"
+    }
+
+    private fun sanitize(value: String?): String {
+        if (value.isNullOrEmpty()) return ""
+        val builder = StringBuilder()
+        for (character in value) {
+            if (character.isLetterOrDigit() || character == ' ' || character == '-' || character == '_') {
+                builder.append(character)
+            }
+            if (builder.length >= 48) break
+        }
+        return builder.toString().trim()
+    }
+
+    /** The picture of the gift as a PNG in the pictures of the device. */
+    @JvmStatic
+    fun savePng(bitmap: Bitmap, name: String): Uri? {
+        val values = ContentValues()
+        values.put(MediaStore.MediaColumns.DISPLAY_NAME, name)
+        values.put(MediaStore.MediaColumns.MIME_TYPE, "image/png")
+        values.put(
+            MediaStore.MediaColumns.RELATIVE_PATH,
+            Environment.DIRECTORY_PICTURES + File.separator + "tele" + File.separator
+        )
+        val uri = ApplicationLoader.applicationContext.contentResolver
+            .insert(MediaStore.Images.Media.getContentUri(MediaStore.VOLUME_EXTERNAL_PRIMARY), values)
+            ?: return null
+        val output = ApplicationLoader.applicationContext.contentResolver.openOutputStream(uri)
+            ?: return null
+        output.use {
+            if (!bitmap.compress(Bitmap.CompressFormat.PNG, 100, it)) {
+                throw IllegalStateException("the picture could not be written")
+            }
+        }
+        return uri
+    }
+
+    /** The frames of the gift as a video in the movies of the device. */
+    @JvmStatic
+    fun saveVideo(name: String, frames: List<Bitmap>): Uri? {
+        val file = File(ApplicationLoader.getFilesDirFixed("cache/tele-gift-studio"), name)
+        file.parentFile?.mkdirs()
+        if (!encodeVideo(file, frames)) return null
+        val values = ContentValues()
+        values.put(MediaStore.MediaColumns.DISPLAY_NAME, name)
+        values.put(MediaStore.MediaColumns.MIME_TYPE, "video/mp4")
+        values.put(
+            MediaStore.MediaColumns.RELATIVE_PATH,
+            Environment.DIRECTORY_MOVIES + File.separator + "tele" + File.separator
+        )
+        val uri = ApplicationLoader.applicationContext.contentResolver
+            .insert(MediaStore.Video.Media.getContentUri(MediaStore.VOLUME_EXTERNAL_PRIMARY), values)
+            ?: return null
+        val output = ApplicationLoader.applicationContext.contentResolver.openOutputStream(uri)
+            ?: return null
+        output.use {
+            file.inputStream().use { input -> AndroidUtilities.copyFile(input, it) }
+        }
+        file.delete()
+        return uri
+    }
+
+    /** The frames as a video file; false when the device has no encoder. */
+    private fun encodeVideo(file: File, frames: List<Bitmap>): Boolean {
+        if (frames.isEmpty()) return false
+        val width = frames[0].width
+        val height = frames[0].height
+        if (width % 2 != 0 || height % 2 != 0) return false
+        var codec: MediaCodec? = null
+        var muxer: MediaMuxer? = null
+        var track = -1
+        var started = false
+        try {
+            val format = MediaFormat.createVideoFormat("video/avc", width, height)
+            format.setInteger(
+                MediaFormat.KEY_COLOR_FORMAT,
+                MediaCodecInfo.CodecCapabilities.COLOR_FORMAT_YUV420Flexible
+            )
+            format.setInteger(MediaFormat.KEY_BIT_RATE, width * height * 4)
+            format.setInteger(MediaFormat.KEY_FRAME_RATE, VIDEO_FPS)
+            format.setInteger(MediaFormat.KEY_I_FRAME_INTERVAL, 1)
+            codec = MediaCodec.createEncoderByType("video/avc")
+            codec.configure(format, null, null, MediaCodec.CONFIGURE_FLAG_ENCODE)
+            codec.start()
+            muxer = MediaMuxer(file.absolutePath, MediaMuxer.OutputFormat.MUXER_OUTPUT_MPEG_4)
+            val info = MediaCodec.BufferInfo()
+            var presentation = 0L
+            var sent = 0
+            var done = false
+            while (!done) {
+                if (sent < frames.size) {
+                    val input = codec.dequeueInputBuffer(10000)
+                    if (input >= 0) {
+                        val buffer = codec.getInputBuffer(input)
+                        if (buffer != null) {
+                            buffer.clear()
+                            buffer.put(toYuv420(frames[sent], width, height))
+                            codec.queueInputBuffer(input, 0, width * height * 3 / 2, presentation, 0)
+                        }
+                        presentation += 1_000_000L / VIDEO_FPS
+                        sent++
+                    }
+                } else {
+                    val input = codec.dequeueInputBuffer(10000)
+                    if (input >= 0) {
+                        codec.queueInputBuffer(
+                            input, 0, 0, presentation,
+                            MediaCodec.BUFFER_FLAG_END_OF_STREAM
+                        )
+                    }
+                }
+                while (true) {
+                    val output = codec.dequeueOutputBuffer(info, 10000)
+                    if (output == MediaCodec.INFO_OUTPUT_FORMAT_CHANGED) {
+                        track = muxer.addTrack(codec.outputFormat)
+                        muxer.start()
+                        started = true
+                        continue
+                    }
+                    if (output < 0) break
+                    val buffer = codec.getOutputBuffer(output)
+                    if (buffer != null && info.size > 0 && started) {
+                        buffer.position(info.offset)
+                        buffer.limit(info.offset + info.size)
+                        muxer.writeSampleData(track, buffer, info)
+                    }
+                    codec.releaseOutputBuffer(output, false)
+                    if (info.flags and MediaCodec.BUFFER_FLAG_END_OF_STREAM != 0) {
+                        done = true
+                        break
+                    }
+                }
+            }
+        } catch (throwable: Throwable) {
+            FileLog.e("tele gift studio video: " + throwable.message)
+            return false
+        } finally {
+            try {
+                codec?.stop()
+            } catch (ignore: Throwable) {
+            }
+            codec?.release()
+            if (started) {
+                try {
+                    muxer?.stop()
+                } catch (ignore: Throwable) {
+                }
+            }
+            muxer?.release()
+        }
+        return file.length() > 0
+    }
+
+    /** The pixels of the picture as the yuv420 the encoder of the device takes. */
+    private fun toYuv420(bitmap: Bitmap, width: Int, height: Int): ByteArray {
+        val pixels = IntArray(width * height)
+        bitmap.getPixels(pixels, 0, width, 0, 0, width, height)
+        val result = ByteArray(width * height * 3 / 2)
+        var yIndex = 0
+        var uIndex = width * height
+        var vIndex = uIndex + width * height / 4
+        for (row in 0 until height) {
+            for (column in 0 until width) {
+                val color = pixels[row * width + column]
+                val red = (color shr 16) and 0xFF
+                val green = (color shr 8) and 0xFF
+                val blue = color and 0xFF
+                val y = ((66 * red + 129 * green + 25 * blue + 128) shr 8) + 16
+                val u = ((-38 * red - 74 * green + 112 * blue + 128) shr 8) + 128
+                val v = ((112 * red - 94 * green - 18 * blue + 128) shr 8) + 128
+                result[yIndex++] = y.coerceIn(0, 255).toByte()
+                if (row % 2 == 0 && column % 2 == 0) {
+                    result[uIndex++] = u.coerceIn(0, 255).toByte()
+                    result[vIndex++] = v.coerceIn(0, 255).toByte()
+                }
+            }
+        }
+        return result
+    }
+
+    /** The uri of a file to share. */
+    @JvmStatic
+    fun shareUri(context: Context, file: File): Uri {
+        return FileProvider.getUriForFile(
+            context,
+            ApplicationLoader.getApplicationId() + ".provider",
+            file
+        )
+    }
+
+    /** The intent that shares a file. */
+    @JvmStatic
+    fun shareIntent(uri: Uri, mime: String): Intent {
+        return Intent(Intent.ACTION_SEND)
+            .setType(mime)
+            .putExtra(Intent.EXTRA_STREAM, uri)
+            .addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
+    }
+
+    @JvmStatic
+    fun savedText(): String = LocaleController.getString(R.string.TeleGiftStudioSaved)
+
+    /** The bytes of a bitmap, as a png. */
+    @JvmStatic
+    fun pngBytes(bitmap: Bitmap): ByteArray {
+        val stream = java.io.ByteArrayOutputStream()
+        bitmap.compress(Bitmap.CompressFormat.PNG, 100, stream)
+        return stream.toByteArray()
+    }
+
+    /** How many frames a video of the studio has. */
+    @JvmStatic
+    fun videoFrames(): Int = VIDEO_FRAMES
+}
