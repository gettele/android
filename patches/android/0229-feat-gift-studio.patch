+        private const val SYMBOL = 24f
+        private const val COVER_WIDTH = 440f
+        private const val SUBTITLE_TOP = 170f
+        private const val SUBTITLE_FONT = 15f
+        private const val COVER_BOTTOM = 20f
+        private const val COVER_HEIGHT = SUBTITLE_TOP + SUBTITLE_FONT + COVER_BOTTOM
