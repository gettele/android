+
+    /** The kinds of the saved gift: the picture in three sizes and, when it is on, the animation. */
+    private fun chooseSave() {
+        val kinds = ArrayList<String>()
+        kinds.add("PNG · 1080")
+        kinds.add("PNG · 2160")
+        kinds.add("PNG · 4320")
+        kinds.add("MP4 · 30 fps")
