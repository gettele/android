+package tele.helpers
+
+import org.telegram.messenger.R
+import org.telegram.tgnet.tl.TL_stars
+import org.telegram.ui.ActionBar.BaseFragment
+import org.telegram.ui.Components.ItemOptions
+import tele.TeleConfig
+import tele.ui.TeleGiftStudioActivity
+
+/**
+ * The entry of the gift studio in the menu of a gift (desktop 0197). The row is only there when
+ * the setting is on, so the stock menu stays the same without it.
+ */
+object GiftStudioMenu {
+
+    /** The id of the row of the menu of the studio. */
+    const val ID_OPEN = 9690
+
+    @JvmStatic
+    fun enabled(): Boolean = TeleConfig.GIFT_STUDIO.value
+
+    /** Adds the row of the studio to the menu of a gift. */
+    @JvmStatic
+    fun addAction(
+        options: ItemOptions,
+        fragment: BaseFragment?,
+        account: Int,
+        dialogId: Long,
+        gift: TL_stars.SavedStarGift
+    ) {
+        if (!enabled()) return
+        options.add(R.drawable.filled_gift_simple, "Open in gift studio") {
+            options.dismiss()
+            fragment?.presentFragment(TeleGiftStudioActivity(account, dialogId, gift))
+        }
+    }
+}
diff --git a/TMessagesProj/src/main/java/tele/helpers/GiftStudioRenderer.kt b/TMessagesProj/src/main/java/tele/helpers/GiftStudioRenderer.kt
new file mode 100644
index 000000000..78eae3ba5
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/GiftStudioRenderer.kt
@@ -0,0 +1,223 @@
+package tele.helpers
+
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.LinearGradient
+import android.graphics.Paint
+import android.graphics.RadialGradient
+import android.graphics.RectF
+import android.graphics.Shader
+import android.graphics.Typeface
+import android.text.TextPaint
+import android.text.TextUtils
+import org.telegram.messenger.ImageLocation
+import org.telegram.messenger.ImageReceiver
+import org.telegram.messenger.R
+import org.telegram.tgnet.TLRPC
+
+/**
+ * The renderer of the gift studio (desktop 0197): the parts of a gift are drawn on a canvas, so
+ * the preview and the exported picture are the same picture. The geometry is in the canvas pixels,
+ * so a bigger canvas is a bigger picture and not a stretched one.
+ */
+class GiftStudioRenderer(private val context: Context) {
+
+    /** The rectangles of the last layout, in canvas pixels. */
+    class Layout(
+        @JvmField val content: RectF,
+        @JvmField val model: RectF,
+        @JvmField val symbol: RectF
+    )
+
+    private val paint = Paint(Paint.ANTI_ALIAS_FLAG)
+    private val textPaint = TextPaint(Paint.ANTI_ALIAS_FLAG).apply {
+        typeface = Typeface.create(Typeface.DEFAULT, Typeface.BOLD)
+    }
+    private val receiver = ImageReceiver()
+    private val symbolReceiver = ImageReceiver()
+
+    private var model: GiftStudio.Part? = null
+    private var symbol: GiftStudio.Part? = null
+    private var backdrop: GiftStudio.Part? = null
+
+    private var title = ""
+    private var number = ""
+    private var subtitle = ""
+
+    private var layout: Layout? = null
+
+    init {
+        receiver.setDelegate(object : ImageReceiver.ImageReceiverDelegate {
+            override fun didSetImage(imageReceiver: ImageReceiver, set: Boolean, thumb: Boolean, memCache: Boolean) {
+                if (set) imageReceiver.invalidate()
+            }
+        })
+        symbolReceiver.setDelegate(object : ImageReceiver.ImageReceiverDelegate {
+            override fun didSetImage(imageReceiver: ImageReceiver, set: Boolean, thumb: Boolean, memCache: Boolean) {
+                if (set) imageReceiver.invalidate()
+            }
+        })
+    }
+
+    fun setModel(part: GiftStudio.Part?) {
+        if (part === model) return
+        model = part
+        load(receiver, part?.document)
+    }
+
+    fun setSymbol(part: GiftStudio.Part?) {
+        if (part === symbol) return
+        symbol = part
+        load(symbolReceiver, part?.document)
+    }
+
+    fun setBackdrop(part: GiftStudio.Part?) {
+        if (part === backdrop) return
+        backdrop = part
+    }
+
+    fun setTexts(title: String, number: String, subtitle: String) {
+        this.title = title
+        this.number = number
+        this.subtitle = subtitle
+    }
+
+    private fun load(target: ImageReceiver, document: TLRPC.Document?) {
+        target.cancelLoadImage()
+        if (document == null) {
+            target.clearImage()
+            return
+        }
+        target.setImage(
+            ImageLocation.getForDocument(document),
+            "80_80_nolimit_pcache",
+            null,
+            null,
+            null,
+            document
+        )
+    }
+
+    fun release() {
+        receiver.cancelLoadImage()
+        symbolReceiver.cancelLoadImage()
+    }
+
+    /** The colors of the backdrop of the gift. */
+    private fun centerColor(): Int = backdrop?.centerColor?.takeIf { it != 0 } ?: 0xFF8E6CF0.toInt()
+
+    private fun edgeColor(): Int = backdrop?.edgeColor?.takeIf { it != 0 } ?: 0xFF3C2A8C.toInt()
+
+    private fun textColor(): Int = backdrop?.textColor?.takeIf { it != 0 } ?: Color.WHITE
+
+    /** The place of every part on a canvas of this size. */
+    fun computeLayout(width: Int, height: Int): Layout {
+        val content = RectF(0f, 0f, width.toFloat(), height.toFloat())
+        val side = Math.min(width, height).toFloat()
+        val modelSize = side * 0.62f
+        val modelRect = RectF(
+            content.centerX() - modelSize / 2f,
+            content.centerY() - modelSize / 2f - side * 0.06f,
+            content.centerX() + modelSize / 2f,
+            content.centerY() + modelSize / 2f - side * 0.06f
+        )
+        val symbolSize = side * 0.26f
+        val symbolRect = RectF(
+            content.centerX() - symbolSize / 2f,
+            modelRect.bottom + side * 0.02f,
+            content.centerX() + symbolSize / 2f,
+            modelRect.bottom + side * 0.02f + symbolSize
+        )
+        val result = Layout(content, modelRect, symbolRect)
+        layout = result
+        return result
+    }
+
+    /** The picture of the gift, as it is shown and as it is saved. */
+    fun draw(canvas: Canvas, width: Int, height: Int) {
+        val current = computeLayout(width, height)
+        val radius = Math.max(Math.min(width, height) * 0.35f, 1f)
+        paint.shader = RadialGradient(
+            current.content.centerX(),
+            current.content.centerY() - height * 0.12f,
+            radius,
+            intArrayOf(centerColor(), centerColor(), edgeColor()),
+            floatArrayOf(0f, 0f, 1f),
+            Shader.TileMode.CLAMP
+        )
+        canvas.drawRect(current.content, paint)
+        paint.shader = null
+
+        drawSymbol(canvas, current)
+        drawModel(canvas, current)
+        drawTexts(canvas, current)
+    }
+
+    private fun drawModel(canvas: Canvas, current: Layout) {
+        if (model?.document == null) return
+        val saved = canvas.save()
+        canvas.translate(current.model.left, current.model.top)
+        receiver.setImageCoords(0f, 0f, current.model.width(), current.model.height())
+        receiver.draw(canvas)
+        canvas.restoreToCount(saved)
+    }
+
+    private fun drawSymbol(canvas: Canvas, current: Layout) {
+        if (symbol?.document == null) return
+        val saved = canvas.save()
+        canvas.translate(current.symbol.left, current.symbol.top)
+        symbolReceiver.setImageCoords(0f, 0f, current.symbol.width(), current.symbol.height())
+        symbolReceiver.draw(canvas)
+        canvas.restoreToCount(saved)
+    }
+
+    private fun drawTexts(canvas: Canvas, current: Layout) {
+        val color = textColor()
+        val side = Math.min(current.content.width(), current.content.height())
+        val padding = side * 0.06f
+
+        textPaint.color = color
+        textPaint.textSize = side * 0.09f
+        val titleText = TextUtils.ellipsize(title, textPaint, current.content.width() - padding * 2, TextUtils.TruncateAt.END).toString()
+        canvas.drawText(titleText, padding, current.content.bottom - padding - textPaint.textSize * 0.6f, textPaint)
+
+        textPaint.textSize = side * 0.07f
+        val numberText = number
+        if (numberText.isNotEmpty()) {
+            canvas.drawText(numberText, padding, current.content.bottom - padding, textPaint)
+        }
+
+        if (subtitle.isNotEmpty()) {
+            textPaint.textSize = side * 0.055f
+            val subtitleText = TextUtils.ellipsize(subtitle, textPaint, current.content.width() - padding * 2, TextUtils.TruncateAt.END).toString()
+            canvas.drawText(subtitleText, padding, current.content.top + padding + textPaint.textSize, textPaint)
+        }
+    }
+
+    /** The picture of the gift as a bitmap of this size. */
+    fun renderBitmap(width: Int, height: Int): Bitmap {
+        val bitmap = Bitmap.createBitmap(Math.max(width, 1), Math.max(height, 1), Bitmap.Config.ARGB_8888)
+        val canvas = Canvas(bitmap)
+        draw(canvas, bitmap.width, bitmap.height)
+        return bitmap
+    }
+
+    /** The picture of the gift for a save or a share. */
+    fun renderForExport(width: Int, height: Int): Bitmap? {
+        if (receiver.drawable == null && model?.document != null) return null
+        return renderBitmap(width, height)
+    }
+
+    companion object {
+        /** The size of an exported picture. */
+        const val EXPORT_SIZE = 512
+
+        /** The biggest picture the studio makes, so a big scale doesn't eat the memory. */
+        const val MAX_EXPORT_PIXELS = 4096 * 4096
+
+        @JvmStatic
+        fun exportSize(scale: Int): Int = EXPORT_SIZE * scale.coerceIn(1, 4)
+    }
+}
diff --git a/TMessagesProj/src/main/java/tele/ui/TeleGiftStudioActivity.kt b/TMessagesProj/src/main/java/tele/ui/TeleGiftStudioActivity.kt
new file mode 100644
index 000000000..a78db9df0
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/ui/TeleGiftStudioActivity.kt
@@ -0,0 +1,338 @@
+package tele.ui
+
+import android.content.Context
+import android.graphics.Bitmap
+import android.view.Gravity
+import android.graphics.Canvas
+import android.graphics.Paint
+import android.graphics.RectF
+import android.view.Gravity
+import android.view.View
+import android.view.ViewGroup
+import android.widget.FrameLayout
+import android.widget.LinearLayout
+import android.widget.TextView
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.LiteMode
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.R
+import org.telegram.messenger.UserConfig
+import org.telegram.tgnet.tl.TL_stars
+import org.telegram.ui.ActionBar.ActionBar
+import org.telegram.ui.ActionBar.AlertDialog
+import org.telegram.ui.ActionBar.BaseFragment
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Cells.TextSettingsCell
+import org.telegram.ui.Components.BulletinFactory
+import org.telegram.ui.Components.LayoutHelper
+import org.telegram.ui.Stars.StarsController
+import tele.TeleConfig
+import tele.helpers.GiftStudio
+import tele.helpers.GiftStudioExport
+import tele.helpers.GiftStudioRenderer
+import tele.helpers.TeleLowercase
+import tele.helpers.TeleToast
+
+/**
+ * The gift studio (desktop 0197): a gift is built of a model, a backdrop and a symbol and the
+ * result is exported as a picture. The parts come from the gifts of the account, so nothing is
+ * asked of a third party.
+ */
+class TeleGiftStudioActivity @JvmOverloads constructor(
+    private val account: Int,
+    private val dialogId: Long,
+    private val initial: TL_stars.SavedStarGift? = null
+) : BaseFragment() {
+
+    private var preview: PreviewView? = null
+    private var renderer: GiftStudioRenderer? = null
+    private var collectionRow: TextSettingsCell? = null
+    private var modelRow: TextSettingsCell? = null
+    private var backdropRow: TextSettingsCell? = null
+    private var symbolRow: TextSettingsCell? = null
+    private var rarityRow: TextSettingsCell? = null
+    private var saveRow: TextSettingsCell? = null
+    private var videoRow: TextSettingsCell? = null
+    private var moreRow: TextSettingsCell? = null
+    private var pillRow: RarityPillView? = null
+    private var collectionCard: org.telegram.ui.Gifts.GiftSheet.GiftCell? = null
+    private val partsList by lazy { TeleStudioPartsList(parentActivity ?: context, account, resourceProvider) }
+
+    private val gifts = ArrayList<TL_stars.StarGift>()
+    private var parts: GiftStudio.Parts = GiftStudio.Parts(emptyList(), emptyList(), emptyList())
+    private var gift: TL_stars.StarGift? = null
+    private var model: GiftStudio.Part? = null
+    private var backdrop: GiftStudio.Part? = null
+    private var symbol: GiftStudio.Part? = null
+    private var generation = 0
+
+    override fun createView(context: Context): View {
+        actionBar.setBackButtonImage(R.drawable.ic_ab_back)
+        actionBar.setAllowOverlayTitle(true)
+        actionBar.setTitle(lc("Gift studio"))
+        actionBar.setActionBarMenuOnItemClick(object : ActionBar.ActionBarMenuOnItemClick() {
+            override fun onItemClick(id: Int) {
+                if (id == -1) finishFragment()
+            }
+        })
+
+        val container = LinearLayout(context)
+        container.orientation = LinearLayout.VERTICAL
+        container.setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundGray))
+
+        val previewView = PreviewView(context)
+        preview = previewView
+        renderer = GiftStudioRenderer(context)
+        container.addView(previewView, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, AndroidUtilities.dp(240f)))
+
+        catalogRow = addRow(container, "Catalog") { chooseCatalog() }
+        collectionRow = addRowWithCard(container, "Collection") { chooseCollection() }
+        modelRow = addRow(container, "Model") { chooseModel() }
+        backdropRow = addRow(container, "Backdrop") { chooseBackdrop() }
+        symbolRow = addRow(container, "Symbol") { chooseSymbol() }
+        rarityRow = addRow(container, "Rarity") {}
+        rarityRow?.isEnabled = false
+
+        saveRow = addRow(container, "Save as a picture") { savePng() }
+        if (TeleConfig.GIFT_STUDIO_VIDEO.value) {
+            videoRow = addRow(container, "Save as a video") { saveVideo() }
+        }
+
+        fragmentView = container
+        load()
+        return container
+    }
+
+    private fun lc(text: String): String = TeleLowercase.lc(text)
+
+    private fun addRow(container: LinearLayout, title: String, action: () -> Unit): TextSettingsCell {
+        val cell = TextSettingsCell(container.context)
+        cell.setText(lc(title), false)
+        cell.setOnClickListener { action() }
+        container.addView(cell, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT))
+        return cell
+    }
+
+    /** A row with the card of the gift on the left, like the desktop client shows it. */
+    private fun addRowWithCard(container: LinearLayout, title: String, action: () -> Unit): TextSettingsCell {
+        val cell = TextSettingsCell(container.context)
+        cell.setText(lc(title), false)
+        cell.setOnClickListener { action() }
+        val card = org.telegram.ui.Gifts.GiftSheet.GiftCell(container.context, account, resourceProvider)
+        card.setImageSize(44)
+        collectionCard = card
+        cell.addView(card, LayoutHelper.createFrame(44f, 44f, Gravity.CENTER_VERTICAL or Gravity.LEFT, 12f, 0f, 0f, 0f))
+        container.addView(cell, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, AndroidUtilities.dp(56f)))
+        return cell
+    }
+
+    private fun load() {
+        val stars = StarsController.getInstance(account)
+        val found = ArrayList<TL_stars.StarGift>()
+        for (gift in stars.gifts) {
+            found.add(gift)
+        }
+        if (dialogId != 0L) {
+            val list = stars.getProfileGiftsList(dialogId, false)
+            if (list != null) {
+                for (saved in list.gifts) {
+                    if (saved.gift is TL_stars.TL_starGiftUnique) found.add(saved.gift)
+                }
+            }
+        }
+        gifts.clear()
+        gifts.addAll(found)
+        parts = GiftStudio.collectParts(found)
+        val first = found.firstOrNull()
+        if (first != null) select(first)
+        val initialGift = initial?.gift
+        if (initialGift != null) {
+            found.add(initialGift)
+            parts = GiftStudio.collectParts(found)
+            select(initialGift)
+        }
+    }
+
+    private fun select(gift: TL_stars.StarGift) {
+        this.gift = gift
+        val own = GiftStudio.partsOf(gift)
+        model = own.models.firstOrNull() ?: parts.models.firstOrNull()
+        backdrop = own.backdrops.firstOrNull() ?: parts.backdrops.firstOrNull()
+        symbol = own.symbols.firstOrNull() ?: parts.symbols.firstOrNull()
+        update()
+    }
+
+    private fun update() {
+        val current = renderer ?: return
+        current.setModel(model)
+        current.setBackdrop(backdrop)
+        current.setSymbol(symbol)
+        val gift = gift
+        current.setTexts(
+            gift?.title ?: "",
+            gift?.num?.takeIf { it > 0 }?.let { "#$it" } ?: "",
+            listOfNotNull(model?.name, backdrop?.name, symbol?.name).joinToString(" · ")
+        )
+        collectionRow?.setValue(gift?.title ?: "", true)
+        modelRow?.setValue(model?.name ?: "", true)
+        backdropRow?.setValue(backdrop?.name ?: "", true)
+        symbolRow?.setValue(symbol?.name ?: "", true)
+        val modelPermille = model?.permille ?: 0
+        val backdropPermille = backdrop?.permille ?: 0
+        val odds = GiftStudio.rarityOdds(modelPermille, backdropPermille)
+        val chance = GiftStudio.rarityChance(modelPermille, backdropPermille)
+        rarityRow?.setValue(
+            when {
+                odds.isEmpty() -> lc("unknown")
+                chance.isEmpty() -> odds
+                else -> "$odds ($chance)"
+            },
+            true
+        )
+        pillRow?.setPart(modelPart)
+        // the card shows the gift with the chosen parts, so the picture is what will be saved
+        val built = gift?.let { GiftStudio.giftWithParts(it, model, backdrop, symbol) }
+        preview?.set(built)
+        collectionCard?.setStarsGift(built, false, false, false, false, false)
+    }
+
+    private fun chooseCollection() {
+        val rows = gifts.map { gift ->
+            TeleStudioPartsList.Row(GiftStudio.Part(gift.title ?: "", 0, gift.getDocument(), 0, 0, 0, 0, 0, null, GiftStudio.Tier.DEFAULT), gift, gift.title ?: "")
+        }
+        showDialog(partsList.dialog(lc("Collection"), rows, null, { part ->
+            val gift = gifts.firstOrNull { it.title == part.name }
+            if (gift != null) select(gift)
+        }, {}))
+    }
+
+    private fun choosePart(title: String, list: List<GiftStudio.Part>, apply: (GiftStudio.Part?) -> Unit) {
+        val rows = TeleStudioPartsList.rowsOf(list, gifts)
+        showDialog(partsList.dialog(lc(title), rows, null, { part -> apply(part) }, {}))
+    }
+
+    private fun chooseModel() {
+        choosePart("Model", parts.models) {
+            model = it
+            update()
+        }
+    }
+
+    private fun chooseBackdrop() {
+        choosePart("Backdrop", parts.backdrops) {
+            backdrop = it
+            update()
+        }
+    }
+
+    private fun chooseSymbol() {
+        choosePart("Symbol", parts.symbols) {
+            symbol = it
+            update()
+        }
+    }
+
+    private fun savePng() {
+        val current = renderer ?: return
+        val size = GiftStudioRenderer.exportSize(1)
+        val card = preview?.card()
+        val bitmap = if (card != null) {
+            // the picture of the card, so the file is what the studio shows
+            drawCard(card, size)
+        } else {
+            current.renderForExport(size, size)
+        }
+        if (bitmap == null) {
+            showError()
+            return
+        }
+        try {
+            val name = GiftStudioExport.fileName(gift?.title, gift?.num?.takeIf { it > 0 }?.let { "#$it" }, GiftStudioExport.Format.PNG)
+            val uri = GiftStudioExport.savePng(bitmap, name)
+            if (uri == null) {
+                showError()
+                return
+            }
+            showSaved()
+        } catch (throwable: Throwable) {
+            org.telegram.messenger.FileLog.e(throwable)
+            showError()
+        }
+    }
+
+    /** The card of the gift as a picture, the same way the grid saves its cards. */
+    private fun drawCard(card: org.telegram.ui.Gifts.GiftSheet.GiftCell, size: Int): Bitmap? {
+        return try {
+            val bitmap = Bitmap.createBitmap(size, size, Bitmap.Config.ARGB_8888)
+            val canvas = android.graphics.Canvas(bitmap)
+            card.measure(
+                View.MeasureSpec.makeMeasureSpec(size, View.MeasureSpec.EXACTLY),
+                View.MeasureSpec.makeMeasureSpec(size, View.MeasureSpec.EXACTLY)
+            )
+            card.layout(0, 0, size, size)
+            card.draw(canvas)
+            bitmap
+        } catch (throwable: Throwable) {
+            org.telegram.messenger.FileLog.e(throwable)
+            null
+        }
+    }
+
+    private fun saveVideo() {
+        val current = renderer ?: return
+        val size = GiftStudioRenderer.exportSize(1)
+        val frames = ArrayList<Bitmap>()
+        for (index in 0 until GiftStudioExport.videoFrames()) {
+            frames.add(current.renderBitmap(size, size))
+        }
+        val name = GiftStudioExport.fileName(gift?.title, gift?.num?.takeIf { it > 0 }?.let { "#$it" }, GiftStudioExport.Format.MP4)
+        val uri = GiftStudioExport.saveVideo(name, frames)
+        for (frame in frames) frame.recycle()
+        if (uri == null) {
+            showError()
+            return
+        }
+        showSaved()
+    }
+
+    private fun showSaved() {
+        val text = GiftStudioExport.savedText()
+        TeleToast.log("gift-studio-saved", text, account = account)
+        BulletinFactory.of(this).createSimpleBulletin(R.raw.info, text).show()
+    }
+
+    private fun showError() {
+        val text = LocaleController.getString(R.string.TeleGiftStudioError)
+        TeleToast.log("gift-studio-error", text, account = account)
+        BulletinFactory.of(this).createSimpleBulletin(R.raw.error, text).show()
+    }
+
+    override fun onFragmentDestroy() {
+        super.onFragmentDestroy()
+        renderer?.release()
+        renderer = null
+        preview = null
+    }
+
+    /** The card of the gift as it is shown: the stock one, so it looks like a gift in Telegram. */
+    private inner class PreviewView(context: Context) : FrameLayout(context) {
+
+        private val cell = org.telegram.ui.Gifts.GiftSheet.GiftCell(context, account, resourceProvider)
+
+        init {
+            cell.setImageSize(180)
+            addView(cell, LayoutHelper.createFrame(180, 180, Gravity.CENTER))
+        }
+
+        fun set(gift: TL_stars.StarGift?) {
+            if (gift == null) {
+                cell.setStarsGift(null, false, false, false, false, false)
+            } else {
+                cell.setStarsGift(gift, false, false, false, false, false)
+            }
+        }
+
+        /** The card of the gift, to draw it into a picture. */
+        fun card(): org.telegram.ui.Gifts.GiftSheet.GiftCell = cell
+    }
+}
diff --git a/TMessagesProj/src/main/java/tele/ui/TeleStudioPartsList.kt b/TMessagesProj/src/main/java/tele/ui/TeleStudioPartsList.kt
new file mode 100644
index 000000000..dd1bfe4da
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/ui/TeleStudioPartsList.kt
@@ -0,0 +1,174 @@
+package tele.ui
+
+import android.content.Context
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.View
+import android.view.ViewGroup
+import android.widget.LinearLayout
+import android.widget.TextView
+import androidx.recyclerview.widget.LinearLayoutManager
+import androidx.recyclerview.widget.RecyclerView
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.R
+import org.telegram.tgnet.tl.TL_stars
+import org.telegram.ui.ActionBar.AlertDialog
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Components.LayoutHelper
+import org.telegram.ui.Components.RecyclerListView
+import org.telegram.ui.Gifts.GiftSheet
+import tele.helpers.GiftStudio
+
+/**
+ * The list of the parts of the studio (desktop 0197): every row shows the card of the gift on the
+ * left, so the choice is seen before it is made. The card is the stock one of Telegram.
+ */
+class TeleStudioPartsList(
+    private val context: Context,
+    private val account: Int,
+    private val resourcesProvider: Theme.ResourcesProvider?
+) {
+
+    /** One row of the list: a part with the gift it belongs to. */
+    class Row(
+        @JvmField val part: GiftStudio.Part,
+        @JvmField val gift: TL_stars.StarGift?,
+        @JvmField val title: String
+    )
+
+    /**
+     * The dialog of the parts, every row with the card of the gift of the part. The caller shows it.
+     *
+     * [onPick] is called with the chosen part, [onCancel] when the list is closed without a choice.
+     */
+    fun dialog(
+        title: String,
+        rows: List<Row>,
+        selected: GiftStudio.Part?,
+        onPick: (GiftStudio.Part) -> Unit,
+        onCancel: () -> Unit
+    ): AlertDialog {
+        // an empty list still opens, so the row of the setting is never dead
+        val list = if (rows.isEmpty()) emptyList(context, resourcesProvider) else partsList(context, resourcesProvider, rows, selected, onPick)
+        return AlertDialog.Builder(context, resourcesProvider)
+            .setTitle(title)
+            .setView(list)
+            .setNegativeButton(LocaleController.getString(R.string.Cancel)) { _, _ -> onCancel() }
+            .create()
+    }
+
+    /** The list of the parts. */
+    private fun partsList(
+        context: Context,
+        resourcesProvider: Theme.ResourcesProvider?,
+        rows: List<Row>,
+        selected: GiftStudio.Part?,
+        onPick: (GiftStudio.Part) -> Unit
+    ): RecyclerListView {
+        val list = RecyclerListView(context)
+        list.layoutManager = LinearLayoutManager(context)
+        list.adapter = Adapter(rows, selected)
+        list.setOnItemClickListener { _, position ->
+            rows.getOrNull(position)?.let { onPick(it.part) }
+        }
+        return list
+    }
+
+    /** A list that only says there is nothing to pick yet. */
+    private fun emptyList(context: Context, resourcesProvider: Theme.ResourcesProvider?): View {
+        val text = TextView(context)
+        text.setText(LocaleController.getString(R.string.TeleGiftStudioNoParts))
+        text.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14f)
+        text.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2, resourcesProvider))
+        text.setPadding(AndroidUtilities.dp(32f), AndroidUtilities.dp(48f), AndroidUtilities.dp(32f), AndroidUtilities.dp(48f))
+        return text
+    }
+
+    private inner class Adapter(
+        private val rows: List<Row>,
+        private val selected: GiftStudio.Part?
+    ) : RecyclerListView.SelectionAdapter() {
+
+        override fun getItemCount(): Int = rows.size
+
+        override fun isEnabled(holder: RecyclerView.ViewHolder): Boolean = true
+
+        override fun onCreateViewHolder(parent: ViewGroup, viewType: Int): RecyclerView.ViewHolder {
+            return Holder(RowView(context, account, resourcesProvider))
+        }
+
+        override fun onBindViewHolder(holder: RecyclerView.ViewHolder, position: Int) {
+            val row = rows[position]
+            (holder.itemView as RowView).set(row, row.part === selected)
+        }
+    }
+
+    private class Holder(val row: RowView) : RecyclerView.ViewHolder(row)
+
+    /** One row: the card of the gift on the left and the name of the part on the right. */
+    private class RowView(
+        context: Context,
+        account: Int,
+        resourcesProvider: Theme.ResourcesProvider?
+    ) : LinearLayout(context) {
+
+        private val cell: GiftSheet.GiftCell
+        private val nameView: TextView
+        private val chanceView: TextView
+
+        init {
+            orientation = HORIZONTAL
+            gravity = Gravity.CENTER_VERTICAL
+            setPadding(AndroidUtilities.dp(12f), AndroidUtilities.dp(6f), AndroidUtilities.dp(16f), AndroidUtilities.dp(6f))
+            cell = GiftSheet.GiftCell(context, account, resourcesProvider)
+            cell.setImageSize(52)
+            addView(cell, LayoutHelper.createLinear(52, 52))
+            val text = LinearLayout(context)
+            text.orientation = VERTICAL
+            nameView = TextView(context)
+            nameView.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16f)
+            nameView.setTextColor(Theme.getColor(Theme.key_dialogTextBlack, resourcesProvider))
+            chanceView = TextView(context)
+            chanceView.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13f)
+            chanceView.setTextColor(Theme.getColor(Theme.key_dialogTextGray2, resourcesProvider))
+            text.addView(nameView, LayoutHelper.createLinear(LayoutHelper.WRAP_CONTENT, LayoutHelper.WRAP_CONTENT))
+            text.addView(chanceView, LayoutHelper.createLinear(LayoutHelper.WRAP_CONTENT, LayoutHelper.WRAP_CONTENT))
+            addView(text, LayoutHelper.createLinear(0, LayoutHelper.WRAP_CONTENT, 1f))
+        }
+
+        fun set(row: Row, selected: Boolean) {
+            nameView.text = row.title
+            chanceView.text = GiftStudio.rarityOdds(row.part.permille, 1000)
+            chanceView.visibility = if (chanceView.text.isEmpty()) GONE else VISIBLE
+            // the card of the gift the part belongs to
+            val gift = row.gift
+            if (gift != null) {
+                cell.setStarsGift(gift, false, false, false, false, false)
+            }
+            alpha = if (selected) 1f else 0.85f
+        }
+    }
+
+    companion object {
+        /** The rows of the parts of one kind, with the gift of every part. */
+        @JvmStatic
+        fun rowsOf(parts: List<GiftStudio.Part>, gifts: List<TL_stars.StarGift>): List<Row> {
+            val result = ArrayList<Row>()
+            for (part in parts) {
+                val gift = gifts.firstOrNull { gift ->
+                    gift.attributes.any { attribute ->
+                        when (attribute) {
+                            is TL_stars.starGiftAttributeModel -> attribute.name == part.name
+                            is TL_stars.starGiftAttributeBackdrop -> attribute.name == part.name
+                            is TL_stars.starGiftAttributePattern -> attribute.name == part.name
+                            else -> false
+                        }
+                    }
+                }
+                result.add(Row(part, gift, part.name))
+            }
+            return result
+        }
+    }
+}
