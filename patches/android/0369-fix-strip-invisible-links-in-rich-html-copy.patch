From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: test <test@example.com>
Date: Sun, 22 Nov 2026 11:50:25 +0300
Subject: [PATCH] fix: strip invisible links in rich html copy

The rich-message HTML copy serialized links straight from the spans, bypassing CopyLinks. A link whose whole span text is invisible (spaces and tabs included, like the desktop table) is now dropped there too.
---
 .../src/main/java/org/telegram/ui/iv/RichHtml.java    | 11 ++++++++---
 TMessagesProj/src/main/java/tele/helpers/CopyLinks.kt |  5 +++--
 2 files changed, 11 insertions(+), 5 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/iv/RichHtml.java b/TMessagesProj/src/main/java/org/telegram/ui/iv/RichHtml.java
index bb6e9797c..c26eda484 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/iv/RichHtml.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/iv/RichHtml.java
@@ -452,13 +452,18 @@ public class RichHtml {
             String url = null;
             URLSpanReplacement[] urls = sp.getSpans(pos, next, URLSpanReplacement.class);
             if (urls.length > 0) url = urls[0].getURL();
+            // a link over invisible text (spaces included) carries nothing visible: drop it whole
+            boolean hiddenLink = url != null && tele.helpers.CopyLinks.enabled()
+                && tele.helpers.InvisibleNames.isInvisibleText(cs.subSequence(pos, next));
             long emojiId = 0;
             AnimatedEmojiSpan[] emoji = sp.getSpans(pos, next, AnimatedEmojiSpan.class);
             if (emoji.length > 0 && !emoji[0].standard) emojiId = emoji[0].getDocumentId();
 
-            openInline(out, flags, url, emojiId);
-            escape(out, cs, pos, next);
-            closeInline(out, flags, url, emojiId);
+            if (!hiddenLink) {
+                openInline(out, flags, url, emojiId);
+                escape(out, cs, pos, next);
+                closeInline(out, flags, url, emojiId);
+            }
             pos = next;
         }
     }
diff --git a/TMessagesProj/src/main/java/tele/helpers/CopyLinks.kt b/TMessagesProj/src/main/java/tele/helpers/CopyLinks.kt
index b190fd206..dd19c2764 100644
--- a/TMessagesProj/src/main/java/tele/helpers/CopyLinks.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/CopyLinks.kt
@@ -8,8 +8,9 @@ import tele.TeleConfig
 
 /**
  * Strips links hidden in invisible text when copying (desktop 0343). A custom-url entity whose
- * whole range is invisible code points carries no visible text, so the link goes and the invisible
- * characters with it; a link over visible text stays.
+ * whole range is invisible code points — spaces and tabs included, like the desktop table —
+ * carries no visible text, so the link goes and the invisible characters with it; a link over
+ * visible text stays.
  */
 object CopyLinks {
 
