From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Thu, 5 Nov 2026 15:20:09 +0300
Subject: [PATCH] fix: keep badges clear of names and restore shot tags

---
 .../java/org/telegram/ui/Cells/ChatMessageCell.java  | 12 ++++++++++--
 TMessagesProj/src/main/java/tele/ui/ShotColumn.kt    |  1 +
 2 files changed, 11 insertions(+), 2 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Cells/ChatMessageCell.java b/TMessagesProj/src/main/java/org/telegram/ui/Cells/ChatMessageCell.java
index 09506bd45..5e42b7735 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Cells/ChatMessageCell.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Cells/ChatMessageCell.java
@@ -16180,13 +16180,21 @@ public class ChatMessageCell extends BaseCell implements SeekBar.SeekBarDelegate
             if (currentNameBotVerificationId != 0) {
                 nameWidth -= dp(4 + 12 + 4);
             }
-            final boolean teleVerified = !viaBot && !viaGuestBot && (tele_bubbleKey & 1) != 0;
+            boolean teleVerified = !viaBot && !viaGuestBot && (tele_bubbleKey & 1) != 0;
             if (teleVerified) {
-                nameWidth -= dp(4 + 16);
+                final int verifiedWidth = dp(4 + 20);
+                if (nameWidth > verifiedWidth) {
+                    nameWidth -= verifiedWidth;
+                } else {
+                    teleVerified = false;
+                }
             }
             if (adminString != null) {
                 nameWidth -= dp(8);
             }
+            if (nameWidth < 0) {
+                nameWidth = 0;
+            }
             nameStringFinal = TextUtils.ellipsize(nameStringFinal, Theme.chat_namePaint, nameWidth + additionalWidth - (viaBot ? viaWidth : 0), TextUtils.TruncateAt.END);
             if (teleVerified) {
                 nameStringFinal = tele.ui.TeleNameBadges.withVerified(nameStringFinal);
diff --git a/TMessagesProj/src/main/java/tele/ui/ShotColumn.kt b/TMessagesProj/src/main/java/tele/ui/ShotColumn.kt
index 90e2a2e5e..724247eee 100644
--- a/TMessagesProj/src/main/java/tele/ui/ShotColumn.kt
+++ b/TMessagesProj/src/main/java/tele/ui/ShotColumn.kt
@@ -93,6 +93,7 @@ class ShotColumn(
 
     private val delegate = object : ChatMessageCell.ChatMessageCellDelegate {
         override fun canPerformActions(): Boolean = false
+        override fun isAdmin(uid: Long): Boolean = true
     }
 
     private val afterTime = ArrayList<ChatMessageCell>()
