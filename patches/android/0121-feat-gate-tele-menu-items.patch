From: tangenx <me@tangenx.dev>
Date: Thu, 22 Oct 2026 07:23:49 +0300
Subject: [PATCH] feat: gate tele menu items

---
 .../src/main/java/tele/helpers/MessageMenu.kt | 26 +++++++++++++++++++
 .../java/tele/ui/settings/TeleMenuActivity.kt |  2 ++
 2 files changed, 28 insertions(+)

diff --git a/TMessagesProj/src/main/java/tele/helpers/MessageMenu.kt b/TMessagesProj/src/main/java/tele/helpers/MessageMenu.kt
index d1d29f82a..835f08c20 100644
--- a/TMessagesProj/src/main/java/tele/helpers/MessageMenu.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/MessageMenu.kt
@@ -2,6 +2,7 @@ package tele.helpers
 
 import org.json.JSONArray
 import org.telegram.ui.ChatActivity
+import tele.TeleConfig
 import tele.db.TeleDatabaseHelper
 
 object MessageMenu {
@@ -63,6 +64,15 @@ object MessageMenu {
     private const val KEY = "message_menu_hidden"
     private const val ORDER_KEY = "message_menu_order"
 
+    /** The items that only show up when their feature is on. */
+    private val GATES = mapOf(
+        ChatActivity.tele_option_copy_msg_id to TeleConfig.MESSAGE_ID_MENU,
+        ChatActivity.tele_option_view_as_tl to TeleConfig.VIEW_AS_TL,
+        ChatActivity.tele_option_copy_emoji_id to TeleConfig.COPY_EMOJI_ID,
+        ChatActivity.tele_option_shot to TeleConfig.SHOT,
+        ChatActivity.tele_option_mark_viewed to TeleConfig.KEEP_DISAPPEARING_MEDIA
+    )
+
     private fun loadOrder(): Map<Int, Int> {
         val raw = TeleDatabaseHelper.get(ORDER_KEY) ?: return emptyMap()
         val out = HashMap<Int, Int>()
@@ -122,8 +132,24 @@ object MessageMenu {
         save(set)
     }
 
+    /** The item is behind a feature that is off, the menu editor shows it greyed. */
+    @JvmStatic
+    fun isGatedOff(code: Int): Boolean {
+        val gate = GATES[code] ?: return false
+        return gate.value as? Boolean != true
+    }
+
     @JvmStatic
     fun filter(items: ArrayList<CharSequence>, icons: ArrayList<Int>, options: ArrayList<Int>) {
+        // the items of a feature that is off don't show up
+        for (i in options.indices.reversed()) {
+            val gate = GATES[options[i]] ?: continue
+            if (gate.value as? Boolean != true) {
+                items.removeAt(i)
+                icons.removeAt(i)
+                options.removeAt(i)
+            }
+        }
         val hidden = load()
         if (hidden != null && hidden.isNotEmpty()) {
             for (i in options.indices.reversed()) {
diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleMenuActivity.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleMenuActivity.kt
index 9f67639d3..bdc30982a 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TeleMenuActivity.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleMenuActivity.kt
@@ -157,6 +157,8 @@ class TeleMenuActivity : BaseFragment() {
                     val cell = wrapper.getChildAt(0) as TextCheckCell
                     val item = rows[position - 1]
                     cell.setTextAndCheck(item.name, !MessageMenu.isHidden(item.code), position < rows.size)
+                    // the items of a feature that is off stay greyed
+                    cell.setAlpha(if (MessageMenu.isGatedOff(item.code)) 0.5f else 1f)
                 }
             }
         }
