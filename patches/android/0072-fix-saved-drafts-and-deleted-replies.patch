+    public void teleSaveDraftFromAttachAlert(ChatAttachAlert alert) {
+        if (chatActivityEnterView == null || alert == null) {
+            return;
+        }
+        MessageObject replyObject = chatActivityEnterView.getReplyingMessageObject();
+        TLRPC.Message replyMessage = replyObject != null ? replyObject.messageOwner : null;
+        CharSequence text = alert.getCommentView().getText();
+        ArrayList<TLRPC.MessageEntity> entities = MediaDataController.getInstance(currentAccount).getEntities(new CharSequence[]{text}, true);
+        TLRPC.TL_draftMessage draft = tele.helpers.SavedDrafts.buildDraftMessage(text, entities, replyMessage, chatActivityEnterView.getWebPage());
+        ArrayList<MediaController.PhotoEntry> entries = new ArrayList<>();
+        HashMap<Object, Object> selected = alert.getPhotoLayout().getSelectedPhotos();
+        ArrayList<Object> order = alert.getPhotoLayout().getSelectedPhotosOrder();
+        for (Object key : order) {
+            Object value = selected.get(key);
+            if (value instanceof MediaController.PhotoEntry) {
+                entries.add((MediaController.PhotoEntry) value);
+            }
+        }
+        final TLRPC.TL_draftMessage finalDraft = draft;
+        final ArrayList<MediaController.PhotoEntry> finalEntries = entries;
+        final TLRPC.Message finalReplyMessage = replyMessage;
+        Utilities.globalQueue.postRunnable(() -> {
+            List<tele.helpers.SavedDrafts.StoredFile> files = tele.helpers.SavedDrafts.copyAttachedFiles(finalEntries);
+            tele.helpers.SavedDrafts.save(currentAccount, getDialogId(), (int) getTopicId(), finalDraft, files, finalReplyMessage);
+            AndroidUtilities.runOnUIThread(() -> {
+                updateTeleDraftButton(true);
+                BulletinFactory.of(this).createSimpleBulletin(R.raw.contact_check, LocaleController.getString(R.string.TeleDraftSaved)).show();
+                chatActivityEnterView.setFieldText("");
+                alert.getPhotoLayout().clearSelectedPhotos();
+                alert.dismiss();
+        });
         });
     }
 
