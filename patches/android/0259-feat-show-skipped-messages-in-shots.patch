+    private fun skippedObject(account: Int, count: Int): MessageObject {
+        val message = TLRPC.TL_message()
+        message.message = LocaleController.formatPluralString("TeleShotSkipped", count)
+        message.id = 0
+        message.date = 0
+        val result = MessageObject(account, message, false, false)
+        result.type = 10
+        result.contentType = 1
+        result.isDateObject = true
+        return result
+    }
