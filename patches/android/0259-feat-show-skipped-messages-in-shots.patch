+    /** Desktop 0327: the messages of the selected range that the shot does not show. */
+    private fun countSkipped(chat: ChatActivity, source: List<MessageObject>): Map<Int, Int> {
+        if (source.size < 2) return emptyMap()
+        val loaded = chat.messages.filter { !it.isDateObject && !it.isSponsored && it.id > 0 }
+        if (loaded.isEmpty()) return emptyMap()
+        val result = HashMap<Int, Int>()
+        for (i in 1 until source.size) {
+            val previous = source[i - 1]
+            val next = source[i]
+            if (previous.dialogId != next.dialogId || previous.topicId != next.topicId || next.id <= previous.id) continue
+            val groups = HashSet<Long>()
+            var count = 0
+            for (message in loaded) {
+                if (message.id <= previous.id || message.id >= next.id) continue
+                if (message.topicId != next.topicId) continue
+                val group = message.groupId
+                if (group != 0L && !groups.add(group)) continue
+                count++
+            }
+            if (count > 0) result[next.id] = count
+        }
+        return result
+    }
+
     // an album always travels whole, even when only one of its photos was selected
