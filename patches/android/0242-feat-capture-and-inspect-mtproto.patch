diff --git a/TMessagesProj/src/main/java/tele/helpers/TeleMtp.kt b/TMessagesProj/src/main/java/tele/helpers/TeleMtp.kt
new file mode 100644
index 000000000..399c612ce
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/TeleMtp.kt
@@ -0,0 +1,415 @@
+package tele.helpers
+
+import org.json.JSONArray
+import org.json.JSONObject
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.ApplicationLoader
+import org.telegram.messenger.FileLog
+import org.telegram.messenger.Utilities
+import org.telegram.tgnet.TLObject
+import org.telegram.tgnet.TLRPC
+import tele.TeleConfig
+import java.io.File
+import java.lang.reflect.Field
+import java.lang.reflect.Modifier
+import java.util.ArrayDeque
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.CopyOnWriteArrayList
+
+/**
+ * The Java side of the MTProto inspector: what Telegram hands to tgnet and what comes back,
+ * bounded and redacted. The encrypted wire packets stay in native code and are not visible here,
+ * so the screen is honest about being the TL boundary, not a packet dump.
+ */
+object TeleMtp {
+
+    /** One log line, like the desktop inspector: a send, a receive or an incoming update. */
+    class Entry(
+        @JvmField val id: Long,
+        @JvmField val account: Int,
+        @JvmField val method: String,
+        @JvmField val dc: Int,
+        /** 0 send, 1 receive, 2 other (updates). */
+        @JvmField val direction: Int,
+        @JvmField val json: String,
+        @JvmField val errorText: String,
+        @JvmField val timeMillis: Long,
+        @JvmField val durationMs: Long,
+        @JvmField val messageId: Long,
+        @JvmField val size: Int
+    )
+
+    private const val MAX_ENTRIES = 300
+    private const val MAX_SIDE = 16000
+    private const val MAX_DEPTH = 4
+    private const val MAX_VECTOR = 20
+    private const val MAX_STRING = 200
+    private const val PENDING_AGE_MS = 5 * 60 * 1000L
+    private const val SAVE_DELAY_MS = 1000L
+    private const val FORMAT = 2
+
+    private class Pending(
+        @JvmField val id: Long,
+        @JvmField val startedAt: Long,
+        @JvmField val created: Long,
+        @JvmField val method: String,
+        @JvmField val dc: Int
+    )
+
+    private class State {
+        @JvmField val entries = ArrayDeque<Entry>()
+        @JvmField var loaded = false
+        @JvmField var dirty = false
+        @JvmField var saveScheduled = false
+    }
+
+    private val lock = Any()
+    private val states = ConcurrentHashMap<Int, State>()
+    private val pending = ConcurrentHashMap<Long, Pending>()
+    private val listeners = CopyOnWriteArrayList<Runnable>()
+    private var nextId = 1L
+
+    @JvmStatic
+    fun enabled(): Boolean = TeleConfig.MTP_INSPECTOR.value
+
+    @JvmStatic
+    fun addListener(listener: Runnable) {
+        if (!listeners.contains(listener)) listeners.add(listener)
+    }
+
+    @JvmStatic
+    fun removeListener(listener: Runnable) {
+        listeners.remove(listener)
+    }
+
+    /** Called before the request is serialized: the toggle check comes before any copy. */
+    @JvmStatic
+    fun onRequest(account: Int, request: TLObject?, flags: Int, datacenterId: Int, token: Int) {
+        if (request == null || !enabled()) return
+        try {
+            val dc = if (datacenterId == Int.MAX_VALUE) currentDc(account) else datacenterId
+            val text = json(request)
+            val method = methodName(request)
+            val entry = append(account, method, dc, 0, text, "", System.currentTimeMillis(), 0, 0)
+            pending[pendingKey(account, token)] = Pending(entry.id, System.nanoTime(), entry.timeMillis, method, dc)
+        } catch (e: Throwable) {
+            FileLog.e(e)
+        }
+    }
+
+    /** Called after the native answer: a receive line with the parsed response or the error. */
+    @JvmStatic
+    fun onResponse(account: Int, request: TLObject?, response: TLObject?, error: TLRPC.TL_error?, messageId: Long, token: Int) {
+        if (request == null || !enabled()) return
+        try {
+            val waiting = pending.remove(pendingKey(account, token)) ?: return
+            if (System.currentTimeMillis() - waiting.created > PENDING_AGE_MS) return
+            val duration = (System.nanoTime() - waiting.startedAt) / 1_000_000L
+            val text = if (response != null) json(response) else ""
+            val errorText = if (error != null) (error.code.toString() + " " + error.text.orEmpty()).trim() else ""
+            val method = if (response != null) methodName(response) else waiting.method
+            append(account, method, waiting.dc, 1, text, errorText, System.currentTimeMillis(), duration, messageId)
+        } catch (e: Throwable) {
+            FileLog.e(e)
+        }
+    }
+
+    /** Incoming updates, a separate toggle: they grow the log fast. */
+    @JvmStatic
+    fun onUpdate(account: Int, updates: TLRPC.Updates?) {
+        if (updates == null || !enabled() || !TeleConfig.MTP_UPDATES.value) return
+        try {
+            append(account, methodName(updates), currentDc(account), 2, json(updates), "", System.currentTimeMillis(), 0, 0)
+        } catch (e: Throwable) {
+            FileLog.e(e)
+        }
+    }
+
+    private fun append(
+        account: Int,
+        method: String,
+        dc: Int,
+        direction: Int,
+        text: String,
+        errorText: String,
+        time: Long,
+        duration: Long,
+        messageId: Long
+    ): Entry {
+        val state = stateOf(account)
+        val id = synchronized(lock) { nextId++ }
+        val entry = Entry(id, account, method, dc, direction, text, errorText, time, duration, messageId, text.toByteArray(Charsets.UTF_8).size)
+        synchronized(lock) {
+            state.entries.addFirst(entry)
+            while (state.entries.size > MAX_ENTRIES) state.entries.removeLast()
+            state.dirty = true
+        }
+        scheduleSave(account)
+        dispatch()
+        return entry
+    }
+
+    @JvmStatic
+    fun entries(account: Int): List<Entry> = synchronized(lock) { ArrayList(stateOf(account).entries) }
+
+    @JvmStatic
+    fun entry(account: Int, id: Long): Entry? = synchronized(lock) { stateOf(account).entries.firstOrNull { it.id == id } }
+
+    @JvmStatic
+    fun sizeText(account: Int): String = synchronized(lock) {
+        val list = stateOf(account).entries
+        var bytes = 0
+        for (entry in list) bytes += entry.size
+        val size = if (bytes < 1024) "$bytes B" else "${Math.max(1, bytes / 1024)} KB"
+        "${list.size} ${if (list.size == 1) "entry" else "entries"} · $size"
+    }
+
+    /** A logged out account leaves no captured traffic behind. */
+    @JvmStatic
+    fun onLogout(account: Int) {
+        clear(account)
+    }
+
+    @JvmStatic
+    fun clear(account: Int) {
+        synchronized(lock) {
+            val state = stateOf(account)
+            state.entries.clear()
+            state.dirty = false
+        }
+        pending.clear()
+        runCatching { fileOf(account).delete() }
+        dispatch()
+    }
+
+    /** `TL_messages_deleteMessages` reads as `messages.deleteMessages`, like the TL schema. */
+    @JvmStatic
+    fun methodName(object1: TLObject?): String {
+        val clazz = object1?.javaClass ?: return ""
+        TeleTl.nameOfClassIfLoaded(clazz.name)?.let { return it }
+        val simple = clazz.simpleName
+        val base = if (simple.startsWith("TL_")) simple.substring(3) else simple
+        val dot = base.indexOf('_')
+        return if (dot < 0) base else base.substring(0, dot) + "." + base.substring(dot + 1)
+    }
+
+    /** A bounded, redacted JSON view; nothing here touches the disk until the ring is saved. */
+    /** Always valid json: when the size cap is reached the rest of the fields is simply dropped. */
+    @JvmStatic
+    fun json(object1: TLObject?): String {
+        if (object1 == null) return ""
+        return try {
+            val text = StringBuilder()
+            writeValue(text, object1, 0)
+            text.toString()
+        } catch (e: Throwable) {
+            ""
+        }
+    }
+
+    private fun full(out: StringBuilder): Boolean = out.length >= MAX_SIDE
+
+    private fun writeValue(out: StringBuilder, value: Any?, depth: Int) {
+        if (out.length > MAX_SIDE) return
+        when (value) {
+            null -> out.append("null")
+            is String -> quoted(out, value)
+            is Boolean -> out.append(value)
+            is Int, is Long, is Short, is Byte -> out.append(value)
+            is Double, is Float -> out.append(value)
+            is TLObject -> writeObject(out, value, depth)
+            is Collection<*> -> {
+                out.append('[')
+                var first = true
+                var count = 0
+                for (item in value) {
+                    if (count++ >= MAX_VECTOR || full(out)) break
+                    if (!first) out.append(',')
+                    first = false
+                    writeValue(out, item, depth + 1)
+                }
+                out.append(']')
+            }
+            is ByteArray -> quoted(out, "bytes:${value.size}")
+            is org.telegram.tgnet.NativeByteBuffer -> quoted(out, "<bytes>")
+            else -> quoted(out, value.toString())
+        }
+    }
+
+    private fun writeObject(out: StringBuilder, value: Any, depth: Int) {
+        if (depth > MAX_DEPTH) {
+            quoted(out, "…")
+            return
+        }
+        out.append('{')
+        // the desktop view marks the type of every object, and so do we
+        val type = TeleTl.nameOfClassIfLoaded(value.javaClass.name)
+        if (type != null) {
+            quoted(out, "_")
+            out.append(':')
+            quoted(out, type)
+            out.append(',')
+        }
+        var first = true
+        for (field in fieldsOf(value.javaClass)) {
+            if (full(out)) break
+            val secret = redacted(field.name)
+            quoted(out, field.name)
+            out.append(':')
+            if (secret) {
+                quoted(out, "<redacted>")
+            } else {
+                val item = runCatching { field.get(value) }.getOrNull()
+                writeValue(out, item, depth + 1)
+            }
+            out.append(',')
+            first = false
+        }
+        if (!first) out.setLength(out.length - 1)
+        out.append('}')
+    }
+
+    private fun quoted(out: StringBuilder, text: String) {
+        out.append('"')
+        val limit = Math.min(text.length, MAX_STRING)
+        for (i in 0 until limit) {
+            val c = text[i]
+            when {
+                c == '"' -> out.append("\\\"")
+                c == '\\' -> out.append("\\\\")
+                c == '\n' -> out.append("\\n")
+                c == '\r' -> out.append("\\r")
+                c == '\t' -> out.append("\\t")
+                c < ' ' -> out.append(' ')
+                else -> out.append(c)
+            }
+        }
+        if (text.length > limit) out.append('…')
+        out.append('"')
+    }
+
+    private fun fieldsOf(clazz: Class<*>): List<Field> =
+        clazz.fields.filter {
+            !Modifier.isStatic(it.modifiers) && !it.isSynthetic &&
+                it.name != "flags" && it.name != "networkType" && it.name != "disableFree"
+        }
+
+    private fun redacted(name: String): Boolean {
+        val lower = name.lowercase()
+        if (lower == "user_id" || lower == "chat_id" || lower == "channel_id") return false
+        return lower.contains("password") || lower.contains("auth") || lower.contains("secret") ||
+            lower.contains("phone") || lower.contains("key") || lower.contains("hash") ||
+            lower.contains("token")
+    }
+
+    // sendRequestInternal gets the override DC, the real one lives in the connection
+    private fun currentDc(account: Int): Int = runCatching {
+        org.telegram.tgnet.ConnectionsManager.getInstance(account).currentDatacenterId
+    }.getOrDefault(-1)
+
+    private fun pendingKey(account: Int, token: Int): Long =
+        (account.toLong() shl 32) or (token.toLong() and 0xFFFFFFFFL)
+
+    private fun stateOf(account: Int): State {
+        val state = states.getOrPut(account) { State() }
+        if (!state.loaded) {
+            synchronized(lock) {
+                if (!state.loaded) {
+                    state.loaded = true
+                    load(account, state)
+                }
+            }
+        }
+        return state
+    }
+
+    private fun dir(account: Int): File = File(ApplicationLoader.applicationContext.filesDir, "tele_mtp")
+
+    private fun fileOf(account: Int): File = File(dir(account), "$account.json")
+
+    private fun load(account: Int, state: State) {
+        val file = fileOf(account)
+        if (!file.exists() || file.length() == 0L) return
+        try {
+            val root = JSONObject(file.readText())
+            if (root.optInt("format") != FORMAT) {
+                file.delete()
+                return
+            }
+            val array = root.optJSONArray("entries") ?: return
+            for (i in 0 until array.length()) {
+                val item = array.optJSONObject(i) ?: continue
+                state.entries.addLast(
+                    Entry(
+                        id = item.optLong("id"),
+                        account = account,
+                        method = item.optString("method"),
+                        dc = item.optInt("dc", -1),
+                        direction = item.optInt("direction"),
+                        json = item.optString("json"),
+                        errorText = item.optString("error"),
+                        timeMillis = item.optLong("time"),
+                        durationMs = item.optLong("duration"),
+                        messageId = item.optLong("messageId"),
+                        size = item.optInt("size")
+                    )
+                )
+            }
+            while (state.entries.size > MAX_ENTRIES) state.entries.removeLast()
+        } catch (e: Throwable) {
+            FileLog.e(e)
+        }
+    }
+
+    private fun scheduleSave(account: Int) {
+        val state = stateOf(account)
+        if (state.saveScheduled) return
+        state.saveScheduled = true
+        AndroidUtilities.runOnUIThread({
+            state.saveScheduled = false
+            Utilities.globalQueue.postRunnable { save(account, state) }
+        }, SAVE_DELAY_MS)
+    }
+
+    private fun save(account: Int, state: State) {
+        try {
+            val array = JSONArray()
+            synchronized(lock) {
+                if (!state.dirty) return
+                state.dirty = false
+                for (entry in state.entries) {
+                    array.put(
+                        JSONObject()
+                            .put("id", entry.id)
+                            .put("method", entry.method)
+                            .put("dc", entry.dc)
+                            .put("direction", entry.direction)
+                            .put("json", entry.json)
+                            .put("error", entry.errorText)
+                            .put("time", entry.timeMillis)
+                            .put("duration", entry.durationMs)
+                            .put("messageId", entry.messageId)
+                            .put("size", entry.size)
+                    )
+                }
+            }
+            val out = dir(account).apply { mkdirs() }
+            val file = File(out, "$account.json")
+            val tmp = File(out, "$account.json.tmp")
+            tmp.writeText(JSONObject().put("format", FORMAT).put("entries", array).toString())
+            if (!tmp.renameTo(file)) {
+                file.delete()
+                tmp.renameTo(file)
+            }
+        } catch (e: Throwable) {
+            FileLog.e(e)
+        }
+    }
+
+    private fun dispatch() {
+        if (listeners.isEmpty()) return
+        AndroidUtilities.runOnUIThread {
+            for (listener in listeners) runCatching { listener.run() }
+        }
+    }
+}
diff --git a/TMessagesProj/src/main/java/tele/helpers/TeleTl.kt b/TMessagesProj/src/main/java/tele/helpers/TeleTl.kt
new file mode 100644
index 000000000..2e98c0ce5
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/TeleTl.kt
@@ -0,0 +1,371 @@
+package tele.helpers
+
+import org.telegram.messenger.ApplicationLoader
+import org.telegram.messenger.FileLog
+import org.telegram.messenger.R
+import org.telegram.tgnet.TLObject
+import java.lang.reflect.Field
+import java.lang.reflect.Modifier
+import java.lang.reflect.ParameterizedType
+
+/**
+ * The TL layer the app speaks, read from the generated TLRPC classes: the console builds a real
+ * generated request class here, so the stock serializer and parser do the actual work.
+ */
+object TeleTl {
+
+    class Method(@JvmField val name: String, @JvmField val display: String, @JvmField val fqn: String, @JvmField val ctor: Long)
+
+    private class Info(
+        @JvmField val display: String,
+        @JvmField val fqn: String,
+        @JvmField val parent: String,
+        @JvmField val ctor: Long,
+        @JvmField val method: Boolean,
+        @JvmField val optional: Map<String, Int>
+    )
+
+    private val byName = HashMap<String, Info>()
+    private val byFqn = HashMap<String, String>()
+    private val byMethod = LinkedHashMap<String, Method>()
+    private val byParent = HashMap<String, MutableList<String>>()
+    private var layerValue = 0
+
+    @Volatile
+    private var loaded = false
+
+    @JvmStatic
+    fun isLoaded(): Boolean = loaded
+
+    // 3064 classes are a big parse, so it happens once, off the main thread
+    @JvmStatic
+    fun preload() {
+        ensureLoaded()
+    }
+
+    @Synchronized
+    private fun ensureLoaded() {
+        if (loaded) return
+        try {
+            val text = ApplicationLoader.applicationContext.resources.openRawResource(R.raw.tele_tl_index)
+                .bufferedReader().use { it.readText() }
+            val root = org.json.JSONObject(text)
+            layerValue = root.optInt("layer")
+            val classes = root.optJSONArray("classes") ?: return
+            for (i in 0 until classes.length()) {
+                val item = classes.optJSONObject(i) ?: continue
+                val display = item.optString("c")
+                if (display.isEmpty()) continue
+                val optional = HashMap<String, Int>()
+                item.optJSONObject("o")?.let { map ->
+                    for (name in map.keys()) optional[name] = map.optInt(name)
+                }
+                val info = Info(display, item.optString("f"), item.optString("p"), item.optLong("id"), item.optInt("m") == 1, optional)
+                byName[display] = info
+                byFqn[info.fqn] = display
+                byParent.getOrPut(info.parent) { ArrayList() }.add(display)
+                if (info.method) {
+                    val name = methodOf(display)
+                    if (name.isNotEmpty()) byMethod[name] = Method(name, display, info.fqn, info.ctor)
+                }
+            }
+        } catch (e: Throwable) {
+            FileLog.e(e)
+        } finally {
+            loaded = true
+        }
+    }
+
+    /** `TL_messages_deleteMessages` and `TL_account.deleteAccount` both read as `namespace.method`. */
+    private fun methodOf(display: String): String {
+        if (display.contains('.')) {
+            val namespace = display.substringBefore('.').removePrefix("TL_")
+            val rest = display.substringAfter('.')
+            // some subpackages keep the TL namespace in the class name, like payments_getStarsStatus
+            val dot = rest.indexOf('_')
+            return if (dot < 0) namespace + "." + rest
+            else namespace + "." + rest.substring(0, dot) + "." + rest.substring(dot + 1)
+        }
+        val base = if (display.startsWith("TL_")) display.substring(3) else display
+        val dot = base.indexOf('_')
+        return if (dot < 0) base else base.substring(0, dot) + "." + base.substring(dot + 1)
+    }
+
+    private fun camelOf(display: String): String {
+        val base = if (display.startsWith("TL_")) display.substring(3) else display
+        return base.substringAfter('.')
+    }
+
+    @JvmStatic
+    fun layer(): Int {
+        ensureLoaded()
+        return layerValue
+    }
+
+    @JvmStatic
+    fun methods(): List<Method> {
+        ensureLoaded()
+        return ArrayList(byMethod.values)
+    }
+
+    /** The TL name of the class, for the schema site. */
+    @JvmStatic
+    fun classNameFor(method: String): String? {
+        ensureLoaded()
+        return byMethod[method]?.display
+    }
+
+    @JvmStatic
+    fun constructorsOf(parent: String): List<String> {
+        ensureLoaded()
+        return ArrayList(byParent[parent].orEmpty())
+    }
+
+    /** Resolves a TL constructor name, either `TL_inputPeerSelf`, `inputPeerSelf` or a namespaced one. */
+    @JvmStatic
+    fun resolveClass(name: String): String? {
+        ensureLoaded()
+        if (byName.containsKey(name)) return name
+        if (byName.containsKey("TL_" + name)) return "TL_" + name
+        for (key in byName.keys) {
+            if (camelOf(key) == name) return key
+        }
+        for (key in byName.keys) {
+            if (key.endsWith("." + name)) return key
+        }
+        return null
+    }
+
+    /** The fields the serializer writes only with a flags bit, like the desktop's `flags.N?type`. */
+    @JvmStatic
+    fun isOptional(display: String?, field: String): Boolean {
+        ensureLoaded()
+        val info = byName[display ?: return false] ?: return false
+        return info.optional.containsKey(field)
+    }
+
+    @JvmStatic
+    fun optionalFields(display: String?): Map<String, Int> {
+        ensureLoaded()
+        return byName[display ?: return emptyMap()]?.optional ?: emptyMap()
+    }
+
+    /** The TL name of a generated class, for the inspector rows and the danger list. */
+    @JvmStatic
+    fun nameOfClass(fqn: String): String? {
+        ensureLoaded()
+        val display = byFqn[fqn] ?: return null
+        return methodOf(display)
+    }
+
+    /** Never touches the disk: the capture path runs on request threads. */
+    @JvmStatic
+    fun nameOfClassIfLoaded(fqn: String): String? {
+        if (!loaded) return null
+        val display = byFqn[fqn] ?: return null
+        return methodOf(display)
+    }
+
+    @JvmStatic
+    fun fqnOf(display: String?): String? {
+        ensureLoaded()
+        return byName[display]?.fqn
+    }
+
+    @JvmStatic
+    fun newInstance(fqn: String): TLObject? = try {
+        Class.forName(fqn).getDeclaredConstructor().newInstance() as? TLObject
+    } catch (e: Throwable) {
+        null
+    }
+
+    @JvmStatic
+    fun fields(clazz: Class<*>): MutableList<Field> {
+        val result = ArrayList<Field>()
+        for (field in clazz.fields) {
+            if (Modifier.isStatic(field.modifiers) || field.isSynthetic) continue
+            // flags and the transport fields are set by the stock code, not by the console
+            if (field.name == "flags" || field.name == "constructor" || field.name == "networkType" || field.name == "disableFree") continue
+            result.add(field)
+        }
+        return result
+    }
+
+    @JvmStatic
+    fun typeLabel(field: Field): String {
+        val type = field.type
+        if (type == Int::class.javaPrimitiveType || type == Integer::class.java) return "int"
+        if (type == Long::class.javaPrimitiveType || type == java.lang.Long::class.java) return "long"
+        if (type == Boolean::class.javaPrimitiveType || type == java.lang.Boolean::class.java) return "bool"
+        if (type == Double::class.javaPrimitiveType || type == java.lang.Double::class.java) return "double"
+        if (type == Float::class.javaPrimitiveType || type == java.lang.Float::class.java) return "float"
+        if (type == String::class.java) return "string"
+        if (type == ByteArray::class.java) return "bytes"
+        if (List::class.java.isAssignableFrom(type)) {
+            val argument = genericArgument(field)
+            return "vector<" + labelOf(argument) + ">"
+        }
+        return labelOf(type)
+    }
+
+    private fun labelOf(type: Class<*>?): String {
+        if (type == null) return "?"
+        if (type == Int::class.javaPrimitiveType || type == Integer::class.java) return "int"
+        if (type == Long::class.javaPrimitiveType || type == java.lang.Long::class.java) return "long"
+        if (type == String::class.java) return "string"
+        if (type == ByteArray::class.java) return "bytes"
+        if (type == Boolean::class.javaPrimitiveType || type == java.lang.Boolean::class.java) return "bool"
+        val name = type.simpleName
+        return if (name.startsWith("TL_")) camelOf(name) else name
+    }
+
+    private fun genericArgument(field: Field): Class<*>? {
+        val generic = field.genericType as? ParameterizedType ?: return null
+        return generic.actualTypeArguments.firstOrNull() as? Class<*>
+    }
+
+    /** Also finds the fields a class inherits, so `inputPeerUser.user_id` works from the parent view. */
+    @JvmStatic
+    fun fieldByName(clazz: Class<*>, name: String): Field? {
+        var type: Class<*>? = clazz
+        while (type != null) {
+            for (field in fields(type)) if (field.name == name) return field
+            type = type.superclass
+        }
+        return null
+    }
+
+    /**
+     * Puts the typed text into the field. Returns null on success or a short message for the form.
+     * Never throws: an unknown constructor or a malformed number is a user error, not a crash.
+     */
+    @JvmStatic
+    fun set(target: Any, field: Field, text: String?): String? {
+        val value = text.orEmpty().trim()
+        return try {
+            val type = field.type
+            when {
+                type == Int::class.javaPrimitiveType || type == Integer::class.java -> {
+                    if (value.isEmpty()) return null
+                    field.setInt(target, number(value)?.toInt() ?: return "expected a number")
+                    null
+                }
+                type == Long::class.javaPrimitiveType || type == java.lang.Long::class.java -> {
+                    if (value.isEmpty()) return null
+                    field.setLong(target, number(value) ?: return "expected a number")
+                    null
+                }
+                type == Boolean::class.javaPrimitiveType || type == java.lang.Boolean::class.java -> {
+                    if (value.isEmpty()) return null
+                    val bool = when (value.lowercase()) {
+                        "true", "1", "yes" -> true
+                        "false", "0", "no" -> false
+                        else -> return "expected true or false"
+                    }
+                    field.setBoolean(target, bool)
+                    null
+                }
+                type == Double::class.javaPrimitiveType || type == java.lang.Double::class.java -> {
+                    if (value.isEmpty()) return null
+                    field.setDouble(target, value.toDoubleOrNull() ?: return "expected a number")
+                    null
+                }
+                type == Float::class.javaPrimitiveType || type == java.lang.Float::class.java -> {
+                    if (value.isEmpty()) return null
+                    field.setFloat(target, value.toFloatOrNull() ?: return "expected a number")
+                    null
+                }
+                type == String::class.java -> {
+                    field.set(target, if (value.isEmpty()) null else value)
+                    null
+                }
+                type == ByteArray::class.java -> {
+                    if (value.isEmpty()) return null
+                    field.set(target, bytes(value) ?: return "expected hex bytes")
+                    null
+                }
+                List::class.java.isAssignableFrom(type) -> {
+                    if (value.isEmpty()) return null
+                    val argument = genericArgument(field) ?: Any::class.java
+                    val list = ArrayList<Any?>()
+                    for (part in value.split(',')) {
+                        val item = part.trim()
+                        if (item.isEmpty()) continue
+                        list.add(vectorItem(argument, item) ?: return "bad item: $item")
+                    }
+                    field.set(target, list)
+                    null
+                }
+                TLObject::class.java.isAssignableFrom(type) -> {
+                    if (value.isEmpty()) return null
+                    field.set(target, nested(value) ?: return "unknown constructor")
+                    null
+                }
+                else -> "unsupported type"
+            }
+        } catch (e: Throwable) {
+            FileLog.e(e)
+            "could not set the value"
+        }
+    }
+
+    private fun vectorItem(type: Class<*>, item: String): Any? = when {
+        type == Int::class.javaPrimitiveType || type == Integer::class.java -> number(item)?.toInt()
+        type == Long::class.javaPrimitiveType || type == java.lang.Long::class.java -> number(item)
+        type == String::class.java -> item
+        type == ByteArray::class.java -> bytes(item)
+        TLObject::class.java.isAssignableFrom(type) -> nested(item)
+        else -> null
+    }
+
+    private fun number(text: String): Long? {
+        val value = text.trim()
+        return if (value.startsWith("0x") || value.startsWith("-0x")) {
+            value.replaceFirst("0x", "").toLongOrNull(16)?.let { if (value.startsWith("-")) -it else it }
+        } else {
+            value.toLongOrNull()
+        }
+    }
+
+    private fun bytes(text: String): ByteArray? {
+        val clean = text.replace(" ", "").replace("0x", "").replace(":","")
+        if (clean.length % 2 != 0) return null
+        val result = ByteArray(clean.length / 2)
+        for (i in result.indices) {
+            val byte = clean.substring(i * 2, i * 2 + 2).toIntOrNull(16) ?: return null
+            result[i] = byte.toByte()
+        }
+        return result
+    }
+
+    /** `inputPeerUser{user_id=1;access_hash=2}` or a bare `inputPeerSelf`. */
+    @JvmStatic
+    fun nested(text: String): TLObject? {
+        val trimmed = text.trim()
+        val brace = trimmed.indexOf('{')
+        val name = if (brace < 0) trimmed else trimmed.substring(0, brace).trim()
+        val className = resolveClass(name) ?: return null
+        val object1 = newInstance(className) ?: return null
+        if (brace < 0) return object1
+        val body = trimmed.substring(brace + 1).trim().removeSuffix("}")
+        for (pair in body.split(';')) {
+            val part = pair.trim()
+            if (part.isEmpty()) continue
+            val eq = part.indexOf('=')
+            if (eq < 0) continue
+            val fieldName = part.substring(0, eq).trim()
+            val fieldValue = part.substring(eq + 1).trim()
+            val field = fieldByName(object1.javaClass, fieldName) ?: continue
+            set(object1, field, fieldValue)
+        }
+        return object1
+    }
+
+    /** The constructor of a value, for the argument summary. */
+    @JvmStatic
+    fun constructorOf(value: Any?): String = when (value) {
+        null -> "null"
+        is TLObject -> camelOf(value.javaClass.simpleName)
+        else -> value.toString()
+    }
+}
