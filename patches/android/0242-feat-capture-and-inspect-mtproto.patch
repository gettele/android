+            badge.text = label
+            badge.setTextColor(color)
+            badge.background = Theme.createRoundRectDrawable(AndroidUtilities.dp(4f), Theme.multAlpha(color, 0.16f))
+            title.text = entry.method
+            meta.text = timeFormat.format(Date(entry.timeMillis)) + "  dc " + entry.dc + "  " + entry.size + " B"
+            val body = entry.errorText.ifEmpty { entry.json }
+            text.text = body
+            text.setTextColor(
+                Theme.getColor(
+                    if (entry.errorText.isNotEmpty()) Theme.key_text_RedRegular else Theme.key_windowBackgroundWhiteGrayText2,
+                    resourceProvider
+                )
+            )
+        }
+    }
+
+    companion object {
+        private const val MENU_CLEAR = 9712
+    }
+}
diff --git a/TMessagesProj/src/main/java/tele/ui/TeleMtpDetailActivity.kt b/TMessagesProj/src/main/java/tele/ui/TeleMtpDetailActivity.kt
new file mode 100644
index 000000000..29fce58a2
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/ui/TeleMtpDetailActivity.kt
@@ -0,0 +1,406 @@
+package tele.ui
+
+import android.content.Context
+import android.content.Intent
+import android.net.Uri
+import android.os.Bundle
+import android.text.SpannableStringBuilder
+import android.text.Spanned
+import android.text.TextPaint
+import android.text.method.LinkMovementMethod
+import android.text.style.ClickableSpan
+import android.text.style.ForegroundColorSpan
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.View
+import android.widget.FrameLayout
+import android.widget.LinearLayout
+import android.widget.ScrollView
+import android.widget.TextView
+import org.json.JSONArray
+import org.json.JSONObject
+import org.json.JSONTokener
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.R
+import org.telegram.messenger.UserConfig
+import org.telegram.ui.ActionBar.ActionBar
+import org.telegram.ui.ActionBar.BaseFragment
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Components.LayoutHelper
+import tele.helpers.TeleCopies
+import tele.helpers.TeleLowercase.lc
+import tele.helpers.TeleMtp
+import tele.helpers.TeleTl
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+
+/** One captured entry, laid out like the desktop inspector: the header, the meta and the json tree. */
+class TeleMtpDetailActivity : BaseFragment() {
+
+    private val account get() = arguments?.getInt(ARG_ACCOUNT, UserConfig.selectedAccount) ?: UserConfig.selectedAccount
+    private val entryId get() = arguments?.getLong(ARG_ID) ?: 0L
+    private var treeView: TextView? = null
+    private var root: Node? = null
+    private var entry: TeleMtp.Entry? = null
+    private val timeFormat = SimpleDateFormat("HH:mm:ss.SSS", Locale.US)
+
+    private class Node(
+        @JvmField val key: String?,
+        @JvmField val kind: Int,
+        @JvmField val text: String?,
+        @JvmField val children: MutableList<Node> = ArrayList()
+    ) {
+        @JvmField var expanded = true
+    }
+
+    override fun createView(context: Context): View {
+        entry = TeleMtp.entry(account, entryId)
+        actionBar.setBackButtonImage(R.drawable.ic_ab_back)
+        actionBar.setAllowOverlayTitle(true)
+        actionBar.setTitle(entry?.method ?: lc("entry expired"))
+        actionBar.setActionBarMenuOnItemClick(object : ActionBar.ActionBarMenuOnItemClick() {
+            override fun onItemClick(id: Int) {
+                if (id == -1) finishFragment()
+            }
+        })
+        val scroll = ScrollView(context)
+        val column = LinearLayout(context)
+        column.orientation = LinearLayout.VERTICAL
+        column.setPadding(AndroidUtilities.dp(16f), AndroidUtilities.dp(12f), AndroidUtilities.dp(16f), AndroidUtilities.dp(24f))
+        scroll.addView(column, FrameLayout.LayoutParams(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT))
+
+        val item = entry
+        if (item == null) {
+            val gone = TextView(context)
+            gone.text = lc("This entry is gone.")
+            gone.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText, resourceProvider))
+            column.addView(gone)
+            fragmentView = scroll
+            return scroll
+        }
+
+        // the badge, the constructor and the right side meta, like the desktop entry header
+        val header = LinearLayout(context)
+        header.orientation = LinearLayout.HORIZONTAL
+        header.gravity = Gravity.CENTER_VERTICAL
+        header.addView(badge(context, item.direction), LayoutHelper.createLinear(LayoutHelper.WRAP_CONTENT, LayoutHelper.WRAP_CONTENT))
+        val name = TextView(context)
+        name.text = item.method
+        name.typeface = android.graphics.Typeface.MONOSPACE
+        name.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15f)
+        name.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText, resourceProvider))
+        name.maxLines = 1
+        name.ellipsize = android.text.TextUtils.TruncateAt.END
+        name.setPadding(AndroidUtilities.dp(8f), 0, 0, 0)
+        header.addView(name, LayoutHelper.createLinear(0, LayoutHelper.WRAP_CONTENT, 1f))
+        val meta = TextView(context)
+        meta.typeface = android.graphics.Typeface.MONOSPACE
+        meta.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 11f)
+        meta.gravity = Gravity.END
+        meta.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText, resourceProvider))
+        meta.text = timeFormat.format(Date(item.timeMillis)) + "  dc " + item.dc + "  " + item.size + " B"
+        header.addView(meta, LayoutHelper.createLinear(LayoutHelper.WRAP_CONTENT, LayoutHelper.WRAP_CONTENT))
+        column.addView(header, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT))
+
+        val pairs = ArrayList<Pair<String, String>>()
+        pairs.add("msg_id" to item.messageId.toString())
+        pairs.add("connection" to ("dc " + item.dc))
+        if (item.direction == 1) pairs.add("duration" to (item.durationMs.toString() + " ms"))
+        pairs.add("entry" to item.id.toString())
+        pairs.add("direction" to when (item.direction) {
+            0 -> "send"
+            1 -> "recv"
+            else -> "other"
+        })
+        for ((key, value) in pairs) column.addView(metaLine(context, key, value))
+
+        column.addView(divider(context))
+
+        val buttons = LinearLayout(context)
+        buttons.orientation = LinearLayout.HORIZONTAL
+        buttons.gravity = Gravity.CENTER_VERTICAL
+        buttons.addView(button(context, lc("Copy entry")) { copyEntry() }, LayoutHelper.createLinear(LayoutHelper.WRAP_CONTENT, LayoutHelper.WRAP_CONTENT, 0f, 0f, 8f, 0f))
+        buttons.addView(button(context, lc("Copy JSON")) { copyJson() }, LayoutHelper.createLinear(LayoutHelper.WRAP_CONTENT, LayoutHelper.WRAP_CONTENT, 0f, 0f, 8f, 0f))
+        buttons.addView(button(context, lc("Schema")) { openSchema(item.method) }, LayoutHelper.createLinear(LayoutHelper.WRAP_CONTENT, LayoutHelper.WRAP_CONTENT))
+        column.addView(buttons, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT, 0f, 8f, 0f, 0f))
+
+        val expandRow = LinearLayout(context)
+        expandRow.orientation = LinearLayout.HORIZONTAL
+        expandRow.addView(button(context, lc("Expand all")) {
+            applyAll(true)
+        }, LayoutHelper.createLinear(LayoutHelper.WRAP_CONTENT, LayoutHelper.WRAP_CONTENT, 0f, 0f, 8f, 0f))
+        expandRow.addView(button(context, lc("Collapse all")) { applyAll(false) }, LayoutHelper.createLinear(LayoutHelper.WRAP_CONTENT, LayoutHelper.WRAP_CONTENT))
+        column.addView(expandRow, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT, 0f, 8f, 0f, 8f))
+
+        if (item.errorText.isNotEmpty()) {
+            val error = TextView(context)
+            error.text = item.errorText
+            error.typeface = android.graphics.Typeface.MONOSPACE
+            error.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12f)
+            error.setTextColor(Theme.getColor(Theme.key_text_RedRegular, resourceProvider))
+            column.addView(error, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT, 0f, 4f, 0f, 4f))
+        }
+
+        root = parse(item.json)
+        val tree = TextView(context)
+        tree.typeface = android.graphics.Typeface.MONOSPACE
+        tree.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12f)
+        tree.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText, resourceProvider))
+        tree.movementMethod = LinkMovementMethod.getInstance()
+        tree.setTextIsSelectable(false)
+        treeView = tree
+        if (root == null && item.json.isNotEmpty()) {
+            // a body that is not json (a cut entry from an older build) still shows as text
+            tree.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGreenText, resourceProvider))
+            tree.text = item.json
+        } else {
+            render()
+        }
+        column.addView(tree, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT))
+        fragmentView = scroll
+        return scroll
+    }
+
+    private fun badge(context: Context, direction: Int): TextView {
+        val color = when (direction) {
+            0 -> Theme.getColor(Theme.key_windowBackgroundWhiteBlueText, resourceProvider)
+            1 -> Theme.getColor(Theme.key_windowBackgroundWhiteGreenText, resourceProvider)
+            else -> Theme.getColor(Theme.key_windowBackgroundWhiteGrayText, resourceProvider)
+        }
+        val view = TextView(context)
+        view.text = when (direction) {
+            0 -> "send"
+            1 -> "recv"
+            else -> "other"
+        }
+        view.typeface = android.graphics.Typeface.MONOSPACE
+        view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 11f)
+        view.setTextColor(color)
+        view.setPadding(AndroidUtilities.dp(6f), AndroidUtilities.dp(2f), AndroidUtilities.dp(6f), AndroidUtilities.dp(2f))
+        view.background = Theme.createRoundRectDrawable(AndroidUtilities.dp(4f), Theme.multAlpha(color, 0.16f))
+        return view
+    }
+
+    private fun metaLine(context: Context, key: String, value: String): TextView {
+        val view = TextView(context)
+        view.typeface = android.graphics.Typeface.MONOSPACE
+        view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12f)
+        val text = SpannableStringBuilder()
+        val start = text.length
+        text.append(key.padEnd(12))
+        text.setSpan(
+            ForegroundColorSpan(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText, resourceProvider)),
+            start, text.length, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE
+        )
+        text.append(value)
+        view.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText, resourceProvider))
+        view.text = text
+        view.setPadding(0, AndroidUtilities.dp(3f), 0, 0)
+        return view
+    }
+
+    private fun divider(context: Context): View {
+        val container = FrameLayout(context)
+        val line = View(context)
+        line.setBackgroundColor(Theme.getColor(Theme.key_divider, resourceProvider))
+        container.addView(line, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, 1f, Gravity.CENTER_VERTICAL, 0f, 10f, 0f, 10f))
+        return container
+    }
+
+    private fun button(context: Context, text: String, onClick: () -> Unit): TextView {
+        val view = TextView(context)
+        view.text = text
+        view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13f)
+        view.typeface = android.graphics.Typeface.MONOSPACE
+        view.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlueText, resourceProvider))
+        view.setPadding(AndroidUtilities.dp(10f), AndroidUtilities.dp(6f), AndroidUtilities.dp(10f), AndroidUtilities.dp(6f))
+        view.background = Theme.createRoundRectDrawable(
+            AndroidUtilities.dp(6f),
+            Theme.getColor(Theme.key_windowBackgroundGray, resourceProvider)
+        )
+        view.setOnClickListener { onClick() }
+        return view
+    }
+
+    private fun applyAll(expanded: Boolean) {
+        val root = root ?: return
+        fun walk(node: Node) {
+            node.expanded = expanded
+            for (child in node.children) walk(child)
+        }
+        walk(root)
+        render()
+    }
+
+    private fun copyEntry() {
+        val item = entry ?: return
+        val text = buildString {
+            appendLine(item.method)
+            appendLine(timeFormat.format(Date(item.timeMillis)) + " dc " + item.dc + " " + item.size + " B")
+            if (item.errorText.isNotEmpty()) appendLine(item.errorText)
+            appendLine(item.json)
+        }
+        if (AndroidUtilities.addToClipboard(text)) TeleCopies.log(account, lc("MTProto entry"), text)
+    }
+
+    private fun copyJson() {
+        val item = entry ?: return
+        val text = item.json.ifEmpty { item.errorText }
+        if (text.isNotEmpty() && AndroidUtilities.addToClipboard(text)) TeleCopies.log(account, lc("MTProto JSON"), text)
+    }
+
+    private fun openSchema(method: String) {
+        val activity = parentActivity ?: return
+        val url = "https://schema.jppgr.am/constructor/" + Uri.encode(TeleTl.classNameFor(method) ?: method)
+        try {
+            activity.startActivity(Intent(Intent.ACTION_VIEW, Uri.parse(url)))
+        } catch (e: Throwable) {
+            // no browser installed
+        }
+    }
+
+    private fun color(key: Int): Int = Theme.getColor(key, resourceProvider)
+
+    private fun render() {
+        val view = treeView ?: return
+        val root = root ?: run {
+            view.text = ""
+            return
+        }
+        val text = SpannableStringBuilder()
+        if (root.kind == OBJ || root.kind == ARR) {
+            container(text, root, 0)
+        } else {
+            scalar(text, root.text, root.kind)
+        }
+        view.text = text
+    }
+
+    private fun container(text: SpannableStringBuilder, node: Node, depth: Int) {
+        val isObject = node.kind == OBJ
+        if (node.children.isEmpty()) {
+            punctuation(text, if (isObject) "{}" else "[]")
+            return
+        }
+        val start = text.length
+        text.append(if (node.expanded) "▾ " else "▸ ")
+        text.setSpan(object : ClickableSpan() {
+            override fun onClick(widget: View) {
+                node.expanded = !node.expanded
+                render()
+            }
+
+            override fun updateDrawState(ds: TextPaint) {
+                ds.color = color(Theme.key_windowBackgroundWhiteBlueText)
+                ds.isUnderlineText = false
+            }
+        }, start, text.length, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
+        punctuation(text, if (isObject) "{" else "[")
+        if (!node.expanded) {
+            text.append(' ')
+            punctuation(text, "…")
+            text.append(' ')
+            punctuation(text, if (isObject) "}" else "]")
+            return
+        }
+        if (!isObject) {
+            val count = node.children.size
+            text.append(' ')
+            gray(text, "(" + count + " " + (if (count == 1) "item" else "items") + ")")
+        }
+        for (child in node.children) {
+            text.append('\n')
+            repeat(depth + 1) { text.append("  ") }
+            if (isObject) {
+                string(text, child.key.orEmpty())
+                punctuation(text, ": ")
+            }
+            when (child.kind) {
+                OBJ, ARR -> container(text, child, depth + 1)
+                else -> {
+                    scalar(text, child.text, child.kind)
+                    if (child.kind == INT || child.kind == LONG) {
+                        text.append(' ')
+                        gray(text, if (child.kind == INT) "(int)" else "(long)")
+                    }
+                }
+            }
+            if (child !== node.children.last()) punctuation(text, ",")
+        }
+        text.append('\n')
+        repeat(depth) { text.append("  ") }
+        punctuation(text, if (isObject) "}" else "]")
+    }
+
+    private fun scalar(text: SpannableStringBuilder, value: String?, kind: Int) {
+        when (kind) {
+            STR -> string(text, value.orEmpty())
+            INT, LONG -> number(text, value.orEmpty())
+            BOOL -> bool(text, value.orEmpty())
+            NULL -> nullText(text)
+            else -> text.append(value.orEmpty())
+        }
+    }
+
+    private fun string(text: SpannableStringBuilder, value: String) = span(text, "\"" + value + "\"", Theme.key_windowBackgroundWhiteGreenText)
+
+    private fun number(text: SpannableStringBuilder, value: String) = span(text, value, Theme.key_statisticChartLine_orange)
+
+    private fun bool(text: SpannableStringBuilder, value: String) = span(text, value, Theme.key_statisticChartLine_purple)
+
+    private fun nullText(text: SpannableStringBuilder) = span(text, "null", Theme.key_text_RedRegular)
+
+    private fun punctuation(text: SpannableStringBuilder, value: String) = span(text, value, Theme.key_windowBackgroundWhiteGrayText)
+
+    private fun gray(text: SpannableStringBuilder, value: String) = span(text, value, Theme.key_windowBackgroundWhiteGrayText)
+
+    private fun span(text: SpannableStringBuilder, value: String, key: Int) {
+        val start = text.length
+        text.append(value)
+        text.setSpan(ForegroundColorSpan(color(key)), start, text.length, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
+    }
+
+    private fun parse(json: String): Node? = try {
+        if (json.isEmpty()) null else convert(JSONTokener(json).nextValue(), null)
+    } catch (e: Throwable) {
+        null
+    }
+
+    private fun convert(value: Any?, key: String?): Node? = when (value) {
+        null, JSONObject.NULL -> Node(key, NULL, "null")
+        is JSONObject -> Node(key, OBJ, null).also { node ->
+            for (name in value.keys()) node.children.add(convert(value.opt(name), name) ?: Node(name, NULL, "null"))
+        }
+        is JSONArray -> Node(key, ARR, null).also { node ->
+            for (i in 0 until value.length()) node.children.add(convert(value.opt(i), null) ?: Node(null, NULL, "null"))
+        }
+        is String -> Node(key, STR, value)
+        is Boolean -> Node(key, BOOL, value.toString())
+        is Int -> Node(key, INT, value.toString())
+        is Long -> Node(key, if (value > Int.MAX_VALUE || value < Int.MIN_VALUE) LONG else INT, value.toString())
+        is Double, is Float -> Node(key, DOUBLE, value.toString())
+        else -> Node(key, STR, value.toString())
+    }
+
+    companion object {
+        private const val ARG_ACCOUNT = "account"
+        private const val ARG_ID = "id"
+        private const val OBJ = 0
+        private const val ARR = 1
+        private const val STR = 2
+        private const val INT = 3
+        private const val LONG = 4
+        private const val BOOL = 5
+        private const val NULL = 6
+        private const val DOUBLE = 7
+
+        @JvmStatic
+        fun of(account: Int, id: Long): TeleMtpDetailActivity = TeleMtpDetailActivity().apply {
+            arguments = Bundle().apply {
+                putInt(ARG_ACCOUNT, account)
+                putLong(ARG_ID, id)
+            }
+        }
+    }
+}
