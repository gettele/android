From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Fri, 6 Nov 2026 21:35:41 +0300
Subject: [PATCH] fix: keep docked spoilers after leaving the media editor

---
 TMessagesProj/src/main/java/tele/helpers/DockedMedia.kt | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/TMessagesProj/src/main/java/tele/helpers/DockedMedia.kt b/TMessagesProj/src/main/java/tele/helpers/DockedMedia.kt
index 321343f74..80139d155 100644
--- a/TMessagesProj/src/main/java/tele/helpers/DockedMedia.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/DockedMedia.kt
@@ -494,7 +494,12 @@ object DockedMedia {
 
     private fun entryOf(item: Item, index: Int): MediaController.PhotoEntry {
         val source = item.source
-        if (source != null) return source.clone()
+        if (source != null) {
+            val entry = source.clone()
+            // the dock can toggle the spoiler after the source entry was captured
+            entry.hasSpoiler = item.spoiler
+            return entry
+        }
         val path = item.path ?: item.sendPath()
         val entry = MediaController.PhotoEntry(0, if (item.imageId != 0) item.imageId else -(index + 1), 0, path, if (item.isVideo) item.duration else item.orientation, item.isVideo, item.width, item.height, item.size)
         if (!item.isVideo && item.imagePath != null && item.imagePath != path) entry.imagePath = item.imagePath
