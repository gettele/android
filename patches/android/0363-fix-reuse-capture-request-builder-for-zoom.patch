From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: test <test@example.com>
Date: Fri, 20 Nov 2026 02:03:28 +0300
Subject: [PATCH] fix: reuse capture request builder for zoom

The round-video camera recreated the whole CaptureRequest.Builder on every zoom frame. Reuse it and update only the zoom and torch, like the stock Camera2Session does. This removes the preview lag and frame freeze some devices showed when zooming while recording.
---
 .../recorder/round/RoundVideoCameraController.java    | 11 ++++++++++-
 1 file changed, 10 insertions(+), 1 deletion(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/utils/recorder/round/RoundVideoCameraController.java b/TMessagesProj/src/main/java/org/telegram/utils/recorder/round/RoundVideoCameraController.java
index 9874a79a1..b49f0c794 100644
--- a/TMessagesProj/src/main/java/org/telegram/utils/recorder/round/RoundVideoCameraController.java
+++ b/TMessagesProj/src/main/java/org/telegram/utils/recorder/round/RoundVideoCameraController.java
@@ -1720,7 +1720,16 @@ final class RoundVideoCameraController {
         CameraCaptureSession session = captureSession;
         if (!active || session == null || cameraDevice == null) return;
         try {
-            repeatingBuilder = createRepeatingRequestBuilder(false);
+            if (repeatingBuilder != null) {
+                // zoom-only update: reuse the builder, just like the stock Camera2Session does
+                applyZoom(repeatingBuilder);
+                applyTorch(repeatingBuilder);
+                requestGeneration++;
+                repeatingBuilder.setTag(requestGeneration);
+                if (torchVerificationPending) torchVerificationGeneration = requestGeneration;
+            } else {
+                repeatingBuilder = createRepeatingRequestBuilder(false);
+            }
             submitRepeatingRequest();
         } catch (IllegalStateException e) {
             if (dualActiveMode) {
