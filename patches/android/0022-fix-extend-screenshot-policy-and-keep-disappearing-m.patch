From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Fri, 2 Oct 2026 13:29:18 +0300
Subject: [PATCH] fix: extend screenshot policy and keep disappearing media on
 view

---
 .../main/java/org/telegram/messenger/FlagSecureReason.java  | 6 ++++++
 .../java/org/telegram/messenger/MessagesController.java     | 3 +++
 .../src/main/java/org/telegram/ui/ChatActivity.java         | 6 ++++++
 .../src/main/java/org/telegram/ui/SecretMediaViewer.java    | 6 ++++++
 .../src/main/java/org/telegram/ui/SecretVoicePlayer.java    | 2 +-
 .../src/main/java/org/telegram/ui/Stories/StoryViewer.java  | 2 +-
 TMessagesProj/src/main/java/tele/TeleConfig.kt              | 2 ++
 .../src/main/java/tele/ui/settings/TeleSettingsActivity.kt  | 1 +
 8 files changed, 26 insertions(+), 2 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/FlagSecureReason.java b/TMessagesProj/src/main/java/org/telegram/messenger/FlagSecureReason.java
index 9b56bbf25..d4414b612 100644
--- a/TMessagesProj/src/main/java/org/telegram/messenger/FlagSecureReason.java
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/FlagSecureReason.java
@@ -64,6 +64,12 @@ public class FlagSecureReason {
             return;
         }
 
+        if (tele.TeleConfig.NEVER_BLOCK_SCREENSHOTS.getValue()) {
+            window.clearFlags(WindowManager.LayoutParams.FLAG_SECURE);
+            AndroidUtilities.logFlagSecure();
+            return;
+        }
+
         if (isSecuredNow(window)) {
             window.addFlags(WindowManager.LayoutParams.FLAG_SECURE);
             AndroidUtilities.logFlagSecure();
diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/MessagesController.java b/TMessagesProj/src/main/java/org/telegram/messenger/MessagesController.java
index 25f60c7ae..5f38c5b5d 100644
--- a/TMessagesProj/src/main/java/org/telegram/messenger/MessagesController.java
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/MessagesController.java
@@ -14409,6 +14409,9 @@ public class MessagesController extends BaseController implements NotificationCe
         if (messageObject.scheduled) {
             return;
         }
+        if (tele.TeleConfig.KEEP_DISAPPEARING_MEDIA.getValue() && tele.TeleHooks.isDisappearing(messageObject)) {
+            return;
+        }
         ArrayList<Integer> arrayList = new ArrayList<>();
         if (messageObject.messageOwner.mentioned) {
             getMessagesStorage().markMentionMessageAsRead(-messageObject.messageOwner.peer_id.channel_id, messageObject.getId(), messageObject.getDialogId());
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
index 77a68e3d8..d5a57dbbb 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
@@ -15568,6 +15568,9 @@ public class ChatActivity extends BaseFragment implements
         if (messageObject == null || messageObject.isOut() || !messageObject.isSecretMedia() || messageObject.messageOwner.destroyTime != 0 || messageObject.messageOwner.ttl <= 0) {
             return null;
         }
+        if (tele.TeleConfig.KEEP_DISAPPEARING_MEDIA.getValue() && tele.TeleHooks.isDisappearing(messageObject)) {
+            return null;
+        }
         if (readNow) {
             final boolean delete = messageObject.messageOwner.ttl != 0x7FFFFFFF;
             final int ttl = messageObject.messageOwner.ttl == 0x7FFFFFFF ? 0 : messageObject.messageOwner.ttl;
@@ -15597,6 +15600,9 @@ public class ChatActivity extends BaseFragment implements
         if (messageObject == null || messageObject.isOut() || !messageObject.isSecretMedia() || messageObject.messageOwner.ttl != 0x7FFFFFFF) {
             return null;
         }
+        if (tele.TeleConfig.KEEP_DISAPPEARING_MEDIA.getValue() && tele.TeleHooks.isDisappearing(messageObject)) {
+            return null;
+        }
         final long taskId = getMessagesController().createDeleteShowOnceTask(dialog_id, messageObject.getId());
         messageObject.forceExpired = true;
         if (messageObject.isOutOwner() || !messageObject.isRoundOnce() && !messageObject.isVoiceOnce()) {
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/SecretMediaViewer.java b/TMessagesProj/src/main/java/org/telegram/ui/SecretMediaViewer.java
index 635b933a9..1841d6bd1 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/SecretMediaViewer.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/SecretMediaViewer.java
@@ -1566,6 +1566,12 @@ public class SecretMediaViewer implements NotificationCenter.NotificationCenterD
         }
 
         WindowManager wm = (WindowManager) parentActivity.getSystemService(Context.WINDOW_SERVICE);
+        if (!tele.TeleConfig.NEVER_BLOCK_SCREENSHOTS.getValue() &&
+            !(tele.TeleConfig.ALLOW_SCREENSHOTS_DISAPPEARING.getValue() && tele.TeleHooks.isDisappearing(messageObject))) {
+            windowLayoutParams.flags |= WindowManager.LayoutParams.FLAG_SECURE;
+        } else {
+            windowLayoutParams.flags &=~ WindowManager.LayoutParams.FLAG_SECURE;
+        }
         wm.addView(windowView, windowLayoutParams);
         secretDeleteTimer.invalidate();
         isVisible = true;
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/SecretVoicePlayer.java b/TMessagesProj/src/main/java/org/telegram/ui/SecretVoicePlayer.java
index c43df6754..7e38be383 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/SecretVoicePlayer.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/SecretVoicePlayer.java
@@ -238,7 +238,7 @@ public class SecretVoicePlayer extends Dialog {
             WindowManager.LayoutParams.FLAG_LAYOUT_INSET_DECOR |
             WindowManager.LayoutParams.FLAG_DRAWS_SYSTEM_BAR_BACKGROUNDS |
             WindowManager.LayoutParams.FLAG_TRANSLUCENT_NAVIGATION;
-        if (!BuildVars.DEBUG_PRIVATE_VERSION) {
+        if (!BuildVars.DEBUG_PRIVATE_VERSION && !tele.TeleConfig.NEVER_BLOCK_SCREENSHOTS.getValue()) {
             params.flags |= WindowManager.LayoutParams.FLAG_SECURE;
             AndroidUtilities.logFlagSecure();
         }
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Stories/StoryViewer.java b/TMessagesProj/src/main/java/org/telegram/ui/Stories/StoryViewer.java
index 37f1386e0..1e327feb6 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Stories/StoryViewer.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Stories/StoryViewer.java
@@ -2877,7 +2877,7 @@ public class StoryViewer implements NotificationCenter.NotificationCenterDelegat
         if (BuildVars.DEBUG_PRIVATE_VERSION) {
             return;
         }
-        allowScreenshots = !isShowing || allowScreenshots;
+        allowScreenshots = tele.TeleConfig.NEVER_BLOCK_SCREENSHOTS.getValue() || !isShowing || allowScreenshots;
         if (this.allowScreenshots != allowScreenshots) {
             this.allowScreenshots = allowScreenshots;
 
diff --git a/TMessagesProj/src/main/java/tele/TeleConfig.kt b/TMessagesProj/src/main/java/tele/TeleConfig.kt
index 2653e9df1..4d3374206 100644
--- a/TMessagesProj/src/main/java/tele/TeleConfig.kt
+++ b/TMessagesProj/src/main/java/tele/TeleConfig.kt
@@ -78,6 +78,8 @@ object TeleConfig {
     val ALLOW_SCREENSHOTS_DISAPPEARING = BoolItem("allow_screenshots_disappearing", false)
     @JvmField
     val LOCAL_DRAFTS = BoolItem("local_drafts", false)
+    @JvmField
+    val KEEP_DISAPPEARING_MEDIA = BoolItem("keep_disappearing_media", false)
 
     private var prefs: SharedPreferences? = null
 
diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
index 949c94ae0..eece0289a 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
@@ -88,6 +88,7 @@ class TeleSettingsActivity : BaseFragment() {
             Row(TYPE_TOGGLE, "hide viewed receipts", item = TeleConfig.GHOST_CONTENTS_READ),
             Row(TYPE_TOGGLE, "never block screenshots", item = TeleConfig.NEVER_BLOCK_SCREENSHOTS),
             Row(TYPE_TOGGLE, "allow screenshots of disappearing media", item = TeleConfig.ALLOW_SCREENSHOTS_DISAPPEARING),
+            Row(TYPE_TOGGLE, "don't burn disappearing media on view", item = TeleConfig.KEEP_DISAPPEARING_MEDIA),
             Row(TYPE_TOGGLE, "keep drafts on this device", item = TeleConfig.LOCAL_DRAFTS)
         )
 
