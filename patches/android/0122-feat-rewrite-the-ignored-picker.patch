 /**
- * The picker of the privacy exceptions: a plain list of the chats with the checkmarks, the count
- * of the picked ones and a done button. The ignored list holds people and bots only.
+ * The picker of the privacy exceptions: the list of the chats like in the forward screen, with the
+ * avatars, the last message and the time, and a mark on the picked ones. The ignored list holds
+ * people and bots only.
  */
 class TelePeersActivity(private val account: Int, private val mode: String) : BaseFragment() {
 
     private val selected = HashSet<Long>()
     private var items: List<TLRPC.Dialog> = emptyList()
     private var counter: TextView? = null
+    private lateinit var screenContext: Context
 
     override fun createView(context: Context): View {
+        screenContext = context
         actionBar.setBackButtonImage(R.drawable.ic_ab_back)
+        actionBar.setAllowOverlayTitle(true)
         actionBar.setTitle(title())
+        actionBar.setActionBarMenuOnItemClick(object : ActionBar.ActionBarMenuOnItemClick() {
+            override fun onItemClick(id: Int) {
+                if (id == -1) finishFragment()
+            }
+        })
 
         val root = LinearLayout(context)
         root.orientation = LinearLayout.VERTICAL
@@ -117,7 +131,6 @@ class TelePeersActivity(private val account: Int, private val mode: String) : Ba
     private fun isUser(dialog: TLRPC.Dialog): Boolean {
         val peer = dialog.peer
         if (peer != null) {
-            // the peer of a person carries the user id, the peer of a chat or a channel does not
             return peer.user_id != 0L
         }
         val messagesController = AccountInstance.getInstance(account).getMessagesController()
@@ -146,7 +159,9 @@ class TelePeersActivity(private val account: Int, private val mode: String) : Ba
             }
         }
         for (did in picked) {
-            setMode(did, if (mode == MODE_IGNORE) PrivacyRules.MODE_HIDE else {
+            setMode(did, if (mode == MODE_IGNORE) {
+                if (TeleConfig.IGNORE_FADE.value) PrivacyRules.MODE_FADE else PrivacyRules.MODE_HIDE
+            } else {
                 if (mode == MODE_GHOST_NEVER) PrivacyRules.GHOST_NEVER else PrivacyRules.GHOST_ALWAYS
             })
         }
@@ -163,54 +178,99 @@ class TelePeersActivity(private val account: Int, private val mode: String) : Ba
     }
 
     private fun row(convertView: View?, dialog: TLRPC.Dialog): View {
-        val context = convertView?.context ?: parentActivity ?: return View(context)
+        val context = convertView?.context ?: screenContext
         val holder = convertView as? LinearLayout ?: LinearLayout(context).apply {
             orientation = LinearLayout.HORIZONTAL
             gravity = Gravity.CENTER_VERTICAL
             setPadding(
-                AndroidUtilities.dp(12f), AndroidUtilities.dp(6f),
-                AndroidUtilities.dp(12f), AndroidUtilities.dp(6f)
+                AndroidUtilities.dp(12f), AndroidUtilities.dp(5f),
+                AndroidUtilities.dp(12f), AndroidUtilities.dp(5f)
             )
+
+            val avatarBox = FrameLayout(context)
             val avatar = BackupImageView(context)
-            avatar.setRoundRadius(AndroidUtilities.dp(23f))
-            addView(avatar, LinearLayout.LayoutParams(AndroidUtilities.dp(46f), AndroidUtilities.dp(46f)))
+            avatar.setRoundRadius(AndroidUtilities.dp(24f))
+            avatarBox.addView(avatar, FrameLayout.LayoutParams(AndroidUtilities.dp(48f), AndroidUtilities.dp(48f)))
+            val mark = ImageView(context)
+            mark.setImageResource(R.drawable.msg_check_s)
+            mark.setColorFilter(android.graphics.Color.WHITE)
+            val markBox = FrameLayout(context)
+            markBox.background = circle(Theme.getColor(Theme.key_windowBackgroundWhiteBlueText))
+            markBox.setPadding(AndroidUtilities.dp(3f), AndroidUtilities.dp(3f), AndroidUtilities.dp(3f), AndroidUtilities.dp(3f))
+            markBox.addView(mark, FrameLayout.LayoutParams(-1, -1))
+            val markParams = FrameLayout.LayoutParams(AndroidUtilities.dp(20f), AndroidUtilities.dp(20f))
+            markParams.gravity = Gravity.BOTTOM or Gravity.END
+            avatarBox.addView(markBox, markParams)
+            addView(avatarBox, LinearLayout.LayoutParams(AndroidUtilities.dp(48f), AndroidUtilities.dp(48f)))
+
+            val texts = LinearLayout(context)
+            texts.orientation = LinearLayout.VERTICAL
+            texts.gravity = Gravity.CENTER_VERTICAL
             val name = TextView(context)
             name.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16f)
             name.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
             name.maxLines = 1
-            val nameParams = LinearLayout.LayoutParams(0, -2, 1f)
-            nameParams.leftMargin = AndroidUtilities.dp(12f)
-            addView(name, nameParams)
-            val check = ImageView(context)
-            check.setImageResource(R.drawable.msg_check_s)
-            check.setColorFilter(Theme.getColor(Theme.key_checkboxCheck))
-            addView(check, LinearLayout.LayoutParams(AndroidUtilities.dp(24f), AndroidUtilities.dp(24f)))
+            texts.addView(name, LinearLayout.LayoutParams(-1, -2))
+            val preview = TextView(context)
+            preview.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14f)
+            preview.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2))
+            preview.maxLines = 1
+            preview.ellipsize = android.text.TextUtils.TruncateAt.END
+            texts.addView(preview, LinearLayout.LayoutParams(-1, -2))
+            val textParams = LinearLayout.LayoutParams(0, -2, 1f)
+            textParams.leftMargin = AndroidUtilities.dp(12f)
+            addView(texts, textParams)
+
+            val time = TextView(context)
+            time.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13f)
+            time.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2))
+            time.gravity = Gravity.TOP
+            val timeParams = LinearLayout.LayoutParams(-2, -2)
+            timeParams.leftMargin = AndroidUtilities.dp(8f)
+            addView(time, timeParams)
         }
 
         val messagesController = AccountInstance.getInstance(account).getMessagesController()
         val user = messagesController.getUser(dialog.id)
         val chat: TLRPC.Chat? = messagesController.getChat(dialog.id)
-        val avatar = holder.getChildAt(0) as BackupImageView
-        val name = holder.getChildAt(1) as TextView
-        val check = holder.getChildAt(2) as ImageView
+        val avatarBox = holder.getChildAt(0) as FrameLayout
+        val avatar = avatarBox.getChildAt(0) as BackupImageView
+        val markBox = avatarBox.getChildAt(1) as FrameLayout
+        val texts = holder.getChildAt(1) as LinearLayout
+        val name = texts.getChildAt(0) as TextView
+        val preview = texts.getChildAt(1) as TextView
+        val time = holder.getChildAt(2) as TextView
 
         name.text = if (user != null) {
             UserObject.getFirstName(user)
         } else {
             chat?.title ?: ""
         }
-        check.visibility = if (selected.contains(dialog.id)) View.VISIBLE else View.INVISIBLE
+
+        val message = lastMessage(dialog)
+        if (message != null) {
+            val text = if (!message.messageTextShort.isNullOrEmpty()) message.messageTextShort else message.messageText
+            preview.text = text
+            preview.visibility = if (text.isNullOrEmpty()) View.GONE else View.VISIBLE
+            time.text = LocaleController.stringForMessageListDate(dialog.last_message_date.toLong())
+        } else {
+            preview.text = ""
+            preview.visibility = View.GONE
+            time.text = ""
+        }
+
+        markBox.visibility = if (selected.contains(dialog.id)) View.VISIBLE else View.INVISIBLE
 
         if (user != null) {
             val placeholder = AvatarDrawable()
-            placeholder.setTextSize(AndroidUtilities.dp(23f).toInt())
+            placeholder.setTextSize(AndroidUtilities.dp(24f).toInt())
             avatar.setImage(
                 ImageLocation.getForUser(account, user, ImageLocation.TYPE_SMALL),
                 "50_50", placeholder, user
             )
         } else if (chat != null) {
             val placeholder = AvatarDrawable()
-            placeholder.setTextSize(AndroidUtilities.dp(23f).toInt())
+            placeholder.setTextSize(AndroidUtilities.dp(24f).toInt())
             avatar.setImage(
                 ImageLocation.getForUserOrChat(account, chat, ImageLocation.TYPE_SMALL),
                 "50_50", placeholder, chat
@@ -221,6 +281,22 @@ class TelePeersActivity(private val account: Int, private val mode: String) : Ba
         return holder
     }
 
+    private fun lastMessage(dialog: TLRPC.Dialog): MessageObject? {
+        val messagesController = AccountInstance.getInstance(account).getMessagesController()
+        val messages = messagesController.dialogMessage?.get(dialog.id)
+        if (messages == null || messages.isEmpty()) {
+            return null
+        }
+        return messages[messages.size - 1]
+    }
+
+    private fun circle(color: Int): android.graphics.drawable.GradientDrawable {
+        val drawable = android.graphics.drawable.GradientDrawable()
+        drawable.setShape(android.graphics.drawable.GradientDrawable.OVAL)
+        drawable.setColor(color)
+        return drawable
+    }
+
     companion object {
         const val MODE_IGNORE = "ignore"
         const val MODE_GHOST_ALWAYS = "ghost_always"
