diff --git a/TMessagesProj/src/main/java/tele/helpers/InvisibleNames.kt b/TMessagesProj/src/main/java/tele/helpers/InvisibleNames.kt
new file mode 100644
index 000000000..f5cd17993
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/InvisibleNames.kt
@@ -0,0 +1,203 @@
+package tele.helpers
+
+import org.telegram.messenger.AccountInstance
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.ChatObject
+import org.telegram.messenger.FileLog
+import org.telegram.messenger.MessagesController
+import org.telegram.messenger.NotificationCenter
+import org.telegram.messenger.UserConfig
+import org.telegram.messenger.UserObject
+import org.telegram.tgnet.SerializedData
+import org.telegram.tgnet.TLRPC
+import tele.TeleConfig
+import tele.TeleHooks
+
+/**
+ * Desktop 0208: @username instead of invisible names.
+ * Replacements are display-only: chat titles are swapped in memory and put back before they reach the DB.
+ */
+object InvisibleNames {
+
+    private const val MAX_PHRASE = 64
+
+    private class Entry(val real: String, val shown: String)
+
+    // per account: chat id -> real and shown title of the chats whose title is blank
+    private val chats = Array(UserConfig.MAX_ACCOUNT_COUNT) { HashMap<Long, Entry>() }
+
+    // the exact set of the desktop table
+    @JvmStatic
+    fun isInvisibleChar(ch: Int): Boolean {
+        if (isSpace(ch)) return true
+        when (ch) {
+            0x00AD, 0x034F, 0x061C, 0x115F, 0x1160, 0x17B4, 0x17B5, 0x2800, 0x3164, 0xFEFF, 0xFFA0, 0x1D159 -> return true
+        }
+        return ch in 0x180B..0x180F ||
+            ch in 0x200B..0x200F ||
+            ch in 0x2028..0x202E ||
+            ch in 0x2060..0x2064 ||
+            ch in 0x2066..0x206F ||
+            ch in 0xFE00..0xFE0F ||
+            ch in 0x1D173..0x1D17A ||
+            ch in 0xE0000..0xE007F ||
+            ch in 0xE0100..0xE01EF
+    }
+
+    // QChar::isSpace: the Latin-1 whitespace plus the space, line and paragraph separators
+    private fun isSpace(ch: Int): Boolean {
+        if (ch in 0x09..0x0D || ch == 0x85) return true
+        val type = Character.getType(ch)
+        return type == Character.SPACE_SEPARATOR.toInt() ||
+            type == Character.LINE_SEPARATOR.toInt() ||
+            type == Character.PARAGRAPH_SEPARATOR.toInt()
+    }
+
+    /** Not empty and made only of invisible code points; broken surrogates are not invisible. */
+    @JvmStatic
+    fun isInvisibleText(text: CharSequence?): Boolean {
+        if (text.isNullOrEmpty()) return false
+        var i = 0
+        while (i < text.length) {
+            val ch = Character.codePointAt(text, i)
+            val size = Character.charCount(ch)
+            if (Character.isSurrogate(text[i]) && size == 1) return false
+            if (!isInvisibleChar(ch)) return false
+            i += size
+        }
+        return true
+    }
+
+    private fun isBlank(text: String?): Boolean = text.isNullOrEmpty() || isInvisibleText(text)
+
+    private fun phrase(): String {
+        val value = TeleConfig.INVISIBLE_NAMES_PHRASE.value.replace(Regex("\\s+"), " ").trim().take(MAX_PHRASE)
+        return value.ifEmpty { defaultPhrase() }
+    }
+
+    @JvmStatic
+    fun defaultPhrase(): String = TeleLowercase.lc("Unknown name")
+
+    private fun replacement(account: Int, username: String?, peerId: Long, chat: Boolean): String {
+        if (!username.isNullOrEmpty()) return "@$username"
+        if (TeleConfig.INVISIBLE_NAMES_FALLBACK.value == "id") {
+            val id = if (chat) PeerId.format(account, 0L, peerId) else PeerId.format(account, peerId, 0L)
+            return TeleLowercase.lc("ID $id")
+        }
+        return phrase()
+    }
+
+    /** The display name of a user whose whole name is blank, null for the stock name. */
+    @JvmStatic
+    fun user(user: TLRPC.User?): String? {
+        if (!TeleConfig.INVISIBLE_NAMES.value || user == null || UserObject.isUserSelf(user) || UserObject.isDeleted(user)) return null
+        val first = user.first_name
+        val last = user.last_name
+        if (!isBlank(first) || !isBlank(last)) return null
+        val username = UserObject.getPublicUsername(user)
+        // a completely empty name with a phone number keeps the stock phone
+        if (username.isNullOrEmpty() && first.isNullOrEmpty() && last.isNullOrEmpty() && !user.phone.isNullOrEmpty()) return null
+        return replacement(UserConfig.selectedAccount, username, user.id, false)
+    }
+
+    /** The short name: the visible part of the name when only one part is blank. */
+    @JvmStatic
+    fun shortUser(user: TLRPC.User?): String? {
+        if (!TeleConfig.INVISIBLE_NAMES.value || user == null || UserObject.isUserSelf(user) || UserObject.isDeleted(user)) return null
+        val first = user.first_name
+        val last = user.last_name
+        if (!isBlank(if (first.isNullOrEmpty()) last else first)) return null
+        if (!isBlank(last)) return last
+        return user(user)
+    }
+
+    /** Called from MessagesController.putChat: swaps a blank title for the display value in memory. */
+    @JvmStatic
+    fun applyChat(account: Int, chat: TLRPC.Chat?) {
+        chat ?: return
+        val title = chat.title ?: return
+        synchronized(chats[account]) {
+            val map = chats[account]
+            val entry = map[chat.id]
+            val real = if (entry != null && entry.shown.isNotEmpty() && title == entry.shown) entry.real else title
+            if (!isBlank(real)) {
+                map.remove(chat.id)
+                chat.title = real
+                return
+            }
+            val shown = if (TeleConfig.INVISIBLE_NAMES.value) replacement(account, ChatObject.getPublicUsername(chat), chat.id, true) else ""
+            map[chat.id] = Entry(real, shown)
+            chat.title = shown.ifEmpty { real }
+        }
+    }
+
+    /** The chats for the DB: copies with their real titles, the live objects stay as they are. */
+    @JvmStatic
+    fun stockChats(account: Int, list: List<TLRPC.Chat?>): List<TLRPC.Chat?> {
+        val map = chats[account]
+        var result: ArrayList<TLRPC.Chat?>? = null
+        for (i in list.indices) {
+            val chat = list[i] ?: continue
+            val real = synchronized(map) {
+                val entry = map[chat.id]
+                if (entry != null && entry.shown.isNotEmpty() && chat.title == entry.shown) entry.real else null
+            } ?: continue
+            val copy = copyOf(chat) ?: continue
+            copy.title = real
+            if (result == null) result = ArrayList(list)
+            result[i] = copy
+        }
+        return result ?: list
+    }
+
+    private fun copyOf(chat: TLRPC.Chat): TLRPC.Chat? {
+        val out = SerializedData(chat.objectSize)
+        return try {
+            chat.serializeToStream(out)
+            val input = SerializedData(out.toByteArray())
+            try {
+                TLRPC.Chat.TLdeserialize(input, input.readInt32(false), false)
+            } finally {
+                input.cleanup()
+            }
+        } catch (e: Exception) {
+            FileLog.e(e)
+            null
+        } finally {
+            out.cleanup()
+        }
+    }
+
+    @JvmStatic
+    fun isNameItem(item: tele.Item<*>): Boolean =
+        item === TeleConfig.INVISIBLE_NAMES || item === TeleConfig.INVISIBLE_NAMES_FALLBACK || item === TeleConfig.INVISIBLE_NAMES_PHRASE
+
+    /** The name settings changed: recompute the titles, then rebind the lists, headers and cells of every account. */
+    @JvmStatic
+    fun onNamesChanged() {
+        AndroidUtilities.runOnUIThread {
+            for (account in 0 until UserConfig.MAX_ACCOUNT_COUNT) {
+                val ids = synchronized(chats[account]) { chats[account].keys.toList() }
+                if (ids.isEmpty()) continue
+                val controller = MessagesController.getInstance(account)
+                for (id in ids) {
+                    applyChat(account, controller.getChat(id))
+                }
+            }
+            refreshAll()
+        }
+    }
+
+    private fun refreshAll() {
+        TeleHooks.bumpUiRevision()
+        for (account in 0 until UserConfig.MAX_ACCOUNT_COUNT) {
+            if (!UserConfig.getInstance(account).isClientActivated) continue
+            val center = AccountInstance.getInstance(account).notificationCenter
+            center.postNotificationName(
+                NotificationCenter.updateInterfaces,
+                MessagesController.UPDATE_MASK_NAME or MessagesController.UPDATE_MASK_CHAT_NAME
+            )
+            center.postNotificationName(NotificationCenter.dialogsNeedReload)
+        }
+    }
+}
