+    private fun chooseInvisibleFallback() {
+        val activity = parentActivity ?: return
+        val values = arrayOf("", "id")
+        val labels = arrayOf(lc("Phrase"), lc("ID"))
+        val builder = if (resourceProvider != null) AlertDialog.Builder(activity, resourceProvider) else AlertDialog.Builder(activity)
+        builder.setTitle(lc("Without a username"))
+        builder.setItems(labels) { _, which ->
+            TeleConfig.set(TeleConfig.INVISIBLE_NAMES_FALLBACK, values[which])
+            TeleHooks.onConfigChanged(TeleConfig.INVISIBLE_NAMES_FALLBACK)
+            refresh()
+        }
+        showDialog(builder.create())
+    }
+
+    private fun chooseInvisiblePhrase() {
+        val activity = parentActivity ?: return
+        val input = android.widget.EditText(activity)
+        input.setText(TeleConfig.INVISIBLE_NAMES_PHRASE.value)
+        input.setSingleLine(true)
+        input.filters = arrayOf(android.text.InputFilter.LengthFilter(64))
+        val builder = if (resourceProvider != null) AlertDialog.Builder(activity, resourceProvider) else AlertDialog.Builder(activity)
+        builder.setTitle(lc("Phrase"))
+        builder.setMessage(lc("Shown instead of a blank name that has no username. Up to 64 characters."))
+        builder.setView(input)
+        builder.setPositiveButton(org.telegram.messenger.LocaleController.getString(org.telegram.messenger.R.string.OK)) { _, _ ->
+            setInvisiblePhrase(input.text.toString().replace(Regex("\\s+"), " ").trim())
+        }
+        builder.setNeutralButton(lc("Reset")) { _, _ -> setInvisiblePhrase("") }
+        builder.setNegativeButton(org.telegram.messenger.LocaleController.getString(org.telegram.messenger.R.string.Cancel), null)
+        showDialog(builder.create())
+    }
+
+    private fun setInvisiblePhrase(phrase: String) {
+        TeleConfig.set(TeleConfig.INVISIBLE_NAMES_PHRASE, phrase)
+        TeleHooks.onConfigChanged(TeleConfig.INVISIBLE_NAMES_PHRASE)
+        refresh()
+    }
+
