From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Fri, 6 Nov 2026 16:26:22 +0300
Subject: [PATCH] fix: open docked media viewer with files in the tray

---
 .../src/main/java/tele/helpers/DockedMedia.kt    | 16 ++++++++++------
 .../src/main/java/tele/ui/TeleDockedStrip.kt     |  1 +
 2 files changed, 11 insertions(+), 6 deletions(-)

diff --git a/TMessagesProj/src/main/java/tele/helpers/DockedMedia.kt b/TMessagesProj/src/main/java/tele/helpers/DockedMedia.kt
index fcca37f50..321343f74 100644
--- a/TMessagesProj/src/main/java/tele/helpers/DockedMedia.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/DockedMedia.kt
@@ -529,13 +529,17 @@ object DockedMedia {
             applied = true
             val current = tray(key) ?: return
             val result = ArrayList<Item>()
-            entries.forEachIndexed { i, entry ->
-                if (!selected.containsKey(ids[i])) return@forEachIndexed
-                result.add(snapshot(entry, items[i].asFile).also { it.stars = items[i].stars; it.asVideo = items[i].asVideo })
+            for (item in current.items) {
+                if (item.isSticker || item.isFile) {
+                    result.add(item)
+                    continue
+                }
+                val i = items.indexOfFirst { it === item }
+                if (i >= 0 && selected.containsKey(ids[i])) {
+                    result.add(snapshot(entries[i], item.asFile).also { it.stars = item.stars; it.asVideo = item.asVideo })
+                }
             }
-            val kept = current.items.filter { it.isSticker || it.isFile }
             current.items.clear()
-            current.items.addAll(kept)
             current.items.addAll(result)
             changed(key)
         }
@@ -581,7 +585,7 @@ object DockedMedia {
             override fun onClose() = apply()
         }
         org.telegram.ui.PhotoViewer.getInstance().setParentActivity(fragment)
-        org.telegram.ui.PhotoViewer.getInstance().openPhotoForSelect(ArrayList<Any>(entries), index, 0, false, provider, fragment)
+        org.telegram.ui.PhotoViewer.getInstance().openPhotoForSelect(ArrayList<Any>(entries), viewerIndex, 0, false, provider, fragment)
     }
 
     private fun toInfo(item: Item): SendMessagesHelper.SendingMediaInfo {
diff --git a/TMessagesProj/src/main/java/tele/ui/TeleDockedStrip.kt b/TMessagesProj/src/main/java/tele/ui/TeleDockedStrip.kt
index 4467fa502..b44b0f6ff 100644
--- a/TMessagesProj/src/main/java/tele/ui/TeleDockedStrip.kt
+++ b/TMessagesProj/src/main/java/tele/ui/TeleDockedStrip.kt
@@ -318,6 +318,7 @@ class TeleDockedStrip(
             spoilerEffect?.callback = this
             val image = BackupImageView(context)
             image.setRoundRadius(AndroidUtilities.dp(8f))
+            if (item.spoiler) image.setAspectFit(true)
             val filter = if (item.spoiler) "${TILE.toInt()}_${TILE.toInt()}_b" else "${TILE.toInt()}_${TILE.toInt()}"
             val placeholder = Theme.chat_attachEmptyDrawable
             val cover = item.coverPath
