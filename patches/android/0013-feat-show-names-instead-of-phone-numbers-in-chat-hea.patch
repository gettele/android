From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?t=CE=B1ngenx?= <me@tangenx.dev>
Date: Thu, 1 Oct 2026 19:50:36 +0300
Subject: [PATCH] feat: show names instead of phone numbers in chat headers

---
 TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java  | 2 +-
 TMessagesProj/src/main/java/tele/TeleConfig.kt                 | 2 ++
 .../src/main/java/tele/ui/settings/TeleSettingsActivity.kt     | 3 ++-
 3 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
index 3ab2f7251..5c8be3502 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
@@ -19542,7 +19542,7 @@ public class ChatActivity extends BaseFragment implements
             if (currentUser.self) {
                 avatarContainer.setTitle(LocaleController.getString(R.string.SavedMessages));
             } else if (!MessagesController.isSupportUser(currentUser) && getContactsController().contactsDict.get(currentUser.id) == null && (getContactsController().contactsDict.size() != 0 || !getContactsController().isLoadingContacts())) {
-                if (!TextUtils.isEmpty(currentUser.phone)) {
+                if (!TextUtils.isEmpty(currentUser.phone) && !TeleConfig.NAME_INSTEAD_OF_PHONE.getValue()) {
                     avatarContainer.setTitle(PhoneFormat.getInstance().format("+" + currentUser.phone), currentUser.scam, currentUser.fake, currentUser.verified, getMessagesController().isPremiumUser(currentUser), currentUser.emoji_status, animated);
                 } else {
                     avatarContainer.setTitle(AndroidUtilities.removeRTL(AndroidUtilities.removeDiacritics(UserObject.getUserName(currentUser))), currentUser.scam, currentUser.fake, currentUser.verified, getMessagesController().isPremiumUser(currentUser), currentUser.emoji_status, animated);
diff --git a/TMessagesProj/src/main/java/tele/TeleConfig.kt b/TMessagesProj/src/main/java/tele/TeleConfig.kt
index a81d47903..5d48c2eae 100644
--- a/TMessagesProj/src/main/java/tele/TeleConfig.kt
+++ b/TMessagesProj/src/main/java/tele/TeleConfig.kt
@@ -52,6 +52,8 @@ object TeleConfig {
     val CONFIRM_CALLS = BoolItem("confirm_calls", false)
     @JvmField
     val OPEN_LINKS_DIRECTLY = BoolItem("open_links_directly", false)
+    @JvmField
+    val NAME_INSTEAD_OF_PHONE = BoolItem("name_instead_of_phone", false)
 
     private var prefs: SharedPreferences? = null
 
diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
index 391f4378e..aaeb85cf1 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
@@ -71,7 +71,8 @@ class TeleSettingsActivity : BaseFragment() {
             Row(TYPE_TOGGLE, "hide the all chats folder", item = TeleConfig.HIDE_ALL_CHATS_FOLDER),
             Row(TYPE_TOGGLE, "hide call buttons", item = TeleConfig.HIDE_CALL_BUTTONS),
             Row(TYPE_TOGGLE, "confirm calls before starting", item = TeleConfig.CONFIRM_CALLS),
-            Row(TYPE_TOGGLE, "open links without confirmation", item = TeleConfig.OPEN_LINKS_DIRECTLY)
+            Row(TYPE_TOGGLE, "open links without confirmation", item = TeleConfig.OPEN_LINKS_DIRECTLY),
+            Row(TYPE_TOGGLE, "show names instead of phone numbers in chat headers", item = TeleConfig.NAME_INSTEAD_OF_PHONE)
         )
 
         override fun getItemCount(): Int = rows.size
