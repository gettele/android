+    private fun roundRect(color: Int, radius: Float): android.graphics.drawable.GradientDrawable {
+        return android.graphics.drawable.GradientDrawable().apply {
+            setColor(color)
+            cornerRadius = radius
+        }
     }
 
+    private class SelectionBadge(context: Context) : View(context) {
+        private val paint = android.graphics.Paint(android.graphics.Paint.ANTI_ALIAS_FLAG)
+        private val path = android.graphics.Path()
+        private var checked = false
+        private var progress = 0f
+        private var animator: android.animation.ValueAnimator? = null
+
+        fun setChecked(value: Boolean, animated: Boolean) {
+            if (checked == value) return
+            checked = value
+            animator?.cancel()
+            val target = if (value) 1f else 0f
+            if (animated) {
+                animator = android.animation.ValueAnimator.ofFloat(progress, target).apply {
+                    duration = 180
+                    addUpdateListener {
+                        progress = it.animatedValue as Float
+                        invalidate()
+                    }
+                    start()
+                }
+            } else {
+                progress = target
+                invalidate()
+            }
+        }
+
+        override fun onDraw(canvas: android.graphics.Canvas) {
+            super.onDraw(canvas)
+            if (progress <= 0f) return
+            val cx = width / 2f
+            val cy = height / 2f
+            paint.style = android.graphics.Paint.Style.FILL
+            paint.color = android.graphics.Color.rgb(52, 199, 89)
+            canvas.drawCircle(cx, cy, AndroidUtilities.dp(11f) * progress, paint)
+            paint.style = android.graphics.Paint.Style.STROKE
+            paint.strokeWidth = AndroidUtilities.dp(2f).toFloat()
+            paint.strokeCap = android.graphics.Paint.Cap.ROUND
+            paint.strokeJoin = android.graphics.Paint.Join.ROUND
+            paint.color = android.graphics.Color.WHITE
+            paint.alpha = (255 * progress).toInt()
+            path.reset()
+            path.moveTo(cx - AndroidUtilities.dp(5f), cy)
+            path.lineTo(cx - AndroidUtilities.dp(1f), cy + AndroidUtilities.dp(4f))
+            path.lineTo(cx + AndroidUtilities.dp(6f), cy - AndroidUtilities.dp(4f))
+            canvas.drawPath(path, paint)
+            paint.alpha = 255
+        }
+    }
     companion object {
