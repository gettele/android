+    private fun spanAt(event: MotionEvent): ClickableSpan? {
+        val spanned = text.text as? Spanned ?: return null
+        val layout = text.layout ?: return null
+        val x = event.x - text.totalPaddingLeft + text.scrollX
+        val y = event.y - text.totalPaddingTop + text.scrollY
+        if (y < 0 || y > layout.height) return null
+        val line = layout.getLineForVertical(y.toInt())
+        if (x < layout.getLineLeft(line) || x > layout.getLineRight(line)) return null
+        val offset = layout.getOffsetForHorizontal(line, x)
+        return spanned.getSpans(offset, offset, ClickableSpan::class.java).firstOrNull()
+    }
+
+    private fun touchSpan(event: MotionEvent): Boolean {
+        when (event.actionMasked) {
+            MotionEvent.ACTION_DOWN -> {
+                pressedSpan = spanAt(event)
+                return pressedSpan != null
+            }
+            MotionEvent.ACTION_UP -> {
+                val span = pressedSpan ?: return false
+                pressedSpan = null
+                if (spanAt(event) == span) span.onClick(text)
+                return true
+            }
+            MotionEvent.ACTION_CANCEL -> {
+                val pressed = pressedSpan != null
+                pressedSpan = null
+                return pressed
+            }
+        }
+        return pressedSpan != null
+    }
