diff --git a/TMessagesProj/src/main/java/tele/helpers/TeleCopies.kt b/TMessagesProj/src/main/java/tele/helpers/TeleCopies.kt
new file mode 100644
index 000000000..d3061923e
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/TeleCopies.kt
@@ -0,0 +1,45 @@
+package tele.helpers
+
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.UserConfig
+import tele.TeleConfig
+
+/**
+ * Logs the values that the features of tele put on the clipboard (ids, data centers, paths, menu
+ * layouts) in the notification center, so a value can be copied again later. The stock copies are
+ * not logged: a feature calls [log] next to its own `addToClipboard`.
+ */
+object TeleCopies {
+
+    private const val MERGE_SECONDS = 60
+
+    @JvmStatic
+    fun enabled(): Boolean = TeleNotices.enabled() && TeleConfig.NOTICES_COPIES.value
+
+    /** [title] is what the toast of the copy says; [value] is what went to the clipboard. */
+    @JvmStatic
+    fun log(account: Int, title: String, value: CharSequence?) {
+        if (!enabled() || value.isNullOrEmpty()) return
+        val text = value.toString()
+        // the same value from the same feature within a minute stays one entry
+        val bucket = (System.currentTimeMillis() / 1000L) / MERGE_SECONDS
+        TeleNotices.add(
+            account,
+            TeleNotice(
+                kind = NoticeKind.COPY,
+                title = title,
+                text = text,
+                key = "copy:${(title + '\u0000' + text).hashCode()}:$bucket"
+            )
+        )
+    }
+
+    /** For the code that has no account at hand. */
+    @JvmStatic
+    fun log(title: String, value: CharSequence?) = log(UserConfig.selectedAccount, title, value)
+
+    /** The tap on an entry: the value goes to the clipboard again. */
+    fun copyAgain(notice: TeleNotice) {
+        AndroidUtilities.addToClipboard(notice.text)
+    }
+}
