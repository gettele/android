@@ -0,0 +1,29 @@
+package tele.helpers
+
+import org.telegram.messenger.VideoEditedInfo
+import org.telegram.ui.Components.voip.AnimatedFileInfo
+import org.telegram.ui.Components.AnimatedFileNative
+import tele.TeleConfig
+
+/** Desktop 0242: the chosen type of a video without an audio track, GIF by default. */
+object SilentVideo {
+
+    @JvmStatic
+    fun asVideo(): Boolean = TeleConfig.SILENT_VIDEO_AS.value == "video"
+
+    /** Whether the muted video goes out as an animation rather than as a silent video. */
+    @JvmStatic
+    fun sendsAsGif(info: VideoEditedInfo?): Boolean = info != null && info.muted && !info.tele_asVideo && !asVideo()
+
+    @JvmStatic
+    fun apply(info: VideoEditedInfo?, path: String?, allowed: Boolean) {
+        if (info == null || path == null || !allowed || info.tele_asVideo) return
+        if (info.isSticker || info.isPhoto) return
+        // an explicit mute stays: removing the sound is the user's choice, not the GIF default
+        if (info.muted) return
+        val params = IntArray(AnimatedFileInfo.PARAM_NUM_COUNT)
+        AnimatedFileNative.getVideoInfo(path, params, info.videoOffset)
+        if (params[AnimatedFileInfo.PARAM_NUM_HAS_AUDIO] != 0) return
+        info.muted = !asVideo()
+    }
+}
