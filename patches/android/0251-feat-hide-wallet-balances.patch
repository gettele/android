From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Tue, 3 Nov 2026 18:16:43 +0300
Subject: [PATCH] feat: hide wallet balances

---
 .../main/java/org/telegram/ui/Wallet/WalletActivity.java   | 7 ++++---
 TMessagesProj/src/main/java/tele/TeleConfig.kt             | 2 ++
 TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt | 5 ++++-
 .../src/main/java/tele/ui/settings/TeleSettingsActivity.kt | 2 ++
 4 files changed, 12 insertions(+), 4 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Wallet/WalletActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/Wallet/WalletActivity.java
index 47dda2324..0f0817b38 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Wallet/WalletActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Wallet/WalletActivity.java
@@ -3584,15 +3584,16 @@ public class WalletActivity extends UniversalFragment implements NotificationCen
         if (walletTopPanel == null) return;
         final GramWallet wallet = GramWallet.getInstance(currentAccount);
         final boolean animated = walletTopPanel.isAttachedToWindow() && walletTopPanel.isLaidOut();
-        walletTopPanel.setViewVisible(waltButton, wallet.hasWaltBalance(), animated);
+        final boolean hideExtra = tele.TeleConfig.HIDE_OTHER_WALLET_BALANCES.value;
+        walletTopPanel.setViewVisible(waltButton, !hideExtra && wallet.hasWaltBalance(), animated);
         final long previousWalletsBalance = wallet.getBalanceOfPreviousWallets();
-        final boolean showOldWallets = previousWalletsBalance > 500_000_000L;
+        final boolean showOldWallets = !hideExtra && previousWalletsBalance > 500_000_000L;
         if (showOldWallets) {
             oldWalletsButtonText.setText(formatWalletNoticeBalance(previousWalletsBalance, R.string.WalletOldWalletsBalance));
         }
         walletTopPanel.setViewVisible(oldWalletsButton, showOldWallets, animated);
         final long earningsBalance = StarsController.getTonInstance(currentAccount).getBalance().amount;
-        final boolean showEarnings = earningsBalance > 500_000_000L;
+        final boolean showEarnings = !hideExtra && earningsBalance > 500_000_000L;
         if (showEarnings) {
             gramEarningsButtonText.setText(formatWalletNoticeBalance(earningsBalance, R.string.WalletGramEarningsBalance));
         }
diff --git a/TMessagesProj/src/main/java/tele/TeleConfig.kt b/TMessagesProj/src/main/java/tele/TeleConfig.kt
index 402e844f7..333b2a535 100644
--- a/TMessagesProj/src/main/java/tele/TeleConfig.kt
+++ b/TMessagesProj/src/main/java/tele/TeleConfig.kt
@@ -136,6 +136,8 @@ object TeleConfig {
     @JvmField
     val DIM_WALLET_ADDRESS = BoolItem("dim_wallet_address", false)
     @JvmField
+    val HIDE_OTHER_WALLET_BALANCES = BoolItem("hide_other_wallet_balances", false)
+    @JvmField
     val WALLET_COPY_WORDS = BoolItem("wallet_copy_words", false)
     @JvmField
     val WALLET_PRIVATE_KEYS = BoolItem("wallet_private_keys", false)
diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt
index 5cff512dc..38848bbae 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt
@@ -439,7 +439,10 @@ object TeleSearch {
             section(1549, "Update the secret phrase", "money", TeleSettingsActivity.MODE_MONEY, "Rotate the wallet phrase"),
             section(1550, "Dim wallet address groups", "money", TeleSettingsActivity.MODE_MONEY, "Dim wallet address groups"),
             section(1551, "Dim every other address group", "money", TeleSettingsActivity.MODE_MONEY, "Dim wallet address groups"),
-            section(1552, "Address groups", "money", TeleSettingsActivity.MODE_MONEY, "Dim wallet address groups")
+            section(1552, "Address groups", "money", TeleSettingsActivity.MODE_MONEY, "Dim wallet address groups"),
+            section(1553, "Hide other balances", "money", TeleSettingsActivity.MODE_MONEY, "Hide other balances"),
+            section(1554, "Other balances", "money", TeleSettingsActivity.MODE_MONEY, "Hide other balances"),
+            section(1555, "Hide the balances above the card", "money", TeleSettingsActivity.MODE_MONEY, "Hide other balances")
         ))
         return results.toTypedArray()
     }
diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
index 032434226..7754c4e4c 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
@@ -1100,6 +1100,7 @@ class TeleSettingsActivity @JvmOverloads constructor(private val mode: String =
             "Report crashes without a dump" to "Say why a crash had no dump when it is sent.",
             "Turn off Money" to "Money is gone from the app, links and messages included.",
             "Dim wallet address groups" to "Dims every other group of four in an address, like on iOS.",
+            "Hide other balances" to "Hides the rows above the card — the old wallets' balance and the earnings. Your balance stays.",
             "Force the wallet" to "Show the money wallet even when the server has it off.",
             "Copy wallet words" to "A copy button on the secret phrase screen; the clipboard clears in a minute.",
             "Import wallets from private keys" to "Import a wallet from a raw ed25519 key instead of words.",
@@ -1654,6 +1655,7 @@ class TeleSettingsActivity @JvmOverloads constructor(private val mode: String =
                     rows.add(Row(TYPE_SHADOW))
                     rows.add(Row(TYPE_HEADER, "Addresses and balances"))
                     rows.add(toggle("Dim wallet address groups", TeleConfig.DIM_WALLET_ADDRESS))
+                    rows.add(toggle("Hide other balances", TeleConfig.HIDE_OTHER_WALLET_BALANCES))
                 }
                 rows.add(Row(TYPE_SHADOW))
                 rows
