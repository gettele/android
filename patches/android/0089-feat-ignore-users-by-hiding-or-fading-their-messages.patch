+package tele.ui.settings
+
+import android.content.Context
+import android.text.Editable
+import android.text.TextWatcher
+import android.view.Gravity
+import android.view.View
+import android.view.ViewGroup
+import android.widget.FrameLayout
+import androidx.recyclerview.widget.LinearLayoutManager
+import androidx.recyclerview.widget.RecyclerView
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.ContactsController
+import org.telegram.messenger.MessagesController
+import org.telegram.messenger.R
+import org.telegram.messenger.UserConfig
+import org.telegram.messenger.UserObject
+import org.telegram.tgnet.ConnectionsManager
+import org.telegram.tgnet.TLRPC
+import org.telegram.ui.ActionBar.ActionBar
+import org.telegram.ui.ActionBar.AlertDialog
+import org.telegram.ui.ActionBar.BaseFragment
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Cells.HeaderCell
+import org.telegram.ui.Cells.TextCheckCell
+import org.telegram.ui.Cells.TextInfoPrivacyCell
+import org.telegram.ui.Components.EditTextBoldCursor
+import org.telegram.ui.Components.LayoutHelper
+import org.telegram.ui.Components.RecyclerListView
+import tele.helpers.PrivacyRules
+
+/**
+ * Fork picker of privacy exceptions: it looks like the privacy screens, but it edits the local
+ * lists of the fork instead of the server block list.
+ */
+class TelePeersActivity(private val account: Int, private val mode: String) : BaseFragment() {
+
+    private class Peer(val dialogId: Long, val title: String, val subtitle: String)
+
+    private var peers: List<Peer> = emptyList()
+    private var query = ""
+    private var adapter: Adapter? = null
+    private var searchField: EditTextBoldCursor? = null
+    private var searchRunnable: Runnable? = null
+
+    private val isIgnoreMode get() = mode == MODE_IGNORE
+
+    private fun title(): String = when (mode) {
+        MODE_GHOST_ALWAYS -> "always ghost in"
+        MODE_GHOST_NEVER -> "never ghost in"
+        else -> "ignored users"
+    }
+
+    private fun modeOf(dialogId: Long): String? = if (isIgnoreMode) {
+        PrivacyRules.ignoredMode(account, dialogId)
+    } else {
+        PrivacyRules.ghostMode(account, dialogId)
+    }
+
+    private fun applyMode(dialogId: Long, newMode: String?) {
+        if (isIgnoreMode) {
+            PrivacyRules.setIgnored(account, dialogId, newMode)
+        } else {
+            PrivacyRules.setGhost(account, dialogId, newMode)
+        }
+        tele.TeleHooks.onPrivacyRulesChanged()
+    }
+
+    private fun peerTitle(dialogId: Long): String {
+        val controller = MessagesController.getInstance(account)
+        if (dialogId > 0) {
+            val user = controller.getUser(dialogId)
+            if (user != null) {
+                return ContactsController.formatName(user.first_name, user.last_name)
+            }
+        } else {
+            val chat = controller.getChat(-dialogId)
+            if (chat != null) {
+                return chat.title
+            }
+        }
+        return "id $dialogId"
+    }
+
+    private fun peerSubtitle(dialogId: Long): String {
+        val controller = MessagesController.getInstance(account)
+        if (dialogId > 0) {
+            val user = controller.getUser(dialogId)
+            if (user != null) {
+                return if (user.bot) "bot" else "user"
+            }
+        } else {
+            val chat = controller.getChat(-dialogId)
+            if (chat != null) {
+                return if (chat.megagroup) "group" else "channel"
+            }
+        }
+        return ""
+    }
+
+    private fun loadLocalPeers(): List<Peer> {
+        val result = ArrayList<Peer>()
+        val seen = HashSet<Long>()
+        val controller = MessagesController.getInstance(account)
+        val dialogs = controller.getAllDialogs()
+        for (dialog in dialogs) {
+            if (dialog.isFolder || dialog is TLRPC.TL_dialogCommunity) {
+                continue
+            }
+            val dialogId = dialog.id
+            if (dialogId == 0L || !seen.add(dialogId)) {
+                continue
+            }
+            if (dialogId > 0) {
+                val user = controller.getUser(dialogId) ?: continue
+                if (UserObject.isDeleted(user) || user.self) {
+                    continue
+                }
+            }
+            if (query.isNotEmpty() && !peerTitle(dialogId).contains(query, ignoreCase = true)) {
+                continue
+            }
+            result.add(Peer(dialogId, peerTitle(dialogId), peerSubtitle(dialogId)))
+        }
+        return result
+    }
+
+    private fun searchUsers(text: String) {
+        val request = TLRPC.TL_contacts_search()
+        request.q = text
+        request.limit = 50
+        ConnectionsManager.getInstance(account).sendRequest(request) { response, error ->
+            if (error != null || response !is TLRPC.TL_contacts_found) {
+                return@sendRequest
+            }
+            val found = ArrayList<Peer>()
+            for (user in response.users) {
+                if (user.self || UserObject.isDeleted(user) || UserObject.isService(user.id)) {
+                    continue
+                }
+                found.add(Peer(user.id, ContactsController.formatName(user.first_name, user.last_name), "user"))
+            }
+            android.os.Handler(android.os.Looper.getMainLooper()).post {
+                if (query != text) {
+                    return@post
+                }
+                peers = merge(found, peers)
+                adapter?.notifyDataSetChanged()
+            }
+        }
+    }
+
+    private fun merge(first: List<Peer>, second: List<Peer>): List<Peer> {
+        val result = ArrayList<Peer>(first)
+        val seen = HashSet<Long>()
+        for (peer in first) {
+            seen.add(peer.dialogId)
+        }
+        for (peer in second) {
+            if (seen.add(peer.dialogId)) {
+                result.add(peer)
+            }
+        }
+        return result
+    }
+
+    private fun reload() {
+        peers = loadLocalPeers()
+        adapter?.notifyDataSetChanged()
+    }
+
+    override fun createView(context: Context): View {
+        actionBar.setBackButtonImage(R.drawable.ic_ab_back)
+        actionBar.setAllowOverlayTitle(true)
+        actionBar.setTitle(title())
+        actionBar.setActionBarMenuOnItemClick(object : ActionBar.ActionBarMenuOnItemClick() {
+            override fun onItemClick(id: Int) {
+                if (id == -1) {
+                    finishFragment()
+                }
+            }
+        })
+
+        val frameLayout = FrameLayout(context)
+        frameLayout.setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundGray))
+        fragmentView = frameLayout
+
+        val field = EditTextBoldCursor(context)
+        field.setSingleLine(true)
+        field.setTextSize(android.util.TypedValue.COMPLEX_UNIT_DIP, 17f)
+        field.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
+        field.setHintTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteHintText))
+        field.setBackgroundDrawable(null)
+        field.setLineColors(
+            Theme.getColor(Theme.key_windowBackgroundWhiteInputField),
+            Theme.getColor(Theme.key_windowBackgroundWhiteInputFieldActivated),
+            Theme.getColor(Theme.key_text_RedRegular)
+        )
+        field.hint = "search"
+        field.setPadding(0, 0, 0, 0)
+        val fieldContainer = FrameLayout(context)
+        fieldContainer.setPadding(AndroidUtilities.dp(20f), AndroidUtilities.dp(8f), AndroidUtilities.dp(20f), AndroidUtilities.dp(8f))
+        fieldContainer.addView(field, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, 42f))
+        field.addTextChangedListener(object : TextWatcher {
+            override fun beforeTextChanged(s: CharSequence?, start: Int, count: Int, after: Int) {}
+            override fun onTextChanged(s: CharSequence?, start: Int, before: Int, count: Int) {}
+            override fun afterTextChanged(s: Editable?) {
+                query = s?.toString()?.trim() ?: ""
+                reload()
+                searchRunnable?.let { android.os.Handler(android.os.Looper.getMainLooper()).removeCallbacks(it) }
+                if (query.length >= 2) {
+                    val runnable = Runnable { searchUsers(query) }
+                    searchRunnable = runnable
+                    android.os.Handler(android.os.Looper.getMainLooper()).postDelayed(runnable, 400)
+                }
+            }
+        })
+        searchField = field
+        frameLayout.addView(fieldContainer, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT, Gravity.TOP))
+
+        val listView = RecyclerListView(context)
+        listView.setLayoutManager(LinearLayoutManager(context))
+        listView.setVerticalScrollBarEnabled(false)
+        listView.setPadding(0, 0, 0, AndroidUtilities.dp(12f))
+        listView.setClipToPadding(false)
+        adapter = Adapter(context)
+        listView.setAdapter(adapter)
+        listView.setOnItemClickListener { _, position ->
+            val peer = peers.getOrNull(position - 1) ?: return@setOnItemClickListener
+            val current = modeOf(peer.dialogId)
+            val next = if (current != null) null else if (isIgnoreMode) PrivacyRules.MODE_FADE else mode
+            applyMode(peer.dialogId, next)
+            adapter?.notifyDataSetChanged()
+        }
+        listView.setOnItemLongClickListener { _, position ->
+            val peer = peers.getOrNull(position - 1) ?: return@setOnItemLongClickListener false
+            showModeDialog(peer)
+            true
+        }
+        frameLayout.addView(listView, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.MATCH_PARENT, Gravity.TOP))
+        listView.setPadding(0, AndroidUtilities.dp(52f), 0, AndroidUtilities.dp(12f))
+
+        reload()
+        return frameLayout
+    }
+
+    private fun showModeDialog(peer: Peer) {
+        val activity = parentActivity ?: return
+        val builder = AlertDialog.Builder(activity)
+        builder.setTitle(peer.title)
+        val current = modeOf(peer.dialogId)
+        val options = if (isIgnoreMode) {
+            arrayOf("hide", "fade", "remove")
+        } else {
+            arrayOf("always ghost", "never ghost", "remove")
+        }
+        builder.setItems(options) { _, which ->
+            when (which) {
+                0 -> applyMode(peer.dialogId, if (isIgnoreMode) PrivacyRules.MODE_HIDE else PrivacyRules.GHOST_ALWAYS)
+                1 -> applyMode(peer.dialogId, if (isIgnoreMode) PrivacyRules.MODE_FADE else PrivacyRules.GHOST_NEVER)
+                else -> applyMode(peer.dialogId, null)
+            }
+            adapter?.notifyDataSetChanged()
+        }
+        if (current != null) {
+            builder.setNegativeButton("cancel", null)
+        }
+        showDialog(builder.create())
+    }
+
+    private inner class Adapter(private val context: Context) : RecyclerListView.SelectionAdapter() {
+
+        override fun getItemCount(): Int = peers.size + 2
+
+        override fun isEnabled(holder: RecyclerView.ViewHolder): Boolean = holder.adapterPosition in 1..peers.size
+
+        override fun onCreateViewHolder(parent: ViewGroup, viewType: Int): RecyclerView.ViewHolder {
+            val view: View = when (viewType) {
+                TYPE_HEADER -> HeaderCell(context)
+                TYPE_SHADOW -> TextInfoPrivacyCell(context)
+                else -> TextCheckCell(context)
+            }
+            view.layoutParams = RecyclerView.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT)
+            return RecyclerListView.Holder(view)
+        }
+
+        override fun onBindViewHolder(holder: RecyclerView.ViewHolder, position: Int) {
+            when (val cell = holder.itemView) {
+                is HeaderCell -> cell.setText(title())
+                is TextInfoPrivacyCell -> cell.setText(
+                    if (isIgnoreMode) "tap to add or remove, long press to hide or fade the messages"
+                    else "tap to add or remove, long press to switch between always and never"
+                )
+                else -> {
+                    val peer = peers[position - 1]
+                    val current = modeOf(peer.dialogId)
+                    val value = when {
+                        current == null -> peer.subtitle
+                        isIgnoreMode && current == PrivacyRules.MODE_HIDE -> "hidden"
+                        isIgnoreMode -> "faded"
+                        current == PrivacyRules.GHOST_ALWAYS -> "always"
+                        else -> "never"
+                    }
+                    (cell as TextCheckCell).setTextAndValueAndCheck(peer.title, value, current != null, false, false)
+                }
+            }
+        }
+
+        override fun getItemViewType(position: Int): Int = when (position) {
+            0 -> TYPE_HEADER
+            peers.size + 1 -> TYPE_SHADOW
+            else -> TYPE_ENTRY
+        }
+    }
+
+    companion object {
+        const val MODE_IGNORE = "ignore"
+        const val MODE_GHOST_ALWAYS = "ghost_always"
+        const val MODE_GHOST_NEVER = "ghost_never"
+
+        private const val TYPE_ENTRY = 1
+        private const val TYPE_HEADER = 2
+        private const val TYPE_SHADOW = 3
+    }
+}
