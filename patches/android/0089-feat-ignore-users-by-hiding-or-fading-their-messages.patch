diff --git a/TMessagesProj/src/main/java/tele/helpers/PrivacyRules.kt b/TMessagesProj/src/main/java/tele/helpers/PrivacyRules.kt
new file mode 100644
index 000000000..ad007d8d0
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/PrivacyRules.kt
@@ -0,0 +1,275 @@
+package tele.helpers
+
+import org.json.JSONObject
+import org.telegram.messenger.MessageObject
+import org.telegram.tgnet.TLRPC
+import tele.TeleConfig
+import tele.db.TeleDatabaseHelper
+import java.util.regex.Pattern
+import java.util.regex.PatternSyntaxException
+
+/**
+ * Local privacy rules of the fork: ignored peers, per-chat ghost overrides and hidden words.
+ * Everything is stored in tele_kv, scoped by account, and never leaves the device.
+ */
+object PrivacyRules {
+
+    const val MODE_HIDE = "hide"
+    const val MODE_FADE = "fade"
+    const val GHOST_ALWAYS = "always"
+    const val GHOST_NEVER = "never"
+
+    private const val KEY_IGNORE = "privacy_ignore"
+    private const val KEY_GHOST = "privacy_ghost"
+    private const val KEY_WORDS = "privacy_hidden_words"
+
+    private val lock = Any()
+    private val ignored = HashMap<Int, MutableMap<Long, String>>()
+    private val ghosts = HashMap<Int, MutableMap<Long, String>>()
+    private val globalWords = HashMap<Int, List<Rule>>()
+    private val chatWords = HashMap<String, List<Rule>>()
+
+    private class Rule(val pattern: Pattern)
+
+    @JvmStatic
+    fun init() {
+        Thread {
+            for (account in 0 until org.telegram.messenger.UserConfig.MAX_ACCOUNT_COUNT) {
+                synchronized(lock) {
+                    if (!ignored.containsKey(account)) ignored[account] = readPeers(ignoreKey(account))
+                    if (!ghosts.containsKey(account)) ghosts[account] = readPeers(ghostKey(account))
+                }
+            }
+        }.start()
+    }
+
+    private fun ignoreKey(account: Int) = "$KEY_IGNORE:$account"
+
+    private fun ghostKey(account: Int) = "$KEY_GHOST:$account"
+
+    private fun wordsKey(account: Int) = "$KEY_WORDS:$account"
+
+    private fun chatWordsKey(account: Int, dialogId: Long) = "$KEY_WORDS:$account:$dialogId"
+
+    private fun readPeers(key: String): MutableMap<Long, String> {
+        val map = HashMap<Long, String>()
+        val raw = TeleDatabaseHelper.get(key) ?: return map
+        runCatching {
+            val json = JSONObject(raw)
+            for (name in json.keys()) {
+                val id = name.toLongOrNull() ?: continue
+                when (json.optString(name)) {
+                    MODE_HIDE, MODE_FADE, GHOST_ALWAYS, GHOST_NEVER -> map[id] = json.optString(name)
+                }
+            }
+        }
+        return map
+    }
+
+    private fun writePeers(key: String, map: Map<Long, String>) {
+        val json = JSONObject()
+        for ((id, mode) in map) {
+            json.put(id.toString(), mode)
+        }
+        TeleDatabaseHelper.put(key, json.toString())
+    }
+
+    // ignored peers
+
+    @JvmStatic
+    fun ignoredPeers(account: Int): Map<Long, String> = synchronized(lock) {
+        ignored.getOrPut(account) { readPeers(ignoreKey(account)) }.toMap()
+    }
+
+    @JvmStatic
+    fun ignoredMode(account: Int, dialogId: Long): String? = synchronized(lock) {
+        ignored[account]?.get(dialogId)
+    }
+
+    @JvmStatic
+    fun setIgnored(account: Int, dialogId: Long, mode: String?) = synchronized(lock) {
+        val map = ignored.getOrPut(account) { readPeers(ignoreKey(account)) }
+        if (mode == null) {
+            map.remove(dialogId)
+        } else {
+            map[dialogId] = mode
+        }
+        writePeers(ignoreKey(account), map)
+    }
+
+    // per-chat ghost overrides
+
+    @JvmStatic
+    fun ghostPeers(account: Int): Map<Long, String> = synchronized(lock) {
+        ghosts.getOrPut(account) { readPeers(ghostKey(account)) }.toMap()
+    }
+
+    @JvmStatic
+    fun ghostMode(account: Int, dialogId: Long): String? = synchronized(lock) {
+        ghosts[account]?.get(dialogId)
+    }
+
+    @JvmStatic
+    fun setGhost(account: Int, dialogId: Long, mode: String?) = synchronized(lock) {
+        val map = ghosts.getOrPut(account) { readPeers(ghostKey(account)) }
+        if (mode == null) {
+            map.remove(dialogId)
+        } else {
+            map[dialogId] = mode
+        }
+        writePeers(ghostKey(account), map)
+    }
+
+    /** The chat is listed as always ghosted, whatever the global switches say. */
+    @JvmStatic
+    fun ghosted(account: Int, dialogId: Long): Boolean = ghostMode(account, dialogId) == GHOST_ALWAYS
+
+    private fun ghostClass(account: Int, dialogId: Long, global: Boolean): Boolean {
+        if (!TeleConfig.GHOST_PER_CHAT.value) {
+            return global
+        }
+        return when (ghostMode(account, dialogId)) {
+            GHOST_ALWAYS -> true
+            GHOST_NEVER -> false
+            else -> global
+        }
+    }
+
+    @JvmStatic
+    fun ghostRead(account: Int, dialogId: Long): Boolean = ghostClass(account, dialogId, TeleConfig.GHOST_READ.value)
+
+    @JvmStatic
+    fun ghostTyping(account: Int, dialogId: Long): Boolean = ghostClass(account, dialogId, TeleConfig.GHOST_TYPING.value)
+
+    @JvmStatic
+    fun ghostContentsRead(account: Int, dialogId: Long): Boolean = ghostClass(account, dialogId, TeleConfig.GHOST_CONTENTS_READ.value)
+
+    // hidden words
+
+    @JvmStatic
+    fun hiddenWords(account: Int): String = TeleDatabaseHelper.get(wordsKey(account)) ?: ""
+
+    @JvmStatic
+    fun setHiddenWords(account: Int, text: String) {
+        TeleDatabaseHelper.put(wordsKey(account), text)
+        synchronized(lock) {
+            globalWords.remove(account)
+        }
+    }
+
+    @JvmStatic
+    fun chatHiddenWords(account: Int, dialogId: Long): String = TeleDatabaseHelper.get(chatWordsKey(account, dialogId)) ?: ""
+
+    @JvmStatic
+    fun setChatHiddenWords(account: Int, dialogId: Long, text: String) {
+        TeleDatabaseHelper.put(chatWordsKey(account, dialogId), text)
+        synchronized(lock) {
+            chatWords.remove(chatWordsKey(account, dialogId))
+        }
+    }
+
+    /** Parses one rule per line: plain text or /regex/ and /regex/i. Returns null for an invalid regex. */
+    @JvmStatic
+    fun parseRule(line: String): Pattern? {
+        if (line.length > 2 && line[0] == '/') {
+            val end = line.lastIndexOf('/')
+            if (end > 0) {
+                val flags = line.substring(end + 1)
+                if (flags.isEmpty() || flags.equals("i", ignoreCase = true)) {
+                    return try {
+                        Pattern.compile(line.substring(1, end), Pattern.CASE_INSENSITIVE or Pattern.UNICODE_CASE)
+                    } catch (e: PatternSyntaxException) {
+                        null
+                    }
+                }
+            }
+        }
+        return Pattern.compile(Pattern.quote(line), Pattern.CASE_INSENSITIVE or Pattern.UNICODE_CASE)
+    }
+
+    private fun rules(text: String): List<Rule> {
+        val result = ArrayList<Rule>()
+        val seen = HashSet<String>()
+        for (raw in text.split('\n')) {
+            val line = raw.trim()
+            if (line.isEmpty()) {
+                continue
+            }
+            if (!seen.add(line.lowercase())) {
+                continue
+            }
+            val pattern = parseRule(line) ?: continue
+            result.add(Rule(pattern))
+        }
+        return result
+    }
+
+    private fun globalRules(account: Int): List<Rule> = synchronized(lock) {
+        globalWords.getOrPut(account) { rules(hiddenWords(account)) }
+    }
+
+    private fun chatRules(account: Int, dialogId: Long): List<Rule> = synchronized(lock) {
+        val key = chatWordsKey(account, dialogId)
+        chatWords.getOrPut(key) { rules(chatHiddenWords(account, dialogId)) }
+    }
+
+    @JvmStatic
+    fun matchesWords(account: Int, dialogId: Long, text: CharSequence?): Boolean {
+        if (text.isNullOrEmpty()) {
+            return false
+        }
+        val list = ArrayList<Rule>(globalRules(account))
+        list.addAll(chatRules(account, dialogId))
+        for (rule in list) {
+            if (rule.pattern.matcher(text).find()) {
+                return true
+            }
+        }
+        return false
+    }
+
+    // message classification
+
+    private fun messageText(message: MessageObject): CharSequence? = message.messageText ?: message.caption
+
+    /**
+     * Mode of the local privacy rules for one message: hide, fade or null when the message stays untouched.
+     * Own messages, service messages and sponsored messages are never touched.
+     */
+    @JvmStatic
+    fun messageMode(account: Int, dialogId: Long, message: MessageObject?): String? {
+        if (message == null) {
+            return null
+        }
+        if (message.isOutOwner() || message.messageOwner is TLRPC.TL_messageService || message.isSponsored()) {
+            return null
+        }
+        if (TeleConfig.IGNORE_USERS.value) {
+            ignoredMode(account, dialogId)?.let { return it }
+            val sender = message.getFromChatId()
+            if (sender != dialogId) {
+                ignoredMode(account, sender)?.let { return it }
+            }
+        }
+        if (TeleConfig.HIDDEN_WORDS.value && matchesWords(account, dialogId, messageText(message))) {
+            return MODE_HIDE
+        }
+        return null
+    }
+
+    /** The chat list preview of one message: hide, fade or null. */
+    @JvmStatic
+    fun previewMode(account: Int, dialogId: Long, message: MessageObject?): String? = messageMode(account, dialogId, message)
+
+    @JvmStatic
+    fun onAccountRemoved(account: Int) {
+        synchronized(lock) {
+            ignored.remove(account)
+            ghosts.remove(account)
+            globalWords.remove(account)
+        }
+        TeleDatabaseHelper.put(ignoreKey(account), null)
+        TeleDatabaseHelper.put(ghostKey(account), null)
+        TeleDatabaseHelper.put(wordsKey(account), null)
+    }
+}
