+    // the messages being purged: their local copies are deleted for good, not archived again
+    private val purging = ConcurrentHashMap.newKeySet<String>()
+
+    private fun purgeKey(account: Int, dialogId: Long, messageId: Int) = "$account:$dialogId:$messageId"
+
+    private fun isPurging(account: Int, dialogId: Long, messageId: Int) = purging.contains(purgeKey(account, dialogId, messageId))
+
+    /** Forgets kept messages: the archive rows and the copies left in the chat. */
+    @JvmStatic
+    fun purge(account: Int, dialogId: Long, ids: List<Int>) {
+        if (ids.isEmpty()) return
+        val keys = ids.map { purgeKey(account, dialogId, it) }
+        purging.addAll(keys)
+        keptInChat[account]?.get(dialogId)?.removeAll(ids.toSet())
+        for (id in ids) TeleDatabaseHelper.removeDeletedMessage(account, dialogId, id)
+        org.telegram.messenger.MessagesController.getInstance(account).deleteMessagesFromUser(ArrayList(ids), null, null, dialogId, 0, false, 0)
+        // the storage and the open chat see the deletion later, the mark has to outlive both
+        AndroidUtilities.runOnUIThread({ purging.removeAll(keys.toSet()) }, 60_000)
+    }
+
     @JvmStatic
     fun fadeMarker(): Boolean = TeleConfig.DELETED_MARKER.value == "fade"
     @JvmStatic
