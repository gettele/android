From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Sat, 7 Nov 2026 00:06:14 +0300
Subject: [PATCH] fix: expose message actions under both names

---
 TMessagesProj/src/main/assets/tele/scripting/runtime.js   | 4 ++++
 TMessagesProj/src/main/java/tele/scripting/ScriptTypes.kt | 1 +
 2 files changed, 5 insertions(+)

diff --git a/TMessagesProj/src/main/assets/tele/scripting/runtime.js b/TMessagesProj/src/main/assets/tele/scripting/runtime.js
index 11e9e17ca..da23478b5 100644
--- a/TMessagesProj/src/main/assets/tele/scripting/runtime.js
+++ b/TMessagesProj/src/main/assets/tele/scripting/runtime.js
@@ -1249,6 +1249,10 @@
 				return given.messageAction(options);
 			},
 
+			messageAction(options) {
+				return given.messageAction(options);
+			},
+
 			registerChatAction(options) {
 				const placements = options?.placements ?? ['chat', 'chatRow'];
 				const disposers = [];
diff --git a/TMessagesProj/src/main/java/tele/scripting/ScriptTypes.kt b/TMessagesProj/src/main/java/tele/scripting/ScriptTypes.kt
index a31da4151..6ceae7d68 100644
--- a/TMessagesProj/src/main/java/tele/scripting/ScriptTypes.kt
+++ b/TMessagesProj/src/main/java/tele/scripting/ScriptTypes.kt
@@ -45,6 +45,7 @@ declare interface Tele {
   onMessageEdited(callback: (message: Message, previous: Message | null) => void): () => void;
   onMessageDeleted(callback: (event: { chatId: bigint | null; ids: bigint[]; messages: (Message | null)[] }) => void): () => void;
   messageAction(options: { text: string; icon?: string; chats?: string | string[]; onClick?: (context: { chatId: bigint; messageId: number; text: string; date: number; out: boolean }) => void }): () => void;
+  registerMessageAction(options: { text: string; icon?: string; chats?: string | string[]; onClick?: (context: { chatId: bigint; messageId: number; text: string; date: number; out: boolean }) => void }): () => void;
   decorateMessages(decorator: (message: Message) => MessageDecoration | null | void | Promise<MessageDecoration | null | void>): () => void;
   decorateMessage(peer: PeerLike, id: number, decoration: MessageDecoration | null): Promise<void>;
   getMe(): Promise<Record<string, unknown>>;
