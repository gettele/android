From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Mon, 5 Oct 2026 19:27:44 +0300
Subject: [PATCH] feat: turn @username into a t.me link in the link box

Typing @handle into the add-link dialog now produces
https://t.me/handle, the same rewrite the compose field does on desktop.

Confidence: high
Scope-risk: narrow
---
 .../org/telegram/ui/Components/EditTextCaption.java   |  2 +-
 .../src/main/java/tele/helpers/LinkRewrites.kt        | 11 +++++++++++
 2 files changed, 12 insertions(+), 1 deletion(-)
 create mode 100644 TMessagesProj/src/main/java/tele/helpers/LinkRewrites.kt

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Components/EditTextCaption.java b/TMessagesProj/src/main/java/org/telegram/ui/Components/EditTextCaption.java
index 6203cff2c..343d012df 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Components/EditTextCaption.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Components/EditTextCaption.java
@@ -479,7 +479,7 @@ public class EditTextCaption extends EditTextBoldCursor implements FloatingToolb
         builder.setView(container);
 
         builder.setPositiveButton(LocaleController.getString(R.string.OK), (dialogInterface, i) -> {
-            callback.run(editText.getText().toString().trim());
+            callback.run(tele.helpers.LinkRewrites.usernameToLink(editText.getText().toString().trim()));
         });
         builder.setNegativeButton(LocaleController.getString(R.string.Cancel), null);
         if (adaptive) {
diff --git a/TMessagesProj/src/main/java/tele/helpers/LinkRewrites.kt b/TMessagesProj/src/main/java/tele/helpers/LinkRewrites.kt
new file mode 100644
index 000000000..aa0b9cfb6
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/LinkRewrites.kt
@@ -0,0 +1,11 @@
+package tele.helpers
+
+object LinkRewrites {
+
+    @JvmStatic
+    fun usernameToLink(url: String): String {
+        val trimmed = url.trim()
+        val match = Regex("^@([a-zA-Z][a-zA-Z0-9_]{3,31})$").find(trimmed) ?: return url
+        return "https://t.me/" + match.groupValues[1]
+    }
+}
\ No newline at end of file
