@@ -65,6 +65,23 @@ object DeletedMessages {
         TeleDatabaseHelper.removeDeletedMessage(account, dialogId, messageId)
     }
 
+    /** Drops the kept mark of messages whose deletion failed on the server; returns the ids that were kept. Storage queue only. */
+    @JvmStatic
+    fun unkeep(account: Int, dialogId: Long, ids: List<Int>): List<Int> {
+        if (ids.isEmpty()) return emptyList()
+        ensureLoaded(account, dialogId)
+        val inChat = keptInChat[account]?.get(dialogId)
+        val result = ArrayList<Int>(ids.size)
+        for (id in ids) {
+            val wasInChat = inChat?.remove(id) == true
+            if (wasInChat || TeleDatabaseHelper.hasDeletedMessage(account, dialogId, id)) {
+                TeleDatabaseHelper.removeDeletedMessage(account, dialogId, id)
+                result.add(id)
+            }
+        }
+        return result
+    }
+
     private val keptInChat = ConcurrentHashMap<Int, ConcurrentHashMap<Long, MutableSet<Int>>>()
     private val loadedDialogs = ConcurrentHashMap.newKeySet<Long>()
 
@@ -173,7 +190,7 @@ object DeletedMessages {
 
     private fun purgeKey(account: Int, dialogId: Long, messageId: Int) = "$account:$dialogId:$messageId"
 
-    private fun isPurging(account: Int, dialogId: Long, messageId: Int) = purging.contains(purgeKey(account, dialogId, messageId))
+    fun isPurging(account: Int, dialogId: Long, messageId: Int) = purging.contains(purgeKey(account, dialogId, messageId))
 
     /** Forgets kept messages: the archive rows and the copies left in the chat. */
     @JvmStatic
