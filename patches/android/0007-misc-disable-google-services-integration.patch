From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?t=CE=B1ngenx?= <me@tangenx.dev>
Date: Thu, 1 Oct 2026 05:30:54 +0300
Subject: [PATCH 007/128] misc: disable google services integration

---
 TMessagesProj/build.gradle     | 1 -
 TMessagesProj_App/build.gradle | 6 +++++-
 2 files changed, 5 insertions(+), 2 deletions(-)

diff --git a/TMessagesProj/build.gradle b/TMessagesProj/build.gradle
index 6f5e7ab1b..087e78f8a 100644
--- a/TMessagesProj/build.gradle
+++ b/TMessagesProj/build.gradle
@@ -260,7 +260,6 @@ def getProps(String propName) {
         return "";
     }
 }
-apply plugin: 'com.google.gms.google-services'
 
 task checkVisibility {
     doFirst {
diff --git a/TMessagesProj_App/build.gradle b/TMessagesProj_App/build.gradle
index b42d5adf7..972b165fd 100644
--- a/TMessagesProj_App/build.gradle
+++ b/TMessagesProj_App/build.gradle
@@ -195,4 +195,8 @@ android {
     }
 }
 
-apply plugin: 'com.google.gms.google-services'
+// firebase (fcm pushes) only for a build given tele's own google-services.json; telegram's stock one doesn't match tele's package
+def teleFirebase = file('google-services.json')
+if (teleFirebase.exists() && teleFirebase.text.contains('"org.telegram.messenger.tele"')) {
+    apply plugin: 'com.google.gms.google-services'
+}
