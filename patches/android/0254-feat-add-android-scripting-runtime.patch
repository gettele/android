+        // what tele 0112 compares between builds: every visible setting plus the section pages
+        @JvmStatic
+        fun settingIds(): List<String> {
+            val ids = ArrayList<String>()
+            SECTION_SPECS.forEach { ids.add("tele/${it.mode}") }
+            for (mode in SECTION_SPECS.map { it.mode } + MODE_ROOT) {
+                for (row in buildRows(mode)) {
