-                    setScrimView(null);
-                    scrimViewTask = null;
-                    scrimViewReaction = null;
-                    contentView.invalidate();
-                    chatListView.invalidate();
-                }
-            }
-        });
-        if (scrimView != null && scrimViewAlpha <= 0f) {
