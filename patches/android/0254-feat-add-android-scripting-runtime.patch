+    private fun displayTitle(value: String): String = when (value) {
+        "Server url" -> "Server URL"
+        "ids" -> "IDs"
+        "Your data" -> "Your Data"
+        "Message menu" -> value
+        else -> if (value.startsWith("tele")) value else value.replaceFirstChar { if (it.isLowerCase()) it.titlecase() else it.toString() }
