+    new_len = js_typed_array_get_length_unsafe(ctx, ret);
+    if (new_len < 0)
+        goto fail;
+    if (require_mutable && typed_array_is_immutable(JS_VALUE_GET_OBJ(ret))) {
+        JS_ThrowTypeErrorImmutableArrayBuffer(ctx);
+        goto fail;
+    }
+    if (argc == 1) {
