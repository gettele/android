+    private fun setupNewPage() {
+        actionBar.createMenu().addItem(SEARCH_ITEM, R.drawable.outline_header_search)
+            .setIsSearchField(true, false)
+            .setActionBarMenuItemSearchListener(object : ActionBarMenuItem.ActionBarMenuItemSearchListener() {
+                override fun onSearchExpand() {
+                    searchNew("")
+                }
+
+                override fun onSearchCollapse() {
+                    searchNew("")
+                }
+
+                override fun onTextChanged(editText: android.widget.EditText) {
+                    searchNew(editText.text.toString())
+                }
+            })
+            .setSearchFieldHint(LocaleController.getString(R.string.Search))
+        // the history is parsed off the main thread; the page fills in when it is ready
+        tele.helpers.TeleChangelogHistory.load { refresh() }
+    }
+
+    private fun searchNew(query: String) {
+        val now = query.trim()
+        if (newState.query == now) return
+        newState.query = now
+        refresh()
+    }
+
+    /** The version chips: one scroll view that is kept, so a scrolled strip stays where it is when a toggle refreshes the page. */
+    private fun newTabsView(context: Context): View {
+        val releases = tele.helpers.TeleChangelogHistory.loaded() ?: emptyList()
+        val selected = newVersionOf(newState, releases)
+        val scroll = newTabs ?: android.widget.HorizontalScrollView(context).also {
+            it.isHorizontalScrollBarEnabled = false
+            newTabs = it
+        }
+        val strip = android.widget.LinearLayout(context)
+        strip.setPadding(AndroidUtilities.dp(12f), AndroidUtilities.dp(4f), AndroidUtilities.dp(12f), AndroidUtilities.dp(8f))
+        for (release in releases) {
+            val active = release.version == selected
+            val chip = TextView(context)
+            chip.text = lc("tele ${release.version}")
+            chip.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14f)
+            chip.gravity = android.view.Gravity.CENTER
+            chip.setPadding(AndroidUtilities.dp(14f), AndroidUtilities.dp(7f), AndroidUtilities.dp(14f), AndroidUtilities.dp(7f))
+            chip.setTextColor(Theme.getColor(if (active) Theme.key_featuredStickers_buttonText else Theme.key_windowBackgroundWhiteBlackText))
+            chip.background = Theme.createRoundRectDrawable(AndroidUtilities.dp(16f), Theme.getColor(if (active) Theme.key_featuredStickers_addButton else Theme.key_windowBackgroundWhite))
+            chip.setOnClickListener {
+                newState.version = release.version
+                newState.picked = true
+                refresh()
+            }
+            val params = android.widget.LinearLayout.LayoutParams(LayoutHelper.WRAP_CONTENT, LayoutHelper.WRAP_CONTENT)
+            params.rightMargin = AndroidUtilities.dp(8f)
+            strip.addView(chip, params)
+        }
+        scroll.removeAllViews()
+        scroll.addView(strip, android.widget.FrameLayout.LayoutParams(LayoutHelper.WRAP_CONTENT, LayoutHelper.WRAP_CONTENT))
+        return scroll
+    }
