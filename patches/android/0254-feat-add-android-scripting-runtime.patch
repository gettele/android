+    override fun createView(context: Context): View {
+        screenContext = context
+        // the search opens the section on the row it points to
+        val page = buildRows(mode)
+        val target = if (jumpId != null) page.firstOrNull { idOf(it) == jumpId } else jumpTo?.let { title -> page.firstOrNull { it.title == title } }
+        val targetKey = target?.item?.key
+        if (targetKey != null) {
+            // a child of a group is shown when its group is expanded
+            parentKeyOf(targetKey)?.let { expandedGroups.add(it) }
+        }
+        teleSearchRow = when {
+            jumpId != null -> withGroups(page).indexOfFirst { idOf(it) == jumpId }
+            jumpTo != null -> withGroups(page).indexOfFirst { it.title == jumpTo }
+            else -> -1
+        }
+        actionBar.setBackButtonImage(R.drawable.ic_ab_back)
+        actionBar.setAllowOverlayTitle(true)
+        actionBar.setTitle(lc(sectionTitle()))
+        actionBar.setActionBarMenuOnItemClick(object : ActionBar.ActionBarMenuOnItemClick() {
+            override fun onItemClick(id: Int) {
+                if (id == -1) finishFragment()
+            }
+        })
+        if (canonicalMode(mode) == MODE_NEW) setupNewPage()
+
+        val frameLayout = FrameLayout(context)
+        frameLayout.setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundGray))
+        fragmentView = frameLayout
+        listView = UniversalRecyclerView(this, this::fillItems, this::onItemClick, this::onItemLongClick)
+        listView!!.setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundGray))
+        listView!!.setSections()
+        listView!!.adapter.setApplyBackground(false)
+        listView!!.setPadding(0, AndroidUtilities.dp(12f), 0, AndroidUtilities.dp(12f))
+        listView!!.setClipToPadding(false)
+        frameLayout.addView(listView, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.MATCH_PARENT.toFloat()))
+        // a link scrolls to its row and highlights it, like the search does
+        if (jumpId != null && teleSearchRow >= 0) {
+            val list = listView!!
+            list.highlightRow(RecyclerListView.IntReturnCallback {
+                (list.layoutManager as? LinearLayoutManager)?.scrollToPositionWithOffset(teleSearchRow, AndroidUtilities.dp(60f))
+                teleSearchRow
+            })
+        }
+        return fragmentView
+    }
+    private fun fillItems(items: ArrayList<UItem>, adapter: UniversalAdapter) {
+        rows = pageRows()
+        rows.forEachIndexed { position, row ->
+            val title = row.title.orEmpty()
+            val shown = lc(displayTitle(title))
+            val subtitle = row.subtitle?.let { lc(it) }
+            if (row.type == TYPE_HEADER) {
+                items.add(UItem.asHeader(position, shown))
+            } else {
+                items.add(when (row.type) {
+                    TYPE_TOGGLE -> {
+                        if (row.expandable) {
+                            UItem.asExpandableSwitch(position, shown, lc("${row.childCount} on")).apply {
+                                 checked = row.item!!.value as Boolean
+                                 collapsed = !expandedGroups.contains(row.item.key)
+                                clickCallback = View.OnClickListener { toggleExpanded(row) }
+                                 bind = Utilities.Callback { view: View ->
+                                     val cell = view as TextCheckCell2
+                                    cell.setCollapseSwitchClick { setGroupValue(row, !(row.item!!.value as Boolean)) }
+                                    cell.setCollapseDividerVisible(false)
+                                    if (!subtitle.isNullOrEmpty()) {
+                                         cell.setTextAndValue(shown, subtitle, true, true)
+                                     }
+                                     cell.setPadding(0, 0, 0, 0)
+                                     cell.setCollapseLayout(AndroidUtilities.dp(140f), true)
+                                 }
+                             }
+                        } else {
+                            val parentEnabled = row.parent?.value as? Boolean ?: true
+                            UItem.asSwitchNoIcon(position, shown).apply {
+                                checked = row.item!!.value as Boolean
+                                enabled = parentEnabled
+                                bind = Utilities.Callback { view: View ->
+                                    val cell = view as TextCheckCell2
+                                    cell.clearCollapseLayout()
+                                    if (!subtitle.isNullOrEmpty()) {
+                                        cell.setTextAndValueAndCheck(shown, subtitle, checked, true, true)
+                                    }
+                                    cell.setPadding(if (row.indent > 0) AndroidUtilities.dp(16f) else 0, 0, 0, 0)
+                                    cell.setEnabled(parentEnabled)
+                                 }
+                            }
+                        }
+                    }
+                    TYPE_VALUE -> UItem.asButton(position, shown, shownValue(row)).apply {
+                        // TextCell dims its own text; alpha on the view would fade the section background too
+                        enabled = row.parent?.value as? Boolean ?: true
+                    }
+                    TYPE_LINK_ICON -> UItem.asButton(position, row.icon, if (row.badge) tele.helpers.TeleNewSettings.withBadge(shown) else if (row.count > 0) tele.ui.TeleCountBadge.withCount(shown, row.count) else if (row.mode == MODE_MENU || row.mode == MODE_RULES) lc(title) else shown)
+                    TYPE_LINK -> UItem.asButton(position, if (row.mode == MODE_MENU || row.mode == MODE_RULES) lc(title) else shown, shownValue(row))
+                    TYPE_SHADOW -> UItem.asShadow(row.title?.let { lc(it) })
+                    TYPE_CUSTOM -> {
+                        val view = customView(row)
+                        if (view == null) UItem.asButton(position, lc(title)) else UItem.asCustom(position, view)
+                    }
+                    else -> UItem.asButton(position, lc(title))
+                }.also { item ->
+                    // a recycled TextCell keeps the shift of a group child, so every text row sets it
+                    if (item.bind == null && row.type != TYPE_SHADOW && row.type != TYPE_CUSTOM) {
+                        val shift = if (row.indent > 0) AndroidUtilities.dp(16f).toFloat() else 0f
+                        item.bind = Utilities.Callback { view: View -> (view as? org.telegram.ui.Cells.TextCell)?.textView?.translationX = shift }
+                    }
+                })
+            }
+        }
+    }
