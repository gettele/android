+package tele.scripting
+
+import android.os.Bundle
+import org.json.JSONObject
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.UserConfig
+import org.telegram.ui.ChatActivity
+import org.telegram.ui.LaunchActivity
+
+/** Navigation requested by a script, always posted to the main thread and never from the script thread. */
+object ScriptUi {
+    @JvmStatic
+    fun openChat(account: Int, peer: JSONObject?) {
+        val target = peer ?: return
+        val args = Bundle()
+        when (target.optString("_")) {
+            "inputPeerSelf" -> args.putLong("user_id", UserConfig.getInstance(account).getClientUserId())
+            "inputPeerUser" -> args.putLong("user_id", target.optLong("userId"))
+            "inputPeerChat" -> args.putLong("chat_id", target.optLong("chatId"))
+            "inputPeerChannel" -> args.putLong("chat_id", target.optLong("channelId"))
+            else -> return
+        }
+        AndroidUtilities.runOnUIThread {
+            LaunchActivity.instance?.actionBarLayout?.presentFragment(ChatActivity(args))
+        }
+    }
+
+    @JvmStatic
+    fun openChat(account: Int, peer: JSONObject?, messageId: Int) {
+        openChat(account, peer)
+    }
+}
diff --git a/TMessagesProj/src/main/java/tele/scripting/ScriptWeb.kt b/TMessagesProj/src/main/java/tele/scripting/ScriptWeb.kt
new file mode 100644
index 0000000..42e1c54
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/scripting/ScriptWeb.kt
@@ -0,0 +1,141 @@
+package tele.scripting
+
+import okhttp3.OkHttpClient
+import okhttp3.Request
+import okhttp3.RequestBody.Companion.toRequestBody
+import okhttp3.Response
+import org.json.JSONObject
+import org.telegram.messenger.FileLog
+import java.io.ByteArrayOutputStream
+import java.net.URI
+import java.util.Base64
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.TimeUnit
+
+/**
+ * The script web platform: fetch through one shared client, bounded, with a per-host grant and
+ * no Telegram credentials. Redirects are followed by hand so every hop is checked again.
+ */
+object ScriptWeb {
+    private const val MAX_BODY = 16 * 1024 * 1024
+    private const val MAX_REDIRECTS = 5
+    private val client = OkHttpClient.Builder()
+        .connectTimeout(20, TimeUnit.SECONDS)
+        .readTimeout(30, TimeUnit.SECONDS)
+        .writeTimeout(30, TimeUnit.SECONDS)
+        .followRedirects(false)
+        .followSslRedirects(false)
+        .build()
+    private val calls = ConcurrentHashMap<String, okhttp3.Call>()
+
+    @JvmStatic
+    fun fetch(runtime: ScriptRuntime, args: JSONObject): JSONObject {
+        val original = args.optString("url").trim()
+        if (original.isEmpty()) throw ScriptException("bad-argument", "fetch needs a url")
+        var uri = parse(original)
+        val method = args.optString("method", "GET").uppercase()
+        val headers = args.optJSONObject("headers")
+        val body = args.optString("body", "").ifEmpty { null }
+        val abort = args.optInt("abort", 0)
+        var redirects = 0
+        while (true) {
+            checkGrant(runtime, uri)
+            val builder = Request.Builder().url(uri.toURL())
+            if (headers != null) {
+                for (name in headers.keys()) {
+                    val value = headers.optString(name)
+                    if (name.equals("host", true) || name.equals("content-length", true)) continue
+                    builder.header(name, value)
+                }
+            }
+            val requestBody = when (method) {
+                "GET", "HEAD" -> null
+                else -> (body ?: "").toRequestBody(null)
+            }
+            val request = builder.method(method, requestBody).build()
+            val call = client.newCall(request)
+            if (abort != 0) calls["$abort"] = call
+            val response = try {
+                call.execute()
+            } catch (e: Throwable) {
+                if (!runtime.running) throw ScriptException("stopped", "the script was stopped")
+                throw ScriptException("network", e.message ?: "the request failed")
+            } finally {
+                if (abort != 0) calls.remove("$abort")
+            }
+            response.use {
+                if (it.isRedirect && redirects < MAX_REDIRECTS) {
+                    val location = it.header("Location") ?: return@use result(it)
+                    redirects++
+                    uri = parse(uri.resolve(location).toString())
+                    return@use null
+                }
+                return result(it)
+            } ?: continue
+        }
+    }
+
+    private fun result(response: Response): JSONObject {
+        val bytes = readBounded(response.body?.byteStream())
+        val headers = JSONObject()
+        for (name in response.headers.names()) {
+            headers.put(name.lowercase(), response.headers.values(name).joinToString(", "))
+        }
+        val text = runCatching { bytes.toString(Charsets.UTF_8) }.getOrDefault("")
+        return JSONObject()
+            .put("status", response.code)
+            .put("statusText", response.message)
+            .put("url", response.request.url.toString())
+            .put("headers", headers)
+            .put("text", if (text.length > MAX_BODY) text.substring(0, MAX_BODY) else text)
+            .put("base64", Base64.getEncoder().encodeToString(bytes))
+    }
+
+    private fun readBounded(input: java.io.InputStream?): ByteArray {
+        if (input == null) return ByteArray(0)
+        val output = ByteArrayOutputStream()
+        val buffer = ByteArray(32 * 1024)
+        var total = 0
+        while (true) {
+            val read = input.read(buffer)
+            if (read < 0) break
+            total += read
+            if (total > MAX_BODY) throw ScriptException("too-big", "the response is larger than 16 MB")
+            output.write(buffer, 0, read)
+        }
+        return output.toByteArray()
+    }
+
+    private fun parse(text: String): URI {
+        val uri = try {
+            URI(text)
+        } catch (e: Throwable) {
+            throw ScriptException("bad-url", "not a valid url: $text")
+        }
+        if (uri.scheme != "http" && uri.scheme != "https") {
+            throw ScriptException("bad-url", "only http and https urls are allowed")
+        }
+        if (uri.host.isNullOrEmpty()) throw ScriptException("bad-url", "the url has no host")
+        return uri
+    }
+
+    private fun checkGrant(runtime: ScriptRuntime, uri: URI) {
+        val host = uri.host.lowercase()
+        if (!runtime.allows("fetch", host)) {
+            throw ScriptException("not-granted", "fetch needs the grant 'fetch($host)'", JSONObject().put("grant", "fetch($host)"))
+        }
+    }
+
+    @JvmStatic
+    fun abort(id: Int) {
+        calls.remove("$id")?.cancel()
+    }
+
+    @JvmStatic
+    fun cancel(runtime: ScriptRuntime) {
+        for (call in calls.values) {
+            runCatching { call.cancel() }
+        }
+        calls.clear()
+    }
+}
diff --git a/TMessagesProj/src/main/java/tele/scripting/Scripts.kt b/TMessagesProj/src/main/java/tele/scripting/Scripts.kt
new file mode 100644
index 0000000..cf0f7cd
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/scripting/Scripts.kt
@@ -0,0 +1,337 @@
+package tele.scripting
+
+import org.json.JSONArray
+import org.json.JSONObject
+import org.telegram.messenger.ApplicationLoader
+import org.telegram.messenger.FileLog
+import org.telegram.messenger.MessageObject
+import org.telegram.messenger.UserConfig
+import org.telegram.messenger.Utilities
+import org.telegram.tgnet.tl.TL_update
+import org.telegram.tgnet.TLRPC
+import tele.TeleConfig
+import java.io.File
+import java.util.concurrent.ConcurrentHashMap
+
+/**
+ * The scripting manager: the folder, per-account enabled state and one runtime per enabled script.
+ * Off means no scan, no thread, no isolate and no stock hook doing anything.
+ */
+object Scripts {
+    private val runtimes = ConcurrentHashMap<String, ScriptRuntime>()
+    private val scans = ConcurrentHashMap<Int, List<ScriptFile>>()
+    private val loaded = ConcurrentHashMap<String, String>()
+    private val messages = ConcurrentHashMap<String, TLRPC.Message>()
+    private val bus = ConcurrentHashMap<String, MutableList<Pair<String, Int>>>()
+    private var started = false
+
+    private fun key(account: Int, id: String) = "$account:$id"
+
+    @JvmStatic
+    fun init() {
+        started = true
+        ScriptTypes.write()
+        if (TeleConfig.SCRIPTING.value) startWhenReady(UserConfig.selectedAccount)
+    }
+
+    private fun startWhenReady(account: Int) {
+        Utilities.globalQueue.postRunnable {
+            try {
+                Thread.sleep(1500)
+            } catch (e: InterruptedException) {
+                return@postRunnable
+            }
+            var tries = 0
+            while (tries++ < 150) {
+                if (!TeleConfig.SCRIPTING.value) return@postRunnable
+                if (UserConfig.getInstance(account).isClientActivated) break
+                try {
+                    Thread.sleep(100)
+                } catch (e: InterruptedException) {
+                    return@postRunnable
+                }
+            }
+            if (TeleConfig.SCRIPTING.value) start(account)
+        }
+    }
+
+    @JvmStatic
+    fun scripts(account: Int): List<ScriptFile> {
+        scans[account]?.let { return it }
+        val list = ScriptScanner.scan()
+        scans[account] = list
+        return list
+    }
+
+    @JvmStatic
+    fun refresh(account: Int): List<ScriptFile> {
+        val list = ScriptScanner.scan()
+        scans[account] = list
+        val alive = list.map { it.id }.toSet()
+        for ((key, runtime) in runtimes) {
+            if (runtime.account == account && runtime.id !in alive) {
+                runtime.stop()
+                runtimes.remove(key)
+            }
+        }
+        for (script in list) {
+            val key = key(account, script.id)
+            val previous = loaded.put(key, script.source)
+            if (previous != null && previous != script.source) {
+                runtimes[key]?.stop()
+                runtimes.remove(key)
+                ScriptStore.addLog(account, script.id, "source changed, the old runtime stopped")
+            }
+        }
+        if (TeleConfig.SCRIPTING.value) start(account)
+        return list
+    }
+
+    @JvmStatic
+    fun start(account: Int) {
+        if (!TeleConfig.SCRIPTING.value) return
+        for (script in scripts(account)) {
+            if (!ScriptStore.enabled(account, script.id)) continue
+            if (script.error != null) continue
+            val grants = ScriptStore.grants(account, script.id)
+            if (ScriptGrants.missing(script.grants, grants).isNotEmpty()) continue
+            start(account, script, grants)
+        }
+    }
+
+    private fun start(account: Int, script: ScriptFile, grants: List<String>) {
+        val key = key(account, script.id)
+        val running = runtimes[key]
+        if (running != null && running.running) return
+        val runtime = ScriptRuntime(account, script.id, script, grants)
+        runtimes[key] = runtime
+        runtime.start()
+    }
+
+    @JvmStatic
+    fun stop(account: Int) {
+        for ((key, runtime) in runtimes) {
+            if (runtime.account != account) continue
+            runtime.stop()
+            runtimes.remove(key)
+        }
+    }
+
+    @JvmStatic
+    fun stopAll() {
+        for ((key, runtime) in runtimes) {
+            runtime.stop()
+            runtimes.remove(key)
+        }
+    }
+
+    @JvmStatic
+    fun runtime(account: Int, id: String): ScriptRuntime? = runtimes[key(account, id)]
+
+    @JvmStatic
+    fun runtimeStopped(runtime: ScriptRuntime) {
+        runtimes.remove(key(runtime.account, runtime.id), runtime)
+    }
+
+    @JvmStatic
+    fun isEnabled(account: Int, id: String): Boolean = ScriptStore.enabled(account, id)
+
+    @JvmStatic
+    fun setEnabled(account: Int, id: String, on: Boolean) {
+        ScriptStore.setEnabled(account, id, on)
+        if (!on) {
+            runtimes[key(account, id)]?.stop()
+            runtimes.remove(key(account, id))
+            ScriptStore.setGrants(account, id, emptyList())
+            return
+        }
+        val script = scripts(account).firstOrNull { it.id == id } ?: return
+        if (ScriptGrants.missing(script.grants, ScriptStore.grants(account, id)).isEmpty()) {
+            start(account, script, ScriptStore.grants(account, id))
+        }
+    }
+
+    @JvmStatic
+    fun approve(account: Int, id: String, grants: List<String>) {
+        ScriptStore.setGrants(account, id, grants)
+        if (!ScriptStore.enabled(account, id)) return
+        val script = scripts(account).firstOrNull { it.id == id } ?: return
+        if (ScriptGrants.missing(script.grants, grants).isEmpty()) {
+            start(account, script, grants)
+        }
+    }
+
+    @JvmStatic
+    fun revoke(account: Int, id: String) {
+        ScriptStore.setGrants(account, id, emptyList())
+        runtimes[key(account, id)]?.stop()
+        runtimes.remove(key(account, id))
+    }
+
+    @JvmStatic
+    fun onConfigChanged() {
+        if (!started) return
+        val account = UserConfig.selectedAccount
+        if (TeleConfig.SCRIPTING.value) {
+            start(account)
+        } else {
+            stopAll()
+        }
+    }
+
+    @JvmStatic
+    fun onAccountChanged(account: Int) {
+        if (!started) return
+        stopAll()
+        if (TeleConfig.SCRIPTING.value) start(account)
+    }
+
+    @JvmStatic
+    fun onUpdate(account: Int, updates: TLRPC.Updates?) {
+        if (updates == null || !TeleConfig.SCRIPTING.value) return
+        val peers = JSONObject()
+        runCatching { peers.put("users", JSONArray(updates.users.map { ScriptTl.json(it) })) }
+        runCatching { peers.put("chats", JSONArray(updates.chats.map { ScriptTl.json(it) })) }
+        val list = mutableListOf<TLRPC.Update>()
+        when (updates) {
+            is TLRPC.TL_updateShort -> list.add(updates.update)
+            is TLRPC.TL_updates -> list.addAll(updates.updates)
+            is TLRPC.TL_updatesCombined -> list.addAll(updates.updates)
+        }
+        val json = ScriptTl.json(updates)
+        for ((key, runtime) in runtimes) {
+            if (runtime.account != account) continue
+            runtime.notifyUpdate(json)
+        }
+        for (update in list) {
+            val updateJson = ScriptTl.json(update)
+            val kind = updateJson.optString("_")
+            when (kind) {
+                "updateNewMessage", "updateNewChannelMessage" -> {
+                    cacheMessage(update)
+                    notifyAll(account, "new", updateJson, peers)
+                }
+                "updateEditMessage", "updateEditChannelMessage" -> {
+                    cacheMessage(update)
+                    notifyAll(account, "edit", updateJson, peers)
+                }
+                "updateDeleteMessages", "updateDeleteChannelMessages" -> {
+                    notifyAll(account, "delete", updateJson, peers)
+                }
+            }
+        }
+        if (updates is TLRPC.TL_updateShortMessage || updates is TLRPC.TL_updateShortChatMessage) {
+            notifyAll(account, "new", ScriptTl.json(updates), peers)
+        }
+    }
+
+    private fun cacheMessage(update: TLRPC.Update) {
+        val message = when (update) {
+            is TL_update.TL_updateNewMessage -> update.message
+            is TL_update.TL_updateNewChannelMessage -> update.message
+            is TL_update.TL_updateEditMessage -> update.message
+            is TL_update.TL_updateEditChannelMessage -> update.message
+            else -> null
+        } ?: return
+        val peer = message.peer_id ?: return
+        val peerId = when (peer) {
+            is TLRPC.TL_peerUser -> peer.user_id
+            is TLRPC.TL_peerChat -> -peer.chat_id
+            is TLRPC.TL_peerChannel -> -1000000000000L - peer.channel_id
+            else -> 0L
+        }
+        if (peerId == 0L || message.id == 0) return
+        messages["$peerId:${message.id}"] = message
+        if (messages.size > 5000) messages.clear()
+    }
+
+    private fun notifyAll(account: Int, kind: String, update: JSONObject, peers: JSONObject) {
+        for (runtime in runtimes.values) {
+            if (runtime.account == account) runtime.notify(kind, update, peers)
+        }
+    }
+
+    @JvmStatic
+    fun cachedMessage(account: Int, peerId: String, id: Long): JSONObject? {
+        val marked = peerId.toLongOrNull() ?: return null
+        val message = messages["$marked:$id"] ?: return null
+        return ScriptTl.messageJson(message)
+    }
+
+    @JvmStatic
+    fun decorateSync(account: Int, message: MessageObject): Decoration? {
+        if (!TeleConfig.SCRIPTING.value) return null
+        var result: Decoration? = null
+        for (runtime in runtimes.values) {
+            if (runtime.account != account) continue
+            runtime.decorationFor(message)?.let { result = it }
+        }
+        return result
+    }
+
+    @JvmStatic
+    fun menu(account: Int, chatKind: String? = null): List<ScriptMenuItem> = ScriptMenu.list(account, chatKind)
+
+    @JvmStatic
+    fun invokeMenu(account: Int, script: String, callback: Int, context: JSONObject): Boolean =
+        ScriptMenu.invoke(account, script, callback, context)
+
+    @JvmStatic
+    fun host(runtime: ScriptRuntime, name: String, args: JSONObject?): Any? {
+        return when (name) {
+            "scripts.list" -> {
+                val array = JSONArray()
+                for (script in scripts(runtime.account)) {
+                    array.put(JSONObject().put("id", script.id).put("name", script.name))
+                }
+                array
+            }
+            "scripts.emit" -> {
+                val event = args?.optString("event").orEmpty()
+                val target = args?.opt("to")
+                val data = args?.opt("data")
+                val message = JSONObject().put("from", runtime.id).put("data", data ?: JSONObject.NULL)
+                bus[event]?.let { list ->
+                    for ((script, callback) in list) {
+                        if (target != null && target != JSONObject.NULL && target.toString() != script) continue
+                        val other = runtimes[key(runtime.account, script)] ?: continue
+                        other.dispatch(callback, "scripts", JSONArray().put(message))
+                    }
+                }
+                true
+            }
+            "scripts.on" -> {
+                val event = args?.optString("event").orEmpty()
+                val callback = args?.optInt("id") ?: 0
+                bus.getOrPut(event) { ArrayList() }.add(runtime.id to callback)
+                true
+            }
+            "scripts.off" -> {
+                val callback = args?.optInt("value") ?: 0
+                for (list in bus.values) list.removeAll { it.second == callback }
+                true
+            }
+            else -> throw ScriptException("unsupported", "$name is not available to scripts on android yet")
+        }
+    }
+
+    @JvmStatic
+    fun options(runtime: ScriptRuntime): JSONArray = JSONArray()
+
+    @JvmStatic
+    fun log(account: Int, id: String): List<String> = ScriptStore.log(account, id)
+
+    @JvmStatic
+    fun clearLog(account: Int, id: String) = ScriptStore.clearLog(account, id)
+
+    @JvmStatic
+    fun path(): File = ScriptScanner.root()
+
+    @JvmStatic
+    fun delete(account: Int, id: String): Boolean {
+        runtimes[key(account, id)]?.stop()
+        runtimes.remove(key(account, id))
+        scans.remove(account)
+        return ScriptScanner.delete(id)
+    }
+}
diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleScriptsActivity.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleScriptsActivity.kt
new file mode 100644
index 0000000..a21f476
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleScriptsActivity.kt
@@ -0,0 +1,304 @@
+package tele.ui.settings
+
+import android.app.Activity
+import android.content.Context
+import android.content.Intent
+import android.net.Uri
+import android.provider.OpenableColumns
+import android.view.View
+import android.widget.FrameLayout
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.R
+import org.telegram.messenger.Utilities
+import org.telegram.ui.ActionBar.ActionBar
+import org.telegram.ui.ActionBar.AlertDialog
+import org.telegram.ui.ActionBar.BaseFragment
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Components.BulletinFactory
+import org.telegram.ui.Components.ItemOptions
+import org.telegram.ui.Components.LayoutHelper
+import org.telegram.ui.Components.UItem
+import org.telegram.ui.Components.UniversalAdapter
+import org.telegram.ui.Components.UniversalRecyclerView
+import tele.TeleConfig
+import tele.TeleHooks
+import tele.scripting.ScriptFile
+import tele.scripting.ScriptGrants
+import tele.scripting.ScriptScanner
+import tele.scripting.ScriptStore
+import tele.scripting.Scripts
+import java.util.ArrayList
+
+/** The scripts manager: the master switch, the folder, SAF import and one switch per script. */
+class TeleScriptsActivity : BaseFragment() {
+
+    private var recycler: UniversalRecyclerView? = null
+    private var pending: ScriptFile? = null
+    private var pendingUri: Uri? = null
+
+    private fun fillItems(items: ArrayList<UItem>, adapter: UniversalAdapter) {
+        val account = currentAccount
+        val scripts = Scripts.scripts(account)
+        items.add(UItem.asHeader("Scripts"))
+        items.add(
+            UItem.asSwitchNoIcon(ID_MASTER, "Enable scripting")
+                .setChecked(TeleConfig.SCRIPTING.value)
+        )
+        items.add(
+            UItem.asShadow(
+                "Scripts run in a separate thread with their own QuickJS runtime. Imported code is untrusted: it only gets the permissions you approve, and only the selected account sees its effects."
+            )
+        )
+        items.add(UItem.asButton(ID_FOLDER, "Open scripts folder", Scripts.path().absolutePath))
+        items.add(UItem.asButton(ID_IMPORT, "Import a script"))
+        items.add(UItem.asHeader("Installed"))
+        if (scripts.isEmpty()) {
+            items.add(UItem.asShadow("No scripts yet. Import a .js, .mjs, .ts or .mts file."))
+        }
+        for ((index, script) in scripts.withIndex()) {
+            items.add(
+                UItem.asSwitchNoIcon(ID_SCRIPT + index, script.name)
+                    .setChecked(Scripts.isEnabled(account, script.id))
+            )
+            val error = script.error ?: ScriptStore.lastError(account, script.id)
+            val status = when {
+                error != null -> "Error: $error"
+                Scripts.isEnabled(account, script.id) -> "On · ${script.id}"
+                else -> "Off · ${script.id}"
+            }
+            items.add(UItem.asShadow(status))
+        }
+    }
+
+    private fun click(item: UItem, view: View, position: Int, x: Float, y: Float) {
+        val account = currentAccount
+        when (item.id) {
+            ID_MASTER -> {
+                val checked = !TeleConfig.SCRIPTING.value
+                TeleConfig.set(TeleConfig.SCRIPTING, checked)
+                TeleHooks.onConfigChanged(TeleConfig.SCRIPTING)
+                if (checked) Scripts.start(account) else Scripts.stop(account)
+                recycler?.adapter?.update(true)
+                return
+            }
+            ID_FOLDER -> {
+                val path = Scripts.path().absolutePath
+                AlertDialog.Builder(parentActivity ?: return, resourceProvider)
+                    .setTitle("Scripts folder")
+                    .setMessage(path)
+                    .setPositiveButton("Copy") { _, _ ->
+                        AndroidUtilities.addToClipboard(path)
+                        BulletinFactory.of(this).createSimpleBulletin(R.raw.info, "Path copied").show()
+                    }
+                    .setNegativeButton("Close", null)
+                    .show()
+                return
+            }
+            ID_IMPORT -> {
+                pickScript()
+                return
+            }
+            else -> {
+                if (item.id < ID_SCRIPT) return
+                val script = Scripts.scripts(account).getOrNull(item.id - ID_SCRIPT) ?: return
+                toggle(script)
+                return
+            }
+        }
+    }
+
+    private fun longClick(item: UItem, view: View, position: Int, x: Float, y: Float): Boolean {
+        if (item.id < ID_SCRIPT) return false
+        val script = Scripts.scripts(currentAccount).getOrNull(item.id - ID_SCRIPT) ?: return true
+        ItemOptions.makeOptions(this, view)
+            .add(R.drawable.msg_permissions, "Review permissions", Runnable { showGrants(script) })
+            .add(R.drawable.msg_message, "Open log", Runnable { showLog(script) })
+            .add(R.drawable.msg_retry, "Restart", Runnable {
+                Scripts.setEnabled(currentAccount, script.id, false)
+                Scripts.setEnabled(currentAccount, script.id, true)
+                recycler?.adapter?.update(true)
+            })
+            .add(R.drawable.msg_delete, "Remove", Runnable { remove(script) })
+            .show()
+        return true
+    }
+
+    private fun toggle(script: ScriptFile) {
+        val account = currentAccount
+        val enabled = Scripts.isEnabled(account, script.id)
+        if (enabled) {
+            Scripts.setEnabled(account, script.id, false)
+            recycler?.adapter?.update(true)
+            return
+        }
+        if (script.error != null) {
+            BulletinFactory.of(this).createSimpleBulletin(R.raw.error, script.error).show()
+            return
+        }
+        val approved = ScriptStore.grants(account, script.id)
+        if (ScriptGrants.missing(script.grants, approved).isNotEmpty()) {
+            askGrants(script) {
+                Scripts.approve(account, script.id, script.grants)
+                Scripts.setEnabled(account, script.id, true)
+                recycler?.adapter?.update(true)
+            }
+        } else {
+            Scripts.setEnabled(account, script.id, true)
+            recycler?.adapter?.update(true)
+        }
+    }
+
+    private fun askGrants(script: ScriptFile, onAllowed: () -> Unit) {
+        val message = StringBuilder()
+        var dangerous = false
+        for (raw in script.grants) {
+            val grant = ScriptGrants.parse(raw) ?: continue
+            if (ScriptGrants.dangerous(grant)) dangerous = true
+            message.append("• ").append(ScriptGrants.consentLine(grant)).append('\n')
+        }
+        if (message.isEmpty()) message.append("This script does not ask for anything.")
+        if (dangerous) {
+            message.append("\nThis can change your account, call Telegram or change what you see. Only allow code you trust.")
+        }
+        AlertDialog.Builder(parentActivity ?: return, resourceProvider)
+            .setTitle("Allow ${script.name}?")
+            .setMessage(message.toString().trim())
+            .setPositiveButton("Allow") { _, _ -> onAllowed() }
+            .setNegativeButton("Cancel", null)
+            .show()
+    }
+
+    private fun showGrants(script: ScriptFile) {
+        val approved = ScriptStore.grants(currentAccount, script.id)
+        val message = StringBuilder()
+        for (raw in script.grants) {
+            val grant = ScriptGrants.parse(raw) ?: continue
+            message.append(if (approved.any { ScriptGrants.covers(ScriptGrants.parse(it) ?: return@any false, grant) }) "Allowed · " else "Missing · ")
+                .append(ScriptGrants.consentLine(grant)).append('\n')
+        }
+        AlertDialog.Builder(parentActivity ?: return, resourceProvider)
+            .setTitle(script.name)
+            .setMessage(message.toString().trim().ifEmpty { "No permissions." })
+            .setPositiveButton("Allow what is missing") { _, _ ->
+                askGrants(script) {
+                    Scripts.approve(currentAccount, script.id, script.grants)
+                    recycler?.adapter?.update(true)
+                }
+            }
+            .setNeutralButton("Revoke") { _, _ ->
+                Scripts.revoke(currentAccount, script.id)
+                recycler?.adapter?.update(true)
+            }
+            .setNegativeButton("Close", null)
+            .show()
+    }
+
+    private fun showLog(script: ScriptFile) {
+        val lines = Scripts.log(currentAccount, script.id)
+        AlertDialog.Builder(parentActivity ?: return, resourceProvider)
+            .setTitle("${script.name} log")
+            .setMessage(lines.joinToString("\n").ifEmpty { "The log is empty." })
+            .setPositiveButton("Close", null)
+            .setNeutralButton("Clear") { _, _ ->
+                Scripts.clearLog(currentAccount, script.id)
+            }
+            .show()
+    }
+
+    private fun remove(script: ScriptFile) {
+        AlertDialog.Builder(parentActivity ?: return, resourceProvider)
+            .setTitle("Remove ${script.name}?")
+            .setMessage("The source file is deleted from the scripts folder. The approvals and storage stay per account.")
+            .setPositiveButton("Remove") { _, _ ->
+                Scripts.delete(currentAccount, script.id)
+                recycler?.adapter?.update(true)
+            }
+            .setNegativeButton("Cancel", null)
+            .show()
+    }
+
+    private fun pickScript() {
+        try {
+            val intent = Intent(Intent.ACTION_OPEN_DOCUMENT).apply {
+                addCategory(Intent.CATEGORY_OPENABLE)
+                type = "*/*"
+                putExtra(
+                    Intent.EXTRA_MIME_TYPES,
+                    arrayOf("text/javascript", "application/javascript", "text/plain", "application/octet-stream")
+                )
+            }
+            startActivityForResult(intent, REQUEST_IMPORT)
+        } catch (e: Throwable) {
+            BulletinFactory.of(this).createSimpleBulletin(R.raw.error, "No file picker").show()
+        }
+    }
+
+    override fun onActivityResultFragment(requestCode: Int, resultCode: Int, data: Intent?) {
+        super.onActivityResultFragment(requestCode, resultCode, data)
+        if (requestCode != REQUEST_IMPORT || resultCode != Activity.RESULT_OK) return
+        val uri = data?.data ?: return
+        pendingUri = uri
+        import(uri, replace = false)
+    }
+
+    private fun import(uri: Uri, replace: Boolean) {
+        val activity = parentActivity ?: return
+        Utilities.globalQueue.postRunnable {
+            val result = ScriptScanner.importFrom(activity, uri, replace)
+            AndroidUtilities.runOnUIThread {
+                if (result.second == "exists") {
+                    AlertDialog.Builder(activity, resourceProvider)
+                        .setTitle("Replace the script?")
+                        .setMessage("A script with this name is already in the folder.")
+                        .setPositiveButton("Replace") { _, _ -> import(uri, replace = true) }
+                        .setNegativeButton("Cancel", null)
+                        .show()
+                } else if (result.second != null) {
+                    BulletinFactory.of(this).createSimpleBulletin(R.raw.error, result.second).show()
+                } else {
+                    Scripts.refresh(currentAccount)
+                    recycler?.adapter?.update(true)
+                    BulletinFactory.of(this).createSimpleBulletin(R.raw.info, "Imported ${result.first}. It is off until you enable it and allow its permissions.").show()
+                }
+            }
+        }
+    }
+
+    override fun createView(context: Context): View {
+        actionBar.setBackButtonImage(R.drawable.ic_ab_back)
+        actionBar.setAllowOverlayTitle(true)
+        actionBar.setTitle("tele · Scripts")
+        actionBar.setActionBarMenuOnItemClick(object : ActionBar.ActionBarMenuOnItemClick() {
+            override fun onItemClick(id: Int) {
+                if (id == -1) finishFragment()
+            }
+        })
+        val frame = FrameLayout(context)
+        frame.setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundGray))
+        fragmentView = frame
+        val list = UniversalRecyclerView(this, this::fillItems, this::click, this::longClick)
+        list.setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundGray))
+        list.setSections()
+        list.adapter.setApplyBackground(false)
+        list.setPadding(0, AndroidUtilities.dp(12f), 0, AndroidUtilities.dp(12f))
+        list.setClipToPadding(false)
+        frame.addView(list, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.MATCH_PARENT.toFloat()))
+        recycler = list
+        return frame
+    }
+
+    override fun onResume() {
+        super.onResume()
+        Scripts.refresh(currentAccount)
+        recycler?.adapter?.update(true)
+    }
+
+    companion object {
+        private const val ID_MASTER = 1
+        private const val ID_FOLDER = 2
+        private const val ID_IMPORT = 3
+        private const val ID_SCRIPT = 100
+        private const val REQUEST_IMPORT = 411
+    }
+}
