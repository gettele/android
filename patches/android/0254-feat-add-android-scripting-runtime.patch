+JNIEXPORT jlong JNICALL
+Java_tele_scripting_QuickJs_create(JNIEnv *env, jclass, jint memoryLimit, jint stackSize, jobject host) {
+    auto *runtime = new Runtime();
+    runtime->rt = JS_NewRuntime();
+    if (runtime->rt == nullptr) {
+        delete runtime;
+        return 0;
+    }
+    runtime->ctx = JS_NewContext(runtime->rt);
+    if (runtime->ctx == nullptr) {
+        JS_FreeRuntime(runtime->rt);
+        delete runtime;
+        return 0;
+    }
+    JS_SetMemoryLimit(runtime->rt, static_cast<size_t>(memoryLimit));
+    JS_SetMaxStackSize(runtime->rt, static_cast<size_t>(stackSize));
+    JS_SetInterruptHandler(runtime->rt, InterruptHandler, runtime);
+    JS_SetContextOpaque(runtime->ctx, runtime);
+    jclass hostClass = env->GetObjectClass(host);
+    runtime->invoke = env->GetMethodID(hostClass, "invoke", "(JLjava/lang/String;Ljava/lang/String;)Ljava/lang/String;");
+    env->DeleteLocalRef(hostClass);
+    if (runtime->invoke == nullptr) {
+        if (env->ExceptionCheck()) env->ExceptionClear();
+        JS_FreeContext(runtime->ctx);
+        JS_FreeRuntime(runtime->rt);
+        delete runtime;
+        return 0;
+    }
+    runtime->host = env->NewGlobalRef(host);
+    JSValue global = JS_GetGlobalObject(runtime->ctx);
+    JS_SetPropertyStr(runtime->ctx, global, "__teleHost",
+                      JS_NewCFunction(runtime->ctx, HostFunction, "__teleHost", 2));
+    JS_FreeValue(runtime->ctx, global);
+    {
+        std::lock_guard<std::mutex> guard(g_lock);
+        g_runtimes.insert(runtime);
+    }
+    if (g_vm == nullptr) env->GetJavaVM(&g_vm);
+    return reinterpret_cast<jlong>(runtime);
+}
+
+JNIEXPORT void JNICALL
+Java_tele_scripting_QuickJs_destroy(JNIEnv *env, jclass, jlong handle) {
+    auto *runtime = GetRuntime(handle);
+    if (runtime == nullptr) return;
+    {
+        std::lock_guard<std::mutex> guard(g_lock);
+        g_runtimes.erase(runtime);
+    }
+    runtime->interrupted.store(true);
+    if (runtime->ctx != nullptr) JS_FreeContext(runtime->ctx);
+    if (runtime->rt != nullptr) JS_FreeRuntime(runtime->rt);
+    if (runtime->host != nullptr) env->DeleteGlobalRef(runtime->host);
+    delete runtime;
+}
+
+JNIEXPORT jstring JNICALL
+Java_tele_scripting_QuickJs_eval(JNIEnv *env, jclass, jlong handle, jstring source, jstring filename, jboolean module) {
+    auto *runtime = GetRuntime(handle);
+    if (runtime == nullptr) return ErrorString(env, "runtime is gone");
+    const std::string code = Utf8(env, source);
+    const std::string file = filename != nullptr ? Utf8(env, filename) : std::string("script.js");
+    const int flags = module ? (JS_EVAL_TYPE_MODULE | JS_EVAL_FLAG_COMPILE_ONLY) : JS_EVAL_TYPE_GLOBAL;
+    JSValue value = JS_Eval(runtime->ctx, code.c_str(), code.size(), file.c_str(), flags);
+    if (JS_IsException(value)) {
+        const std::string error = ExceptionText(runtime->ctx);
+        JS_FreeValue(runtime->ctx, value);
+        return ErrorString(env, error);
+    }
+    if (module) {
+        JSValue result = JS_EvalFunction(runtime->ctx, value);
+        if (JS_IsException(result)) {
+            const std::string error = ExceptionText(runtime->ctx);
+            JS_FreeValue(runtime->ctx, result);
+            return ErrorString(env, error);
+        }
+        JS_FreeValue(runtime->ctx, result);
+    } else {
+        JS_FreeValue(runtime->ctx, value);
+    }
+    return nullptr;
+}
+
+JNIEXPORT jstring JNICALL
+Java_tele_scripting_QuickJs_call(JNIEnv *env, jclass, jlong handle, jstring function, jstring argument) {
+    auto *runtime = GetRuntime(handle);
+    if (runtime == nullptr) return ErrorString(env, "runtime is gone");
+    const std::string name = Utf8(env, function);
+    JSValue global = JS_GetGlobalObject(runtime->ctx);
+    JSValue target = JS_GetPropertyStr(runtime->ctx, global, name.c_str());
+    JS_FreeValue(runtime->ctx, global);
+    if (!JS_IsFunction(runtime->ctx, target)) {
+        JS_FreeValue(runtime->ctx, target);
+        return ErrorString(env, "no function " + name);
+    }
+    JSValue result;
+    if (argument != nullptr) {
+        const std::string text = Utf8(env, argument);
+        JSValue arg = JS_NewStringLen(runtime->ctx, text.c_str(), text.size());
+        result = JS_Call(runtime->ctx, target, JS_UNDEFINED, 1, &arg);
+        JS_FreeValue(runtime->ctx, arg);
+    } else {
+        result = JS_Call(runtime->ctx, target, JS_UNDEFINED, 0, nullptr);
+    }
+    JS_FreeValue(runtime->ctx, target);
+    if (JS_IsException(result)) {
+        const std::string error = ExceptionText(runtime->ctx);
+        JS_FreeValue(runtime->ctx, result);
+        return ErrorString(env, error);
+    }
+    JS_FreeValue(runtime->ctx, result);
+    return nullptr;
+}
+
+JNIEXPORT jstring JNICALL
+Java_tele_scripting_QuickJs_callString(JNIEnv *env, jclass, jlong handle, jstring function, jstring argument) {
+    auto *runtime = GetRuntime(handle);
+    if (runtime == nullptr) return nullptr;
+    const std::string name = Utf8(env, function);
+    JSValue global = JS_GetGlobalObject(runtime->ctx);
+    JSValue target = JS_GetPropertyStr(runtime->ctx, global, name.c_str());
+    JS_FreeValue(runtime->ctx, global);
+    if (!JS_IsFunction(runtime->ctx, target)) {
+        JS_FreeValue(runtime->ctx, target);
+        return nullptr;
+    }
+    JSValue result;
+    if (argument != nullptr) {
+        const std::string text = Utf8(env, argument);
+        JSValue arg = JS_NewStringLen(runtime->ctx, text.c_str(), text.size());
+        result = JS_Call(runtime->ctx, target, JS_UNDEFINED, 1, &arg);
+        JS_FreeValue(runtime->ctx, arg);
+    } else {
+        result = JS_Call(runtime->ctx, target, JS_UNDEFINED, 0, nullptr);
+    }
+    JS_FreeValue(runtime->ctx, target);
+    if (JS_IsException(result)) {
+        JS_FreeValue(runtime->ctx, result);
+        return nullptr;
+    }
+    if (JS_IsString(result)) {
+        size_t length = 0;
+        const char *text = JS_ToCStringLen2(runtime->ctx, &length, result, false);
+        jstring out = text != nullptr ? JavaString(env, text, length) : nullptr;
+        if (text != nullptr) JS_FreeCString(runtime->ctx, text);
+        JS_FreeValue(runtime->ctx, result);
+        return out;
+    }
+    JS_FreeValue(runtime->ctx, result);
+    return nullptr;
+}
+
+JNIEXPORT jstring JNICALL
+Java_tele_scripting_QuickJs_runJobs(JNIEnv *env, jclass, jlong handle) {
+    auto *runtime = GetRuntime(handle);
+    if (runtime == nullptr) return ErrorString(env, "runtime is gone");
+    JSContext *context = nullptr;
+    while (true) {
+        const int state = JS_ExecutePendingJob(runtime->rt, &context);
+        if (state == 0) return nullptr;
+        if (state < 0) {
+            JSContext *ctx = context != nullptr ? context : runtime->ctx;
+            return ErrorString(env, ExceptionText(ctx));
+        }
+    }
+}
+
+JNIEXPORT void JNICALL
+Java_tele_scripting_QuickJs_interrupt(JNIEnv *, jclass, jlong handle) {
+    auto *runtime = GetRuntime(handle);
+    if (runtime != nullptr) runtime->interrupted.store(true);
+}
