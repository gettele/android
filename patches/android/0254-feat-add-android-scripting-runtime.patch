+        if (option >= tele_option_script_base) {
+            final int tele_script_index = option - tele_option_script_base;
+            if (tele_script_index >= 0 && tele_script_index < tele_scriptMenuItems.size()) {
+                final tele.scripting.ScriptMenuItem tele_script_item = tele_scriptMenuItems.get(tele_script_index);
+                final org.json.JSONObject tele_script_context = new org.json.JSONObject();
+                try {
+                    tele_script_context.put("chatId", selectedObject.getDialogId());
+                    tele_script_context.put("messageId", selectedObject.getId());
+                    tele_script_context.put("text", selectedObject.messageText == null ? "" : selectedObject.messageText.toString());
+                    tele_script_context.put("date", selectedObject.messageOwner == null ? 0 : selectedObject.messageOwner.date);
+                    tele_script_context.put("out", selectedObject.isOut());
+                } catch (Throwable ignored) {
+                }
+                tele.scripting.Scripts.invokeMenu(currentAccount, tele_script_item.scriptId, tele_script_item.callbackId, tele_script_context);
+            }
+            return;
+        }
+        boolean preserveDim = false;
+        switch (option) {
+            case OPTION_RETRY: {
+                final MessageObject object = selectedObject;
+                final MessageObject.GroupedMessages group = selectedObjectGroup;
+                AlertsCreator.ensurePaidMessageConfirmation(currentAccount, getDialogId(), group != null ? group.messages.size() : 1, payStars -> {
+                    if (group != null) {
+                        boolean success = true;
+                        for (int a = 0; a < group.messages.size(); a++) {
+                            if (!getSendMessagesHelper().retrySendMessage(group.messages.get(a), false, payStars)) {
+                                success = false;
+                            }
+                        }
+                        if (success && chatMode == 0) {
+                            moveScrollToLastMessage(false);
+                        }
+                    } else {
+                        if (getSendMessagesHelper().retrySendMessage(object, false, payStars)) {
+                            updateVisibleRows();
+                            if (chatMode == 0) {
+                                moveScrollToLastMessage(false);
+                            }
