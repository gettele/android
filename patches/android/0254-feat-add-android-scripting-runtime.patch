+
+    companion object {
+
+        private val DELETED_RETENTION_LABELS = arrayOf("1 day", "7 days", "30 days", "Forever")
+
+        /** The parent toggles with their children: the children are shown when the group is expanded. */
+        private val GROUPS = mapOf(
+            TeleConfig.KEEP_DELETED_MESSAGES.key to listOf(
+                TeleConfig.KEEP_SELF_DELETED_MESSAGES.key,
+                TeleConfig.KEEP_DELETED_BOTS.key,
+                TeleConfig.KEEP_DELETED_SAVED.key,
+                TeleConfig.KEEP_DELETED_OWN.key,
+                TeleConfig.KEEP_DELETED_CHATS.key,
+                TeleConfig.DELETED_RETENTION.key,
+                TeleConfig.RECOVER_FORWARDED_POSTS.key,
+                TeleConfig.DELETED_MARKER.key,
+                TeleConfig.DELETED_REPLY.key,
+                TeleConfig.DELETED_QUOTE_NAME.key
+            ),
+            TeleConfig.SHOW_PEER_ID.key to listOf(
+                TeleConfig.PEER_IDS_WITHOUT_SPACES.key,
+                TeleConfig.BOT_API_PEER_IDS.key,
+                TeleConfig.SHOW_DC.key,
+                TeleConfig.MERGE_ID_DC.key
+            ),
+            TeleConfig.QUEUE_BEHIND_MEDIA.key to listOf(
+                TeleConfig.SEND_OLDER_REPLIES.key,
+                TeleConfig.DOUBLE_ENTER_SEND.key
+            ),
+            TeleConfig.CONFIRM_SEND.key to listOf(
+                TeleConfig.CONFIRM_STICKERS.key,
+                TeleConfig.CONFIRM_GIFS.key,
+                TeleConfig.CONFIRM_VOICE.key
+            ),
+            TeleConfig.HIDE_COUNTERS.key to listOf(
+                TeleConfig.HIDE_FOLDER_COUNTERS.key,
+                TeleConfig.HIDE_APP_COUNTER.key,
+                TeleConfig.COUNTER_SKIP_ARCHIVE.key
+            ),
+            TeleConfig.CALCMULA.key to listOf(
+                TeleConfig.CALCMULA_PREVIEW.key,
+                TeleConfig.CALCMULA_SUGGESTIONS.key,
+                TeleConfig.CALCMULA_INLINE_RESULT.key
+            ),
+            TeleConfig.LIVE_MARKDOWN.key to listOf(
+                TeleConfig.LIVE_MARKDOWN_QUOTES.key
+            ),
+            TeleConfig.PROFILE_PHOTO_BACKGROUND.key to listOf(
+                TeleConfig.PROFILE_PHOTO_BACKGROUND_COLOR.key
+            ),
+            TeleConfig.NOTICES.key to listOf(
+                TeleConfig.NOTICES_LOG_LIMITS.key,
+                TeleConfig.NOTICES_MENTIONS.key,
+                TeleConfig.NOTICES_COPIES.key,
+                TeleConfig.NOTICES_TELE_TOASTS.key
+            ),
+            TeleConfig.INVISIBLE_NAMES.key to listOf(
+                TeleConfig.INVISIBLE_NAMES_FALLBACK.key,
+                TeleConfig.INVISIBLE_NAMES_PHRASE.key
+            )
+        )
+
+        init {
+            // the groups are built once: a group can't hold itself and the parents can't be nested
+            for ((parent, children) in GROUPS) {
+                check(parent !in children) { "the group $parent holds itself" }
+                for (child in children) {
+                    check(child !in GROUPS) { "the group $parent holds the group $child" }
+                }
+            }
+        }
+        const val MODE_ROOT = "root"
+        const val MODE_INTERFACE = "interface"
+        const val MODE_CHATS = "chats"
+        const val MODE_MESSAGES = "messages"
