+    private fun onItemClick(item: UItem, view: View, position: Int, x: Float, y: Float) {
+        val row = rows.getOrNull(item.id) ?: return
+        when {
+            row.type == TYPE_TOGGLE && row.item != null -> {
+                if (row.expandable) {
+                    val switchArea = if (org.telegram.messenger.LocaleController.isRTL) x < AndroidUtilities.dp(76f) else x > view.width - AndroidUtilities.dp(76f)
+                    if (switchArea) setGroupValue(row, !(row.item!!.value as Boolean)) else toggleExpanded(row)
+                    return
+                }
+                if (GROUPS.containsKey(row.item.key)) {
+                    // a group parent on the what's new page turns its children on like on its own page
+                    setGroupValue(row, !(row.item.value as Boolean))
+                    return
+                }
+                if (tele.helpers.StarsLock.isProtectedOption(row.item) && row.item.value == true) {
+                    // switching a protection off needs the password; the switch stays on until then
+                    tele.helpers.StarsLock.confirm(parentActivity, resourceProvider, Runnable {
+                        setValue(row.item, false)
+                        refresh()
+                    })
+                    return
+                }
+                if (row.item == TeleConfig.MTP_INSPECTOR && row.item.value != true) {
+                    val activity = parentActivity ?: return
+                    AlertDialog.Builder(activity, resourceProvider)
+                        .setTitle(lc("Debug logs"))
+                        .setMessage(lc("Do you want to enable DEBUG logs? All network events will be logged."))
+                        .setPositiveButton(lc("Enable")) { _, _ ->
+                            item.checked = true
+                            (view as TextCheckCell2).setChecked(true)
+                            setValue(row.item, true)
+                            refresh()
+                        }
+                        .setNegativeButton(lc("Cancel"), null)
+                        .show()
+                    return
+                }
+                val checked = !item.checked
+                item.checked = checked
+                (view as TextCheckCell2).setChecked(checked)
+                val parent = row.parent
+                if (parent != null && parent.value as? Boolean != true) {
+                    // the parent gates its children, it turns on first
+                    setValue(parent, true)
+                }
+                TeleConfig.set(row.item, checked)
+                android.util.Log.d("TeleToggle", "key=${row.item.key} state=$checked")
+                if (row.item == TeleConfig.IGNORE_FADE) {
+                    tele.helpers.PrivacyRules.setIgnoredModes(
+                        UserConfig.selectedAccount,
+                        if (checked) tele.helpers.PrivacyRules.MODE_FADE else tele.helpers.PrivacyRules.MODE_HIDE
+                    )
+                    tele.TeleHooks.onPrivacyRulesChanged()
+                }
+                TeleHooks.onConfigChanged(row.item)
+                refresh()
+            }
+            row.type == TYPE_VALUE && row.item == TeleConfig.LINK_PREVIEW_MODE -> chooseLinkPreviewMode()
+            row.type == TYPE_VALUE && row.item == TeleConfig.DELETED_MARKER -> chooseDeletedMarker()
+            row.type == TYPE_VALUE && row.item == TeleConfig.DELETED_RETENTION -> chooseDeletedRetention()
+            row.type == TYPE_VALUE && row.item == TeleConfig.MAP_SERVICE -> chooseMapService()
+            row.type == TYPE_VALUE && row.item == TeleConfig.DELETED_REPLY -> chooseDeletedReply()
+            row.type == TYPE_VALUE && row.item == TeleConfig.DELETED_QUOTE_NAME -> chooseDeletedQuoteName()
+            row.type == TYPE_VALUE && row.item == TeleConfig.TELE_SERVER_URL -> chooseServerUrl()
+            row.type == TYPE_VALUE && row.item == TeleConfig.INVISIBLE_NAMES_FALLBACK -> chooseInvisibleFallback()
+            row.type == TYPE_VALUE && row.item == TeleConfig.INVISIBLE_NAMES_PHRASE -> chooseInvisiblePhrase()
+            row.type == TYPE_VALUE && row.item == TeleConfig.TITLE_TEMPLATE -> TeleTitleEditor.show(this) { refresh() }
+            row.type == TYPE_LINK || row.type == TYPE_LINK_ICON -> when (row.mode) {
+                TeleNamesActivity.MODE_LOCAL -> presentFragment(TeleNamesActivity(TeleNamesActivity.MODE_LOCAL))
+                TeleNamesActivity.MODE_ALIAS -> presentFragment(TeleNamesActivity(TeleNamesActivity.MODE_ALIAS))
+                TeleChatBackgroundsActivity.MODE_CHAT_BACKGROUNDS -> presentFragment(TeleChatBackgroundsActivity())
+                TeleReactionsActivity.MODE_REACTIONS -> presentFragment(TeleReactionsActivity())
+                MODE_MENU -> if (row.type == TYPE_LINK) {
+                    presentFragment(TeleMenuActivity(tele.helpers.TeleMenuKind.MESSAGE))
+                } else {
+                    presentFragment(TeleSettingsActivity(MODE_MENU))
+                }
+                MODE_SCRIPTS -> presentFragment(TeleScriptsActivity())
+                "menu_export" -> exportMenus()
+                "menu_import" -> importMenus()
+                "peers_ignore" -> presentFragment(TelePeersActivity(UserConfig.selectedAccount, TelePeersActivity.MODE_IGNORE))
+                "peers_ghost_always" -> presentFragment(TelePeersActivity(UserConfig.selectedAccount, TelePeersActivity.MODE_GHOST_ALWAYS))
+                "peers_ghost_never" -> presentFragment(TelePeersActivity(UserConfig.selectedAccount, TelePeersActivity.MODE_GHOST_NEVER))
+                "peers_online" -> presentFragment(TelePeersActivity(UserConfig.selectedAccount, TelePeersActivity.MODE_ONLINE))
+                "words_global" -> presentFragment(TeleWordsActivity(UserConfig.selectedAccount, 0L))
+                TeleDeletedMessagesActivity.MODE_ARCHIVE -> presentFragment(TeleDeletedMessagesActivity())
+                TeleNoticesActivity.MODE_NOTICES -> presentFragment(TeleNoticesActivity())
+                TeleDraftsActivity.MODE_DRAFTS -> presentFragment(TeleDraftsActivity())
+                TeleBookmarksActivity.MODE_BOOKMARKS -> presentFragment(TeleBookmarksActivity.of(UserConfig.selectedAccount))
+                MODE_RULES -> presentFragment(TeleRulesActivity())
+                "backup_export" -> exportSettings()
+                "local_password" -> tele.ui.StarsLockUi.openSetup(parentActivity ?: return, resourceProvider)
+                "backup_import" -> importSettings()
+                "server_refresh" -> tele.helpers.TeleServer.refresh(::showServerResult)
+                "server_clear" -> tele.helpers.TeleServer.clearCachedData(::showServerResult)
+                "server_send_crash" -> (parentActivity ?: return).let { tele.helpers.TeleCrash.sendPendingAsync(it); refresh() }
+                "server_share_dump" -> (parentActivity ?: return).let { tele.helpers.TeleCrash.shareDump(it) }
+                "mtp_log" -> presentFragment(tele.ui.TeleMtpActivity())
+                "mtp_console" -> presentFragment(tele.ui.TeleMtpConsoleActivity())
+                "mtp_clear" -> clearMtpLog()
+                "mtp_history_clear" -> {
+                    tele.helpers.TeleMtpHistory.clear(UserConfig.selectedAccount)
+                    refresh()
+                }
+                MODE_UPDATE_ACTION -> if (tele.helpers.TeleUpdater.isReady()) tele.helpers.TeleUpdater.install(parentActivity) else tele.helpers.TeleUpdater.checkNow()
+                "gift_grid" -> presentFragment(TeleGiftGridActivity())
+                "gift_studio" -> presentFragment(
+                    tele.ui.TeleGiftStudioActivity(UserConfig.selectedAccount, 0L, null)
+                )
+                MODE_WHATS_NEW -> tele.helpers.TeleChangelog.open(this)
+                else -> presentFragment(TeleSettingsActivity(row.mode ?: MODE_ROOT))
+            }
+        }
+    }
