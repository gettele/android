+        ret = js_typed_array_constructor(ctx, JS_UNDEFINED, argc, argv,
+                                         p->class_id);
+    } else {
+        ret = js_typed_array_create(ctx, ctor, argc, argv, require_mutable);
+        JS_FreeValue(ctx, ctor);
+    }
+    return ret;
