+            ActionBarMenuItem tagItem = actionBar.createActionMode().getItem(tag_message);
+            if (tagItem != null) {
+                tagItem.setIcon(hasReactions ? R.drawable.menu_tag_edit : R.drawable.menu_tag_plus, true);
