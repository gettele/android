+static no_inline int js_strict_eq_slow(JSContext *ctx, JSValue *sp,
+                                       bool is_neq)
+{
+    bool res;
+    res = js_strict_eq(ctx, sp[-2], sp[-1]);
+    JS_FreeValue(ctx, sp[-2]);
+    JS_FreeValue(ctx, sp[-1]);
+    sp[-2] = js_bool(res ^ is_neq);
+    return 0;
+}
