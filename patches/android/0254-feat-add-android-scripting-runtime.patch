+/* code point ranges for Zs,Zl or Zp property */
+static const uint16_t char_range_space[] = {
+    10,
+    0x0009, 0x000D + 1,
+    0x0020, 0x0020 + 1,
+    0x00A0, 0x00A0 + 1,
