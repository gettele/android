-                    }
-                }
-                if (foundExactly) {
-                    break;
-                }
-            }
-            if (foundExactly) {
-                for (int i = 0; i < foundWords.size(); i++) {
-                    boolean findMatch = false;
-                    for (int j = 0; j < queryWord.length; j++) {
