+package tele.scripting
+
+/**
+ * One QuickJS runtime per running script. Every method must be called on the script thread;
+ * the handle owns the isolate and never crosses threads.
+ */
+object QuickJs {
+    const val MEMORY_LIMIT = 64 * 1024 * 1024
+    const val STACK_LIMIT = 1024 * 1024
+
+    @JvmStatic
+    external fun create(memoryLimit: Int, stackSize: Int, host: ScriptHost): Long
+
+    @JvmStatic
+    external fun destroy(handle: Long)
+
+    /** Returns null on success, the exception text otherwise. */
+    @JvmStatic
+    external fun eval(handle: Long, source: String, filename: String, module: Boolean): String?
+
+    /** Calls a global function; null on success, the exception text otherwise. */
+    @JvmStatic
+    external fun call(handle: Long, function: String, argument: String?): String?
+
+    /** Calls a global function and returns its string result, or null. */
+    @JvmStatic
+    external fun callString(handle: Long, function: String, argument: String?): String?
+
+    /** Drains promise jobs; null on success, the exception text otherwise. */
+    @JvmStatic
+    external fun runJobs(handle: Long): String?
+
+    @JvmStatic
+    external fun interrupt(handle: Long)
+}
