+++ b/TMessagesProj/src/main/java/tele/scripting/ScriptDisplay.kt
@@ -0,0 +1,110 @@
+package tele.scripting
+
+import android.text.SpannableStringBuilder
+import org.json.JSONObject
+import org.telegram.messenger.MessageObject
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.NotificationCenter
+import tele.TeleConfig
+import java.util.concurrent.ConcurrentHashMap
+
+class Decoration(
+    @JvmField val text: String?,
+    @JvmField val badge: String?,
+    @JvmField val footer: String?,
+    @JvmField val opacity: Float,
+    @JvmField val hidden: Boolean
+)
+
+/** Local message decorations from scripts: explicit per message and the display(messages) gate. */
+object ScriptDisplay {
+    private val explicit = ConcurrentHashMap<String, Decoration>()
+    private val owners = ConcurrentHashMap<String, String>()
+    private val cache = ConcurrentHashMap<String, Decoration?>()
+
+    private fun key(account: Int, peerId: Long, messageId: Int) = "$account:$peerId:$messageId"
+
+    @JvmStatic
+    fun set(account: Int, script: String, peerId: Long, messageId: Int, json: JSONObject?) {
+        val key = key(account, peerId, messageId)
+        if (json == null) {
+            explicit.remove(key)
+            owners.remove(key)
+        } else {
+            val value = parse(json)
+            if (value == null) {
+                explicit.remove(key)
+                owners.remove(key)
+            } else {
+                explicit[key] = value
+                owners[key] = script
+            }
+        }
+        cache.remove(key)
+        refresh(account)
+    }
+
+    @JvmStatic
+    fun parse(json: JSONObject): Decoration? {
+        val text = when (val value = json.opt("text")) {
+            null, JSONObject.NULL -> null
+            is String -> value
+            is JSONObject -> value.optString("text").ifEmpty { null }
+            else -> null
+        }
+        val badge = json.optString("badge", "").ifEmpty { null }
+        val footer = when (val value = json.opt("footer")) {
+            null, JSONObject.NULL -> null
+            is String -> value
+            is JSONObject -> value.optString("text").ifEmpty { null }
+            else -> null
+        }
+        val opacity = json.optDouble("opacity", 1.0).toFloat().coerceIn(0f, 1f)
+        val hidden = json.optBoolean("hidden", false)
+        if (text == null && badge == null && footer == null && opacity >= 1f && !hidden) return null
+        return Decoration(text, badge, footer, opacity, hidden)
+    }
+
+    @JvmStatic
+    fun decoration(account: Int, message: MessageObject): Decoration? {
+        val key = key(account, message.getDialogId(), message.getId())
+        explicit[key]?.let { return it }
+        if (cache.containsKey(key)) return cache[key]
+        val fromScripts = Scripts.decorateSync(account, message)
+        if (fromScripts != null) cache[key] = fromScripts
+        return fromScripts
+    }
+
+    @JvmStatic
+    fun apply(account: Int, message: MessageObject) {
+        if (!TeleConfig.SCRIPTING.value) return
+        val decoration = decoration(account, message) ?: return
+        val text = decoration.text
+        if (text != null) {
+            message.messageText = SpannableStringBuilder(text)
+        }
+    }
+
+    @JvmStatic
+    fun clearScript(account: Int, script: String) {
+        val mine = owners.entries.filter { it.value == script && it.key.startsWith("$account:") }.map { it.key }
+        for (key in mine) {
+            owners.remove(key)
+            explicit.remove(key)
+        }
+        cache.clear()
+        refresh(account)
+    }
+
+    @JvmStatic
+    fun clear() {
+        explicit.clear()
+        cache.clear()
+    }
+
+    private fun refresh(account: Int) {
+        AndroidUtilities.runOnUIThread {
+            NotificationCenter.getInstance(account).postNotificationName(NotificationCenter.updateInterfaces, 0)
+        }
+    }
+}
diff --git a/TMessagesProj/src/main/java/tele/scripting/ScriptGrants.kt b/TMessagesProj/src/main/java/tele/scripting/ScriptGrants.kt
new file mode 100644
index 0000000..665d122
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/scripting/ScriptGrants.kt
@@ -0,0 +1,95 @@
+package tele.scripting
+
+/**
+ * One canonical grant parser and matcher. A grant is `name` or `name(scope, scope)`, the scopes
+ * are matched exactly, by a trailing `*`, or as a boundary, never by string suffix alone.
+ */
+object ScriptGrants {
+    private val known = setOf(
+        "call", "onUpdate", "interceptRpc", "interceptUpdate", "interceptSendMessage",
+        "interceptLink", "interceptNotification", "account.read", "account.write", "display",
+        "fetch", "clipboard.read", "clipboard.write", "openUrl", "notify", "options", "scripts",
+        "files.write", "fs.read", "fs.write", "app", "unsafe"
+    )
+    private val dangerous = setOf(
+        "call", "account.write", "display", "files.write", "fs.write", "unsafe",
+        "interceptRpc", "interceptUpdate", "interceptSendMessage", "interceptNotification"
+    )
+
+    class Grant(val raw: String, val name: String, val scopes: List<String>, val known: Boolean)
+
+    fun parse(raw: String): Grant? {
+        val text = raw.trim()
+        if (text.isEmpty()) return null
+        val open = text.indexOf('(')
+        if (open < 0) {
+            if (text.any { it.isWhitespace() || it == ')' }) return null
+            return Grant(text, text, emptyList(), text in known)
+        }
+        if (!text.endsWith(')')) return null
+        val name = text.substring(0, open).trim()
+        if (name.isEmpty() || name.any { it.isWhitespace() }) return null
+        val body = text.substring(open + 1, text.length - 1)
+        val scopes = if (body.isBlank()) emptyList() else body.split(',').map { it.trim() }.filter { it.isNotEmpty() }
+        if (scopes.any { it.any(Char::isWhitespace) }) return null
+        return Grant(text, name, scopes, name in known)
+    }
+
+    fun normalize(declared: List<String>): List<String> = declared.mapNotNull { parse(it)?.raw }.distinct()
+
+    fun unknown(declared: List<String>): List<String> =
+        declared.mapNotNull { parse(it) }.filter { !it.known }.map { it.raw }
+
+    fun dangerous(grant: Grant): Boolean = grant.name in dangerous || grant.name.startsWith("unsafe")
+
+    fun consentLine(grant: Grant): String = when (grant.name) {
+        "call" -> if (grant.scopes.isEmpty()) "Call any Telegram method" else "Call ${grant.scopes.joinToString(", ")}"
+        "onUpdate" -> "Read Telegram updates"
+        "interceptRpc" -> "Change Telegram requests before they are sent"
+        "interceptUpdate" -> "Change Telegram updates before the app sees them"
+        "interceptSendMessage" -> "Change messages before they are sent"
+        "interceptLink" -> "Change the links the app opens"
+        "interceptNotification" -> "Change notifications"
+        "account.read" -> "Read your account: ${grant.scopes.ifEmpty { listOf("everything") }.joinToString(", ")}"
+        "account.write" -> "Change your account: ${grant.scopes.ifEmpty { listOf("everything") }.joinToString(", ")}"
+        "display" -> "Change what you see on this device: ${grant.scopes.ifEmpty { listOf("everything") }.joinToString(", ")}"
+        "fetch" -> "Use the network: ${grant.scopes.ifEmpty { listOf("any host") }.joinToString(", ")}"
+        "clipboard.read" -> "Read the clipboard"
+        "clipboard.write" -> "Write to the clipboard"
+        "openUrl" -> "Open links"
+        "notify" -> "Show notifications"
+        "options" -> "Add options to the scripts settings"
+        "scripts" -> "Talk to other scripts"
+        "files.write" -> "Write files through the system picker"
+        "fs.read" -> "Read the script's own files"
+        "fs.write" -> "Write the script's own files"
+        "app" -> "Read app state"
+        "unsafe" -> "Use unsafe APIs"
+        else -> "Unknown permission: ${grant.raw}"
+    }
+
+    fun covers(granted: Grant, required: Grant): Boolean {
+        if (granted.name != required.name) return false
+        if (granted.scopes.isEmpty()) return true
+        if (required.scopes.isEmpty()) return false
+        return required.scopes.all { wanted -> granted.scopes.any { matches(it, wanted) } }
+    }
+
+    private fun matches(scope: String, wanted: String): Boolean {
+        if (scope == wanted) return true
+        if (scope.endsWith("*")) {
+            return wanted.startsWith(scope.dropLast(1))
+        }
+        return false
+    }
+
+    fun allows(granted: Collection<Grant>, name: String, scope: String? = null): Boolean {
+        val required = Grant(if (scope == null) name else "$name($scope)", name, scope?.let { listOf(it) } ?: emptyList(), true)
+        return granted.any { covers(it, required) }
+    }
+
+    fun missing(declared: List<String>, approved: List<String>): List<String> {
+        val have = approved.mapNotNull(::parse)
+        return declared.mapNotNull(::parse).filter { wanted -> have.none { covers(it, wanted) } }.map { it.raw }
+    }
+}
