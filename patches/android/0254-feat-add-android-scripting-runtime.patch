+    private Integer findClosest(ArrayList<Integer> arrayList, int target, int[] index) {
+        if (arrayList.isEmpty()) {
+            return 0;
+        }
+        Integer val = arrayList.get(0);
+        if (target >= val) {
+            index[0] = 0;
+            return val;
+        }
+        int n = arrayList.size();
+        val = arrayList.get(n - 1);
+        if (target <= val) {
+            index[0] = n - 1;
+            return val;
+        }
+
+        int i = 0, j = n, mid = 0;
+        while (i < j) {
+            mid = (i + j) / 2;
+
+            val = arrayList.get(mid);
+            if (val == target) {
+                index[0] = mid;
+                return val;
+            }
+            if (target < val) {
+                if (mid > 0) {
+                    Integer val2 = arrayList.get(mid - 1);
+                    if (target > val2) {
+                        index[0] = mid - 1;
+                        return val2;
+                    }
+                }
+                i = mid + 1;
+            } else {
+                if (mid > 0) {
+                    Integer val2 = arrayList.get(mid - 1);
+                    if (target < val2) {
+                        index[0] = mid;
+                        return val;
+                    }
+                }
+                j = mid;
+            }
+        }
+        index[0] = mid;
+        return arrayList.get(mid);
+    }
