+int lre_is_space_non_ascii(uint32_t c)
+{
+    size_t i, n;
+
+    n = countof(char_range_space);
+    for(i = 5; i < n; i += 2) {
+        uint32_t low = char_range_space[i];
+        uint32_t high = char_range_space[i + 1];
+        if (c < low)
+            return false;
+        if (c < high)
+            return true;
+    }
+    return false;
+}
