+    t.d = d;
+    u = t.u64;
+
+    e = ((u >> 52) & 0x7FF) - 1023;
+    if (e > 30) {
+        // accept 0, INT32_MIN, reject too large, too small, nan, inf, -0
+        return !u || (u == 0xc1e0000000000000);
+    } else {
+        // shift out sign, exponent and whole part bits
+        // value is fractional if remaining low bits are non-zero
+        return !(u << 12 << e);
+    }
