+/* Equality comparisons and sameness */
+int JS_IsEqual(JSContext *ctx, JSValueConst op1, JSValueConst op2)
+{
+    JSValue sp[2] = { js_dup(op1), js_dup(op2) };
+    if (js_eq_slow(ctx, endof(sp), 0))
+        return -1;
+    return JS_VALUE_GET_BOOL(sp[0]);
+}
