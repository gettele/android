index 0000000..d93dde1
--- /dev/null
+++ b/TMessagesProj/src/main/assets/tele/scripting/bootstrap.js
@@ -0,0 +1,678 @@
+(() => {
+	class TeleError extends Error {
+		constructor(code, message, extra) {
+			super(String(message ?? code ?? 'error'));
+			this.name = 'TeleError';
+			this.code = String(code ?? 'error');
+			if (extra && typeof extra === 'object') {
+				Object.assign(this, extra);
+			}
+		}
+	}
+
+	const revive = (value) => {
+		if (Array.isArray(value)) {
+			return value.map(revive);
+		}
+		if (value && typeof value === 'object') {
+			const keys = Object.keys(value);
+			if (keys.length === 1 && typeof value.$b === 'string') {
+				return BigInt(value.$b);
+			}
+			for (const key of keys) {
+				value[key] = revive(value[key]);
+			}
+		}
+		return value;
+	};
+
+	const encode = (value) => {
+		if (typeof value === 'bigint') {
+			return value.toString();
+		}
+		if (Array.isArray(value)) {
+			return value.map(encode);
+		}
+		if (value && typeof value === 'object') {
+			const result = {};
+			for (const key of Object.keys(value)) {
+				const item = value[key];
+				if (typeof item !== 'function' && item !== undefined) {
+					result[key] = encode(item);
+				}
+			}
+			return result;
+		}
+		if (typeof value === 'function' || value === undefined) {
+			return null;
+		}
+		return value;
+	};
+
+	const host = (name, value) => {
+		const text = value === undefined ? null : JSON.stringify(encode(value));
+		const raw = __teleHost(name, text);
+		if (raw === null || raw === undefined) {
+			throw new TeleError('host', `${name}: the host returned no answer`);
+		}
+		const answer = JSON.parse(raw);
+		if (!answer || answer.ok !== true) {
+			throw new TeleError(
+				answer?.code ?? 'host',
+				answer?.error ?? `${name} failed`,
+				answer?.extra ? revive(answer.extra) : undefined
+			);
+		}
+		return revive(answer.value);
+	};
+
+	const callbacks = new Map();
+	const timers = new Map();
+	let nextCallback = 1;
+	let nextTimer = 1;
+	const remember = (callback) => {
+		if (typeof callback !== 'function') {
+			throw new TypeError('expected a function');
+		}
+		const id = nextCallback++;
+		callbacks.set(id, callback);
