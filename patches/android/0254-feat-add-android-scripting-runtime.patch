-                            findMatch = true;
-                            break;
-                        }
-                    }
-                    if (!findMatch) {
-                        foundWords.remove(i--);
-                    }
-                }
-                if (foundWords.size() > 0) {
-                    Collections.sort(foundWords, (s, s1) -> s1.length() - s.length());
-                    String s = foundWords.get(0);
