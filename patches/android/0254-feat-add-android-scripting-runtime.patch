+        /** The shown version: the picked one, else this build's, else the newest. */
+        private fun newVersionOf(state: NewState, releases: List<tele.helpers.TeleChangelogHistory.Release>): Int {
+            if (state.picked && releases.any { it.version == state.version }) return state.version
+            val build = tele.TeleBuild.BUILD
+            return if (build > 0 && releases.any { it.version == build }) build else releases.firstOrNull()?.version ?: 0
+        }
+
+        /** The group parent of a child setting, so a child shown outside its page is gated by it like on its page. */
+        private fun groupParent(key: String?): Item<*>? {
+            if (key == null) return null
+            val parentKey = GROUPS.entries.firstOrNull { key in it.value }?.key ?: return null
+            return tele.configItems.firstOrNull { it.key == parentKey }
+        }
+
+        // the rows of the canonical pages by id: the what's new page shows these very rows, so a toggle there is the same setting
+        private fun newRowIndex(): Map<String, Row> {
+            val index = HashMap<String, Row>()
+            for (mode in SECTION_SPECS.map { it.mode } + MODE_ROOT) {
+                for (row in buildRows(mode, true)) {
+                    if (row.type != TYPE_TOGGLE && row.type != TYPE_VALUE && row.type != TYPE_LINK) continue
+                    val id = idOf(row) ?: continue
+                    if (!index.containsKey(id)) index[id] = row
+                }
+            }
+            return index
+        }
+
+        private fun newRows(state: NewState): List<Row> {
+            val releases = tele.helpers.TeleChangelogHistory.loaded() ?: return listOf(Row(TYPE_SHADOW, title = "Loading…"))
+            val words = tele.helpers.TeleChangelogHistory.words(state.query)
+            val current = newVersionOf(state, releases)
+            val result = ArrayList<Row>()
+            if (words.isEmpty() && releases.isNotEmpty()) result.add(Row(TYPE_CUSTOM, mode = "new_tabs"))
+            val index = if (releases.isEmpty()) emptyMap<String, Row>() else newRowIndex()
+            val covered = HashSet<String>()
+            var listed = false
+            for (release in releases) {
+                if (words.isEmpty() && release.version != current) continue
+                val found = release.items.filter { tele.helpers.TeleChangelogHistory.matches(it, words) }
+                if (found.isEmpty()) continue
+                // the items that point at the same settings share their rows
+                val blocks = ArrayList<Pair<List<String>, ArrayList<tele.helpers.TeleChangelogHistory.Item>>>()
+                val plain = ArrayList<tele.helpers.TeleChangelogHistory.Item>()
+                for (item in found) {
+                    val ids = tele.helpers.TeleChangelogHistory.settingIds(item).filter { index.containsKey(it) }
+                    if (ids.isEmpty()) {
+                        plain.add(item)
+                        continue
+                    }
+                    val block = blocks.firstOrNull { it.first == ids }
+                    if (block != null) block.second.add(item) else blocks.add(Pair(ids, arrayListOf(item)))
+                }
+                val prefix = if (words.isEmpty()) "" else "${release.title}, "
+                if (blocks.isNotEmpty()) {
+                    result.add(Row(TYPE_HEADER, prefix + "settings"))
+                    for ((ids, items) in blocks) {
+                        for (id in ids) {
+                            val row = index[id] ?: continue
+                            result.add(row.copy(parent = groupParent(row.item?.key)))
+                            row.item?.key?.let { covered.add(it) }
+                        }
+                        items.forEach { result.add(Row(TYPE_SHADOW, title = it.text)) }
+                    }
+                    result.add(Row(TYPE_SHADOW))
+                }
+                if (plain.isNotEmpty()) {
+                    result.add(Row(TYPE_HEADER, prefix + "other changes"))
+                    plain.forEach { result.add(Row(TYPE_SHADOW, title = it.text)) }
+                    result.add(Row(TYPE_SHADOW))
+                }
+                listed = true
+            }
+            // what this build added and the notes of the shown version don't mention
+            var rest = false
+            if (words.isEmpty() && current == newVersionOf(NewState(), releases)) {
+                val fresh = tele.helpers.TeleNewSettings.fresh().filter { it !in covered }.toHashSet()
+                if (fresh.isNotEmpty()) {
+                    rest = true
