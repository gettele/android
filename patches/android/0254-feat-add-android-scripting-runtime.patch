+namespace {
+
+JavaVM *g_vm = nullptr;
+std::mutex g_lock;
+std::unordered_set<void *> g_runtimes;
+
+struct Runtime {
+    JSRuntime *rt = nullptr;
+    JSContext *ctx = nullptr;
+    jobject host = nullptr;
+    jmethodID invoke = nullptr;
+    std::atomic<bool> interrupted{false};
+};
+
+std::string Utf8(JNIEnv *env, jstring value) {
+    if (value == nullptr) return {};
+    const jsize length = env->GetStringLength(value);
+    const jchar *chars = env->GetStringChars(value, nullptr);
+    if (chars == nullptr) return {};
+    std::string out;
+    out.reserve(static_cast<size_t>(length));
+    for (jsize i = 0; i < length; ++i) {
+        uint32_t code = chars[i];
+        if (code >= 0xD800 && code <= 0xDBFF && i + 1 < length) {
+            const uint32_t low = chars[i + 1];
+            if (low >= 0xDC00 && low <= 0xDFFF) {
+                code = 0x10000 + ((code - 0xD800) << 10) + (low - 0xDC00);
+                ++i;
+            }
+        }
+        if (code < 0x80) {
+            out.push_back(static_cast<char>(code));
+        } else if (code < 0x800) {
+            out.push_back(static_cast<char>(0xC0 | (code >> 6)));
+            out.push_back(static_cast<char>(0x80 | (code & 0x3F)));
+        } else if (code < 0x10000) {
+            out.push_back(static_cast<char>(0xE0 | (code >> 12)));
+            out.push_back(static_cast<char>(0x80 | ((code >> 6) & 0x3F)));
+            out.push_back(static_cast<char>(0x80 | (code & 0x3F)));
+        } else {
+            out.push_back(static_cast<char>(0xF0 | (code >> 18)));
+            out.push_back(static_cast<char>(0x80 | ((code >> 12) & 0x3F)));
+            out.push_back(static_cast<char>(0x80 | ((code >> 6) & 0x3F)));
+            out.push_back(static_cast<char>(0x80 | (code & 0x3F)));
+        }
+    }
+    env->ReleaseStringChars(value, chars);
+    return out;
+}
+
+jstring JavaString(JNIEnv *env, const char *data, size_t length) {
+    if (data == nullptr) return nullptr;
+    std::u16string out;
+    out.reserve(length);
+    size_t i = 0;
+    while (i < length) {
+        const auto first = static_cast<unsigned char>(data[i]);
+        if (first < 0x80) {
+            out.push_back(static_cast<char16_t>(first));
+            ++i;
+        } else if ((first & 0xE0) == 0xC0 && i + 1 < length) {
+            const auto second = static_cast<unsigned char>(data[i + 1]);
+            out.push_back(static_cast<char16_t>(((first & 0x1F) << 6) | (second & 0x3F)));
+            i += 2;
+        } else if ((first & 0xF0) == 0xE0 && i + 2 < length) {
+            const auto second = static_cast<unsigned char>(data[i + 1]);
+            const auto third = static_cast<unsigned char>(data[i + 2]);
+            out.push_back(static_cast<char16_t>(((first & 0x0F) << 12) | ((second & 0x3F) << 6) | (third & 0x3F)));
+            i += 3;
+        } else if ((first & 0xF8) == 0xF0 && i + 3 < length) {
+            const auto second = static_cast<unsigned char>(data[i + 1]);
+            const auto third = static_cast<unsigned char>(data[i + 2]);
+            const auto fourth = static_cast<unsigned char>(data[i + 3]);
+            uint32_t code = ((first & 0x07) << 18) | ((second & 0x3F) << 12) |
+                            ((third & 0x3F) << 6) | (fourth & 0x3F);
+            code -= 0x10000;
+            out.push_back(static_cast<char16_t>(0xD800 + (code >> 10)));
+            out.push_back(static_cast<char16_t>(0xDC00 + (code & 0x3FF)));
+            i += 4;
+        } else {
+            out.push_back(u'\uFFFD');
+            ++i;
+        }
+    }
+    return env->NewString(reinterpret_cast<const jchar *>(out.data()), static_cast<jsize>(out.size()));
+}
+
+std::string ExceptionText(JSContext *ctx) {
+    JSValue exception = JS_GetException(ctx);
+    size_t length = 0;
+    const char *text = JS_ToCStringLen2(ctx, &length, exception, false);
+    std::string result = text != nullptr ? std::string(text, length) : std::string("javascript exception");
+    if (text != nullptr) JS_FreeCString(ctx, text);
+    JS_FreeValue(ctx, exception);
+    return result;
+}
+
+int InterruptHandler(JSRuntime *, void *opaque) {
+    auto *runtime = static_cast<Runtime *>(opaque);
+    return runtime != nullptr && runtime->interrupted.load(std::memory_order_relaxed) ? 1 : 0;
+}
+
+JSValue HostFunction(JSContext *ctx, JSValueConst, int argc, JSValueConst *argv) {
+    auto *runtime = static_cast<Runtime *>(JS_GetContextOpaque(ctx));
+    if (runtime == nullptr || runtime->host == nullptr) {
+        return JS_ThrowInternalError(ctx, "script host is gone");
+    }
+    JNIEnv *env = nullptr;
+    bool attached = false;
+    if (g_vm == nullptr || g_vm->GetEnv(reinterpret_cast<void **>(&env), JNI_VERSION_1_6) != JNI_OK) {
+        if (g_vm == nullptr) return JS_ThrowInternalError(ctx, "no java vm");
+        if (g_vm->AttachCurrentThread(&env, nullptr) != JNI_OK) {
+            return JS_ThrowInternalError(ctx, "could not attach the script thread");
+        }
+        attached = true;
+    }
+    const char *name = argc > 0 ? JS_ToCString(ctx, argv[0]) : nullptr;
+    const char *args = (argc > 1 && !JS_IsNull(argv[1]) && !JS_IsUndefined(argv[1]))
+                               ? JS_ToCString(ctx, argv[1]) : nullptr;
+    jstring jname = JavaString(env, name, name != nullptr ? std::strlen(name) : 0);
+    jstring jargs = args != nullptr ? JavaString(env, args, std::strlen(args)) : nullptr;
+    auto result = static_cast<jstring>(env->CallObjectMethod(
+            runtime->host, runtime->invoke, reinterpret_cast<jlong>(runtime), jname, jargs));
+    JSValue value = JS_NULL;
+    if (env->ExceptionCheck()) {
+        env->ExceptionDescribe();
+        env->ExceptionClear();
+        value = JS_ThrowInternalError(ctx, "script host call failed");
+    } else if (result != nullptr) {
+        const char *text = env->GetStringUTFChars(result, nullptr);
+        if (text != nullptr) {
+            value = JS_NewString(ctx, text);
+            env->ReleaseStringUTFChars(result, text);
+        }
+        env->DeleteLocalRef(result);
+    }
+    if (jname != nullptr) env->DeleteLocalRef(jname);
+    if (jargs != nullptr) env->DeleteLocalRef(jargs);
+    if (name != nullptr) JS_FreeCString(ctx, name);
+    if (args != nullptr) JS_FreeCString(ctx, args);
+    if (attached) g_vm->DetachCurrentThread();
+    return value;
+}
+
+Runtime *GetRuntime(jlong handle) {
+    auto *runtime = reinterpret_cast<Runtime *>(handle);
+    std::lock_guard<std::mutex> guard(g_lock);
+    if (runtime == nullptr || g_runtimes.find(runtime) == g_runtimes.end()) return nullptr;
+    return runtime;
+}
+
+jstring ErrorString(JNIEnv *env, const std::string &error) {
+    return JavaString(env, error.data(), error.size());
+}
