+    // the title template and the server url are the user's own text
+    private fun shownValue(row: Row): String {
+        val value = row.value.orEmpty()
+        val own = (row.item === TeleConfig.TITLE_TEMPLATE && TeleConfig.TITLE_TEMPLATE.value.isNotEmpty()) ||
+            (row.item === TeleConfig.TELE_SERVER_URL && TeleConfig.TELE_SERVER_URL.value.isNotBlank()) ||
+            (row.item === TeleConfig.INVISIBLE_NAMES_PHRASE && TeleConfig.INVISIBLE_NAMES_PHRASE.value.isNotBlank())
+        return if (own) value else lc(value)
+    }
