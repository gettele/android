+int JS_GetTypedArrayType(JSValueConst obj)
+{
+    JSClassID class_id = JS_GetClassID(obj);
+    if (is_typed_array(class_id))
+        return class_id - JS_CLASS_UINT8C_ARRAY;
+    else
+        return -1;
+}
