@@ -0,0 +1,66 @@
+package tele.scripting
+
+import org.json.JSONArray
+import org.json.JSONObject
+import java.util.concurrent.ConcurrentHashMap
+
+class ScriptMenuItem(
+    @JvmField val account: Int,
+    @JvmField val scriptId: String,
+    @JvmField val callbackId: Int,
+    @JvmField val text: String,
+    @JvmField val icon: String?,
+    @JvmField val chats: List<String>
+)
+
+object ScriptMenu {
+    private val items = ConcurrentHashMap<String, MutableList<ScriptMenuItem>>()
+
+    private fun key(account: Int, script: String) = "$account:$script"
+
+    @JvmStatic
+    fun register(runtime: ScriptRuntime, args: JSONObject): Boolean {
+        val text = args.optString("text").trim()
+        if (text.isEmpty()) throw ScriptException("bad-argument", "a menu item needs text")
+        val icon = args.optString("icon", "").trim().ifEmpty { null }
+        val chats = when (val value = args.opt("chats")) {
+            null, JSONObject.NULL -> listOf("all")
+            is JSONArray -> buildList { for (i in 0 until value.length()) add(value.optString(i)) }
+            is String -> listOf(value)
+            else -> listOf("all")
+        }
+        val item = ScriptMenuItem(runtime.account, runtime.id, args.optInt("id"), text, icon, chats)
+        items.getOrPut(key(runtime.account, runtime.id)) { ArrayList() }.add(item)
+        return true
+    }
+
+    @JvmStatic
+    fun unregister(runtime: ScriptRuntime, id: Int) {
+        items[key(runtime.account, runtime.id)]?.removeAll { it.callbackId == id }
+    }
+
+    @JvmStatic
+    fun clear(runtime: ScriptRuntime) {
+        items.remove(key(runtime.account, runtime.id))
+    }
+
+    @JvmStatic
+    fun list(account: Int, chatKind: String? = null): List<ScriptMenuItem> {
+        val result = ArrayList<ScriptMenuItem>()
+        for ((key, list) in items) {
+            if (!key.startsWith("$account:")) continue
+            for (item in list) {
+                if (item.chats.contains("all") || chatKind == null || item.chats.contains(chatKind)) {
+                    result.add(item)
+                }
+            }
+        }
+        return result
+    }
+
+    @JvmStatic
+    fun invoke(account: Int, scriptId: String, callbackId: Int, context: JSONObject): Boolean {
+        val runtime = Scripts.runtime(account, scriptId) ?: return false
+        return runtime.dispatch(callbackId, "menu", JSONArray().put(context))
+    }
+}
diff --git a/TMessagesProj/src/main/java/tele/scripting/ScriptRuntime.kt b/TMessagesProj/src/main/java/tele/scripting/ScriptRuntime.kt
new file mode 100644
index 0000000..832cff8
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/scripting/ScriptRuntime.kt
@@ -0,0 +1,513 @@
+package tele.scripting
+
+import android.util.Log
+import org.json.JSONArray
+import org.json.JSONObject
+import org.telegram.messenger.ApplicationLoader
+import org.telegram.messenger.FileLog
+import org.telegram.messenger.MessagesController
+import org.telegram.messenger.UserConfig
+import org.telegram.messenger.Utilities
+import org.telegram.tgnet.TLRPC
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.FutureTask
+import java.util.concurrent.LinkedBlockingQueue
+import java.util.concurrent.ScheduledFuture
+import java.util.concurrent.ScheduledThreadPoolExecutor
+import java.util.concurrent.TimeUnit
+
+/**
+ * One script, one isolate, one thread. Host calls from QuickJS block that thread (and only that
+ * thread); every callback into JS is posted to the same queue, so JSValue never crosses threads.
+ */
+class ScriptRuntime(
+    @JvmField val account: Int,
+    @JvmField val id: String,
+    @JvmField val script: ScriptFile,
+    private val approved: List<String>
+) {
+    @Volatile
+    var running = false
+        private set
+
+    private var handle = 0L
+    private var thread: Thread? = null
+    private val queue = LinkedBlockingQueue<Runnable>()
+    private val scheduler = ScheduledThreadPoolExecutor(1)
+    private val timers = ConcurrentHashMap<Int, ScheduledFuture<*>>()
+    private val listeners = ConcurrentHashMap<String, Int>()
+    private val decorators = ArrayList<Int>()
+    @Volatile
+    private var updateListener = 0
+    @Volatile
+    private var failed = false
+
+    private val assets = HashMap<String, String>()
+
+    fun start() {
+        if (running) return
+        running = true
+        failed = false
+        scheduler.setRemoveOnCancelPolicy(true)
+        thread = Thread({ runLoop() }, "TeleScript-$account-${script.name}").also {
+            it.isDaemon = true
+            it.start()
+        }
+    }
+
+    fun stop() {
+        if (!running && handle == 0L) return
+        running = false
+        val current = handle
+        if (current != 0L) QuickJs.interrupt(current)
+        scheduler.shutdownNow()
+        timers.clear()
+        queue.offer(Runnable { })
+        runCatching { thread?.join(2000) }
+        thread = null
+    }
+
+    fun allows(name: String, scope: String? = null): Boolean =
+        ScriptGrants.allows(approved.mapNotNull(ScriptGrants::parse), name, scope)
+
+    fun dispatch(callback: Int, kind: String, args: JSONArray): Boolean {
+        if (!running || handle == 0L) return false
+        val payload = JSONObject().put("id", callback).put("args", args).toString()
+        queue.offer(Runnable {
+            val error = QuickJs.call(handle, "__teleDispatch", payload)
+            if (error != null) fault(error)
+        })
+        return true
+    }
+
+    fun decorationFor(message: org.telegram.messenger.MessageObject): Decoration? {
+        if (!running || handle == 0L || decorators.isEmpty()) return null
+        val raw = ScriptTl.messageJson(message.messageOwner) ?: return null
+        val key = "${message.getDialogId()}:${message.getId()}"
+        val task = FutureTask<Decoration?> {
+            var result: Decoration? = null
+            for (callback in ArrayList(decorators)) {
+                val payload = JSONObject()
+                    .put("key", "$key:$callback")
+                    .put("id", callback)
+                    .put("raw", raw)
+                    .toString()
+                val callError = QuickJs.call(handle, "__teleDecorate", payload)
+                if (callError != null) {
+                    fault(callError)
+                    break
+                }
+                val deadline = System.currentTimeMillis() + 200
+                while (System.currentTimeMillis() < deadline) {
+                    val jobError = QuickJs.runJobs(handle)
+                    if (jobError != null) {
+                        fault(jobError)
+                        break
+                    }
+                    val text = QuickJs.callString(handle, "__teleDecorateResult", "$key:$callback") ?: break
+                    val value = runCatching { JSONObject(text) }.getOrNull() ?: break
+                    val ready = value.optBoolean("ready", false)
+                    if (!ready) break
+                    val decoration = value.optJSONObject("value") ?: continue
+                    val parsed = ScriptDisplay.parse(decoration)
+                    if (parsed != null) result = parsed
+                    break
+                }
+            }
+            result
+        }
+        queue.offer(task)
+        return runCatching { task.get(250, TimeUnit.MILLISECONDS) }.getOrNull()
+    }
+
+    fun host(handle: Long, name: String, args: String?): String {
+        return try {
+            if (!running) throw ScriptException("stopped", "the script is not running")
+            val value = args?.takeIf { it.startsWith("{") }?.let { JSONObject(it) }
+            val scalar = scalarOf(args)
+            val result = when (name) {
+                "selfId" -> JSONObject().put("\$b", UserConfig.getInstance(account).getClientUserId().toString())
+                "scriptName" -> script.name
+                "current" -> JSONObject.NULL
+                "randomId" -> Utilities.random.nextLong().let { if (it == 0L) 1L else it }.toString()
+                "random.bytes" -> {
+                    val count = (scalar?.toIntOrNull() ?: 0).coerceIn(0, 65536)
+                    val bytes = ByteArray(count)
+                    Utilities.random.nextBytes(bytes)
+                    JSONArray(IntArray(count) { bytes[it].toInt() and 0xff }.toList())
+                }
+                "random.hex" -> {
+                    val count = (scalar?.toIntOrNull() ?: 0).coerceIn(0, 4096)
+                    val bytes = ByteArray(count)
+                    Utilities.random.nextBytes(bytes)
+                    bytes.joinToString("") { "%02x".format(it) }
+                }
+                "call" -> {
+                    val method = value?.optString("_").orEmpty()
+                    if (!allows("call", method)) {
+                        throw ScriptException("not-granted", "tg.call needs the grant 'call($method)'", JSONObject().put("grant", "call($method)"))
+                    }
+                    ScriptTl.call(account, value.toString()) { running }
+                }
+                "resolve" -> resolvePeer(scalar.orEmpty())
+                "peerInput" -> peerInput(scalar.orEmpty())
+                "message.cached" -> value?.let {
+                    Scripts.cachedMessage(account, it.optString("peer"), it.optLong("id"))
+                }
+                "storage.get" -> ScriptStore.storage(account, id).opt(scalar.orEmpty())
+                "storage.set" -> {
+                    val argsValue = value ?: throw ScriptException("bad-argument", "storage.set needs a key")
+                    ScriptStore.putStorage(account, id, argsValue.optString("key"), argsValue.opt("value"))
+                    true
+                }
+                "storage.delete" -> {
+                    ScriptStore.putStorage(account, id, scalar.orEmpty(), null)
+                    true
+                }
+                "storage.keys" -> JSONArray(ScriptStore.storage(account, id).keys().asSequence().toList())
+                "storage.clear" -> {
+                    ScriptStore.clearStorage(account, id)
+                    true
+                }
+                "log" -> {
+                    val line = args ?: ""
+                    ScriptStore.addLog(account, id, line)
+                    Log.d("TeleScript", "[$account/$id] $line")
+                    null
+                }
+                "timer.set" -> {
+                    val argsValue = value ?: JSONObject()
+                    setTimer(argsValue.optInt("id"), argsValue.optLong("ms", 0))
+                    true
+                }
+                "timer.clear" -> {
+                    timers.remove(value?.optInt("id") ?: -1)?.cancel(false)
+                    true
+                }
+                "fetch" -> {
+                    val argsValue = value ?: throw ScriptException("bad-argument", "fetch needs options")
+                    ScriptWeb.fetch(this, argsValue)
+                }
+                "fetchAbort" -> {
+                    ScriptWeb.abort(scalar?.toIntOrNull() ?: 0)
+                    true
+                }
+                "menu.register" -> ScriptMenu.register(this, value ?: JSONObject())
+                "menu.unregister" -> {
+                    ScriptMenu.unregister(this, scalar?.toIntOrNull() ?: 0)
+                    true
+                }
+                "listen.register" -> {
+                    val argsValue = value ?: JSONObject()
+                    listeners[argsValue.optString("kind")] = argsValue.optInt("id")
+                    true
+                }
+                "listen.unregister" -> {
+                    val argsValue = scalar?.toIntOrNull() ?: 0
+                    listeners.entries.removeAll { it.value == argsValue }
+                    true
+                }
+                "update.register" -> {
+                    updateListener = scalar?.toIntOrNull() ?: 0
+                    true
+                }
+                "update.unregister" -> {
+                    updateListener = 0
+                    true
+                }
+                "decorate.register" -> {
+                    val argsValue = scalar?.toIntOrNull() ?: 0
+                    if (!decorators.contains(argsValue)) decorators.add(argsValue)
+                    true
+                }
+                "decorate.unregister" -> {
+                    decorators.remove(scalar?.toIntOrNull() ?: 0)
+                    true
+                }
+                "decorate.message" -> {
+                    val argsValue = value ?: throw ScriptException("bad-argument", "decorateMessage needs a target")
+                    val peerId = peerIdOf(argsValue.opt("peer"))
+                    if (peerId != 0L) {
+                        val decoration = argsValue.optJSONObject("decoration")
+                        if (decoration == null) {
+                            ScriptDisplay.set(account, id, peerId, argsValue.optLong("id").toInt(), null)
+                        } else {
+                            ScriptDisplay.set(account, id, peerId, argsValue.optLong("id").toInt(), decoration)
+                        }
+                    }
+                    true
+                }
+                "accounts.list" -> {
+                    val array = JSONArray()
+                    for (i in 0 until UserConfig.MAX_ACCOUNT_COUNT) {
+                        val config = UserConfig.getInstance(i)
+                        if (!config.isClientActivated) continue
+                        val user = config.currentUser ?: continue
+                        array.put(
+                            JSONObject()
+                                .put("id", i)
+                                .put("selfId", JSONObject().put("\$b", user.id.toString()))
+                                .put("name", org.telegram.messenger.UserObject.getUserName(user))
+                        )
+                    }
+                    array
+                }
+                "connection" -> 1
+                "open.chat" -> {
+                    if (!allows("app")) throw ScriptException("not-granted", "tg.openChat needs the grant 'app'", JSONObject().put("grant", "app"))
+                    ScriptUi.openChat(account, value?.optJSONObject("peer"), value?.optInt("message") ?: 0)
+                    true
+                }
+                "scripts.list", "scripts.emit", "scripts.on", "scripts.off" -> Scripts.host(this, name, value)
+                "options.list" -> Scripts.options(this)
+                "options.get", "options.set", "options.listen", "options.unlisten" -> null
+                "theme.get" -> null
+                else -> throw ScriptException("unsupported", "$name is not available to scripts on android yet")
+            }
+            ok(result)
+        } catch (e: ScriptException) {
+            fail(e)
+        } catch (e: Throwable) {
+            FileLog.e(e)
+            fail(ScriptException("host", e.message ?: "the host call failed"))
+        }
+    }
+
+    private fun keyOf(args: String?): String {
+        val text = args ?: return ""
+        return runCatching { JSONObject("{\"v\":$text}").optString("v") }.getOrDefault(text)
+    }
+
+    private fun scalarOf(args: String?): String? {
+        if (args == null) return null
+        return runCatching {
+            val value = JSONArray("[$args]").opt(0)
+            if (value == null || value == JSONObject.NULL) null else value.toString()
+        }.getOrNull()
+    }
+
+    private fun setTimer(id: Int, ms: Long) {
+        val delay = ms.coerceIn(0, 60 * 60 * 1000)
+        val future = scheduler.schedule({
+            queue.offer(Runnable {
+                val error = QuickJs.call(handle, "__teleTimer", id.toString())
+                if (error != null) fault(error)
+            })
+        }, delay, TimeUnit.MILLISECONDS)
+        timers[id] = future
+    }
+
+    private fun resolvePeer(name: String): JSONObject? {
+        val clean = name.trim().removePrefix("@")
+        if (clean.isEmpty()) return null
+        val user = MessagesController.getInstance(account).getUser(clean)
+        if (user != null) return info(user)
+        return null
+    }
+
+    private fun peerInput(idText: String): JSONObject? {
+        val id = idText.toLongOrNull() ?: return null
+        if (id == UserConfig.getInstance(account).getClientUserId()) {
+            return info(UserConfig.getInstance(account).currentUser)
+        }
+        if (id < 0) {
+            val raw = -id
+            val chat = MessagesController.getInstance(account).getChat(raw)
+                ?: MessagesController.getInstance(account).getChat(-raw)
+            if (chat != null) return info(chat)
+        } else {
+            val user = MessagesController.getInstance(account).getUser(id)
+            if (user != null) return info(user)
+        }
+        return null
+    }
+
+    private fun info(user: TLRPC.User?): JSONObject? {
+        if (user == null) return null
+        val result = JSONObject()
+            .put("id", JSONObject().put("\$b", user.id.toString()))
+            .put("kind", if (user.bot) "bot" else "user")
+            .put("name", org.telegram.messenger.UserObject.getUserName(user))
+        if (!user.username.isNullOrEmpty()) result.put("username", user.username)
+        result.put(
+            "input",
+            if (user.id == UserConfig.getInstance(account).getClientUserId()) {
+                JSONObject().put("_", "inputPeerSelf")
+            } else {
+                JSONObject()
+                    .put("_", "inputPeerUser")
+                    .put("userId", JSONObject().put("\$b", user.id.toString()))
+                    .put("accessHash", JSONObject().put("\$b", user.access_hash.toString()))
+            }
+        )
+        return result
+    }
+
+    private fun info(chat: TLRPC.Chat): JSONObject {
+        val result = JSONObject()
+            .put("id", JSONObject().put("\$b", (-chat.id).toString()))
+            .put("kind", "chat")
+            .put("name", chat.title)
+        result.put(
+            "input",
+            if (chat.id > 0 && chat.access_hash == 0L) {
+                JSONObject().put("_", "inputPeerChat").put("chatId", JSONObject().put("\$b", chat.id.toString()))
+            } else {
+                JSONObject()
+                    .put("_", "inputPeerChannel")
+                    .put("channelId", JSONObject().put("\$b", chat.id.toString()))
+                    .put("accessHash", JSONObject().put("\$b", chat.access_hash.toString()))
+            }
+        )
+        return result
+    }
+
+    private fun peerIdOf(peer: Any?): Long {
+        if (peer !is JSONObject) return 0
+        return when (peer.optString("_")) {
+            "inputPeerSelf" -> UserConfig.getInstance(account).getClientUserId()
+            "inputPeerUser" -> peer.optLong("userId")
+            "inputPeerChat" -> -peer.optLong("chatId")
+            "inputPeerChannel" -> -1000000000000L - peer.optLong("channelId")
+            "peerUser" -> peer.optLong("userId")
+            "peerChat" -> -peer.optLong("chatId")
+            "peerChannel" -> -1000000000000L - peer.optLong("channelId")
+            else -> 0
+        }
+    }
+
+    private fun ok(value: Any?): String = JSONObject()
+        .put("ok", true)
+        .put("value", value ?: JSONObject.NULL)
+        .toString()
+
+    private fun fail(error: ScriptException): String {
+        val result = JSONObject()
+            .put("ok", false)
+            .put("code", error.errorCode)
+            .put("error", error.message ?: "the host call failed")
+        error.extra?.let { result.put("extra", it) }
+        return result.toString()
+    }
+
+    private fun runLoop() {
+        try {
+            val host = ScriptHost(this)
+            handle = QuickJs.create(QuickJs.MEMORY_LIMIT, QuickJs.STACK_LIMIT, host)
+            if (handle == 0L) throw ScriptException("runtime", "could not create the javascript runtime")
+            evalAsset("tele/scripting/bootstrap.js")
+            evalAsset("tele/scripting/runtime.js")
+            evalAsset("tele/scripting/web.js")
+            var source = script.source
+            val file = script.file.name
+            if (file.endsWith(".ts") || file.endsWith(".mts")) {
+                evalAsset("tele/scripting/strip.js")
+                QuickJs.eval(
+                    handle,
+                    "globalThis.__teleStripJson = (payload) => { const p = JSON.parse(payload); return JSON.stringify(globalThis.__teleStrip(p.code, p.file)); };",
+                    "strip-wrapper.js",
+                    false
+                )?.let { throw ScriptException("strip", it) }
+                val stripped = QuickJs.callString(
+                    handle,
+                    "__teleStripJson",
+                    JSONObject().put("code", source).put("file", file).toString()
+                ) ?: throw ScriptException("strip", "could not strip the TypeScript")
+                source = JSONObject(stripped).optString("code")
+            }
+            QuickJs.eval(handle, source, file, true)?.let { throw ScriptException("script", it) }
+            QuickJs.call(handle, "__teleInit", null)?.let { throw ScriptException("runtime", it) }
+            QuickJs.call(handle, "__teleStart", null)?.let { throw ScriptException("script", it) }
+            for (i in 0 until 20) {
+                QuickJs.runJobs(handle)?.let { throw ScriptException("script", it) }
+                val setupError = QuickJs.callString(handle, "__teleSetupError", null)
+                if (setupError != null) throw ScriptException("script", setupError)
+                try {
+                    Thread.sleep(5)
+                } catch (e: InterruptedException) {
+                    break
+                }
+            }
+            ScriptStore.setLastError(account, id, null)
+            ScriptStore.addLog(account, id, "started ${script.name}")
+            while (running) {
+                val task = try {
+                    queue.poll(100, TimeUnit.MILLISECONDS)
+                } catch (e: InterruptedException) {
+                    null
+                }
+                task?.run()
+                if (handle == 0L) break
+                val error = QuickJs.runJobs(handle)
+                if (error != null) {
+                    fault(error)
+                    break
+                }
+            }
+        } catch (e: ScriptException) {
+            fault(e.message ?: "could not start the script")
+        } catch (e: Throwable) {
+            FileLog.e(e)
+            fault(e.message ?: "could not start the script")
+        } finally {
+            cleanup()
+        }
+    }
+
+    private fun evalAsset(path: String) {
+        val source = assets.getOrPut(path) {
+            ApplicationLoader.applicationContext.assets.open(path).bufferedReader().use { it.readText() }
+        }
+        QuickJs.eval(handle, source, path, false)?.let { throw ScriptException("runtime", "$path: $it") }
+    }
+
+    private fun fault(error: String) {
+        if (failed) return
+        failed = true
+        ScriptStore.setLastError(account, id, error)
+        ScriptStore.addLog(account, id, "fault: $error")
+        Log.e("TeleScript", "[$account/$id] $error")
+        running = false
+        QuickJs.interrupt(handle)
+        queue.offer(Runnable { })
+    }
+
+    private fun cleanup() {
+        running = false
+        val current = handle
+        handle = 0
+        if (current != 0L) {
+            runCatching { QuickJs.call(current, "__teleStop", null) }
+            runCatching { QuickJs.destroy(current) }
+        }
+        scheduler.shutdownNow()
+        timers.clear()
+        ScriptMenu.clear(this)
+        ScriptDisplay.clearScript(account, id)
+        listeners.clear()
+        updateListener = 0
+        decorators.clear()
+        ScriptStore.addLog(account, id, "stopped")
+        Scripts.runtimeStopped(this)
+    }
+
+    fun notify(kind: String, update: JSONObject, peers: JSONObject?) {
+        val callback = listeners[kind] ?: return
+        val args = JSONArray().put(update)
+        if (peers != null) args.put(peers)
+        dispatch(callback, kind, args)
+    }
+
+    fun notifyNewMessage(message: TLRPC.Message) {
+        val callback = listeners["new"] ?: 0
+        if (callback == 0) return
+        val json = ScriptTl.messageJson(message) ?: return
+        val peers = JSONObject()
+        dispatch(callback, "new", JSONArray().put(json).put(peers))
+    }
+
+    fun notifyUpdate(updates: JSONObject) {
+        val callback = updateListener
+        if (callback != 0) dispatch(callback, "update", JSONArray().put(updates))
+    }
+}
diff --git a/TMessagesProj/src/main/java/tele/scripting/ScriptScanner.kt b/TMessagesProj/src/main/java/tele/scripting/ScriptScanner.kt
new file mode 100644
index 0000000..5c0c762
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/scripting/ScriptScanner.kt
@@ -0,0 +1,153 @@
+package tele.scripting
+
+import android.content.Context
+import android.net.Uri
+import android.provider.OpenableColumns
+import org.telegram.messenger.ApplicationLoader
+import org.telegram.messenger.FileLog
+import java.io.File
+
+class ScriptFile(
+    @JvmField val id: String,
+    @JvmField val file: File,
+    @JvmField val name: String,
+    @JvmField val grants: List<String>,
+    @JvmField val source: String,
+    @JvmField val error: String?
+)
+
+/** The scripts folder under the app's external files dir: installed source, never executed while off. */
+object ScriptScanner {
+    private const val MAX_SOURCE = 2 * 1024 * 1024
+    private val extensions = listOf("js", "mjs", "ts", "mts")
+    private val entryNames = listOf("index.js", "index.mjs", "index.ts", "index.mts")
+
+    @JvmStatic
+    fun root(): File {
+        val base = ApplicationLoader.applicationContext.getExternalFilesDir(null)
+            ?: ApplicationLoader.applicationContext.filesDir
+        val dir = File(base, "tele/scripts")
+        if (!dir.exists()) dir.mkdirs()
+        return dir
+    }
+
+    @JvmStatic
+    fun scan(): List<ScriptFile> {
+        val root = root()
+        val result = ArrayList<ScriptFile>()
+        val files = root.listFiles().orEmpty()
+        for (file in files) {
+            if (file.name.startsWith(".") || file.name.startsWith("_")) continue
+            if (file.name.endsWith(".d.ts") || file.name == "tsconfig.json") continue
+            val entry = when {
+                file.isFile && extensionOf(file.name) in extensions -> file
+                file.isDirectory -> entryNames.map { File(file, it) }.firstOrNull { it.isFile }
+                else -> null
+            } ?: continue
+            val id = if (entry.parentFile == root) entry.name else file.name
+            val source = try {
+                if (entry.length() > MAX_SOURCE) throw IllegalStateException("the script is larger than 2 MB")
+                entry.readText()
+            } catch (e: Throwable) {
+                FileLog.e(e)
+                result.add(ScriptFile(id, entry, id, emptyList(), "", e.message ?: "could not read the script"))
+                continue
+            }
+            val meta = metadata(source)
+            result.add(ScriptFile(id, entry, meta.first ?: id, meta.second, source, meta.third))
+        }
+        return result.sortedBy { it.name.lowercase() }
+    }
+
+    @JvmStatic
+    fun fileFor(id: String): File? = scan().firstOrNull { it.id == id }?.file
+
+    private fun extensionOf(name: String): String = name.substringAfterLast('.', "").lowercase()
+
+    /** Reads the literal `name` and `grants` of `defineScript` without executing the source. */
+    @JvmStatic
+    fun metadata(source: String): Triple<String?, List<String>, String?> {
+        val nameMatch = Regex("""\bname\s*:\s*(['"])(.*?)\1""", RegexOption.DOT_MATCHES_ALL).find(source)
+        val name = nameMatch?.groupValues?.get(2)?.trim()?.takeIf { it.isNotEmpty() }
+        val grantsMatch = Regex("""\bgrants\s*:\s*\[([^\]]*)\]""", RegexOption.DOT_MATCHES_ALL).find(source)
+        val grants = ArrayList<String>()
+        if (grantsMatch != null) {
+            val quoted = Regex("""(['"])(.*?)\1""", RegexOption.DOT_MATCHES_ALL)
+            for (match in quoted.findAll(grantsMatch.groupValues[1])) {
+                val value = match.groupValues[2].trim()
+                if (value.isNotEmpty()) grants.add(value)
+            }
+        }
+        val error = when {
+            name == null -> "the script has no defineScript name"
+            grantsMatch == null -> "the script has no defineScript grants"
+            else -> null
+        }
+        return Triple(name, grants, error)
+    }
+
+    @JvmStatic
+    fun importFrom(context: Context, uri: Uri, replace: Boolean): Pair<String?, String?> {
+        val resolver = context.contentResolver
+        var display = "script.js"
+        runCatching {
+            resolver.query(uri, arrayOf(OpenableColumns.DISPLAY_NAME), null, null, null)?.use { cursor ->
+                if (cursor.moveToFirst()) {
+                    val index = cursor.getColumnIndex(OpenableColumns.DISPLAY_NAME)
+                    if (index >= 0) display = cursor.getString(index) ?: display
+                }
+            }
+        }
+        val safe = display.substringAfterLast('/').substringAfterLast('\\').trim()
+        if (safe.isEmpty() || safe.startsWith(".") || safe.startsWith("_")) {
+            return null to "the file has no usable name"
+        }
+        if (extensionOf(safe) !in extensions) {
+            return null to "only .js, .mjs, .ts and .mts scripts can be imported"
+        }
+        val target = File(root(), safe)
+        if (target.exists() && !replace) return safe to "exists"
+        val part = File(root(), "$safe.part")
+        try {
+            resolver.openInputStream(uri)?.use { input ->
+                part.outputStream().use { output ->
+                    val buffer = ByteArray(64 * 1024)
+                    var total = 0
+                    while (true) {
+                        val read = input.read(buffer)
+                        if (read < 0) break
+                        total += read
+                        if (total > MAX_SOURCE) throw IllegalStateException("the script is larger than 2 MB")
+                        output.write(buffer, 0, read)
+                    }
+                }
+            } ?: return null to "could not open the file"
+            val text = part.readText()
+            if (text.isBlank()) {
+                part.delete()
+                return null to "the file is empty"
+            }
+            if (target.exists()) target.delete()
+            if (!part.renameTo(target)) {
+                part.copyTo(target, overwrite = true)
+                part.delete()
+            }
+            return safe to null
+        } catch (e: Throwable) {
+            FileLog.e(e)
+            part.delete()
+            return null to (e.message ?: "could not import the script")
+        }
+    }
+
+    @JvmStatic
+    fun delete(id: String): Boolean {
+        val file = fileFor(id) ?: return false
+        val parent = file.parentFile
+        val deleted = file.delete()
+        if (deleted && parent != null && parent != root() && parent.listFiles()?.isEmpty() == true) {
+            parent.delete()
+        }
+        return deleted
+    }
+}
diff --git a/TMessagesProj/src/main/java/tele/scripting/ScriptStore.kt b/TMessagesProj/src/main/java/tele/scripting/ScriptStore.kt
new file mode 100644
index 0000000..b234b9a
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/scripting/ScriptStore.kt
@@ -0,0 +1,103 @@
+package tele.scripting
+
+import android.content.Context
+import android.content.SharedPreferences
+import org.json.JSONArray
+import org.json.JSONObject
+import org.telegram.messenger.ApplicationLoader
+import org.telegram.messenger.FileLog
+
+/** Per-account state of the scripts: what is on, what was approved, storage and the log. */
+object ScriptStore {
+    private const val MAX_STORAGE = 16 * 1024 * 1024
+    private const val MAX_LOG = 200
+
+    private fun prefs(account: Int): SharedPreferences =
+        ApplicationLoader.applicationContext.getSharedPreferences("tele_scripts_$account", Context.MODE_PRIVATE)
+
+    @Synchronized
+    fun enabled(account: Int, id: String): Boolean = prefs(account).getBoolean("enabled:$id", false)
+
+    @Synchronized
+    fun setEnabled(account: Int, id: String, on: Boolean) {
+        prefs(account).edit().putBoolean("enabled:$id", on).apply()
+    }
+
+    @Synchronized
+    fun grants(account: Int, id: String): List<String> {
+        val text = prefs(account).getString("grants:$id", null) ?: return emptyList()
+        return try {
+            val array = JSONArray(text)
+            buildList { for (i in 0 until array.length()) array.optString(i).takeIf { it.isNotEmpty() }?.let(::add) }
+        } catch (e: Throwable) {
+            FileLog.e(e)
+            emptyList()
+        }
+    }
+
+    @Synchronized
+    fun setGrants(account: Int, id: String, grants: List<String>) {
+        prefs(account).edit().putString("grants:$id", JSONArray(ScriptGrants.normalize(grants)).toString()).apply()
+    }
+
+    @Synchronized
+    fun storage(account: Int, id: String): JSONObject {
+        val text = prefs(account).getString("storage:$id", null) ?: return JSONObject()
+        return try {
+            JSONObject(text)
+        } catch (e: Throwable) {
+            JSONObject()
+        }
+    }
+
+    @Synchronized
+    fun putStorage(account: Int, id: String, key: String, value: Any?) {
+        val data = storage(account, id)
+        if (value == null) data.remove(key) else data.put(key, value)
+        val text = data.toString()
+        if (text.length > MAX_STORAGE) throw ScriptException("quota", "the script storage is full")
+        prefs(account).edit().putString("storage:$id", text).apply()
+    }
+
+    @Synchronized
+    fun clearStorage(account: Int, id: String) {
+        prefs(account).edit().remove("storage:$id").apply()
+    }
+
+    @Synchronized
+    fun storageSize(account: Int, id: String): Int = storage(account, id).toString().length
+
+    @Synchronized
+    fun log(account: Int, id: String): List<String> {
+        val text = prefs(account).getString("log:$id", null) ?: return emptyList()
+        return try {
+            val array = JSONArray(text)
+            buildList { for (i in 0 until array.length()) add(array.optString(i)) }
+        } catch (e: Throwable) {
+            emptyList()
+        }
+    }
+
+    @Synchronized
+    fun addLog(account: Int, id: String, line: String) {
+        val lines = log(account, id).toMutableList()
+        lines.add(line.take(2000))
+        while (lines.size > MAX_LOG) lines.removeAt(0)
+        prefs(account).edit().putString("log:$id", JSONArray(lines).toString()).apply()
+    }
+
+    @Synchronized
+    fun clearLog(account: Int, id: String) {
+        prefs(account).edit().remove("log:$id").apply()
+    }
+
+    @Synchronized
+    fun lastError(account: Int, id: String): String? = prefs(account).getString("error:$id", null)
+
+    @Synchronized
+    fun setLastError(account: Int, id: String, error: String?) {
+        prefs(account).edit().apply {
+            if (error == null) remove("error:$id") else putString("error:$id", error.take(2000))
+        }.apply()
+    }
+}
diff --git a/TMessagesProj/src/main/java/tele/scripting/ScriptTl.kt b/TMessagesProj/src/main/java/tele/scripting/ScriptTl.kt
new file mode 100644
index 0000000..1912795
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/scripting/ScriptTl.kt
@@ -0,0 +1,277 @@
+package tele.scripting
+
+import org.json.JSONArray
+import org.json.JSONObject
+import org.telegram.tgnet.ConnectionsManager
+import org.telegram.messenger.FileLog
+import org.telegram.tgnet.TLObject
+import org.telegram.tgnet.TLRPC
+import tele.helpers.TeleTl
+import java.lang.reflect.Field
+import java.lang.reflect.ParameterizedType
+import java.util.Base64
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.TimeUnit
+
+class ScriptException(val errorCode: String, message: String, val extra: JSONObject? = null) : Exception(message)
+
+/**
+ * The TL boundary of scripting: a plain object from JS becomes a real generated request, the
+ * stock serializer and parser do the wire work, and the answer comes back as plain JSON.
+ */
+object ScriptTl {
+    private const val MAX_DEPTH = 8
+    private const val MAX_VECTOR = 1000
+    private const val MAX_STRING = 512 * 1024
+    private const val TIMEOUT_SECONDS = 60L
+
+    private val blocked = listOf(
+        "auth.", "account.deleteAccount", "account.resetAuthorization", "account.getPassword",
+        "account.updatePasswordSettings", "auth.checkPassword", "auth.exportLoginToken",
+        "auth.importLoginToken", "auth.acceptLoginToken", "auth.resetLoginToken"
+    )
+
+    @JvmStatic
+    fun call(account: Int, requestJson: String, alive: () -> Boolean = { true }): JSONObject? {
+        val request = try {
+            JSONObject(requestJson)
+        } catch (e: Throwable) {
+            throw ScriptException("bad-request", "tg.call expects an object")
+        }
+        val method = request.optString("_")
+        if (method.isEmpty()) throw ScriptException("bad-request", "tg.call needs a method in _")
+        if (blocked.any { method == it || (it.endsWith(".") && method.startsWith(it)) }) {
+            throw ScriptException("forbidden", "$method is blocked for scripts")
+        }
+        val info = TeleTl.method(method)
+            ?: throw ScriptException("unsupported", "$method is not in this build's TL layer")
+        val instance = TeleTl.newInstance(info.fqn)
+            ?: throw ScriptException("unsupported", "$method cannot be constructed")
+        fill(instance, request, 0)
+        val response = send(account, instance, alive)
+        return if (response == null) null else json(response, 0)
+    }
+
+    private fun send(account: Int, request: TLObject, alive: () -> Boolean): TLObject? {
+        val latch = CountDownLatch(1)
+        var response: TLObject? = null
+        var error: TLRPC.TL_error? = null
+        ConnectionsManager.getInstance(account).sendRequest(request) { result, failure ->
+            response = result
+            error = failure
+            latch.countDown()
+        }
+        val deadline = System.currentTimeMillis() + TIMEOUT_SECONDS * 1000
+        while (true) {
+            if (latch.await(100, TimeUnit.MILLISECONDS)) break
+            if (!alive()) throw ScriptException("stopped", "the script was stopped")
+            if (System.currentTimeMillis() > deadline) {
+                throw ScriptException("timeout", "the answer did not arrive in $TIMEOUT_SECONDS seconds")
+            }
+        }
+        val failure = error
+        if (failure != null) {
+            throw ScriptException(
+                "rpc",
+                failure.text ?: "request failed",
+                JSONObject().put("code", failure.code)
+            )
+        }
+        return response
+    }
+
+    private fun fill(target: TLObject, source: JSONObject, depth: Int) {
+        if (depth > MAX_DEPTH) throw ScriptException("too-deep", "the request is nested too deeply")
+        val display = TeleTl.displayForFqn(target.javaClass.name) ?: ""
+        val optional = TeleTl.optionalFieldsForFqn(target.javaClass.name)
+        var flags = 0
+        for (key in source.keys()) {
+            if (key == "_" || key == "flags" || key == "flags2") continue
+            val field = fieldOf(target.javaClass, key) ?: continue
+            val value = source.opt(key)
+            if (value == null || value == JSONObject.NULL) continue
+            setField(target, field, value, depth)
+            flags = flags or (optional[field.name] ?: 0)
+        }
+        if (flags != 0) {
+            runCatching {
+                val field = target.javaClass.getField("flags")
+                field.setInt(target, field.getInt(target) or flags)
+            }
+        }
+    }
+
+    private fun fieldOf(type: Class<*>, key: String): Field? {
+        val wanted = listOf(key, snake(key), key.replace("_", "").lowercase())
+        var current: Class<*>? = type
+        while (current != null) {
+            for (field in TeleTl.fields(current)) {
+                val name = field.name
+                if (name == key || name == snake(key) || name.replace("_", "").lowercase() == wanted.last()) {
+                    return field
+                }
+            }
+            current = current.superclass
+        }
+        return null
+    }
+
+    private fun setField(target: TLObject, field: Field, value: Any, depth: Int) {
+        try {
+            val type = field.type
+            when {
+                type == Int::class.javaPrimitiveType || type == Integer::class.java -> {
+                    field.setInt(target, number(value).toInt())
+                }
+                type == Long::class.javaPrimitiveType || type == java.lang.Long::class.java -> {
+                    field.setLong(target, number(value))
+                }
+                type == Boolean::class.javaPrimitiveType || type == java.lang.Boolean::class.java -> {
+                    field.setBoolean(target, bool(value))
+                }
+                type == Double::class.javaPrimitiveType || type == java.lang.Double::class.java -> {
+                    field.setDouble(target, value.toString().toDouble())
+                }
+                type == Float::class.javaPrimitiveType || type == java.lang.Float::class.java -> {
+                    field.setFloat(target, value.toString().toFloat())
+                }
+                type == String::class.java -> field.set(target, value.toString())
+                type == ByteArray::class.java -> field.set(target, bytes(value))
+                List::class.java.isAssignableFrom(type) -> {
+                    if (value !is JSONArray) throw ScriptException("bad-field", "${field.name} expects a list")
+                    if (value.length() > MAX_VECTOR) throw ScriptException("too-big", "${field.name} is too long")
+                    val argument = genericArgument(field)
+                    val list = ArrayList<Any?>()
+                    for (i in 0 until value.length()) {
+                        list.add(vectorItem(argument, value.opt(i), depth + 1))
+                    }
+                    field.set(target, list)
+                }
+                TLObject::class.java.isAssignableFrom(type) -> {
+                    if (value !is JSONObject) throw ScriptException("bad-field", "${field.name} expects an object")
+                    field.set(target, nested(value, depth + 1))
+                }
+                else -> throw ScriptException("bad-field", "${field.name} has an unsupported type")
+            }
+        } catch (e: ScriptException) {
+            throw e
+        } catch (e: Throwable) {
+            FileLog.e(e)
+            throw ScriptException("bad-field", "${field.name}: ${e.message ?: "could not set the value"}")
+        }
+    }
+
+    private fun vectorItem(type: Class<*>?, value: Any?, depth: Int): Any? {
+        if (value == null || value == JSONObject.NULL) return null
+        return when {
+            type == null -> value
+            type == Int::class.javaPrimitiveType || type == Integer::class.java -> number(value).toInt()
+            type == Long::class.javaPrimitiveType || type == java.lang.Long::class.java -> number(value)
+            type == String::class.java -> value.toString()
+            type == ByteArray::class.java -> bytes(value)
+            type == Boolean::class.javaPrimitiveType || type == java.lang.Boolean::class.java -> bool(value)
+            TLObject::class.java.isAssignableFrom(type) -> {
+                if (value !is JSONObject) throw ScriptException("bad-field", "a list item expects an object")
+                nested(value, depth + 1)
+            }
+            else -> value
+        }
+    }
+
+    private fun nested(source: JSONObject, depth: Int): TLObject {
+        if (depth > MAX_DEPTH) throw ScriptException("too-deep", "the request is nested too deeply")
+        val name = source.optString("_")
+        if (name.isEmpty()) throw ScriptException("bad-field", "a nested object needs _")
+        val fqn = TeleTl.resolveClass(name)?.let { TeleTl.fqnOf(it) }
+            ?: throw ScriptException("unsupported", "unknown constructor $name")
+        val object1 = TeleTl.newInstance(fqn)
+            ?: throw ScriptException("unsupported", "unknown constructor $name")
+        fill(object1, source, depth)
+        return object1
+    }
+
+    private fun genericArgument(field: Field): Class<*>? {
+        val generic = field.genericType as? ParameterizedType ?: return null
+        return generic.actualTypeArguments.firstOrNull() as? Class<*>
+    }
+
+    private fun number(value: Any): Long = when (value) {
+        is Number -> value.toLong()
+        is String -> value.toLongOrNull() ?: throw ScriptException("bad-field", "expected a number, got $value")
+        else -> value.toString().toLongOrNull() ?: throw ScriptException("bad-field", "expected a number")
+    }
+
+    private fun bool(value: Any): Boolean = when (value) {
+        is Boolean -> value
+        is Number -> value.toInt() != 0
+        is String -> value.equals("true", true) || value == "1"
+        else -> false
+    }
+
+    private fun bytes(value: Any): ByteArray = when (value) {
+        is JSONArray -> ByteArray(value.length()) { value.optInt(it).toByte() }
+        is String -> try {
+            Base64.getDecoder().decode(value)
+        } catch (e: Throwable) {
+            Base64.getUrlDecoder().decode(value)
+        }
+        else -> throw ScriptException("bad-field", "expected bytes")
+    }
+
+    private fun snake(name: String): String = buildString {
+        for ((index, char) in name.withIndex()) {
+            if (char.isUpperCase() && index > 0) append('_')
+            append(char.lowercaseChar())
+        }
+    }
+
+    @JvmStatic
+    fun json(object1: TLObject, depth: Int = 0): JSONObject {
+        if (depth > MAX_DEPTH) return JSONObject().put("_", "truncated")
+        val result = JSONObject()
+        val name = TeleTl.nameOfClass(object1.javaClass.name)?.substringAfterLast('.')
+        if (name != null) result.put("_", name)
+        for (field in TeleTl.fields(object1.javaClass)) {
+            if (field.name == "flags" || field.name == "flags2" || field.name == "constructor") continue
+            val value = runCatching { field.get(object1) }.getOrNull() ?: continue
+            result.put(camel(field.name), valueToJson(value, depth + 1))
+        }
+        return result
+    }
+
+    @JvmStatic
+    fun messageJson(message: TLRPC.Message?, depth: Int = 0): JSONObject? =
+        message?.let { json(it, depth) }
+
+    private fun valueToJson(value: Any?, depth: Int): Any {
+        if (depth > MAX_DEPTH) return "truncated"
+        return when (value) {
+            null -> JSONObject.NULL
+            is String -> if (value.length > MAX_STRING) value.substring(0, MAX_STRING) else value
+            is Boolean, is Int, is Short, is Byte, is Double, is Float -> value
+            is Long -> JSONObject().put("\$b", value.toString())
+            is TLObject -> json(value, depth)
+            is ByteArray -> Base64.getEncoder().encodeToString(value)
+            is Collection<*> -> {
+                val array = JSONArray()
+                for (item in value.take(MAX_VECTOR)) array.put(valueToJson(item, depth + 1))
+                array
+            }
+            else -> value.toString()
+        }
+    }
+
+    private fun camel(name: String): String = buildString {
+        var upper = false
+        for (char in name) {
+            if (char == '_') {
+                upper = true
+            } else if (upper) {
+                append(char.uppercaseChar())
+                upper = false
+            } else {
+                append(char)
+            }
+        }
+    }
+}
diff --git a/TMessagesProj/src/main/java/tele/scripting/ScriptTypes.kt b/TMessagesProj/src/main/java/tele/scripting/ScriptTypes.kt
new file mode 100644
index 0000000..b114810
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/scripting/ScriptTypes.kt
@@ -0,0 +1,124 @@
+package tele.scripting
+
+import org.telegram.messenger.ApplicationLoader
+import java.io.File
+
+/** The typings and tsconfig of the Android script API; user edits of tsconfig are never overwritten. */
+object ScriptTypes {
+    private const val TYPES = """/*
+ * tele for android: the scripting API of this build.
+ * Imported code is untrusted. A script only gets the permissions the user approves.
+ */
+
+declare type Grant = string;
+
+declare interface ScriptConfig {
+  name: string;
+  grants?: Grant[];
+  setup?(tg: Tele): void | Promise<void>;
+}
+
+declare function defineScript(config: ScriptConfig): ScriptConfig;
+
+declare interface Tele {
+  readonly selfId: bigint;
+  readonly scriptName: string;
+  readonly peers: { resolve(name: string): Promise<PeerInfo | null> };
+  readonly storage: {
+    get(key: string): unknown;
+    set(key: string, value: unknown): boolean;
+    delete(key: string): boolean;
+    keys(): string[];
+    clear(): boolean;
+  };
+  readonly options: {
+    list(): unknown[];
+    get(id: string): unknown;
+    set(id: string, value: unknown): boolean;
+    onChange(id: string, callback: (change: unknown) => void): () => void;
+  };
+  call(request: Record<string, unknown>): Promise<Record<string, unknown> | null>;
+  randomId(): bigint;
+  log(...args: unknown[]): void;
+  onUnload(callback: () => void): void;
+  onUpdate(callback: (update: Record<string, unknown>) => void): () => void;
+  onNewMessage(callback: (message: Message, peers: unknown) => void): () => void;
+  onMessageEdited(callback: (message: Message, previous: Message | null) => void): () => void;
+  onMessageDeleted(callback: (event: { chatId: bigint | null; ids: bigint[]; messages: (Message | null)[] }) => void): () => void;
+  messageAction(options: { text: string; icon?: string; chats?: string | string[]; onClick?: (context: { chatId: bigint; messageId: number; text: string; date: number; out: boolean }) => void }): () => void;
+  decorateMessages(decorator: (message: Message) => MessageDecoration | null | void | Promise<MessageDecoration | null | void>): () => void;
+  decorateMessage(peer: PeerLike, id: number, decoration: MessageDecoration | null): Promise<void>;
+  getMe(): Promise<Record<string, unknown>>;
+  sendMessage(peer: PeerLike, text: string, options?: Record<string, unknown>): Promise<Message>;
+  getHistory(peer: PeerLike, options?: Record<string, unknown>): Promise<Message[]>;
+  getMessages(peer: PeerLike, ids: number | number[]): Promise<Message | (Message | null)[]>;
+}
+
+declare interface MessageDecoration {
+  text?: string;
+  footer?: string;
+  badge?: string;
+  opacity?: number;
+  hidden?: boolean;
+}
+
+declare interface PeerInfo {
+  id: bigint;
+  kind: 'user' | 'bot' | 'chat' | 'supergroup' | 'channel';
+  name: string;
+  username?: string;
+  input: Record<string, unknown>;
+}
+
+declare type PeerLike = string | number | bigint | PeerInfo | Message | Record<string, unknown>;
+
+declare class Message {
+  readonly id: number;
+  readonly chatId: bigint | null;
+  readonly text: string;
+  readonly date: number;
+  readonly out: boolean;
+  readonly raw: Record<string, unknown>;
+}
+
+declare class TeleError extends Error {
+  readonly code: string;
+  readonly grant?: string;
+}
+
+declare const tg: Tele;
+declare function fetch(input: string, init?: Record<string, unknown>): Promise<{
+  ok: boolean;
+  status: number;
+  statusText: string;
+  url: string;
+  headers: { get(name: string): string | null; has(name: string): boolean };
+  text(): Promise<string>;
+  json(): Promise<unknown>;
+  arrayBuffer(): Promise<ArrayBuffer>;
+}>;
+declare const console: { log(...args: unknown[]): void; info(...args: unknown[]): void; warn(...args: unknown[]): void; error(...args: unknown[]): void };
+"""
+
+    const val TSCONFIG = """{
+  "compilerOptions": {
+    "target": "ES2022",
+    "module": "ESNext",
+    "moduleResolution": "Bundler",
+    "strict": true,
+    "noEmit": true,
+    "types": []
+  },
+  "include": ["**/*.ts", "**/*.mts"]
+}
+"""
+
+    @JvmStatic
+    fun write() {
+        val root = ScriptScanner.root()
+        val types = File(root, "tele.d.ts")
+        if (!types.exists() || types.readText() != TYPES) types.writeText(TYPES)
+        val config = File(root, "tsconfig.json")
+        if (!config.exists()) config.writeText(TSCONFIG)
+    }
+}
