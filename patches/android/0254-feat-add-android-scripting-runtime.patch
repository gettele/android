+    public void showPasscodeActivity(boolean fingerprint, boolean animated, int x, int y, Runnable onShow, Runnable onStart) {
+        if (drawerLayoutContainer == null || isFinishing()) {
+            return;
+        }
+        if (passcodeDialog == null) {
