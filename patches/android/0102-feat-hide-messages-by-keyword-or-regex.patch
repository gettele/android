+package tele.ui.settings
+
+import android.content.Context
+import android.text.InputType
+import android.view.Gravity
+import android.view.View
+import android.view.ViewGroup
+import android.widget.EditText
+import android.widget.LinearLayout
+import android.widget.ScrollView
+import android.widget.Toast
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.R
+import org.telegram.ui.ActionBar.ActionBar
+import org.telegram.ui.ActionBar.BaseFragment
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Cells.TextSettingsCell
+import org.telegram.ui.Components.EditTextBoldCursor
+import org.telegram.ui.Components.LayoutHelper
+import tele.helpers.PrivacyRules
+
+/**
+ * Editor of the hidden word rules: one rule per line, a plain text or a /regex/ in java regex syntax.
+ */
+class TeleWordsActivity(private val account: Int, private val dialogId: Long) : BaseFragment() {
+
+    private var field: EditTextBoldCursor? = null
+
+    override fun createView(context: Context): View {
+        actionBar.setBackButtonImage(R.drawable.ic_ab_back)
+        actionBar.setAllowOverlayTitle(true)
+        actionBar.setTitle(if (dialogId == 0L) "hidden words" else "hidden words for this chat")
+        actionBar.setActionBarMenuOnItemClick(object : ActionBar.ActionBarMenuOnItemClick() {
+            override fun onItemClick(id: Int) {
+                if (id == -1) {
+                    finishFragment()
+                }
+            }
+        })
+
+        val container = LinearLayout(context)
+        container.orientation = LinearLayout.VERTICAL
+        container.setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundGray))
+        container.setPadding(AndroidUtilities.dp(16f), AndroidUtilities.dp(12f), AndroidUtilities.dp(16f), AndroidUtilities.dp(12f))
+
+        val input = EditTextBoldCursor(context)
+        input.setText(if (dialogId == 0L) PrivacyRules.hiddenWords(account) else PrivacyRules.chatHiddenWords(account, dialogId))
+        input.setHint("one rule per line")
+        input.setGravity(Gravity.TOP or Gravity.START)
+        input.setInputType(InputType.TYPE_CLASS_TEXT or InputType.TYPE_TEXT_FLAG_MULTI_LINE or InputType.TYPE_TEXT_FLAG_NO_SUGGESTIONS)
+        input.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
+        input.setHintTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteHintText))
+        input.setBackgroundDrawable(null)
+        input.setLineColors(
+            Theme.getColor(Theme.key_windowBackgroundWhiteInputField),
+            Theme.getColor(Theme.key_windowBackgroundWhiteInputFieldActivated),
+            Theme.getColor(Theme.key_text_RedRegular)
+        )
+        field = input
+        container.addView(input, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, 0, 1f))
+
+        val save = TextSettingsCell(context)
+        save.setText("save", false)
+        save.setOnClickListener { save() }
+        container.addView(save, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT))
+
+        fragmentView = container
+        return container
+    }
+
+    private fun save() {
+        val text = field?.text?.toString() ?: ""
+        var lineNumber = 0
+        for (line in text.split('\n')) {
+            lineNumber++
+            val trimmed = line.trim()
+            if (trimmed.length <= 2 || !trimmed.startsWith("/")) {
+                continue
+            }
+            if (PrivacyRules.parseRule(trimmed) == null) {
+                val activity = parentActivity
+                if (activity != null) {
+                    Toast.makeText(activity, "line $lineNumber is not a valid regex", Toast.LENGTH_SHORT).show()
+                }
+                return
+            }
+        }
+        if (dialogId == 0L) {
+            PrivacyRules.setHiddenWords(account, text)
+        } else {
+            PrivacyRules.setChatHiddenWords(account, dialogId, text)
+        }
+        tele.TeleHooks.onPrivacyRulesChanged()
+        finishFragment()
+    }
+}
