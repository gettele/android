diff --git a/TMessagesProj/src/main/java/tele/helpers/PrivacyRules.kt b/TMessagesProj/src/main/java/tele/helpers/PrivacyRules.kt
index 22cc0ea21..46499dbd4 100644
--- a/TMessagesProj/src/main/java/tele/helpers/PrivacyRules.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/PrivacyRules.kt
@@ -289,6 +289,27 @@ object PrivacyRules {
         return null
     }
 
+    /** The message is classified by the ignore list or by the hidden word rules, in any display mode. */
+    @JvmStatic
+    fun isMuted(account: Int, dialogId: Long, message: MessageObject?): Boolean {
+        if (message == null) {
+            return false
+        }
+        if (message.isOutOwner() || message.messageOwner is TLRPC.TL_messageService || message.isSponsored()) {
+            return false
+        }
+        if (TeleConfig.IGNORE_USERS.value) {
+            if (ignoredMode(account, dialogId) != null) {
+                return true
+            }
+            val sender = message.getFromChatId()
+            if (sender != dialogId && ignoredMode(account, sender) != null) {
+                return true
+            }
+        }
+        return TeleConfig.HIDDEN_WORDS.value && matchesWords(account, dialogId, messageText(message))
+    }
+
     /** The chat list preview of one message: hide, fade or null. */
     @JvmStatic
     fun previewMode(account: Int, dialogId: Long, message: MessageObject?): String? = messageMode(account, dialogId, message)
