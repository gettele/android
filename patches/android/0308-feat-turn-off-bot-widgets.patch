From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: test <test@example.com>
Date: Sun, 8 Nov 2026 22:07:47 +0300
Subject: [PATCH] feat: turn off bot widgets

---
 .../java/org/telegram/messenger/RichMessageLayout.java    | 5 +++++
 .../main/java/org/telegram/ui/Cells/ChatMessageCell.java  | 8 ++++++--
 .../main/java/org/telegram/ui/Cells/ContextLinkCell.java  | 2 +-
 TMessagesProj/src/main/java/tele/TeleConfig.kt            | 2 ++
 .../main/java/tele/ui/settings/TeleSettingsActivity.kt    | 4 ++++
 5 files changed, 18 insertions(+), 3 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/RichMessageLayout.java b/TMessagesProj/src/main/java/org/telegram/messenger/RichMessageLayout.java
index a16f92293..3b396d715 100644
--- a/TMessagesProj/src/main/java/org/telegram/messenger/RichMessageLayout.java
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/RichMessageLayout.java
@@ -1181,6 +1181,11 @@ public class RichMessageLayout {
             return null;
         } else if (pageBlock instanceof TL_iv.pageBlockEmbed && RichWidgetBlock.supports((TL_iv.pageBlockEmbed) pageBlock)) {
             final TL_iv.pageBlockEmbed embed = (TL_iv.pageBlockEmbed) pageBlock;
+            if (tele.TeleConfig.NO_WIDGETS.getValue()) {
+                // the caption stays, the widget itself never runs: no scripts, no requests
+                emitCaption(embed.caption, padding, textFlags);
+                return null;
+            }
             final RichBlock block = new RichWidgetBlock(this, padding, RichWidgetBlock.contentWidth(embed, maxWidth), embed, blocks.isEmpty());
             blocks.add(block);
             emitCaption(embed.caption, padding, textFlags);
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Cells/ChatMessageCell.java b/TMessagesProj/src/main/java/org/telegram/ui/Cells/ChatMessageCell.java
index 5e42b7735..08eb903a6 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Cells/ChatMessageCell.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Cells/ChatMessageCell.java
@@ -2325,9 +2325,13 @@ public class ChatMessageCell extends BaseCell implements SeekBar.SeekBarDelegate
     // MotionEvent#getDownTime of the last press on the cell (isWidgetPress).
     private long lastTouchDownTime;
 
-    /** The widget of a widget message, or null. */
+    /** The widget of a widget message, or null: widgets off leaves the message without one. */
     private RichWidgetBlock widgetBlock() {
-        return currentMessageObject != null && isWidgetMessage() ? (RichWidgetBlock) currentMessageObject.richLayout.blocks.get(0) : null;
+        if (currentMessageObject == null || !isWidgetMessage() || currentMessageObject.richLayout.blocks.isEmpty()) {
+            return null;
+        }
+        final RichMessageLayout.RichBlock first = currentMessageObject.richLayout.blocks.get(0);
+        return first instanceof RichWidgetBlock ? (RichWidgetBlock) first : null;
     }
 
     /**
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Cells/ContextLinkCell.java b/TMessagesProj/src/main/java/org/telegram/ui/Cells/ContextLinkCell.java
index 0341c011f..a2b2464f8 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Cells/ContextLinkCell.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Cells/ContextLinkCell.java
@@ -545,7 +545,7 @@ public class ContextLinkCell extends FrameLayout implements DownloadController.F
         mediaWebpage = media;
         isForceGif = forceGif;
         if (widgetPreview != null) widgetPreview.hide();
-        widgetPreview = org.telegram.ui.Components.WidgetInlinePreview.supports(contextResult)
+        widgetPreview = !tele.TeleConfig.NO_WIDGETS.getValue() && org.telegram.ui.Components.WidgetInlinePreview.supports(contextResult)
                 ? new org.telegram.ui.Components.WidgetInlinePreview(this, currentAccount, contextResult, resourcesProvider) : null;
         setAttachType();
         if (forceGif) {
diff --git a/TMessagesProj/src/main/java/tele/TeleConfig.kt b/TMessagesProj/src/main/java/tele/TeleConfig.kt
index 199763b05..088b22a5e 100644
--- a/TMessagesProj/src/main/java/tele/TeleConfig.kt
+++ b/TMessagesProj/src/main/java/tele/TeleConfig.kt
@@ -61,6 +61,8 @@ object TeleConfig {
     @JvmField
     val NO_AI = BoolItem("no_ai", false)
     @JvmField
+    val NO_WIDGETS = BoolItem("no_widgets", false)
+    @JvmField
     val REACTIONS_STRIP_COUNT = StringItem("reactions_strip_count", "")
     @JvmField
     val RESTRICT_MENU = BoolItem("restrict_menu", false)
diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
index 2d3a1dd77..8803ddd4e 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
@@ -1438,6 +1438,10 @@ class TeleSettingsActivity @JvmOverloads constructor(private val mode: String =
                 Row(TYPE_HEADER, "Downloads"),
                 toggle("Save downloads in a folder per chat", TeleConfig.DOWNLOADS_PER_CHAT),
                 Row(TYPE_SHADOW),
+                Row(TYPE_HEADER, "Widgets"),
+                toggle("Turn off bot widgets", TeleConfig.NO_WIDGETS),
+                Row(TYPE_SHADOW, "Bot widgets show a static notice instead of running their scripts and asking the network: after a restart they keep their captions and nothing else. The message field and the links stay as usual."),
+                Row(TYPE_SHADOW),
                 Row(TYPE_HEADER, "Sponsored"),
                 toggle("Hide sponsored messages", TeleConfig.HIDE_SPONSORED),
                 toggle("Hide the proxy sponsor channel", TeleConfig.HIDE_PROXY_SPONSOR),
