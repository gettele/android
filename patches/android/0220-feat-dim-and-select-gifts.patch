@@ -0,0 +1,307 @@
+package tele.helpers
+
+import android.content.Context
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.BirthdayController
+import org.telegram.messenger.DialogObject
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.MessagesController
+import org.telegram.messenger.R
+import org.telegram.tgnet.ConnectionsManager
+import org.telegram.tgnet.TLRPC
+import org.telegram.tgnet.tl.TL_stars
+import org.telegram.ui.ActionBar.AlertDialog
+import org.telegram.ui.ActionBar.BaseFragment
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Components.BulletinFactory
+import org.telegram.ui.Components.Premium.boosts.UserSelectorBottomSheet
+import org.telegram.ui.Stars.StarGiftSheet
+import org.telegram.ui.Stars.StarsController
+import org.telegram.ui.Stars.StarsIntroActivity
+import org.telegram.messenger.Utilities
+
+/**
+ * The bulk actions of the gift selection (desktop 0185): show, hide, pin, unpin and transfer. Each
+ * one runs over [GiftSelection.gifts] one by one, stops at the first error and leaves the select mode.
+ */
+object GiftBulk {
+
+    @JvmStatic
+    fun canShow(selection: GiftSelection): Boolean =
+        canToggleSaved(selection) && selection.gifts.any { it.unsaved }
+
+    @JvmStatic
+    fun canHide(selection: GiftSelection): Boolean =
+        canToggleSaved(selection) && selection.gifts.any { !it.unsaved }
+
+    @JvmStatic
+    fun canTransfer(selection: GiftSelection): Boolean {
+        val gifts = selection.gifts
+        return gifts.isNotEmpty() && gifts.all { transferable(selection.currentAccount, it) }
+    }
+
+    @JvmStatic
+    fun canPin(selection: GiftSelection): Boolean {
+        val gifts = selection.gifts
+        return pinnable(selection) && gifts.isNotEmpty()
+            && gifts.any { !it.pinned_to_top }
+            && gifts.all { it.gift is TL_stars.TL_starGiftUnique && !it.unsaved }
+    }
+
+    @JvmStatic
+    fun canUnpin(selection: GiftSelection): Boolean {
+        val gifts = selection.gifts
+        return pinnable(selection) && gifts.isNotEmpty() && gifts.all { it.pinned_to_top }
+    }
+
+    private fun canToggleSaved(selection: GiftSelection): Boolean =
+        StarGiftSheet.isMineWithActions(selection.currentAccount, selection.dialogId)
+
+    // pinned gifts live on the main list only, like in the menu of a gift
+    private fun pinnable(selection: GiftSelection): Boolean =
+        selection.canPin && selection.list === selection.allList
+
+    /** A unique gift of the user (or of a channel they own) that is not locked for transfers. */
+    @JvmStatic
+    fun transferable(currentAccount: Int, gift: TL_stars.SavedStarGift): Boolean {
+        val unique = gift.gift as? TL_stars.TL_starGiftUnique ?: return false
+        if (unique.owner_id == null) return false
+        if (gift.can_transfer_at > ConnectionsManager.getInstance(currentAccount).currentTime) return false
+        return StarGiftSheet.isMineWithActions(currentAccount, DialogObject.getPeerDialogId(unique.owner_id))
+    }
+
+    private fun bulletins(fragment: BaseFragment?): BulletinFactory = BulletinFactory.of(fragment)
+
+    private fun toast(selection: GiftSelection, fragment: BaseFragment?, site: String, text: CharSequence) {
+        TeleToast.log(site, text, account = selection.currentAccount)
+        bulletins(fragment).createSimpleBulletin(R.raw.chats_infotip, text).show()
+    }
+
+    private fun showError(fragment: BaseFragment?, error: TLRPC.TL_error?) {
+        bulletins(fragment).showForError(error)
+    }
+
+    /** Shows ([save]) or hides the picked gifts that are not like that yet. */
+    @JvmStatic
+    fun setSaved(selection: GiftSelection, save: Boolean, fragment: BaseFragment?) {
+        if (selection.isBusy) return
+        val account = selection.currentAccount
+        val targets = selection.gifts.filter { it.unsaved == save }
+        if (targets.isEmpty()) return
+        selection.work(true, LocaleController.formatString(R.string.TeleGiftsProgress, 1, targets.size))
+        val connections = ConnectionsManager.getInstance(account)
+
+        fun finish(done: Int) {
+            if (done == targets.size) {
+                toast(
+                    selection, fragment, if (save) "gifts-shown" else "gifts-hidden",
+                    LocaleController.formatPluralString(if (save) "TeleGiftsShown" else "TeleGiftsHidden", done)
+                )
+            }
+            selection.exit()
+        }
+
+        fun step(index: Int) {
+            if (index == targets.size || selection.isCancelled) {
+                finish(index)
+                return
+            }
+            selection.work(true, LocaleController.formatString(R.string.TeleGiftsProgress, index + 1, targets.size))
+            val gift = targets[index]
+            val request = TL_stars.saveStarGift()
+            request.stargift = selection.list.getInput(gift)
+            request.unsave = !save
+            connections.sendRequest(request) { _, err ->
+                AndroidUtilities.runOnUIThread {
+                    if (err != null) {
+                        showError(fragment, err)
+                        finish(index)
+                        return@runOnUIThread
+                    }
+                    // a hidden gift can't stay pinned, like in its menu
+                    if (!save && gift.pinned_to_top && !selection.list.isCollection) {
+                        selection.list.togglePinned(gift, false, false)
+                    }
+                    selection.collections.updateGiftsUnsaved(gift, !save)
+                    gift.unsaved = !save
+                    step(index + 1)
+                }
+            }
+        }
+        step(0)
+    }
+
+    /** Pins ([pin]) or unpins the picked gifts; pinning stops before the limit is exceeded. */
+    @JvmStatic
+    fun setPinned(selection: GiftSelection, pin: Boolean, fragment: BaseFragment?) {
+        if (selection.isBusy || !pinnable(selection)) return
+        val list = selection.list
+        val targets = selection.gifts.filter { it.pinned_to_top != pin }
+        if (targets.isEmpty()) return
+        if (pin) {
+            val limit = MessagesController.getInstance(selection.currentAccount).stargiftsPinnedToTopLimit
+            if (list.getPinned().size + targets.size > limit) {
+                bulletins(fragment).createSimpleBulletin(R.raw.chats_infotip, LocaleController.formatPluralStringComma("GiftsPinLimit", limit)).show()
+                return
+            }
+        }
+        // the list sends its new pinned order itself after each change
+        for (gift in targets) list.togglePinned(gift, pin, false)
+        toast(
+            selection, fragment, if (pin) "gifts-pinned" else "gifts-unpinned",
+            LocaleController.formatPluralString(if (pin) "TeleGiftsPinned" else "TeleGiftsUnpinned", targets.size)
+        )
+        selection.exit()
+    }
+
+    /**
+     * Transfers the picked gifts to a person or a channel they choose: one confirmation for all, then
+     * one transfer after another; the first error stops the run. Paid transfers are never retried.
+     */
+    @JvmStatic
+    fun transfer(selection: GiftSelection, fragment: BaseFragment?, context: Context, resourcesProvider: Theme.ResourcesProvider?) {
+        if (selection.isBusy || !canTransfer(selection)) return
+        val account = selection.currentAccount
+        val gifts = selection.gifts
+        val sheet = UserSelectorBottomSheet(
+            context, account, 0, BirthdayController.getInstance(account).state,
+            UserSelectorBottomSheet.TYPE_TRANSFER, true, resourcesProvider
+        )
+        sheet.setTitle(LocaleController.formatPluralString("TeleGiftsTransferTitle", gifts.size))
+        sheet.setOnUserSelector(Utilities.Callback<Long> { to ->
+            if (to == UserSelectorBottomSheet.OPTION_FRAGMENT || to == UserSelectorBottomSheet.OPTION_MY_WALLET || to == UserSelectorBottomSheet.OPTION_MY_GIFTS) {
+                return@Callback
+            }
+            confirmTransfer(selection, gifts, to, fragment, context, resourcesProvider, sheet)
+        })
+        sheet.show()
+    }
+
+    private fun confirmTransfer(
+        selection: GiftSelection,
+        gifts: List<TL_stars.SavedStarGift>,
+        to: Long,
+        fragment: BaseFragment?,
+        context: Context,
+        resourcesProvider: Theme.ResourcesProvider?,
+        sheet: UserSelectorBottomSheet
+    ) {
+        val stars = gifts.sumOf { maxOf(it.transfer_stars, 0L) }
+        val name = DialogObject.getShortName(to)
+        val text: CharSequence = if (stars > 0) {
+            StarsIntroActivity.replaceStarsWithPlain(
+                LocaleController.formatPluralString("TeleGiftsTransferConfirmPrice", gifts.size, name, "XTR " + LocaleController.formatNumber(stars, ',')),
+                .66f
+            )
+        } else {
+            LocaleController.formatPluralString("TeleGiftsTransferConfirm", gifts.size, name)
+        }
+        AlertDialog.Builder(context, resourcesProvider)
+            .setTitle(LocaleController.formatPluralString("TeleGiftsTransferTitle", gifts.size))
+            .setMessage(text)
+            .setPositiveButton(LocaleController.getString(R.string.Gift2TransferDo)) { _, _ ->
+                sheet.dismiss()
+                // the whole batch is one protected action
+                StarsLock.guard(fragment, "transfer") {
+                    if (!selection.isBusy) runTransfer(selection, gifts, to, fragment)
+                }
+            }
+            .setNegativeButton(LocaleController.getString(R.string.Cancel), null)
+            .show()
+    }
+
+    private fun runTransfer(selection: GiftSelection, gifts: List<TL_stars.SavedStarGift>, to: Long, fragment: BaseFragment?) {
+        val account = selection.currentAccount
+        val connections = ConnectionsManager.getInstance(account)
+        val messages = MessagesController.getInstance(account)
+        val total = gifts.size
+        var paid = false
+
+        fun finish(done: Int, problem: CharSequence?) {
+            if (paid) {
+                StarsController.getInstance(account).invalidateBalance()
+                StarsController.getInstance(account).invalidateTransactions(false)
+            }
+            if (done > 0) StarsController.getInstance(account).invalidateProfileGifts(to)
+            if (done == total) {
+                toast(
+                    selection, fragment, "gifts-transferred",
+                    LocaleController.formatPluralString("TeleGiftsTransferred", done, DialogObject.getShortName(to))
+                )
+            } else {
+                toast(
+                    selection, fragment, "gifts-transfer-stopped",
+                    LocaleController.formatString(R.string.TeleGiftsTransferStopped, done, total) + (if (problem.isNullOrEmpty()) "" else " $problem")
+                )
+            }
+            selection.exit()
+        }
+
+        fun step(index: Int) {
+            if (index == total || selection.isCancelled) {
+                finish(index, null)
+                return
+            }
+            selection.work(true, LocaleController.formatString(R.string.TeleGiftsProgress, index + 1, total))
+            val gift = gifts[index]
+            val input = selection.list.getInput(gift)
+            val peer = messages.getInputPeer(to)
+            val sent = Runnable {
+                StarsController.getInstance(account).removeProfileGiftLocally(selection.dialogId, gift)
+                selection.remove(gift)
+                step(index + 1)
+            }
+            if (gift.transfer_stars <= 0) {
+                val request = TL_stars.transferStarGift()
+                request.stargift = input
+                request.to_id = peer
+                connections.sendRequest(request) { response, err ->
+                    AndroidUtilities.runOnUIThread {
+                        if (response is TLRPC.Updates) {
+                            messages.processUpdates(response, false)
+                            sent.run()
+                        } else {
+                            finish(index, err?.text)
+                        }
+                    }
+                }
+                return
+            }
+            paid = true
+            val invoice = TLRPC.TL_inputInvoiceStarGiftTransfer()
+            invoice.stargift = input
+            invoice.to_id = peer
+            val formRequest = TLRPC.TL_payments_getPaymentForm()
+            formRequest.invoice = invoice
+            connections.sendRequest(formRequest) { form, formError ->
+                AndroidUtilities.runOnUIThread {
+                    if (form !is TLRPC.PaymentForm) {
+                        // nothing was charged yet
+                        finish(index, formError?.text)
+                        return@runOnUIThread
+                    }
+                    messages.putUsers(form.users, false)
+                    val pay = TL_stars.TL_payments_sendStarsForm()
+                    pay.form_id = form.form_id
+                    pay.invoice = invoice
+                    connections.sendRequest(pay) { result, payError ->
+                        AndroidUtilities.runOnUIThread {
+                            if (result is TLRPC.TL_payments_paymentResult) {
+                                messages.putUsers(result.updates.users, false)
+                                messages.putChats(result.updates.chats, false)
+                                Utilities.stageQueue.postRunnable { messages.processUpdates(result.updates, false) }
+                                sent.run()
+                            } else {
+                                val text = payError?.text
+                                // the result of the payment is unknown unless the server says the balance is too low
+                                val hint = if (text == "BALANCE_TOO_LOW") "" else LocaleController.getString(R.string.TeleGiftsCheckBalance)
+                                finish(index, (text ?: "") + (if (hint.isEmpty()) "" else " $hint"))
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        step(0)
+    }
+}
diff --git a/TMessagesProj/src/main/java/tele/helpers/GiftSelection.kt b/TMessagesProj/src/main/java/tele/helpers/GiftSelection.kt
