--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/GiftSelection.kt
@@ -0,0 +1,127 @@
+package tele.helpers
+
+import org.telegram.ui.Stars.StarGiftSheet
+import org.telegram.ui.Stars.StarsController
+import org.telegram.tgnet.tl.TL_stars
+import tele.TeleConfig
+
+/**
+ * The gifts a user picks in the gift list of a profile (desktop 0185). One instance per profile gifts
+ * container; bulk actions read [gifts] and call [remove] / [exit] as they go (see [GiftBulk]).
+ */
+class GiftSelection(
+    @JvmField val currentAccount: Int,
+    @JvmField val dialogId: Long,
+    @JvmField val allList: StarsController.GiftsList,
+    @JvmField val collections: StarsController.GiftsCollections,
+    // the user can pin gifts of this profile
+    @JvmField val canPin: Boolean
+) {
+
+    private val selected = LinkedHashMap<String, TL_stars.SavedStarGift>()
+    private val listeners = ArrayList<Runnable>()
+
+    /** The list of the page that is shown: the selection never spans pages. */
+    @JvmField
+    var list: StarsController.GiftsList = allList
+
+    var isActive = false
+        private set
+
+    /** An action is running: the bar is locked and clicks on gifts do nothing. */
+    var isBusy = false
+        private set
+
+    /** Asked to stop after the step the running action is on. */
+    var isCancelled = false
+        private set
+
+    /** What the bar shows instead of the count while an action runs. */
+    var status: CharSequence? = null
+        private set
+
+    val count: Int get() = selected.size
+
+    /** The selected gifts in the order they were picked; a copy. */
+    val gifts: List<TL_stars.SavedStarGift> get() = ArrayList(selected.values)
+
+    fun isSelected(gift: TL_stars.SavedStarGift?): Boolean = gift != null && selected.containsKey(key(gift))
+
+    fun addListener(listener: Runnable) {
+        listeners.add(listener)
+    }
+
+    fun removeListener(listener: Runnable) {
+        listeners.remove(listener)
+    }
+
+    fun enter() {
+        if (isActive) return
+        isActive = true
+        isCancelled = false
+        selected.clear()
+        fire()
+    }
+
+    fun exit() {
+        if (!isActive) return
+        isActive = false
+        isBusy = false
+        isCancelled = false
+        status = null
+        selected.clear()
+        fire()
+    }
+
+    fun cancel() {
+        isCancelled = true
+    }
+
+    /** Drops the picked gifts, e.g. when another page comes. */
+    fun clear() {
+        if (selected.isEmpty()) return
+        selected.clear()
+        fire()
+    }
+
+    /** Picks or unpicks a gift; false when nothing changed (not active or busy). */
+    fun toggle(gift: TL_stars.SavedStarGift): Boolean {
+        if (!isActive || isBusy) return false
+        val key = key(gift)
+        if (selected.remove(key) == null) selected[key] = gift
+        fire()
+        return true
+    }
+
+    fun remove(gift: TL_stars.SavedStarGift) {
+        if (selected.remove(key(gift)) != null) fire()
+    }
+
+    fun work(busy: Boolean, status: CharSequence? = null) {
+        isBusy = busy
+        this.status = if (busy) status else null
+        fire()
+    }
+
+    private fun fire() {
+        for (listener in ArrayList(listeners)) listener.run()
+    }
+
+    companion object {
+        /** The same gift in two lists has two objects; this key is the same for both. */
+        @JvmStatic
+        fun key(gift: TL_stars.SavedStarGift): String {
+            if (gift.flags and 8 != 0) return "m" + gift.msg_id
+            if (gift.saved_id != 0L) return "s" + gift.saved_id
+            // gifts of someone else's profile carry neither id, so "s0" would merge them all
+            val unique = gift.gift as? TL_stars.TL_starGiftUnique
+            if (unique != null) return "u" + unique.id
+            return "g" + gift.gift?.id + ":" + gift.date + ":" + org.telegram.messenger.DialogObject.getPeerDialogId(gift.from_id)
+        }
+
+        /** Whether the profile has the select mode at all: the option is on and the user manages its gifts. */
+        @JvmStatic
+        fun available(currentAccount: Int, dialogId: Long, canReorder: Boolean): Boolean =
+            TeleConfig.GIFT_SELECT.value && (StarGiftSheet.isMineWithActions(currentAccount, dialogId) || canReorder)
+    }
+}
