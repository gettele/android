@@ -0,0 +1,142 @@
+package tele.ui
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.PorterDuff
+import android.graphics.PorterDuffColorFilter
+import android.graphics.Paint
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.View
+import android.widget.ImageView
+import android.widget.LinearLayout
+import android.widget.TextView
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.AndroidUtilities.dp
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.R
+import org.telegram.ui.ActionBar.BaseFragment
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Components.LayoutHelper
+import tele.helpers.GiftBulk
+import tele.helpers.GiftSelection
+
+/** The bar under the gift list while gifts are being picked: the count, cancel and the bulk actions. */
+class TeleGiftSelectionBar(
+    context: Context,
+    private val resourcesProvider: Theme.ResourcesProvider?,
+    private val selection: GiftSelection,
+    private val fragment: BaseFragment?
+) : LinearLayout(context) {
+
+    private val closeView = ImageView(context)
+    private val titleView = TextView(context)
+    private val buttons = LinearLayout(context)
+    private val showButton: TextView
+    private val hideButton: TextView
+    private val transferButton: TextView
+    private val pinButton: TextView
+    private val unpinButton: TextView
+    private val linePaint = Paint()
+    private val refresh = Runnable { update() }
+
+    init {
+        orientation = VERTICAL
+        setWillNotDraw(false)
+        setBackgroundColor(color(Theme.key_windowBackgroundWhite))
+        linePaint.color = color(Theme.key_divider)
+
+        val header = LinearLayout(context)
+        header.orientation = HORIZONTAL
+        header.gravity = Gravity.CENTER_VERTICAL
+        addView(header, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, 48))
+
+        closeView.id = ID_CANCEL
+        closeView.scaleType = ImageView.ScaleType.CENTER
+        closeView.setImageResource(R.drawable.msg_close)
+        closeView.colorFilter = PorterDuffColorFilter(color(Theme.key_windowBackgroundWhiteBlackText), PorterDuff.Mode.SRC_IN)
+        closeView.background = Theme.createSelectorDrawable(Theme.multAlpha(color(Theme.key_windowBackgroundWhiteBlackText), .12f), Theme.RIPPLE_MASK_CIRCLE_20DP, dp(20f))
+        closeView.contentDescription = LocaleController.getString(R.string.Cancel)
+        closeView.setOnClickListener {
+            // a running action stops after its current step and then leaves the mode itself
+            if (selection.isBusy) selection.cancel() else selection.exit()
+        }
+        header.addView(closeView, LayoutHelper.createLinear(48, 48))
+
+        titleView.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 17f)
+        titleView.typeface = AndroidUtilities.bold()
+        titleView.setTextColor(color(Theme.key_windowBackgroundWhiteBlackText))
+        titleView.gravity = Gravity.CENTER_VERTICAL
+        header.addView(titleView, LayoutHelper.createLinear(0, LayoutHelper.MATCH_PARENT, 1f, 4, 0, 16, 0))
+
+        buttons.orientation = HORIZONTAL
+        addView(buttons, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, 40, 12f, 0f, 12f, 12f))
+
+        showButton = button(ID_SHOW, R.string.Gift2ShowGift) { GiftBulk.setSaved(selection, true, fragment) }
+        hideButton = button(ID_HIDE, R.string.Gift2HideGift) { GiftBulk.setSaved(selection, false, fragment) }
+        transferButton = button(ID_TRANSFER, R.string.Gift2TransferOption) { GiftBulk.transfer(selection, fragment, context, resourcesProvider) }
+        pinButton = button(ID_PIN, R.string.Gift2Pin) { GiftBulk.setPinned(selection, true, fragment) }
+        unpinButton = button(ID_UNPIN, R.string.Gift2Unpin) { GiftBulk.setPinned(selection, false, fragment) }
+    }
+
+    private fun color(key: Int): Int = Theme.getColor(key, resourcesProvider)
+
+    private fun button(id: Int, text: Int, click: () -> Unit): TextView {
+        val accent = color(Theme.key_featuredStickers_addButton)
+        val view = TextView(context)
+        view.id = id
+        view.gravity = Gravity.CENTER
+        view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15f)
+        view.typeface = AndroidUtilities.bold()
+        view.setTextColor(accent)
+        view.text = LocaleController.getString(text)
+        view.background = Theme.createSimpleSelectorRoundRectDrawable(dp(8f), Theme.multAlpha(accent, .12f), Theme.multAlpha(accent, .24f))
+        view.setOnClickListener { if (!selection.isBusy) click() }
+        buttons.addView(view, LayoutHelper.createLinear(0, LayoutHelper.MATCH_PARENT, 1f, 4, 0, 4, 0))
+        return view
+    }
+
+    private fun update() {
+        titleView.text = selection.status ?: LocaleController.formatString(R.string.TeleGiftsSelected, selection.count)
+        val busy = selection.isBusy
+        var visible = 0
+        for ((view, shown) in listOf(
+            showButton to GiftBulk.canShow(selection),
+            hideButton to GiftBulk.canHide(selection),
+            transferButton to GiftBulk.canTransfer(selection),
+            pinButton to GiftBulk.canPin(selection),
+            unpinButton to GiftBulk.canUnpin(selection)
+        )) {
+            view.visibility = if (shown) View.VISIBLE else View.GONE
+            view.alpha = if (busy) .5f else 1f
+            if (shown) visible++
+        }
+        buttons.visibility = if (visible > 0) View.VISIBLE else View.GONE
+    }
+
+    override fun onAttachedToWindow() {
+        super.onAttachedToWindow()
+        selection.addListener(refresh)
+        update()
+    }
+
+    override fun onDetachedFromWindow() {
+        super.onDetachedFromWindow()
+        selection.removeListener(refresh)
+    }
+
+    override fun onDraw(canvas: Canvas) {
+        canvas.drawRect(0f, 0f, width.toFloat(), 1f, linePaint)
+    }
+
+    companion object {
+        const val ID_CANCEL = 9671
+        const val ID_SHOW = 9666
+        const val ID_HIDE = 9667
+        const val ID_TRANSFER = 9668
+        const val ID_PIN = 9669
+        const val ID_UNPIN = 9670
+        // the "Select gifts" entry of the gifts menu
+        const val ID_SELECT = 9665
+    }
+}
