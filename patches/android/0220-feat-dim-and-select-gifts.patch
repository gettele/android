+    public boolean canSelectGifts() {
+        final Page page = getCurrentPage();
+        return GiftSelection.available(currentAccount, dialogId, canReorder())
+            && !selection.isActive() && !isReordering()
+            && page != null && page.list != null && !page.list.gifts.isEmpty();
+    }
+
+    public void startSelection() {
+        final Page page = getCurrentPage();
+        if (page == null || page.list == null) return;
+        resetReordering();
+        selection.list = page.list;
+        selection.enter();
+    }
+
+    private void toggleSelected(Page page, TL_stars.SavedStarGift gift, View view) {
+        if (selection.list != page.list) {
+            selection.list = page.list;
+            selection.clear();
+        }
+        if (selection.toggle(gift) && view instanceof GiftSheet.GiftCell) {
+            ((GiftSheet.GiftCell) view).setChecked(selection.isSelected(gift), true);
+        }
+    }
+
+    // the picked gifts belong to one page: another page starts from nothing
+    private void syncSelectionPage() {
+        if (!selection.isActive() || selection.isBusy()) return;
+        final Page page = getCurrentPage();
+        if (page != null && page.list != null && page.list != selection.list) {
+            selection.list = page.list;
+            selection.clear();
+        }
+    }
+
+    private void onSelectionChanged() {
+        final boolean active = selection.isActive();
+        final View[] pages = viewPager.getViewPages();
+        if (active != selectionShown) {
+            selectionShown = active;
+            if (active) {
+                selectionBar = new TeleGiftSelectionBar(getContext(), resourcesProvider, selection, fragment);
+                final FrameLayout.LayoutParams lp = LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT, Gravity.FILL_HORIZONTAL | Gravity.BOTTOM);
+                lp.bottomMargin += AndroidUtilities.navigationBarHeight;
+                addView(selectionBar, indexOfChild(bulletinContainer), lp);
+            } else if (selectionBar != null) {
+                removeView(selectionBar);
+                selectionBar = null;
+            }
+            if (pages != null) {
+                for (View view : pages) {
+                    if (view instanceof Page) ((Page) view).applySelectionMode();
+                }
+            }
+            updateButton();
+        } else if (pages != null) {
+            for (View view : pages) {
+                if (view instanceof Page) ((Page) view).refreshChecks();
+            }
+        }
+    }
