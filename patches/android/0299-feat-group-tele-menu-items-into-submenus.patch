 object TeleMenuLayout {
+    /** The runtime marker of a thin separator. */
     const val RUNTIME_SEPARATOR = Int.MIN_VALUE
+    /** The runtime marker of a submenu title row. */
     const val RUNTIME_SUBMENU = Int.MIN_VALUE + 1
+    /** The runtime marker of a thick separator. */
+    const val RUNTIME_SEPARATOR_THICK = Int.MIN_VALUE + 2
+
+    @JvmStatic
+    fun isRuntimeSeparator(option: Int): Boolean =
+        option == RUNTIME_SEPARATOR || option == RUNTIME_SEPARATOR_THICK
+
+    @JvmStatic
+    fun isRuntimeSeparatorThick(option: Int): Boolean =
+        option == RUNTIME_SEPARATOR_THICK
 
     /** The submenus of the last applied layout: the number of rows after each top-level title row. */
     private val submenuChildCounts = ArrayList<Int>()
 
+    /** The tele tools that are grouped into submenus when no custom layout is stored. */
+    private val DEFAULT_GROUPS: Map<TeleMenuKind, List<Pair<String, List<String>>>> = mapOf(
+        TeleMenuKind.MESSAGE to listOf(
+            "Tools" to listOf("view_as_tl"),
+            "tele" to listOf("bookmark", "rename_bookmark", "edit_history", "shot", "mark_viewed")
+        )
+    )
+
     @JvmStatic
     fun hasRuntimeSubmenu(options: List<Int>): Boolean = options.contains(RUNTIME_SUBMENU)
 
@@ -176,7 +197,7 @@ object TeleMenuLayout {
         } else {
             parse(stored, kind)
         } ?: return emptyList()
-        return normalize(parsed.entries, kind, parsed.hidden)
+        return ensureDefaultGroups(normalize(parsed.entries, kind, parsed.hidden), kind)
     }
 
     /** Adds missing registry items at the root while preserving hidden items in their submenu. */
@@ -203,19 +224,234 @@ object TeleMenuLayout {
         }
         return result
     }
+
+    /** The default submenus of a menu: Tools and tele for the message menu. */
+    fun isDefaultGroup(kind: TeleMenuKind, title: String): Boolean =
+        DEFAULT_GROUPS[kind]?.any { it.first == title } == true
+
+    /**
+     * Keeps the default submenus in the layout. Without this, a layout saved before the
+     * submenus existed would silently flatten them and the editor would never show them.
+     */
+    fun ensureDefaultGroups(entries: List<TeleMenuEntry>, kind: TeleMenuKind): List<TeleMenuEntry> {
+        val groups = DEFAULT_GROUPS[kind] ?: return entries
+        val result = ArrayList(entries)
+        for ((title, keys) in groups) {
+            if (title == "Tools") continue
+            fillGroup(result, kind, title, keys)
+        }
+        val tools = groups.firstOrNull { it.first == "Tools" }
+        if (tools != null) {
+            ensureToolsLast(result, kind, tools.second)
+        }
+        return result
+    }
+
+    private fun fillGroup(entries: MutableList<TeleMenuEntry>, kind: TeleMenuKind, title: String, keys: List<String>) {
+        val existing = entries.indexOfFirst { it is TeleMenuEntry.Submenu && it.title == title }
+        if (existing >= 0) {
+            val submenu = entries[existing] as TeleMenuEntry.Submenu
+            val present = HashSet<String>()
+            collectKeys(submenu.entries, present)
+            for (key in keys) {
+                if (key in present) continue
+                val item = item(kind, key) ?: continue
+                if (removeTopLevelItem(entries, key)) submenu.entries.add(item)
+            }
+            return
+        }
+        val children = ArrayList<TeleMenuEntry>()
+        for (key in keys) {
+            val item = item(kind, key) ?: continue
+            if (removeTopLevelItem(entries, key)) children.add(item)
+        }
+        if (children.isEmpty()) return
+        val at = afterCopyLink(entries)
+        entries.add(at, TeleMenuEntry.Submenu(title, children))
+        if (at > 0 && entries[at - 1] !is TeleMenuEntry.Separator) {
+            entries.add(at, TeleMenuEntry.Separator(TeleMenuEntry.Separator.Style.THIN))
+        }
+        val index = entries.indexOfFirst { it is TeleMenuEntry.Submenu && it.title == title }
+        if (index >= 0 && index + 1 < entries.size && entries[index + 1] !is TeleMenuEntry.Separator) {
+            entries.add(index + 1, TeleMenuEntry.Separator(TeleMenuEntry.Separator.Style.THIN))
+        }
+    }
+
+    private fun ensureToolsLast(entries: MutableList<TeleMenuEntry>, kind: TeleMenuKind, keys: List<String>) {
+        var index = entries.indexOfFirst { it is TeleMenuEntry.Submenu && it.title == "Tools" }
+        if (index >= 0) {
+            val submenu = entries[index] as TeleMenuEntry.Submenu
+            val present = HashSet<String>()
+            collectKeys(submenu.entries, present)
+            for (key in keys) {
+                if (key in present) continue
+                val item = item(kind, key) ?: continue
+                if (removeTopLevelItem(entries, key)) submenu.entries.add(item)
+            }
+            index = entries.indexOfFirst { it is TeleMenuEntry.Submenu && it.title == "Tools" }
+            val separators = ArrayList<TeleMenuEntry>()
+            var scan = index - 1
+            while (scan >= 0 && entries[scan] is TeleMenuEntry.Separator) {
+                separators.add(0, entries.removeAt(scan))
+                scan--
+            }
+            val moved = entries.removeAt(entries.indexOfFirst { it is TeleMenuEntry.Submenu && it.title == "Tools" })
+            if (entries.isNotEmpty()) entries.addAll(separators)
+            entries.add(moved)
+            return
+        }
+        val children = ArrayList<TeleMenuEntry>()
+        for (key in keys) {
+            val item = item(kind, key) ?: continue
+            if (removeTopLevelItem(entries, key)) children.add(item)
+        }
+        if (children.isEmpty()) return
+        if (entries.isNotEmpty() && entries.last() !is TeleMenuEntry.Separator) {
+            entries.add(TeleMenuEntry.Separator(TeleMenuEntry.Separator.Style.THIN))
+        }
+        entries.add(TeleMenuEntry.Submenu("Tools", children))
+    }
+
+    private fun collectKeys(entries: List<TeleMenuEntry>, out: MutableSet<String>) {
+        for (entry in entries) {
+            when (entry) {
+                is TeleMenuEntry.Item -> out.add(entry.key)
+                is TeleMenuEntry.Separator -> Unit
+                is TeleMenuEntry.Submenu -> collectKeys(entry.entries, out)
+            }
+        }
+    }
+
+    private fun removeTopLevelItem(entries: MutableList<TeleMenuEntry>, key: String): Boolean {
+        val index = entries.indexOfFirst { it is TeleMenuEntry.Item && it.key == key }
+        if (index < 0) return false
+        entries.removeAt(index)
+        return true
+    }
+
+    private fun afterCopyLink(entries: List<TeleMenuEntry>): Int {
+        val index = entries.indexOfFirst { it is TeleMenuEntry.Item && it.key == "copy_link" }
+        return if (index < 0) entries.size else index + 1
+    }
