From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Fri, 6 Nov 2026 23:00:35 +0300
Subject: [PATCH] feat: strip the a parameter and link fragments

---
 .../src/main/java/tele/helpers/Tracking.kt      | 17 ++++++++++++++---
 1 file changed, 14 insertions(+), 3 deletions(-)

diff --git a/TMessagesProj/src/main/java/tele/helpers/Tracking.kt b/TMessagesProj/src/main/java/tele/helpers/Tracking.kt
index a3fff6544..f1d16c489 100644
--- a/TMessagesProj/src/main/java/tele/helpers/Tracking.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/Tracking.kt
@@ -38,7 +38,7 @@ object Tracking {
         Provider(regex("(?:^|\\.)spotify\\.com$"), params("context", "nd", "dl_branch")),
         Provider(
             regex("(?:^|\\.)(?:twitter\\.com|x\\.com|fxtwitter\\.com|vxtwitter\\.com|fixupx\\.com|fixvx\\.com|samekosabax\\.com)$"),
-            params("s", "t", "src", "ref_src", "ref_url", "cn")
+            params("s", "t", "src", "ref_src", "ref_url", "cn", "a")
         ),
         Provider(regex("(?:^|\\.)instagram\\.com$"), params("igshid", "igsh")),
         Provider(regex("(?:^|\\.)(?:threads\\.net|threads\\.com)$"), params("xmt", "slof")),
@@ -165,9 +165,12 @@ object Tracking {
         val parsed = split(url) ?: return url
         if (TELEGRAM_HOST.matches(parsed.host)) return url
         val provider = PROVIDERS.firstOrNull { it.host.matches(parsed.host) }
-        if (parsed.query.isEmpty() && (provider == null || provider.paths.isEmpty())) return url
+        val hashBody = parsed.hash.removePrefix("#")
+        val hashParams = hashBody.isNotEmpty() && hashBody.contains('=')
+        if (parsed.query.isEmpty() && !hashParams && (provider == null || provider.paths.isEmpty())) return url
 
         var path = parsed.path
+        var hash = parsed.hash
         var removed = false
         if (provider != null && provider.paths.isNotEmpty()) {
             for (pattern in provider.paths) {
@@ -185,12 +188,20 @@ object Tracking {
             removed = removed || kept.size != query.split('&').count { it.isNotEmpty() }
             query = kept.joinToString("&")
         }
+        if (hashParams) {
+            val parts = hashBody.split('&')
+            val kept = parts.filter { it.isNotEmpty() && !tracked(it.substringBefore('='), provider) }
+            if (kept.size != parts.count { it.isNotEmpty() }) {
+                removed = true
+                hash = if (kept.isEmpty()) "" else "#" + kept.joinToString("&")
+            }
+        }
         if (!removed) return url
 
         return buildString {
             append(parsed.prefix).append(parsed.host).append(path)
             if (query.isNotEmpty()) append('?').append(query)
-            append(parsed.hash)
+            append(hash)
         }
     }
 
