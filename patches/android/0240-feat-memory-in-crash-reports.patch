@@ -1,8 +1,11 @@
 package tele.helpers
 
 import android.app.Activity
+import android.app.ActivityManager
 import android.content.Context
 import android.os.Build
+import android.os.Debug
+import android.os.Process
 import org.telegram.messenger.AndroidUtilities
 import org.telegram.messenger.ApplicationLoader
 import org.telegram.messenger.BuildVars
@@ -56,6 +59,7 @@ object TeleCrash {
             appendLine("Version: ${BuildVars.BUILD_VERSION_STRING} (${versionCode(context)})")
             appendLine("tele: ${TeleBuild.BUILD}")
             appendLine("Device: ${Build.MANUFACTURER} ${Build.MODEL}, android ${Build.VERSION.RELEASE} (sdk ${Build.VERSION.SDK_INT})")
+            appendLine(memory(context))
             appendLine("thread: ${thread.name}")
             appendLine("report:")
             appendLine(sw.toString())
@@ -63,6 +67,19 @@ object TeleCrash {
         crashFile(context).writeText(report)
     }
 
+    // the java side alone tells nothing about a native-heavy crash, so report the pss too
+    private fun memory(context: Context): String = runCatching {
+        val runtime = Runtime.getRuntime()
+        val used = (runtime.totalMemory() - runtime.freeMemory()) / 1048576L
+        val max = runtime.maxMemory() / 1048576L
+        val native = Debug.getNativeHeapAllocatedSize() / 1048576L
+        val manager = context.getSystemService(Context.ACTIVITY_SERVICE) as ActivityManager
+        var pss = 0L
+        val infos = manager.getProcessMemoryInfo(intArrayOf(Process.myPid()))
+        if (infos.isNotEmpty()) pss = infos[0].totalPss / 1024L
+        "memory: java $used/$max MB, native $native MB, pss $pss MB"
+    }.getOrElse { "memory: unknown" }
+
     // the next start after a crash asks before anything leaves the device, like desktop's crash window
     @JvmStatic
     fun offerPending(activity: Activity) {
