@@ -0,0 +1,74 @@
+package tele.helpers
+
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.Emoji
+import org.telegram.tgnet.TLRPC
+import tele.TeleConfig
+
+// emoji typed with the keyboard count in the recent ones when the message goes out (tele 0141)
+object TypedEmoji {
+    private const val MAX_PICKED = 128
+
+    // emoji already counted by a pick, so a sent message doesn't count them twice; UI thread
+    private val picked = HashMap<String, Int>()
+    private var counting = false
+
+    // from Emoji.addRecentEmoji, UI thread
+    @JvmStatic
+    fun remember(code: String?) {
+        if (code == null || counting || !TeleConfig.RECENT_TYPED_EMOJI.value) return
+        if (picked.size >= MAX_PICKED) picked.clear()
+        picked[code] = (picked[code] ?: 0) + 1
+    }
+
+    // any thread: the text is read here, the recent list changes on the UI thread
+    @JvmStatic
+    fun count(text: String?, entities: List<TLRPC.MessageEntity>?) {
+        if (!TeleConfig.RECENT_TYPED_EMOJI.value || text.isNullOrEmpty()) return
+        val codes = collect(text, entities?.toList())
+        if (codes.isEmpty()) return
+        AndroidUtilities.runOnUIThread { apply(codes) }
+    }
+
+    private fun collect(text: String, entities: List<TLRPC.MessageEntity>?): List<String> {
+        val custom = ArrayList<IntArray>()
+        val codes = ArrayList<String>()
+        entities?.forEach {
+            if (it is TLRPC.TL_messageEntityCustomEmoji && it.document_id != 0L) {
+                custom.add(intArrayOf(it.offset, it.offset + it.length))
+                codes.add("animated_" + it.document_id)
+            }
+        }
+        // the plain emoji under a custom one is only its placeholder
+        Emoji.parseEmojis(text).forEach { range ->
+            if (custom.none { range.start < it[1] && range.end > it[0] } && Emoji.isValidEmoji(range.code)) {
+                codes.add(range.code.toString())
+            }
+        }
+        return codes
+    }
+
+    private fun apply(codes: List<String>) {
+        Emoji.loadRecentEmoji()
+        // the list is sorted when the panel opens; addRecentEmoji needs it filled once the history is full
+        if (Emoji.recentEmoji.isEmpty()) Emoji.sortEmoji()
+        var added = false
+        counting = true
+        try {
+            for (code in codes) {
+                val left = picked[code] ?: 0
+                if (left > 1) {
+                    picked[code] = left - 1
+                } else if (left == 1) {
+                    picked.remove(code)
+                } else {
+                    Emoji.addRecentEmoji(code)
+                    added = true
+                }
+            }
+        } finally {
+            counting = false
+        }
+        if (added) Emoji.saveRecentEmoji()
+    }
+}
