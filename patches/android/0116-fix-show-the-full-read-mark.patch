From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Wed, 21 Oct 2026 11:29:54 +0300
Subject: [PATCH] fix: show the full read mark

---
 .../java/tele/ui/settings/TeleGhostPreview.kt | 27 ++++++++++++++-----
 1 file changed, 21 insertions(+), 6 deletions(-)

diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleGhostPreview.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleGhostPreview.kt
index af0c3c4c3..844e0e0d9 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TeleGhostPreview.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleGhostPreview.kt
@@ -233,13 +233,28 @@ object TeleGhostPreview {
             )
             bubble.addView(title, LinearLayout.LayoutParams(LayoutHelper.WRAP_CONTENT, LayoutHelper.WRAP_CONTENT))
             if (data.out && data.check > 0) {
-                // the read mark is the same icon as in the chat list, the sent one is the chat bubble check
-                val check = ImageView(context)
-                check.setImageResource(if (data.check == 2) R.drawable.list_check else R.drawable.msg_check_s)
-                check.scaleType = android.widget.ImageView.ScaleType.FIT_CENTER
-                val checkParams = LinearLayout.LayoutParams(dp(14f), dp(12f))
+                // the same marks as in the chat list: one check for a sent message, two for a read one
+                val checks = LinearLayout(context)
+                checks.orientation = LinearLayout.HORIZONTAL
+                checks.gravity = Gravity.CENTER_VERTICAL
+                val first = ImageView(context)
+                first.setImageResource(R.drawable.list_check)
+                first.scaleType = android.widget.ImageView.ScaleType.FIT_CENTER
+                checks.addView(first, LinearLayout.LayoutParams(dp(14f), dp(12f)))
+                if (data.check == 2) {
+                    // the second check is drawn over the first one, like in the chat list
+                    val second = ImageView(context)
+                    // the stock tints this drawable for the chat list, here it stays white
+                    second.setImageDrawable(context.getDrawable(R.drawable.list_halfcheck)?.mutate())
+                    second.setColorFilter(Color.WHITE)
+                    second.scaleType = android.widget.ImageView.ScaleType.FIT_CENTER
+                    val secondParams = LinearLayout.LayoutParams(dp(14f), dp(12f))
+                    secondParams.leftMargin = -dp(8.5f)
+                    checks.addView(second, secondParams)
+                }
+                val checkParams = LinearLayout.LayoutParams(LayoutHelper.WRAP_CONTENT, dp(12f))
                 checkParams.leftMargin = dp(6f)
-                bubble.addView(check, checkParams)
+                bubble.addView(checks, checkParams)
             }
             content.addView(bubble, LinearLayout.LayoutParams(LayoutHelper.WRAP_CONTENT, LayoutHelper.WRAP_CONTENT))
         } else {
