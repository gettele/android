From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Fri, 23 Oct 2026 10:32:03 +0300
Subject: [PATCH] fix: split expandable group switch hit area

---
 .../org/telegram/ui/Cells/TextCheckCell2.java | 21 ++++++++++++++++++-
 .../tele/ui/settings/TeleSettingsActivity.kt  |  8 +++----
 2 files changed, 24 insertions(+), 5 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Cells/TextCheckCell2.java b/TMessagesProj/src/main/java/org/telegram/ui/Cells/TextCheckCell2.java
index 622641334..4576e19d5 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Cells/TextCheckCell2.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Cells/TextCheckCell2.java
@@ -18,6 +18,7 @@ import android.graphics.drawable.Drawable;
 import android.text.TextUtils;
 import android.util.TypedValue;
 import android.view.Gravity;
+import android.view.MotionEvent;
 import android.view.View;
 import android.view.accessibility.AccessibilityNodeInfo;
 import android.widget.FrameLayout;
@@ -47,6 +48,8 @@ public class TextCheckCell2 extends FrameLayout {
     private View collapsedArrow;
     private View checkBoxClickArea;
     private int collapseReservedRight;
+    private Runnable collapseSwitchClick;
+
     private boolean collapseAlignToTitle;
 
 
@@ -84,8 +87,24 @@ public class TextCheckCell2 extends FrameLayout {
         animatedTextView.setText(text);
         collapsedArrow.animate().cancel();
         collapsedArrow.animate().rotation(collapsed ? 0 : 180).setDuration(340).setInterpolator(CubicBezierInterpolator.EASE_OUT_QUINT).start();
-        checkBoxClickArea.setOnClickListener(v -> onCheckClick.run());
+        checkBoxClickArea.setOnTouchListener((v, event) -> {
+            if (event.getActionMasked() == MotionEvent.ACTION_UP) {
+                float switchLeft = checkBox.getLeft() - checkBoxClickArea.getLeft();
+                float switchRight = checkBox.getRight() - checkBoxClickArea.getLeft();
+                if (collapseSwitchClick != null && event.getX() >= switchLeft && event.getX() <= switchRight) {
+                    collapseSwitchClick.run();
+                } else {
+                    onCheckClick.run();
+                }
+                v.performClick();
+            }
+            return true;
+        });
     }
+    public void setCollapseSwitchClick(Runnable onSwitchClick) {
+        collapseSwitchClick = onSwitchClick;
+    }
+
 
     /** Reserves a fixed column for the counter and arrow before the switch. */
     public void setCollapseLayout(int reservedRight, boolean alignToTitle) {
diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
index 3ced6e10b..956ed8db2 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
@@ -327,10 +327,10 @@ class TeleSettingsActivity @JvmOverloads constructor(private val mode: String =
                             UItem.asExpandableSwitch(position, displayTitle(title), "${row.childCount} on").apply {
                                  checked = row.item!!.value as Boolean
                                  collapsed = !expandedGroups.contains(row.item.key)
-                                clickCallback = View.OnClickListener { setGroupValue(row, !(row.item!!.value as Boolean)) }
-                                bind = Utilities.Callback { view: View ->
-                                    val cell = view as TextCheckCell2
-                                    cell.getCheckBox().setOnClickListener { setGroupValue(row, !(row.item!!.value as Boolean)) }
+                                clickCallback = View.OnClickListener { toggleExpanded(row) }
+                                 bind = Utilities.Callback { view: View ->
+                                     val cell = view as TextCheckCell2
+                                    cell.setCollapseSwitchClick { setGroupValue(row, !(row.item!!.value as Boolean)) }
                                     if (!row.subtitle.isNullOrEmpty()) {
                                          cell.setTextAndValue(displayTitle(title), row.subtitle, true, true)
                                      }
