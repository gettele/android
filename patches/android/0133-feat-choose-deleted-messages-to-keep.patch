@@ -124,6 +124,12 @@ object TeleConfig {
     @JvmField
     val KEEP_SELF_DELETED_MESSAGES = BoolItem("keep_self_deleted_messages", false)
     @JvmField
+    val KEEP_DELETED_BOTS = BoolItem("keep_deleted_bots", true)
+    @JvmField
+    val KEEP_DELETED_SAVED = BoolItem("keep_deleted_saved", true)
+    @JvmField
+    val KEEP_DELETED_OWN = BoolItem("keep_deleted_own", true)
+    @JvmField
     val SELECT_SERVICE_MESSAGES = BoolItem("select_service_messages", true)
     @JvmField
     val DELETED_MARKER = StringItem("deleted_marker", "fade")
diff --git a/TMessagesProj/src/main/java/tele/helpers/DeletedMessages.kt b/TMessagesProj/src/main/java/tele/helpers/DeletedMessages.kt
index 867cf3886..a4e401233 100644
--- a/TMessagesProj/src/main/java/tele/helpers/DeletedMessages.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/DeletedMessages.kt
@@ -17,8 +17,19 @@ import java.util.concurrent.ConcurrentHashMap
 
 object DeletedMessages {
     @JvmStatic
-    fun shouldArchive(account: Int, outgoing: Boolean, userInitiated: Boolean = false, dialogId: Long = 0L): Boolean =
-        !org.telegram.messenger.DialogObject.isEncryptedDialog(dialogId) && (TeleConfig.KEEP_DELETED_MESSAGES.value || outgoing && userInitiated && TeleConfig.KEEP_SELF_DELETED_MESSAGES.value)
+    fun shouldArchive(account: Int, outgoing: Boolean, userInitiated: Boolean = false, dialogId: Long = 0L): Boolean {
+        if (org.telegram.messenger.DialogObject.isEncryptedDialog(dialogId)) return false
+        val own = outgoing && userInitiated && TeleConfig.KEEP_SELF_DELETED_MESSAGES.value
+        if (!own && !(TeleConfig.KEEP_DELETED_MESSAGES.value && (!userInitiated || TeleConfig.KEEP_DELETED_OWN.value))) return false
+        return wantedIn(account, dialogId)
+    }
+
+    // the where-filters: Saved Messages and bot chats can be left out
+    private fun wantedIn(account: Int, dialogId: Long): Boolean {
+        if (dialogId == UserConfig.getInstance(account).clientUserId) return TeleConfig.KEEP_DELETED_SAVED.value
+        if (dialogId <= 0 || TeleConfig.KEEP_DELETED_BOTS.value) return true
+        return org.telegram.messenger.MessagesController.getInstance(account).getUser(dialogId)?.bot != true
+    }
 
     @JvmStatic
     fun keepInChat(account: Int, message: TLRPC.Message, userInitiated: Boolean): Boolean {
