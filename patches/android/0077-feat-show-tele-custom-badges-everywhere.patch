diff --git a/TMessagesProj/src/main/java/tele/helpers/TeleBadges.kt b/TMessagesProj/src/main/java/tele/helpers/TeleBadges.kt
index 8ccdc7b0d..72cc4fdf8 100644
--- a/TMessagesProj/src/main/java/tele/helpers/TeleBadges.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/TeleBadges.kt
@@ -28,6 +28,8 @@ object TeleBadges {
 
     private val dataRef = AtomicReference<ServerData?>(null)
     private val markedUsers = java.util.concurrent.ConcurrentHashMap.newKeySet<Long>()
+    // icon document id requires an argon2 hash; cache per peer so list binds don't recompute it on the UI thread
+    private val iconCache = ConcurrentHashMap<Long, Long>()
 
     @JvmStatic
     fun current(): ServerData? = dataRef.get()
@@ -121,6 +123,7 @@ object TeleBadges {
     fun loadFromJson(text: String): Boolean {
         val d = parse(text) ?: return false
         dataRef.set(d)
+        iconCache.clear()
         return true
     }
 
@@ -174,7 +177,7 @@ object TeleBadges {
                 }
             }
             markedUsers.clear()
-            val mask = org.telegram.messenger.MessagesController.UPDATE_MASK_CHAT
+            val mask = org.telegram.messenger.MessagesController.UPDATE_MASK_CHAT or org.telegram.messenger.MessagesController.UPDATE_MASK_NAME
             android.os.Handler(android.os.Looper.getMainLooper()).post {
                 org.telegram.messenger.NotificationCenter.getInstance(account).postNotificationName(org.telegram.messenger.NotificationCenter.updateInterfaces, mask)
             }
@@ -210,7 +213,7 @@ object TeleBadges {
                     if (p.checkmark || p.scam || p.fake) markedUsers.add(pid)
