+    private fun allSearchHits(): List<SearchHit> {
+        val hits = ArrayList<SearchHit>()
+        val seen = HashSet<String>()
+        for (section in SECTION_SPECS + listOf(Section(MODE_MENU, "Message menu", R.drawable.msg2_permissions), Section(MODE_ROOT, "tele", R.drawable.tele_settings_icon))) {
+            for (row in buildRows(section.mode, true)) {
+                if (row.type != TYPE_TOGGLE && row.type != TYPE_VALUE && row.type != TYPE_LINK && row.type != TYPE_LINK_ICON) continue
+                val title = row.title ?: continue
+                val identity = idOf(row) ?: "${section.mode}:$title"
+                if (!seen.add(identity)) continue
+                val text = listOf(title, lc(displayTitle(title)), row.subtitle.orEmpty(), row.subtitle?.let { lc(it) }.orEmpty(), section.title, lc(section.title)).joinToString(" ").lowercase(java.util.Locale.ROOT)
+                hits.add(SearchHit(section.mode, section.title, row, identity, text))
+            }
+        }
+        return hits
+    }
+
+    private fun searchPreferences(): SharedPreferences =
+        ApplicationLoader.applicationContext.getSharedPreferences("tele_settings_search", Context.MODE_PRIVATE)
+
+    private fun recentSearchIds(): List<String> =
+        searchPreferences().getString(KEY_RECENT_SEARCHES, "").orEmpty()
+            .split(RECENT_SEARCH_SEPARATOR)
+            .filter { it.isNotEmpty() }
+
+    private fun recentSearchHits(): List<SearchHit> {
+        val byIdentity = allSearchHits().associateBy { it.identity }
+        val seen = HashSet<String>()
+        val hits = ArrayList<SearchHit>()
+        for (identity in recentSearchIds()) {
+            val hit = byIdentity[identity] ?: continue
+            if (seen.add(identity)) hits.add(hit)
+        }
+        return hits
+    }
+
+    private fun saveRecentSearch(identity: String) {
+        val ids = ArrayList(recentSearchIds())
+        ids.remove(identity)
+        ids.add(0, identity)
+        while (ids.size > MAX_RECENT_SEARCHES) ids.removeAt(ids.size - 1)
+        searchPreferences().edit().putString(KEY_RECENT_SEARCHES, ids.joinToString(RECENT_SEARCH_SEPARATOR)).apply()
+    }
+
+    private fun clearRecentSearches() {
+        searchPreferences().edit().remove(KEY_RECENT_SEARCHES).apply()
+        refresh()
+    }
+
+    private fun showClearSearchHistoryDialog() {
+        val activity = parentActivity ?: return
+        val builder = if (resourceProvider != null) AlertDialog.Builder(activity, resourceProvider) else AlertDialog.Builder(activity)
+        builder.setTitle(LocaleController.getString(R.string.ClearSearchAlertTitle))
+        builder.setMessage(LocaleController.getString(R.string.ClearSearchAlert))
+        builder.setPositiveButton(LocaleController.getString(R.string.ClearButton)) { _, _ -> clearRecentSearches() }
+        builder.setNegativeButton(LocaleController.getString(R.string.Cancel), null)
+        val dialog = builder.create()
+        showDialog(dialog)
+        val button = dialog.getButton(DialogInterface.BUTTON_POSITIVE) as? android.widget.TextView
+        if (button != null) ThemeBind.textColor(button, Theme.key_text_RedBold)
+    }
+
     private fun onItemClick(item: UItem, view: View, position: Int, x: Float, y: Float) {
-        if (!searchQuery.isNullOrEmpty()) {
+        if (!searchQuery.isNullOrEmpty() || (searchActive && searchHits.isNotEmpty())) {
             val hit = searchHits.getOrNull(item.id) ?: return
+            saveRecentSearch(hit.identity)
             presentFragment(TeleSettingsActivity(hit.mode, hit.row.title, idOf(hit.row)))
             return
         }
