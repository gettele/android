 .../ui/Components/EditTextCaption.java        | 13 +++++++++++--
 .../main/java/tele/helpers/LinkRewrites.kt    | 19 +++++++++++--------
 .../tele/ui/settings/TeleRulesActivity.kt     | 10 +++++++---
 4 files changed, 38 insertions(+), 13 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Components/ChatActivityEnterView.java b/TMessagesProj/src/main/java/org/telegram/ui/Components/ChatActivityEnterView.java
index ee6ea07ca..b94b2c5ac 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Components/ChatActivityEnterView.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Components/ChatActivityEnterView.java
@@ -5746,6 +5746,15 @@ public class ChatActivityEnterView extends FrameLayout implements
                 pastedServerLink = true;
             }
 
+            @Override
+            protected void teleNotifyRewrittenLinks(java.util.ArrayList<String> notes) {
+                if (parentFragment == null) {
+                    super.teleNotifyRewrittenLinks(notes);
+                    return;
+                }
+                BulletinFactory.of(parentFragment).createSimpleBulletin(R.raw.info, TextUtils.join("\n", notes)).show();
+            }
+
             @Override
             protected boolean performTeleMenuAction(int itemId) {
                 if (itemId == R.id.tele_add_link_preview) {
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Components/EditTextCaption.java b/TMessagesProj/src/main/java/org/telegram/ui/Components/EditTextCaption.java
index 7a9dc98cf..7f6a33aed 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Components/EditTextCaption.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Components/EditTextCaption.java
@@ -980,7 +980,7 @@ public class EditTextCaption extends EditTextBoldCursor implements FloatingToolb
                     teleNotifyPasted(text);
                     android.util.Pair<String, java.util.ArrayList<String>> rewritten = tele.helpers.LinkRewrites.applyToText(text.toString());
                     if (rewritten != null) {
-                        Toast.makeText(getContext(), "tele rewrote links:\n" + TextUtils.join("\n", rewritten.second), Toast.LENGTH_SHORT).show();
+                        showRewriteBulletin(rewritten.second);
                         return super.commitText(rewritten.first, newCursorPosition);
                     }
                 }
@@ -1018,9 +1018,18 @@ public class EditTextCaption extends EditTextBoldCursor implements FloatingToolb
         int end = Math.min(getText().length(), getSelectionEnd());
         setText(getText().replace(start, end, rewritten.first));
         setSelection(start + rewritten.first.length(), start + rewritten.first.length());
-        Toast.makeText(getContext(), "tele rewrote links:\n" + TextUtils.join("\n", rewritten.second), Toast.LENGTH_SHORT).show();
+        showRewriteBulletin(rewritten.second);
         return true;
     }
+
+    private void showRewriteBulletin(java.util.ArrayList<String> notes) {
+        teleNotifyRewrittenLinks(notes);
+    }
+
+    /** Shows what the link rewrite changed: the domain before and after. */
+    protected void teleNotifyRewrittenLinks(java.util.ArrayList<String> notes) {
+        BulletinFactory.global().createSimpleBulletin(R.raw.info, TextUtils.join("\n", notes)).show();
+    }
     public boolean onTextContextMenuItem(int id) {
         if (id == android.R.id.paste && teleRewritePaste()) {
             return true;
diff --git a/TMessagesProj/src/main/java/tele/helpers/LinkRewrites.kt b/TMessagesProj/src/main/java/tele/helpers/LinkRewrites.kt
index dd57cd8bc..0bcd9cf20 100644
--- a/TMessagesProj/src/main/java/tele/helpers/LinkRewrites.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/LinkRewrites.kt
@@ -161,9 +161,9 @@ object LinkRewrites {
             if (memo.containsKey(url)) return@replace memo[url]!!
             val rewritten = applyRules(url, rules)
             if (rewritten != null) {
-                memo[url] = rewritten
-                if (notes.size < 3) notes.add(url + " → " + rewritten)
-                rewritten
+                memo[url] = rewritten.first
+                if (notes.size < 3) notes.add(rewritten.second)
+                rewritten.first
             } else {
                 url
             }
@@ -172,7 +172,7 @@ object LinkRewrites {
         return android.util.Pair(result, notes)
     }
 
-    private fun applyRules(url: String, rules: List<Rule>): String? {
+    private fun applyRules(url: String, rules: List<Rule>): Pair<String, String>? {
         for (rule in rules) {
             if (!rule.enabled) continue
             if (rule.type == TYPE_DOMAIN) {
@@ -184,7 +184,8 @@ object LinkRewrites {
                 val rewritten = runCatching {
                     val regex = Regex(rule.find, RegexOption.IGNORE_CASE)
                     val match = regex.find(url) ?: return@runCatching null
-                    url.replaceRange(match.range, expand(rule.replace, match))
+                    val replacement = expand(rule.replace, match)
+                    url.replaceRange(match.range, replacement) to (match.value + " -> " + replacement)
                 }.getOrNull()
                 if (rewritten != null) {
                     android.util.Log.d("TeleLinkRewrite", "rule=${rule.type}")
@@ -202,7 +203,7 @@ object LinkRewrites {
         return match.groups[1]!!.range.first to host
     }
 
-    private fun applyDomains(url: String, rule: Rule): String? {
+    private fun applyDomains(url: String, rule: Rule): Pair<String, String>? {
         if (rule.to.isEmpty()) return null
         val (hostStart, host) = hostOf(url) ?: return null
         for (domain in rule.from) {
@@ -214,12 +215,14 @@ object LinkRewrites {
             }
             if (prefix == "www." || prefix == "m." || prefix == "mobile.") prefix = ""
             val target = if (rule.random && rule.to.size > 1) {
-                rule.to[(url.hashCode() % rule.to.size + rule.to.size) % rule.to.size]
+                // a fresh pick on every rewrite, not a hash of the link
+                rule.to.random()
             } else {
                 rule.to.first()
             }
             val hostEnd = hostStart + host.length
-            return url.substring(0, hostStart) + prefix + target + url.substring(hostEnd)
+            val rewritten = url.substring(0, hostStart) + prefix + target + url.substring(hostEnd)
+            return rewritten to (d + " -> " + target)
         }
         return null
     }
