From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Tue, 3 Nov 2026 18:40:20 +0300
Subject: [PATCH] feat: open transfer transaction links

---
 .../java/org/telegram/ui/ChatActivity.java    | 37 +++++++++++++++++++
 .../src/main/java/tele/helpers/MessageMenu.kt |  2 +
 2 files changed, 39 insertions(+)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
index 35f6bd727..241bbcf26 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
@@ -1295,6 +1295,8 @@ public class ChatActivity extends BaseFragment implements
     public final static int tele_option_restrict = 430;
     public final static int tele_option_copy_service_text = 219;
     public final static int tele_option_copy_file_path = 220;
+    public final static int tele_option_copy_tx_link = 223;
+    public final static int tele_option_open_tx_link = 224;
     public final static int tele_option_copy_alias = 221;
     public final static int tele_option_delete_alias = 222;
     public final static int tele_option_bookmark = 240;
@@ -35336,6 +35338,21 @@ public class ChatActivity extends BaseFragment implements
                 tele.helpers.SendOrder.releaseNow(currentAccount, dialog_id, selectedObject.getId());
                 break;
             }
+            case tele_option_copy_tx_link: {
+                final String tele_tx_url = teleTransactionUrlOf(selectedObject);
+                if (tele_tx_url != null) {
+                    AndroidUtilities.addToClipboard(tele_tx_url);
+                    BulletinFactory.of(this).createSimpleBulletin(R.raw.copy, getString(R.string.TeleWalletTxLinkCopied)).show(false);
+                }
+                break;
+            }
+            case tele_option_open_tx_link: {
+                final String tele_tx_url = teleTransactionUrlOf(selectedObject);
+                if (tele_tx_url != null) {
+                    Browser.openUrlInSystemBrowser(getContext(), tele_tx_url);
+                }
+                break;
+            }
             case tele_option_read: {
                 // the ghost read option keeps the read receipts away, so the message is only marked read locally
                 getMessagesController().markDialogAsRead(dialog_id, selectedObject.getId(), 0, 0, false, getTopicId(), 0, false, 0);
@@ -47734,6 +47751,13 @@ public class ChatActivity extends BaseFragment implements
         return file.getAbsolutePath();
     }
 
+    /** The tonscan link of the wallet transfer of a message, null when the history has no such transaction. */
+    private String teleTransactionUrlOf(MessageObject message) {
+        if (message == null || message.messageOwner == null) return null;
+        final TL_wallet.walletTransaction tele_tx = GramWallet.getInstance(currentAccount).findTransaction(message);
+        return tele_tx == null ? null : tele.helpers.WalletLinks.transactionUrl(tele_tx.tx_hash);
+    }
+
     public void fillMessageMenu(
         MessageObject primaryMessage,
 
@@ -47787,6 +47811,19 @@ public class ChatActivity extends BaseFragment implements
             options.add(0, tele_option_copy_service_text);
             icons.add(0, R.drawable.msg_copy);
         }
+        if (tele.TeleConfig.WALLET_TRANSACTION_LINKS.getValue() && message.getId() > 0
+                && message.messageOwner != null && message.messageOwner.action instanceof TLRPC.TL_messageActionGramTransfer
+                && getMessagesController().config.walletAvailable()) {
+            final String tele_tx_url = teleTransactionUrlOf(message);
+            if (tele_tx_url != null) {
+                items.add(0, "Open in explorer");
+                options.add(0, tele_option_open_tx_link);
+                icons.add(0, R.drawable.msg_search);
+                items.add(0, "Copy transaction link");
+                options.add(0, tele_option_copy_tx_link);
+                icons.add(0, R.drawable.msg_copy);
+            }
+        }
 
 
         boolean allowChatActions = true;
diff --git a/TMessagesProj/src/main/java/tele/helpers/MessageMenu.kt b/TMessagesProj/src/main/java/tele/helpers/MessageMenu.kt
index d904fff15..0f4721848 100644
--- a/TMessagesProj/src/main/java/tele/helpers/MessageMenu.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/MessageMenu.kt
@@ -65,6 +65,8 @@ object MessageMenu {
         Item(ChatActivity.tele_option_copy_service_text, "Copy service text", "copy_service_text", TeleConfig.COPY_SERVICE_TEXT),
         Item(ChatActivity.tele_option_audio_voice, "Send as voice message", "audio_voice", TeleConfig.AUDIO_AS_VOICE),
         Item(ChatActivity.tele_option_copy_file_path, "Copy file path", "copy_file_path", TeleConfig.COPY_FILE_PATH),
+        Item(ChatActivity.tele_option_copy_tx_link, "Copy transaction link", "copy_tx_link", TeleConfig.WALLET_TRANSACTION_LINKS),
+        Item(ChatActivity.tele_option_open_tx_link, "Open in explorer", "open_tx_link", TeleConfig.WALLET_TRANSACTION_LINKS),
         Item(ChatActivity.tele_option_copy_alias, "Copy alias", "copy_alias", TeleConfig.USERNAME_ALIASES),
         Item(ChatActivity.tele_option_delete_alias, "Delete alias", "delete_alias", TeleConfig.USERNAME_ALIASES),
         Item(ChatActivity.tele_option_bookmark, "Bookmark", "bookmark", TeleConfig.BOOKMARKS),
