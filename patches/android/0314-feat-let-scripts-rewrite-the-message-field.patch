--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/scripting/ScriptCompose.kt
@@ -0,0 +1,80 @@
+package tele.scripting
+
+import org.json.JSONArray
+import org.json.JSONObject
+import java.lang.ref.WeakReference
+import java.util.concurrent.CopyOnWriteArrayList
+
+/** The input hooks of the scripts: they see the field as it is typed and may rewrite it. */
+object ScriptCompose {
+
+    private val runtimes = CopyOnWriteArrayList<ScriptRuntime>()
+    private var field: WeakReference<org.telegram.ui.Components.ChatActivityEnterView>? = null
+    private var dialogId = 0L
+
+    @Volatile
+    private var applying = false
+
+    @JvmStatic
+    fun register(runtime: ScriptRuntime) {
+        if (!runtimes.contains(runtime)) runtimes.add(runtime)
+    }
+
+    @JvmStatic
+    fun unregister(runtime: ScriptRuntime) {
+        runtimes.remove(runtime)
+    }
+
+    @JvmStatic
+    fun isApplying(): Boolean = applying
+
+    @JvmStatic
+    fun text(): String? {
+        val view = field?.get() ?: return null
+        return view.messageEditText?.text?.toString() ?: ""
+    }
+
+    @JvmStatic
+    fun chatId(): Long {
+        val view = field?.get() ?: return 0
+        return view.tele_getDialogId()
+    }
+
+    /** Told on every keystroke: the scripts decide whether to rewrite the field. */
+    @JvmStatic
+    fun inputChanged(view: org.telegram.ui.Components.ChatActivityEnterView, id: Long, text: String) {
+        field = WeakReference(view)
+        dialogId = id
+        if (applying || runtimes.isEmpty()) return
+        val context = JSONObject().put("chatId", id).put("text", text)
+        for (runtime in runtimes) {
+            if (runtime.hasComposeHandlers()) {
+                runtime.dispatchCompose(context)
+            }
+        }
+    }
+
+    /** The script set the field: applied on the ui thread and not fed back to the scripts. */
+    @JvmStatic
+    fun setText(peer: Long, text: String) {
+        org.telegram.messenger.AndroidUtilities.runOnUIThread {
+            val view = field?.get() ?: return@runOnUIThread
+            if (peer != 0L && peer != view.tele_getDialogId()) return@runOnUIThread
+            applying = true
+            view.tele_setComposeText(text)
+            org.telegram.messenger.AndroidUtilities.runOnUIThread({ applying = false }, 80)
+        }
+    }
+
+    @JvmStatic
+    fun insert(text: String): Boolean {
+        val view = field?.get() ?: return false
+        org.telegram.messenger.AndroidUtilities.runOnUIThread {
+            val current = view.messageEditText?.text?.toString().orEmpty()
+            applying = true
+            view.tele_setComposeText(current + text)
+            org.telegram.messenger.AndroidUtilities.runOnUIThread({ applying = false }, 80)
+        }
+        return true
+    }
+}
