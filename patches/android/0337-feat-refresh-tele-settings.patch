new file mode 100644
index 000000000..1a7ee3550
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/ui/TeleBaseFragment.kt
@@ -0,0 +1,147 @@
+package tele.ui
+
+import android.graphics.Canvas
+import android.view.View
+import android.widget.FrameLayout
+import android.widget.ScrollView
+import org.telegram.ui.ActionBar.ActionBar
+import org.telegram.ui.ActionBar.BaseFragment
+import org.telegram.ui.Components.RecyclerListView
+import org.telegram.ui.Components.SizeNotifierFrameLayout
+import org.telegram.ui.Components.blur3.utils.Blur3Utils
+import org.telegram.utils.glass.BaseFragmentSimpleGlass
+
+/**
+ * A tele screen with the stock glass header: the action bar goes above the content and the capture
+ * under its glass is the screen's own list or scroll view, not a flat colour.
+ */
+open class TeleBaseFragment : BaseFragment() {
+
+    override fun isSupportEdgeToEdge(): Boolean = true
+
+    private var glassRoot: FrameLayout? = null
+    private var glassListView: RecyclerListView? = null
+    private var glassScrollView: ScrollView? = null
+    private var listExtraTop = 0
+    private var listExtraBottom = 0
+    private var listHorizontalPadding = 0
+    private var scrollExtraTop = 0
+    private var scrollExtraBottom = 0
+    private var scrollHorizontalPadding = 0
+    private val wallpaperBounds = android.graphics.Rect()
+
+    /**
+     * Puts [content] under the glass header of [root]. A list gets the stock overscan and edge
+     * padding; a scroll view gets its content below the header while scrolling under it.
+     */
+    protected fun installGlass(
+        root: FrameLayout,
+        content: View,
+        wallpaper: SizeNotifierFrameLayout? = null,
+        extraTop: Int = 0,
+        extraBottom: Int = 0,
+        horizontalPadding: Int = 0
+    ) {
+        val glass = getBaseSimpleGlass()
+        glassRoot = root
+        if (content is RecyclerListView) {
+            glassListView = content
+            glassScrollView = null
+            listExtraTop = extraTop
+            listExtraBottom = extraBottom
+            listHorizontalPadding = horizontalPadding
+            glass.setViews(root, content, actionBar, resourceProvider)
+            applyListInsets(content)
+        } else {
+            glassListView = null
+            glassScrollView = content as? ScrollView
+            scrollExtraTop = extraTop
+            scrollExtraBottom = extraBottom
+            scrollHorizontalPadding = horizontalPadding
+            glass.setViews(root, actionBar, resourceProvider)
+            glass.setClipView(content)
+            if (content is ScrollView) {
+                content.clipToPadding = false
+                applyScrollInsets(content)
+                var lastScrollY = content.scrollY
+                content.setOnScrollChangeListener { _, _, _, _, _ ->
+                    val y = content.scrollY
+                    glassEngine.onScrolled(0, y - lastScrollY)
+                    lastScrollY = y
+                }
+            }
+        }
+        glass.setCapture { canvas, position ->
+            wallpaper?.let { drawWallpaper(it, canvas) }
+            Blur3Utils.captureRelativeParent({ target, _ -> content.draw(target) }, canvas, position, content, root)
+        }
+    }
+
+    /** The wallpaper of a chat screen is under the glass too: the capture is only the list. */
+    private fun drawWallpaper(wallpaper: SizeNotifierFrameLayout, canvas: Canvas) {
+        val drawable = wallpaper.backgroundImage ?: return
+        val save = canvas.save()
+        wallpaperBounds.set(drawable.bounds)
+        try {
+            drawable.setBounds(0, 0, wallpaper.width, wallpaper.height)
+            drawable.draw(canvas)
+        } finally {
+            drawable.bounds = wallpaperBounds
+        }
+        canvas.restoreToCount(save)
+    }
+
+    protected fun refreshGlass() {
+        glassEngine.invalidate()
+    }
+
+    /** The pin bands of a screen change the list's start, e.g. a search band under the header. */
+    protected fun setGlassListPadding(extraTop: Int, extraBottom: Int) {
+        listExtraTop = extraTop
+        listExtraBottom = extraBottom
+        glassListView?.let { applyListInsets(it) }
+    }
+
+    /** The y where the content of the screen starts under the header. */
+    protected fun glassContentTop(): Int = mSystemInsets.top + ActionBar.getCurrentActionBarHeight()
+
+    override fun onInsets(left: Int, top: Int, right: Int, bottom: Int) {
+        glassListView?.let { applyListInsets(it) }
+        glassScrollView?.let { applyScrollInsets(it) }
+        onGlassInsets(left, top, right, bottom)
+    }
+
+    /** For the screens with their own pinned bands next to the glass content. */
+    protected open fun onGlassInsets(left: Int, top: Int, right: Int, bottom: Int) {}
+
+    private fun applyListInsets(list: RecyclerListView) {
+        if (list.parent !== glassRoot) {
+            list.setPadding(
+                listHorizontalPadding,
+                mSystemInsets.top + ActionBar.getCurrentActionBarHeight() + listExtraTop,
+                listHorizontalPadding,
+                mSystemInsets.bottom + listExtraBottom
+            )
+            return
+        }
+        BaseFragmentSimpleGlass.setListViewParams(
+            list,
+            mSystemInsets.top,
+            mSystemInsets.bottom,
+            ActionBar.getCurrentActionBarHeight() + listExtraTop,
+            listExtraBottom
+        )
+        if (listHorizontalPadding != 0) {
+            list.setPadding(listHorizontalPadding, list.paddingTop, listHorizontalPadding, list.paddingBottom)
+        }
+    }
+
+    private fun applyScrollInsets(scroll: ScrollView) {
+        scroll.setPadding(
+            scrollHorizontalPadding,
+            mSystemInsets.top + ActionBar.getCurrentActionBarHeight() + scrollExtraTop,
+            scrollHorizontalPadding,
+            mSystemInsets.bottom + scrollExtraBottom
+        )
+    }
+}
