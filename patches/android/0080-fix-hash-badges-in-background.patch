From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Mon, 19 Oct 2026 01:00:01 +0300
Subject: [PATCH] fix: hash badges in background

putUser hooks and list binds computed an 8 MiB argon2 hash per peer on the UI thread; a fresh account load blocked it for ~40 s and froze the emulator (ANR). Lookups are now cached per feed; UI-thread callers read the cache and resolve misses on a background queue, then mark the current object and refresh the UI. Replaces the icon cache, whose 32-bit key collided for ids above 2^32 and for channels.
---
 .../src/main/java/tele/helpers/TeleBadges.kt  | 72 +++++++++++++------
 1 file changed, 50 insertions(+), 22 deletions(-)

diff --git a/TMessagesProj/src/main/java/tele/helpers/TeleBadges.kt b/TMessagesProj/src/main/java/tele/helpers/TeleBadges.kt
index fcc2de38f..72a058fea 100644
--- a/TMessagesProj/src/main/java/tele/helpers/TeleBadges.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/TeleBadges.kt
@@ -33,8 +33,11 @@ object TeleBadges {
     // flags tele overwrote, keyed by object identity: restored on clear and written to storage instead of tele's
     private class StockFlags(val verified: Boolean, val scam: Boolean, val fake: Boolean, val support: Boolean)
     private val stockFlags = java.util.Collections.synchronizedMap(java.util.WeakHashMap<TLObject, StockFlags>())
-    // icon document id requires an argon2 hash; cache per peer so list binds don't recompute it on the UI thread
-    private val iconCache = ConcurrentHashMap<Long, Long>()
+    // argon2 is memory-hard (~8 MiB per hash): lookups are cached per feed and never computed on the UI thread
+    private val peerCache = ConcurrentHashMap<String, Peer>()
+    private val noPeer = Peer()
+    private val pending = ConcurrentHashMap.newKeySet<String>()
+    private val lookupQueue by lazy { org.telegram.messenger.DispatchQueue("teleBadges") }
 
     @JvmStatic
     fun current(): ServerData? = dataRef.get()
@@ -54,21 +57,45 @@ object TeleBadges {
         // Bot API style: -100<chatId> for channels/supergroups
         if (chat.id < 0) -1000000000000L - chat.id else chat.id.toLong()
 
-    @JvmStatic
-    fun key(account: Int, peerId: Long): String? {
-        val d = dataRef.get() ?: return null
-        val scope = scopeFor(account)
-        val password = "$scope:$peerId".toByteArray(Charsets.UTF_8)
+    private fun key(d: ServerData, account: Int, peerId: Long): String {
+        val password = "${scopeFor(account)}:$peerId".toByteArray(Charsets.UTF_8)
         val argon2 = com.lambdapioneer.argon2kt.Argon2Kt()
         val res: Argon2KtResult = argon2.hash(com.lambdapioneer.argon2kt.Argon2Mode.ARGON2_ID, password, d.config.salt,
             d.config.passes, d.config.memoryKiB, d.config.lanes, 16, com.lambdapioneer.argon2kt.Argon2Version.V13)
         return Base64.getUrlEncoder().withoutPadding().encodeToString(res.rawHashAsByteArray())
     }
 
+    private fun cacheKey(account: Int, peerId: Long) = "${scopeFor(account)}:$peerId"
+
+    // blocking: background threads only
     @JvmStatic
     fun peer(account: Int, peerId: Long): Peer? {
-        val k = key(account, peerId) ?: return null
-        return dataRef.get()?.peers?.get(k)
+        val d = dataRef.get() ?: return null
+        val cacheKey = cacheKey(account, peerId)
+        peerCache[cacheKey]?.let { return it.takeUnless { p -> p === noPeer } }
+        val p = d.peers[key(d, account, peerId)]
+        if (dataRef.get() === d) peerCache[cacheKey] = p ?: noPeer
+        return p
+    }
+
+    // UI-thread lookup: answers from the cache; a miss is resolved in the background and reported only for listed peers
+    private fun cachedPeer(account: Int, peerId: Long, onResolved: (Peer) -> Unit): Peer? {
+        val d = dataRef.get() ?: return null
+        val cacheKey = cacheKey(account, peerId)
+        peerCache[cacheKey]?.let { return it.takeUnless { p -> p === noPeer } }
+        if (pending.add(cacheKey)) {
+            lookupQueue.postRunnable {
+                val p = try {
+                    runCatching { peer(account, peerId) }.onFailure(FileLog::e).getOrNull()
+                } finally {
+                    pending.remove(cacheKey)
+                }
+                if (p != null) {
+                    org.telegram.messenger.AndroidUtilities.runOnUIThread { if (dataRef.get() === d) onResolved(p) }
+                }
+            }
+        }
+        return null
     }
 
     private fun parse(jsonText: String): ServerData? {
@@ -128,7 +155,7 @@ object TeleBadges {
     fun loadFromJson(text: String): Boolean {
         val d = parse(text) ?: return false
         dataRef.set(d)
-        iconCache.clear()
+        peerCache.clear()
         return true
     }
 
@@ -158,7 +185,7 @@ object TeleBadges {
     @JvmStatic
     fun clearCachedData(account: Int) {
         dataRef.set(null)
-        iconCache.clear()
+        peerCache.clear()
         val marked = synchronized(stockFlags) { stockFlags.keys.toList() }
         marked.forEach(::unmark)
         notifyChanged(account)
@@ -191,15 +218,21 @@ object TeleBadges {
 
     @JvmStatic
     fun applyUser(account: Int, user: TLRPC.User) {
-        if (dataRef.get() == null) return
-        val p = peer(account, user.id.toLong()) ?: return
+        val p = cachedPeer(account, user.id.toLong()) { resolved ->
+            // the object handed to putUser may have been replaced while its key was computed
+            MessagesController.getInstance(account).getUser(user.id)?.let { mark(it, resolved) }
+            notifyChanged(account)
+        } ?: return
         mark(user, p)
     }
 
     @JvmStatic
     fun applyChat(account: Int, chat: TLRPC.Chat) {
-        if (dataRef.get() == null || !ChatObject.isChannel(chat)) return
-        val p = peer(account, channelPeerId(chat)) ?: return
+        if (!ChatObject.isChannel(chat)) return
+        val p = cachedPeer(account, channelPeerId(chat)) { resolved ->
+            MessagesController.getInstance(account).getChat(chat.id)?.let { mark(it, resolved) }
+            notifyChanged(account)
+        } ?: return
         mark(chat, p)
     }
 
@@ -289,13 +322,8 @@ object TeleBadges {
 
     @JvmStatic
     fun iconDocumentId(account: Int, peerId: Long): Long {
-        val key = (account.toLong() shl 32) or (peerId and 0xFFFFFFFFL)
-        if (iconCache.containsKey(key)) {
-            return iconCache[key]!!
-        }
-        val id = peer(account, peerId)?.icon?.let { runCatching { it.toLong() }.getOrDefault(0L) } ?: 0L
-        iconCache[key] = id
-        return id
+        val p = cachedPeer(account, peerId) { notifyChanged(account) } ?: return 0L
+        return p.icon?.toLongOrNull() ?: 0L
     }
 
     @JvmStatic
