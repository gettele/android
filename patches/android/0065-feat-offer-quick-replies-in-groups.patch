+    private void teleResendQuickReply(QuickRepliesController.QuickReply reply) {
+        QuickRepliesController.getInstance(currentAccount).sendQuickReply(dialog_id, reply, messages -> {
+            if (messages == null || messages.isEmpty()) {
+                BulletinFactory.of(this).createSimpleBulletin(R.raw.error, getString(R.string.UnknownError)).show();
+                return;
+            }
+            for (TLRPC.Message message : messages) {
+                if (message.media instanceof TLRPC.TL_messageMediaWebPage
+                    || message.media instanceof TLRPC.TL_messageMediaEmpty
+                    || message.media == null) {
+                    SendMessagesHelper.SendMessageParams params = SendMessagesHelper.SendMessageParams.of(
+                        message.message,
+                        dialog_id,
+                        null,
+                        null,
+                        message.media instanceof TLRPC.TL_messageMediaWebPage ? message.media.webpage : null,
+                        true,
+                        message.entities,
+                        message.reply_markup,
+                        null,
+                        true,
+                        0,
+                        0,
+                        null,
+                        false
+                    );
+                    getSendMessagesHelper().sendMessage(params);
+                } else if (message.media.photo instanceof TLRPC.TL_photo) {
+                    SendMessagesHelper.SendMessageParams params = SendMessagesHelper.SendMessageParams.of(
+                        (TLRPC.TL_photo) message.media.photo,
+                        null,
+                        dialog_id,
+                        null,
+                        null,
+                        message.message,
+                        message.entities,
+                        message.reply_markup,
+                        null,
+                        true,
+                        0,
+                        0,
+                        message.media.ttl_seconds,
+                        null,
+                        false,
+                        false
+                    );
+                    getSendMessagesHelper().sendMessage(params);
+                } else if (message.media.document instanceof TLRPC.TL_document) {
+                    String attachPath = message.attachPath;
+                    TLRPC.Document document = message.media.document;
+                    if (TextUtils.isEmpty(attachPath) || !new java.io.File(attachPath).exists()) {
+                        String fileName = FileLoader.getInstance(currentAccount).getPathToAttach(document, true).getAbsolutePath();
+                        attachPath = new java.io.File(fileName).exists() ? fileName : null;
+                    }
+                    SendMessagesHelper.SendMessageParams params = SendMessagesHelper.SendMessageParams.of(
+                        (TLRPC.TL_document) document,
+                        null,
+                        attachPath,
+                        dialog_id,
+                        null,
+                        null,
+                        message.message,
+                        message.entities,
+                        message.reply_markup,
+                        null,
+                        true,
+                        0,
+                        0,
+                        message.media.ttl_seconds,
+                        null,
+                        null,
+                        false
+                    );
+                    getSendMessagesHelper().sendMessage(params);
+                } else {
+                    BulletinFactory.of(this).createSimpleBulletin(R.raw.error, getString(R.string.UnknownError)).show();
+                }
+            }
+        });
+    }
