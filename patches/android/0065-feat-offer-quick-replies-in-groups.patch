+    private void teleResendQuickReply(QuickRepliesController.QuickReply reply) {
+        final MessagesStorage storage = getMessagesStorage();
+        storage.getStorageQueue().postRunnable(() -> {
+            ArrayList<TLRPC.Message> messages = new ArrayList<>();
+            SQLiteCursor cursor = null;
+            try {
+                cursor = storage.getDatabase().queryFinalized("SELECT data FROM quick_replies_messages WHERE topic_id = ? ORDER BY mid ASC", reply.id);
+                while (cursor.next()) {
+                    NativeByteBuffer data = cursor.byteBufferValue(0);
+                    if (data != null) {
+                        TLRPC.Message message = TLRPC.Message.TLdeserialize(data, data.readInt32(false), false);
+                        if (message != null) {
+                            message.readAttachPath(data, getUserConfig().clientUserId);
+                            messages.add(message);
+                        }
+                        data.reuse();
+                    }
+                }
+            } catch (Exception e) {
+                FileLog.e(e);
+            } finally {
+                if (cursor != null) {
+                    cursor.dispose();
+                }
+            }
+            AndroidUtilities.runOnUIThread(() -> {
+                if (messages.isEmpty()) {
+                    BulletinFactory.of(this).createSimpleBulletin(R.raw.error, getString(R.string.UnknownError)).show();
+                    return;
+                }
+                ArrayList<MessageObject> objects = new ArrayList<>();
+                for (int a = 0, N = messages.size(); a < N; a++) {
+                    TLRPC.Message message = messages.get(a);
+                    message.quick_reply_shortcut = null;
+                    message.quick_reply_shortcut_id = 0;
+                    message.flags &= ~1073741824;
+                    objects.add(new MessageObject(currentAccount, message, true, false));
+                }
+                getSendMessagesHelper().sendMessage(objects, dialog_id, true, false, true, 0, 0);
+            });
+        });
+    }
