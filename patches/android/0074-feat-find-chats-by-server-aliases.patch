+    // chat search (tele 0103): server aliases starting with the query, exact ones first; a single unloaded target is
+    // resolved once and onResolved re-runs the search
+    @JvmStatic
+    fun searchPeers(account: Int, query: String, onResolved: Runnable?): List<android.util.Pair<String, Long>> {
+        val q = query.trim().trimStart('@').lowercase()
+        if (q.isEmpty()) return emptyList()
+        val index = index(account) ?: return emptyList()
+        val controller = org.telegram.messenger.MessagesController.getInstance(account)
+        val out = ArrayList<android.util.Pair<String, Long>>()
+        val missing = LinkedHashSet<String>()
+        for ((alias, target) in index.targets) {
+            if (!alias.startsWith(q) || Aliases.dialogId(account, alias) != 0L) continue
+            when (val peer = controller.getUserOrChat(target)) {
+                is TLRPC.User -> out.add(android.util.Pair(alias, peer.id))
+                is TLRPC.Chat -> out.add(android.util.Pair(alias, -peer.id))
+                else -> missing.add(target.lowercase())
+            }
+        }
+        if (onResolved != null && missing.size == 1 && resolveRequested.add("$account:${missing.first()}")) {
+            val target = missing.first()
+            org.telegram.messenger.AndroidUtilities.runOnUIThread {
+                controller.userNameResolver.resolve(target) { peerId -> if (peerId != null && peerId != Long.MAX_VALUE) onResolved.run() }
+            }
+        }
+        out.sortWith(compareBy<android.util.Pair<String, Long>> { it.first.length != q.length }.thenBy { it.first })
+        return out
+    }
+
