+    /** The expanded groups are transient: they are not a setting and not exported. */
+    private val expandedGroups = HashSet<String>()
+
+    private val itemsByKey: Map<String, Item<*>> by lazy {
+        tele.configItems.associateBy { it.key }
+    }
+
+    /** Puts the children of a group under their parent and hides them while the group is collapsed. */
+    private fun withGroups(page: List<Row>): List<Row> {
+        if (GROUPS.isEmpty()) return page
+        val childParent = HashMap<String, String>()
+        for ((parent, children) in GROUPS) {
+            for (child in children) {
+                childParent[child] = parent
+            }
+        }
+        val result = ArrayList<Row>()
+        for (row in page) {
+            val key = row.item?.key
+            val parentKey = if (key != null) childParent[key] else null
+            if (parentKey != null && page.any { it.item?.key == parentKey }) {
+                continue // the child is shown under its parent
+            }
+            val children = if (key != null) GROUPS[key] else null
+            if (children == null) {
+                result.add(row)
+                continue
+            }
+            var on = 0
+            for (childKey in children) {
+                if (itemsByKey[childKey]?.value as? Boolean == true) on++
+            }
+            result.add(row.copy(expandable = true, childCount = on))
+            if (!expandedGroups.contains(key)) continue
+            for (childKey in children) {
+                val child = page.firstOrNull { it.item?.key == childKey } ?: continue
+                result.add(child.copy(parent = row.item, indent = 1))
+            }
+        }
+        return result
+    }
+
+    /** The parent of a child row: the group it belongs to. */
+    private fun parentKeyOf(childKey: String): String? {
+        for ((parent, children) in GROUPS) {
+            if (childKey in children) return parent
+        }
+        return null
+    }
+
+    private fun setValue(item: Item<*>, value: Any) {
+        TeleConfig.set(item, value)
+        TeleHooks.onConfigChanged(item)
+    }
+
+    /** Turns the parent of a group on and remembers the values of its children. */
+    private fun setGroupValue(row: Row, value: Boolean) {
+        val item = row.item ?: return
+        setValue(item, value)
+        if (value) {
+            // like the desktop client, a group without an enabled child turns all of them on
+            val children = GROUPS[item.key] ?: return
+            var any = false
+            for (childKey in children) {
+                if (itemsByKey[childKey]?.value as? Boolean == true) {
+                    any = true
+                    break
+                }
+            }
+            if (!any) {
+                for (childKey in children) {
+                    val childItem = itemsByKey[childKey] ?: continue
+                    if (childItem.value is Boolean) setValue(childItem, true)
+                }
+            }
+        }
+        refresh()
+    }
+
+    private fun toggleExpanded(row: Row) {
+        val key = row.item?.key ?: return
+        if (!expandedGroups.remove(key)) expandedGroups.add(key)
+        refresh()
+    }
