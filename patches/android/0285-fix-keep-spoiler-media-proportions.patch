From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Fri, 6 Nov 2026 16:49:05 +0300
Subject: [PATCH] fix: keep spoiler media proportions in docked previews

---
 .../src/main/java/tele/ui/TeleDockedStrip.kt          | 11 +++++++++--
 1 file changed, 9 insertions(+), 2 deletions(-)

diff --git a/TMessagesProj/src/main/java/tele/ui/TeleDockedStrip.kt b/TMessagesProj/src/main/java/tele/ui/TeleDockedStrip.kt
index b44b0f6ff..f86e7445e 100644
--- a/TMessagesProj/src/main/java/tele/ui/TeleDockedStrip.kt
+++ b/TMessagesProj/src/main/java/tele/ui/TeleDockedStrip.kt
@@ -318,8 +318,15 @@ class TeleDockedStrip(
             spoilerEffect?.callback = this
             val image = BackupImageView(context)
             image.setRoundRadius(AndroidUtilities.dp(8f))
-            if (item.spoiler) image.setAspectFit(true)
-            val filter = if (item.spoiler) "${TILE.toInt()}_${TILE.toInt()}_b" else "${TILE.toInt()}_${TILE.toInt()}"
+            if (item.spoiler) {
+                image.setAspectFit(true)
+                if (android.os.Build.VERSION.SDK_INT >= android.os.Build.VERSION_CODES.S) {
+                    image.setRenderEffect(android.graphics.RenderEffect.createBlurEffect(
+                        AndroidUtilities.dp(6f).toFloat(), AndroidUtilities.dp(6f).toFloat(), android.graphics.Shader.TileMode.CLAMP
+                    ))
+                }
+            }
+            val filter = "${TILE.toInt()}_${TILE.toInt()}"
             val placeholder = Theme.chat_attachEmptyDrawable
             val cover = item.coverPath
             val thumb = item.thumbPath
