             "Remove my messages" to "Adds it to chat menus: deletes all your messages there for everyone.",
             "Show seconds in message times" to "Times read 14:03:21, and service messages show their time too.",
+            "Jump to the first message" to "Adds it to the chat menu: opens the very start of the chat or topic.",
             "Hide communities" to "Their chats show up as regular chats.",
             "Hide the all chats folder" to "The chat list opens on your first folder.",
             "Folders past the limit" to "Go past Telegram's folder limits; extras stay on this device.",
@@ -783,6 +784,7 @@ class TeleSettingsActivity @JvmOverloads constructor(private val mode: String =
                 toggle("Unsorted folder", TeleConfig.UNSORTED_FOLDER),
                 toggle("Hide similar channels", TeleConfig.HIDE_SIMILAR_CHANNELS),
                 toggle("Hide communities", TeleConfig.HIDE_COMMUNITIES),
+                toggle("Jump to the first message", TeleConfig.JUMP_TO_FIRST),
                 Row(TYPE_SHADOW),
                 Row(TYPE_HEADER, "Chats and profiles"),
                 toggle("Show names instead of phone numbers in chat headers", TeleConfig.NAME_INSTEAD_OF_PHONE),
