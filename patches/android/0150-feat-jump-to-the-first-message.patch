From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Sat, 24 Oct 2026 03:46:40 +0300
Subject: [PATCH 150/151] feat: jump to the first message

---
 .../src/main/java/org/telegram/ui/ChatActivity.java        | 7 +++++++
 TMessagesProj/src/main/java/tele/TeleConfig.kt             | 2 ++
 TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt | 1 +
 .../src/main/java/tele/ui/settings/TeleSettingsActivity.kt | 2 ++
 TMessagesProj/src/main/res/values/strings_tele.xml         | 1 +
 5 files changed, 13 insertions(+)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
index b5ac0bcf5..afae71980 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
@@ -1735,6 +1735,7 @@ public class ChatActivity extends BaseFragment implements
     private final static int tele_action_peek_last_seen = 133;
     private final static int tele_action_remove_mine = 190;
     private final static int tele_action_bookmarks = 134;
+    private final static int tele_action_jump_first = 320;
 
     private final static int id_chat_compose_panel = 1000;
 
@@ -3894,6 +3895,9 @@ public class ChatActivity extends BaseFragment implements
                     tele.helpers.RemoveMine.start(ChatActivity.this, getDialogId(), getTopicId());
                 } else if (id == tele_action_bookmarks) {
                     tele.helpers.Bookmarks.openList(ChatActivity.this);
+                } else if (id == tele_action_jump_first) {
+                    // a date before any message makes the stock date jump land on the oldest one
+                    jumpToDate(86400);
                 } else if (id == copy) {
                     SpannableStringBuilder str = new SpannableStringBuilder();
                     long previousUid = 0;
@@ -4648,6 +4652,9 @@ public class ChatActivity extends BaseFragment implements
             if (tele.TeleConfig.LAST_SEEN_RESTORE.getValue() && currentUser != null && !currentUser.self && !currentUser.bot && currentEncryptedChat == null && !isTopic) {
                 headerItem.lazilyAddSubItem(tele_action_peek_last_seen, R.drawable.msg_contacts, "Peek last seen");
             }
+            if (tele.TeleConfig.JUMP_TO_FIRST.getValue() && chatMode == 0 && currentEncryptedChat == null && (isTopic || threadMessageId == 0)) {
+                headerItem.lazilyAddSubItem(tele_action_jump_first, R.drawable.msg_go_up, getString(R.string.TeleJumpToFirst));
+            }
             if (tele.TeleConfig.BOOKMARKS.getValue() && currentEncryptedChat == null) {
                 headerItem.lazilyAddSubItem(tele_action_bookmarks, R.drawable.msg_saved, getString(R.string.TeleBookmarks));
                 headerItem.hideSubItem(tele_action_bookmarks);
diff --git a/TMessagesProj/src/main/java/tele/TeleConfig.kt b/TMessagesProj/src/main/java/tele/TeleConfig.kt
index 1c4cab69d..ade75c155 100644
