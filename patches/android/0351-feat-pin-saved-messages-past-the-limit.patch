+            d.pinned = false
+            d.pinnedNum = 0
+        }
+        val dialog = if (self == 0L) null else dict.get(self) as? TLRPC.TL_dialog
+        if (dialog == null) {
+            s.hasFakes = false
+            return
+        }
+        val items = s.lists["d${dialog.folder_id}"]
