diff --git a/TMessagesProj/src/main/java/tele/helpers/LinkRewrites.kt b/TMessagesProj/src/main/java/tele/helpers/LinkRewrites.kt
index 0bcd9cf20..70fab9e8e 100644
--- a/TMessagesProj/src/main/java/tele/helpers/LinkRewrites.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/LinkRewrites.kt
@@ -148,10 +148,30 @@ object LinkRewrites {
     @JvmStatic
     fun rewritePastedLinksEnabled(): Boolean = TeleConfig.REWRITE_PASTED_LINKS.value
 
+    // pasted text stays as typed and only the link preview asks for the rewritten url; idle while previews are off
+    @JvmStatic
+    fun previewOnly(): Boolean =
+        TeleConfig.REWRITE_PASTED_LINKS.value && TeleConfig.REWRITE_PREVIEW_ONLY.value && !TeleConfig.NO_LINK_PREVIEWS.value
+
+    // the preview request text with the rules applied, or null when nothing changes; off the main thread
+    @JvmStatic
+    fun previewText(text: String): String? {
+        if (!previewOnly()) return null
+        val rules = rules()
+        if (rules.isEmpty()) return null
+        var changed = false
+        val memo = HashMap<String, String>()
+        val result = URL_REGEX.replace(text) { match ->
+            val url = match.value
+            memo.getOrPut(url) { applyRules(url, rules)?.first?.also { changed = true } ?: url }
+        }
+        return if (changed) result else null
+    }
+
     // returns the rewritten text and up to three change notes, or null when nothing matched
     @JvmStatic
     fun applyToText(text: String): android.util.Pair<String, java.util.ArrayList<String>>? {
-        if (!TeleConfig.REWRITE_PASTED_LINKS.value) return null
+        if (!TeleConfig.REWRITE_PASTED_LINKS.value || previewOnly()) return null
         val rules = rules()
         if (rules.isEmpty()) return null
         val notes = ArrayList<String>()
