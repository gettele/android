From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?t=CE=B1ngenx?= <me@tangenx.dev>
Date: Thu, 1 Oct 2026 04:50:28 +0300
Subject: [PATCH] feat: show the tele build number

---
 TMessagesProj/build.gradle                            |  1 +
 .../main/java/org/telegram/ui/DialogsActivity.java    | 10 ++--------
 .../main/java/org/telegram/ui/SettingsActivity.java   |  3 ++-
 TMessagesProj/src/main/java/tele/TeleBuild.kt         | 11 +++++++++++
 4 files changed, 16 insertions(+), 9 deletions(-)
 create mode 100644 TMessagesProj/src/main/java/tele/TeleBuild.kt

diff --git a/TMessagesProj/build.gradle b/TMessagesProj/build.gradle
index eb8e75428..2cfd68304 100644
--- a/TMessagesProj/build.gradle
+++ b/TMessagesProj/build.gradle
@@ -165,6 +165,7 @@ android {
         }
         buildConfigField "int", "TELE_API_ID", teleApiId == null || teleApiId.toString().isEmpty() ? "0" : teleApiId.toString()
         buildConfigField "String", "TELE_API_HASH", "\"" + (teleApiHash == null ? "" : teleApiHash.toString()) + "\""
+        buildConfigField "int", "TELE_BUILD", (getProps("TELE_BUILD") ?: "0").toString()
 
         externalNativeBuild {
             cmake {
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/DialogsActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/DialogsActivity.java
index e6478ee82..c8a8735c0 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/DialogsActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/DialogsActivity.java
@@ -150,6 +150,7 @@ import org.telegram.ui.ActionBar.ActionBarPopupWindow;
 import org.telegram.ui.ActionBar.AlertDialog;
 import org.telegram.ui.ActionBar.BackDrawable;
 import org.telegram.ui.ActionBar.BaseFragment;
+import tele.TeleBuild;
 import org.telegram.ui.ActionBar.BottomSheet;
 import org.telegram.ui.ActionBar.INavigationLayout;
 import org.telegram.ui.ActionBar.MenuDrawable;
@@ -3436,14 +3437,7 @@ public class DialogsActivity extends BaseFragment implements NotificationCenter.
             } else {
                 statusDrawable = new AnimatedEmojiDrawable.SwapAnimatedEmojiDrawable(null, dp(26));
                 statusDrawable.center = true;
-                logoDrawable = context.getResources().getDrawable(R.drawable.telegram_logo_2).mutate();
-                logoDrawable.setBounds(0, dp(2), logoDrawable.getIntrinsicWidth(), dp(2) + logoDrawable.getIntrinsicHeight());
-                // a new drawable (also when the view is recreated after a theme switch made elsewhere): remember its tint, the
-                // theme hook only recolors when the color differs from the last one applied
-                logoDrawable.setColorFilter(lastLogoDrawableColor = getThemedColor(Theme.key_telegram_color_dialogsLogo), PorterDuff.Mode.MULTIPLY);
-                SpannableStringBuilder ssb = new SpannableStringBuilder(getString(R.string.AppName));
-                ssb.setSpan(new ImageSpan(logoDrawable), 0, ssb.length(), Spanned.SPAN_EXCLUSIVE_EXCLUSIVE);
-                actionBar.setTitle(ssb, statusDrawable);
+                actionBar.setTitle(TeleBuild.label(), statusDrawable);
                 updateStatus(UserConfig.getInstance(currentAccount).getCurrentUser(), false);
             }
             if (folderId == 0) {
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/SettingsActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/SettingsActivity.java
index c09db7673..895af4389 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/SettingsActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/SettingsActivity.java
@@ -96,6 +96,7 @@ import org.telegram.ui.ActionBar.SimpleActionBarMenu;
 import org.telegram.ui.ActionBar.ActionBarMenuItem;
 import org.telegram.ui.ActionBar.AlertDialog;
 import org.telegram.ui.ActionBar.BaseFragment;
+import tele.TeleBuild;
 import org.telegram.ui.ActionBar.INavigationLayout;
 import org.telegram.ui.ActionBar.SimpleTextView;
 import org.telegram.ui.ActionBar.Theme;
@@ -539,7 +540,7 @@ public class SettingsActivity extends BaseFragment implements NotificationCenter
         }
         subtitleView.setText(sb);
 
-        versionView.setText(getVersionName());
+        versionView.setText(getVersionName() + " · " + TeleBuild.label());
     }
 
 
diff --git a/TMessagesProj/src/main/java/tele/TeleBuild.kt b/TMessagesProj/src/main/java/tele/TeleBuild.kt
new file mode 100644
index 000000000..4f9eedd0a
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/TeleBuild.kt
@@ -0,0 +1,11 @@
+package tele
+
+import org.telegram.messenger.BuildConfig
+
+object TeleBuild {
+    @JvmField
+    val BUILD: Int = BuildConfig.TELE_BUILD
+
+    @JvmStatic
+    fun label(): String = if (BUILD == 0) "tele dev" else "tele $BUILD"
+}
