diff --git a/TMessagesProj/src/main/java/tele/helpers/MultiQuote.kt b/TMessagesProj/src/main/java/tele/helpers/MultiQuote.kt
new file mode 100644
index 000000000..dea082d52
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/MultiQuote.kt
@@ -0,0 +1,131 @@
+package tele.helpers
+
+import android.text.SpannableStringBuilder
+import android.text.Spanned
+import android.view.View
+import org.telegram.messenger.DialogObject
+import org.telegram.messenger.MediaDataController
+import org.telegram.messenger.MessageObject
+import org.telegram.messenger.MessagesController
+import org.telegram.messenger.R
+import org.telegram.messenger.UserConfig
+import org.telegram.tgnet.TLRPC
+import org.telegram.ui.ChatActivity
+import org.telegram.ui.Components.AnimatedEmojiSpan
+import org.telegram.ui.Components.BulletinFactory
+import org.telegram.ui.Components.ChatActivityEnterView
+import org.telegram.ui.Components.QuoteSpan
+import org.telegram.ui.Components.TextStyleSpan
+import tele.TeleConfig
+
+// A reply keeps one server quote; more quotes go into the field as blockquotes (desktop 0210, 0211)
+object MultiQuote {
+
+    /** True when the quote was handled here; false leaves the stock reply-with-quote path. */
+    @JvmStatic
+    fun onQuote(activity: ChatActivity?, enter: ChatActivityEnterView?, mo: MessageObject?, start: Int, end: Int, text: CharSequence?): Boolean {
+        if (!TeleConfig.MULTI_QUOTE.value || activity == null || enter == null || mo == null) {
+            return false
+        }
+        if (enter.visibility != View.VISIBLE || activity.editingMessageObject != null) {
+            return false
+        }
+        val replying = enter.replyingMessageObject
+        if (replying == null || activity.replyQuote == null) {
+            return false
+        }
+        val quote = ChatActivity.ReplyQuote.from(mo, start, end)
+        if (quote?.text == null) {
+            return false
+        }
+        val credit = if (replying.id != mo.id) senderName(activity, mo) else null
+        if (!append(activity, enter, quoteBody(activity, enter, quote), credit)) {
+            return true
+        }
+        if (activity.actionBar != null && activity.actionBar.isActionModeShowed) {
+            activity.clearSelectionMode()
+        }
+        enter.openKeyboard()
+        return true
+    }
+
+    private fun quoteBody(activity: ChatActivity, enter: ChatActivityEnterView, quote: ChatActivity.ReplyQuote): CharSequence {
+        val result = SpannableStringBuilder(quote.text)
+        val entities = quote.entities
+        if (entities.isNullOrEmpty()) {
+            return result
+        }
+        MediaDataController.addTextStyleRuns(entities, quote.text, result)
+        if (!UserConfig.getInstance(activity.currentAccount).isPremium) {
+            return result
+        }
+        val metrics = enter.editField?.paint?.fontMetricsInt
+        for (entity in entities) {
+            if (entity !is TLRPC.TL_messageEntityCustomEmoji || entity.offset < 0 || entity.offset + entity.length > result.length) {
+                continue
+            }
+            val span = if (entity.document != null) AnimatedEmojiSpan(entity.document, metrics) else AnimatedEmojiSpan(entity.document_id, metrics)
+            result.setSpan(span, entity.offset, entity.offset + entity.length, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
+        }
+        return result
+    }
+
+    private fun senderName(activity: ChatActivity, mo: MessageObject): String? {
+        val id = mo.fromChatId
+        if (id == 0L) {
+            return null
+        }
+        return DialogObject.getName(activity.currentAccount, id).trim().ifEmpty { null }
+    }
+
+    private fun append(activity: ChatActivity, enter: ChatActivityEnterView, body: CharSequence, credit: String?): Boolean {
+        val field = enter.editField ?: return false
+        val editable = field.text ?: return false
+        val limit = MessagesController.getInstance(activity.currentAccount).maxMessageLength
+        val separator = if (editable.isNotEmpty() && editable[editable.length - 1] != '\n') 1 else 0
+        // the quote closes with a newline of its own
+        var available = limit - editable.length - separator - 1
+        var prefix = if (credit != null) credit.length + 1 else 0
+        if (prefix > 0 && prefix + 1 >= available) {
+            prefix = 0
+        }
+        available -= prefix
+        if (available < 1) {
+            BulletinFactory.of(activity).createSimpleBulletin(R.raw.error, TeleLowercase.lc("There's no room left for another quote")).show()
+            return false
+        }
+        val content = SpannableStringBuilder()
+        if (prefix > 0 && credit != null) {
+            content.append(credit)
+            content.setSpan(boldSpan(), 0, credit.length, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
+            content.append('\n')
+        }
+        content.append(body)
+        // the new quote is cut, never the text already in the field
+        var cut = prefix + available
+        if (content.length > cut) {
+            if (cut > 0 && Character.isHighSurrogate(content[cut - 1])) {
+                cut--
+            }
+            content.delete(cut, content.length)
+        }
+        if (content.isEmpty()) {
+            return false
+        }
+        if (separator > 0) {
+            editable.append('\n')
+        }
+        val start = editable.length
+        editable.append(content)
+        val selection = QuoteSpan.putQuoteToEditable(editable, start, editable.length, false)
+        field.invalidateQuotes(true)
+        field.setSelection(if (selection in 0..editable.length) selection else editable.length)
+        return true
+    }
+
+    private fun boldSpan(): TextStyleSpan {
+        val run = TextStyleSpan.TextStyleRun()
+        run.flags = TextStyleSpan.FLAG_STYLE_BOLD
+        return TextStyleSpan(run)
+    }
+}
