+    private fun chooseServerUrl() {
+        val activity = parentActivity ?: return
+        val input = android.widget.EditText(activity)
+        input.setText(TeleConfig.TELE_SERVER_URL.value)
+        input.setSingleLine(true)
+        val builder = if (resourceProvider != null) AlertDialog.Builder(activity, resourceProvider) else AlertDialog.Builder(activity)
+        builder.setTitle("tele server url")
+        builder.setView(input)
+        builder.setPositiveButton(org.telegram.messenger.LocaleController.getString(org.telegram.messenger.R.string.OK)) { _, _ ->
+            TeleConfig.set(TeleConfig.TELE_SERVER_URL, input.text.toString())
+            tele.helpers.TeleServer.start(activity)
+            adapter?.refresh()
+        }
+        builder.setNegativeButton(org.telegram.messenger.LocaleController.getString(org.telegram.messenger.R.string.Cancel), null)
+        showDialog(builder.create())
+    }
+
