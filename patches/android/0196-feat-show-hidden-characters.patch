+import java.util.concurrent.atomic.AtomicInteger
 
 /**
- * Desktop 0208: @username instead of invisible names.
+ * Desktop 0208 (@username instead of invisible names) and 0209 (show hidden characters).
  * Replacements are display-only: chat titles are swapped in memory and put back before they reach the DB.
  */
 object InvisibleNames {
 
     private const val MAX_PHRASE = 64
+    private const val CHIP_ALPHA_BG = 31
+    private const val CHIP_ALPHA_FG = 153
 
     private class Entry(val real: String, val shown: String)
 
     // per account: chat id -> real and shown title of the chats whose title is blank
     private val chats = Array(UserConfig.MAX_ACCOUNT_COUNT) { HashMap<Long, Entry>() }
 
+    private val revision = AtomicInteger()
+    private var chipsUsed = false
+
+    /** Changes when a setting changes how texts are decorated, so cached layouts get rebuilt. */
+    @JvmStatic
+    fun revision(): Int = revision.get()
+
     // the exact set of the desktop table
     @JvmStatic
     fun isInvisibleChar(ch: Int): Boolean {
@@ -188,6 +207,12 @@ object InvisibleNames {
         }
     }
 
+    @JvmStatic
+    fun onHiddenCharsChanged() {
+        revision.incrementAndGet()
+        AndroidUtilities.runOnUIThread { refreshAll() }
+    }
+
     private fun refreshAll() {
         TeleHooks.bumpUiRevision()
         for (account in 0 until UserConfig.MAX_ACCOUNT_COUNT) {
@@ -200,4 +225,73 @@ object InvisibleNames {
             center.postNotificationName(NotificationCenter.dialogsNeedReload)
         }
     }
+
+    // 0209: the hidden characters of a text made only of them become chips with their code points
+
+    /** The text with chips when the whole text is hidden characters and the option is on; stale chips are always dropped. */
+    @JvmStatic
+    fun withHiddenChars(text: CharSequence?): CharSequence? {
+        if (text == null) return null
+        val enabled = TeleConfig.SHOW_HIDDEN_CHARS.value
+        if (!enabled && !chipsUsed) return text
+        if (text is Spannable) {
+            for (span in text.getSpans(0, text.length, HiddenCharSpan::class.java)) {
+                text.removeSpan(span)
+            }
+        }
+        if (!enabled || !isInvisibleText(text)) return text
+        chipsUsed = true
+        val result = if (text is SpannableStringBuilder) text else SpannableStringBuilder(text)
+        var i = 0
+        while (i < result.length) {
+            val ch = Character.codePointAt(result, i)
+            val size = Character.charCount(ch)
+            // line breaks stay breaks: a replacement over them would break the layout
+            if (!isLineBreak(ch)) {
+                result.setSpan(HiddenCharSpan(ch), i, i + size, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
+            }
+            i += size
+        }
+        return result
+    }
+
+    private fun isLineBreak(ch: Int): Boolean = ch == 0x0A || ch == 0x0D || ch == 0x0B || ch == 0x0C || ch == 0x85 || ch == 0x2028 || ch == 0x2029
+
+    private fun hexCode(ch: Int): String = Integer.toHexString(ch).uppercase().padStart(4, '0')
+
+    private class HiddenCharSpan(code: Int) : ReplacementSpan() {
+        private val hex = hexCode(code)
+
+        private fun small(base: Paint): Paint {
+            val paint = Paint(base)
+            paint.textSize = base.textSize * 0.7f
+            paint.typeface = Typeface.MONOSPACE
+            paint.isFakeBoldText = false
+            return paint
+        }
+
+        override fun getSize(paint: Paint, text: CharSequence?, start: Int, end: Int, fm: Paint.FontMetricsInt?): Int {
+            if (!TeleConfig.SHOW_HIDDEN_CHARS.value) return 0
+            return Math.ceil(small(paint).measureText(hex).toDouble()).toInt() + 2 * (AndroidUtilities.dp(1f) + AndroidUtilities.dp(3f))
+        }
+
+        override fun draw(canvas: Canvas, text: CharSequence?, start: Int, end: Int, x: Float, top: Int, y: Int, bottom: Int, paint: Paint) {
+            if (!TeleConfig.SHOW_HIDDEN_CHARS.value) return
+            val chip = small(paint)
+            val margin = AndroidUtilities.dp(1f)
+            val width = chip.measureText(hex) + 2 * AndroidUtilities.dp(3f)
+            val metrics = chip.fontMetrics
+            val height = metrics.descent - metrics.ascent + 2 * margin
+            val centerY = (top + bottom) / 2f
+            val rect = RectF(x + margin, centerY - height / 2f, x + margin + width, centerY + height / 2f)
+            val color = paint.color
+            val background = Paint(Paint.ANTI_ALIAS_FLAG)
+            background.color = ColorUtils.setAlphaComponent(color, CHIP_ALPHA_BG)
+            val radius = AndroidUtilities.dp(4f).toFloat()
+            canvas.drawRoundRect(rect, radius, radius, background)
+            chip.color = ColorUtils.setAlphaComponent(color, CHIP_ALPHA_FG)
+            chip.textAlign = Paint.Align.CENTER
+            canvas.drawText(hex, rect.centerX(), rect.centerY() - (metrics.ascent + metrics.descent) / 2f, chip)
+        }
+    }
 }
