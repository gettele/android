diff --git a/TMessagesProj/src/main/java/tele/helpers/PastLimit.kt b/TMessagesProj/src/main/java/tele/helpers/PastLimit.kt
new file mode 100644
index 000000000..e6822c7a0
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/PastLimit.kt
@@ -0,0 +1,290 @@
+package tele.helpers
+
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.FileLog
+import org.telegram.messenger.MessagesController
+import org.telegram.messenger.NotificationCenter
+import org.telegram.messenger.UserConfig
+import org.telegram.messenger.Utilities
+import org.telegram.tgnet.SerializedData
+import org.telegram.tgnet.TLRPC
+import org.telegram.ui.Components.Bulletin
+import org.telegram.ui.Components.StickerSetBulletinLayout
+import tele.TeleConfig
+import tele.db.TeleDatabaseHelper
+
+/**
+ * Saved GIFs and favorite stickers that no longer fit the server limit stay in tele.db and are merged
+ * into the lists the stock code shows. The stock lists keep mirroring the server, so nothing local
+ * is ever sent to it.
+ */
+object PastLimit {
+    const val GIFS = 0
+    const val FAVED = 1
+    private const val KINDS = 2
+    private const val TYPE_FAVE = 2 // MediaDataController.TYPE_FAVE
+
+    private class State {
+        // the newest first
+        val lists = Array(KINDS) { ArrayList<TLRPC.Document>() }
+        // the changes made before the stored rows arrived
+        val forgotten = Array(KINDS) { HashSet<Long>() }
+        val dirty = BooleanArray(KINDS)
+        var loaded = false
+        var loading = false
+    }
+
+    private val states = arrayOfNulls<State>(UserConfig.MAX_ACCOUNT_COUNT)
+
+    @JvmStatic
+    fun enabled(): Boolean = TeleConfig.KEEP_MEDIA_PAST_LIMIT.value
+
+    @Synchronized
+    private fun state(account: Int): State {
+        var s = states[account]
+        if (s == null) {
+            s = State()
+            states[account] = s
+        }
+        return s
+    }
+
+    // reads the stored rows once per session without blocking the caller
+    @Synchronized
+    @JvmStatic
+    fun preload(account: Int) {
+        if (!enabled()) return
+        val s = state(account)
+        if (s.loaded || s.loading) return
+        s.loading = true
+        Utilities.globalQueue.postRunnable {
+            val rows = runCatching { TeleDatabaseHelper.getPastLimit(account) }.onFailure { FileLog.e(it) }.getOrDefault(emptyList())
+            val decoded = rows.mapNotNull { row -> decode(row.data)?.let { row.kind to it } }
+            AndroidUtilities.runOnUIThread { finishLoad(account, s, decoded) }
+        }
+    }
+
+    @Synchronized
+    private fun finishLoad(account: Int, s: State, rows: List<Pair<Int, TLRPC.Document>>) {
+        if (states[account] !== s) return
+        for ((kind, document) in rows) {
+            if (kind !in 0 until KINDS || document.id in s.forgotten[kind]) continue
+            val list = s.lists[kind]
+            if (list.none { it.id == document.id }) list.add(document)
+        }
+        s.loaded = true
+        s.loading = false
+        for (kind in 0 until KINDS) {
+            s.forgotten[kind].clear()
+            if (s.dirty[kind]) {
+                s.dirty[kind] = false
+                persist(account, s, kind)
+            }
+        }
+        if (s.lists.any { it.isNotEmpty() }) notifyLists(account)
+    }
+
+    private fun limit(account: Int, kind: Int): Int {
+        val controller = MessagesController.getInstance(account)
+        val premium = UserConfig.getInstance(account).isPremium
+        return if (kind == GIFS) {
+            if (premium) controller.savedGifsLimitPremium else controller.savedGifsLimitDefault
+        } else {
+            if (premium) controller.stickersFavedLimitPremium else controller.stickersFavedLimitDefault
+        }
+    }
+
+    private fun persist(account: Int, s: State, kind: Int) {
+        if (!s.loaded) {
+            s.dirty[kind] = true
+            return
+        }
+        val snapshot = ArrayList(s.lists[kind])
+        Utilities.globalQueue.postRunnable {
+            runCatching {
+                val rows = snapshot.mapNotNull { document -> encode(document)?.let { TeleDatabaseHelper.PastLimitRow(kind, document.id, it) } }
+                TeleDatabaseHelper.replacePastLimit(account, kind, rows)
+            }.onFailure { FileLog.e(it) }
+        }
+    }
+
+    private fun encode(document: TLRPC.Document): ByteArray? {
+        val stream = SerializedData()
+        return try {
+            document.serializeToStream(stream)
+            stream.toByteArray()
+        } catch (e: Exception) {
+            FileLog.e(e)
+            null
+        } finally {
+            stream.cleanup()
+        }
+    }
+
+    private fun decode(data: ByteArray): TLRPC.Document? {
+        val stream = SerializedData(data)
+        return try {
+            TLRPC.Document.TLdeserialize(stream, stream.readInt32(false), false)?.takeIf { it !is TLRPC.TL_documentEmpty && it.id != 0L }
+        } catch (e: Exception) {
+            FileLog.e(e)
+            null
+        } finally {
+            stream.cleanup()
+        }
+    }
+
+    private fun notifyLists(account: Int) {
+        val center = NotificationCenter.getInstance(account)
+        center.postNotificationName(NotificationCenter.recentDocumentsDidLoad, true, 0)
+        center.postNotificationName(NotificationCenter.recentDocumentsDidLoad, false, TYPE_FAVE)
+    }
+
+    // adds the documents of the extras the server list lacks; the same instance comes back when there is nothing to add
+    @Synchronized
+    private fun merge(account: Int, kind: Int, server: ArrayList<TLRPC.Document>): ArrayList<TLRPC.Document> {
+        if (!enabled()) return server
+        preload(account)
+        val extra = state(account).lists[kind]
+        if (extra.isEmpty()) return server
+        val ids = HashSet<Long>(server.size * 2)
+        server.forEach { ids.add(it.id) }
+        var result = server
+        for (document in extra) {
+            if (!ids.add(document.id)) continue
+            if (result === server) result = ArrayList(server)
+            result.add(document)
+        }
+        return result
+    }
+
+    @Synchronized
+    private fun has(account: Int, kind: Int, id: Long): Boolean {
+        if (!enabled()) return false
+        preload(account)
+        return state(account).lists[kind].any { it.id == id }
+    }
+
+    // true when the document was held locally
+    @Synchronized
+    private fun forget(account: Int, kind: Int, id: Long): Boolean {
+        val s = states[account] ?: return false
+        if (!s.loaded) s.forgotten[kind].add(id)
+        val removed = s.lists[kind].removeAll { it.id == id }
+        if (removed) persist(account, s, kind)
+        return removed
+    }
+
+    // the server list with the local extras after it, for the saved GIFs
+    @JvmStatic
+    fun gifs(account: Int, server: ArrayList<TLRPC.Document>): ArrayList<TLRPC.Document> = merge(account, GIFS, server)
+
+    // the server list with the local extras after it, for the favorite stickers
+    @JvmStatic
+    fun faved(account: Int, server: ArrayList<TLRPC.Document>): ArrayList<TLRPC.Document> = merge(account, FAVED, server)
+
+    @JvmStatic
+    fun hasGif(account: Int, id: Long): Boolean = has(account, GIFS, id)
+
+    @JvmStatic
+    fun hasFaved(account: Int, id: Long): Boolean = has(account, FAVED, id)
+
+    // the GIF got back into the server list
+    @JvmStatic
+    fun forgetGif(account: Int, id: Long) {
+        forget(account, GIFS, id)
+    }
+
+    /** True when the GIF was only local: the caller must not touch the server then. */
+    @JvmStatic
+    fun removeGif(account: Int, id: Long, inServerList: Boolean): Boolean {
+        if (!enabled() || !forget(account, GIFS, id) || inServerList) return false
+        notifyLists(account)
+        return true
+    }
+
+    /**
+     * Before a favorite sticker is added or removed. True when the removal only concerned a local
+     * extra and is done: the server doesn't know the sticker.
+     */
+    @JvmStatic
+    fun beforeFaved(account: Int, document: TLRPC.Document, remove: Boolean, server: List<TLRPC.Document>): Boolean {
+        if (!enabled()) return false
+        val wasLocal = forget(account, FAVED, document.id)
+        if (!remove || !wasLocal || server.any { it.id == document.id }) return false
+        NotificationCenter.getGlobalInstance().postNotificationName(NotificationCenter.showBulletin, Bulletin.TYPE_STICKER, document, StickerSetBulletinLayout.TYPE_REMOVED_FROM_FAVORITES)
+        notifyLists(account)
+        return true
+    }
+
+    /** The stock trimming dropped a saved GIF past the limit. True when it is kept locally. */
+    @JvmStatic
+    fun keepGif(account: Int, document: TLRPC.Document): Boolean = keep(account, GIFS, document)
+
+    /** The stock trimming dropped a favorite sticker; [sizeBefore] is the list size before it. */
+    @JvmStatic
+    fun keepFaved(account: Int, document: TLRPC.Document, sizeBefore: Int): Boolean {
+        if (sizeBefore <= limit(account, FAVED)) return false
+        return keep(account, FAVED, document)
+    }
+
+    @Synchronized
+    private fun keep(account: Int, kind: Int, document: TLRPC.Document): Boolean {
+        if (!enabled() || document.id == 0L) return false
+        preload(account)
+        val s = state(account)
+        val list = s.lists[kind]
+        if (list.none { it.id == document.id }) {
+            list.add(0, document)
+            persist(account, s, kind)
+        }
+        return true
+    }
+
+    /**
+     * A fresh server list replaces the stock one: what the server dropped to stay within its limit
+     * goes to the extras and what it lists again leaves them.
+     */
+    @Synchronized
+    @JvmStatic
+    fun reconcile(account: Int, gif: Boolean, old: List<TLRPC.Document>, fresh: List<TLRPC.Document>) {
+        if (!enabled()) return
+        preload(account)
+        val kind = if (gif) GIFS else FAVED
+        val s = state(account)
+        val list = s.lists[kind]
+        val freshIds = HashSet<Long>(fresh.size * 2)
+        fresh.forEach { freshIds.add(it.id) }
+        var changed = false
+        if (fresh.size >= limit(account, kind)) {
+            val known = HashSet<Long>(freshIds)
+            list.forEach { known.add(it.id) }
+            val dropped = old.filter { known.add(it.id) }
+            if (dropped.isNotEmpty()) {
+                list.addAll(0, dropped)
+                changed = true
+            }
+        }
+        if (list.removeAll { it.id in freshIds }) changed = true
+        if (changed) persist(account, s, kind)
+    }
+
+    // the settings switch: the panels show or hide the extras
+    @JvmStatic
+    fun onToggled() {
+        for (account in 0 until UserConfig.MAX_ACCOUNT_COUNT) {
+            if (!UserConfig.getInstance(account).isClientActivated) continue
+            preload(account)
+            notifyLists(account)
+        }
+    }
+
+    // the account logs out: its extras must not reach the next user of the slot
+    @Synchronized
+    @JvmStatic
+    fun cleanup(account: Int) {
+        states[account] = null
+        Utilities.globalQueue.postRunnable {
+            runCatching { TeleDatabaseHelper.removePastLimit(account) }.onFailure { FileLog.e(it) }
+        }
+    }
+}
