+    class PastLimitRow(val kind: Int, val docId: Long, val data: ByteArray)
+
+    // ordered by the position inside the kind: the newest first
+    fun getPastLimit(account: Int): List<PastLimitRow> {
+        val db = helper?.readableDatabase ?: return emptyList()
+        val result = ArrayList<PastLimitRow>()
+        db.rawQuery("SELECT kind, doc_id, data FROM tele_past_limit WHERE account = ? ORDER BY kind, position", arrayOf(account.toString())).use { c ->
+            while (c.moveToNext()) result.add(PastLimitRow(c.getInt(0), c.getLong(1), c.getBlob(2)))
+        }
+        return result
+    }
+
+    fun replacePastLimit(account: Int, kind: Int, rows: List<PastLimitRow>) {
+        val db = helper?.writableDatabase ?: return
+        db.beginTransaction()
+        try {
+            db.delete("tele_past_limit", "account = ? AND kind = ?", arrayOf(account.toString(), kind.toString()))
+            rows.forEachIndexed { index, row ->
+                val values = ContentValues().apply {
+                    put("account", account)
+                    put("kind", kind)
+                    put("doc_id", row.docId)
+                    put("position", index)
+                    put("data", row.data)
+                }
+                db.insertWithOnConflict("tele_past_limit", null, values, SQLiteDatabase.CONFLICT_REPLACE)
+            }
+            db.setTransactionSuccessful()
+        } finally {
+            db.endTransaction()
+        }
+    }
+
+    fun removePastLimit(account: Int) {
+        val db = helper?.writableDatabase ?: return
+        db.delete("tele_past_limit", "account = ?", arrayOf(account.toString()))
+    }
+
