From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?t=CE=B1ngenx?= <me@tangenx.dev>
Date: Fri, 2 Oct 2026 00:05:40 +0300
Subject: [PATCH 019/128] fix: apply interface toggles without restart

---
 TMessagesProj/src/main/java/tele/TeleHooks.kt   | 17 +++++++++++++++++
 .../tele/ui/settings/TeleSettingsActivity.kt    |  2 ++
 2 files changed, 19 insertions(+)

diff --git a/TMessagesProj/src/main/java/tele/TeleHooks.kt b/TMessagesProj/src/main/java/tele/TeleHooks.kt
index 5dddcbe65..cbe4ddf17 100644
--- a/TMessagesProj/src/main/java/tele/TeleHooks.kt
+++ b/TMessagesProj/src/main/java/tele/TeleHooks.kt
@@ -3,6 +3,10 @@ package tele
 import android.app.Activity
 import android.content.Context
 import org.telegram.messenger.R
+import org.telegram.messenger.AccountInstance
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.NotificationCenter
+import org.telegram.messenger.UserConfig
 import org.telegram.ui.ActionBar.AlertDialog
 import tele.db.TeleDatabaseHelper
 
@@ -42,4 +46,17 @@ object TeleHooks {
             .setOnDismissListener { callConfirmed = false }
             .show()
     }
+
+    @JvmStatic
+    fun onConfigChanged(item: Item<*>) {
+        if (item === TeleConfig.SHOW_SECONDS) {
+            LocaleController.getInstance().recreateFormatters()
+            for (account in 0 until UserConfig.MAX_ACCOUNT_COUNT) {
+                AccountInstance.getInstance(account).getNotificationCenter().postNotificationName(NotificationCenter.messagesDidLoad)
+            }
+        }
+        if (item === TeleConfig.HIDE_ALL_CHATS_FOLDER) {
+            AccountInstance.getInstance(UserConfig.selectedAccount).getNotificationCenter().postNotificationName(NotificationCenter.dialogFiltersUpdated)
+        }
+    }
 }
diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
index 174f9f677..f99376584 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
@@ -18,6 +18,7 @@ import org.telegram.ui.Cells.TextSettingsCell
 import org.telegram.ui.Components.LayoutHelper
 import org.telegram.ui.Components.RecyclerListView
 import tele.Item
+import tele.TeleHooks
 import tele.TeleConfig
 
 class TeleSettingsActivity : BaseFragment() {
@@ -54,6 +55,7 @@ class TeleSettingsActivity : BaseFragment() {
                 val newValue = !cell.isChecked
                 cell.setChecked(newValue)
                 TeleConfig.set(row.item, newValue)
+                TeleHooks.onConfigChanged(row.item)
             }
         }
         frameLayout.addView(listView, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.MATCH_PARENT.toFloat()))
