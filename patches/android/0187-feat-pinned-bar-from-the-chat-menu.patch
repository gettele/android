diff --git a/TMessagesProj/src/main/java/tele/helpers/PinnedBar.kt b/TMessagesProj/src/main/java/tele/helpers/PinnedBar.kt
new file mode 100644
index 000000000..d326e8668
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/PinnedBar.kt
@@ -0,0 +1,58 @@
+package tele.helpers
+
+import android.view.View
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.MessagesController
+import org.telegram.messenger.R
+import org.telegram.ui.ActionBar.ActionBarMenuItem
+import tele.TeleConfig
+
+/**
+ * The chat menu hides and shows the pinned bar. It is offered to people who can pin too (desktop
+ * does not): their bar button unpins, so the menu is their only way to hide it. It uses the stock
+ * `pin_<dialog>` mark: the bar stays hidden while it holds the id of the top pinned message.
+ */
+object PinnedBar {
+
+    private const val NONE = 0
+    private const val SHOWN = 1
+    private const val HIDDEN = 2
+
+    private fun hiddenId(account: Int, dialogId: Long): Int =
+        MessagesController.getNotificationsSettings(account).getInt("pin_$dialogId", 0)
+
+    private fun state(account: Int, dialogId: Long, pinned: List<Int>): Int {
+        if (!TeleConfig.PINNED_BAR_MENU.value || pinned.isEmpty()) return NONE
+        return if (pinned[0] == hiddenId(account, dialogId)) HIDDEN else SHOWN
+    }
+
+    @JvmStatic
+    fun refresh(item: ActionBarMenuItem.Item, account: Int, dialogId: Long, pinned: List<Int>) {
+        when (state(account, dialogId, pinned)) {
+            SHOWN -> {
+                item.setText(LocaleController.getString(R.string.TelePinnedBarHide))
+                item.setIcon(R.drawable.msg_unpin)
+                item.setVisibility(View.VISIBLE)
+            }
+            HIDDEN -> {
+                item.setText(LocaleController.getString(R.string.TelePinnedBarShow))
+                item.setIcon(R.drawable.msg_pin)
+                item.setVisibility(View.VISIBLE)
+            }
+            else -> item.setVisibility(View.GONE)
+        }
+    }
+
+    /** Returns true when the mark changed and the bar has to be updated. */
+    @JvmStatic
+    fun toggle(account: Int, dialogId: Long, pinned: List<Int>): Boolean {
+        val editor = MessagesController.getNotificationsSettings(account).edit()
+        when (state(account, dialogId, pinned)) {
+            SHOWN -> editor.putInt("pin_$dialogId", pinned[0])
+            HIDDEN -> editor.remove("pin_$dialogId")
+            else -> return false
+        }
+        editor.commit()
+        return true
+    }
+}
