diff --git a/TMessagesProj/src/main/java/tele/helpers/ReturnPoint.kt b/TMessagesProj/src/main/java/tele/helpers/ReturnPoint.kt
new file mode 100644
index 000000000..9df7589e1
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/ReturnPoint.kt
@@ -0,0 +1,69 @@
+package tele.helpers
+
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.Utilities
+import org.telegram.tgnet.ConnectionsManager
+import tele.TeleConfig
+import tele.db.TeleDatabaseHelper
+import java.util.concurrent.ConcurrentHashMap
+
+/**
+ * The place a chat was left from when a message was sent while scrolled up.
+ * It is only remembered here: nothing marks the chat as read and nothing goes to the server.
+ */
+object ReturnPoint {
+
+    private data class Key(val account: Int, val dialogId: Long, val topicId: Long)
+
+    private val points = ConcurrentHashMap<Key, Int>()
+    private val loaded = ConcurrentHashMap.newKeySet<Pair<Int, Long>>()
+
+    @JvmStatic
+    fun enabled(): Boolean = TeleConfig.RETURN_POINT.value
+
+    @JvmStatic
+    fun isLoaded(account: Int, dialogId: Long): Boolean = loaded.contains(account to dialogId)
+
+    /** Reads the return points of a chat off the main thread, [done] runs on the main thread. */
+    @JvmStatic
+    fun load(account: Int, dialogId: Long, done: (() -> Unit)?) {
+        if (isLoaded(account, dialogId)) {
+            done?.invoke()
+            return
+        }
+        Utilities.globalQueue.postRunnable {
+            val rows = TeleDatabaseHelper.getReturnPoints(account, dialogId)
+            AndroidUtilities.runOnUIThread {
+                // a point set while the read was running is newer
+                for (row in rows) points.putIfAbsent(Key(account, dialogId, row.topicId), row.messageId)
+                loaded.add(account to dialogId)
+                done?.invoke()
+            }
+        }
+    }
+
+    /** The message to return to, 0 when there is none. */
+    @JvmStatic
+    fun get(account: Int, dialogId: Long, topicId: Long): Int = points[Key(account, dialogId, topicId)] ?: 0
+
+    @JvmStatic
+    fun set(account: Int, dialogId: Long, topicId: Long, messageId: Int) {
+        if (points.put(Key(account, dialogId, topicId), messageId) == messageId) return
+        val now = ConnectionsManager.getInstance(account).currentTime
+        Utilities.globalQueue.postRunnable { TeleDatabaseHelper.putReturnPoint(account, dialogId, topicId, messageId, now) }
+    }
+
+    @JvmStatic
+    fun clear(account: Int, dialogId: Long, topicId: Long) {
+        if (points.remove(Key(account, dialogId, topicId)) == null) return
+        Utilities.globalQueue.postRunnable { TeleDatabaseHelper.removeReturnPoint(account, dialogId, topicId) }
+    }
+
+    /** The message is gone for good: every point of the chat that stood on it goes. */
+    @JvmStatic
+    fun clearMessage(account: Int, dialogId: Long, messageId: Int) {
+        for ((key, value) in points) {
+            if (key.account == account && key.dialogId == dialogId && value == messageId) clear(account, dialogId, key.topicId)
+        }
+    }
+}
