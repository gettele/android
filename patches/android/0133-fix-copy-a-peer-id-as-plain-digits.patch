From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Wed, 21 Oct 2026 23:19:06 +0300
Subject: [PATCH] fix: copy a peer id as plain digits

---
 .../src/main/java/org/telegram/ui/ProfileActivity.java       | 2 +-
 TMessagesProj/src/main/java/tele/helpers/PeerId.kt           | 5 +++++
 2 files changed, 6 insertions(+), 1 deletion(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/ProfileActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/ProfileActivity.java
index 8cb674276..baef4faff 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/ProfileActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/ProfileActivity.java
@@ -7486,7 +7486,7 @@ public class ProfileActivity extends BaseFragment implements NotificationCenter.
             o.setScrimViewBackground(listView.getClipBackground(view));
             o.add(R.drawable.msg_copy, getString(R.string.Copy), () -> {
                 AndroidUtilities.addToClipboard(idRow
-                    ? tele.helpers.PeerId.rowText(currentAccount, userId, chatId)
+                    ? tele.helpers.PeerId.copyText(currentAccount, userId, chatId)
                     : String.valueOf(tele.helpers.PeerId.dc(currentAccount, userId, chatId)));
                 BulletinFactory.of(this).createCopyBulletin(getString(idRow ? R.string.TeleIdCopied : R.string.TeleDcCopied)).show();
             });
diff --git a/TMessagesProj/src/main/java/tele/helpers/PeerId.kt b/TMessagesProj/src/main/java/tele/helpers/PeerId.kt
index cd0cb9d85..1df9e9fe0 100644
--- a/TMessagesProj/src/main/java/tele/helpers/PeerId.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/PeerId.kt
@@ -57,6 +57,11 @@ object PeerId {
         return if (dc.isEmpty()) id else "$id (DC$dc)"
     }
 
+    // the clipboard gets the plain digits, whatever the row shows
+    @JvmStatic
+    fun copyText(account: Int, userId: Long, chatId: Long): String =
+        botApiAdjusted(account, userId, chatId).toString()
+
     @JvmStatic
     fun showDcRow(): Boolean =
         TeleConfig.SHOW_DC.value && !TeleConfig.MERGE_ID_DC.value
