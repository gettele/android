+package tele.ui
+
+import android.content.Context
+import android.text.SpannableStringBuilder
+import android.text.Spanned
+import android.text.style.ForegroundColorSpan
+import android.text.style.TypefaceSpan
+import android.util.TypedValue
+import android.view.View
+import android.widget.FrameLayout
+import android.widget.LinearLayout
+import android.widget.ScrollView
+import android.widget.TextView
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.R
+import org.telegram.ui.ActionBar.ActionBar
+import org.telegram.ui.ActionBar.BaseFragment
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Components.LayoutHelper
+import tele.helpers.TeleLowercase.lc
+import tele.helpers.TeleTl
+
+/** What the console fields accept, in the shape of the desktop's syntax panel. */
+class TeleMtpHelpActivity : BaseFragment() {
+
+    private class Section(val title: String, val body: String, val note: String? = null)
+
+    private val sections = listOf(
+        Section(
+            "Fields",
+            "bot_id: 1000\nscope: \"messages\"",
+            "one input per field of the constructor; the type is shown next to the name"
+        ),
+        Section(
+            "Required",
+            "bot_id*\nvalue_hashes*",
+            "the star marks a field the schema does not hide behind a flags bit; an empty one stops the send"
+        ),
+        Section(
+            "Numbers",
+            "10  -100123  +5  0x1f",
+            "kept exactly as typed; 64-bit ids are safe"
+        ),
+        Section(
+            "Strings",
+            "hello  C:\\path",
+            "typed as is, single line"
+        ),
+        Section(
+            "Flags and Bool",
+            "silent: true\nreply_to: false",
+            "a boolean turns its flags bit on or off; an empty optional field leaves the bit off"
+        ),
+        Section(
+            "Vectors",
+            "1, 2, 3\nx, y",
+            "comma separated; an empty field sends no vector"
+        ),
+        Section(
+            "Bytes",
+            "de ad be ef\ndeadbeef",
+            "hex, spaces allowed"
+        ),
+        Section(
+            "Objects",
+            "{inputPeerUser user_id=1 access_hash=2}\ninputPeerUser{user_id=1;access_hash=2}\ninputPeerSelf",
+            "a constructor with fields or a bare constructor without them"
+        ),
+        Section(
+            "Dangerous methods",
+            "messages.deleteMessages",
+            "a confirmation always comes first; paid ones ask for the local password too"
+        )
+    )
+
+    override fun createView(context: Context): View {
+        actionBar.setBackButtonImage(R.drawable.ic_ab_back)
+        actionBar.setAllowOverlayTitle(true)
+        actionBar.setTitle(lc("Syntax"))
+        actionBar.setActionBarMenuOnItemClick(object : ActionBar.ActionBarMenuOnItemClick() {
+            override fun onItemClick(id: Int) {
+                if (id == -1) finishFragment()
+            }
+        })
+        val scroll = ScrollView(context)
+        val column = LinearLayout(context)
+        column.orientation = LinearLayout.VERTICAL
+        column.setPadding(AndroidUtilities.dp(16f), AndroidUtilities.dp(8f), AndroidUtilities.dp(16f), AndroidUtilities.dp(24f))
+        for (section in sections) {
+            val title = TextView(context)
+            title.text = section.title
+            title.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14f)
+            title.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlueText, resourceProvider))
+            title.setPadding(0, AndroidUtilities.dp(10f), 0, AndroidUtilities.dp(2f))
+            column.addView(title, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT))
+
+            val body = TextView(context)
+            val text = SpannableStringBuilder()
+            val start = text.length
+            text.append(section.body)
+            text.setSpan(TypefaceSpan("monospace"), start, text.length, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
+            body.text = text
+            body.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13f)
+            body.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText, resourceProvider))
+            column.addView(body, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT))
+
+            val note = section.note
+            if (note != null) {
+                val hint = TextView(context)
+                hint.text = note
+                hint.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12f)
+                hint.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText, resourceProvider))
+                column.addView(hint, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT))
+            }
+        }
+        val layer = TextView(context)
+        layer.text = lc("Schema layer ") + TeleTl.layer()
+        layer.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 12f)
+        layer.typeface = android.graphics.Typeface.MONOSPACE
+        layer.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText, resourceProvider))
+        layer.setPadding(0, AndroidUtilities.dp(16f), 0, 0)
+        column.addView(layer, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT))
+
+        scroll.addView(column, FrameLayout.LayoutParams(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT))
+        fragmentView = scroll
+        return scroll
+    }
+}
