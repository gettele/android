diff --git a/TMessagesProj/src/main/java/tele/helpers/TeleMtpDanger.kt b/TMessagesProj/src/main/java/tele/helpers/TeleMtpDanger.kt
new file mode 100644
index 000000000..502d1492d
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/TeleMtpDanger.kt
@@ -0,0 +1,179 @@
+package tele.helpers
+
+import org.json.JSONObject
+import org.telegram.tgnet.TLObject
+import org.telegram.ui.ActionBar.AlertDialog
+import org.telegram.ui.ActionBar.BaseFragment
+import tele.helpers.TeleLowercase.lc
+
+/**
+ * The console can send any method, so the irreversible and paid ones stop at a dialog first; the
+ * payments go through the local password of the stars options, like the rest of tele.
+ */
+object TeleMtpDanger {
+
+    private val EXACT = setOf(
+        "account.deleteAccount",
+        "account.resetAuthorization",
+        "auth.resetAuthorizations",
+        "auth.logOut",
+        "account.updatePasswordSettings",
+        "channels.deleteChannel",
+        "channels.deleteHistory",
+        "messages.deleteHistory",
+        "messages.deleteChat",
+        "messages.deleteMessages",
+        "channels.deleteMessages",
+        "messages.editChatCreator",
+        "channels.deleteParticipantHistory",
+        "messages.deleteSavedHistory",
+        "messages.deleteScheduledMessages",
+        "photos.deletePhotos",
+        "stories.deleteStories",
+        "stickers.deleteStickerSet",
+        "contacts.deleteContacts",
+        "contacts.deleteByPhones",
+        "channels.leaveChannel",
+        "messages.deleteChatUser",
+        "account.setAccountTTL",
+        "payments.sendStarsForm",
+        "payments.sendPaymentForm",
+        "payments.transferStarGift",
+        "payments.convertStarGift",
+        "payments.upgradeStarGift",
+        "payments.updateStarGiftPrice",
+        "payments.resolveStarGiftOffer",
+        "payments.sendStarGiftOffer",
+        "payments.craftStarGift",
+        "messages.sendPaidReaction",
+        "payments.fulfillStarsSubscription"
+    )
+
+    private val ACTIONS = mapOf(
+        "payments.sendStarsForm" to StarsLock.BOT_PAYMENTS,
+        "payments.sendPaymentForm" to StarsLock.BUY,
+        "payments.transferStarGift" to StarsLock.TRANSFER,
+        "payments.sendStarGiftOffer" to StarsLock.TRANSFER,
+        "payments.convertStarGift" to StarsLock.CONVERT,
+        "payments.upgradeStarGift" to StarsLock.UPGRADE,
+        "payments.craftStarGift" to StarsLock.UPGRADE,
+        "payments.resolveStarGiftOffer" to StarsLock.SELL,
+        "payments.updateStarGiftPrice" to StarsLock.SELL,
+        "messages.sendPaidReaction" to StarsLock.REACTIONS,
+        "payments.fulfillStarsSubscription" to StarsLock.SUBSCRIPTIONS
+    )
+
+    private val INVOICES = mapOf(
+        "inputInvoiceMessage" to StarsLock.PAID_MEDIA,
+        "inputInvoiceSlug" to StarsLock.PAID_MEDIA,
+        "inputInvoiceChatInviteSubscription" to StarsLock.SUBSCRIPTIONS,
+        "inputInvoiceStarGift" to StarsLock.SEND,
+        "inputInvoicePremiumGiftStars" to StarsLock.SEND,
+        "inputInvoiceStarGiftUpgrade" to StarsLock.UPGRADE,
+        "inputInvoiceStarGiftPrepaidUpgrade" to StarsLock.UPGRADE,
+        "inputInvoiceStarGiftDropOriginalDetails" to StarsLock.UPGRADE,
+        "inputInvoiceStarGiftTransfer" to StarsLock.TRANSFER,
+        "inputInvoiceStarGiftResale" to StarsLock.BUY,
+        "inputInvoiceStarGiftAuctionBid" to StarsLock.BUY
+    )
+
+    /** The account and money methods that need the local password too, not just the dialog. */
+    private val PASSWORD_FIRST = setOf(
+        "account.deleteAccount",
+        "account.resetAuthorization",
+        "auth.resetAuthorizations",
+        "auth.logOut",
+        "account.updatePasswordSettings"
+    )
+
+    @JvmStatic
+    fun isDangerous(method: String): Boolean {
+        if (EXACT.contains(method)) return true
+        val name = method.substringAfterLast('.')
+        return method.contains(".delete") || method.contains("leave") ||
+            (method.endsWith("TTL") && !name.startsWith("get"))
+    }
+
+    /** The payment kind of a request, looked up by the method and by the invoice it carries. */
+    @JvmStatic
+    fun actionFor(request: TLObject): String? {
+        val method = TeleMtp.methodName(request)
+        ACTIONS[method]?.let { return it }
+        for (field in TeleTl.fields(request.javaClass)) {
+            val value = runCatching { field.get(request) }.getOrNull() ?: continue
+            val name = TeleTl.constructorOf(value)
+            INVOICES[name]?.let { return it }
+        }
+        return null
+    }
+
+    /** The dialog always comes first; the password of the matching stars option follows for payments. */
+    @JvmStatic
+    fun confirm(fragment: BaseFragment?, method: String, argsSummary: String, onAllowed: Runnable, onCancelled: Runnable? = null) {
+        if (!isDangerous(method)) {
+            onAllowed.run()
+            return
+        }
+        val context = fragment?.parentActivity ?: run {
+            onCancelled?.run()
+            return
+        }
+        val spends = method.startsWith("payments.") || method == "messages.sendPaidReaction"
+        val text = StringBuilder(method)
+        if (argsSummary.isNotEmpty()) text.append('\n').append(argsSummary)
+        text.append("\n\n")
+        text.append(lc(if (spends) "This spends stars or gifts." else "This cannot be undone."))
+        AlertDialog.Builder(context, fragment.resourceProvider)
+            .setTitle(lc("Dangerous method"))
+            .setMessage(text.toString())
+            .setPositiveButton(lc("Send")) { _, _ -> allowed(fragment, method, argsSummary, onAllowed, onCancelled) }
+            .setNegativeButton(lc("Cancel")) { _, _ -> onCancelled?.run() }
+            .setOnCancelListener { onCancelled?.run() }
+            .show()
+    }
+
+    private fun allowed(fragment: BaseFragment?, method: String, argsSummary: String, onAllowed: Runnable, onCancelled: Runnable?) {
+        val action = when {
+            PASSWORD_FIRST.contains(method) -> return StarsLock.confirm(fragment?.parentActivity, fragment?.resourceProvider, onAllowed)
+            else -> actionOf(method)
+        }
+        if (action == null) {
+            onAllowed.run()
+            return
+        }
+        StarsLock.guard(fragment, action, onAllowed, onCancelled)
+    }
+
+    private fun actionOf(method: String): String? = ACTIONS[method]
+
+    /** A short, redacted line for the dialog: the fields the request actually sets. */
+    @JvmStatic
+    fun summary(request: TLObject): String {
+        val parts = ArrayList<String>()
+        for (field in TeleTl.fields(request.javaClass)) {
+            val value = runCatching { field.get(request) }.getOrNull() ?: continue
+            if (value is Number && value.toLong() == 0L) continue
+            if (value is Boolean && !value) continue
+            if (value is Collection<*> && value.isEmpty()) continue
+            val name = field.name
+            if (name.contains("password") || name.contains("auth") || name.contains("hash") || name.contains("phone")) {
+                parts.add("$name=<redacted>")
+            } else {
+                val text = TeleTl.constructorOf(value).take(60)
+                parts.add("$name=$text")
+            }
+            if (parts.size >= 4) break
+        }
+        return parts.joinToString(", ")
+    }
+
+    /** For tests and the schema json: whether a method is dangerous, without any UI. */
+    @JvmStatic
+    fun dumpMethods(): JSONObject {
+        val result = JSONObject()
+        for (method in TeleTl.methods()) {
+            if (isDangerous(method.name)) result.put(method.name, true)
+        }
+        return result
+    }
+}
