+++ b/TMessagesProj/src/main/java/tele/helpers/TeleMtpHistory.kt
@@ -0,0 +1,39 @@
+package tele.helpers
+
+/** The last console requests of this device, kept in memory only and only when the option is on. */
+object TeleMtpHistory {
+
+    class Item(
+        @JvmField val method: String,
+        @JvmField val args: String,
+        @JvmField val result: String,
+        @JvmField val timeMillis: Long
+    )
+
+    private const val MAX = 20
+    private val lock = Any()
+    private val lists = HashMap<Int, ArrayDeque<Item>>()
+
+    @JvmStatic
+    fun add(account: Int, method: String, args: String, result: String) {
+        synchronized(lock) {
+            val list = lists.getOrPut(account) { ArrayDeque() }
+            list.addFirst(Item(method, args.take(400), result.take(400), System.currentTimeMillis()))
+            while (list.size > MAX) list.removeLast()
+        }
+    }
+
+    @JvmStatic
+    fun items(account: Int): List<Item> = synchronized(lock) { ArrayList(lists[account].orEmpty()) }
+
+    @JvmStatic
+    fun clear(account: Int) {
+        synchronized(lock) { lists.remove(account) }
+    }
+
+    @JvmStatic
+    fun sizeText(account: Int): String {
+        val count = synchronized(lock) { lists[account]?.size ?: 0 }
+        return "$count ${if (count == 1) "request" else "requests"}"
+    }
+}
