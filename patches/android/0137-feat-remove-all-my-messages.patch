+++ b/TMessagesProj/src/main/java/tele/helpers/RemoveMine.kt
@@ -0,0 +1,401 @@
+package tele.helpers
+
+import android.widget.Toast
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.ApplicationLoader
+import org.telegram.messenger.ChatObject
+import org.telegram.messenger.DialogObject
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.MessageObject
+import org.telegram.messenger.MessagesController
+import org.telegram.messenger.R
+import org.telegram.messenger.UserObject
+import org.telegram.messenger.Utilities
+import org.telegram.tgnet.ConnectionsManager
+import org.telegram.tgnet.RequestDelegate
+import org.telegram.tgnet.TLObject
+import org.telegram.tgnet.TLRPC
+import org.telegram.ui.ActionBar.AlertDialog
+import org.telegram.ui.ActionBar.BaseFragment
+import tele.TeleConfig
+import java.util.concurrent.ConcurrentHashMap
+
+/**
+ * Removes all the messages the current account wrote in a chat or a forum topic: the own messages
+ * are searched page by page and deleted for everyone by the stock deleter, newest first.
+ * The state of a run lives on the UI thread, only the stock delete callback comes from outside.
+ */
+object RemoveMine {
+
+    private const val PER_PAGE = 100
+    private const val PAUSE = 300L
+    private const val PAUSE_JITTER = 200
+    private const val WAIT_JITTER = 1000
+    private const val ANNOUNCE_WAIT = 10
+    private const val SERVICE_NOTIFICATIONS = 777000L
+
+    private val FLOOD = Regex("^FLOOD(?:_PREMIUM)?_WAIT_(\\d+)$")
+    private val runs = ConcurrentHashMap<String, Run>()
+
+    private fun runKey(account: Int, dialogId: Long, topicId: Long) = "$account:$dialogId:$topicId"
+
+    private fun string(res: Int, vararg args: Any): String =
+        if (args.isEmpty()) LocaleController.getString(res) else LocaleController.formatString(res, *args)
+
+    @JvmStatic
+    fun title(): String = string(R.string.TeleRemoveMine)
+
+    /** The menu item is offered when the option is on, and always while a run goes on in the chat. */
+    @JvmStatic
+    fun available(account: Int, dialogId: Long, topicId: Long): Boolean {
+        if (!TeleConfig.REMOVE_MY_MESSAGES.value && !runs.containsKey(runKey(account, dialogId, topicId))) return false
+        return eligible(account, dialogId, topicId)
+    }
+
+    private fun eligible(account: Int, dialogId: Long, topicId: Long): Boolean {
+        if (dialogId == 0L || DialogObject.isEncryptedDialog(dialogId) || dialogId == TeleChat.PEER_ID) return false
+        val controller = MessagesController.getInstance(account)
+        if (DialogObject.isUserDialog(dialogId)) {
+            if (topicId != 0L || dialogId == SERVICE_NOTIFICATIONS || dialogId == UserObject.VERIFY || UserObject.isReplyUser(dialogId)) return false
+            val user = controller.getUser(dialogId) ?: return false
+            return !user.self && !user.bot
+        }
+        val chat = controller.getChat(-dialogId) ?: return false
+        if (ChatObject.isNotInChat(chat)) return false
+        if (ChatObject.isChannel(chat) && (!chat.megagroup || chat.monoforum)) return false
+        return topicId == 0L || ChatObject.isForum(chat)
+    }
+
+    /** Opens the progress of the run of this chat, or counts the messages and asks for a confirmation. */
+    @JvmStatic
+    fun start(fragment: BaseFragment, dialogId: Long, topicId: Long) {
+        val account = fragment.currentAccount
+        val activity = fragment.parentActivity ?: return
+        val running = runs[runKey(account, dialogId, topicId)]
+        if (running != null) {
+            running.attach(fragment)
+            return
+        }
+        if (!eligible(account, dialogId, topicId)) return
+        val targets = arrayListOf(dialogId)
+        if (topicId == 0L && DialogObject.isChatDialog(dialogId)) {
+            val migrated = MessagesController.getInstance(account).getChatFull(-dialogId)?.migrated_from_chat_id ?: 0L
+            if (migrated != 0L) targets.add(-migrated)
+        }
+        val spinner = AlertDialog(activity, AlertDialog.ALERT_TYPE_SPINNER)
+        spinner.showDelayed(300)
+        count(account, targets, topicId, 0, 0) { total, error ->
+            spinner.dismiss()
+            if (error != null) {
+                toast(string(R.string.TeleRemoveMineCountFailed, error))
+            } else if (total <= 0) {
+                toast(string(R.string.TeleRemoveMineNone))
+            } else if (fragment.parentActivity != null) {
+                confirm(fragment, dialogId, topicId, targets, total)
+            }
+        }
+    }
+
+    private fun count(account: Int, targets: List<Long>, topicId: Long, index: Int, sum: Int, done: (Int, String?) -> Unit) {
+        val req = searchRequest(account, targets[index], if (index == 0) topicId else 0L, 0, 1)
+        ConnectionsManager.getInstance(account).sendRequest(req, RequestDelegate { response: TLObject?, error: TLRPC.TL_error? ->
+            AndroidUtilities.runOnUIThread {
+                if (error != null) {
+                    done(0, error.text ?: "")
+                    return@runOnUIThread
+                }
+                val result = response as? TLRPC.messages_Messages
+                val next = sum + if (result == null) 0 else maxOf(result.count, result.messages.size)
+                if (index + 1 < targets.size) {
+                    count(account, targets, topicId, index + 1, next, done)
+                } else {
+                    done(next, null)
+                }
+            }
+        }, ConnectionsManager.RequestFlagFailOnServerErrors)
+    }
+
+    private fun confirm(fragment: BaseFragment, dialogId: Long, topicId: Long, targets: List<Long>, total: Int) {
+        val activity = fragment.parentActivity ?: return
+        val account = fragment.currentAccount
+        val controller = MessagesController.getInstance(account)
+        val isUser = DialogObject.isUserDialog(dialogId)
+        val name = when {
+            isUser -> UserObject.getUserName(controller.getUser(dialogId))
+            topicId != 0L -> controller.getTopicsController().findTopic(-dialogId, topicId)?.title ?: controller.getChat(-dialogId)?.title ?: ""
+            else -> controller.getChat(-dialogId)?.title ?: ""
+        }
+        val text = string(if (isUser) R.string.TeleRemoveMineConfirmUser else R.string.TeleRemoveMineConfirmChat, total, name)
+        val dialog = AlertDialog.Builder(activity)
+            .setTitle(title())
+            .setMessage(text)
+            .setPositiveButton(string(R.string.TeleRemoveMineAction)) { _, _ ->
+                if (runs.containsKey(runKey(account, dialogId, topicId))) return@setPositiveButton
+                val run = Run(account, dialogId, topicId, ArrayList(targets), total)
+                runs[run.key] = run
+                run.attach(fragment)
+                run.requestPage()
+            }
+            .setNegativeButton(LocaleController.getString(R.string.Cancel), null)
+            .create()
+        fragment.showDialog(dialog)
+        dialog.makeRed(android.content.DialogInterface.BUTTON_POSITIVE)
+    }
+
+    /** Called by the stock deleter when the server has answered a delete request. */
+    @JvmStatic
+    fun onDeleteDone(account: Int, dialogId: Long, ids: List<Int>, error: TLRPC.TL_error?) {
+        if (runs.isEmpty()) return
+        val copy = ArrayList(ids)
+        AndroidUtilities.runOnUIThread {
+            for (run in runs.values) {
+                if (run.account == account && run.matches(dialogId, copy)) {
+                    run.deleted(error)
+                    return@runOnUIThread
+                }
+            }
+        }
+    }
+
+    private fun toast(text: String) {
+        Toast.makeText(ApplicationLoader.applicationContext, text, Toast.LENGTH_LONG).show()
+    }
+
+    private fun searchRequest(account: Int, dialogId: Long, topicId: Long, offsetId: Int, limit: Int): TLRPC.TL_messages_search {
+        val req = TLRPC.TL_messages_search()
+        req.peer = MessagesController.getInstance(account).getInputPeer(dialogId)
+        req.q = ""
+        req.from_id = TLRPC.TL_inputPeerSelf()
+        req.saved_reaction = null
+        if (topicId != 0L) {
+            req.flags = req.flags or TLObject.FLAG_1
+            req.top_msg_id = topicId.toInt()
+        }
+        req.filter = TLRPC.TL_inputMessagesFilterEmpty()
+        req.offset_id = offsetId
+        req.limit = limit
+        return req
+    }
+
+    private fun floodWait(type: String): Int =
+        FLOOD.matchEntire(type)?.groupValues?.get(1)?.toIntOrNull()?.coerceAtLeast(1) ?: 0
+
+    private class Run(val account: Int, val dialogId: Long, val topicId: Long, val targets: ArrayList<Long>, val total: Int) {
+        val key = runKey(account, dialogId, topicId)
+
+        private var index = 0
+        private var offsetId = 0
+        private var nextOffsetId = 0
+        private var chunkLimit = PER_PAGE
+        private var removed = 0
+        private var finished = false
+        private var inFlight = false
+        private var chunk: List<Int> = emptyList()
+        private val chunks = ArrayDeque<List<Int>>()
+        private val skip = HashSet<Int>()
+        private val done = HashSet<Int>()
+        private var scheduled: Runnable? = null
+        private var dialog: AlertDialog? = null
+        private var status: String? = null
+
+        private val target get() = targets[index]
+        // the topic belongs to the chat itself, not to the chat it migrated from
+        private val topic get() = if (index == 0) topicId else 0L
+
+        fun matches(dialogId: Long, ids: List<Int>): Boolean = inFlight && !finished && dialogId == target && ids == chunk
+
+        fun attach(fragment: BaseFragment) {
+            val activity = fragment.parentActivity ?: return
+            if (finished) return
+            dialog?.let { if (it.isShowing) it.dismiss() }
+            val progress = AlertDialog(activity, AlertDialog.ALERT_TYPE_LOADING)
+            progress.setCanceledOnTouchOutside(false)
+            progress.setCancelable(false)
+            progress.setNegativeButton(string(R.string.TeleRemoveMineStop)) { _, _ -> stop() }
+            dialog = progress
+            render()
+            fragment.showDialog(progress)
+        }
+
+        private fun render() {
+            val progress = dialog ?: return
+            progress.setMessage(status ?: string(R.string.TeleRemoveMineProgress, removed, total))
+            progress.setProgress(if (total > 0) minOf(removed * 100L / total, 100L).toInt() else 0)
+        }
+
+        fun stop() {
+            finish(string(R.string.TeleRemoveMineStopped, removed))
+        }
+
+        private fun finish(text: String) {
+            if (finished) return
+            finished = true
+            scheduled?.let { AndroidUtilities.cancelRunOnUIThread(it) }
+            scheduled = null
+            dialog?.let { if (it.isShowing) it.dismiss() }
+            dialog = null
+            runs.remove(key, this)
+            toast(text)
+        }
+
+        private fun schedule(delay: Long, action: () -> Unit) {
+            scheduled?.let { AndroidUtilities.cancelRunOnUIThread(it) }
+            val runnable = Runnable {
+                scheduled = null
+                if (!finished) action()
+            }
+            scheduled = runnable
+            AndroidUtilities.runOnUIThread(runnable, delay)
+        }
+
+        private fun pause() = PAUSE + Utilities.fastRandom.nextInt(PAUSE_JITTER)
+
+        fun requestPage() {
+            if (finished) return
+            val req = searchRequest(account, target, topic, offsetId, PER_PAGE)
+            ConnectionsManager.getInstance(account).sendRequest(req, RequestDelegate { response: TLObject?, error: TLRPC.TL_error? ->
+                AndroidUtilities.runOnUIThread {
+                    if (error != null) {
+                        pageFailed(error)
+                    } else {
+                        pageReceived(response as? TLRPC.messages_Messages)
+                    }
+                }
+            }, ConnectionsManager.RequestFlagFailOnServerErrors)
+        }
+
+        private fun pageFailed(error: TLRPC.TL_error) {
+            if (finished) return
+            val type = error.text ?: ""
+            val wait = floodWait(type)
+            if (wait > 0) {
+                waitFor(wait) { requestPage() }
+            } else {
+                finish(string(R.string.TeleRemoveMineFailed, type))
+            }
+        }
+
+        private fun waitFor(seconds: Int, action: () -> Unit) {
+            if (seconds >= ANNOUNCE_WAIT) {
+                status = string(R.string.TeleRemoveMineWaiting, seconds)
+                render()
+            }
+            schedule(seconds * 1000L + Utilities.fastRandom.nextInt(WAIT_JITTER)) {
+                status = null
+                render()
+                action()
+            }
+        }
+
+        private fun pageReceived(result: TLRPC.messages_Messages?) {
+            if (finished) return
+            val messages = result?.messages
+            if (messages.isNullOrEmpty()) {
+                passFinished()
+                return
+            }
+            val ids = ArrayList<Int>(messages.size)
+            var minId = 0
+            for (message in messages) {
+                val id = message.id
+                if (minId == 0 || id < minId) minId = id
+                if (id in done || id in skip) continue
+                if (message is TLRPC.TL_messageEmpty || message.date == 0 || !message.out
+                    || MessageObject.getPeerId(message.peer_id) != target
+                    || DeletedMessages.isKept(account, target, id)
+                ) {
+                    skip.add(id)
+                    continue
+                }
+                ids.add(id)
+            }
+            nextOffsetId = minId
+            if (ids.isEmpty()) {
+                advance()
+                return
+            }
+            ids.sortDescending()
+            chunks.clear()
+            ids.chunked(chunkLimit).forEach { chunks.addLast(it) }
+            deleteNext()
+        }
+
+        private fun deleteNext() {
+            if (finished) return
+            val next = chunks.removeFirstOrNull()
+            if (next == null) {
+                advance()
+                return
+            }
+            chunk = next
+            sendChunk()
+        }
+
+        private fun sendChunk() {
+            inFlight = true
+            // userInitiated: the chat keeps the messages the way it does for any delete the user made
+            MessagesController.getInstance(account).deleteMessages(
+                ArrayList(chunk), null, null, target, true, 0, false, 0, null, topic.toInt(), false, 0, true
+            )
+        }
+
+        fun deleted(error: TLRPC.TL_error?) {
+            inFlight = false
+            if (error == null) {
+                removed += chunk.size
+                done.addAll(chunk)
+                chunk = emptyList()
+                render()
+                schedule(pause()) { deleteNext() }
+                return
+            }
+            val type = error.text ?: ""
+            val wait = floodWait(type)
+            if (wait > 0) {
+                waitFor(wait) { sendChunk() }
+                return
+            }
+            if (type == "MESSAGE_DELETE_FORBIDDEN" || type == "MESSAGE_ID_INVALID") {
+                if (chunk.size == 1) {
+                    skip.add(chunk[0])
+                    chunk = emptyList()
+                    schedule(pause()) { deleteNext() }
+                } else {
+                    // find the message the server refuses by deleting in smaller pieces
+                    chunkLimit = maxOf(chunk.size / 2, 1)
+                    chunk = emptyList()
+                    chunks.clear()
+                    schedule(pause()) { requestPage() }
+                }
+                return
+            }
+            finish(string(R.string.TeleRemoveMineFailed, type))
+        }
+
+        private fun advance() {
+            if (nextOffsetId == 0 || (offsetId != 0 && nextOffsetId >= offsetId)) {
+                passFinished()
+                return
+            }
+            offsetId = nextOffsetId
+            chunkLimit = PER_PAGE
+            schedule(pause()) { requestPage() }
+        }
+
+        private fun passFinished() {
+            if (index + 1 >= targets.size) {
+                finish(string(R.string.TeleRemoveMineDone, removed))
+                return
+            }
+            index++
+            skip.clear()
+            done.clear()
+            chunks.clear()
+            chunk = emptyList()
+            offsetId = 0
+            nextOffsetId = 0
+            chunkLimit = PER_PAGE
+            schedule(pause()) { requestPage() }
+        }
+    }
+}
