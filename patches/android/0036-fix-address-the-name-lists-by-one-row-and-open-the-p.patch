From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Mon, 5 Oct 2026 06:07:29 +0300
Subject: [PATCH] fix: address the name lists by one row and open the profile
 on long press

The click handler took the adapter position straight as an entry index,
but position 0 is the header, so every tap opened the entry below it and
the last one was unreachable. Long press now opens the peer profile.

Confidence: high
Scope-risk: narrow
---
 .../java/tele/ui/settings/TeleNamesActivity.kt     | 14 ++++++++++++--
 1 file changed, 12 insertions(+), 2 deletions(-)

diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleNamesActivity.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleNamesActivity.kt
index 0ea46aed2..c7a75ff7e 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TeleNamesActivity.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleNamesActivity.kt
@@ -18,6 +18,7 @@ import org.telegram.ui.Cells.TextInfoPrivacyCell
 import org.telegram.ui.Cells.TextSettingsCell
 import org.telegram.ui.Components.LayoutHelper
 import org.telegram.ui.Components.RecyclerListView
+import org.telegram.ui.ProfileActivity
 import tele.TeleHooks
 import tele.helpers.Aliases
 import tele.helpers.LocalNames
@@ -81,13 +82,22 @@ class TeleNamesActivity(private val mode: String) : BaseFragment() {
         adapter = Adapter(context)
         listView.setAdapter(adapter)
         listView.setOnItemClickListener { _, position ->
-            val entry = entries.getOrNull(position) ?: return@setOnItemClickListener
+            val entry = entries.getOrNull(position - 1) ?: return@setOnItemClickListener
             if (isAliasMode) {
                 TeleHooks.showUsernameAliasDialog(this, entry.dialogId)
             } else {
                 TeleHooks.showLocalNameDialog(this, entry.dialogId)
             }
         }
+        listView.setOnItemLongClickListener { _, position ->
+            val entry = entries.getOrNull(position - 1)
+            if (entry != null) {
+                presentFragment(ProfileActivity.of(entry.dialogId))
+                true
+            } else {
+                false
+            }
+        }
         frameLayout.addView(listView, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.MATCH_PARENT.toFloat()))
         return fragmentView
     }
@@ -119,7 +129,7 @@ class TeleNamesActivity(private val mode: String) : BaseFragment() {
                 is HeaderCell -> cell.setText(if (isAliasMode) "aliases" else "local names")
                 is TextInfoPrivacyCell -> cell.setText(
                     if (entries.isEmpty()) "nothing saved on this device yet"
-                    else "tap a row to rename it or delete it"
+                    else "tap a row to rename it or delete it, long press to open the profile"
                 )
                 else -> {
                     val entry = entries[position - 1]
