diff --git a/TMessagesProj/src/main/java/tele/scripting/ScriptDrops.kt b/TMessagesProj/src/main/java/tele/scripting/ScriptDrops.kt
new file mode 100644
index 000000000..9c63e391d
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/scripting/ScriptDrops.kt
@@ -0,0 +1,111 @@
+package tele.scripting
+
+import android.content.Context
+import android.content.Intent
+import android.net.Uri
+import android.os.Parcelable
+import android.provider.OpenableColumns
+import org.json.JSONArray
+import org.json.JSONObject
+import java.io.File
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.CopyOnWriteArrayList
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicInteger
+
+/**
+ * The drop interceptors of the running scripts: files shared into the app are offered to them
+ * before they reach a chat, and a script may keep them away.
+ */
+object ScriptDrops {
+
+    private const val TIMEOUT_MS = 500L
+
+    private val runtimes = CopyOnWriteArrayList<ScriptRuntime>()
+    private val waiters = ConcurrentHashMap<Int, CountDownLatch>()
+    private val verdicts = ConcurrentHashMap<Int, Boolean>()
+    private val tokens = AtomicInteger(1)
+
+    @JvmStatic
+    fun register(runtime: ScriptRuntime) {
+        if (!runtimes.contains(runtime)) runtimes.add(runtime)
+    }
+
+    @JvmStatic
+    fun unregister(runtime: ScriptRuntime) {
+        runtimes.remove(runtime)
+    }
+
+    @JvmStatic
+    fun verdict(token: Int, accept: Boolean) {
+        verdicts[token] = accept
+        waiters[token]?.countDown()
+    }
+
+    /** True to accept the files, false when a script drops them. */
+    @JvmStatic
+    fun accept(context: Context, intent: Intent?): Boolean {
+        if (runtimes.isEmpty() || intent == null) return true
+        val action = intent.action
+        if (action != Intent.ACTION_SEND && action != Intent.ACTION_SEND_MULTIPLE) return true
+        val uris = ArrayList<Uri>()
+        if (action == Intent.ACTION_SEND) {
+            val uri = intent.getParcelableExtra<Parcelable>(Intent.EXTRA_STREAM)
+            if (uri is Uri) uris.add(uri)
+        } else {
+            val list = intent.getParcelableArrayListExtra<Parcelable>(Intent.EXTRA_STREAM)
+            list?.forEach { if (it is Uri) uris.add(it) }
+        }
+        if (uris.isEmpty()) return true
+        val files = JSONArray()
+        for (uri in uris) {
+            val (name, size) = fileInfo(context, uri)
+            files.put(JSONObject().put("name", name).put("size", size))
+        }
+        for (runtime in runtimes) {
+            if (!runtime.hasDropInterceptors()) continue
+            val token = tokens.getAndIncrement()
+            val latch = CountDownLatch(1)
+            waiters[token] = latch
+            val payload = JSONObject().put("token", token).put("files", files)
+            if (!runtime.requestDrop(token, payload)) {
+                waiters.remove(token)
+                continue
+            }
+            val answered = latch.await(TIMEOUT_MS, TimeUnit.MILLISECONDS)
+            val accept = verdicts.remove(token)
+            waiters.remove(token)
+            if (!answered || accept == null) return true
+            if (!accept) return false
+        }
+        return true
+    }
+
+    private fun fileInfo(context: Context, uri: Uri): Pair<String, Long> {
+        var name = uri.lastPathSegment ?: "file"
+        var size = -1L
+        try {
+            if ("file".equals(uri.scheme, true)) {
+                val file = File(uri.path ?: "")
+                name = file.name
+                size = file.length()
+            } else {
+                context.contentResolver.query(uri, arrayOf(OpenableColumns.DISPLAY_NAME, OpenableColumns.SIZE), null, null, null)?.use { cursor ->
+                    if (cursor.moveToFirst()) {
+                        val nameIndex = cursor.getColumnIndex(OpenableColumns.DISPLAY_NAME)
+                        if (nameIndex >= 0) {
+                            cursor.getString(nameIndex)?.let { name = it }
+                        }
+                        val sizeIndex = cursor.getColumnIndex(OpenableColumns.SIZE)
+                        if (sizeIndex >= 0 && !cursor.isNull(sizeIndex)) {
+                            size = cursor.getLong(sizeIndex)
+                        }
+                    }
+                }
+            }
+        } catch (e: Throwable) {
+        }
+        return name to size
+    }
+}
