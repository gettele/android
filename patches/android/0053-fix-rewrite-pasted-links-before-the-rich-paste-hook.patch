From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Mon, 5 Oct 2026 20:48:24 +0300
Subject: [PATCH] fix: rewrite pasted links before the rich paste hook

The message field is an anonymous EditTextCaption subclass whose
onTextContextMenuItem intercepts paste with handleRichHtmlPaste first,
so clips with an html flavour (most browser copies) never reached the
rewriter. The rewrite is now a protected method called before it.

Confidence: high
Scope-risk: narrow
---
 .../ui/Components/ChatActivityEnterView.java   |  3 +++
 .../ui/Components/EditTextCaption.java         | 18 ++----------------
 2 files changed, 5 insertions(+), 16 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Components/ChatActivityEnterView.java b/TMessagesProj/src/main/java/org/telegram/ui/Components/ChatActivityEnterView.java
index a8f997306..b70b053cb 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Components/ChatActivityEnterView.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Components/ChatActivityEnterView.java
@@ -5704,6 +5704,9 @@ public class ChatActivityEnterView extends FrameLayout implements
 
             @Override
             public boolean onTextContextMenuItem(int id) {
+                if (id == android.R.id.paste && teleRewritePaste()) {
+                    return true;
+                }
                 if (id == android.R.id.paste && handleRichHtmlPaste()) {
                     return true;
                 }
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Components/EditTextCaption.java b/TMessagesProj/src/main/java/org/telegram/ui/Components/EditTextCaption.java
index 138257ad2..47c7441cf 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Components/EditTextCaption.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Components/EditTextCaption.java
@@ -996,7 +996,6 @@ public class EditTextCaption extends EditTextBoldCursor implements FloatingToolb
     protected boolean performTeleMenuAction(int itemId) {
         return false;
     }
-
     protected boolean teleRewritePaste() {
         ClipboardManager clipboard = (ClipboardManager) getContext().getSystemService(Context.CLIPBOARD_SERVICE);
         ClipData clip = clipboard == null ? null : clipboard.getPrimaryClip();
@@ -1017,21 +1016,8 @@ public class EditTextCaption extends EditTextBoldCursor implements FloatingToolb
         return true;
     }
     public boolean onTextContextMenuItem(int id) {
-        if (id == android.R.id.paste && tele.helpers.LinkRewrites.rewritePastedLinksEnabled()) {
-            ClipboardManager clipboard = (ClipboardManager) getContext().getSystemService(Context.CLIPBOARD_SERVICE);
-            ClipData clip = clipboard == null ? null : clipboard.getPrimaryClip();
-            CharSequence clipText = clip != null && clip.getItemCount() > 0 ? clip.getItemAt(0).coerceToText(getContext()) : null;
-            if (!TextUtils.isEmpty(clipText)) {
-                android.util.Pair<String, java.util.ArrayList<String>> rewritten = tele.helpers.LinkRewrites.applyToText(clipText.toString());
-                if (rewritten != null) {
-                    int start = Math.max(0, getSelectionStart());
-                    int end = Math.min(getText().length(), getSelectionEnd());
-                    setText(getText().replace(start, end, rewritten.first));
-                    setSelection(start + rewritten.first.length(), start + rewritten.first.length());
-                    Toast.makeText(getContext(), TextUtils.join("\n", rewritten.second), Toast.LENGTH_SHORT).show();
-                    return true;
-                }
-            }
+        if (id == android.R.id.paste && teleRewritePaste()) {
+            return true;
         }
         if (id == android.R.id.paste) {
             ClipboardManager clipboard = (ClipboardManager) getContext().getSystemService(Context.CLIPBOARD_SERVICE);
