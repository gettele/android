         headerIcons[view] = icon
         return icon
     }
+
+    /** The badges of a forwarded-from or a reply name: the icon before it, the checkmark after it. */
+    class HeaderBadges internal constructor(internal val icon: Drawable?, internal val iconWidth: Int, internal val check: Drawable?, internal val spaceWidth: Int)
+
+    private val cellIcons = WeakHashMap<View, Array<AnimatedEmojiDrawable.SwapAnimatedEmojiDrawable?>>()
+
+    private class Resolved(val user: TLRPC.User?, val chat: TLRPC.Chat?)
+
+    private fun resolve(account: Int, peer: TLRPC.Peer?): Resolved? {
+        val controller = MessagesController.getInstance(account)
+        return when (peer) {
+            is TLRPC.TL_peerUser -> controller.getUser(peer.user_id)?.let { Resolved(it, null) }
+            is TLRPC.TL_peerChannel -> controller.getChat(peer.channel_id)?.let { Resolved(null, it) }
+            is TLRPC.TL_peerChat -> controller.getChat(peer.chat_id)?.let { Resolved(null, it) }
+            else -> null
+        }
+    }
+
+    private fun resolveFrom(account: Int, message: MessageObject): Resolved? {
+        val id = message.fromChatId
+        val controller = MessagesController.getInstance(account)
+        return when {
+            id > 0 -> controller.getUser(id)?.let { Resolved(it, null) }
+            id < 0 -> controller.getChat(-id)?.let { Resolved(null, it) }
+            else -> null
+        }
+    }
+
+    private fun key(account: Int, peer: Resolved?): Long =
+        if (peer == null) 0L else TeleBadges.bubbleKey(account, peer.user, peer.chat)
+
+    private fun resolveDialog(account: Int, id: Long): Resolved? {
+        val controller = MessagesController.getInstance(account)
+        return when {
+            id > 0 -> controller.getUser(id)?.let { Resolved(it, null) }
+            id < 0 -> controller.getChat(-id)?.let { Resolved(null, it) }
+            else -> null
+        }
+    }
+
+    /** The one peer a quote reply header names, mirroring getReplyQuoteNameWithIcon; null when it names two or none. */
+    private fun resolveQuote(account: Int, message: MessageObject): Resolved? {
+        val replyTo = message.messageOwner?.reply_to ?: return null
+        var sender: Resolved? = null
+        var chat: Resolved? = null
+        var senderNamed = false
+        fun put(peer: Resolved?) {
+            if (peer?.user != null) sender = peer else if (peer != null) chat = peer
+        }
+        val from = replyTo.reply_from
+        if (from != null) {
+            val peer = from.from_id ?: from.saved_from_peer
+            if (peer != null) put(resolve(account, peer)) else senderNamed = !from.from_name.isNullOrEmpty()
+        }
+        val toPeer = replyTo.reply_to_peer_id
+        if (toPeer != null && DialogObject.getPeerDialogId(toPeer) != message.dialogId) put(resolve(account, toPeer))
+        val reply = message.replyMessageObject
+        if (reply != null) {
+            val id = reply.senderId
+            if (DialogObject.isChatDialog(id)) {
+                if (chat == null) chat = resolveDialog(account, id)
+            } else if (sender == null && !senderNamed) {
+                sender = resolveDialog(account, id)
+            }
+        }
+        return if (sender != null && chat != null) null else sender ?: chat
+    }
+
+    private fun storyPeer(message: MessageObject): TLRPC.Peer? =
+        message.messageOwner?.reply_to?.takeIf { it.story_id != 0 }?.peer
+
+    /** Changes with what the headers of a message show, so a bound cell knows to rebuild; 0 when badges are off. */
+    @JvmStatic
+    fun headerKey(account: Int, message: MessageObject?): Long {
+        if (!TeleConfig.BUBBLE_BADGES.value || message == null) return 0L
+        var result = key(account, resolve(account, message.messageOwner?.fwd_from?.from_id))
+        result = result * 31 + key(account, resolveQuote(account, message))
+        result = result * 31 + key(account, resolve(account, storyPeer(message)))
+        if (message.hideSendersName) result = result * 31 + key(account, resolve(account, message.sendAsPeer))
+        val reply = message.replyMessageObject ?: return result
+        result = result * 31 + key(account, resolve(account, reply.messageOwner?.fwd_from?.from_id))
+        return result * 31 + key(account, resolveFrom(account, reply))
+    }
+
+    @JvmStatic
+    fun forwardBadges(view: View, account: Int, message: MessageObject, paint: Paint): HeaderBadges? =
+        badges(view, 0, account, resolve(account, message.messageOwner?.fwd_from?.from_id), paint)
+
+    /** The name over a reply: the original sender of a forwarded reply source, its own sender otherwise. */
+    @JvmStatic
+    fun replyBadges(view: View, account: Int, reply: MessageObject, forwarded: Boolean, paint: Paint): HeaderBadges? =
+        badges(view, 1, account, if (forwarded) resolve(account, reply.messageOwner?.fwd_from?.from_id) else resolveFrom(account, reply), paint)
+
+    /** The name over a quote or cross-chat reply, when it names a single peer. */
+    @JvmStatic
+    fun quoteBadges(view: View, account: Int, message: MessageObject, paint: Paint): HeaderBadges? =
+        badges(view, 1, account, resolveQuote(account, message), paint)
+
+    /** The name over a reply to a story, or any reply whose name is a known peer. */
+    @JvmStatic
+    fun dialogBadges(view: View, account: Int, dialogId: Long, paint: Paint): HeaderBadges? =
+        badges(view, 1, account, resolveDialog(account, dialogId), paint)
+
+    @JvmStatic
+    fun peerBadges(view: View, account: Int, peer: TLRPC.Peer?, paint: Paint): HeaderBadges? =
+        badges(view, 1, account, resolve(account, peer), paint)
+
+    /** Where the name starts in a reply header: after the leading peer-kind icon and its space, if any. */
+    @JvmStatic
+    fun nameStart(name: CharSequence?): Int =
+        if (name is Spanned && name.length > 1 && name.getSpans(0, 1, ColoredImageSpan::class.java).isNotEmpty()) 2 else 0
+
+    private fun badges(view: View, slot: Int, account: Int, peer: Resolved?, paint: Paint): HeaderBadges? {
+        if (peer == null || !TeleConfig.BUBBLE_BADGES.value) return null
+        val iconId = TeleBadges.bubbleIcon(account, peer.user, peer.chat, DialogObject.getBotVerificationIcon(peer.user ?: peer.chat))
+        val verified = (TeleBadges.bubbleKey(account, peer.user, peer.chat) and 1L) != 0L
+        if (iconId == 0L && !verified) return null
+        val size = (paint.textSize * 1.15f).toInt()
+        var icon: Drawable? = null
+        if (iconId != 0L) {
+            icon = cellIcon(view, slot, account, size).also { it.set(iconId, false) }
+        }
+        val check = if (verified) verifiedDrawable() else null
+        return HeaderBadges(icon, size, check, Math.ceil(paint.measureText(" ").toDouble()).toInt())
+    }
+
+    private fun cellIcon(view: View, slot: Int, account: Int, size: Int): AnimatedEmojiDrawable.SwapAnimatedEmojiDrawable {
+        val slots = cellIcons[view] ?: arrayOfNulls<AnimatedEmojiDrawable.SwapAnimatedEmojiDrawable>(2).also {
+            cellIcons[view] = it
+            view.addOnAttachStateChangeListener(object : View.OnAttachStateChangeListener {
+                override fun onViewAttachedToWindow(v: View) {
+                    cellIcons[v]?.forEach { icon -> icon?.attach() }
+                }
+
+                override fun onViewDetachedFromWindow(v: View) {
+                    cellIcons[v]?.forEach { icon -> icon?.detach() }
+                }
+            })
+        }
+        slots[slot]?.let {
+            it.setCurrentAccount(account)
+            return it
+        }
+        val icon = AnimatedEmojiDrawable.SwapAnimatedEmojiDrawable(view, size, AnimatedEmojiDrawable.CACHE_TYPE_EMOJI_STATUS)
+        icon.setCurrentAccount(account)
+        icon.setColor(Theme.getColor(Theme.key_chats_verifiedBackground))
+        if (view.isAttachedToWindow) icon.attach()
+        slots[slot] = icon
+        return icon
+    }
+
+    /** The width the badges take, to take it off the name before it is cut. */
+    @JvmStatic
+    fun reserve(badges: HeaderBadges?): Int {
+        if (badges == null) return 0
+        var width = 0
+        if (badges.icon != null) width += badges.iconWidth + badges.spaceWidth
+        if (badges.check != null) width += badges.spaceWidth + badges.check.intrinsicWidth
+        return width
+    }
+
+    /** The icon goes in at [nameStart], the checkmark after the end. */
+    @JvmStatic
+    fun decorate(badges: HeaderBadges?, text: CharSequence, nameStart: Int): CharSequence {
+        if (badges == null) return text
+        val result = SpannableStringBuilder(text)
+        if (badges.icon != null) {
+            val icon = SpannableStringBuilder().appendDrawable(badges.icon, badges.iconWidth).append(" ")
+            result.insert(nameStart.coerceIn(0, result.length), icon)
+        }
+        if (badges.check != null) result.append(" ").appendDrawable(badges.check)
+        return result
+    }
 }
