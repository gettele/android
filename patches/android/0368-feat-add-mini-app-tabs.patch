+    private void teleSetMiniAppAvatar(GlassTabView tab, long botId) {
+        final TLRPC.User user = getMessagesController().getUser(botId);
+        final BackupImageView image = tab.getBackupImageView();
+        if (user != null && image != null) {
+            tab.setAttachBotUser(user, currentAccount);
+            tab.setText(tele.ui.TeleMiniAppFragment.title(currentAccount, botId));
+        } else if (image != null) {
+            tele.helpers.MainTabsAvatars.bind(image, currentAccount, botId, 22f);
+        }
+    }
+
+    private long teleBotIdOf(String kind) {
+        try {
+            return Long.parseLong(kind.substring(tele.helpers.MainTabsConfig.KIND_MINIAPP_PREFIX.length()));
+        } catch (NumberFormatException e) {
+            return 0;
+        }
+    }
+
