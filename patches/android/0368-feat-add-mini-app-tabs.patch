+import org.telegram.tgnet.TLObject
+import org.telegram.tgnet.TLRPC
+import org.telegram.ui.ActionBar.ActionBar
+import org.telegram.ui.ActionBar.ActionBarMenuItem
+import org.telegram.ui.ActionBar.AlertDialog
+import org.telegram.ui.ActionBar.BaseFragment
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.ChatActivity
+import org.telegram.ui.DialogsActivity
+import org.telegram.ui.LaunchActivity
+import org.telegram.ui.MainTabsActivity
+import org.telegram.ui.PaymentFormActivity
+import org.telegram.ui.Stars.StarsController
+import org.telegram.ui.WebAppDisclaimerAlert
+import org.telegram.ui.bots.BotButtons
+import org.telegram.ui.bots.BotWebViewContainer
+import org.telegram.ui.bots.BotWebViewSheet
+import org.telegram.ui.Components.LayoutHelper
+import java.util.Locale
+import tele.helpers.TeleLowercase
+
+class TeleMiniAppFragment(args: Bundle) : BaseFragment(args), MainTabsActivity.TabFragmentDelegate, NotificationCenter.NotificationCenterDelegate {
+
+    private val account = args.getInt("account", UserConfig.selectedAccount)
+    private val botId = args.getLong("bot_id")
+
+    private var container: BotWebViewContainer? = null
+    private var buttons: BotButtons? = null
+    private var root: FrameLayout? = null
+    private var placeholder: TextView? = null
+    private var settingsItem: ActionBarMenuItem? = null
+    private var settingsVisible = false
+    private var opening = false
+    private var started = false
+    private var loadingBots = false
+    private var closeConfirmation = false
+    private var backButtonVisible = false
+    private var parentSwipingAllowed = true
+    private var queryId = 0L
+    private var sentWebViewData = false
+
+    private val pollRunnable = Runnable {
+        if (queryId == 0L || container == null) {
+            return@Runnable
+        }
+        val request = TLRPC.TL_messages_prolongWebView()
+        request.bot = MessagesController.getInstance(account).getInputUser(botId)
+        request.peer = MessagesController.getInstance(account).getInputPeer(botId)
+        request.query_id = queryId
+        request.silent = false
+        ConnectionsManager.getInstance(account).sendRequest(request) { _, error ->
+            AndroidUtilities.runOnUIThread {
+                if (container == null || queryId == 0L) {
+                    return@runOnUIThread
+                }
+                if (error == null) {
+                    AndroidUtilities.runOnUIThread(pollRunnable, POLL_PERIOD)
+                } else {
+                    queryId = 0L
+                }
+            }
+        }
+    }
+
+    init {
+        setCurrentAccount(account)
+    }
+
+    override fun createActionBar(context: Context): ActionBar {
+        val bar = super.createActionBar(context)
+        bar.setBackButtonImage(R.drawable.ic_ab_back)
+        bar.setTitle(title(account, botId))
+        bar.setActionBarMenuOnItemClick(object : ActionBar.ActionBarMenuOnItemClick() {
+            override fun onItemClick(id: Int) {
+                when (id) {
+                    -1 -> if (onBackPressed(true)) closeToChats()
+                    ID_SETTINGS -> container?.onSettingsButtonPressed()
+                }
+            }
+        })
+        settingsItem = bar.createMenu().addItem(ID_SETTINGS, R.drawable.ic_ab_other, resourceProvider)
+        settingsItem?.visibility = if (settingsVisible) View.VISIBLE else View.GONE
+        return bar
+    }
+
+    override fun createView(context: Context): View {
+        val frame = FrameLayout(context)
+        frame.setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundWhite, resourceProvider))
+        root = frame
+
+        val label = TextView(context)
+        label.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText, resourceProvider))
+        label.setTextSize(android.util.TypedValue.COMPLEX_UNIT_DIP, 15f)
+        label.gravity = Gravity.CENTER
+        val padding = AndroidUtilities.dp(24f)
+        label.setPadding(padding, padding, padding, padding)
+        label.visibility = View.GONE
+        frame.addView(label, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT, Gravity.CENTER))
+        placeholder = label
+
+        val web = container ?: newContainer(context).also { container = it }
+        AndroidUtilities.removeFromParent(web)
+        frame.addView(web, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.MATCH_PARENT))
+        web.setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundWhite, resourceProvider))
+
+        val buttonView = buttons ?: BotButtons(context, resourceProvider).also { buttons = it }
+        AndroidUtilities.removeFromParent(buttonView)
+        buttonView.setOnButtonClickListener { main ->
+            if (main) container?.onMainButtonPressed() else container?.onSecondaryButtonPressed()
+        }
+        buttonView.setOnResizeListener { updateButtonsHeight() }
+        frame.addView(buttonView, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT, Gravity.BOTTOM or Gravity.CENTER_HORIZONTAL))
+        updateButtonsHeight()
+        label.bringToFront()
+
+        frame.addOnAttachStateChangeListener(object : View.OnAttachStateChangeListener {
+            override fun onViewAttachedToWindow(v: View) {
+                updateButtonsHeight()
+            }
+
+            override fun onViewDetachedFromWindow(v: View) {
+            }
+        })
+
+        fragmentView = frame
+        return frame
+    }
+
+    private fun newContainer(context: Context): BotWebViewContainer {
+        val web = object : BotWebViewContainer(context, resourceProvider, Theme.getColor(Theme.key_windowBackgroundWhite, resourceProvider), true) {
+            override fun onTitleChanged(title: String?) {
+                if (!title.isNullOrBlank()) {
+                    actionBar?.setTitle(title)
+                }
+            }
+        }
+        web.setDelegate(createDelegate())
+        return web
+    }
+
+    private fun createDelegate(): BotWebViewContainer.Delegate =
+        object : BotWebViewContainer.Delegate {
+            override fun onCloseRequested(callback: Runnable?) {
+                requestClose(callback)
+            }
+
+            override fun onWebAppSetupClosingBehavior(needConfirmation: Boolean) {
+                closeConfirmation = needConfirmation
+            }
+
+            override fun onWebAppSwipingBehavior(allowSwiping: Boolean) {
+                parentSwipingAllowed = allowSwiping
+            }
+
+            override fun onWebAppSetActionBarColor(colorKey: Int, color: Int, isOverrideColor: Boolean) {
+                actionBar?.setBackgroundColor(color)
+                buttons?.setBackgroundColor(color, true)
+            }
+
+            override fun onWebAppSetNavigationBarColor(color: Int) {
+                setNavigationBarColor(color)
+            }
+
+            override fun onWebAppSetBackgroundColor(color: Int) {
+                root?.setBackgroundColor(color)
+                container?.setBackgroundColor(color)
+                buttons?.setBackgroundColor(color, true)
+            }
+
+            override fun onWebAppExpand() {
+                updateButtonsHeight()
+                root?.requestLayout()
+            }
+
+            override fun onWebAppSwitchInlineQuery(botUser: TLRPC.User, query: String, chatTypes: MutableList<String>) {
+                inlineQuery(botUser, query, chatTypes)
+            }
+
+            override fun onWebAppOpenInvoice(inputInvoice: TLRPC.InputInvoice, slug: String, response: TLObject) {
+                openInvoice(inputInvoice, slug, response)
+            }
+
+            override fun onSetupMainButton(isVisible: Boolean, isActive: Boolean, text: String, emojiId: Long, color: Int, textColor: Int, isProgressVisible: Boolean, hasShineEffect: Boolean) {
+                buttons?.setMainState(BotButtons.ButtonState.of(isVisible, isActive, isProgressVisible, hasShineEffect, text, emojiId, color, textColor), true)
+            }
+
+            override fun onSetupSecondaryButton(isVisible: Boolean, isActive: Boolean, text: String, emojiId: Long, color: Int, textColor: Int, isProgressVisible: Boolean, hasShineEffect: Boolean, position: String) {
+                buttons?.setSecondaryState(BotButtons.ButtonState.of(isVisible, isActive, isProgressVisible, hasShineEffect, text, emojiId, color, textColor, position), true)
+            }
+
+            override fun onSetBackButtonVisible(visible: Boolean) {
+                backButtonVisible = visible
+            }
+
+            override fun onSetSettingsButtonVisible(visible: Boolean) {
+                settingsVisible = visible
+                settingsItem?.visibility = if (visible) View.VISIBLE else View.GONE
+            }
+
+            override fun onSendWebViewData(data: String) {
+                if (sentWebViewData || queryId == 0L) {
+                    return
+                }
+                sentWebViewData = true
+                val request = TLRPC.TL_messages_sendWebViewData()
+                request.bot = MessagesController.getInstance(account).getInputUser(botId)
+                request.random_id = org.telegram.messenger.Utilities.random.nextLong()
+                request.button_text = title(account, botId).toString()
+                request.data = data
+                ConnectionsManager.getInstance(account).sendRequest(request) { response, _ ->
+                    if (response is TLRPC.TL_updates) {
+                        MessagesController.getInstance(account).processUpdates(response, false)
+                    }
+                }
+            }
+
+            override fun getWebAppName(): String = title(account, botId).toString()
+
+            override fun isClipboardAvailable(): Boolean =
+                MediaDataController.getInstance(account).botInAttachMenu(botId) ||
+                    MessagesController.getInstance(account).whitelistedBots.contains(botId)
+        }
+
+    override fun canParentTabsSlide(ev: MotionEvent?, forward: Boolean): Boolean = parentSwipingAllowed
+
+    private fun updateButtonsHeight() {
+        val web = container ?: return
+        val params = web.layoutParams as? FrameLayout.LayoutParams ?: return
+        val height = buttons?.getTotalHeight() ?: 0
+        if (params.bottomMargin != height) {
+            params.bottomMargin = height
+            web.layoutParams = params
+            web.requestLayout()
+        }
+    }
+
+    override fun onResume() {
+        super.onResume()
+        container?.getWebView()?.onResume()
+        if (!started) {
+            started = true
+            startMiniApp()
+        }
+    }
+
+    override fun onPause() {
+        container?.getWebView()?.onPause()
+        super.onPause()
+    }
+
+    override fun onFragmentCreate(): Boolean {
+        NotificationCenter.getInstance(account).addObserver(this, NotificationCenter.webViewResultSent)
+        return super.onFragmentCreate()
+    }
+
+    override fun onFragmentDestroy() {
+        NotificationCenter.getInstance(account).removeObserver(this, NotificationCenter.webViewResultSent)
+        AndroidUtilities.cancelRunOnUIThread(pollRunnable)
+        queryId = 0L
+        container?.destroyWebView()
+        container = null
+        buttons = null
+        root = null
+        placeholder = null
+        super.onFragmentDestroy()
+    }
+
+    override fun didReceivedNotification(id: Int, account: Int, vararg args: Any?) {
+        if (id == NotificationCenter.webViewResultSent) {
+            val sentQueryId = args.firstOrNull() as? Long ?: return
+            if (sentQueryId != 0L && sentQueryId == queryId) {
+                queryId = 0L
+                AndroidUtilities.cancelRunOnUIThread(pollRunnable)
+                closeToChats()
+            }
+        }
+    }
+
+    override fun onThemeColorsChanged() {
+        super.onThemeColorsChanged()
+        root?.setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundWhite, resourceProvider))
+        placeholder?.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText, resourceProvider))
+        container?.updateColors()
+        container?.notifyThemeChanged()
+    }
+
+    override fun onBackPressed(invoked: Boolean): Boolean {
+        if (!super.onBackPressed(invoked)) {
+            return false
+        }
+        if (container?.onBackPressed() == true) {
+            return false
+        }
+        val webView = container?.getWebView()
+        if (webView != null && webView.canGoBack()) {
+            if (invoked) {
+                webView.goBack()
+            }
+            return false
+        }
+        if (backButtonVisible) {
+            return false
+        }
+        if (invoked && closeConfirmation) {
+            confirmClose(null)
+            return false
+        }
+        return true
+    }
+
+    private fun startMiniApp() {
+        val bot = findAttachBot(account, botId)
+        if (bot == null) {
+            if (loadingBots) {
+                return
+            }
+            showPlaceholder(R.string.TeleMiniAppOpenFailed)
+            loadingBots = true
+            MediaDataController.getInstance(account).loadAttachMenuBots(false, true) {
+                loadingBots = false
+                if (container == null || fragmentView == null || container?.getUrlLoaded() != null) {
+                    return@loadAttachMenuBots
+                }
+                val loaded = findAttachBot(account, botId)
+                if (loaded == null) {
+                    showPlaceholder(R.string.TeleMiniAppUnsupported)
+                } else {
+                    openBot(loaded)
+                }
+            }
+            return
+        }
+        openBot(bot)
+    }
+
+    private fun openBot(bot: TLRPC.TL_attachMenuBot) {
+        actionBar?.setTitle(title(account, botId))
+        if (bot.inactive || bot.side_menu_disclaimer_needed) {
+            val dismissed = Runnable { showPlaceholder(R.string.TeleMiniAppOpenFailed) }
+            val allowed = org.telegram.messenger.Utilities.Callback<Boolean> { accepted ->
+                if (!accepted) {
+                    showPlaceholder(R.string.TeleMiniAppOpenFailed)
+                } else {
+                    enableBot(bot) { openWebApp() }
+                }
+            }
+            WebAppDisclaimerAlert.show(context, allowed, MessagesController.getInstance(account).getUser(botId), dismissed)
+        } else {
+            openWebApp()
+        }
+    }
+
+    private fun enableBot(bot: TLRPC.TL_attachMenuBot, onDone: () -> Unit) {
+        val request = TLRPC.TL_messages_toggleBotInAttachMenu()
+        request.bot = MessagesController.getInstance(account).getInputUser(bot.bot_id)
+        request.enabled = true
+        request.write_allowed = true
+        ConnectionsManager.getInstance(account).sendRequest(request, { _, error ->
+            AndroidUtilities.runOnUIThread {
+                if (error != null) {
+                    showPlaceholder(R.string.TeleMiniAppOpenFailed)
+                    return@runOnUIThread
+                }
+                bot.inactive = false
+                bot.side_menu_disclaimer_needed = false
+                MediaDataController.getInstance(account).updateAttachMenuBotsInCache()
+                onDone()
+            }
+        }, ConnectionsManager.RequestFlagInvokeAfter or ConnectionsManager.RequestFlagFailOnServerErrors)
+    }
+
+    private fun openWebApp() {
+        val web = container ?: return
+        if (opening || web.getUrlLoaded() != null) {
+            return
+        }
+        opening = true
+        val user = MessagesController.getInstance(account).getUser(botId)
+        if (user == null) {
+            opening = false
+            showPlaceholder(R.string.TeleMiniAppOpenFailed)
+            return
+        }
+        web.setBotUser(user)
+        web.loadFlickerAndSettingsItem(account, botId, null)
+
+        val request = TLRPC.TL_messages_requestSimpleWebView()
+        request.bot = MessagesController.getInstance(account).getInputUser(botId)
+        request.platform = "android"
+        request.from_side_menu = true
+        request.compact = false
+        request.fullscreen = false
+        BotWebViewSheet.makeThemeParams(resourceProvider)?.let { params ->
+            request.theme_params = TLRPC.TL_dataJSON()
+            request.theme_params.data = params.toString()
+            request.flags = request.flags or 1
+        }
+        ConnectionsManager.getInstance(account).sendRequest(request, { response, error ->
+            AndroidUtilities.runOnUIThread {
+                if (container == null || fragmentView == null || error != null || response == null) {
+                    opening = false
+                    started = false
+                    showPlaceholder(R.string.TeleMiniAppOpenFailed)
+                    return@runOnUIThread
+                }
+                val url: String?
+                val sameOrigin: Boolean
+                if (response is TLRPC.TL_webViewResultUrl) {
+                    url = response.url
+                    sameOrigin = response.same_origin
+                    queryId = response.query_id
+                } else if (response is TLRPC.TL_simpleWebViewResultUrl) {
+                    url = response.url
+                    sameOrigin = false
+                } else {
+                    url = null
+                    sameOrigin = false
+                }
+                if (url.isNullOrEmpty()) {
+                    opening = false
+                    started = false
+                    showPlaceholder(R.string.TeleMiniAppOpenFailed)
+                    return@runOnUIThread
+                }
+                opening = false
+                placeholder?.visibility = View.GONE
+                container?.loadUrl(account, url, sameOrigin)
+                MediaDataController.getInstance(account).increaseWebappRating(botId)
+                if (queryId != 0L) {
+                    AndroidUtilities.cancelRunOnUIThread(pollRunnable)
+                    AndroidUtilities.runOnUIThread(pollRunnable, POLL_PERIOD)
+                }
+            }
+        })
+    }
+
+    private fun showPlaceholder(resId: Int) {
+        placeholder?.text = TeleLowercase.lc(LocaleController.getString(resId))
+        placeholder?.visibility = View.VISIBLE
+    }
+
+    private fun closeToChats() {
+        val tabs = (parentActivity as? LaunchActivity)?.actionBarLayout?.lastFragment as? MainTabsActivity
+        tabs?.tele_showChatsTab()
+    }
+
+    private fun confirmClose(callback: Runnable?) {
+        val user = MessagesController.getInstance(account).getUser(botId)
+        val name = if (user == null) title(account, botId) else UserObject.getUserName(user)
+        val dialog = AlertDialog.Builder(context, resourceProvider)
+            .setTitle(name)
+            .setMessage(LocaleController.getString(R.string.BotWebViewChangesMayNotBeSaved))
+            .setPositiveButton(LocaleController.getString(R.string.BotWebViewCloseAnyway)) { _, _ ->
+                closeConfirmation = false
+                callback?.run()
+                closeToChats()
+            }
+            .setNegativeButton(LocaleController.getString(R.string.Cancel), null)
+            .create()
+        dialog.show()
+        dialog.getButton(AlertDialog.BUTTON_POSITIVE)?.setTextColor(Theme.getColor(Theme.key_text_RedBold, resourceProvider))
+    }
+
+    private fun requestClose(callback: Runnable?) {
+        if (closeConfirmation) {
+            confirmClose(callback)
+        } else {
+            callback?.run()
+            closeToChats()
+        }
+    }
+
+    private fun inlineQuery(bot: TLRPC.User, query: String, chatTypes: List<String>) {
+        if (chatTypes.isEmpty()) {
+            val last = (parentActivity as? LaunchActivity)?.actionBarLayout?.lastFragment
+            if (last is ChatActivity) {
+                last.getChatActivityEnterView()?.setFieldText("@" + UserObject.getPublicUsername(bot) + " " + query)
+                closeToChats()
+                return
+            }
+        }
+        val args = Bundle()
+        args.putInt("dialogsType", DialogsActivity.DIALOGS_TYPE_START_ATTACH_BOT)
+        args.putBoolean("onlySelect", true)
+        args.putBoolean("allowGroups", chatTypes.isEmpty() || chatTypes.contains("groups"))
+        args.putBoolean("allowMegagroups", chatTypes.isEmpty() || chatTypes.contains("groups"))
+        args.putBoolean("allowLegacyGroups", chatTypes.isEmpty() || chatTypes.contains("groups"))
+        args.putBoolean("allowUsers", chatTypes.isEmpty() || chatTypes.contains("users"))
+        args.putBoolean("allowChannels", chatTypes.contains("channels"))
+        args.putBoolean("allowBots", chatTypes.contains("bots"))
+        val picker = DialogsActivity(args)
+        picker.setDelegate { fragment, dids, _, _, _, _, _, topicsFragment ->
+            val dialogId = dids.firstOrNull()?.dialogId ?: return@setDelegate false
+            fragment.finishFragment()
+            topicsFragment?.removeSelfFromStack()
+            val chat = Bundle()
+            chat.putBoolean("scrollToTopOnResume", true)
+            if (DialogObject.isEncryptedDialog(dialogId)) {
+                chat.putInt("enc_id", DialogObject.getEncryptedChatId(dialogId))
+            } else if (DialogObject.isUserDialog(dialogId)) {
+                chat.putLong("user_id", dialogId)
+            } else {
+                chat.putLong("chat_id", -dialogId)
+            }
+            chat.putString("start_text", "@" + UserObject.getPublicUsername(bot) + " " + query)
+            AndroidUtilities.runOnUIThread({
+                if (MessagesController.getInstance(account).checkCanOpenChat(chat, this)) {
+                    presentFragment(ChatActivity(chat))
+                }
+            }, 250)
+            true
+        }
+        presentFragment(picker)
+    }
+
+    private fun openInvoice(inputInvoice: TLRPC.InputInvoice, slug: String, response: TLObject) {
+        if (response is TLRPC.TL_payments_paymentFormStars) {
+            val progress = AlertDialog(context, AlertDialog.ALERT_TYPE_SPINNER)
+            progress.showDelayed(150)
+            StarsController.getInstance(account).openPaymentForm(null, inputInvoice, response, {
+                progress.dismiss()
+            }) { status ->
+                container?.onInvoiceStatusUpdate(slug, status)
+            }
+            return
+        }
+        val payment: PaymentFormActivity = when (response) {
+            is TLRPC.PaymentForm -> {
+                MessagesController.getInstance(account).putUsers(response.users, false)
+                PaymentFormActivity(response, slug, this)
+            }
+            is TLRPC.PaymentReceipt -> PaymentFormActivity(response)
+            else -> return
+        }
+        payment.setPaymentFormCallback { status ->
+            container?.onInvoiceStatusUpdate(slug, status.name.lowercase(Locale.ROOT))
+        }
+        payment.setResourcesProvider(resourceProvider)
+        presentFragment(payment)
+    }
+
+    override fun onRequestPermissionsResultFragment(requestCode: Int, permissions: Array<String>, grantResults: IntArray) {
+        container?.onRequestPermissionsResult(requestCode, permissions, grantResults)
+        super.onRequestPermissionsResultFragment(requestCode, permissions, grantResults)
+    }
+
+    companion object {
+        private const val ID_SETTINGS = 7801
+        private const val POLL_PERIOD = 60_000L
+
+        @JvmStatic
+        fun findAttachBot(account: Int, botId: Long): TLRPC.TL_attachMenuBot? =
+            MediaDataController.getInstance(account).attachMenuBots?.bots?.firstOrNull { it.bot_id == botId }
+
+        @JvmStatic
+        fun title(account: Int, botId: Long): CharSequence {
+            val bot = findAttachBot(account, botId)
+            if (bot != null && !bot.short_name.isNullOrEmpty()) {
+                return bot.short_name
+            }
+            return DialogObject.getName(account, botId)
+        }
+
+        @JvmStatic
+        fun sideMenuBots(account: Int): List<TLRPC.TL_attachMenuBot> =
+            MediaDataController.getInstance(account).attachMenuBots?.bots?.filter { it.show_in_side_menu && it.bot_id != 0L } ?: emptyList()
+    }
+}
