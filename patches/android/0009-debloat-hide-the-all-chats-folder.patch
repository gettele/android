From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?t=CE=B1ngenx?= <me@tangenx.dev>
Date: Thu, 1 Oct 2026 17:06:02 +0300
Subject: [PATCH 009/128] debloat: hide the all chats folder

---
 .../telegram/messenger/MessagesController.java    | 15 ++++++++++++---
 TMessagesProj/src/main/java/tele/TeleConfig.kt    |  2 ++
 .../java/tele/ui/settings/TeleSettingsActivity.kt |  3 ++-
 3 files changed, 16 insertions(+), 4 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/MessagesController.java b/TMessagesProj/src/main/java/org/telegram/messenger/MessagesController.java
index 91faf802c..01b1d9680 100644
--- a/TMessagesProj/src/main/java/org/telegram/messenger/MessagesController.java
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/MessagesController.java
@@ -64,6 +64,7 @@ import org.telegram.messenger.voip.VoIPDebugToSend;
 import org.telegram.messenger.voip.VoIPPreNotificationService;
 import org.telegram.messenger.voip.VoIPService;
 import org.telegram.tgnet.ConnectionsManager;
+import tele.TeleConfig;
 import org.telegram.tgnet.NativeByteBuffer;
 import org.telegram.tgnet.RequestDelegate;
 import org.telegram.tgnet.SerializedData;
@@ -415,10 +416,18 @@ public class MessagesController extends BaseController implements NotificationCe
     private UserNameResolver userNameResolver;
 
     public ArrayList<DialogFilter> getDialogFilters() {
-        if (frozenDialogFilters != null) {
-            return frozenDialogFilters;
+        ArrayList<DialogFilter> list = frozenDialogFilters != null ? frozenDialogFilters : dialogFilters;
+        if (!TeleConfig.HIDE_ALL_CHATS_FOLDER.getValue()) {
+            return list;
         }
-        return dialogFilters;
+        ArrayList<DialogFilter> filtered = new ArrayList<>(list.size());
+        for (int i = 0; i < list.size(); i++) {
+            DialogFilter filter = list.get(i);
+            if (!filter.isDefault()) {
+                filtered.add(filter);
+            }
+        }
+        return filtered;
     }
 
     private final CacheFetcher<Integer, TLRPC.TL_help_appConfig> appConfigFetcher = new CacheFetcher<Integer, TLRPC.TL_help_appConfig>() {
diff --git a/TMessagesProj/src/main/java/tele/TeleConfig.kt b/TMessagesProj/src/main/java/tele/TeleConfig.kt
index 79a98de9d..79d59f26b 100644
--- a/TMessagesProj/src/main/java/tele/TeleConfig.kt
+++ b/TMessagesProj/src/main/java/tele/TeleConfig.kt
@@ -44,6 +44,8 @@ class StringItem(key: String, default: String) : Item<String>(key, default)
 object TeleConfig {
     @JvmField
     val SHOW_SECONDS = BoolItem("show_seconds", false)
+    @JvmField
+    val HIDE_ALL_CHATS_FOLDER = BoolItem("hide_all_chats_folder", false)
 
     private var prefs: SharedPreferences? = null
 
diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
index afccce386..486e62a75 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
@@ -67,7 +67,8 @@ class TeleSettingsActivity : BaseFragment() {
             Row(TYPE_VALUE, "tele", BuildVars.BUILD_VERSION_STRING),
             Row(TYPE_SHADOW),
             Row(TYPE_HEADER, "interface"),
-            Row(TYPE_TOGGLE, "show seconds in message times", item = TeleConfig.SHOW_SECONDS)
+            Row(TYPE_TOGGLE, "show seconds in message times", item = TeleConfig.SHOW_SECONDS),
+            Row(TYPE_TOGGLE, "hide the all chats folder", item = TeleConfig.HIDE_ALL_CHATS_FOLDER)
         )
 
         override fun getItemCount(): Int = rows.size
