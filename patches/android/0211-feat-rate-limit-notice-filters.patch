@@ -381,6 +381,8 @@ object TeleConfig {
     val NOTICES = BoolItem("notices", false)
     @JvmField
     val NOTICES_LIMITS = BoolItem("notices_limits", false)
+    @JvmField
+    val NOTICES_LOG_LIMITS = BoolItem("notices_log_limits", false)
 
     private var prefs: SharedPreferences? = null
 
diff --git a/TMessagesProj/src/main/java/tele/TeleHooks.kt b/TMessagesProj/src/main/java/tele/TeleHooks.kt
index 410a6cc3d..e1331f67a 100644
--- a/TMessagesProj/src/main/java/tele/TeleHooks.kt
+++ b/TMessagesProj/src/main/java/tele/TeleHooks.kt
@@ -170,7 +170,7 @@ object TeleHooks {
         if (item === TeleConfig.ONLINE_NOTIFY) {
             tele.helpers.OnlineNotify.onToggled()
         }
-        if (item === TeleConfig.NOTICES || item === TeleConfig.NOTICES_LIMITS) {
+        if (item === TeleConfig.NOTICES || item === TeleConfig.NOTICES_LIMITS || item === TeleConfig.NOTICES_LOG_LIMITS) {
             tele.helpers.TeleFloodWait.refresh()
         }
         if (item === TeleConfig.KEEP_MEDIA_PAST_LIMIT) {
diff --git a/TMessagesProj/src/main/java/tele/helpers/TeleFloodWait.kt b/TMessagesProj/src/main/java/tele/helpers/TeleFloodWait.kt
index 14ce582b1..7c9eac34d 100644
--- a/TMessagesProj/src/main/java/tele/helpers/TeleFloodWait.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/TeleFloodWait.kt
@@ -95,11 +95,31 @@ object TeleFloodWait {
         return classes.firstOrNull { it.first.isAssignableFrom(request) }?.second
     }
 
-    /** The toasts and the bar. */
-    private fun shown(): Boolean = TeleNotices.enabled() && TeleConfig.NOTICES_LIMITS.value
+    private val transfers: List<Class<*>> by lazy {
+        listOf(
+            TLRPC.TL_upload_getFile::class.java,
+            TLRPC.TL_upload_getWebFile::class.java,
+            TLRPC.TL_upload_getCdnFile::class.java,
+            TLRPC.TL_upload_getFileHashes::class.java,
+            TLRPC.TL_upload_getCdnFileHashes::class.java,
+            TLRPC.TL_upload_reuploadCdnFile::class.java,
+            TLRPC.TL_upload_saveFilePart::class.java,
+            TLRPC.TL_upload_saveBigFilePart::class.java
+        )
+    }
+
+    // slow mode is the chat's own rule and the premium wait of file transfers has its stock bulletin: neither is a rate limit notice
+    private fun tracked(request: Class<*>?, error: String): Boolean = when {
+        error.startsWith("SLOWMODE_WAIT_") -> false
+        error.startsWith("FLOOD_PREMIUM_WAIT_") -> request == null || transfers.none { it.isAssignableFrom(request) }
+        else -> true
+    }
+
+    /** The toasts and the bar; they don't need the center. */
+    private fun shown(): Boolean = TeleConfig.NOTICES_LIMITS.value
 
     /** The entries of the center. */
-    private fun logged(): Boolean = TeleNotices.enabled() && TeleConfig.NOTICES_LIMITS.value
+    private fun logged(): Boolean = TeleNotices.enabled() && TeleConfig.NOTICES_LOG_LIMITS.value
 
     /** Whether tgnet should send the events; the Java side asks it before every request too. */
     @JvmStatic
@@ -126,7 +146,7 @@ object TeleFloodWait {
     }
 
     private fun onWait(account: Int, token: Int, request: Class<*>?, seconds: Int, error: String) {
-        if (!enabled() || seconds <= 0) return
+        if (!enabled() || seconds <= 0 || !tracked(request, error)) return
         val action = classify(request) ?: return
         val key = key(account, action)
         val now = SystemClock.elapsedRealtime()
