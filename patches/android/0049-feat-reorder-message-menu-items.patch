 .../java/tele/ui/settings/TeleMenuActivity.kt | 58 ++++++++++++++++---
 2 files changed, 96 insertions(+), 16 deletions(-)

diff --git a/TMessagesProj/src/main/java/tele/helpers/MessageMenu.kt b/TMessagesProj/src/main/java/tele/helpers/MessageMenu.kt
index ae6b4d9bd..07084bf1a 100644
--- a/TMessagesProj/src/main/java/tele/helpers/MessageMenu.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/MessageMenu.kt
@@ -58,6 +58,30 @@ object MessageMenu {
     )
 
     private const val KEY = "message_menu_hidden"
+    private const val ORDER_KEY = "message_menu_order"
+
+    private fun loadOrder(): Map<Int, Int> {
+        val raw = TeleDatabaseHelper.get(ORDER_KEY) ?: return emptyMap()
+        val out = HashMap<Int, Int>()
+        runCatching {
+            val array = JSONArray(raw)
+            for (i in 0 until array.length()) {
+                out[array.getInt(i)] = i
+            }
+        }
+        return out
+    }
+
+    @JvmStatic
+    fun saveOrder(codes: List<Int>) {
+        if (codes.isEmpty()) {
+            TeleDatabaseHelper.put(ORDER_KEY, null)
+            return
+        }
+        val array = JSONArray()
+        codes.forEach { array.put(it) }
+        TeleDatabaseHelper.put(ORDER_KEY, array.toString())
+    }
 
     private fun load(): MutableSet<Int>? {
         val raw = TeleDatabaseHelper.get(KEY) ?: return null
@@ -97,14 +121,30 @@ object MessageMenu {
 
     @JvmStatic
     fun filter(items: ArrayList<CharSequence>, icons: ArrayList<Int>, options: ArrayList<Int>) {
-        val hidden = load() ?: return
-        if (hidden.isEmpty()) return
-        for (i in options.indices.reversed()) {
-            if (options[i] in hidden) {
-                items.removeAt(i)
-                icons.removeAt(i)
-                options.removeAt(i)
+        val hidden = load()
+        if (hidden != null && hidden.isNotEmpty()) {
+            for (i in options.indices.reversed()) {
+                if (options[i] in hidden) {
+                    items.removeAt(i)
+                    icons.removeAt(i)
+                    options.removeAt(i)
+                }
             }
         }
+        val order = loadOrder()
+        if (order.isEmpty()) return
+        val indices = options.indices.toMutableList()
+        indices.sortBy { i -> order[options[i]] ?: (Int.MAX_VALUE / 2 + i) }
+        val sortedItems = ArrayList<CharSequence>(options.size)
+        val sortedIcons = ArrayList<Int>(options.size)
+        val sortedOptions = ArrayList<Int>(options.size)
+        for (i in indices) {
+            sortedItems.add(items[i])
+            sortedIcons.add(icons[i])
+            sortedOptions.add(options[i])
+        }
+        items.clear(); items.addAll(sortedItems)
+        icons.clear(); icons.addAll(sortedIcons)
+        options.clear(); options.addAll(sortedOptions)
     }
 }
\ No newline at end of file
