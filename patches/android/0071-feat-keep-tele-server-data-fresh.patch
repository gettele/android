+    @JvmStatic
+    @Throws(FeedException::class)
+    fun parse(jsonText: String): ServerData {
+        val o = try {
+            JSONObject(jsonText)
+        } catch (e: org.json.JSONException) {
+            throw FeedException("bad json")
         }
+        val salt = runCatching { Base64.getDecoder().decode(o.optString("salt")) }.getOrNull()
+        if (salt == null || salt.size !in 8..64) throw FeedException("bad salt")
+        val argon2 = o.optJSONObject("argon2") ?: throw FeedException("bad argon2 params")
+        val memory = argon2.intIn("memory", 1024, 65536)
+        val passes = argon2.intIn("passes", 1, 8)
+        val lanes = argon2.intIn("lanes", 1, 8)
+        if (memory == null || passes == null || lanes == null || memory * passes > MAX_ARGON2_WORK) throw FeedException("bad argon2 params")
+        val list = o.optJSONObject("peers") ?: throw FeedException("bad peers")
+        if (list.length() > MAX_ENTRIES) throw FeedException("too many peers")
+        val peers = HashMap<String, Peer>(list.length())
+        val it = list.keys()
+        while (it.hasNext()) {
+            val k = it.next()
+            val tag = runCatching { Base64.getUrlDecoder().decode(k) }.getOrNull()
+            if (tag == null || tag.size != TAG_SIZE) throw FeedException("bad key $k")
+            val entry = list.optJSONObject(k)?.let(::parseEntry) ?: throw FeedException("bad entry $k")
+            peers[Base64.getUrlEncoder().withoutPadding().encodeToString(tag)] = entry
+        }
+        return ServerData(ServerConfig(salt, memory, passes, lanes), peers, parseUsernames(o.optJSONObject("usernames")))
     }
 
