+    private fun parseEntry(e: JSONObject): Peer? {
+        val checkmark = e.flag("checkmark") ?: return null
+        val scam = e.flag("scam") ?: return null
+        val fake = e.flag("fake") ?: return null
+        val support = e.flag("support") ?: return null
+        val supportRaw = e.opt("supportText").takeUnless { it == JSONObject.NULL }
+        val iconRaw = e.opt("icon").takeUnless { it == JSONObject.NULL }
+        val descriptionRaw = e.opt("description").takeUnless { it == JSONObject.NULL }
+        if ((supportRaw != null && supportRaw !is String) || (iconRaw != null && iconRaw !is String) || (descriptionRaw != null && descriptionRaw !is String)) return null
+        val supportText = (supportRaw as String?)?.trim()
+        if (supportText != null && (supportText.isEmpty() || supportText.codePointCount(0, supportText.length) > MAX_SUPPORT_TEXT)) return null
+        var iconId = 0L
+        if (iconRaw != null) {
+            val text = iconRaw as String
+            if (text.isEmpty() || !text[0].isDigit()) return null
+            iconId = text.toULongOrNull()?.toLong() ?: return null
+        }
+        val description = (descriptionRaw as String?)?.takeIf { iconId != 0L && it.isNotBlank() }
+        return Peer(checkmark, scam, fake, support, supportText, iconId, description)
     }
 
+    private fun JSONObject.flag(name: String): Boolean? = when (val v = opt(name)) {
+        null, JSONObject.NULL -> false
+        is Boolean -> v
+        else -> null
+    }
