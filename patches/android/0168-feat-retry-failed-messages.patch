diff --git a/TMessagesProj/src/main/java/tele/helpers/RetryFailed.kt b/TMessagesProj/src/main/java/tele/helpers/RetryFailed.kt
new file mode 100644
index 000000000..7bf8fdfd7
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/RetryFailed.kt
@@ -0,0 +1,64 @@
+package tele.helpers
+
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.MessageObject
+import org.telegram.messenger.R
+import org.telegram.messenger.SendMessagesHelper
+import org.telegram.tgnet.TLRPC
+import org.telegram.ui.ChatActivity
+import org.telegram.ui.Components.AlertsCreator
+import org.telegram.ui.Components.BulletinFactory
+import tele.TeleConfig
+
+/** "Retry all" for the failed messages of the chat, each one goes through the stock retry. */
+object RetryFailed {
+
+    private fun retryable(message: MessageObject): Boolean {
+        val owner = message.messageOwner ?: return false
+        return message.isOut
+            && owner.id < 0
+            && owner.send_state == MessageObject.MESSAGE_SEND_STATE_SEND_ERROR
+            && !message.scheduled
+            && owner.action !is TLRPC.TL_messageActionGramTransfer
+    }
+
+    // the oldest first, the local ids go down with the time
+    private fun collect(messages: List<MessageObject>): List<MessageObject> =
+        messages.filter { retryable(it) }.sortedWith(compareBy<MessageObject> { it.messageOwner.date }.thenByDescending { it.id })
+
+    @JvmStatic
+    fun fillMenu(type: Int, messages: List<MessageObject>, items: ArrayList<CharSequence>, icons: ArrayList<Int>, options: ArrayList<Int>) {
+        if (!TeleConfig.RETRY_ALL_FAILED.value || (type != 0 && type != 20)) return
+        // a single failed message has the stock retry
+        if (collect(messages).size < 2) return
+        val at = options.indexOf(ChatActivity.OPTION_RETRY).let { if (it >= 0) it + 1 else options.size }
+        items.add(at, TeleLowercase.lc(LocaleController.getString(R.string.TeleRetryAllFailed)))
+        icons.add(at, R.drawable.msg_retry)
+        options.add(at, ChatActivity.tele_option_retry_all)
+    }
+
+    @JvmStatic
+    fun retryAll(chat: ChatActivity, messages: List<MessageObject>, done: Runnable) {
+        val failed = collect(messages)
+        if (failed.isEmpty()) return
+        val account = chat.currentAccount
+        AlertsCreator.ensurePaidMessageConfirmation(account, chat.dialogId, failed.size) { payStars ->
+            val helper = SendMessagesHelper.getInstance(account)
+            var attempted = 0
+            var started = 0
+            for (message in failed) {
+                // it may have been retried or deleted while the confirmation was open
+                if (!retryable(message)) continue
+                attempted++
+                if (helper.retrySendMessage(message, false, payStars)) started++
+            }
+            if (started > 0) done.run()
+            if (started < attempted) {
+                BulletinFactory.of(chat).createSimpleBulletin(
+                    R.raw.error,
+                    LocaleController.formatString(R.string.TeleRetryAllPartial, started, attempted)
+                ).show()
+            }
+        }
+    }
+}
