             section(1123, "Reduce motion", "interface", TeleSettingsActivity.MODE_INTERFACE),
             section(1125, "No edited mark on bot messages", "interface", TeleSettingsActivity.MODE_INTERFACE),
+            section(1126, "Show the start parameter", "interface", TeleSettingsActivity.MODE_INTERFACE),
             section(1124, "Hide phone numbers in profiles", "privacy", TeleSettingsActivity.MODE_PRIVACY),
             section(GUID_UPDATES, "Update automatically", "updates", TeleSettingsActivity.MODE_ROOT),
             section(GUID_UPDATES + 1, "Check for updates", "updates", TeleSettingsActivity.MODE_ROOT),
