From: tangenx <me@tangenx.dev>
Date: Wed, 21 Oct 2026 23:27:45 +0300
Subject: [PATCH 117/143] feat: show the start parameter

---
 .../src/main/java/org/telegram/ui/ChatActivity.java   | 11 +++++++++++
 TMessagesProj/src/main/java/tele/TeleConfig.kt        |  2 ++
 .../src/main/java/tele/ui/settings/TeleSearch.kt      |  1 +
 .../java/tele/ui/settings/TeleSettingsActivity.kt     |  2 ++
 4 files changed, 16 insertions(+)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
index 3ce2e6969..e80cf12b6 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
@@ -8583,6 +8583,17 @@ public class ChatActivity extends BaseFragment implements
         bottomOverlayStartButton.setTypeface(AndroidUtilities.bold());
         bottomOverlayStartButton.setVisibility(View.INVISIBLE);
         bottomOverlayStartButton.setOnClickListener(v -> bottomOverlayChatText.callOnClick());
+        bottomOverlayStartButton.setOnLongClickListener(v -> {
+            if (!tele.TeleConfig.SHOW_START_PARAMETER.getValue()) {
+                return false;
+            }
+            String parameter = botUser;
+            if (parameter == null || parameter.isEmpty()) {
+                return false;
+            }
+            android.widget.Toast.makeText(getParentActivity(), "Start parameter: " + parameter, android.widget.Toast.LENGTH_SHORT).show();
+            return true;
+        });
         bottomOverlayStartButton.setPadding(dp(31), 0, dp(31), 0);
         ScaleStateListAnimator.apply(bottomOverlayStartButton, 0.02f, 1.2f);
         bottomChannelButtonsLayout.getContainer().addView(bottomOverlayStartButton, LayoutHelper.createFrame(LayoutHelper.WRAP_CONTENT, 38, Gravity.CENTER, 3, 3, 3, 3));
diff --git a/TMessagesProj/src/main/java/tele/TeleConfig.kt b/TMessagesProj/src/main/java/tele/TeleConfig.kt
index 75a95b391..b0e3b45fb 100644
