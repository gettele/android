diff --git a/TMessagesProj/src/main/java/tele/helpers/CodeLines.kt b/TMessagesProj/src/main/java/tele/helpers/CodeLines.kt
new file mode 100644
index 000000000..4f6f90aa9
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/CodeLines.kt
@@ -0,0 +1,94 @@
+package tele.helpers
+
+import android.graphics.Canvas
+import android.graphics.Paint
+import android.text.Layout
+import android.text.SpannableString
+import android.text.Spanned
+import android.text.TextPaint
+import android.text.style.LeadingMarginSpan
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.MessageObject
+import tele.TeleConfig
+import tele.TeleHooks
+import java.util.concurrent.atomic.AtomicInteger
+
+// line numbers in the code blocks of message bubbles (tele 0142): drawn as the leading margin of the block layout,
+// so the text, the selection and the bubble width follow the layout and the message text stays untouched
+object CodeLines {
+    // desktop numbers the blocks of five lines and more
+    private const val MIN_LINES = 5
+    private const val OPACITY = 0.4f
+
+    private val revision = AtomicInteger()
+
+    // layouts built under another revision are rebuilt, so the switch applies without a restart
+    @JvmStatic
+    fun revision(): Int = revision.get()
+
+    @JvmStatic
+    fun onToggled() {
+        revision.incrementAndGet()
+        TeleHooks.bumpUiRevision()
+    }
+
+    // the logical lines of the code, a break at the very start or end isn't a line
+    private fun countLines(text: CharSequence): Int {
+        var from = 0
+        var till = text.length
+        while (from < till && text[from] == '\n') from++
+        while (till > from && text[till - 1] == '\n') till--
+        if (from == till) return 0
+        var lines = 1
+        for (i in from until till) {
+            if (text[i] == '\n') lines++
+        }
+        return lines
+    }
+
+    // adds the numbers to the layout text of a code block; the layout is built right after
+    @JvmStatic
+    fun apply(text: SpannableString, paint: TextPaint, block: MessageObject.TextLayoutBlock) {
+        block.tele_gutter = 0
+        if (!TeleConfig.CODE_LINE_NUMBERS.value || !block.code || block.quote || text.isEmpty()) return
+        if (countLines(text) < MIN_LINES) return
+
+        val starts = ArrayList<Int>()
+        starts.add(0)
+        text.forEachIndexed { i, ch ->
+            if (ch == '\n') starts.add(i + 1)
+        }
+        val digits = starts.size.toString().length
+        val gap = AndroidUtilities.dp(8f)
+        val gutter = Math.ceil((paint.measureText("0") * digits).toDouble()).toInt() + gap
+        text.setSpan(NumberSpan(gutter, gap, starts.toIntArray()), 0, text.length, Spanned.SPAN_PARAGRAPH)
+        block.tele_gutter = gutter
+    }
+
+    private class NumberSpan(private val gutter: Int, private val gap: Int, private val starts: IntArray) : LeadingMarginSpan {
+        override fun getLeadingMargin(first: Boolean): Int = gutter
+
+        override fun drawLeadingMargin(
+            canvas: Canvas, paint: Paint, x: Int, dir: Int, top: Int, baseline: Int, bottom: Int,
+            text: CharSequence, start: Int, end: Int, first: Boolean, layout: Layout
+        ) {
+            // a wrapped line of a long one has no number, and neither has the empty line after a trailing break
+            if (!first || start >= text.length) return
+            val index = java.util.Arrays.binarySearch(starts, start)
+            if (index < 0) return
+            val alpha = paint.alpha
+            val align = paint.textAlign
+            paint.alpha = (alpha * OPACITY).toInt()
+            val label = (index + 1).toString()
+            if (dir > 0) {
+                paint.textAlign = Paint.Align.RIGHT
+                canvas.drawText(label, (x + gutter - gap).toFloat(), baseline.toFloat(), paint)
+            } else {
+                paint.textAlign = Paint.Align.LEFT
+                canvas.drawText(label, (x - gutter + gap).toFloat(), baseline.toFloat(), paint)
+            }
+            paint.textAlign = align
+            paint.alpha = alpha
+        }
+    }
+}
