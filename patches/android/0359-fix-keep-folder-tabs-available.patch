diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/MessagesController.java b/TMessagesProj/src/main/java/org/telegram/messenger/MessagesController.java
index be7bc3666..8e3da39c4 100644
--- a/TMessagesProj/src/main/java/org/telegram/messenger/MessagesController.java
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/MessagesController.java
@@ -2639,7 +2639,10 @@ public class MessagesController extends BaseController implements NotificationCe
         Collections.sort(dialogFilters, (o1, o2) -> Integer.compare(o1.order, o2.order));
         for (int a = 0; a < selectedDialogFilter.length; a++) {
             if (selectedDialogFilter[a] != null) {
-                selectedDialogFilter[a] = dialogFiltersById.get(selectedDialogFilter[a].id);
+                DialogFilter updated = dialogFiltersById.get(selectedDialogFilter[a].id);
+                if (updated != null) {
+                    selectedDialogFilter[a] = updated;
+                }
             }
         }
         lockFiltersInternal();
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/DialogsActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/DialogsActivity.java
index 1ab673094..3476d54c2 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/DialogsActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/DialogsActivity.java
@@ -6952,13 +6952,18 @@ public class DialogsActivity extends BaseFragment implements NotificationCenter.
         }
     }
 
+    private boolean tele_hasFolderTabs(ArrayList<MessagesController.DialogFilter> filters) {
+        return filters.size() > 1
+                || filters.size() == 1 && !filters.get(0).isDefault() && tele.TeleConfig.HIDE_ALL_CHATS_FOLDER.getValue();
+    }
+
     private void updateFolderSidebar() {
         if (folderSidebar == null || viewPages == null || viewPages.length == 0 || viewPages[0] == null) {
             return;
         }
         final ArrayList<MessagesController.DialogFilter> filters = getMessagesController().getDialogFilters();
         folderSidebarConfigEnabled = tele.ui.TeleFolderSidebar.enabled();
-        final boolean enabled = folderSidebarConfigEnabled && initialDialogsType == DIALOGS_TYPE_DEFAULT && !onlySelect && filters.size() > 1;
+        final boolean enabled = folderSidebarConfigEnabled && initialDialogsType == DIALOGS_TYPE_DEFAULT && !onlySelect && tele_hasFolderTabs(filters);
         final boolean changed = folderSidebarEnabled != enabled;
         folderSidebarEnabled = enabled;
         folderSidebar.setFolders(filters, currentAccount, viewPages[0].selectedType);
@@ -6979,7 +6984,7 @@ public class DialogsActivity extends BaseFragment implements NotificationCenter.
         }
         final ArrayList<MessagesController.DialogFilter> filters = getMessagesController().getDialogFilters();
         updateFolderSidebar();
-        if (filters.size() > 1) {
+        if (tele_hasFolderTabs(filters)) {
             if (force || !canShowFilterTabsView) {
                 boolean animatedUpdateItems = animated && canShowFilterTabsView;
                 canShowFilterTabsView = true;
