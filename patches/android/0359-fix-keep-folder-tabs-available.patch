+        val state = if (required) state(account) else null
+        if (required && state == null) return
         for (i in list.indices.reversed()) {
             val id = list[i].id
             if (isLocal(id)) {
@@ -254,16 +259,15 @@ object LocalFolders {
                 map.remove(id)
             }
