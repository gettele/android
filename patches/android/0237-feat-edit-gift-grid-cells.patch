+/**
+ * The catalog of the gifts, as the sheet of a purchased gift shows it: the cards of the gifts in a
+ * grid, with the search line. Only the gift itself is chosen here; the rest of the editor sets the
+ * parts, as the desktop grid does.
+ */
+class TeleGiftCatalogPicker(
+    context: Context,
+    resourcesProvider: Theme.ResourcesProvider?,
+    private val onPick: (String) -> Unit
+) : BottomSheet(context, true, resourcesProvider) {
+
+    private val adapter = Adapter()
+    private val all = ArrayList<String>()
+
+    init {
+        fixNavigationBar()
+        val root = LinearLayout(context)
+        root.orientation = LinearLayout.VERTICAL
+
+        val handle = View(context)
+        handle.background = Theme.createRoundRectDrawable(
+            AndroidUtilities.dp(2f),
+            Theme.multAlpha(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText4, resourcesProvider), 0.6f)
+        )
+        root.addView(handle, LayoutHelper.createLinear(36, 4, Gravity.CENTER_HORIZONTAL, 0, 8, 0, 0))
+
+        val title = TextView(context)
+        title.text = tele.helpers.TeleLowercase.lc("Choose a gift")
+        title.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 20f)
+        title.typeface = AndroidUtilities.bold()
+        title.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText, resourcesProvider))
+        root.addView(title, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT, Gravity.START, 20, 10, 20, 6))
+
+        val search = EditTextBoldCursor(context)
+        search.hint = org.telegram.messenger.LocaleController.getString(org.telegram.messenger.R.string.Search)
+        search.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16f)
+        search.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText, resourcesProvider))
+        search.setHintTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteHintText, resourcesProvider))
+        search.setCursorColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText, resourcesProvider))
+        search.setBackground(null)
+        search.setSingleLine(true)
+        search.setPadding(AndroidUtilities.dp(20f), 0, AndroidUtilities.dp(20f), 0)
+        search.addTextChangedListener(object : android.text.TextWatcher {
+            override fun beforeTextChanged(s: CharSequence?, start: Int, count: Int, after: Int) {}
+            override fun onTextChanged(s: CharSequence?, start: Int, before: Int, count: Int) {}
+            override fun afterTextChanged(s: android.text.Editable?) {
+                val query = s?.toString()?.trim()?.lowercase().orEmpty()
+                adapter.submit(if (query.isEmpty()) all else all.filter { it.lowercase().contains(query) })
+            }
+        })
+        root.addView(search, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, 44))
+
+        val list = RecyclerListView(context)
+        list.layoutManager = GridLayoutManager(context, 3)
+        list.adapter = adapter
+        list.setPadding(AndroidUtilities.dp(8f), AndroidUtilities.dp(4f), AndroidUtilities.dp(8f), AndroidUtilities.dp(8f))
+        list.setClipToPadding(false)
+        list.setOnItemClickListener(object : RecyclerListView.OnItemClickListener {
+            override fun onItemClick(view: View?, position: Int) {
+                val name = adapter.nameAt(position) ?: return
+                onPick(name)
+                dismiss()
+            }
+        })
+        root.addView(list, LinearLayout.LayoutParams(
+            LayoutHelper.MATCH_PARENT, (AndroidUtilities.displaySize.y * 0.62f).toInt()
+        ))
+
+        setCustomView(root)
+        GiftStudioCatalog.requestGiftNames { names ->
+            all.clear()
+            all.addAll(names)
+            adapter.submit(names)
+        }
+    }
+
+    private class Holder(view: View) : RecyclerView.ViewHolder(view)
+
+    private inner class Adapter : RecyclerView.Adapter<Holder>() {
+        private val rows = ArrayList<String>()
+
+        fun submit(names: List<String>) {
+            rows.clear()
+            rows.addAll(names)
+            notifyDataSetChanged()
+        }
+
+        fun nameAt(position: Int): String? = rows.getOrNull(position)
+
+        override fun getItemCount(): Int = rows.size
+
+        override fun onCreateViewHolder(parent: ViewGroup, viewType: Int): Holder {
+            return Holder(Cell(context))
+        }
+
+        override fun onBindViewHolder(holder: Holder, position: Int) {
+            (holder.itemView as Cell).bind(rows[position])
+        }
+    }
+
+    /** One card of the catalog: the picture of the gift and its name, as the gift sheet has it. */
+    private class Cell(context: Context) : LinearLayout(context) {
+        private val picture = ImageView(context)
+        private val name = TextView(context)
+
+        init {
+            orientation = VERTICAL
+            gravity = Gravity.CENTER_HORIZONTAL
+            picture.scaleType = ImageView.ScaleType.FIT_CENTER
+            picture.setPadding(AndroidUtilities.dp(10f), AndroidUtilities.dp(10f), AndroidUtilities.dp(10f), AndroidUtilities.dp(10f))
+            addView(picture, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, 0, 1f))
+            name.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 11f)
+            name.gravity = Gravity.CENTER
+            name.maxLines = 1
+            name.ellipsize = TextUtils.TruncateAt.END
+            name.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
+            addView(name, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT))
+            setPadding(AndroidUtilities.dp(4f), AndroidUtilities.dp(4f), AndroidUtilities.dp(4f), AndroidUtilities.dp(6f))
+        }
+
+        fun bind(gift: String) {
+            name.text = gift
+            picture.tag = gift
+            picture.setImageDrawable(null)
+            picture.background = GradientDrawable().apply {
+                cornerRadius = AndroidUtilities.dp(10f).toFloat()
+                setColor(0x14808080)
+            }
+            GiftStudioCatalog.giftPng(gift, 128) { bitmap ->
+                if (picture.tag == gift && bitmap != null) picture.setImageBitmap(bitmap)
+            }
+        }
+
+        override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
+            super.onMeasure(widthMeasureSpec, heightMeasureSpec)
+            val width = measuredWidth
+            picture.layoutParams.height = width - paddingLeft - paddingRight
+            super.onMeasure(widthMeasureSpec, heightMeasureSpec)
+        }
+    }
+}
