+    /** The marks of the grid cell: a pinned card and a gift hidden from the profile. */
+    private fun drawMarks(canvas: Canvas, scene: Scene) {
+        val card = scene.clip ?: return
+        if (hiddenMark) {
+            // the mark of the gift screen: the crossed eye on a dark circle, no veil over the card
+            paint.shader = null
+            paint.alpha = 255
+            val radius = card.width() * 0.13f
+            paint.color = 0xE6202832.toInt()
+            canvas.drawCircle(card.centerX(), card.centerY(), radius, paint)
+            val icon = hiddenDrawable ?: return
+            val size = (radius * 1.2f).toInt()
+            icon.setBounds(
+                (card.centerX() - size / 2f).toInt(), (card.centerY() - size / 2f).toInt(),
+                (card.centerX() + size / 2f).toInt(), (card.centerY() + size / 2f).toInt()
+            )
+            icon.draw(canvas)
+        }
+        if (pinnedMark) {
+            // the pin of the gift screen: the icon on a circle of the backdrop colour
+            val icon = pinnedDrawable ?: return
+            val size = (card.width() * 0.14f).toInt()
+            val pad = (card.width() * 0.04f).toInt()
+            val cx = card.left + pad + size / 2f
+            val cy = card.top + pad + size / 2f
+            val center = backdrop?.center ?: 0xFF6E7BD9.toInt()
+            paint.shader = null
+            paint.alpha = 255
+            paint.color = org.telegram.ui.ActionBar.Theme.adaptHSV(center or 0xFF000000.toInt(), 0.1f, -0.2f)
+            canvas.drawCircle(cx, cy, size * 0.62f, paint)
+            icon.setBounds(
+                (cx - size / 2f).toInt(), (cy - size / 2f).toInt(),
+                (cx + size / 2f).toInt(), (cy + size / 2f).toInt()
+            )
+            icon.draw(canvas)
+        }
+    }
+
+    private val pinnedDrawable: android.graphics.drawable.Drawable? by lazy {
+        androidx.core.content.ContextCompat.getDrawable(context, R.drawable.msg_limit_pin)?.mutate()
+    }
+    private val hiddenDrawable: android.graphics.drawable.Drawable? by lazy {
+        androidx.core.content.ContextCompat.getDrawable(context, R.drawable.mini_gift_hidden)?.mutate()
+    }
+
+    /** The badge of the desktop grid: the number or the text over the corner of the card. */
+    private fun drawBadge(canvas: Canvas, scene: Scene) {
+        val text = badgeText
+        if (text.isEmpty()) return
+        val card = scene.clip ?: return
+        val font = card.width() * 0.095f
+        ribbonTextPaint.textSize = font
+        ribbonTextPaint.color = badgeTextColor.takeIf { it != 0 } ?: Color.WHITE
+        val padding = font * 0.45f
+        val textWidth = ribbonTextPaint.measureText(text) + padding * 2f
+        val fontHeight = font * 1.2f
+        val skip = (textWidth / Math.sqrt(2.0)).toFloat()
+        val size = textWidth + fontHeight * 2f
+        val left = card.right - size
+        val top = card.top
+        val save = canvas.save()
+        canvas.clipPath(
+            Path().apply {
+                addRoundRect(card, scene.radius, scene.radius, Path.Direction.CW)
+            }
+        )
+        canvas.clipRect(left, top, left + size, top + size)
+        canvas.translate(left + size - skip, top)
+        canvas.rotate(45f)
+        val band = RectF(-textWidth * 5f, 0f, textWidth * 12f, fontHeight)
+        ribbonPaint.color = badgeEdge
+        canvas.drawRect(band, ribbonPaint)
+        if (badgePattern != 0) {
+            ribbonPaint.color = withAlpha(badgePattern, 0.5f)
+            canvas.drawRect(band, ribbonPaint)
+        }
+        canvas.drawText(text, padding, fontHeight * 0.78f, ribbonTextPaint)
+        canvas.restoreToCount(save)
+    }
