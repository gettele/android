+    /** The catalogue of the gifts, as the sheet of a purchased gift opens it. */
+    private fun pickGiftFromCatalog() {
+        TeleGiftCatalogPicker(context, resourcesProvider) { name ->
+            applyCollection(name)
+        }.show()
+    }
+
+    private fun applyCollection(name: String) {
+        title = name
+        modelName = ""
+        refresh()
+        GiftStudioCatalog.requestGift(name) { meta ->
+            if (meta == null) return@requestGift
+            giftId = meta.id
+            // the gift comes with the model of its own card, not a random one
+            GiftStudioCatalog.requestDefaultModel(name) { default ->
+                modelName = default ?: meta.models.firstOrNull()?.name ?: modelName
+                refresh()
+            }
+            if (backdropName.isEmpty() || centerColor == 0) {
+                val backdrop = meta.backdrops.firstOrNull()
+                backdropName = backdrop?.name ?: ""
+                centerColor = backdrop?.center ?: 0
+                edgeColor = backdrop?.edge ?: 0
+                patternColor = backdrop?.pattern ?: 0
+            }
+            if (symbolName.isEmpty()) {
+                symbolName = meta.symbols.firstOrNull()?.name ?: ""
+            }
+            refresh()
+        }
+    }
+
+    private fun pickCollection() {
+        GiftStudioCatalog.requestGiftNames { names ->
+            val rows = names.map { TeleStudioPartsList.Row(it, lc("catalog"), gift = it) }
+            val dialog = partsList.create(lc("Collection"), rows) { row ->
+                // the name is shown at once, the parts come from the catalog a moment later
+                title = row.name
+                refresh()
+                GiftStudioCatalog.requestGift(row.name) { meta ->
+                    if (meta == null) return@requestGift
+                    giftId = meta.id
+                    // the backdrop and the symbol stay as they were: the model belongs to the gift
+                    modelName = meta.models.firstOrNull()?.name ?: modelName
+                    if (backdropName.isEmpty() || centerColor == 0) {
+                        val backdrop = meta.backdrops.firstOrNull()
+                        backdropName = backdrop?.name ?: ""
+                        centerColor = backdrop?.center ?: 0
+                        edgeColor = backdrop?.edge ?: 0
+                        patternColor = backdrop?.pattern ?: 0
+                    }
+                    if (symbolName.isEmpty()) {
+                        symbolName = meta.symbols.firstOrNull()?.name ?: ""
+                    }
+                    refresh()
+                }
+            }
+            // the picker is its own window, so it stays above the sheet
+            dialog.show()
+        }
+    }
+
+    private fun pickModel() {
+        GiftStudioCatalog.requestGift(title) { meta ->
+            val rows = meta?.models.orEmpty().map {
+                TeleStudioPartsList.Row(it.name, title, GiftStudio.rarityText(it.permille), owner = title, model = it.name)
+            }
+            if (rows.isEmpty()) return@requestGift
+            partsList.create(lc("Model"), rows) { row ->
+                modelName = row.name
+                refresh()
+            }.also { it.show() }
+        }
+    }
+
+    private fun pickBackdrop() {
+        GiftStudioCatalog.requestGift(title) { meta ->
+            val rows = meta?.backdrops.orEmpty().map {
+                TeleStudioPartsList.Row(it.name, title, GiftStudio.rarityText(it.permille), backdrop = it)
+            }
+            if (rows.isEmpty()) return@requestGift
+            partsList.create(lc("Backdrop"), rows) { row ->
+                val found = meta?.backdrops?.firstOrNull { it.name == row.name }
+                backdropName = row.name
+                centerColor = found?.center ?: centerColor
+                edgeColor = found?.edge ?: edgeColor
+                patternColor = found?.pattern ?: patternColor
+                refresh()
+            }.also { it.show() }
+        }
+    }
+
+    private fun pickSymbol() {
+        GiftStudioCatalog.requestGift(title) { meta ->
+            val rows = meta?.symbols.orEmpty().map {
+                TeleStudioPartsList.Row(it.name, title, GiftStudio.rarityText(it.permille), owner = title, symbol = it.name)
+            }
+            if (rows.isEmpty()) return@requestGift
+            partsList.create(lc("Symbol"), rows) { row ->
+                symbolName = row.name
+                refresh()
+            }.also { it.show() }
+        }
+    }
+
+    private fun editNumber() {
