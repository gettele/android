+        input.setBackground(null)
+        input.setPadding(AndroidUtilities.dp(23f), 0, AndroidUtilities.dp(23f), 0)
+        val frame = FrameLayout(context)
+        frame.addView(input, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, 48f))
+        AlertDialog.Builder(context, resourcesProvider)
+            .setTitle(lc("Number"))
+            .setView(frame)
+            .setPositiveButton(LocaleController.getString(R.string.Done)) { _, _ ->
+                number = input.text.toString().toIntOrNull() ?: 0
+                refresh()
+            }
+            .setNegativeButton(LocaleController.getString(R.string.Cancel), null)
+            .show()
+    }
+
+    private fun chooseRibbon(unique: Boolean) {
+        val values = if (unique) {
+            arrayOf(Ribbon.AUTO, Ribbon.NONE, Ribbon.CUSTOM)
+        } else {
+            arrayOf(Ribbon.NONE, Ribbon.LIMITED, Ribbon.SOLD_OUT, Ribbon.CUSTOM)
+        }
+        val labels = if (unique) {
+            arrayOf(lc("number"), lc("none"), lc("custom text"))
+        } else {
+            arrayOf(lc("none"), lc("limited"), lc("sold out"), lc("custom text"))
+        }
+        AlertDialog.Builder(context, resourcesProvider)
+            .setTitle(lc("Ribbon"))
+            .setItems(labels) { _, which ->
+                ribbon = values[which]
+                if (ribbon == Ribbon.CUSTOM) editRibbonText() else refresh()
+            }
+            .setNegativeButton(LocaleController.getString(R.string.Cancel), null)
+            .show()
+    }
+
+    /** The colour of the ribbon: the stock picker of the app, as the desktop swatch opens it. */
+    private fun pickRibbonColor() {
+        val sheet = BottomSheet(context, true, resourcesProvider)
+        sheet.fixNavigationBar()
+        val root = LinearLayout(context)
+        root.orientation = LinearLayout.VERTICAL
+        val picker = org.telegram.ui.Components.ColorPicker(context, false) { color, _, _ ->
+            ribbonColor = color
+            refresh()
+        }
+        root.addView(picker, LinearLayout.LayoutParams(
+            LayoutHelper.MATCH_PARENT, (AndroidUtilities.displaySize.y * 0.45f).toInt()
+        ))
+        val reset = TextView(context)
+        reset.text = lc("Default colour")
+        reset.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15f)
+        reset.gravity = Gravity.CENTER
+        reset.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlueText, resourcesProvider))
+        reset.setPadding(0, AndroidUtilities.dp(12f), 0, AndroidUtilities.dp(12f))
+        reset.setOnClickListener {
+            ribbonColor = 0
+            refresh()
+            sheet.dismiss()
+        }
+        root.addView(reset, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT))
+        sheet.setCustomView(root)
+        sheet.show()
+    }
+
+    private fun editRibbonText() {
+        val input = EditTextBoldCursor(context)
+        input.setText(ribbonText)
+        input.setSelection(input.text.length)
+        input.inputType = InputType.TYPE_CLASS_TEXT
+        input.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 18f)
