+    /** The names of the gifts of the catalog, the newest release first. */
     @JvmStatic
     fun requestGiftNames(done: (List<String>) -> Unit) {
         fetchCached("gifts") { bytes ->
-            val result = ArrayList<String>()
+            val names = ArrayList<String>()
             runCatching {
                 val array = org.json.JSONArray(String(bytes, Charsets.UTF_8))
                 for (i in 0 until array.length()) {
                     val name = array.optString(i)
-                    if (name.isNotEmpty()) result.add(name)
+                    if (name.isNotEmpty()) names.add(name)
                 }
             }.onFailure { FileLog.e(it) }
-            done(result)
+            if (names.isEmpty()) {
+                done(names)
+                return@fetchCached
+            }
+            // the release dates order the list from the newest gift to the oldest
+            fetchCached("ids") { idsBytes ->
+                val idToName = HashMap<Long, String>()
+                runCatching {
+                    val json = JSONObject(String(idsBytes, Charsets.UTF_8))
+                    val keys = json.keys()
+                    while (keys.hasNext()) {
+                        val key = keys.next()
+                        val id = key.toLongOrNull() ?: continue
+                        val name = json.optString(key)
+                        if (name.isNotEmpty()) idToName[id] = name
+                    }
+                }.onFailure { FileLog.e(it) }
+                fetchCached("dates") { datesBytes ->
+                    val released = HashMap<String, Long>()
+                    runCatching {
+                        val array = org.json.JSONArray(String(datesBytes, Charsets.UTF_8))
+                        for (i in 0 until array.length()) {
+                            val item = array.optJSONObject(i) ?: continue
+                            val id = item.optString("id").toLongOrNull() ?: continue
+                            val name = idToName[id] ?: continue
+                            val date = item.optLong("releasedAt")
+                            if (date > 0) released[name] = date
+                        }
+                    }.onFailure { FileLog.e(it) }
+                    if (released.isEmpty()) {
+                        done(names)
+                    } else {
+                        done(names.sortedWith(
+                            compareByDescending<String> { released[it] ?: 0L }
+                                .thenBy { it.lowercase() }
+                        ))
+                    }
+                }
+            }
         }
     }
 
