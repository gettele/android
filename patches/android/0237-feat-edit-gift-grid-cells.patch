--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleGiftGridCellDialog.kt
@@ -0,0 +1,640 @@
+package tele.ui.settings
+
+import android.content.Context
+import android.text.InputType
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.View
+import android.widget.FrameLayout
+import android.widget.LinearLayout
+import android.widget.ScrollView
+import android.widget.TextView
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.R
+import org.telegram.ui.ActionBar.AlertDialog
+import org.telegram.ui.ActionBar.BottomSheet
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Cells.TextCheckCell
+import org.telegram.ui.Cells.TextSettingsCell
+import org.telegram.ui.Components.EditTextBoldCursor
+import org.telegram.ui.Components.LayoutHelper
+import tele.helpers.GiftGrid
+import tele.helpers.GiftGrid.Cell
+import tele.helpers.GiftGrid.Kind
+import tele.helpers.GiftGrid.Ribbon
+import tele.helpers.GiftStudio
+import tele.helpers.GiftStudioCatalog
+import tele.ui.TeleGiftPreview
+import tele.ui.TeleStudioPartsList
+
+/**
+ * The editor of a cell of the gift grid (desktop 0204, EditCellBox): a preview, the collectible
+ * section with the collection and its parts, the number and the ribbon, and the regular section
+ * with the gift, its ribbon and the price.
+ */
+class TeleGiftGridCellDialog(
+    private val context: Context,
+    private val account: Int,
+    private val resourcesProvider: Theme.ResourcesProvider?,
+    private val original: Cell,
+    private val onDone: (Cell) -> Unit,
+    private val onRemove: (() -> Unit)? = null
+) : BottomSheet(context, true, resourcesProvider) {
+
+    private var kind: Kind = if (original.kind == Kind.EMPTY) Kind.UNIQUE else original.kind
+    private var title: String = original.title
+    private var giftId: Long = original.giftId
+    private var modelName: String = original.modelName
+    private var backdropName: String = original.backdropName
+    private var symbolName: String = original.symbolName
+    private var centerColor: Int = original.centerColor
+    private var edgeColor: Int = original.edgeColor
+    private var patternColor: Int = original.patternColor
+    private var number: Int = original.number
+    private var ribbon: Ribbon = original.ribbon
+    private var ribbonText: String = original.ribbonText
+    private var ribbonColor: Int = original.ribbonColor
+    private var pinned: Boolean = original.pinned
+    private var price: Boolean = original.price
+    private var hidden: Boolean = original.hidden
+
+    private val preview = TeleGiftPreview(context, account, resourcesProvider).apply {
+        staticModel = true
+        setPlaying(false)
+        setLayout(TeleGiftPreview.Layout.Tile)
+    }
+    private val partsList by lazy { TeleStudioPartsList(context) }
+
+    private var collectionRow: TextSettingsCell? = null
+    private var modelRow: TextSettingsCell? = null
+    private var backdropRow: TextSettingsCell? = null
+    private var symbolRow: TextSettingsCell? = null
+    private var numberRow: TextSettingsCell? = null
+    private var ribbonRow: TextSettingsCell? = null
+    private var ribbonColorRow: TextSettingsCell? = null
+    private var regularColorRow: TextSettingsCell? = null
+    private var pinnedRow: TextCheckCell? = null
+    private var giftRow: TextSettingsCell? = null
+    private var priceRow: TextCheckCell? = null
+    private var regularRibbonRow: TextSettingsCell? = null
+    private var hiddenRow: TextCheckCell? = null
+    private class Snapshot(
+        val title: String, val giftId: Long, val modelName: String, val backdropName: String,
+        val symbolName: String, val centerColor: Int, val edgeColor: Int, val patternColor: Int,
+        val number: Int, val ribbon: Ribbon, val ribbonText: String, val ribbonColor: Int
+    )
+
+    private var uniqueSnapshot: Snapshot? = null
+    private var regularSnapshot: Snapshot? = null
+
+    private fun snapshot() = Snapshot(
+        title, giftId, modelName, backdropName, symbolName,
+        centerColor, edgeColor, patternColor, number, ribbon, ribbonText, ribbonColor
+    )
+
+    private fun restore(value: Snapshot) {
+        title = value.title
+        giftId = value.giftId
+        modelName = value.modelName
+        backdropName = value.backdropName
+        symbolName = value.symbolName
+        centerColor = value.centerColor
+        edgeColor = value.edgeColor
+        patternColor = value.patternColor
+        number = value.number
+        ribbon = value.ribbon
+        ribbonText = value.ribbonText
+        ribbonColor = value.ribbonColor
+    }
+
+    private fun clearDraft() {
+        title = ""
+        giftId = 0
+        modelName = ""
+        backdropName = ""
+        symbolName = ""
+        centerColor = 0
+        edgeColor = 0
+        patternColor = 0
+        number = 0
+        ribbon = Ribbon.AUTO
+        ribbonText = ""
+        ribbonColor = 0
+    }
+
+    private var uniqueBlock: LinearLayout? = null
+    private var regularBlock: LinearLayout? = null
+    private var uniqueTab: TextView? = null
+    private var regularTab: TextView? = null
+
+    init {
+        currentAccount = account
+        fixNavigationBar()
+        val root = LinearLayout(context)
+        root.orientation = LinearLayout.VERTICAL
+
+        // the handle of the modal, as the picker of files has it
+        val handle = View(context)
+        handle.background = Theme.createRoundRectDrawable(
+            AndroidUtilities.dp(2f),
+            Theme.multAlpha(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText4, resourcesProvider), 0.6f)
+        )
+        root.addView(handle, LayoutHelper.createLinear(36, 4, Gravity.CENTER_HORIZONTAL, 0, 8, 0, 0))
+
+        // the title of the modal, as the title of the app bar
+        val titleView = TextView(context)
+        titleView.text = lc("Edit gift")
+        titleView.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 20f)
+        titleView.typeface = AndroidUtilities.bold()
+        titleView.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText, resourcesProvider))
+        root.addView(titleView, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT, Gravity.START, 20, 10, 20, 6))
+
+        val previewHolder = FrameLayout(context)
+        val size = AndroidUtilities.dp(200f)
+        preview.view().layoutParams = FrameLayout.LayoutParams(size, size, Gravity.CENTER)
+        previewHolder.addView(preview.view())
+        root.addView(previewHolder, LinearLayout.LayoutParams(LinearLayout.LayoutParams.MATCH_PARENT, size + AndroidUtilities.dp(12f)))
+
+        val tabs = LinearLayout(context)
+        tabs.orientation = LinearLayout.HORIZONTAL
+        tabs.setPadding(AndroidUtilities.dp(12f), 0, AndroidUtilities.dp(12f), AndroidUtilities.dp(6f))
+        val uniqueTab = tab(context, "Collectible") { setKind(Kind.UNIQUE) }
+        val regularTab = tab(context, "Gift") { setKind(Kind.REGULAR) }
+        tabs.addView(uniqueTab, LayoutHelper.createLinear(0, 36, 1f, Gravity.CENTER_VERTICAL, 0, 0, 4, 0))
+        tabs.addView(regularTab, LayoutHelper.createLinear(0, 36, 1f, Gravity.CENTER_VERTICAL, 4, 0, 0, 0))
+        root.addView(tabs, LinearLayout.LayoutParams(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT))
+        this.uniqueTab = uniqueTab
+        this.regularTab = regularTab
+
+        val content = LinearLayout(context)
+        content.orientation = LinearLayout.VERTICAL
+
+        val unique = LinearLayout(context)
+        unique.orientation = LinearLayout.VERTICAL
+        uniqueBlock = unique
+        collectionRow = row(unique, "Collection") { pickCollection() }
+        modelRow = row(unique, "Model") { pickModel() }
+        backdropRow = row(unique, "Backdrop") { pickBackdrop() }
+        symbolRow = row(unique, "Symbol") { pickSymbol() }
+        numberRow = row(unique, "Number") { editNumber() }
+        ribbonRow = row(unique, "Ribbon") { chooseRibbon(unique = true) }
+        ribbonColorRow = row(unique, "Ribbon colour") { pickRibbonColor() }
+        pinnedRow = check(unique, "Pinned", pinned) { pinned = it; refresh() }
+        content.addView(unique, LinearLayout.LayoutParams(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT))
+
+        val regular = LinearLayout(context)
+        regular.orientation = LinearLayout.VERTICAL
+        regularBlock = regular
+        giftRow = row(regular, "Choose a gift") { pickGiftFromCatalog() }
+        priceRow = check(regular, "Show the price", price) { price = it; refresh() }
+        regularRibbonRow = row(regular, "Ribbon") { chooseRibbon(unique = false) }
+        regularColorRow = row(regular, "Ribbon colour") { pickRibbonColor() }
+        content.addView(regular, LinearLayout.LayoutParams(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT))
+
+        hiddenRow = check(content, "Hidden from the profile", hidden) { hidden = it; refresh() }
+
+
+        val done = TextView(context)
+        done.text = LocaleController.getString(R.string.Done)
+        done.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16f)
+        done.typeface = AndroidUtilities.bold()
+        done.gravity = Gravity.CENTER
+        done.setTextColor(Theme.getColor(Theme.key_featuredStickers_addButton, resourcesProvider))
+        done.background = Theme.createSimpleSelectorRoundRectDrawable(
+            AndroidUtilities.dp(8f),
+            Theme.multAlpha(Theme.getColor(Theme.key_featuredStickers_addButton, resourcesProvider), .12f),
+            Theme.multAlpha(Theme.getColor(Theme.key_featuredStickers_addButton, resourcesProvider), .24f)
+        )
+        done.setOnClickListener {
+            onDone(result())
+            dismiss()
+        }
+        if (!original.empty && onRemove != null) {
+            val remove = TextView(context)
+            remove.text = lc("Remove from the grid")
+            remove.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15f)
+            remove.gravity = Gravity.CENTER
+            remove.setTextColor(Theme.getColor(Theme.key_text_RedBold, resourcesProvider))
+            remove.setPadding(0, AndroidUtilities.dp(12f), 0, AndroidUtilities.dp(12f))
+            remove.setOnClickListener {
+                onRemove.invoke()
+                dismiss()
+            }
+            content.addView(remove, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT))
+        }
+        content.addView(done, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, 48, Gravity.CENTER, 16, 12, 16, 12))
+        root.addView(content, LinearLayout.LayoutParams(
+            LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT
+        ))
+
+        // the content scrolls both ways: a swipe must not be taken as the dismissal of the sheet
+        setCanDismissWithSwipe(false)
+        // the editor is taller than the screen, so its list is measured up to a limit and scrolls
+        val maxHeight = (AndroidUtilities.displaySize.y * 0.78f).toInt()
+        setCustomView(BoundedScrollView(context, maxHeight).also { scroll ->
+            scroll.addView(root, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT))
+        })
+        setKind(kind)
+        refresh()
+        if (original.empty) startFromLastCollection()
+    }
+
+    /** A free cell opens with the last collection, a random gift of it and the number one. */
+    private fun startFromLastCollection() {
+        val lastName = GiftGrid.lastCollection(account)
+        GiftStudioCatalog.requestGiftNames { names ->
+            val name = when {
+                lastName.isNotEmpty() && names.contains(lastName) -> lastName
+                else -> names.firstOrNull() ?: return@requestGiftNames
+            }
+            GiftStudioCatalog.requestGift(name) { meta ->
+                if (meta == null) return@requestGift
+                title = name
+                giftId = meta.id
+                modelName = meta.models.randomOrNull()?.name ?: ""
+                backdropName = meta.backdrops.randomOrNull()?.name ?: ""
+                symbolName = meta.symbols.randomOrNull()?.name ?: ""
+                val backdrop = meta.backdrops.firstOrNull { it.name == backdropName }
+                centerColor = backdrop?.center ?: 0
+                edgeColor = backdrop?.edge ?: 0
+                patternColor = backdrop?.pattern ?: 0
+                if (number == 0) number = 1
+                refresh()
+            }
+        }
+    }
+
+    private fun result(): Cell {
+        return Cell(
+            kind = kind,
+            giftId = giftId,
+            title = title,
+            number = number,
+            centerColor = centerColor,
+            edgeColor = edgeColor,
+            patternColor = patternColor,
+            stars = original.stars,
+            limited = original.limited,
+            soldOut = original.soldOut,
+            upgradable = original.upgradable,
+            modelName = modelName,
+            backdropName = backdropName,
+            symbolName = symbolName,
+            ribbon = ribbon,
+            ribbonText = ribbonText,
+            ribbonColor = ribbonColor,
+            // a regular gift has no pin: the mark belongs to the collectibles only
+            pinned = pinned && kind != Kind.REGULAR,
+            price = price,
+            hidden = hidden
+        )
+    }
+
+    private fun setKind(value: Kind) {
+        if (kind != value) {
+            if (kind == Kind.UNIQUE) uniqueSnapshot = snapshot() else regularSnapshot = snapshot()
+            val saved = if (value == Kind.UNIQUE) uniqueSnapshot else regularSnapshot
+            if (saved != null) restore(saved) else clearDraft()
+        }
+        kind = value
+        val unique = value != Kind.REGULAR
+        uniqueBlock?.visibility = if (unique) View.VISIBLE else View.GONE
+        regularBlock?.visibility = if (unique) View.GONE else View.VISIBLE
+        val blue = Theme.getColor(Theme.key_windowBackgroundWhiteBlueText, resourcesProvider)
+        val gray = Theme.getColor(Theme.key_windowBackgroundWhiteGrayText4, resourcesProvider)
+        val selected = Theme.multAlpha(blue, 0.12f)
+        uniqueTab?.apply {
+            setTextColor(if (unique) blue else gray)
+            background = if (unique) Theme.createRoundRectDrawable(AndroidUtilities.dp(8f), selected) else null
+        }
+        regularTab?.apply {
+            setTextColor(if (unique) gray else blue)
+            background = if (!unique) Theme.createRoundRectDrawable(AndroidUtilities.dp(8f), selected) else null
+        }
+        refresh()
+        if (value == Kind.UNIQUE && title.isEmpty() && original.empty) startFromLastCollection()
+    }
+
+    private fun tab(context: Context, text: String, action: () -> Unit): TextView {
+        val view = TextView(context)
+        view.text = text
+        view.gravity = Gravity.CENTER
+        view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15f)
+        view.typeface = AndroidUtilities.bold()
+        view.setOnClickListener { action() }
+        return view
+    }
+
+    private fun row(parent: LinearLayout, title: String, action: () -> Unit): TextSettingsCell {
+        val cell = TextSettingsCell(context)
+        cell.setText(lc(title), false)
+        cell.setOnClickListener { action() }
+        parent.addView(cell, LinearLayout.LayoutParams(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT))
+        return cell
+    }
+
+    private fun check(parent: LinearLayout, title: String, checked: Boolean, onChange: (Boolean) -> Unit): TextCheckCell {
+        val cell = TextCheckCell(context)
+        cell.setTextAndCheck(lc(title), checked, false)
+        cell.setOnClickListener {
+            cell.isChecked = !cell.isChecked
+            onChange(cell.isChecked)
+        }
+        parent.addView(cell, LinearLayout.LayoutParams(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT))
+        return cell
+    }
+
+    /** The rows and the preview follow the draft. */
+    private fun refresh() {
+        preview.setGift(title)
+        if (centerColor != 0) {
+            preview.setBackdrop(
+                GiftStudioCatalog.Backdrop(
+                    backdropName, 0,
+                    centerColor or 0xFF000000.toInt(),
+                    edgeColor or 0xFF000000.toInt(),
+                    patternColor or 0xFF000000.toInt(),
+                    0xFFFFFFFF.toInt()
+                )
+            )
+        } else {
+            preview.setBackdrop(null)
+        }
+        preview.setSymbol(if (symbolName.isEmpty()) null else GiftStudioCatalog.Part(symbolName, 0))
+        preview.setModel(if (modelName.isEmpty()) null else GiftStudioCatalog.Part(modelName, 0))
+        collectionRow?.setTextAndValue(lc("Collection"), title, false)
+        modelRow?.setTextAndValue(lc("Model"), modelName, false)
+        backdropRow?.setTextAndValue(lc("Backdrop"), backdropName, false)
+        symbolRow?.setTextAndValue(lc("Symbol"), symbolName, false)
+        numberRow?.setTextAndValue(lc("Number"), number.toString(), false)
+        ribbonRow?.setTextAndValue(lc("Ribbon"), ribbonName(ribbon), false)
+        val shownNumber = if (kind == Kind.UNIQUE) number else 0
+        preview.badgeText = GiftGrid.ribbonText(ribbon, ribbonText, shownNumber, original.limited, original.soldOut)
+        val unique = kind == Kind.UNIQUE
+        var effective = ribbon
+        if (effective == Ribbon.AUTO && !unique) {
+            effective = when {
+                original.soldOut -> Ribbon.SOLD_OUT
+                original.limited -> Ribbon.LIMITED
+                else -> Ribbon.NONE
+            }
+        }
+        val accent = GiftGrid.RIBBON_LIMITED
+        val warning = GiftGrid.RIBBON_SOLD_OUT
+        val onAccent = Theme.getColor(Theme.key_windowBackgroundWhite, resourcesProvider)
+        when {
+            ribbonColor != 0 -> {
+                preview.badgeEdge = ribbonColor
+                preview.badgePattern = 0
+                preview.badgeTextColor = 0xFFFFFFFF.toInt()
+            }
+            unique && effective != Ribbon.LIMITED && effective != Ribbon.SOLD_OUT -> {
+                preview.badgeEdge = edgeColor or 0xFF000000.toInt()
+                preview.badgePattern = patternColor or 0xFF000000.toInt()
+                preview.badgeTextColor = 0xFFFFFFFF.toInt()
+            }
+            effective == Ribbon.SOLD_OUT -> {
+                preview.badgeEdge = warning
+                preview.badgePattern = 0
+                preview.badgeTextColor = onAccent
+            }
+            else -> {
+                preview.badgeEdge = accent
+                preview.badgePattern = 0
+                preview.badgeTextColor = onAccent
+            }
+        }
+        preview.regularGift = kind == Kind.REGULAR
+        preview.pinnedMark = pinned
+        preview.hiddenMark = hidden
+        giftRow?.setTextAndValue(lc("Choose a gift"), title.ifEmpty { lc("nothing chosen") }, false)
+        regularRibbonRow?.setTextAndValue(lc("Ribbon"), ribbonName(ribbon), false)
+        val colorText = if (ribbonColor == 0) lc("default") else String.format("#%06X", 0xFFFFFF and ribbonColor)
+        ribbonColorRow?.setTextAndValue(lc("Ribbon colour"), colorText, false)
+        regularColorRow?.setTextAndValue(lc("Ribbon colour"), colorText, false)
+    }
+
+    private fun ribbonName(value: Ribbon): String = when (value) {
+        Ribbon.NONE -> lc("none")
+        Ribbon.CUSTOM -> ribbonText.ifEmpty { lc("custom text") }
+        Ribbon.LIMITED -> lc("limited")
+        Ribbon.SOLD_OUT -> lc("sold out")
+        Ribbon.AUTO -> if (number > 0) "#$number" else lc("number")
+    }
