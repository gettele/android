+    /** The unique gift of a rolled result, as the upgrade of the server would make it. */
+    @JvmStatic
+    fun buildUnique(base: TL_stars.StarGift?, result: Result): TL_stars.TL_starGiftUnique {
+        val unique = TL_stars.TL_starGiftUnique()
+        // the id of a real collectible is a long number: a fake one gets its own
+        unique.id = (1e18 + Random.nextDouble() * 8e18).toLong()
+        unique.gift_id = if (base != null && base.gift_id != 0L) base.gift_id else (base?.id ?: 0L)
+        unique.title = result.title.ifEmpty { base?.title ?: "" }
+        unique.num = result.number
+        // the quantity of the fake gift is its own number, so the info page shows the same value
+        unique.availability_issued = result.number
+        unique.availability_total = Math.max(base?.availability_total ?: 0, result.number)
+        unique.owner_id = org.telegram.messenger.MessagesController.getInstance(
+            org.telegram.messenger.UserConfig.selectedAccount
+        ).getPeer(
+            org.telegram.messenger.UserConfig.getInstance(
+                org.telegram.messenger.UserConfig.selectedAccount
+            ).clientUserId
+        )
+        unique.attributes = ArrayList<TL_stars.StarGiftAttribute>()
+        result.model?.let { unique.attributes.add(it) }
+        result.pattern?.let { unique.attributes.add(it) }
+        result.backdrop?.let { unique.attributes.add(it) }
+        return unique
+    }
