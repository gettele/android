+    @JvmStatic
+    fun viewStory(activity: Activity?, account: Int, dialogId: Long, storyId: Int) {
+        if (!isEnabled() || activity == null || storyId <= 0) return
+        val peer = MessagesController.getInstance(account).getInputPeer(dialogId)
+        if (peer == null) {
+            showError(activity, LocaleController.getString(org.telegram.messenger.R.string.TeleViewAsTlError))
+            return
+        }
+        val request = TL_stories.TL_stories_getStoriesByID()
+        request.peer = peer
+        request.id.add(storyId)
+        sendTlRequest(activity, account, request)
+    }
+
+    @JvmStatic
+    fun viewTopic(activity: Activity?, account: Int, dialogId: Long, topicId: Int) {
+        if (!isEnabled() || activity == null || topicId <= 0) return
+        val peer = MessagesController.getInstance(account).getInputPeer(dialogId)
+        if (peer == null) {
+            showError(activity, LocaleController.getString(org.telegram.messenger.R.string.TeleViewAsTlError))
+            return
+        }
+        val request = TL_forum.TL_messages_getForumTopicsByID()
+        request.peer = peer
+        request.topics.add(topicId)
+        sendTlRequest(activity, account, request)
+    }
+
+    @JvmStatic
+    fun viewDocument(activity: Activity?, document: TLRPC.Document?) {
+        if (!isEnabled() || activity == null || document == null) return
+        open(activity, document)
+    }
+
+    @JvmStatic
+    fun viewStickerSet(activity: Activity?, account: Int, set: TLRPC.StickerSet?) {
+        if (!isEnabled() || activity == null || set == null) return
+        val input = MediaDataController.getInputStickerSet(set)
+        if (input == null) {
+            showError(activity, LocaleController.getString(org.telegram.messenger.R.string.TeleViewAsTlError))
+            return
+        }
+        val request = TLRPC.TL_messages_getStickerSet()
+        request.stickerset = input
+        request.hash = 0
+        sendTlRequest(activity, account, request)
+    }
+
+    @JvmStatic
+    fun viewUniqueGift(activity: Activity?, account: Int, slug: String?) {
+        if (!isEnabled() || activity == null || slug.isNullOrEmpty()) return
+        val request = TL_stars.getUniqueStarGift()
+        request.slug = slug
+        sendTlRequest(activity, account, request)
+    }
+
+    @JvmStatic
+    fun viewSavedGift(activity: Activity?, account: Int, gift: TL_stars.InputSavedStarGift?) {
+        if (!isEnabled() || activity == null || gift == null) return
+        val request = TL_stars.getSavedStarGift()
+        request.stargift.add(gift)
+        sendTlRequest(activity, account, request)
+    }
+
+    @JvmStatic
+    fun viewFolder(activity: Activity?, account: Int, filterId: Int) {
+        if (!isEnabled() || activity == null) return
+        val request = TLRPC.TL_messages_getDialogFilters()
+        sendTlRequest(activity, account, request) { response ->
+            val filters = (response as? TLRPC.TL_messages_dialogFilters)?.filters
+                ?: return@sendTlRequest null
+            filters.firstOrNull {
+                if (filterId == 0) it is TLRPC.TL_dialogFilterDefault else it.id == filterId
+            }
+        }
+    }
+
+    private fun sendTlRequest(
+        activity: Activity,
+        account: Int,
+        request: TLObject,
+        extract: ((TLObject) -> TLObject?)? = null
+    ) {
+        ConnectionsManager.getInstance(account).sendRequest(request) { response, error ->
+            AndroidUtilities.runOnUIThread {
+                if (error != null) {
+                    TeleToast.log("viewastl-rpc3", error.text ?: "", account = account)
+                    Toast.makeText(activity, error.text ?: LocaleController.getString(org.telegram.messenger.R.string.TeleViewAsTlError), Toast.LENGTH_SHORT).show()
+                    return@runOnUIThread
+                }
+                val value = if (extract != null) response?.let(extract) else response
+                if (value == null) {
+                    showError(activity, LocaleController.getString(org.telegram.messenger.R.string.TeleViewAsTlError))
+                } else {
+                    open(activity, value)
+                }
+            }
+        }
+    }
