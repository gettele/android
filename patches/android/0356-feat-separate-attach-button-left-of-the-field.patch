+    private static final int TELE_ATTACH_SIZE = 56;
+    private static final int TELE_ATTACH_INSET = 47;
+
+    public void tele_setOuterAttachHost(ChatInputViewsContainer host, BlurredBackgroundDrawableViewFactory glassFactory, BlurredBackgroundColorProvider colorProvider) {
+        tele_attachHost = host;
+        tele_attachGlassFactory = glassFactory;
+        tele_attachGlassColorProvider = colorProvider;
+        tele_applyAttachPlacement();
+    }
+
+    private boolean tele_wantsOuterAttach() {
+        return tele.helpers.ComposerAttach.left() && isChat && attachButton != null && attachLayout != null && !isStories
+            && tele_attachHost != null && tele_attachGlassFactory != null && getParent() instanceof ViewGroup;
+    }
+
+    public boolean tele_attachButtonActive() {
+        return tele_attachOuterApplied;
+    }
+
+    private boolean tele_attachAllowed() {
+        if (editingMessageObject != null) {
+            return false;
+        }
+        if (recordingAudioVideo || recordInterfaceState != 0 || audioToSend != null || videoToSendMessageObject != null) {
+            return false;
+        }
+        return !(slowModeTimer > 0 && slowModeTimer != Integer.MAX_VALUE && !isSlowModeIgnored());
+    }
+
+    private void tele_pressAttachButton() {
+        if (adjustPanLayoutHelper != null && adjustPanLayoutHelper.animationInProgress() || attachLayoutPaddingAlpha == 0f) {
+            return;
+        }
+        if (delegate != null) {
+            delegate.didPressAttachButton();
+        }
+    }
+
+    private void tele_syncAttachButton(boolean animated) {
+        if (!tele_attachOuterApplied || tele_attachButton == null) {
+            return;
+        }
+        final boolean show = tele_attachAllowed() && getVisibility() == VISIBLE;
+        if (show == tele_attachButtonShown) {
+            return;
+        }
+        tele_attachButtonShown = show;
+        AndroidUtilities.updateViewVisibilityAnimated(tele_attachButton, show, 0.5f, true, animated);
+    }
+
+    private void tele_layoutOuterAttach() {
+        ViewGroup.LayoutParams params = getLayoutParams();
+        if (params instanceof ViewGroup.MarginLayoutParams) {
+            ViewGroup.MarginLayoutParams enterParams = (ViewGroup.MarginLayoutParams) params;
+            if (tele_attachBaseLeftMargin < 0) {
+                tele_attachBaseLeftMargin = enterParams.leftMargin;
+            }
+            final int target = tele_attachBaseLeftMargin + (tele_attachOuterApplied ? dp(TELE_ATTACH_INSET) : 0);
+            if (enterParams.leftMargin != target) {
+                enterParams.leftMargin = target;
+                setLayoutParams(enterParams);
+            }
+        }
+        if (tele_attachHost != null) {
+            tele_attachHost.tele_setAttachInsetLeft(tele_attachOuterApplied ? dp(TELE_ATTACH_INSET) : 0);
+        }
+    }
+
+    public void tele_applyAttachPlacement() {
+        if (attachButton == null || attachLayout == null) {
+            return;
+        }
+        final boolean outer = tele_wantsOuterAttach();
+        if (sideButtons != null) {
+            sideButtons.tele_attachButtonEnabled = !outer;
+            if (outer) {
+                sideButtons.showButton(ChatActivitySideControlsButtonsLayout.BUTTON_ATTACH, false, false);
+            }
+        }
+        if (tele_attachOuterApplied == outer) {
+            return;
+        }
+        tele_attachOuterApplied = outer;
+        if (outer && tele_attachButton == null) {
+            tele_attachButton = ChatActivityBlurredRoundPageDownButton.create(getContext(), TELE_ATTACH_SIZE, 32, resourcesProvider, tele_attachGlassFactory, tele_attachGlassColorProvider, R.drawable.msg_input_attach2);
+            tele_attachButton.setContentDescription(getString(R.string.AccDescrAttachButton));
+            tele_attachButton.setOnClickListener(v -> tele_pressAttachButton());
+        }
+        attachButton.setVisibility(outer ? GONE : VISIBLE);
+        FrameLayout.LayoutParams attachLayoutParams = (FrameLayout.LayoutParams) attachLayout.getLayoutParams();
+        attachLayoutParams.rightMargin = outer ? 0 : DEFAULT_HEIGHT;
+        attachLayout.setLayoutParams(attachLayoutParams);
+        if (tele_attachButton != null) {
+            tele_attachButtonShown = false;
+            AndroidUtilities.updateViewVisibilityAnimated(tele_attachButton, false, 0.5f, true, false);
+        }
+        if (scheduledButton != null) {
+            scheduledButton.setTranslationX(scheduledButton.getTranslationX());
+        }
+        updateFieldRight(lastAttachVisible);
+        tele_layoutOuterAttach();
+        if (tele_attachButton != null && tele_attachButton.getParent() == null && getParent() instanceof ViewGroup) {
+            ((ViewGroup) getParent()).addView(tele_attachButton, 0, LayoutHelper.createFrame(TELE_ATTACH_SIZE, TELE_ATTACH_SIZE, Gravity.LEFT | Gravity.BOTTOM, 0, 0, 0, -6));
+        }
+        if (outer) {
+            tele_syncAttachButton(false);
+            if (getVisibility() == VISIBLE && delegate != null) {
+                delegate.onAttachButtonShow();
+            }
+        } else {
+            checkSendButton(false);
+        }
+        requestLayout();
+    }
+
