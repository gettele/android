@@ -0,0 +1,23 @@
+package tele.helpers
+
+import org.telegram.ui.Components.ChatActivityEnterView
+import tele.TeleConfig
+import java.util.Collections
+import java.util.WeakHashMap
+
+object ComposerAttach {
+    private val views = Collections.newSetFromMap(WeakHashMap<ChatActivityEnterView, Boolean>())
+
+    @JvmStatic
+    fun left(): Boolean = TeleConfig.ATTACH_BUTTON_LEFT.value
+
+    @JvmStatic
+    fun register(view: ChatActivityEnterView) {
+        views.add(view)
+    }
+
+    @JvmStatic
+    fun onToggled() {
+        for (view in ArrayList(views)) view.tele_applyAttachPlacement()
+    }
+}
