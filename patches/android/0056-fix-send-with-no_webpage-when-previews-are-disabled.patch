From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Mon, 5 Oct 2026 22:43:35 +0300
Subject: [PATCH] fix: send with no_webpage when previews are disabled

The panel gate only muted the preview search; the send path reads the
messageWebPageSearch field directly, which stock resets to true on big
text changes, so the request went out without no_webpage and the server
attached the preview to the outgoing message. Both the reset and the
send params now respect the toggle.

Confidence: high
Scope-risk: narrow
---
 .../org/telegram/ui/Components/ChatActivityEnterView.java     | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Components/ChatActivityEnterView.java b/TMessagesProj/src/main/java/org/telegram/ui/Components/ChatActivityEnterView.java
index 99232d097..f960a7694 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Components/ChatActivityEnterView.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Components/ChatActivityEnterView.java
@@ -5961,7 +5961,7 @@ public class ChatActivityEnterView extends FrameLayout implements
                 if (delegate != null) {
                     if (!ignoreTextChange) {
                         if (before > count + 1 || (count - before) > 2 || TextUtils.isEmpty(charSequence)) {
-                            messageWebPageSearch = true;
+                            messageWebPageSearch = !tele.TeleConfig.NO_LINK_PREVIEWS.getValue();
                         }
                         delegate.onTextChanged(charSequence, before > count + 1 || (count - before) > 2, false);
                     }
@@ -7859,7 +7859,7 @@ public class ChatActivityEnterView extends FrameLayout implements
                 if (replyToTopMsg == null && replyingTopMessage != null) {
                     replyToTopMsg = replyingTopMessage;
                 }
-                SendMessagesHelper.SendMessageParams params = SendMessagesHelper.SendMessageParams.of(message[0].toString(), dialog_id, replyingMessageObject, replyToTopMsg, messageWebPage, messageWebPageSearch, entities, null, null, notify, scheduleDate, scheduleRepeatPeriod, sendAnimationData, updateStickersOrder);
+                SendMessagesHelper.SendMessageParams params = SendMessagesHelper.SendMessageParams.of(message[0].toString(), dialog_id, replyingMessageObject, replyToTopMsg, messageWebPage, messageWebPageSearch && !tele.TeleConfig.NO_LINK_PREVIEWS.getValue(), entities, null, null, notify, scheduleDate, scheduleRepeatPeriod, sendAnimationData, updateStickersOrder);
                 params.sendMessageChatArguments = parentFragment != null ? parentFragment.getMessageChatSendParams() : null;
                 params.effect_id = effectId;
                 params.payStars = payStars;
