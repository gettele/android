@@ -43,6 +43,7 @@ class TeleMiniAppFragment(args: Bundle) : BaseFragment(args), MainTabsActivity.T
 
     private val account = args.getInt("account", UserConfig.selectedAccount)
     private val botId = args.getLong("bot_id")
+    private val botHash = args.getLong("bot_hash")
     private val mainTabsInset = if (args.getBoolean("hasMainTabs", false)) AndroidUtilities.dp(DialogsActivity.MAIN_TABS_HEIGHT_WITH_MARGINS.toFloat()) else 0
 
