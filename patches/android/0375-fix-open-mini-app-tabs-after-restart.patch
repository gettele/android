@@ -277,11 +278,13 @@ class TeleMiniAppFragment(args: Bundle) : BaseFragment(args), MainTabsActivity.T
 
     override fun onFragmentCreate(): Boolean {
         NotificationCenter.getInstance(account).addObserver(this, NotificationCenter.webViewResultSent)
+        NotificationCenter.getInstance(account).addObserver(this, NotificationCenter.updateInterfaces)
         return super.onFragmentCreate()
