     override fun onFragmentDestroy() {
         NotificationCenter.getInstance(account).removeObserver(this, NotificationCenter.webViewResultSent)
+        NotificationCenter.getInstance(account).removeObserver(this, NotificationCenter.updateInterfaces)
         AndroidUtilities.cancelRunOnUIThread(pollRunnable)
         queryId = 0L
         container?.destroyWebView()
@@ -300,6 +303,17 @@ class TeleMiniAppFragment(args: Bundle) : BaseFragment(args), MainTabsActivity.T
                 AndroidUtilities.cancelRunOnUIThread(pollRunnable)
                 closeToChats()
             }
+        } else if (id == NotificationCenter.updateInterfaces && (args.firstOrNull() as? Int ?: 0) and MessagesController.UPDATE_MASK_STATUS != 0) {
+            // reloadUser may land after the attach-bots callback; retry once the user is cached
+            val web = container ?: return
+            if (opening || web.getUrlLoaded() != null || !loadingBots) return
+            val user = MessagesController.getInstance(account).getUser(botId) ?: return
+            loadingBots = false
+            if (user.bot) {
+                startMiniApp()
+            } else {
+                showPlaceholder(R.string.TeleMiniAppUnsupported)
+            }
         }
     }
 
@@ -351,22 +365,46 @@ class TeleMiniAppFragment(args: Bundle) : BaseFragment(args), MainTabsActivity.T
         }
         showPlaceholder(R.string.TeleMiniAppOpenFailed)
         loadingBots = true
-        MessagesController.getInstance(account).reloadUser(botId)
+        reloadBot()
         MediaDataController.getInstance(account).loadAttachMenuBots(false, true) {
-            loadingBots = false
             if (container == null || fragmentView == null || container?.getUrlLoaded() != null) {
+                loadingBots = false
                 return@loadAttachMenuBots
             }
             val loaded = findAttachBot(account, botId)
             val loadedUser = MessagesController.getInstance(account).getUser(botId)
             when {
-                loaded != null -> openBot(loaded)
-                loadedUser != null && loadedUser.bot -> openWebApp()
-                else -> showPlaceholder(R.string.TeleMiniAppUnsupported)
+                loaded != null -> { loadingBots = false; openBot(loaded) }
+                loadedUser != null && loadedUser.bot -> { loadingBots = false; openWebApp() }
+                loadedUser != null -> { loadingBots = false; showPlaceholder(R.string.TeleMiniAppUnsupported) }
+                // user still loading; the updateInterfaces observer retries
             }
         }
     }
 
+    private fun reloadBot() {
+        val controller = MessagesController.getInstance(account)
+        if (controller.getUser(botId) == null && botHash != 0L) {
+            // after restart the bot is not cached; the stored hash makes the lookup valid
+            val input = TLRPC.TL_inputUser()
+            input.user_id = botId
+            input.access_hash = botHash
+            val request = TLRPC.TL_users_getUsers()
+            request.id.add(input)
+            ConnectionsManager.getInstance(account).sendRequest(request, { response, _ ->
+                if (response is org.telegram.tgnet.Vector<*>) {
+                    val users = ArrayList<TLRPC.User>()
+                    for (obj in response.objects) {
+                        if (obj is TLRPC.User) users.add(obj)
+                    }
+                    controller.putUsers(users, false)
+                }
+            })
+        } else {
+            controller.reloadUser(botId)
+        }
+    }
+
     private fun openBot(bot: TLRPC.TL_attachMenuBot) {
         actionBar?.setTitle(title(account, botId))
         if (bot.inactive || bot.side_menu_disclaimer_needed) {
@@ -404,6 +442,11 @@ class TeleMiniAppFragment(args: Bundle) : BaseFragment(args), MainTabsActivity.T
     }
 
     private fun openWebApp() {
+        openWebApp(0)
+    }
+
+    // 0 = main app, 1 = simple webview, 2 = default named app
+    private fun openWebApp(stage: Int) {
         val web = container ?: return
         if (opening || web.getUrlLoaded() != null) {
             return
@@ -423,11 +466,16 @@ class TeleMiniAppFragment(args: Bundle) : BaseFragment(args), MainTabsActivity.T
         val themeParams = BotWebViewSheet.makeThemeParams(resourceProvider)?.let { params ->
             TLRPC.TL_dataJSON().also { it.data = params.toString() }
         }
-        if (sideMenu) {
+        if (!sideMenu && stage >= 2) {
+            opening = false
+            openNamedApp(themeParams)
+            return
+        }
+        if (sideMenu || stage == 1) {
             val simple = TLRPC.TL_messages_requestSimpleWebView()
             simple.bot = MessagesController.getInstance(account).getInputUser(botId)
             simple.platform = "android"
-            simple.from_side_menu = true
+            simple.from_side_menu = sideMenu
             simple.compact = false
             simple.fullscreen = false
             if (themeParams != null) {
@@ -455,10 +503,20 @@ class TeleMiniAppFragment(args: Bundle) : BaseFragment(args), MainTabsActivity.T
         }
         ConnectionsManager.getInstance(account).sendRequest(request, { response, error ->
             AndroidUtilities.runOnUIThread {
-                if (container == null || fragmentView == null || error != null || response == null) {
+                if (container == null || fragmentView == null) {
                     opening = false
                     started = false
-                    showPlaceholder(R.string.TeleMiniAppOpenFailed)
+                    return@runOnUIThread
+                }
+                if (error != null || response == null) {
+                    opening = false
+                    started = false
+                    if (!sideMenu && stage < 2 && error != null && error.text != null &&
+                        (error.text.startsWith("BOT_") || error.text == "URL_INVALID")) {
+                        openWebApp(stage + 1)
+                    } else {
+                        showPlaceholder(R.string.TeleMiniAppOpenFailed)
+                    }
                     return@runOnUIThread
                 }
                 val url: String?
@@ -492,6 +550,62 @@ class TeleMiniAppFragment(args: Bundle) : BaseFragment(args), MainTabsActivity.T
         }, requestFlags)
     }
 
+    private fun openNamedApp(themeParams: TLRPC.TL_dataJSON?) {
+        val app = TLRPC.TL_inputBotAppShortName()
+        app.bot_id = MessagesController.getInstance(account).getInputUser(botId)
+        app.short_name = ""
+        val get = TLRPC.TL_messages_getBotApp()
+        get.app = app
+        get.hash = 0
+        ConnectionsManager.getInstance(account).sendRequest(get, { response, error ->
+            AndroidUtilities.runOnUIThread {
+                if (container == null || fragmentView == null) {
+                    return@runOnUIThread
+                }
+                val botApp = (response as? TLRPC.TL_messages_botApp)?.app
+                if (error != null || botApp == null) {
+                    showPlaceholder(if (error?.text == "BOT_APP_SHORTNAME_INVALID") R.string.TeleMiniAppUnsupported else R.string.TeleMiniAppOpenFailed)
+                    return@runOnUIThread
+                }
+                openApp(botApp, themeParams)
+            }
+        }, ConnectionsManager.RequestFlagFailOnServerErrors)
+    }
+
+    private fun openApp(botApp: TLRPC.BotApp, themeParams: TLRPC.TL_dataJSON?) {
+        val request = TLRPC.TL_messages_requestAppWebView()
+        val app = TLRPC.TL_inputBotAppID()
+        app.id = botApp.id
+        app.access_hash = botApp.access_hash
+        request.app = app
+        request.peer = MessagesController.getInstance(account).getInputPeer(botId)
+        request.platform = "android"
+        request.write_allowed = true
+        request.compact = false
+        request.fullscreen = false
+        if (themeParams != null) {
+            request.theme_params = themeParams
+            request.flags = request.flags or 4
+        }
+        ConnectionsManager.getInstance(account).sendRequest(request, { response, error ->
+            AndroidUtilities.runOnUIThread {
+                val url = (response as? TLRPC.TL_webViewResultUrl)?.url
+                if (container == null || fragmentView == null || error != null || url.isNullOrEmpty()) {
+                    showPlaceholder(R.string.TeleMiniAppOpenFailed)
+                    return@runOnUIThread
+                }
+                queryId = (response as TLRPC.TL_webViewResultUrl).query_id
+                placeholder?.visibility = View.GONE
+                container?.loadUrl(account, url, response.same_origin)
+                MediaDataController.getInstance(account).increaseWebappRating(botId)
+                if (queryId != 0L) {
+                    AndroidUtilities.cancelRunOnUIThread(pollRunnable)
+                    AndroidUtilities.runOnUIThread(pollRunnable, POLL_PERIOD)
+                }
+            }
+        }, ConnectionsManager.RequestFlagInvokeAfter or ConnectionsManager.RequestFlagFailOnServerErrors)
+    }
+
     private fun showPlaceholder(resId: Int) {
         placeholder?.text = TeleLowercase.lc(LocaleController.getString(resId))
         placeholder?.visibility = View.VISIBLE
