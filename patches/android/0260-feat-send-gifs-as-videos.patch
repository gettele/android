+    /** A gif or silent video that should go out as a video; the viewer edits it before the send. */
+    @JvmStatic
+    fun addVideo(fragment: ChatActivity, path: String, info: VideoEditedInfo): Boolean {
+        if (!enabled() || fragment.chatActivityEnterView == null || fragment.chatMode != ChatActivity.MODE_DEFAULT) return false
+        if (fragment.messagesController.getSendPaidMessagesStars(fragment.dialogId) != 0L) return false
+        val file = File(path)
+        if (file.length() <= 1) return false
+        if (info.estimatedSize < file.length()) info.estimatedSize = file.length()
+        val key = keyOf(fragment)
+        ensureLoaded(key.account)
+        val tray = trays.getOrPut(key) { Tray() }
+        if (tray.items.isEmpty()) tray.date = (System.currentTimeMillis() / 1000L).toInt()
+        val entry = MediaController.PhotoEntry(0, 0, 0, path, (info.estimatedDuration / 1000L).toInt(), true, info.resultWidth, info.resultHeight, file.length())
+        entry.editedInfo = info
+        val item = snapshot(entry, false)
+        item.asVideo = true
+        tray.items.add(item)
+        changed(key)
+        openViewer(fragment, key, tray.items.size - 1, true)
+        return true
+    }
