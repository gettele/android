+package tele.ui.settings
+
+import android.content.Context
+import android.view.View
+import android.widget.FrameLayout
+import org.telegram.ui.Components.LayoutHelper
+import org.telegram.ui.Components.RecyclerListView
+import org.telegram.ui.Components.UItem
+import org.telegram.ui.Components.UniversalAdapter
+import org.telegram.ui.Components.UniversalRecyclerView
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Gifts.GiftSheet
+import tele.helpers.GiftGrid
+import tele.helpers.GiftGrid.Cell
+
+/** The view that shows one cell of the grid. It wraps a GiftSheet.GiftCell. */
+class GiftGridCellView(
+    context: Context,
+    currentAccount: Int,
+    resourcesProvider: Theme.ResourcesProvider?
+) : FrameLayout(context) {
+
+    private val giftCell = GiftSheet.GiftCell(context, currentAccount, resourcesProvider)
+
+    init {
+        addView(giftCell, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.MATCH_PARENT))
+        setClickable(true)
+    }
+
+    /** The card of the cell, so the export can draw it. */
+    fun card(): GiftSheet.GiftCell = giftCell
+
+    fun bind(cell: Cell) {
+        val gift = cell.gift ?: return
+        giftCell.setStarsGift(gift, cell.unique, false, false, false, false)
+    }
+}
+
+/** The item of one cell of the gift grid. */
+class GiftGridCellFactory : UItem.UItemFactory<GiftGridCellView>() {
+
+    override fun createView(
+        context: Context,
+        listView: RecyclerListView?,
+        currentAccount: Int,
+        classGuid: Int,
+        resourcesProvider: Theme.ResourcesProvider?
+    ): GiftGridCellView = GiftGridCellView(context, currentAccount, resourcesProvider)
+
+    override fun bindView(
+        view: View,
+        item: UItem,
+        divider: Boolean,
+        adapter: UniversalAdapter,
+        listView: UniversalRecyclerView
+    ) {
+        (view as GiftGridCellView).bind(item.`object` as Cell)
+    }
+
+    override fun equals(a: UItem, b: UItem): Boolean = contentsEquals(a, b)
+
+    override fun contentsEquals(a: UItem, b: UItem): Boolean {
+        val first = a.`object` as? Cell ?: return false
+        val second = b.`object` as? Cell ?: return false
+        return first.giftId == second.giftId && first.gift === second.gift
+    }
+
+    companion object {
+        init {
+            UItem.UItemFactory.setup(GiftGridCellFactory())
+        }
+
+        @JvmStatic
+        fun asCell(cell: Cell): UItem {
+            val item = UItem.ofFactory(GiftGridCellFactory::class.java)
+            item.spanCount = 1
+            item.`object` = cell
+            return item
+        }
+    }
+}
