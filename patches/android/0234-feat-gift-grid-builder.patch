+package tele.ui.settings
+
+import android.content.Context
+import android.view.View
+import android.widget.FrameLayout
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.R
+import org.telegram.ui.ActionBar.ActionBar
+import org.telegram.ui.ActionBar.BaseFragment
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Components.ItemOptions
+import org.telegram.ui.Components.LayoutHelper
+import org.telegram.ui.Components.UItem
+import org.telegram.ui.Components.UniversalAdapter
+import org.telegram.ui.Components.UniversalRecyclerView
+import tele.helpers.GiftGrid
+import tele.helpers.GiftGrid.Layout
+
+/** The gift grid of the studio: a table of three columns that holds gifts. */
+class TeleGiftGridActivity : BaseFragment() {
+
+    private var recycler: UniversalRecyclerView? = null
+    private var layout: Layout = Layout()
+
+    private fun reload() {
+        layout = GiftGrid.load(currentAccount)
+        recycler?.adapter?.update(true)
+    }
+
+    private fun fillItems(items: ArrayList<UItem>, adapter: UniversalAdapter) {
+        val rows = layout.rowCount()
+        for (i in 0 until rows) {
+            for (j in 0 until GiftGrid.COLUMNS) {
+                val cell = layout.cell(i * GiftGrid.COLUMNS + j) ?: continue
+                items.add(GiftGridCellFactory.asCell(cell))
+            }
+        }
+    }
+
+    override fun onFragmentCreate(): Boolean {
+        reload()
+        return super.onFragmentCreate()
+    }
+
+    override fun createView(context: Context): View {
+        val frameLayout = FrameLayout(context)
+        frameLayout.setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundGray))
+        fragmentView = frameLayout
+
+        actionBar.setBackButtonImage(R.drawable.ic_ab_back)
+        actionBar.setAllowOverlayTitle(true)
+        actionBar.setTitle(lc("Gift grid"))
+        actionBar.setActionBarMenuOnItemClick(object : ActionBar.ActionBarMenuOnItemClick() {
+            override fun onItemClick(id: Int) {
+                when (id) {
+                    GiftGrid.ID_EXPORT_PNG -> TeleGiftGridExport.export(this@TeleGiftGridActivity, layout)
+                    GiftGrid.ID_ADD_ROW -> {
+                        if (layout.addRow()) {
+                            GiftGrid.save(currentAccount, layout)
+                            recycler?.adapter?.update(true)
+                        }
+                    }
+                }
+            }
+        })
+
+        val menu = actionBar.createMenu()
+        menu.addItem(GiftGrid.ID_ADD_ROW, R.drawable.filled_add_album).setText(lc("Add row"))
+        menu.addItem(GiftGrid.ID_EXPORT_PNG, R.drawable.filled_share).setText(lc("Save picture"))
+
+        val recycler = UniversalRecyclerView(
+            context,
+            currentAccount,
+            0,
+            false,
+            this::fillItems,
+            { item, view, position, x, y -> onItemClick(item, view, position) },
+            null,
+            resourceProvider,
+            GiftGrid.COLUMNS,
+            1
+        )
+        this.recycler = recycler
+        recycler.setSelectorType(9)
+        recycler.setSelectorDrawableColor(0)
+        recycler.setClipToPadding(false)
+        recycler.setPadding(AndroidUtilities.dp(9f), 0, AndroidUtilities.dp(9f), 0)
+        frameLayout.addView(recycler, LayoutHelper.createFrame(
+            LayoutHelper.MATCH_PARENT,
+            LayoutHelper.MATCH_PARENT
+        ))
+        return fragmentView
+    }
+
+    /** A tap on a cell of the grid offers to take the gift out of the grid. */
+    private fun onItemClick(item: UItem, view: View?, position: Int) {
+        val cell = item.`object` as? GiftGrid.Cell ?: return
+        if (cell.empty) return
+        val scrim = view ?: return
+        val options = ItemOptions.makeOptions(parentActivity ?: return, resourceProvider, scrim)
+        options.add(lc("Remove from the grid")) {
+            layout.removeCell(position)
+            GiftGrid.save(currentAccount, layout)
+            recycler?.adapter?.update(true)
+        }
+        options.show()
+    }
+
+    override fun onFragmentDestroy() {
+        super.onFragmentDestroy()
+        recycler = null
+    }
+}
+
+private fun lc(s: String) = tele.helpers.TeleLowercase.lc(s)
