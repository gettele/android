+package tele.helpers
+
+import org.json.JSONArray
+import org.json.JSONObject
+import org.telegram.messenger.UserConfig
+import org.telegram.tgnet.tl.TL_stars
+import org.telegram.ui.Stars.StarsController
+import tele.db.TeleDatabaseHelper
+
+/**
+ * The gift grid of the studio (desktop 0204): a table of three columns that holds gifts and can be
+ * exported as a picture.
+ *
+ * The model is a [Layout] of rows: every row holds [COLUMNS] cells and every cell is empty or holds
+ * one gift. The layout is kept on this device as JSON, so it survives a restart; the gifts
+ * themselves are found again by their ids, only their numbers and colors are stored.
+ */
+object GiftGrid {
+
+    /** The desktop grid has three columns. */
+    const val COLUMNS = 3
+
+    /** The desktop grid stops at fifty rows. */
+    const val MAX_ROWS = 50
+
+    /** The ids of the actions of the grid. */
+    const val ID_OPEN_IN_GRID = 9704
+    const val ID_COLLECTION_TO_GRID = 9705
+    const val ID_EXPORT_PNG = 9706
+    const val ID_ADD_ROW = 9707
+
+    private const val KEY_PREFIX = "tele_gift_grid_"
+
+    enum class Kind {
+        EMPTY,
+        UNIQUE,
+        REGULAR
+    }
+
+    /** One cell of the grid. The live gift is kept next to the fields that are stored. */
+    class Cell(
+        val kind: Kind = Kind.EMPTY,
+        val giftId: Long = 0,
+        val title: String = "",
+        val number: Int = 0,
+        val slug: String = "",
+        val centerColor: Int = 0,
+        val edgeColor: Int = 0,
+        val patternColor: Int = 0,
+        val stars: Long = 0,
+        val limited: Boolean = false,
+        val soldOut: Boolean = false,
+        val upgradable: Boolean = false
+    ) {
+        /** The gift of the cell, when it is known right now. */
+        var gift: TL_stars.StarGift? = null
+
+        val empty: Boolean get() = kind == Kind.EMPTY
+        val unique: Boolean get() = kind == Kind.UNIQUE
+    }
+
+    /** The rows of the grid and the cells of every row. */
+    class Layout {
+
+        private val rows = ArrayList<MutableList<Cell>>()
+        private var size = 0
+
+        val columns: Int get() = COLUMNS
+
+        fun rowCount(): Int = rows.size
+
+        fun row(index: Int): List<Cell> =
+            if (index in rows.indices) rows[index].toList() else emptyList()
+
+        /** Every cell of the grid, row by row. */
+        fun cells(): List<Cell> {
+            val result = ArrayList<Cell>(size)
+            for (row in rows) result.addAll(row)
+            return result
+        }
+
+        /** The cell at the flat index of the grid. */
+        fun cell(index: Int): Cell? {
+            if (index < 0 || index >= size) return null
+            var left = index
+            for (row in rows) {
+                if (left < row.size) return row[left]
+                left -= row.size
+            }
+            return null
+        }
+
+        /** Puts a gift into the cell at the flat index; the grid grows when the index is past its end. */
+        fun setCell(index: Int, cell: Cell) {
+            if (index < 0) return
+            while (size <= index) {
+                if (!addRow()) return
+            }
+            val row = index / COLUMNS
+            val column = index % COLUMNS
+            val target = rows[row]
+            while (target.size <= column) {
+                target.add(Cell())
+                size++
+            }
+            target[column] = cell
+        }
+
+        /** Adds an empty row at the end; false when the grid is full. */
+        fun addRow(): Boolean {
+            if (rows.size >= MAX_ROWS) return false
+            val row = ArrayList<Cell>(COLUMNS)
+            for (i in 0 until COLUMNS) row.add(Cell())
+            rows.add(row)
+            size += COLUMNS
+            return true
+        }
+
+        /** Removes a row; the gifts of the other rows keep their places. */
+        fun removeRow(index: Int): Boolean {
+            if (index !in rows.indices) return false
+            rows.removeAt(index)
+            size -= COLUMNS
+            if (rows.isEmpty()) addRow()
+            return true
+        }
+
+        /** Puts a gift into the first free cell; -1 when the grid is full. */
+        fun addCell(cell: Cell): Int {
+            val cells = cells()
+            for (i in cells.indices) {
+                if (cells[i].empty) {
+                    setCell(i, cell)
+                    return i
+                }
+            }
+            if (rows.size < MAX_ROWS) {
+                addRow()
+                return addCell(cell)
+            }
+            return -1
+        }
+
+        /** Empties a cell. */
+        fun removeCell(index: Int) {
+            val cell = cell(index) ?: return
+            if (cell.empty) return
+            setCell(index, Cell())
+        }
+
+        /** Moves a cell to another place of the grid; the cell that was there moves back. */
+        fun moveCell(from: Int, to: Int): Boolean {
+            if (from == to) return false
+            val source = cell(from) ?: return false
+            val target = cell(to) ?: return false
+            setCell(to, source)
+            setCell(from, target)
+            return true
+        }
+
+        fun clear() {
+            rows.clear()
+            size = 0
+            addRow()
+        }
+
+        /** The gifts of the grid, in order: the cells that hold one. */
+        fun collect(): List<Cell> {
+            val result = ArrayList<Cell>()
+            for (row in rows) {
+                for (cell in row) {
+                    if (!cell.empty) result.add(cell)
+                }
+            }
+            return result
+        }
+
+        fun toJson(): String {
+            val array = JSONArray()
+            for (row in rows) {
+                val rowArray = JSONArray()
+                for (cell in row) rowArray.put(cellToJson(cell))
+                array.put(rowArray)
+            }
+            return JSONObject().put("rows", array).toString()
+        }
+
+        companion object {
+            fun fromJson(json: String?): Layout {
+                val layout = Layout()
+                layout.clear()
+                if (json.isNullOrEmpty()) return layout
+                try {
+                    val rows = JSONObject(json).optJSONArray("rows") ?: return layout
+                    for (i in 0 until rows.length()) {
+                        val rowArray = rows.optJSONArray(i) ?: continue
+                        if (i > 0) layout.addRow()
+                        for (j in 0 until rowArray.length()) {
+                            layout.setCell(i * COLUMNS + j, cellFromJson(rowArray.optJSONObject(j)))
+                        }
+                    }
+                } catch (e: Exception) {
+                    // a broken layout leaves the grid empty instead of crashing
+                }
+                return layout
+            }
+        }
+    }
+
+    private fun cellToJson(cell: Cell): JSONObject = JSONObject()
+        .put("k", cell.kind.name)
+        .put("id", cell.giftId)
+        .put("t", cell.title)
+        .put("n", cell.number)
+        .put("s", cell.slug)
+        .put("c", cell.centerColor)
+        .put("e", cell.edgeColor)
+        .put("pc", cell.patternColor)
+        .put("st", cell.stars)
+        .put("l", cell.limited)
+        .put("so", cell.soldOut)
+        .put("up", cell.upgradable)
+
+    private fun cellFromJson(json: JSONObject?): Cell {
+        if (json == null) return Cell()
+        val kind = try {
+            Kind.valueOf(json.optString("k"))
+        } catch (e: Exception) {
+            Kind.EMPTY
+        }
+        return Cell(
+            kind = kind,
+            giftId = json.optLong("id"),
+            title = json.optString("t"),
+            number = json.optInt("n"),
+            slug = json.optString("s"),
+            centerColor = json.optInt("c"),
+            edgeColor = json.optInt("e"),
+            patternColor = json.optInt("pc"),
+            stars = json.optLong("st"),
+            limited = json.optBoolean("l"),
+            soldOut = json.optBoolean("so"),
+            upgradable = json.optBoolean("up")
+        )
+    }
+
+    /** Builds a cell of a gift; the number of a collectible gift is the number of the gift. */
+    @JvmStatic
+    fun cellOf(gift: TL_stars.StarGift?): Cell {
+        if (gift == null) return Cell()
+        val unique = gift is TL_stars.TL_starGiftUnique
+        val backdrop = StarsController.findAttribute(gift.attributes, TL_stars.starGiftAttributeBackdrop::class.java)
+        val cell = Cell(
+            kind = if (unique) Kind.UNIQUE else Kind.REGULAR,
+            giftId = gift.id,
+            title = gift.title ?: "",
+            number = if (unique) (gift as TL_stars.TL_starGiftUnique).num else 0,
+            slug = gift.slug ?: "",
+            centerColor = backdrop?.center_color ?: 0,
+            edgeColor = backdrop?.edge_color ?: 0,
+            patternColor = backdrop?.pattern_color ?: 0,
+            stars = gift.stars,
+            limited = gift.limited,
+            soldOut = gift.sold_out,
+            upgradable = gift.can_upgrade
+        )
+        cell.gift = gift
+        return cell
+    }
+
+    /**
+     * Finds a gift of the grid again: the regular gifts come from the catalog of Telegram, the
+     * collectibles from the gift lists that are loaded.
+     */
+    @JvmStatic
+    fun findGift(account: Int, cell: Cell): TL_stars.StarGift? {
+        if (cell.empty) return null
+        val controller = StarsController.getInstance(account)
+        if (cell.unique) {
+            for (i in 0 until controller.giftLists.size()) {
+                val list = controller.giftLists.valueAt(i)
+                for (j in 0 until list.gifts.size()) {
+                    val gift = list.gifts[j].gift
+                    if (gift != null && gift.id == cell.giftId) return gift
+                }
+            }
+            return null
+        }
+        return controller.getStarGift(cell.giftId)
+    }
+
+    /** Fills the cells of a layout with the gifts that are known right now. */
+    @JvmStatic
+    fun resolve(account: Int, layout: Layout) {
+        for (cell in layout.cells()) {
+            if (cell.empty) continue
+            val gift = cell.gift ?: findGift(account, cell)
+            cell.gift = gift
+        }
+    }
+
+    /** The saved layout of the account on this device. */
+    @JvmStatic
+    fun load(account: Int): Layout {
+        val layout = Layout.fromJson(TeleDatabaseHelper.get(KEY_PREFIX + account))
+        resolve(account, layout)
+        return layout
+    }
+
+    /** Saves the layout of the account on this device. */
+    @JvmStatic
+    fun save(account: Int, layout: Layout) {
+        TeleDatabaseHelper.put(KEY_PREFIX + account, layout.toJson())
+    }
+
+    /** The account the grid belongs to. */
+    @JvmStatic
+    fun account(): Int = UserConfig.selectedAccount
+}
