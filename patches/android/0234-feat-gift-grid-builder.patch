+package tele.ui.settings
+
+import android.content.ContentValues
+import android.graphics.Bitmap
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.os.Build
+import android.os.Environment
+import android.provider.MediaStore
+import android.view.View
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.FileLog
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.R
+import org.telegram.ui.ActionBar.BaseFragment
+import org.telegram.ui.Components.BulletinFactory
+import org.telegram.ui.Gifts.GiftSheet
+import tele.helpers.GiftGrid
+import tele.helpers.GiftGrid.Layout
+import java.io.File
+import java.io.FileOutputStream
+
+/**
+ * The export of the gift grid (desktop 0204): the cards of the grid are drawn into one picture and
+ * saved to the gallery.
+ */
+object TeleGiftGridExport {
+
+    /** The picture is at most this wide and this tall, so a full grid does not eat the memory. */
+    private const val MAX_WIDTH = 2048
+    private const val MAX_HEIGHT = 4096
+
+    private const val GAP = 8
+
+    /**
+     * Draws the grid and saves it as a picture. The cards are the same views that the grid shows, so
+     * the picture and the screen look alike.
+     */
+    @JvmStatic
+    fun export(fragment: BaseFragment, layout: Layout) {
+        val activity = fragment.parentActivity ?: return
+        val cells = layout.collect()
+        if (cells.isEmpty()) {
+            show(fragment, LocaleController.getString(R.string.TeleGiftGridEmpty))
+            return
+        }
+        val card = GiftSheet.GiftCell(activity, fragment.currentAccount, fragment.resourceProvider)
+        val cellWidth = AndroidUtilities.dp(120f).toInt()
+        val cellHeight = AndroidUtilities.dp(160f).toInt()
+        val columns = GiftGrid.COLUMNS
+        val rows = (cells.size + columns - 1) / columns
+
+        var scale = 1f
+        val width = columns * cellWidth + (columns + 1) * GAP
+        val height = rows * cellHeight + (rows + 1) * GAP
+        if (width > MAX_WIDTH || height > MAX_HEIGHT) {
+            scale = minOf(MAX_WIDTH.toFloat() / width, MAX_HEIGHT.toFloat() / height)
+        }
+        val bitmap = Bitmap.createBitmap(
+            (width * scale).toInt().coerceAtLeast(2),
+            (height * scale).toInt().coerceAtLeast(2),
+            Bitmap.Config.ARGB_8888
+        )
+        val canvas = Canvas(bitmap)
+        val paint = Paint(Paint.ANTI_ALIAS_FLAG)
+        paint.color = Color.WHITE
+        canvas.drawRect(0f, 0f, bitmap.width.toFloat(), bitmap.height.toFloat(), paint)
+
+        for (i in cells.indices) {
+            val cell = cells[i]
+            val gift = cell.gift ?: continue
+            val column = i % columns
+            val row = i / columns
+            card.setStarsGift(gift, cell.unique, false, false, false, false)
+            card.measure(
+                View.MeasureSpec.makeMeasureSpec(cellWidth, View.MeasureSpec.EXACTLY),
+                View.MeasureSpec.makeMeasureSpec(cellHeight, View.MeasureSpec.EXACTLY)
+            )
+            card.layout(0, 0, cellWidth, cellHeight)
+            val save = canvas.save()
+            canvas.translate(
+                (GAP + column * (cellWidth + GAP)) * scale,
+                (GAP + row * (cellHeight + GAP)) * scale
+            )
+            canvas.scale(scale, scale)
+            card.draw(canvas)
+            canvas.restoreToCount(save)
+        }
+
+        save(fragment, bitmap)
+    }
+
+    /** Saves the picture in the gallery and shows the result. */
+    private fun save(fragment: BaseFragment, bitmap: Bitmap) {
+        val activity = fragment.parentActivity ?: return
+        val name = "gift-grid-${System.currentTimeMillis()}.png"
+        var saved = false
+        try {
+            if (Build.VERSION.SDK_INT >= 29) {
+                val values = ContentValues()
+                values.put(MediaStore.MediaColumns.RELATIVE_PATH, Environment.DIRECTORY_PICTURES + File.separator + "tele")
+                values.put(MediaStore.MediaColumns.DISPLAY_NAME, name)
+                values.put(MediaStore.MediaColumns.MIME_TYPE, "image/png")
+                val resolver = activity.contentResolver
+                val uri = resolver.insert(MediaStore.Images.Media.EXTERNAL_CONTENT_URI, values)
+                if (uri != null) {
+                    resolver.openOutputStream(uri)?.use { output ->
+                        bitmap.compress(Bitmap.CompressFormat.PNG, 100, output)
+                    }
+                    saved = true
+                }
+            } else {
+                val directory = File(activity.getExternalFilesDir(Environment.DIRECTORY_PICTURES), "tele")
+                directory.mkdirs()
+                val file = File(directory, name)
+                FileOutputStream(file).use { output ->
+                    bitmap.compress(Bitmap.CompressFormat.PNG, 100, output)
+                }
+                saved = file.length() > 0
+            }
+        } catch (e: Exception) {
+            FileLog.e("tele-gift-grid-export", e)
+            saved = false
+        }
+        bitmap.recycle()
+        if (saved) {
+            show(fragment, LocaleController.getString(R.string.TeleGiftGridSaved))
+        } else {
+            show(fragment, LocaleController.getString(R.string.TeleGiftGridExportFailed))
+        }
+    }
+
+    private fun show(fragment: BaseFragment, text: CharSequence) {
+        BulletinFactory.of(fragment).createSimpleBulletin(R.raw.error, text).show()
+    }
+}
