diff --git a/TMessagesProj/src/main/java/tele/helpers/FolderIcons.kt b/TMessagesProj/src/main/java/tele/helpers/FolderIcons.kt
new file mode 100644
index 000000000..33c2feefb
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/FolderIcons.kt
@@ -0,0 +1,101 @@
+package tele.helpers
+
+import org.json.JSONObject
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.MessagesController
+import org.telegram.messenger.NotificationCenter
+import org.telegram.messenger.UserConfig
+import org.telegram.messenger.Utilities
+import org.telegram.tgnet.TLRPC
+import org.telegram.ui.Components.FilterTabsView
+import tele.TeleConfig
+import tele.db.TeleDatabaseHelper
+import java.util.concurrent.ConcurrentHashMap
+
+// Icon-only folder tabs. Stock keeps no folder icon, so the server emoticon is remembered here.
+object FolderIcons {
+
+    private const val ALL_CHATS = "\uD83D\uDCAC"
+    private const val FALLBACK = "\uD83D\uDCC1"
+    private const val PRIVATE = "\uD83D\uDC64"
+    private const val GROUPS = "\uD83D\uDC65"
+    private const val CHANNELS = "\uD83D\uDCE2"
+    private const val BOTS = "\uD83E\uDD16"
+    private const val UNREAD = "\u2705"
+    private const val UNMUTED = "\uD83D\uDD14"
+
+    private val emoticons = Array(UserConfig.MAX_ACCOUNT_COUNT) { ConcurrentHashMap<Int, String>() }
+
+    private fun key(account: Int) = "folder_icons.$account"
+
+    @JvmStatic
+    fun enabled(): Boolean = TeleConfig.COMPACT_FOLDERS.value
+
+    @JvmStatic
+    fun preload() {
+        Utilities.globalQueue.postRunnable {
+            for (account in 0 until UserConfig.MAX_ACCOUNT_COUNT) {
+                val raw = TeleDatabaseHelper.get(key(account)) ?: continue
+                runCatching {
+                    val json = JSONObject(raw)
+                    for (id in json.keys()) {
+                        emoticons[account][id.toInt()] = json.getString(id)
+                    }
+                }
+            }
+            if (enabled()) notifyTabs()
+        }
+    }
+
+    // runs on the storage queue with every folder the server just sent
+    @JvmStatic
+    fun onRemote(account: Int, filters: List<TLRPC.DialogFilter>) {
+        val next = HashMap<Int, String>()
+        for (filter in filters) {
+            val emoticon = filter.emoticon
+            if (!emoticon.isNullOrEmpty()) next[filter.id] = emoticon
+        }
+        val known = emoticons[account]
+        if (next == HashMap(known)) return
+        known.clear()
+        known.putAll(next)
+        val json = JSONObject()
+        for ((id, emoticon) in next) json.put(id.toString(), emoticon)
+        TeleDatabaseHelper.put(key(account), if (next.isEmpty()) null else json.toString())
+        if (enabled()) notifyTabs()
+    }
+
+    private fun notifyTabs() {
+        AndroidUtilities.runOnUIThread {
+            val account = UserConfig.selectedAccount
+            NotificationCenter.getInstance(account).postNotificationName(NotificationCenter.dialogFiltersUpdated)
+        }
+    }
+
+    // a folder without its own icon shows the one its kind implies, like desktop does
+    private fun emojiOf(account: Int, filter: MessagesController.DialogFilter): String {
+        if (filter.isDefault) return ALL_CHATS
+        emoticons[account][filter.id]?.let { return it }
+        if (filter.alwaysShow.isNotEmpty()) return FALLBACK
+        val types = filter.flags and MessagesController.DIALOG_FILTER_FLAG_ALL_CHATS
+        val people = MessagesController.DIALOG_FILTER_FLAG_CONTACTS or MessagesController.DIALOG_FILTER_FLAG_NON_CONTACTS
+        return when {
+            types == MessagesController.DIALOG_FILTER_FLAG_ALL_CHATS ->
+                if (filter.flags and MessagesController.DIALOG_FILTER_FLAG_EXCLUDE_READ != 0) UNREAD
+                else if (filter.flags and MessagesController.DIALOG_FILTER_FLAG_EXCLUDE_MUTED != 0) UNMUTED
+                else FALLBACK
+            types != 0 && types and people.inv() == 0 -> PRIVATE
+            types == MessagesController.DIALOG_FILTER_FLAG_GROUPS -> GROUPS
+            types == MessagesController.DIALOG_FILTER_FLAG_CHANNELS -> CHANNELS
+            types == MessagesController.DIALOG_FILTER_FLAG_BOTS -> BOTS
+            else -> FALLBACK
+        }
+    }
+
+    // the tab shows the icon and keeps its title for accessibility
+    @JvmStatic
+    fun apply(tab: FilterTabsView.Tab?, account: Int, filter: MessagesController.DialogFilter?) {
+        if (tab == null || filter == null || !enabled()) return
+        tab.tele_setIcon(emojiOf(account, filter))
+    }
+}
