diff --git a/TMessagesProj/src/main/java/tele/helpers/MediaViewerInfo.kt b/TMessagesProj/src/main/java/tele/helpers/MediaViewerInfo.kt
index 1e212c6b3..718b28e0d 100644
--- a/TMessagesProj/src/main/java/tele/helpers/MediaViewerInfo.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/MediaViewerInfo.kt
@@ -6,18 +6,35 @@ import org.telegram.messenger.MessageObject
 import org.telegram.messenger.R
 import org.telegram.tgnet.TLRPC
 import tele.TeleConfig
+import kotlin.math.abs
 
-// the data center of the shown media, appended to the viewer subtitle like on the desktop
+// the data center and the upload date of the shown media, appended to the viewer subtitle like on the desktop
 object MediaViewerInfo {
 
     private const val SEPARATOR = " · "
+    private const val UPLOAD_DATE_SKIP = 5 * 60
 
-    /** The subtitle of a chat media: the message date, then the media data center. */
+    /** The subtitle of a chat media: the message date, then the media data center, then the upload date. */
     @JvmStatic
     fun subtitle(base: CharSequence?, message: MessageObject?): CharSequence? {
-        if (message == null || !TeleConfig.SHOW_DC.value) return base
+        val dcOn = TeleConfig.SHOW_DC.value
+        val dateOn = TeleConfig.MEDIA_UPLOAD_DATE.value
+        if (message == null || !dcOn && !dateOn) return base
         val document = message.getDocument()
-        return append(base, dcLabel(if (document != null) document.dc_id else photoDc(message.getPhoto())))
+        val photo = message.getPhoto()
+        var result = base
+        if (dcOn) {
+            result = append(result, dcLabel(if (document != null) document.dc_id else photoDc(photo)))
+        }
+        if (dateOn) {
+            val date = if (photo != null) photo.date else document?.date ?: 0
+            val messageDate = message.messageOwner?.date ?: 0
+            if (date != 0 && messageDate != 0 && abs(date - messageDate) >= UPLOAD_DATE_SKIP) {
+                val label = LocaleController.formatString(R.string.TeleMediaUploaded, LocaleController.formatDateTime(date.toLong(), true))
+                result = append(result, label)
+            }
+        }
+        return result
     }
 
     /** The subtitle of a profile photo, whose own date is already shown. */
