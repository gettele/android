+    public boolean tele_refreshReplyQuotePromotion() {
+        final boolean enabled = tele.TeleConfig.PROMOTE_REPLY_QUOTES.getValue();
+        if (!enabled && tele_replyQuoteBodyPrefix == 0 && tele_replyQuoteRevision == -1 && tele_replyQuoteSourceOwner == null && tele_replyQuoteSourceText == null) {
+            return false;
+        }
+        final tele.helpers.ReplyQuotePromotion.PromotedQuote promoted = enabled
+            ? tele.helpers.ReplyQuotePromotion.promote(this)
+            : null;
+        final int bodyPrefix = promoted != null ? promoted.bodyPrefix : 0;
+        final TLRPC.Message sourceOwner = replyMessageObject == null ? null : replyMessageObject.messageOwner;
+        final String sourceText = sourceOwner != null ? sourceOwner.message : null;
+        final int revision = tele.TeleHooks.uiRevision();
+        if (bodyPrefix == 0 && tele_replyQuoteBodyPrefix == 0) {
+            if (enabled) {
+                tele_replyQuoteRevision = revision;
+                tele_replyQuoteSourceOwner = sourceOwner;
+                tele_replyQuoteSourceText = sourceText;
+            } else {
+                tele_clearReplyQuotePromotion();
+            }
+            return false;
+        }
+        if (bodyPrefix == tele_replyQuoteBodyPrefix &&
+            (!enabled || tele_replyQuoteRevision == revision) &&
+            tele_replyQuoteSourceOwner == sourceOwner &&
+            TextUtils.equals(tele_replyQuoteSourceText, sourceText)) {
+            return false;
+        }
+        if (messageOwner instanceof TLRPC.TL_message && !translated && !summarized && messageOwner.message != null) {
+            messageText = messageOwner.message;
+            if (tele.TeleConfig.SCRIPTING.getValue()) {
+                tele.scripting.ScriptDisplay.onTextChanged(this);
+            }
+        }
+        tele_fullPromotedMessageText = null;
+        tele_replyQuoteBodyPrefix = 0;
+        cachedTextHeight = null;
+        if (!enabled) {
+            tele_replyQuoteRevision = -1;
+            tele_replyQuoteSourceOwner = null;
+            tele_replyQuoteSourceText = null;
+        }
+        layoutCreated = false;
+        return true;
+    }
+
+    public CharSequence tele_fullMessageText() {
+        return tele_replyQuoteBodyPrefix > 0 && tele_fullPromotedMessageText != null ? tele_fullPromotedMessageText : messageText;
+    }
+
+    private void tele_clearReplyQuotePromotion() {
+        tele_fullPromotedMessageText = null;
+        tele_replyQuoteBodyPrefix = 0;
+        tele_replyQuoteRevision = -1;
+        tele_replyQuoteSourceOwner = null;
+        tele_replyQuoteSourceText = null;
+    }
