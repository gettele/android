+package tele.helpers
+
+import android.text.NoCopySpan
+import android.text.SpannableStringBuilder
+import android.text.Spanned
+import android.text.TextUtils
+import org.telegram.messenger.DialogObject
+import org.telegram.messenger.MessageObject
+import org.telegram.messenger.MessagesController
+import org.telegram.messenger.RichQuote
+import org.telegram.messenger.UserConfig
+import org.telegram.tgnet.TLObject
+import org.telegram.tgnet.TLRPC
+import org.telegram.tgnet.tl.TL_iv
+import org.telegram.ui.iv.RichTextStyle
+import tele.TeleConfig
+
+object ReplyQuotePromotion {
+    data class PromotedQuote(
+        @JvmField val quote: TLRPC.TL_textWithEntities,
+        @JvmField val bodyPrefix: Int,
+        @JvmField val sourceOffset: Int
+    )
+
+    data class LeadingQuote(
+        val quote: TLRPC.TL_textWithEntities,
+        val bodyPrefix: Int
+    )
+
+    private val entityComparator = Comparator<TLRPC.MessageEntity> { a, b ->
+        compareValuesBy(
+            a, b,
+            { it.offset },
+            { it.length },
+            { canonicalEntityTypeRank(it) },
+            { entityPayloadKey(it) }
+        )
+    }
+
+    @JvmStatic
+    fun promote(item: MessageObject?): PromotedQuote? {
+        if (!TeleConfig.PROMOTE_REPLY_QUOTES.value) {
+            return null
+        }
+        val reply = item ?: return null
+        val owner = reply.messageOwner ?: return null
+        val source = reply.replyMessageObject ?: return null
+        val replyTo = owner.reply_to ?: return null
+        if (reply === source ||
+            replyTo.quote ||
+            replyTo.quote_text != null ||
+            replyTo.quote_rich != null ||
+            replyTo.poll_option != null ||
+            owner.flags and 2048 != 0 ||
+            !isOrdinaryText(reply)
+        ) {
+            return null
+        }
+
+        val replyQuote = leadingQuote(reply) ?: return null
+        sortEntitiesNormalized(replyQuote.quote.entities)
+        return promoteRichSource(source, replyQuote) ?: promoteTextSource(source, replyQuote)
+    }
+
+    private fun promoteRichSource(source: MessageObject, replyQuote: LeadingQuote): PromotedQuote? {
+        if (source.type != MessageObject.TYPE_ARTICLE ||
+            source.isRestrictedMessage ||
+            source.isRepostPreview ||
+            source.translated ||
+            source.summarized ||
+            TeleConfig.SCRIPTING.value && tele.scripting.ScriptDisplay.hasReplacement(source)
+        ) {
+            return null
+        }
+        val rich = source.getDisplayRichMessage() ?: return null
+        val (flat, flatEntities) = collectRichText(rich)
+        val offset = uniqueOffset(flat, replyQuote.quote.text) ?: return null
+        val end = offset + replyQuote.quote.text.length
+        val entities = sliceEntities(flatEntities, offset, end, false) ?: return null
+        if (!entitiesEqual(entities, replyQuote.quote.entities)) {
+            return null
+        }
+        return PromotedQuote(replyQuote.quote, replyQuote.bodyPrefix, offset)
+    }
+
+    private fun collectRichText(message: TL_iv.RichMessage): Pair<String, ArrayList<TLRPC.MessageEntity>> {
+        val text = StringBuilder()
+        val entities = ArrayList<TLRPC.MessageEntity>()
+        val nodes = RichQuote.collectNodes(message)
+        for ((index, node) in nodes.withIndex()) {
+            if (index > 0) {
+                text.append('\n')
+            }
+            appendRichText(node, text, entities)
+        }
+        return text.toString() to entities
+    }
+
+    private fun appendRichText(text: TL_iv.RichText?, out: StringBuilder, entities: ArrayList<TLRPC.MessageEntity>) {
+        if (text == null || text is TL_iv.textEmpty || text is TL_iv.textImage) {
+            return
+        }
+        if (text is TL_iv.textPlain) {
+            if (text.text != null) {
+                out.append(text.text)
+            }
+            return
+        }
+        if (text is TL_iv.textMath) {
+            if (text.source != null) {
+                out.append(text.source)
+            }
+            return
+        }
+        if (text is TL_iv.textCustomEmoji) {
+            val start = out.length
+            out.append(if (TextUtils.isEmpty(text.alt)) "😀" else text.alt)
+            addEntity(
+                entities,
+                TLRPC.TL_messageEntityCustomEmoji().apply { document_id = text.document_id },
+                start,
+                out.length
+            )
+            return
+        }
+        if (text is TL_iv.textConcat) {
+            for (child in text.texts.orEmpty()) {
+                appendRichText(child, out, entities)
+            }
+            return
+        }
+        if (text is TL_iv.textDiff) {
+            appendRichText(if (RichTextStyle.isEmpty(text.text)) text.old_text else text.text, out, entities)
+            return
+        }
+        val start = out.length
+        appendRichText(text.text, out, entities)
+        richTextEntity(text)?.let { addEntity(entities, it, start, out.length) }
+    }
+
+    private fun richTextEntity(text: TL_iv.RichText): TLRPC.MessageEntity? = when (text) {
+        is TL_iv.textBold -> TLRPC.TL_messageEntityBold()
+        is TL_iv.textItalic -> TLRPC.TL_messageEntityItalic()
+        is TL_iv.textUnderline -> TLRPC.TL_messageEntityUnderline()
+        is TL_iv.textStrike -> TLRPC.TL_messageEntityStrike()
+        is TL_iv.textFixed -> TLRPC.TL_messageEntityCode()
+        is TL_iv.textSpoiler -> TLRPC.TL_messageEntitySpoiler()
+        is TL_iv.textUrl -> TLRPC.TL_messageEntityTextUrl().apply { url = text.url }
+        is TL_iv.textAutoUrl -> TLRPC.TL_messageEntityUrl()
+        is TL_iv.textMention -> TLRPC.TL_messageEntityMention()
+        is TL_iv.textMentionName -> TLRPC.TL_messageEntityMentionName().apply {
+            user_id = normalizedId(text.user_id)
+        }
+        is TL_iv.textHashtag -> TLRPC.TL_messageEntityHashtag()
+        is TL_iv.textCashtag -> TLRPC.TL_messageEntityCashtag()
+        is TL_iv.textBotCommand -> TLRPC.TL_messageEntityBotCommand()
+        is TL_iv.textEmail, is TL_iv.textAutoEmail -> TLRPC.TL_messageEntityEmail()
+        is TL_iv.textPhone, is TL_iv.textAutoPhone -> TLRPC.TL_messageEntityPhone()
+        is TL_iv.textBankCard -> TLRPC.TL_messageEntityBankCard()
+        is TL_iv.textTonAddress -> TLRPC.TL_messageEntityTonAddress()
+        is TL_iv.textDate -> createFormattedDateEntity(
+            text.flags,
+            text.relative,
+            text.short_time,
+            text.long_time,
+            text.short_date,
+            text.long_date,
+            text.day_of_week,
+            text.date
+        )
+        else -> null
+    }
+
+    private fun promoteTextSource(source: MessageObject, replyQuote: LeadingQuote): PromotedQuote? {
+        if (!isOrdinaryText(source)) {
+            return null
+        }
+        val owner = source.messageOwner as? TLRPC.TL_message ?: return null
+        val fullSourceText = owner.message ?: return null
+        val offset = uniqueOffset(fullSourceText, replyQuote.quote.text) ?: return null
+        val end = offset + replyQuote.quote.text.length
+        val entities = sliceEntities(owner.entities, offset, end, true) ?: return null
+        if (!entitiesEqual(entities, replyQuote.quote.entities)) {
+            return null
+        }
+        return PromotedQuote(replyQuote.quote, replyQuote.bodyPrefix, offset)
+    }
+
+    private fun uniqueOffset(text: String, quote: String): Int? {
+        if (quote.isEmpty()) {
+            return null
+        }
+        val offset = text.indexOf(quote)
+        if (offset < 0 || text.indexOf(quote, offset + 1) >= 0) {
+            return null
+        }
+        val end = offset + quote.length
+        if (offset > 0 && Character.isLowSurrogate(text[offset]) && Character.isHighSurrogate(text[offset - 1]) ||
+            end < text.length && Character.isHighSurrogate(text[end - 1]) && Character.isLowSurrogate(text[end])
+        ) {
+            return null
+        }
+        return offset
+    }
+
+    private fun sliceEntities(
+        entities: List<TLRPC.MessageEntity>?,
+        start: Int,
+        end: Int,
+        ignoreOuterBlockquote: Boolean
+    ): ArrayList<TLRPC.MessageEntity>? {
+        val result = ArrayList<TLRPC.MessageEntity>()
+        if (entities != null) {
+            for (entity in entities) {
+                val entityEnd = entity.offset + entity.length
+                if (entity.offset >= end || entityEnd <= start) {
+                    continue
+                }
+                if (ignoreOuterBlockquote && entity is TLRPC.TL_messageEntityBlockquote) {
+                    if (entity.offset <= start && entityEnd >= end) {
+                        continue
+                    }
+                    if (entity.offset < start || entityEnd > end) {
+                        return null
+                    }
+                }
+                val copy = copyEntitySlice(entity, start, end) ?: return null
+                result.add(copy)
+            }
+        }
+        sortEntitiesNormalized(result)
+        return result
+    }
+
+    private fun copyStandardEntity(entity: TLRPC.MessageEntity): TLRPC.MessageEntity? = when (entity) {
+        is TLRPC.TL_messageEntityBold -> TLRPC.TL_messageEntityBold()
+        is TLRPC.TL_messageEntityItalic -> TLRPC.TL_messageEntityItalic()
+        is TLRPC.TL_messageEntityUnderline -> TLRPC.TL_messageEntityUnderline()
+        is TLRPC.TL_messageEntityStrike -> TLRPC.TL_messageEntityStrike()
+        is TLRPC.TL_messageEntityCode -> TLRPC.TL_messageEntityCode()
+        is TLRPC.TL_messageEntityPre -> TLRPC.TL_messageEntityPre().apply {
+            language = entity.language
+        }
+        is TLRPC.TL_messageEntitySpoiler -> TLRPC.TL_messageEntitySpoiler()
+        is TLRPC.TL_messageEntityTextUrl -> TLRPC.TL_messageEntityTextUrl().apply {
+            url = entity.url
+        }
+        is TLRPC.TL_messageEntityUrl -> TLRPC.TL_messageEntityUrl()
+        is TLRPC.TL_messageEntityEmail -> TLRPC.TL_messageEntityEmail()
+        is TLRPC.TL_messageEntityPhone -> TLRPC.TL_messageEntityPhone()
+        is TLRPC.TL_messageEntityHashtag -> TLRPC.TL_messageEntityHashtag()
+        is TLRPC.TL_messageEntityCashtag -> TLRPC.TL_messageEntityCashtag()
+        is TLRPC.TL_messageEntityMention -> TLRPC.TL_messageEntityMention()
+        is TLRPC.TL_messageEntityBotCommand -> TLRPC.TL_messageEntityBotCommand()
+        is TLRPC.TL_messageEntityMentionName -> TLRPC.TL_messageEntityMentionName().apply {
+            user_id = normalizedId(entity.user_id)
+        }
+        is TLRPC.TL_inputMessageEntityMentionName -> TLRPC.TL_inputMessageEntityMentionName().apply {
+            user_id = entity.user_id
+        }
+        is TLRPC.TL_messageEntityCustomEmoji -> TLRPC.TL_messageEntityCustomEmoji().apply {
+            document_id = entity.document_id
+            document = entity.document
+        }
+        is TLRPC.TL_messageEntityFormattedDate -> createFormattedDateEntity(
+            entity.flags,
+            entity.relative,
+            entity.short_time,
+            entity.long_time,
+            entity.short_date,
+            entity.long_date,
+            entity.day_of_week,
+            entity.date
+        )
+        is TLRPC.TL_messageEntityBankCard -> TLRPC.TL_messageEntityBankCard()
+        is TLRPC.TL_messageEntityTonAddress -> TLRPC.TL_messageEntityTonAddress()
+        is TLRPC.TL_messageEntityBlockquote -> TLRPC.TL_messageEntityBlockquote().apply {
+            flags = entity.flags
+            collapsed = entity.collapsed
+        }
+        else -> null
+    }
+
+    private fun copyEntitySlice(entity: TLRPC.MessageEntity, start: Int, end: Int): TLRPC.MessageEntity? {
+        val entityStart = maxOf(start, entity.offset)
+        val entityEnd = minOf(end, entity.offset + entity.length)
+        if (entityStart >= entityEnd) {
+            return null
+        }
+        val copy = copyStandardEntity(entity) ?: return null
+        copy.offset = entityStart - start
+        copy.length = entityEnd - entityStart
+        return copy
+    }
+
+    private fun copyBodyEntitySlice(
+        entity: TLRPC.MessageEntity,
+        bodyPrefix: Int,
+        entityStart: Int,
+        entityEnd: Int
+    ): TLRPC.MessageEntity? {
+        if (entityStart >= entityEnd) {
+            return null
+        }
+        val copy = when (entity) {
+            is ScreenshotCut -> ScreenshotCut()
+            is TLRPC.TL_messageEntityDiffInsert -> TLRPC.TL_messageEntityDiffInsert()
+            is TLRPC.TL_messageEntityDiffReplace -> TLRPC.TL_messageEntityDiffReplace().apply {
+                old_text = entity.old_text
+            }
+            is TLRPC.TL_messageEntityDiffDelete -> TLRPC.TL_messageEntityDiffDelete()
+            is TLRPC.TL_messageEntityUnknown -> TLRPC.TL_messageEntityUnknown()
+            else -> copyStandardEntity(entity)
+        } ?: return null
+        copy.offset = entityStart - bodyPrefix
+        copy.length = entityEnd - entityStart
+        return copy
+    }
+
+    @JvmStatic
+    fun bodyEntities(
+        entities: List<TLRPC.MessageEntity>?,
+        bodyPrefix: Int,
+        bodyLength: Int
+    ): ArrayList<TLRPC.MessageEntity> {
+        val result = ArrayList<TLRPC.MessageEntity>()
+        if (entities == null || bodyPrefix <= 0 || bodyLength <= 0) {
+            return result
+        }
+        val bodyPrefixLong = bodyPrefix.toLong()
+        val bodyEndLimit = bodyPrefixLong + bodyLength.toLong()
+        for (entity in entities) {
+            val entityEndLong = entity.offset.toLong() + entity.length.toLong()
+            if (entity.length <= 0 ||
+                entity.offset < 0 ||
+                entityEndLong <= bodyPrefixLong ||
+                entity.offset.toLong() >= bodyEndLimit
+            ) {
+                continue
+            }
+            if (entity is TLRPC.TL_messageEntityBlockquote && entity.offset < bodyPrefix) {
+                continue
+            }
+            val start = maxOf(bodyPrefix, entity.offset)
+            val end = minOf(bodyEndLimit, entityEndLong).toInt()
+            copyBodyEntitySlice(entity, bodyPrefix, start, end)?.let { result.add(it) }
+        }
+        return result
+    }
+
+    private fun entitiesEqual(a: List<TLRPC.MessageEntity>?, b: List<TLRPC.MessageEntity>?): Boolean {
+        if (a === b) {
+            return true
+        }
+        if (a == null || b == null || a.size != b.size) {
+            return false
+        }
+        for (i in a.indices) {
+            val ea = a[i]
+            val eb = b[i]
+            if (canonicalEntityType(ea) != canonicalEntityType(eb) || ea.offset != eb.offset || ea.length != eb.length) {
+                return false
+            }
+            when (ea) {
+                is TLRPC.TL_messageEntityTextUrl -> if (ea.url != (eb as TLRPC.TL_messageEntityTextUrl).url) return false
+                is TLRPC.TL_messageEntityMentionName -> {
+                    val other = eb as TLRPC.TL_messageEntityMentionName
+                    if (normalizedId(ea.user_id) != normalizedId(other.user_id)) return false
+                }
+                is TLRPC.TL_inputMessageEntityMentionName -> {
+                    if (!inputUsersEqual(ea.user_id, (eb as TLRPC.TL_inputMessageEntityMentionName).user_id)) return false
+                }
+                is TLRPC.TL_messageEntityCustomEmoji -> {
+                    val other = eb as TLRPC.TL_messageEntityCustomEmoji
+                    val id = effectiveDocumentId(ea)
+                    if (id != effectiveDocumentId(other) || (id == 0L && ea.document !== other.document)) return false
+                }
+                is TLRPC.TL_messageEntityBlockquote -> {
+                    if (ea.collapsed != (eb as TLRPC.TL_messageEntityBlockquote).collapsed) return false
+                }
+                is TLRPC.TL_messageEntityPre -> {
+                    if ((ea.language ?: "") != ((eb as TLRPC.TL_messageEntityPre).language ?: "")) return false
+                }
+                is TLRPC.TL_messageEntityFormattedDate -> {
+                    val other = eb as TLRPC.TL_messageEntityFormattedDate
+                    if (ea.date != other.date ||
+                        ea.relative != other.relative ||
+                        ea.short_time != other.short_time ||
+                        ea.long_time != other.long_time ||
+                        ea.short_date != other.short_date ||
+                        ea.long_date != other.long_date ||
+                        ea.day_of_week != other.day_of_week
+                    ) return false
+                }
+            }
+        }
+        return true
+    }
+
+
+    private fun inputUsersEqual(a: TLRPC.InputUser?, b: TLRPC.InputUser?): Boolean {
+        if (a === b) {
+            return true
+        }
+        if (a == null || b == null ||
+            canonicalInputUserType(a) != canonicalInputUserType(b) ||
+            normalizedId(a.user_id) != normalizedId(b.user_id) ||
+            a.access_hash != b.access_hash
+        ) {
+            return false
+        }
+        val aMessage = inputUserMessage(a)
+        val bMessage = inputUserMessage(b)
+        if (aMessage != null || bMessage != null) {
+            return aMessage != null && bMessage != null &&
+                aMessage.second == bMessage.second &&
+                inputPeersEqual(aMessage.first, bMessage.first)
+        }
+        return true
+    }
+
+    private fun canonicalInputUserType(user: TLRPC.InputUser): String = when (user) {
+        is TLRPC.TL_inputUserFromMessage, is TLRPC.TL_inputUserFromMessage_layer132 -> "from_message"
+        is TLRPC.TL_inputUser, is TLRPC.TL_inputUser_layer132 -> "user"
+        is TLRPC.TL_inputUserEmpty -> "empty"
+        is TLRPC.TL_inputUserSelf -> "self"
+        else -> user.javaClass.name
+    }
+
+    private fun canonicalInputPeerType(peer: TLRPC.InputPeer): String = when (peer) {
+        is TLRPC.TL_inputPeerUserFromMessage, is TLRPC.TL_inputPeerUserFromMessage_layer131 -> "user_from_message"
+        is TLRPC.TL_inputPeerChannelFromMessage, is TLRPC.TL_inputPeerChannelFromMessage_layer131 -> "channel_from_message"
+        is TLRPC.TL_inputPeerUser, is TLRPC.TL_inputPeerUser_layer131 -> "user"
+        is TLRPC.TL_inputPeerChat, is TLRPC.TL_inputPeerChat_layer131 -> "chat"
+        is TLRPC.TL_inputPeerChannel, is TLRPC.TL_inputPeerChannel_layer131 -> "channel"
+        is TLRPC.TL_inputPeerEmpty -> "empty"
+        is TLRPC.TL_inputPeerSelf -> "self"
+        else -> peer.javaClass.name
+    }
+
+    private fun inputUserMessage(user: TLRPC.InputUser): Pair<TLRPC.InputPeer?, Int>? = when (user) {
+        is TLRPC.TL_inputUserFromMessage -> user.peer to user.msg_id
+        is TLRPC.TL_inputUserFromMessage_layer132 -> user.peer to user.msg_id
+        else -> null
+    }
+
+    private fun inputPeersEqual(a: TLRPC.InputPeer?, b: TLRPC.InputPeer?): Boolean {
+        if (a === b) {
+            return true
+        }
+        if (a == null || b == null ||
+            canonicalInputPeerType(a) != canonicalInputPeerType(b) ||
+            a.msg_id != b.msg_id ||
+            normalizedId(a.user_id) != normalizedId(b.user_id) ||
+            normalizedId(a.channel_id) != normalizedId(b.channel_id) ||
+            normalizedId(a.chat_id) != normalizedId(b.chat_id) ||
+            a.access_hash != b.access_hash
+        ) {
+            return false
+        }
+        return inputPeersEqual(a.peer, b.peer)
+    }
+
+    private fun sortEntitiesNormalized(entities: ArrayList<TLRPC.MessageEntity>?) {
+        entities?.sortWith(entityComparator)
+    }
+
+    private fun canonicalEntityType(entity: TLRPC.MessageEntity): Class<out TLRPC.MessageEntity> = when (entity) {
+        is TLRPC.TL_messageEntityMentionName -> TLRPC.TL_messageEntityMentionName::class.java
+        is TLRPC.TL_messageEntityBlockquote -> TLRPC.TL_messageEntityBlockquote::class.java
+        else -> entity.javaClass
+    }
+
+    private fun canonicalEntityTypeRank(entity: TLRPC.MessageEntity): Int = when (entity) {
+        is TLRPC.TL_messageEntityBold -> 0
+        is TLRPC.TL_messageEntityItalic -> 1
+        is TLRPC.TL_messageEntityUnderline -> 2
+        is TLRPC.TL_messageEntityStrike -> 3
+        is TLRPC.TL_messageEntityCode -> 4
+        is TLRPC.TL_messageEntityPre -> 5
+        is TLRPC.TL_messageEntitySpoiler -> 6
+        is TLRPC.TL_messageEntityTextUrl -> 7
+        is TLRPC.TL_messageEntityUrl -> 8
+        is TLRPC.TL_messageEntityEmail -> 9
+        is TLRPC.TL_messageEntityPhone -> 10
+        is TLRPC.TL_messageEntityHashtag -> 11
+        is TLRPC.TL_messageEntityCashtag -> 12
+        is TLRPC.TL_messageEntityMention -> 13
+        is TLRPC.TL_messageEntityMentionName -> 14
+        is TLRPC.TL_inputMessageEntityMentionName -> 15
+        is TLRPC.TL_messageEntityBotCommand -> 16
+        is TLRPC.TL_messageEntityBankCard -> 17
+        is TLRPC.TL_messageEntityTonAddress -> 18
+        is TLRPC.TL_messageEntityCustomEmoji -> 19
+        is TLRPC.TL_messageEntityFormattedDate -> 20
+        is TLRPC.TL_messageEntityBlockquote -> 21
+        is TLRPC.TL_messageEntityUnknown -> 22
+        is TLRPC.TL_messageEntityDiffInsert -> 23
+        is TLRPC.TL_messageEntityDiffReplace -> 24
+        is TLRPC.TL_messageEntityDiffDelete -> 25
+        else -> Int.MAX_VALUE
+    }
+
+    private fun entityPayloadKey(entity: TLRPC.MessageEntity): String {
+        val payload = when (entity) {
+            is TLRPC.TL_messageEntityTextUrl -> "url=${entity.url?.length ?: -1}:${entity.url ?: ""}"
+            is TLRPC.TL_messageEntityMentionName -> normalizedId(entity.user_id).toString()
+            is TLRPC.TL_inputMessageEntityMentionName -> inputUserPayloadKey(entity.user_id)
+            is TLRPC.TL_messageEntityCustomEmoji -> {
+                val id = effectiveDocumentId(entity)
+                if (id == 0L) "document=${System.identityHashCode(entity.document)}" else id.toString()
+            }
+            is TLRPC.TL_messageEntityBlockquote -> entity.collapsed.toString()
+            is TLRPC.TL_messageEntityPre -> entity.language ?: ""
+            is TLRPC.TL_messageEntityFormattedDate -> listOf(
+                entity.relative,
+                entity.short_time,
+                entity.long_time,
+                entity.short_date,
+                entity.long_date,
+                entity.day_of_week,
+                entity.date
+            ).joinToString(":")
+            else -> ""
+        }
+        return "${canonicalEntityType(entity).name}:$payload"
+    }
+
+    private fun inputUserPayloadKey(user: TLRPC.InputUser?): String {
+        if (user == null) {
+            return "null"
+        }
+        val base = "${canonicalInputUserType(user)}:${normalizedId(user.user_id)}:${user.access_hash}"
+        val message = inputUserMessage(user) ?: return base
+        return "$base:${message.second}:${inputPeerPayloadKey(message.first)}"
+    }
+
+    private fun inputPeerPayloadKey(peer: TLRPC.InputPeer?): String {
+        if (peer == null) {
+            return "null"
+        }
+        return "${canonicalInputPeerType(peer)}:${peer.msg_id}:${normalizedId(peer.user_id)}:" +
+            "${normalizedId(peer.channel_id)}:${normalizedId(peer.chat_id)}:${peer.access_hash}:" +
+            inputPeerPayloadKey(peer.peer)
+    }
+
+    private fun createFormattedDateEntity(
+        srcFlags: Int,
+        relativeFlag: Boolean,
+        shortTime: Boolean,
+        longTime: Boolean,
+        shortDate: Boolean,
+        longDate: Boolean,
+        dayOfWeek: Boolean,
+        dateValue: Int
+    ): TLRPC.TL_messageEntityFormattedDate = TLRPC.TL_messageEntityFormattedDate().apply {
+        flags = srcFlags
+        applyFlags()
+        relative = relative || relativeFlag
+        short_time = short_time || shortTime
+        long_time = long_time || longTime
+        short_date = short_date || shortDate
+        long_date = long_date || longDate
+        day_of_week = day_of_week || dayOfWeek
+        date = dateValue
+        flags = TLObject.setFlag(flags, TLObject.FLAG_0, relative)
+        flags = TLObject.setFlag(flags, TLObject.FLAG_1, short_time)
+        flags = TLObject.setFlag(flags, TLObject.FLAG_2, long_time)
+        flags = TLObject.setFlag(flags, TLObject.FLAG_3, short_date)
+        flags = TLObject.setFlag(flags, TLObject.FLAG_4, long_date)
+        flags = TLObject.setFlag(flags, TLObject.FLAG_5, day_of_week)
+    }
+
+    private fun normalizedId(id: Long): Long = if (id < 0L) id and 0xffffffffL else id
+
+    private fun effectiveDocumentId(entity: TLRPC.TL_messageEntityCustomEmoji): Long =
+        if (entity.document_id != 0L) entity.document_id else entity.document?.id ?: 0L
+
+    private fun addEntity(
+        entities: ArrayList<TLRPC.MessageEntity>,
+        entity: TLRPC.MessageEntity,
+        start: Int,
+        end: Int
+    ) {
+        if (end <= start) {
+            return
+        }
+        entity.offset = start
+        entity.length = end - start
+        entities.add(entity)
+    }
+
+    @JvmStatic
+    fun shouldHideDuplicateAuthor(messageObject: MessageObject?): Boolean {
+        if (messageObject == null) {
+            return false
+        }
+        val owner = messageObject.messageOwner ?: return false
+        val replyTo = owner.reply_to ?: return false
+        val source = messageObject.replyMessageObject ?: return false
+        val sourceOwner = source.messageOwner ?: return false
+        if (DialogObject.isEncryptedDialog(messageObject.dialogId)) {
+            return false
+        }
+        if (messageObject.hideSendersName || messageObject.customName != null || messageObject.customReplyName != null) {
+            return false
+        }
+        if (source.hideSendersName || source.customName != null || source.dialogId != messageObject.dialogId) {
+            return false
+        }
+        if (owner.fwd_from != null || sourceOwner.fwd_from != null) {
+            return false
+        }
+        if (replyTo.story_id != 0 || replyTo.reply_from != null) {
+            return false
+        }
+        val replyToPeer = replyTo.reply_to_peer_id
+        if (replyToPeer != null && DialogObject.getPeerDialogId(replyToPeer) != messageObject.dialogId) {
+            return false
+        }
+        if (!TextUtils.equals(owner.post_author, sourceOwner.post_author)) {
+            return false
+        }
+        val a = effectiveAuthorId(messageObject)
+        val b = effectiveAuthorId(source)
+        return a != 0L && a == b
+    }
+
+    private fun effectiveAuthorId(msg: MessageObject): Long {
+        val owner = msg.messageOwner ?: return 0L
+        val fromId = msg.fromChatId
+        if (fromId != 0L) {
+            return fromId
+        }
+        val dialogId = msg.dialogId
+        if (owner.post) {
+            return dialogId
+        }
+        if (msg.isOut && dialogId > 0L) {
+            return UserConfig.getInstance(msg.currentAccount).clientUserId
+        }
+        return if (dialogId > 0L) dialogId else 0L
+    }
+
+    @JvmStatic
+    fun withoutBodyPrefix(text: CharSequence, bodyPrefix: Int): CharSequence {
+        if (bodyPrefix <= 0) {
+            return text
+        }
+        if (bodyPrefix >= text.length) {
+            return ""
+        }
+        if (text !is Spanned) {
+            return text.subSequence(bodyPrefix, text.length)
+        }
+        val builder = SpannableStringBuilder(text)
+        for (span in builder.getSpans(0, builder.length, Any::class.java)) {
+            if (span is NoCopySpan) {
+                continue
+            }
+            val spanStart = builder.getSpanStart(span)
+            val spanEnd = builder.getSpanEnd(span)
+            if (span is org.telegram.ui.Components.QuoteSpan || span is org.telegram.ui.Components.QuoteSpan.QuoteStyleSpan) {
+                if (spanStart < bodyPrefix) {
+                    builder.removeSpan(span)
+                }
+            } else if (spanEnd <= bodyPrefix) {
+                builder.removeSpan(span)
+            }
+        }
+        builder.delete(0, bodyPrefix)
+        for (span in builder.getSpans(0, builder.length, Any::class.java)) {
+            if (span !is NoCopySpan && builder.getSpanEnd(span) <= builder.getSpanStart(span)) {
+                builder.removeSpan(span)
+            }
+        }
+        return builder
+    }
+
+    private fun isOrdinaryText(item: MessageObject): Boolean {
+        val owner = item.messageOwner
+        return item.type == MessageObject.TYPE_TEXT &&
+            owner is TLRPC.TL_message &&
+            owner.rich_message == null &&
+            item.richLayout == null &&
+            item.isMediaEmptyWebpage &&
+            TextUtils.isEmpty(item.caption) &&
+            item.getGroupId() == 0L &&
+            !item.isRestrictedMessage &&
+            !item.isRepostPreview &&
+            !item.translated &&
+            !item.summarized &&
+            !(TeleConfig.SCRIPTING.value && tele.scripting.ScriptDisplay.hasReplacement(item)) &&
+            !owner.message.isNullOrEmpty()
+    }
+
+    private fun leadingQuote(item: MessageObject): LeadingQuote? {
+        val owner = item.messageOwner as? TLRPC.TL_message ?: return null
+        val text = owner.message ?: return null
+        val entities = owner.entities ?: return null
+        val sortedEntities = entities.sortedWith(entityComparator)
+        val outer = sortedEntities.firstOrNull {
+            it.offset == 0 && it is TLRPC.TL_messageEntityBlockquote
+        } ?: return null
+        var end = outer.length
+        val mergedBlockquotes = mutableSetOf<TLRPC.MessageEntity>(outer)
+        for (next in sortedEntities) {
+            if (next === outer || next !is TLRPC.TL_messageEntityBlockquote || next.offset != end) {
+                continue
+            }
+            if (end <= 0 || end >= text.length || text[end - 1] == '\n') {
+                break
+            }
+            if (next.collapsed != outer.collapsed || next.length <= 0 || next.length > text.length - end) {
+                return null
+            }
+            end += next.length
+            mergedBlockquotes.add(next)
+        }
+        val limit = MessagesController.getInstance(item.currentAccount).quoteLengthMax
+        if (end <= 0 || end > text.length || end > limit ||
+            end < text.length && Character.isHighSurrogate(text[end - 1]) && Character.isLowSurrogate(text[end]) ||
+            text.substring(0, end).isBlank()
+        ) {
+            return null
+        }
+        var prefix = end
+        while (prefix < text.length && text[prefix] == '\n') {
+            prefix++
+        }
+        val result = TLRPC.TL_textWithEntities().apply {
+            this.text = text.substring(0, end)
+        }
+        for (entity in sortedEntities) {
+            if (entity in mergedBlockquotes || entity.offset >= prefix) {
+                continue
+            }
+            if (entity is TLRPC.TL_messageEntityBlockquote ||
+                entity.offset < 0 ||
+                entity.length <= 0 ||
+                entity.offset > end ||
+                entity.length > end - entity.offset
+            ) {
+                return null
+            }
+            result.entities.add(copyEntitySlice(entity, 0, end) ?: return null)
+        }
+        return LeadingQuote(result, prefix)
+    }
+}
