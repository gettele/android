+        tele_replyQuoteSourceOwner = replyMessageObject == null ? null : replyMessageObject.messageOwner;
+        tele_replyQuoteSourceText = tele_replyQuoteSourceOwner != null ? tele_replyQuoteSourceOwner.message : null;
+    }
