From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?t=CE=B1ngenx?= <me@tangenx.dev>
Date: Thu, 1 Oct 2026 20:00:45 +0300
Subject: [PATCH] debloat: hide mention and reaction badges

---
 .../main/java/org/telegram/ui/Cells/DialogCell.java  | 12 +++++++++++-
 .../ChatActivitySideControlsButtonsLayout.java       |  4 ++++
 TMessagesProj/src/main/java/tele/TeleConfig.kt       |  2 ++
 .../java/tele/ui/settings/TeleSettingsActivity.kt    |  3 ++-
 4 files changed, 19 insertions(+), 2 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Cells/DialogCell.java b/TMessagesProj/src/main/java/org/telegram/ui/Cells/DialogCell.java
index 0fae7fdda..15dbf717b 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Cells/DialogCell.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Cells/DialogCell.java
@@ -78,6 +78,7 @@ import org.telegram.messenger.LocaleController;
 import org.telegram.messenger.MediaDataController;
 import org.telegram.messenger.MessageObject;
 import org.telegram.messenger.MessagesController;
+import tele.TeleConfig;
 import org.telegram.messenger.MessagesStorage;
 import org.telegram.messenger.NotificationCenter;
 import org.telegram.messenger.R;
@@ -2106,6 +2107,10 @@ public class DialogCell extends BaseCell implements StoriesListPlaceProvider.Ava
                             drawCount = true;
                             drawMention = false;
                             countString = String.format("%d", unreadCount + mentionCount);
+                        } else if (TeleConfig.HIDE_MENTION_REACTIONS.getValue()) {
+                            drawCount = true;
+                            drawMention = false;
+                            countString = String.format("%d", unreadCount + mentionCount);
                         } else {
                             drawCount = false;
                             drawMention = true;
@@ -2130,7 +2135,7 @@ public class DialogCell extends BaseCell implements StoriesListPlaceProvider.Ava
                     } else {
                         drawCount = false;
                     }
-                    if (mentionCount != 0) {
+                    if (mentionCount != 0 && !TeleConfig.HIDE_MENTION_REACTIONS.getValue()) {
                         drawMention = true;
                         mentionString = "@";
                     } else {
@@ -2140,6 +2145,11 @@ public class DialogCell extends BaseCell implements StoriesListPlaceProvider.Ava
                     drawPollVotesMention = pollVotesMentionCount > 0;
                 }
 
+                if (TeleConfig.HIDE_MENTION_REACTIONS.getValue()) {
+                    drawMention = false;
+                    drawReactionMention = false;
+                }
+
                 if (message.isOut() && draftMessage == null && showChecks && !(message.messageOwner.action instanceof TLRPC.TL_messageActionHistoryClear)) {
                     if (message.isSending()) {
                         drawCheck1 = false;
diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Components/chat/layouts/ChatActivitySideControlsButtonsLayout.java b/TMessagesProj/src/main/java/org/telegram/ui/Components/chat/layouts/ChatActivitySideControlsButtonsLayout.java
index a23f816a3..ba1638a3a 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Components/chat/layouts/ChatActivitySideControlsButtonsLayout.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Components/chat/layouts/ChatActivitySideControlsButtonsLayout.java
@@ -22,6 +22,7 @@ import org.telegram.ui.Components.blur3.drawable.color.BlurredBackgroundColorPro
 import org.telegram.ui.Components.chat.buttons.ChatActivityBlurredRoundPageDownButton;
 
 import me.vkryl.android.AnimatorUtils;
+import tele.TeleConfig;
 import me.vkryl.android.animator.BoolAnimator;
 import me.vkryl.android.animator.FactorAnimator;
 
@@ -110,6 +111,9 @@ public class ChatActivitySideControlsButtonsLayout extends FrameLayout implement
     }
 
     public void showButton(final int buttonId, boolean show, boolean animated) {
+        if (TeleConfig.HIDE_MENTION_REACTIONS.getValue() && (buttonId == BUTTON_MENTION || buttonId == BUTTON_REACTIONS)) {
+            show = false;
+        }
         if (buttonHolders[buttonId] == null && !show) {
             return;
         }
diff --git a/TMessagesProj/src/main/java/tele/TeleConfig.kt b/TMessagesProj/src/main/java/tele/TeleConfig.kt
index 54dbe229f..9cb7330a2 100644
--- a/TMessagesProj/src/main/java/tele/TeleConfig.kt
+++ b/TMessagesProj/src/main/java/tele/TeleConfig.kt
@@ -56,6 +56,8 @@ object TeleConfig {
     val NAME_INSTEAD_OF_PHONE = BoolItem("name_instead_of_phone", false)
     @JvmField
     val REVEAL_SPOILERS = BoolItem("reveal_spoilers", false)
+    @JvmField
+    val HIDE_MENTION_REACTIONS = BoolItem("hide_mention_reactions", false)
 
     private var prefs: SharedPreferences? = null
 
diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
index 96abf6004..0c80e511e 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
@@ -73,7 +73,8 @@ class TeleSettingsActivity : BaseFragment() {
             Row(TYPE_TOGGLE, "confirm calls before starting", item = TeleConfig.CONFIRM_CALLS),
             Row(TYPE_TOGGLE, "open links without confirmation", item = TeleConfig.OPEN_LINKS_DIRECTLY),
             Row(TYPE_TOGGLE, "show names instead of phone numbers in chat headers", item = TeleConfig.NAME_INSTEAD_OF_PHONE),
-            Row(TYPE_TOGGLE, "reveal spoilers automatically", item = TeleConfig.REVEAL_SPOILERS)
+            Row(TYPE_TOGGLE, "reveal spoilers automatically", item = TeleConfig.REVEAL_SPOILERS),
+            Row(TYPE_TOGGLE, "hide mention and reaction badges", item = TeleConfig.HIDE_MENTION_REACTIONS)
         )
 
         override fun getItemCount(): Int = rows.size
