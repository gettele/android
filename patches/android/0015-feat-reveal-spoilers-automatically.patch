From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?t=CE=B1ngenx?= <me@tangenx.dev>
Date: Thu, 1 Oct 2026 19:55:15 +0300
Subject: [PATCH 015/128] feat: reveal spoilers automatically

---
 .../src/main/java/org/telegram/messenger/MessageObject.java | 6 ++++--
 TMessagesProj/src/main/java/tele/TeleConfig.kt              | 2 ++
 .../src/main/java/tele/ui/settings/TeleSettingsActivity.kt  | 3 ++-
 3 files changed, 8 insertions(+), 3 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/messenger/MessageObject.java b/TMessagesProj/src/main/java/org/telegram/messenger/MessageObject.java
index ec503d938..d6ffa4db2 100644
--- a/TMessagesProj/src/main/java/org/telegram/messenger/MessageObject.java
+++ b/TMessagesProj/src/main/java/org/telegram/messenger/MessageObject.java
@@ -95,6 +95,8 @@ import org.telegram.ui.Components.VideoPlayer;
 import org.telegram.ui.Components.WebPlayerView;
 import org.telegram.ui.Components.poll.PollAttachedMediaPack;
 import org.telegram.ui.Components.spoilers.SpoilerEffect;
+import org.telegram.ui.Components.spoilers.SpoilerEffect;
+import tele.TeleConfig;
 import org.telegram.ui.LaunchActivity;
 import org.telegram.ui.PeerColorActivity;
 import org.telegram.ui.PhotoViewer;
@@ -646,7 +648,7 @@ public class MessageObject {
     }
 
     public boolean hasMediaSpoilers() {
-        return !isRepostPreview && (messageOwner.media != null && messageOwner.media.spoiler || needDrawBluredPreview()) || isHiddenSensitive();
+        return !isRepostPreview && (messageOwner.media != null && messageOwner.media.spoiler && !TeleConfig.REVEAL_SPOILERS.getValue() || needDrawBluredPreview()) || isHiddenSensitive();
     }
 
     public Boolean isSensitiveCached;
@@ -8175,7 +8177,7 @@ public class MessageObject {
             newRun.start = entity.offset;
             newRun.end = newRun.start + entity.length;
             TLRPC.MessageEntity urlEntity = null;
-            if (entity instanceof TLRPC.TL_messageEntitySpoiler) {
+            if (entity instanceof TLRPC.TL_messageEntitySpoiler && !TeleConfig.REVEAL_SPOILERS.getValue()) {
                 newRun.flags = TextStyleSpan.FLAG_STYLE_SPOILER;
             } else if (entity instanceof TLRPC.TL_messageEntityStrike) {
                 newRun.flags = TextStyleSpan.FLAG_STYLE_STRIKE;
diff --git a/TMessagesProj/src/main/java/tele/TeleConfig.kt b/TMessagesProj/src/main/java/tele/TeleConfig.kt
index 5d48c2eae..54dbe229f 100644
--- a/TMessagesProj/src/main/java/tele/TeleConfig.kt
+++ b/TMessagesProj/src/main/java/tele/TeleConfig.kt
@@ -54,6 +54,8 @@ object TeleConfig {
     val OPEN_LINKS_DIRECTLY = BoolItem("open_links_directly", false)
     @JvmField
     val NAME_INSTEAD_OF_PHONE = BoolItem("name_instead_of_phone", false)
+    @JvmField
+    val REVEAL_SPOILERS = BoolItem("reveal_spoilers", false)
 
     private var prefs: SharedPreferences? = null
 
diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
index aaeb85cf1..96abf6004 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
@@ -72,7 +72,8 @@ class TeleSettingsActivity : BaseFragment() {
             Row(TYPE_TOGGLE, "hide call buttons", item = TeleConfig.HIDE_CALL_BUTTONS),
             Row(TYPE_TOGGLE, "confirm calls before starting", item = TeleConfig.CONFIRM_CALLS),
             Row(TYPE_TOGGLE, "open links without confirmation", item = TeleConfig.OPEN_LINKS_DIRECTLY),
-            Row(TYPE_TOGGLE, "show names instead of phone numbers in chat headers", item = TeleConfig.NAME_INSTEAD_OF_PHONE)
+            Row(TYPE_TOGGLE, "show names instead of phone numbers in chat headers", item = TeleConfig.NAME_INSTEAD_OF_PHONE),
+            Row(TYPE_TOGGLE, "reveal spoilers automatically", item = TeleConfig.REVEAL_SPOILERS)
         )
 
         override fun getItemCount(): Int = rows.size
