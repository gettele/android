@@ -51,6 +51,8 @@ class TeleNoticesActivity : BaseFragment() {
     private var shown: List<TeleNotice> = emptyList()
     private var built = false
     private val fresh = HashSet<Long>()
+    // entries opened with "Show more"; the cells are recycled, so the state lives here
+    private val expanded = HashSet<Long>()
     private var adapter: Adapter? = null
     private var list: RecyclerListView? = null
     private val listener = TeleNotices.Listener { target -> if (target == account) changed() }
@@ -238,7 +240,10 @@ class TeleNoticesActivity : BaseFragment() {
                     setPadding(AndroidUtilities.dp(32f), AndroidUtilities.dp(48f), AndroidUtilities.dp(32f), AndroidUtilities.dp(16f))
                 }
             } else {
-                TeleNoticeCell(context).apply { onButton = { button -> openLink(button.url) } }
+                TeleNoticeCell(context).apply {
+                    onButton = { button -> openLink(button.url) }
+                    onExpand = { notice, open -> if (open) expanded.add(notice.id) else expanded.remove(notice.id) }
+                }
             }
             view.layoutParams = RecyclerView.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT)
             return RecyclerListView.Holder(view)
@@ -251,7 +256,7 @@ class TeleNoticesActivity : BaseFragment() {
                 return
             }
             val notice = shown[position]
-            (holder.itemView as TeleNoticeCell).set(notice, fresh.contains(notice.id))
+            (holder.itemView as TeleNoticeCell).set(notice, fresh.contains(notice.id), expanded.contains(notice.id))
         }
     }
 
