diff --git a/TMessagesProj/src/main/java/org/telegram/ui/CalendarActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/CalendarActivity.java
index 2334714f1..728397c2e 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/CalendarActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/CalendarActivity.java
@@ -1251,7 +1251,16 @@ public class CalendarActivity extends BaseFragment implements NotificationCenter
                     imagesByDays = null;
                 }
             }
-            if (messagesByDays != null) {
+            if (tele.TeleConfig.PLAIN_SEARCH_CALENDAR.getValue()) {
+                if (imagesByDays != null) {
+                    for (int i = 0; i < imagesByDays.size(); i++) {
+                        imagesByDays.valueAt(i).onDetachedFromWindow();
+                        imagesByDays.valueAt(i).setParentView(null);
+                    }
+                }
+                imagesByDays = new SparseArray<>();
+            }
+            if (messagesByDays != null && !tele.TeleConfig.PLAIN_SEARCH_CALENDAR.getValue()) {
                 if (imagesByDays == null) {
                     imagesByDays = new SparseArray<>();
                 }
@@ -1360,7 +1369,7 @@ public class CalendarActivity extends BaseFragment implements NotificationCenter
                     textPaint.setAlpha((int) (oldAlpha * 0.3f));
                     canvas.drawText(Integer.toString(i + 1), cx, cy + dp(5), textPaint);
                     textPaint.setAlpha(oldAlpha);
-                } else if (day != null && day.hasImage) {
+                } else if (!tele.TeleConfig.PLAIN_SEARCH_CALENDAR.getValue() && day != null && day.hasImage) {
                     float alpha = 1f;
                     if (imagesByDays.get(i) != null) {
                         if (checkEnterItems && !day.wasDrawn) {
