diff --git a/TMessagesProj/src/main/java/tele/helpers/DockedIngress.kt b/TMessagesProj/src/main/java/tele/helpers/DockedIngress.kt
new file mode 100644
index 000000000..f8fe5d677
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/DockedIngress.kt
@@ -0,0 +1,300 @@
+package tele.helpers
+
+import android.graphics.BitmapFactory
+import android.media.MediaMetadataRetriever
+import android.net.Uri
+import android.text.TextUtils
+import android.webkit.MimeTypeMap
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.ApplicationLoader
+import org.telegram.messenger.MediaController
+import org.telegram.messenger.R
+import org.telegram.messenger.SendMessagesHelper
+import org.telegram.messenger.Utilities
+import org.telegram.ui.ChatActivity
+import org.telegram.ui.Components.BulletinFactory
+import java.io.File
+
+/** Clipboard, IME and external share ingress into the tray: every call docks all of its input or nothing. */
+object DockedIngress {
+    private class Source(val path: String?, val uri: Uri?, val isVideo: Boolean)
+    private class Staged(
+        val entries: List<MediaController.PhotoEntry>,
+        val files: List<String>,
+        val names: List<String>,
+        val copied: List<File>
+    )
+
+    @JvmStatic
+    fun dockPaste(fragment: ChatActivity, entry: MediaController.PhotoEntry): Boolean {
+        if (!dockable(fragment)) return false
+        val path = entry.path ?: return false
+        if (!ownedFile(path)) return false
+        fillImageBounds(entry, path)
+        return DockedMedia.appendEntries(fragment, arrayListOf(entry), false, null)
+    }
+
+    @JvmStatic
+    fun dockShared(
+        fragment: ChatActivity,
+        media: ArrayList<SendMessagesHelper.SendingMediaInfo>?,
+        videoPath: String?,
+        documentsPaths: ArrayList<String>?,
+        documentsUris: ArrayList<Uri>?,
+        caption: CharSequence?,
+        forceDocument: Boolean,
+        notify: Boolean,
+        scheduleDate: Int
+    ): Boolean = dockShare(fragment, media, videoPath, documentsPaths, documentsUris, caption, forceDocument, notify, scheduleDate, true)
+
+    @JvmStatic
+    fun dockSendingMedia(
+        fragment: ChatActivity,
+        infos: ArrayList<SendMessagesHelper.SendingMediaInfo>?,
+        forceDocument: Boolean,
+        notify: Boolean,
+        scheduleDate: Int
+    ): Boolean = dockShare(fragment, infos, null, null, null, null, forceDocument, notify, scheduleDate, false)
+
+    private fun dockShare(
+        fragment: ChatActivity,
+        media: ArrayList<SendMessagesHelper.SendingMediaInfo>?,
+        videoPath: String?,
+        documentsPaths: ArrayList<String>?,
+        documentsUris: ArrayList<Uri>?,
+        caption: CharSequence?,
+        forceDocument: Boolean,
+        notify: Boolean,
+        scheduleDate: Int,
+        requireDefault: Boolean
+    ): Boolean {
+        if (!notify || scheduleDate != 0) return false
+        if (!dockable(fragment) || requireDefault && fragment.chatMode != ChatActivity.MODE_DEFAULT) return false
+        val fieldAtStart = fragment.chatActivityEnterView?.getFieldText()?.toString().orEmpty()
+
+        val sources = ArrayList<Source>()
+        for (info in media.orEmpty()) {
+            if (info.isLivePhoto) return false
+            val path = info.path ?: info.imagePath
+            val uri = if (path == null) info.uri else null
+            if (path == null && uri == null) return false
+            sources.add(Source(path, uri, info.isVideo))
+        }
+        if (!TextUtils.isEmpty(videoPath)) {
+            val video = videoPath ?: return false
+            if (video.isEmpty()) return false
+            sources.add(Source(video, null, true))
+        }
+        val documents = ArrayList<Source>()
+        for (path in documentsPaths.orEmpty()) documents.add(Source(path, null, false))
+        for (uri in documentsUris.orEmpty()) documents.add(Source(null, uri, false))
+        if (sources.isEmpty() && documents.isEmpty()) return false
+
+        var text = caption
+        if (TextUtils.isEmpty(text)) text = media?.firstOrNull { !TextUtils.isEmpty(it.caption) }?.caption
+
+        val account = fragment.currentAccount
+        val generation = TeleAccounts.generation(account)
+        val dialogId = fragment.dialogId
+        val threadId = fragment.threadId
+        val mode = fragment.chatMode
+        Utilities.globalQueue.postRunnable {
+            val staged = runCatching { stage(sources, documents) }.getOrNull()
+            AndroidUtilities.runOnUIThread {
+                if (!sameContext(fragment, account, generation, dialogId, threadId, mode)) {
+                    discard(staged)
+                    return@runOnUIThread
+                }
+                if (staged == null) {
+                    showError(fragment, account, "docked-ingress-copy", copyFailed())
+                    return@runOnUIThread
+                }
+                if (!dockable(fragment) || fragment.chatMode != mode) {
+                    discard(staged)
+                    showError(fragment, account, "docked-ingress-attach", attachFailed())
+                    return@runOnUIThread
+                }
+                val current = fragment.chatActivityEnterView?.getFieldText()?.toString().orEmpty()
+                val captionToUse = if (current == fieldAtStart) text else null
+                if (!DockedMedia.appendShared(fragment, staged.entries, staged.files, staged.names, forceDocument, captionToUse)) {
+                    discard(staged)
+                    showError(fragment, account, "docked-ingress-attach", attachFailed())
+                }
+            }
+        }
+        return true
+    }
+
+    @JvmStatic
+    fun dockInputContent(fragment: ChatActivity, uri: Uri?, mime: String?): Boolean {
+        if (uri == null) return false
+        if (!dockable(fragment) || AndroidUtilities.isInternalUri(uri)) return false
+        val type = mime ?: ApplicationLoader.applicationContext.contentResolver.getType(uri).orEmpty()
+        val extension = when {
+            type.startsWith("video/") -> "mp4"
+            type == "image/gif" -> "gif"
+            type.startsWith("image/") -> "jpg"
+            else -> "file"
+        }
+        val account = fragment.currentAccount
+        val generation = TeleAccounts.generation(account)
+        val dialogId = fragment.dialogId
+        val threadId = fragment.threadId
+        val mode = fragment.chatMode
+        Utilities.globalQueue.postRunnable {
+            val path = copy(uri, extension)
+            val valid = path != null && ownedFile(path)
+            val entry = if (valid) when {
+                type == "image/gif" || !type.startsWith("image/") && !type.startsWith("video/") -> null
+                type.startsWith("video/") -> mediaEntry(path!!, true)
+                else -> mediaEntry(path!!, false)
+            } else null
+            AndroidUtilities.runOnUIThread {
+                if (!sameContext(fragment, account, generation, dialogId, threadId, mode)) {
+                    path?.let { File(it).delete() }
+                    return@runOnUIThread
+                }
+                if (!valid || path == null) {
+                    path?.let { File(it).delete() }
+                    showError(fragment, account, "docked-ingress-copy", copyFailed())
+                    return@runOnUIThread
+                }
+                val file = File(path)
+                val docked = if (entry != null) {
+                    DockedMedia.appendShared(fragment, arrayListOf(entry), emptyList(), null, false, null)
+                } else {
+                    DockedMedia.appendShared(fragment, emptyList(), arrayListOf(file.absolutePath), arrayListOf(file.name), false, null)
+                }
+                if (!docked) {
+                    file.delete()
+                    showError(fragment, account, "docked-ingress-attach", attachFailed())
+                }
+            }
+        }
+        return true
+    }
+
+    private fun stage(sources: List<Source>, documents: List<Source>): Staged? {
+        val entries = ArrayList<MediaController.PhotoEntry>()
+        val files = ArrayList<String>()
+        val names = ArrayList<String>()
+        val copied = ArrayList<File>()
+        try {
+            for (source in sources) {
+                val path = source.path ?: copy(source.uri!!, null)?.also { copied.add(File(it)) }
+                if (path == null || !ownedFile(path)) return discard(copied)
+                entries.add(mediaEntry(path, source.isVideo))
+            }
+            for (document in documents) {
+                val path = document.path ?: copy(document.uri!!, null)?.also { copied.add(File(it)) }
+                if (path == null || !ownedFile(path)) return discard(copied)
+                val file = File(path)
+                files.add(file.absolutePath)
+                names.add(file.name)
+            }
+        } catch (t: Throwable) {
+            return discard(copied)
+        }
+        return Staged(entries, files, names, copied)
+    }
+
+    private fun sameContext(
+        fragment: ChatActivity,
+        account: Int,
+        generation: Long,
+        dialogId: Long,
+        threadId: Long,
+        mode: Int
+    ): Boolean {
+        return TeleAccounts.isCurrent(account, generation) && fragment.currentAccount == account &&
+            fragment.dialogId == dialogId && fragment.threadId == threadId && fragment.chatMode == mode &&
+            fragment.getParentActivity() != null && fragment.getFragmentView() != null
+    }
+
+    private fun discard(staged: Staged?) {
+        if (staged != null) discard(staged.copied)
+    }
+
+    private fun discard(copied: List<File>): Staged? {
+        for (file in copied) runCatching { file.delete() }
+        return null
+    }
+
+    private fun dockable(fragment: ChatActivity): Boolean {
+        val enter = fragment.chatActivityEnterView ?: return false
+        val mode = fragment.chatMode
+        return !enter.isEditingMessage && !fragment.isSecretChat() && DockedMedia.enabled() &&
+            (mode == ChatActivity.MODE_DEFAULT || mode == ChatActivity.MODE_SCHEDULED || mode == ChatActivity.MODE_QUICK_REPLIES)
+    }
+
+    private fun ownedFile(path: String): Boolean {
+        val file = File(path)
+        return file.isFile && !AndroidUtilities.isInternalUri(Uri.fromFile(file))
+    }
+
+    private fun mediaEntry(path: String, isVideo: Boolean): MediaController.PhotoEntry {
+        val file = File(path)
+        var width = 0
+        var height = 0
+        var duration = 0
+        if (isVideo) {
+            val retriever = MediaMetadataRetriever()
+            try {
+                retriever.setDataSource(path)
+                val w = retriever.extractMetadata(MediaMetadataRetriever.METADATA_KEY_VIDEO_WIDTH)?.toIntOrNull() ?: 0
+                val h = retriever.extractMetadata(MediaMetadataRetriever.METADATA_KEY_VIDEO_HEIGHT)?.toIntOrNull() ?: 0
+                val rotation = retriever.extractMetadata(MediaMetadataRetriever.METADATA_KEY_VIDEO_ROTATION)?.toIntOrNull() ?: 0
+                if (rotation == 90 || rotation == 270) {
+                    width = h
+                    height = w
+                } else {
+                    width = w
+                    height = h
+                }
+                duration = ((retriever.extractMetadata(MediaMetadataRetriever.METADATA_KEY_DURATION)?.toLongOrNull() ?: 0L) / 1000L).toInt()
+            } catch (t: Throwable) {
+            } finally {
+                runCatching { retriever.release() }
+            }
+        } else {
+            val options = BitmapFactory.Options()
+            options.inJustDecodeBounds = true
+            runCatching { BitmapFactory.decodeFile(path, options) }
+            width = options.outWidth.coerceAtLeast(0)
+            height = options.outHeight.coerceAtLeast(0)
+        }
+        val orientation = if (isVideo) null else runCatching { AndroidUtilities.getImageOrientation(path) }.getOrNull()
+        val entry = MediaController.PhotoEntry(0, -1, 0, path, if (isVideo) duration else (orientation?.first ?: 0), isVideo, width, height, file.length())
+        if (orientation != null) entry.setOrientation(orientation)
+        if (!isVideo) entry.isLivePhoto()
+        return entry
+    }
+
+    private fun fillImageBounds(entry: MediaController.PhotoEntry, path: String) {
+        if (entry.width <= 0 || entry.height <= 0) {
+            val options = BitmapFactory.Options()
+            options.inJustDecodeBounds = true
+            runCatching { BitmapFactory.decodeFile(path, options) }
+            if (options.outWidth > 0) entry.width = options.outWidth
+            if (options.outHeight > 0) entry.height = options.outHeight
+        }
+        if (entry.size <= 0) entry.size = File(path).length()
+    }
+
+    private fun copy(uri: Uri, ext: String?): String? {
+        if (AndroidUtilities.isInternalUri(uri)) return null
+        val extension = ext ?: MimeTypeMap.getSingleton().getExtensionFromMimeType(
+            ApplicationLoader.applicationContext.contentResolver.getType(uri)
+        ) ?: "file"
+        return runCatching { MediaController.copyFileToCache(uri, extension) }.getOrNull()
+    }
+
+    private fun showError(fragment: ChatActivity, account: Int, site: String, text: CharSequence) {
+        TeleToast.log(site, text, account = account)
+        val factory = if (fragment.getParentActivity() != null) BulletinFactory.of(fragment) else BulletinFactory.global()
+        factory.createSimpleBulletin(R.raw.error, text).show()
+    }
+
+    private fun copyFailed(): CharSequence = TeleLowercase.lc("Could not copy the shared files. Try again.")
+    private fun attachFailed(): CharSequence = TeleLowercase.lc("The shared files could not be attached. Try again.")
+}
