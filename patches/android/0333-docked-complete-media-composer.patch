+            cells.add(DockedCell(segment.from + i, rect, tl, tr, bl, br))
+        }
+
+        var albumHeight = rowTop[maxRow + 1]
+        var albumWidth = 0f
+        for (cell in cells) albumWidth = max(albumWidth, cell.rect.right)
+        val factor = if (albumHeight > capPx && albumHeight > 0f) capPx / albumHeight else 1f
+        if (factor < 1f) {
+            for (cell in cells) {
+                cell.rect.set(
+                    cell.rect.left * factor, cell.rect.top * factor,
+                    cell.rect.right * factor, cell.rect.bottom * factor
+                )
+            }
+            albumHeight *= factor
+            albumWidth *= factor
+        }
+        return DockedAlbum(cells, albumWidth, albumHeight)
+    }
+}
