+++ b/TMessagesProj/src/main/java/tele/ui/DockedGridLayout.kt
@@ -0,0 +1,195 @@
+package tele.ui
+
+import android.graphics.RectF
+import org.telegram.messenger.MessageObject
+import org.telegram.messenger.RichMessageLayout
+import tele.helpers.DockedMedia
+import kotlin.math.max
+import kotlin.math.min
+
+internal data class DockedSegment(val from: Int, val till: Int, val album: Boolean)
+
+internal data class DockedCell(
+    val index: Int,
+    val rect: RectF,
+    val tl: Float,
+    val tr: Float,
+    val bl: Float,
+    val br: Float,
+)
+
+internal data class DockedAlbum(val cells: List<DockedCell>, val width: Float, val height: Float)
+
+/** Splits a tray into the send groups and lays out the albums with the grouped-media engine. */
+internal object DockedGridLayout {
+    const val MAX_ALBUM = 10
+    private const val NORM_WIDTH = 1000f
+    private const val NORM_HEIGHT = 814f
+
+    fun albumable(item: DockedMedia.Item): Boolean =
+        !item.isFile && !item.isSticker && !item.asFile && item.ttl == 0 &&
+            item.width > 0 && item.height > 0
+
+    fun segments(items: List<DockedMedia.Item>, group: Boolean): List<DockedSegment> {
+        val result = ArrayList<DockedSegment>()
+        var start = -1
+
+        fun flush(till: Int) {
+            if (start < 0) return
+            var from = start
+            while (from < till) {
+                val end = min(till, from + MAX_ALBUM)
+                result.add(DockedSegment(from, end, group && end - from > 1))
+                from = end
+            }
+            start = -1
+        }
+
+        for (i in items.indices) {
+            if (!albumable(items[i])) {
+                flush(i)
+                result.add(DockedSegment(i, i + 1, false))
+                continue
+            }
+            if (start < 0) {
+                start = i
+            } else if (i - start == MAX_ALBUM) {
+                flush(i)
+                start = i
+            }
+        }
+        flush(items.size)
+        return result
+    }
+
+    fun gridAvailable(items: List<DockedMedia.Item>, group: Boolean): Boolean =
+        segments(items, group).any { it.album }
+
+    /**
+     * Lays out one album into cell rectangles; the result is scaled uniformly down to [capPx].
+     */
+    fun album(
+        items: List<DockedMedia.Item>,
+        segment: DockedSegment,
+        maxWidthPx: Int,
+        capPx: Int,
+        gapPx: Float,
+        outerRadiusPx: Float,
+        innerRadiusPx: Float,
+    ): DockedAlbum? {
+        if (!segment.album || segment.till - segment.from < 2) return null
+        val count = segment.till - segment.from
+
+        val ratios = FloatArray(count)
+        for (k in 0 until count) {
+            val item = items[segment.from + k]
+            var w = item.width.toFloat()
+            var h = item.height.toFloat()
+            // PhotoEntry and SavedDrafts store the rotation in degrees, not the Exif 5..8 codes
+            val turned = ((item.orientation % 360) + 360) % 360
+            if (turned == 90 || turned == 270) {
+                val t = w
+                w = h
+                h = t
+            }
+            ratios[k] = if (w > 0f && h > 0f) w / h else 1f
+        }
+
+        val positions = RichMessageLayout.computeGrouped(ratios)
+        if (positions.size != count) return null
+
+        var maxRow = 0
+        for (p in positions) maxRow = max(maxRow, p.maxY.toInt())
+        val rowHeight = FloatArray(maxRow + 1)
+        for (p in positions) {
+            if (p.minY == p.maxY) {
+                rowHeight[p.minY.toInt()] = max(rowHeight[p.minY.toInt()], p.ph)
+            }
+        }
+        for (p in positions) {
+            if (p.minY == p.maxY) continue
+            val span = (p.maxY - p.minY + 1).toInt()
+            val sibling = p.siblingHeights
+            if (sibling != null && sibling.size == span) {
+                for (r in 0 until span) {
+                    val row = p.minY.toInt() + r
+                    rowHeight[row] = max(rowHeight[row], sibling[r])
+                }
+            } else {
+                val per = p.ph / span
+                for (r in p.minY..p.maxY) {
+                    rowHeight[r.toInt()] = max(rowHeight[r.toInt()], per)
+                }
+            }
+        }
+
+        val unit = maxWidthPx / NORM_WIDTH
+        val rowTop = FloatArray(maxRow + 2)
+        var acc = 0f
+        for (r in 0..maxRow) {
+            rowTop[r] = acc * NORM_HEIGHT * unit
+            acc += rowHeight[r]
+        }
+        rowTop[maxRow + 1] = acc * NORM_HEIGHT * unit
+
+        val halfGap = gapPx / 2f
+        val cells = ArrayList<DockedCell>(count)
+        for (i in 0 until count) {
+            val p = positions[i]
+            val top = rowTop[p.minY.toInt()]
+            val height = rowTop[p.maxY.toInt() + 1] - top
+
+            var leftUnits = 0
+            for (j in positions.indices) {
+                if (j == i) continue
+                val q = positions[j]
