+            if ((p.flags and MessageObject.POSITION_FLAG_BOTTOM) == 0) rect.bottom -= halfGap
+            if ((p.flags and MessageObject.POSITION_FLAG_LEFT) == 0) rect.left += halfGap
+            if ((p.flags and MessageObject.POSITION_FLAG_RIGHT) == 0) rect.right -= halfGap
