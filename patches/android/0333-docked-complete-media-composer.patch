+    /**
+     * Moves a picker selection into the docked tray instead of sending it, when the current
+     * conversation supports docking. Returns true when the selection was docked and the sheet
+     * was dismissed, in which case the caller must not send anything.
+     */
+    public boolean tele_dockFromPicker(boolean forceDocument, boolean group, boolean invert) {
+        if (!tele.helpers.DockedMedia.enabled() || buttonPressed
+                || !(baseFragment instanceof ChatActivity)
+                || !(currentAttachLayout == photoLayout || currentAttachLayout == photoPreviewLayout)
+                || photoLayout == null || editingMessageObject != null || isPhotoPicker || isStickerMode
+                || animatorEphemeralMessageVisibility.getValue()) {
+            return false;
+        }
+        final ChatActivity chatActivity = (ChatActivity) baseFragment;
+        final int mode = chatActivity.getChatMode();
+        if (mode != ChatActivity.MODE_DEFAULT && mode != ChatActivity.MODE_SCHEDULED && mode != ChatActivity.MODE_QUICK_REPLIES) {
+            return false;
+        }
+        final HashMap<Object, Object> selectedPhotos = photoLayout.getSelectedPhotos();
+        final ArrayList<Object> selectedPhotosOrder = photoLayout.getSelectedPhotosOrder();
+        if (selectedPhotos.isEmpty() || selectedPhotos.size() != selectedPhotosOrder.size()) {
+            return false;
+        }
+        // web images and live photos have no file to dock
+        for (int a = 0; a < selectedPhotosOrder.size(); a++) {
+            final Object entry = selectedPhotos.get(selectedPhotosOrder.get(a));
+            if (!(entry instanceof MediaController.PhotoEntry) || ((MediaController.PhotoEntry) entry).isLivePhoto()) {
+                return false;
+            }
+        }
+        if (checkCaption(getCommentView().getText())) {
+            return true;
+        }
+        applyCaption();
+        if (!tele.helpers.DockedMedia.dock(chatActivity, chatActivity.getChatActivityEnterView(), selectedPhotos, selectedPhotosOrder,
+                forceDocument, group, invert, true, 0, 0L, false)) {
+            return false;
+        }
+        setButtonPressed(true);
+        dismiss(true);
+        return true;
+    }
+
