+++ b/TMessagesProj/src/main/java/tele/helpers/GiftQuantity.kt
@@ -0,0 +1,153 @@
+package tele.helpers
+
+import android.content.Context
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.NotificationCenter
+import org.telegram.messenger.R
+import org.telegram.tgnet.TLRPC
+import org.telegram.tgnet.tl.TL_stars
+import org.telegram.ui.ActionBar.AlertDialog
+import org.telegram.ui.ActionBar.BaseFragment
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.ChatActivity
+import org.telegram.ui.Components.BulletinFactory
+import org.telegram.ui.LaunchActivity
+import org.telegram.ui.Stars.StarsController
+import org.telegram.ui.Stars.StarsIntroActivity
+import tele.TeleConfig
+
+/**
+ * Sending several star gifts at once (desktop 0184): the quantity limits, the confirmation of the
+ * total and the sequential sending. It stops at the first error and never repeats a send whose
+ * result is unknown.
+ */
+object GiftQuantity {
+
+    // there is no limit for plain gifts; the confirmation shows the total anyway
+    private const val UNLIMITED = 100
+
+    /** The sheet reacts to what happens to the batch. All the calls are on the UI thread. */
+    interface Listener {
+        /** The batch passed the confirmation and the lock and is about to send. */
+        fun onStart()
+
+        /** The [index]th (from 1) of [total] gifts is being sent. */
+        fun onProgress(index: Int, total: Int)
+
+        /** The batch ended; [sent] gifts left. */
+        fun onFinish(sent: Int)
+    }
+
+    /** What to send. [price] is the Stars one gift is expected to cost, the batch stops when the server asks for more. */
+    class Request(
+        @JvmField val currentAccount: Int,
+        @JvmField val gift: TL_stars.StarGift,
+        @JvmField val dialogId: Long,
+        @JvmField val anonymous: Boolean,
+        @JvmField val upgrade: Boolean,
+        @JvmField val message: TLRPC.TL_textWithEntities?,
+        @JvmField val count: Int,
+        @JvmField val price: Long,
+        @JvmField val name: String,
+        @JvmField val self: Boolean
+    )
+
+    /** Only plain star gifts: collectibles and auctions have their own sheets. */
+    @JvmStatic
+    fun applies(gift: TL_stars.StarGift?, auction: Boolean): Boolean =
+        TeleConfig.GIFT_QUANTITY.value && gift != null && !auction && !gift.auction && gift !is TL_stars.TL_starGiftUnique
+
+    /** The most gifts that can go out in one batch: what the gift has left in total and for the user. */
+    @JvmStatic
+    fun max(gift: TL_stars.StarGift): Int {
+        var result = UNLIMITED
+        if (gift.limited_per_user) result = minOf(result, gift.per_user_remains)
+        if (gift.limited) result = minOf(result, gift.availability_remains)
+        return maxOf(result, 1)
+    }
+
+    /** Asks for the total, passes the lock and sends. */
+    @JvmStatic
+    fun confirmAndSend(
+        context: Context,
+        resourcesProvider: Theme.ResourcesProvider?,
+        fragment: BaseFragment?,
+        request: Request,
+        listener: Listener
+    ) {
+        val total = request.price * request.count
+        val stars = "XTR " + LocaleController.formatNumber(total, ',')
+        val text = StarsIntroActivity.replaceStarsWithPlain(
+            LocaleController.formatString(
+                if (request.self) R.string.TeleGiftsSendConfirmSelf else R.string.TeleGiftsSendConfirm,
+                request.count, request.name, stars
+            ),
+            .66f
+        )
+        AlertDialog.Builder(context, resourcesProvider)
+            .setMessage(text)
+            .setPositiveButton(LocaleController.getString(R.string.Send)) { _, _ ->
+                // the whole batch is one protected action
+                StarsLock.guard(fragment, "send_gift") { start(context, resourcesProvider, request, total, listener) }
+            }
+            .setNegativeButton(LocaleController.getString(R.string.Cancel), null)
+            .show()
+    }
+
+    private fun start(context: Context, resourcesProvider: Theme.ResourcesProvider?, request: Request, total: Long, listener: Listener) {
+        val stars = StarsController.getInstance(request.currentAccount)
+        val run = Runnable {
+            listener.onStart()
+            send(request, listener)
+        }
+        if (stars.balanceAvailable() && stars.balance.amount < total) {
+            // the same top-up sheet as the stock sending; the batch starts once the Stars arrive
+            StarsIntroActivity.StarsNeededSheet(
+                context, resourcesProvider, total, StarsIntroActivity.StarsNeededSheet.TYPE_STAR_GIFT_BUY, request.name, run, 0
+            ).show()
+        } else {
+            run.run()
+        }
+    }
+
+    /** Runs the series through [GiftSender] and reports to the sheet and the user. */
+    private fun send(request: Request, listener: Listener) {
+        val account = request.currentAccount
+        val job = GiftSender.Job(account, request.dialogId, request.gift, request.anonymous, request.upgrade, request.message, request.count, request.price)
+        GiftSender.start(job, object : GiftSender.Listener {
+            override fun onProgress(sent: Int) {
+                listener.onProgress(sent + 1, request.count)
+            }
+
+            override fun onFinished(sent: Int, failure: GiftSender.Failure?) {
+                val stars = StarsController.getInstance(account)
+                if (sent > 0) {
+                    stars.invalidateStarGifts()
+                    stars.invalidateProfileGifts(request.dialogId)
+                    stars.invalidateBalance()
+                    stars.invalidateTransactions(true)
+                }
+                listener.onFinish(sent)
+                val text = if (failure == null && sent == request.count) {
+                    LocaleController.formatString(R.string.TeleGiftsSent, sent)
+                } else {
+                    // the result of the last payment is unknown unless the server answered
+                    val hint = if (failure?.unknown == true) " " + LocaleController.getString(R.string.TeleGiftsCheckBalance) else ""
+                    LocaleController.formatString(R.string.TeleGiftsSendStopped, sent, request.count) + (failure?.let { " ${it.text}" } ?: "") + hint
+                }
+                TeleToast.log("gifts-sent", text, account = account)
+                BulletinFactory.global().createSimpleBulletin(R.raw.chats_infotip, text).show()
+                if (sent > 0) afterSent(account, request.dialogId)
+            }
+        })
+    }
+
+    private fun afterSent(account: Int, dialogId: Long) {
+        if (dialogId < 0) return
+        val fragment = LaunchActivity.getSafeLastFragment() ?: return
+        if (fragment is ChatActivity && fragment.dialogId == dialogId) return
+        NotificationCenter.getInstance(account).postNotificationName(NotificationCenter.closeProfileActivity, dialogId, false)
+        NotificationCenter.getInstance(account).postNotificationName(NotificationCenter.closeChatActivity, dialogId, false)
+        fragment.presentFragment(ChatActivity.of(dialogId))
+    }
+}
diff --git a/TMessagesProj/src/main/java/tele/helpers/GiftSender.kt b/TMessagesProj/src/main/java/tele/helpers/GiftSender.kt
new file mode 100644
index 000000000..a2b373e1f
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/GiftSender.kt
@@ -0,0 +1,130 @@
+package tele.helpers
+
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.MessagesController
+import org.telegram.messenger.R
+import org.telegram.messenger.Utilities
+import org.telegram.tgnet.ConnectionsManager
+import org.telegram.tgnet.TLRPC
+import org.telegram.tgnet.tl.TL_stars
+import org.telegram.tgnet.tl.TL_stars.StarGift
+
+/**
+ * Sends the same star gift several times, one after another (desktop 0184). It stops at the first
+ * error and never retries a payment. Callers only use [start], so the way the series is run can be
+ * swapped without touching them.
+ */
+object GiftSender {
+
+    class Job(
+        @JvmField val currentAccount: Int,
+        @JvmField val dialogId: Long,
+        @JvmField val gift: StarGift,
+        @JvmField val anonymous: Boolean,
+        @JvmField val upgrade: Boolean,
+        @JvmField val message: TLRPC.TL_textWithEntities?,
+        @JvmField val count: Int,
+        /** The Stars one gift may cost at most; a dearer payment form stops the series before any charge. */
+        @JvmField val price: Long
+    )
+
+    /** [unknown]: the payment was sent but its result never came, so the gift may have gone through. */
+    class Failure(@JvmField val text: String, @JvmField val unknown: Boolean)
+
+    interface Listener {
+        /** Gift number [sent] + 1 is being sent now. */
+        fun onProgress(sent: Int)
+
+        fun onFinished(sent: Int, failure: Failure?)
+    }
+
+    class Run internal constructor() {
+        internal var cancelled = false
+
+        /** Stops after the gift that is being sent. */
+        fun cancel() {
+            cancelled = true
+        }
+    }
+
+    @JvmStatic
+    fun start(job: Job, listener: Listener): Run {
+        val run = Run()
+        next(job, listener, run, 0)
+        return run
+    }
+
+    private fun next(job: Job, listener: Listener, run: Run, sent: Int) {
+        if (run.cancelled || sent >= job.count) {
+            listener.onFinished(sent, null)
+            return
+        }
+        listener.onProgress(sent)
+        sendOne(job) { failure ->
+            if (failure != null) {
+                listener.onFinished(sent, failure)
+            } else {
+                next(job, listener, run, sent + 1)
+            }
+        }
+    }
+
+    private fun invoice(job: Job): TLRPC.TL_inputInvoiceStarGift {
+        val invoice = TLRPC.TL_inputInvoiceStarGift()
+        invoice.hide_name = job.anonymous
+        invoice.peer = MessagesController.getInstance(job.currentAccount).getInputPeer(job.dialogId)
+        invoice.gift_id = job.gift.id
+        invoice.include_upgrade = job.upgrade
+        val message = job.message
+        if (message != null && !message.text.isNullOrEmpty()) {
+            invoice.flags = invoice.flags or 2
+            invoice.message = message
+        }
+        return invoice
+    }
+
+    private fun failure(error: TLRPC.TL_error?, fallback: String, afterPayment: Boolean): Failure {
+        val text = error?.text?.takeIf { it.isNotEmpty() } ?: fallback
+        // a server answer (4xx) means the payment was not made; anything else may have been
+        val unknown = afterPayment && (error == null || error.code !in 400..499)
+        return Failure(text, unknown)
+    }
+
+    private fun sendOne(job: Job, done: (Failure?) -> Unit) {
+        val connections = ConnectionsManager.getInstance(job.currentAccount)
+        val invoice = invoice(job)
+        val form = TLRPC.TL_payments_getPaymentForm()
+        form.invoice = invoice
+        connections.sendRequest(form) { formResponse, formError ->
+            AndroidUtilities.runOnUIThread {
+                if (formResponse !is TLRPC.TL_payments_paymentFormStarGift) {
+                    done(failure(formError, "NO_PAYMENT_FORM", false))
+                    return@runOnUIThread
+                }
+                var cost = 0L
+                for (price in formResponse.invoice.prices) cost += price.amount
+                if (cost > job.price) {
+                    done(Failure(LocaleController.getString(R.string.TeleGiftsPriceChanged), false))
+                    return@runOnUIThread
+                }
+                val pay = TL_stars.TL_payments_sendStarsForm()
+                pay.form_id = formResponse.form_id
+                pay.invoice = invoice
+                connections.sendRequest(pay) { payResponse, payError ->
+                    AndroidUtilities.runOnUIThread {
+                        if (payResponse !is TLRPC.TL_payments_paymentResult) {
+                            done(failure(payError, "FAILED_SEND_STARS", true))
+                            return@runOnUIThread
+                        }
+                        Utilities.stageQueue.postRunnable {
+                            MessagesController.getInstance(job.currentAccount).processUpdates(payResponse.updates, false)
+                        }
+                        if (job.gift.limited_per_user) job.gift.per_user_remains--
+                        done(null)
+                    }
+                }
+            }
+        }
+    }
+}
