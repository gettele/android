@@ -0,0 +1,119 @@
+package tele.ui
+
+import android.annotation.SuppressLint
+import android.content.Context
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.MotionEvent
+import android.widget.LinearLayout
+import android.widget.TextView
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.AndroidUtilities.dp
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.R
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Components.LayoutHelper
+
+/** The row of the gift sheet that picks how many gifts go out: a label and a stepper that repeats while held. */
+class TeleGiftQuantityView(
+    context: Context,
+    private val resourcesProvider: Theme.ResourcesProvider?,
+    private val max: Int,
+    private val changed: Runnable
+) : LinearLayout(context) {
+
+    var count = 1
+        private set
+
+    private val countView = TextView(context)
+    private val minus = stepper("\u2212")
+    private val plus = stepper("+")
+    private var step = 0
+    private var held = 0
+
+    private val repeat = object : Runnable {
+        override fun run() {
+            if (!move(step)) return
+            held++
+            AndroidUtilities.runOnUIThread(this, if (held > 8) 40L else 90L)
+        }
+    }
+
+    init {
+        orientation = HORIZONTAL
+        gravity = Gravity.CENTER_VERTICAL
+        setPadding(dp(16f), dp(6f), dp(16f), dp(6f))
+
+        val label = TextView(context)
+        label.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 16f)
+        label.setTextColor(color(Theme.key_windowBackgroundWhiteBlackText))
+        label.text = LocaleController.getString(R.string.TeleGiftsQuantity)
+        addView(label, LayoutHelper.createLinear(0, LayoutHelper.WRAP_CONTENT, 1f, Gravity.CENTER_VERTICAL))
+
+        addView(minus, LayoutHelper.createLinear(40, 40))
+        countView.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 17f)
+        countView.typeface = AndroidUtilities.bold()
+        countView.setTextColor(color(Theme.key_windowBackgroundWhiteBlackText))
+        countView.gravity = Gravity.CENTER
+        addView(countView, LayoutHelper.createLinear(48, 40))
+        addView(plus, LayoutHelper.createLinear(40, 40))
+
+        hold(minus, -1)
+        hold(plus, 1)
+        update()
+    }
+
+    @SuppressLint("ClickableViewAccessibility")
+    private fun hold(view: TextView, direction: Int) {
+        view.setOnTouchListener { v, event ->
+            when (event.actionMasked) {
+                MotionEvent.ACTION_DOWN -> {
+                    v.isPressed = true
+                    step = direction
+                    held = 0
+                    if (move(direction)) AndroidUtilities.runOnUIThread(repeat, 400)
+                    true
+                }
+                MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> {
+                    v.isPressed = false
+                    AndroidUtilities.cancelRunOnUIThread(repeat)
+                    true
+                }
+                else -> true
+            }
+        }
+    }
+
+    // false when the edge is reached
+    private fun move(delta: Int): Boolean {
+        val next = (count + delta).coerceIn(1, max)
+        if (next == count) return false
+        count = next
+        update()
+        changed.run()
+        return true
+    }
+
+    private fun update() {
+        countView.text = count.toString()
+        minus.alpha = if (count > 1) 1f else .4f
+        plus.alpha = if (count < max) 1f else .4f
+    }
+
+    override fun onDetachedFromWindow() {
+        super.onDetachedFromWindow()
+        AndroidUtilities.cancelRunOnUIThread(repeat)
+    }
+
+    private fun stepper(text: String): TextView {
+        val view = TextView(context)
+        view.text = text
+        view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 22f)
+        view.gravity = Gravity.CENTER
+        view.setTextColor(color(Theme.key_featuredStickers_addButton))
+        view.background = Theme.createSelectorDrawable(Theme.multAlpha(color(Theme.key_featuredStickers_addButton), .12f), Theme.RIPPLE_MASK_CIRCLE_20DP, dp(20f))
+        return view
+    }
+
+    private fun color(key: Int): Int = Theme.getColor(key, resourcesProvider)
+}
