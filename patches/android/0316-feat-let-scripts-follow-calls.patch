diff --git a/TMessagesProj/src/main/java/tele/scripting/ScriptCalls.kt b/TMessagesProj/src/main/java/tele/scripting/ScriptCalls.kt
new file mode 100644
index 000000000..ca9071b6b
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/scripting/ScriptCalls.kt
@@ -0,0 +1,97 @@
+package tele.scripting
+
+import android.os.Handler
+import android.os.Looper
+import org.json.JSONArray
+import org.json.JSONObject
+import org.telegram.messenger.UserObject
+import org.telegram.messenger.voip.VoIPService
+import java.util.concurrent.CopyOnWriteArrayList
+
+/** The call the app has now, as scripts read it, plus the handful of controls they may use. */
+object ScriptCalls {
+
+    private val listeners = CopyOnWriteArrayList<Pair<ScriptRuntime, Int>>()
+    private val handler = Handler(Looper.getMainLooper())
+    private var polling = false
+    private var lastSnapshot = ""
+
+    private val poll = object : Runnable {
+        override fun run() {
+            if (listeners.isEmpty()) {
+                polling = false
+                return
+            }
+            listeners.removeAll { !it.first.isRunning() }
+            val snapshot = current()?.toString() ?: ""
+            if (snapshot != lastSnapshot) {
+                lastSnapshot = snapshot
+                val call = if (snapshot.isEmpty()) JSONObject.NULL else JSONObject(snapshot)
+                for ((runtime, id) in listeners) {
+                    runtime.dispatchCall(id, call)
+                }
+            }
+            handler.postDelayed(this, 1000)
+        }
+    }
+
+    @JvmStatic
+    fun current(): JSONObject? {
+        val service = VoIPService.getSharedInstance() ?: return null
+        val state = when (service.getCallState()) {
+            VoIPService.STATE_WAITING_INCOMING -> "incoming"
+            VoIPService.STATE_RINGING -> "ringing"
+            VoIPService.STATE_ESTABLISHED -> "established"
+            VoIPService.STATE_ENDED -> return null
+            else -> "waiting"
+        }
+        val user = service.getUser()
+        val muted = runCatching { service.isMicMute() }.getOrDefault(false)
+        return JSONObject()
+            .put("state", state)
+            .put("muted", muted)
+            .put("video", runCatching { service.isCallingVideo() }.getOrDefault(false))
+            .put("outgoing", service.isOutgoing())
+            .put("user", JSONObject()
+                .put("id", user?.id ?: 0L)
+                .put("name", if (user == null) "" else UserObject.getUserName(user)))
+    }
+
+    @JvmStatic
+    fun control(action: String): Boolean {
+        val service = VoIPService.getSharedInstance() ?: return false
+        return try {
+            when (action) {
+                "answer" -> { service.acceptIncomingCall(); true }
+                "hangup" -> { service.hangUp(); true }
+                "mute" -> { service.setMicMute(true, false, true); true }
+                "unmute" -> { service.setMicMute(false, false, true); true }
+                else -> false
+            }
+        } catch (e: Throwable) {
+            false
+        }
+    }
+
+    @JvmStatic
+    fun listen(runtime: ScriptRuntime, id: Int) {
+        if (listeners.none { it.first === runtime && it.second == id }) {
+            listeners.add(runtime to id)
+        }
+        if (!polling) {
+            polling = true
+            lastSnapshot = current()?.toString() ?: ""
+            handler.post(poll)
+        }
+    }
+
+    @JvmStatic
+    fun unlisten(runtime: ScriptRuntime, id: Int) {
+        listeners.removeAll { it.first === runtime && it.second == id }
+    }
+
+    @JvmStatic
+    fun unregister(runtime: ScriptRuntime) {
+        listeners.removeAll { it.first === runtime }
+    }
+}
