diff --git a/TMessagesProj/src/main/java/tele/helpers/MoneyIncoming.kt b/TMessagesProj/src/main/java/tele/helpers/MoneyIncoming.kt
new file mode 100644
index 000000000..1e31f5de5
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/MoneyIncoming.kt
@@ -0,0 +1,368 @@
+package tele.helpers
+
+import org.json.JSONArray
+import org.json.JSONObject
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.DispatchQueue
+import org.telegram.messenger.FileLog
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.MessagesController
+import org.telegram.messenger.R
+import org.telegram.messenger.UserConfig
+import org.telegram.messenger.UserObject
+import org.telegram.tgnet.ConnectionsManager
+import org.telegram.tgnet.TLRPC
+import org.telegram.tgnet.tl.TL_wallet
+import org.telegram.ui.Wallet.WalletActivity
+import org.telegram.ui.Wallet.GramWallet
+import tele.TeleConfig
+import tele.db.TeleDatabaseHelper
+import java.util.concurrent.CopyOnWriteArrayList
+
+object MoneyIncoming {
+    private const val KEY = "money_incoming"
+    private const val VERSION = 1
+    private const val PAGE_LIMIT = 20
+    private const val MAX_SEEN = 200
+    private const val MAX_ID_LENGTH = 256
+    private const val POLL_INTERVAL = 10 * 60 * 1000L
+
+    fun interface Listener {
+        fun onChanged(account: Int, unseen: Int)
+    }
+
+    private class AccountState(val account: Int, val generation: Long) {
+        var baseline = false
+        var unseen = 0
+        var balance = -1L
+        var requestId = -1
+        var checkAgain = false
+        var poll: Runnable? = null
+        val seenOrder = ArrayDeque<String>()
+        val seenIds = HashSet<String>()
+    }
+
+    private val queue by lazy { DispatchQueue("moneyIncoming") }
+    private val states = HashMap<Int, AccountState>()
+    private val listeners = CopyOnWriteArrayList<Listener>()
+
+    @Volatile
+    private var unseenSnapshot = IntArray(UserConfig.MAX_ACCOUNT_COUNT)
+    init {
+        TeleNotices.registerAction(NoticeKind.MONEY) { fragment, _, _ ->
+            fragment.presentFragment(WalletActivity())
+            true
+        }
+    }
+
+    @JvmStatic
+    fun start(account: Int) {
+        if (!valid(account)) return
+        queue.postRunnable { state(account, true)?.let { refresh(it, false) } }
+    }
+
+    @JvmStatic
+    fun onWalletState(account: Int, state: TL_wallet.WalletState?) {
+        if (!valid(account)) return
+        queue.postRunnable {
+            val tracker = state(account, false) ?: return@postRunnable
+            val balance = (state as? TL_wallet.TL_walletState)?.balance ?: -1L
+            val grew = tracker.balance >= 0L && balance > tracker.balance
+            tracker.balance = balance
+            if (grew || !tracker.baseline) check(tracker)
+        }
+    }
+
+    @JvmStatic
+    fun onTransactionsChanged(account: Int) {
+        if (!valid(account)) return
+        queue.postRunnable { state(account, false)?.let { check(it) } }
+    }
+
+    @JvmStatic
+    fun markSeen(account: Int) {
+        if (!valid(account)) return
+        queue.postRunnable {
+            val tracker = state(account, false) ?: return@postRunnable
+            if (tracker.unseen == 0) return@postRunnable
+            tracker.unseen = 0
+            write(tracker)
+            publish(tracker)
+        }
+    }
+
+    @JvmStatic
+    fun unseen(account: Int): Int =
+        if (valid(account) && badgeEnabled()) unseenSnapshot[account] else 0
+
+    @JvmStatic
+    fun addListener(listener: Listener) {
+        listeners.add(listener)
+    }
+
+    @JvmStatic
+    fun removeListener(listener: Listener) {
+        listeners.remove(listener)
+    }
+
+    @JvmStatic
+    fun onToggled() {
+        queue.postRunnable {
+            for (tracker in states.values.toList()) refresh(tracker, false)
+            for (account in 0 until UserConfig.MAX_ACCOUNT_COUNT) {
+                if (UserConfig.getInstance(account).isClientActivated) {
+                    state(account, true)?.let { refresh(it, false) }
+                }
+            }
+        }
+    }
+
+    @JvmStatic
+    fun onLogout(account: Int) {
+        if (!valid(account)) return
+        queue.postRunnable {
+            val tracker = states.remove(account)
+            if (tracker != null) {
+                cancelPoll(tracker)
+                cancelRequest(tracker)
+            }
+            runCatching { TeleDatabaseHelper.put(key(account), null) }.onFailure { FileLog.e(it) }
+            publishCount(account, 0)
+        }
+    }
+
+    private fun valid(account: Int) = account in 0 until UserConfig.MAX_ACCOUNT_COUNT
+
+    private fun key(account: Int) = "$KEY:$account"
+
+    private fun notifyEnabled() = !TeleConfig.NO_MONEY.value && TeleConfig.MONEY_INCOMING_NOTIFY.value
+
+    private fun badgeEnabled() = !TeleConfig.NO_MONEY.value && TeleConfig.MONEY_INCOMING_BADGE.value
+
+    private fun enabled(account: Int) =
+        valid(account) && UserConfig.getInstance(account).isClientActivated &&
+            !TeleConfig.NO_MONEY.value && (notifyEnabled() || badgeEnabled())
+
+    private fun canCheck(account: Int) =
+        enabled(account) && MessagesController.getInstance(account).config.walletAvailable()
+
+    private fun state(account: Int, create: Boolean): AccountState? {
+        if (!valid(account)) return null
+        val generation = TeleAccounts.generation(account)
+        states[account]?.let { if (it.generation == generation) return it }
+        if (!create) return null
+        val tracker = AccountState(account, generation)
+        states[account] = tracker
+        read(tracker)
+        publish(tracker)
+        return tracker
+    }
+
+    private fun refresh(tracker: AccountState, poll: Boolean) {
+        if (states[tracker.account] !== tracker || !TeleAccounts.isCurrent(tracker.account, tracker.generation)) return
+        if (!enabled(tracker.account)) {
+            cancelPoll(tracker)
+            cancelRequest(tracker)
+            clearUnseen(tracker)
+            return
+        }
+        schedulePoll(tracker)
+        if (canCheck(tracker.account) && (poll || !tracker.baseline)) check(tracker)
+    }
+
+    private fun schedulePoll(tracker: AccountState) {
+        if (tracker.poll != null) return
+        val task = object : Runnable {
+            override fun run() {
+                tracker.poll = null
+                if (states[tracker.account] !== tracker) return
+                if (!TeleAccounts.isCurrent(tracker.account, tracker.generation)) {
+                    states.remove(tracker.account)
+                    publishCount(tracker.account, 0)
+                    return
+                }
+                refresh(tracker, true)
+            }
+        }
+        tracker.poll = task
+        queue.postRunnable(task, POLL_INTERVAL)
+    }
+
+    private fun cancelPoll(tracker: AccountState) {
+        tracker.poll?.let { queue.cancelRunnable(it) }
+        tracker.poll = null
+    }
+
+    private fun check(tracker: AccountState) {
+        if (!canCheck(tracker.account)) return
+        if (tracker.requestId >= 0) {
+            tracker.checkAgain = true
+            return
+        }
+        if (!TeleAccounts.isCurrent(tracker.account, tracker.generation)) return
+        val request = TL_wallet.getTransactions().apply {
+            inbound = true
+            outbound = false
+            offset = ""
+            limit = PAGE_LIMIT
+        }
+        tracker.checkAgain = false
+        tracker.requestId = ConnectionsManager.getInstance(tracker.account).sendRequestTyped(
+            request,
+            AndroidUtilities::runOnUIThread
+        ) { result, error ->
+            if (!TeleAccounts.isCurrent(tracker.account, tracker.generation)) return@sendRequestTyped
+            if (result != null) {
+                val controller = MessagesController.getInstance(tracker.account)
+                controller.putUsers(result.users, false)
+                controller.putChats(result.chats, false)
+            } else if (error != null) {
+                FileLog.e("incoming transactions: ${error.text ?: "NULL_ERROR"}")
+            }
+            queue.postRunnable {
+                val current = states[tracker.account]
+                if (current !== tracker) return@postRunnable
+                tracker.requestId = -1
+                if (!TeleAccounts.isCurrent(tracker.account, tracker.generation)) return@postRunnable
+                if (result != null) apply(tracker, result)
+                if (tracker.checkAgain) check(tracker)
+            }
+        }
+    }
+
+    private fun cancelRequest(tracker: AccountState) {
+        if (tracker.requestId >= 0) {
+            ConnectionsManager.getInstance(tracker.account).cancelRequest(tracker.requestId, true)
+            tracker.requestId = -1
+        }
+        tracker.checkAgain = false
+    }
+
+    private fun apply(tracker: AccountState, result: TL_wallet.walletTransactions) {
+        val first = !tracker.baseline
+        val oldUnseen = tracker.unseen
+        val notices = ArrayList<TL_wallet.walletTransaction>()
+        tracker.baseline = true
+        for (index in result.transactions.indices.reversed()) {
+            val transaction = result.transactions[index] ?: continue
+            val id = transaction.id
+            if (id.isNullOrEmpty() || id.length > MAX_ID_LENGTH) continue
+            if (!remember(tracker, id)) continue
+            if (first || !eligible(transaction)) continue
+            if (badgeEnabled()) tracker.unseen = (tracker.unseen + 1).coerceAtMost(MAX_SEEN)
+            if (notifyEnabled()) notices.add(transaction)
+        }
+        // Persist the ids before UI delivery so a restart cannot announce the same transfer twice.
+        write(tracker)
+        if (oldUnseen != tracker.unseen) publish(tracker)
+        for (transaction in notices) emit(tracker, transaction)
+    }
+
+    private fun eligible(transaction: TL_wallet.walletTransaction) =
+        transaction.incoming && !transaction.failed && !transaction.key_change &&
+            !transaction.pending && transaction.nft == null && transaction.amount > 0L
+
+    private fun remember(tracker: AccountState, id: String): Boolean {
+        if (!tracker.seenIds.add(id)) return false
+        tracker.seenOrder.addLast(id)
+        while (tracker.seenOrder.size > MAX_SEEN) {
+            tracker.seenIds.remove(tracker.seenOrder.removeFirst())
+        }
+        return true
+    }
+
+    private fun emit(tracker: AccountState, transaction: TL_wallet.walletTransaction) {
+        val generation = tracker.generation
+        AndroidUtilities.runOnUIThread {
+            if (!TeleAccounts.isCurrent(tracker.account, generation) || !notifyEnabled()) return@runOnUIThread
+            val from = fromText(tracker.account, transaction.peer)
+            val text = if (from.isEmpty()) {
+                LocaleController.getString(R.string.TeleMoneyIncoming)
+            } else {
+                LocaleController.formatString(R.string.TeleMoneyFrom, from)
+            }
+            TeleNotices.add(
+                tracker.account,
+                TeleNotice(
+                    kind = NoticeKind.MONEY,
+                    title = "+" + GramWallet.formatGrams(transaction.amount),
+                    text = TeleLowercase.lc(text),
+                    tone = NoticeTone.SUCCESS,
+                    date = transaction.date,
+                    key = "money_incoming:${transaction.id}"
+                )
+            )
+        }
+    }
+
+    private fun fromText(account: Int, peer: TL_wallet.WalletTransactionPeer?): String =
+        when (peer) {
+            is TL_wallet.walletTransactionPeerUser ->
+                MessagesController.getInstance(account).getUser(peer.user_id)?.let { UserObject.getUserName(it) }
+                    ?: shortAddress(peer.address)
+            is TL_wallet.walletTransactionPeerChannel ->
+                MessagesController.getInstance(account).getChat(peer.channel_id)?.title ?: shortAddress(peer.address)
+            is TL_wallet.walletTransactionPeerAddress -> peer.domain?.takeIf { it.isNotEmpty() } ?: shortAddress(peer.address)
+            is TL_wallet.walletTransactionPeerOnramp -> peer.provider_name ?: ""
+            else -> ""
+        }
+
+    private fun shortAddress(address: String?): String =
+        if (address != null && address.length > 12) address.take(4) + "…" + address.takeLast(4) else address ?: ""
+
+    private fun clearUnseen(tracker: AccountState) {
+        if (tracker.unseen == 0) {
+            publish(tracker)
+            return
+        }
+        tracker.unseen = 0
+        write(tracker)
+        publish(tracker)
+    }
+
+    private fun publish(tracker: AccountState) {
+        publishCount(tracker.account, if (badgeEnabled()) tracker.unseen else 0)
+    }
+
+    private fun publishCount(account: Int, count: Int) {
+        val next = unseenSnapshot.copyOf()
+        next[account] = count.coerceIn(0, MAX_SEEN)
+        unseenSnapshot = next
+        val visible = if (badgeEnabled()) next[account] else 0
+        AndroidUtilities.runOnUIThread { listeners.forEach { it.onChanged(account, visible) } }
+    }
+
+    private fun read(tracker: AccountState) {
+        val owner = TeleAccounts.identity(tracker.account)
+        if (owner.isEmpty()) return
+        runCatching {
+            val raw = TeleDatabaseHelper.get(key(tracker.account)) ?: return@runCatching
+            val json = JSONObject(raw)
+            if (json.optInt("v") != VERSION || json.optString("owner") != owner || !json.optBoolean("baseline")) return@runCatching
+            tracker.unseen = json.optInt("unseen").coerceIn(0, MAX_SEEN)
+            val ids = json.optJSONArray("seen") ?: JSONArray()
+            for (index in 0 until ids.length()) {
+                val id = ids.optString(index)
+                if (id.isNotEmpty() && id.length <= MAX_ID_LENGTH) remember(tracker, id)
+            }
+            tracker.baseline = true
+        }.onFailure { FileLog.e(it) }
+    }
+
+    private fun write(tracker: AccountState) {
+        if (!tracker.baseline) return
+        val owner = TeleAccounts.identity(tracker.account)
+        if (owner.isEmpty()) return
+        runCatching {
+            val ids = JSONArray()
+            for (id in tracker.seenOrder) ids.put(id)
+            val json = JSONObject()
+                .put("v", VERSION)
+                .put("owner", owner)
+                .put("baseline", true)
+                .put("unseen", tracker.unseen)
+                .put("seen", ids)
+            TeleDatabaseHelper.put(key(tracker.account), json.toString())
+        }.onFailure { FileLog.e(it) }
+    }
+}
