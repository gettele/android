-            builder.setTitle(title)
-            val view = android.widget.TextView(activity)
-            view.text = text
-            view.setTextIsSelectable(true)
-            view.setTextSize(android.util.TypedValue.COMPLEX_UNIT_DIP, 16f)
-            view.setTextColor(org.telegram.ui.ActionBar.Theme.getColor(org.telegram.ui.ActionBar.Theme.key_dialogTextBlack))
-            view.setPadding(AndroidUtilities.dp(24f), AndroidUtilities.dp(8f), AndroidUtilities.dp(24f), AndroidUtilities.dp(8f))
