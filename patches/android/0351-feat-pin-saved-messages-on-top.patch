@@ -0,0 +1,96 @@
+package tele.helpers
+
+import org.telegram.messenger.AccountInstance
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.MessagesController
+import org.telegram.messenger.NotificationCenter
+import org.telegram.messenger.R
+import org.telegram.messenger.UserConfig
+import org.telegram.tgnet.TLRPC
+import org.telegram.ui.ActionBar.AlertDialog
+import org.telegram.ui.ActionBar.BaseFragment
+import tele.TeleConfig
+import tele.TeleHooks
+import tele.db.TeleDatabaseHelper
+
+// the stock self dialog, retyped and moved above the pinned chats; it must stay after the archive
+// row, whose hidden-above-the-list pull assumes that row is still position 0
+object SavedRow {
+    private const val PULL_DP = 88f
+    private val above = HashMap<Int, Boolean>()
+    private val pull = HashMap<Int, Int>()
+
+    private fun key(account: Int) = "saved_row_above:$account"
+
+    @JvmStatic
+    fun enabled(): Boolean = TeleConfig.SAVED_MESSAGES_ROW.value
+
+    @JvmStatic
+    fun dialog(account: Int, dialogsType: Int, folderId: Int, filter: MessagesController.DialogFilter?): TLRPC.Dialog? {
+        if (!enabled() || dialogsType != 0 || folderId != 0 || filter != null && !filter.isDefault) return null
+        val self = UserConfig.getInstance(account).clientUserId
+        if (self == 0L) return null
+        return MessagesController.getInstance(account).dialogs_dict.get(self)
+    }
+
+    @JvmStatic
+    fun hiddenAbove(account: Int): Boolean = above.getOrPut(account) { TeleDatabaseHelper.get(key(account)) == "1" }
+
+    @JvmStatic
+    fun setHiddenAbove(account: Int, value: Boolean) {
+        above[account] = value
+        TeleDatabaseHelper.put(key(account), if (value) "1" else null)
+        AndroidUtilities.runOnUIThread { reload(account) }
+    }
+
+    @JvmStatic
+    fun onToggled() {
+        above.clear()
+        pull.clear()
+        for (account in 0 until UserConfig.MAX_ACCOUNT_COUNT) {
+            TeleDatabaseHelper.put(key(account), null)
+            AndroidUtilities.runOnUIThread { reload(account) }
+        }
+    }
+
+    @JvmStatic
+    fun pulled(account: Int, dialogsType: Int, dy: Int, scrolled: Int, dragging: Boolean) {
+        if (!enabled() || dialogsType != 0 || !dragging || dy >= 0 || scrolled != 0 || !hiddenAbove(account)) {
+            pull.remove(account)
+            return
+        }
+        val total = (pull[account] ?: 0) - dy
+        if (total < AndroidUtilities.dp(PULL_DP)) {
+            pull[account] = total
+            return
+        }
+        pull.remove(account)
+        setHiddenAbove(account, false)
+    }
+
+    @JvmStatic
+    fun showMenu(fragment: BaseFragment): Boolean {
+        val activity = fragment.parentActivity ?: return false
+        val account = fragment.currentAccount
+        val hidden = hiddenAbove(account)
+        val items = arrayListOf<CharSequence>(
+            LocaleController.getString(if (hidden) R.string.PinInTheList else R.string.HideAboveTheList),
+            TeleLowercase.lc("Hide from chat list")
+        )
+        fragment.showDialog(AlertDialog.Builder(activity).setItems(items.toTypedArray()) { _, which ->
+            when (which) {
+                0 -> setHiddenAbove(account, !hidden)
+                1 -> {
+                    TeleConfig.set(TeleConfig.SAVED_MESSAGES_ROW, false)
+                    TeleHooks.onConfigChanged(TeleConfig.SAVED_MESSAGES_ROW)
+                }
+            }
+        }.create())
+        return true
+    }
+
+    private fun reload(account: Int) {
+        AccountInstance.getInstance(account).notificationCenter.postNotificationName(NotificationCenter.dialogsNeedReload)
+    }
+}
