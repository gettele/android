+    private void tele_addSavedRow() {
+        final TLRPC.Dialog saved = tele.helpers.SavedRow.dialog(currentAccount, dialogsType, folderId, getCurrentFilter());
+        if (saved == null || isOnlySelect || communityId != 0 || parentFragment != null && parentFragment.isArchive()) {
+            return;
+        }
+        if (MessagesController.getInstance(currentAccount).isHiddenByUndo(saved.id)) {
+            return;
+        }
+        int from = -1;
+        for (int i = 0; i < itemInternals.size(); i++) {
+            final ItemInternal item = itemInternals.get(i);
+            if (item.viewType == VIEW_TYPE_DIALOG && item.dialog != null && item.dialog.id == saved.id) {
+                from = i;
+                break;
+            }
+        }
+        if (!tele.helpers.SavedRow.isPinned(currentAccount)) {
+            if (from < 0) {
+                itemInternals.add(tele_savedDateIndex(saved), new ItemInternal(VIEW_TYPE_DIALOG, saved));
+            }
+            return;
+        }
+        final ItemInternal item = from >= 0 ? itemInternals.remove(from) : new ItemInternal(tele_VIEW_TYPE_SAVED, saved);
+        item.viewType = tele_VIEW_TYPE_SAVED;
+        itemInternals.add(Math.min(tele_savedTopIndex(), itemInternals.size()), item);
+    }
+
+    private int tele_savedTopIndex() {
+        for (int i = 0; i < itemInternals.size(); i++) {
+            final ItemInternal item = itemInternals.get(i);
+            if (item.viewType == VIEW_TYPE_DIALOG) {
+                return item.dialog instanceof TLRPC.TL_dialogFolder ? i + 1 : i;
+            }
+            if (item.viewType == VIEW_TYPE_EMPTY || item.viewType == VIEW_TYPE_LAST_EMPTY || item.viewType == VIEW_TYPE_NEW_CHAT_HINT || item.viewType == VIEW_TYPE_FLICKER) {
+                return i;
+            }
+        }
+        return itemInternals.size();
+    }
+
+    private int tele_savedDateIndex(TLRPC.Dialog saved) {
+        int last = -1;
+        for (int i = 0; i < itemInternals.size(); i++) {
+            final ItemInternal item = itemInternals.get(i);
+            if (item.viewType != VIEW_TYPE_DIALOG || item.dialog == null) {
+                continue;
+            }
+            last = i;
+            if (!item.pinned && !(item.dialog instanceof TLRPC.TL_dialogFolder) && item.dialog.last_message_date <= saved.last_message_date) {
+                return i;
+            }
+        }
+        return last >= 0 ? last + 1 : tele_savedTopIndex();
     }
 
