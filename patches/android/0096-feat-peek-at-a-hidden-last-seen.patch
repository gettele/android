+++ b/TMessagesProj/src/main/java/tele/helpers/LastSeenPeek.kt
@@ -0,0 +1,290 @@
+package tele.helpers
+
+import android.os.Handler
+import android.os.Looper
+import org.json.JSONArray
+import org.json.JSONObject
+import org.telegram.messenger.ContactsController
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.MessagesController
+import org.telegram.messenger.UserConfig
+import org.telegram.tgnet.ConnectionsManager
+import org.telegram.tgnet.TLRPC
+import org.telegram.tgnet.tl.TL_account
+import org.telegram.ui.ActionBar.BaseFragment
+import tele.TeleConfig
+import tele.db.TeleDatabaseHelper
+
+/**
+ * Peek at a hidden last seen: the last seen privacy rule is changed for one moment, the status of
+ * the peer is read and the original rule is restored right after that. The original rule is kept on
+ * the device, so it is restored even when the app dies in the middle.
+ */
+object LastSeenPeek {
+
+    private const val KEY = "privacy_last_seen"
+    private const val RESTORE_ATTEMPTS = 5
+    private const val RESTORE_DELAY = 2000L
+
+    private val attempts = HashMap<Int, Int>()
+
+    private fun key(account: Int) = "$KEY:$account"
+
+    @JvmStatic
+    fun peek(fragment: BaseFragment, account: Int, userId: Long) {
+        if (!TeleConfig.LAST_SEEN_RESTORE.value) {
+            return
+        }
+        val controller = MessagesController.getInstance(account)
+        val user = controller.getUser(userId)
+        if (user == null || user.bot || user.self) {
+            show(fragment, "this peer has no last seen to peek at")
+            return
+        }
+        val rules = ContactsController.getInstance(account).getPrivacyRules(ContactsController.PRIVACY_RULES_TYPE_LASTSEEN)
+        if (rules == null) {
+            show(fragment, "the privacy rules are not loaded yet")
+            return
+        }
+        val saved = saveRules(rules)
+        TeleDatabaseHelper.put(key(account), saved)
+        val input = buildRules(rules, account, userId) ?: run {
+            TeleDatabaseHelper.put(key(account), null)
+            show(fragment, "could not build the privacy rules")
+            return
+        }
+        send(account, input) { error ->
+            if (error != null) {
+                show(fragment, "could not change the last seen privacy")
+                restore(account)
+                return@send
+            }
+            Handler(Looper.getMainLooper()).postDelayed({
+                val status = controller.getUser(userId)?.status
+                val text = if (status == null) {
+                    "they hide their last seen from you"
+                } else {
+                    LocaleController.formatUserStatus(account, controller.getUser(userId), null, null)
+                }
+                show(fragment, text)
+                restore(account)
+            }, 1500L)
+        }
+    }
+
+    /** Restores a pending rule after the app was killed in the middle of a peek. */
+    @JvmStatic
+    fun restorePending() {
+        for (account in 0 until UserConfig.MAX_ACCOUNT_COUNT) {
+            val saved = TeleDatabaseHelper.get(key(account)) ?: continue
+            restore(account, saved)
+        }
+    }
+
+    private fun restore(account: Int, saved: String? = null) {
+        val json = saved ?: TeleDatabaseHelper.get(key(account)) ?: return
+        val rules = parseRules(json) ?: run {
+            TeleDatabaseHelper.put(key(account), null)
+            return
+        }
+        val input = buildRules(rules, account, 0) ?: return
+        send(account, input) { error ->
+            if (error == null) {
+                TeleDatabaseHelper.put(key(account), null)
+            } else if ((attempts[account] ?: 0) < RESTORE_ATTEMPTS) {
+                Handler(Looper.getMainLooper()).postDelayed({ restore(account, json) }, RESTORE_DELAY)
+            }
+        }
+    }
+
+    private fun send(account: Int, rules: ArrayList<TLRPC.InputPrivacyRule>, callback: (String?) -> Unit) {
+        val request = TL_account.setPrivacy()
+        request.key = TLRPC.TL_inputPrivacyKeyStatusTimestamp()
+        request.rules.addAll(rules)
+        ConnectionsManager.getInstance(account).sendRequest(request, { response: Any?, error: TLRPC.TL_error? ->
+            Handler(Looper.getMainLooper()).post {
+                if (error == null) {
+                    attempts.remove(account)
+                    val privacyRules = response as? TL_account.privacyRules
+                    if (privacyRules != null) {
+                        MessagesController.getInstance(account).putUsers(privacyRules.users, false)
+                        MessagesController.getInstance(account).putChats(privacyRules.chats, false)
+                        ContactsController.getInstance(account).setPrivacyRules(privacyRules.rules, ContactsController.PRIVACY_RULES_TYPE_LASTSEEN)
+                    }
+                } else {
+                    attempts[account] = (attempts[account] ?: 0) + 1
+                }
+                callback(error?.text)
+            }
+        }, ConnectionsManager.RequestFlagFailOnServerErrors)
+    }
+
+    private fun show(fragment: BaseFragment, text: String) {
+        val activity = fragment.parentActivity ?: return
+        android.widget.Toast.makeText(activity, text, android.widget.Toast.LENGTH_SHORT).show()
+    }
+
+    // storage
+
+    private fun saveRules(rules: ArrayList<TLRPC.PrivacyRule>): String {
+        val array = JSONArray()
+        for (rule in rules) {
+            val item = JSONObject()
+            when (rule) {
+                is TLRPC.TL_privacyValueAllowAll -> item.put("t", "allow_all")
+                is TLRPC.TL_privacyValueAllowContacts -> item.put("t", "allow_contacts")
+                is TLRPC.TL_privacyValueAllowUsers -> {
+                    item.put("t", "allow_users")
+                    item.put("u", JSONArray(rule.users))
+                }
+                is TLRPC.TL_privacyValueAllowChatParticipants -> {
+                    item.put("t", "allow_chats")
+                    item.put("c", JSONArray(rule.chats))
+                }
+                is TLRPC.TL_privacyValueAllowCloseFriends -> item.put("t", "allow_close_friends")
+                is TLRPC.TL_privacyValueAllowPremium -> item.put("t", "allow_premium")
+                is TLRPC.TL_privacyValueAllowBots -> item.put("t", "allow_bots")
+                is TLRPC.TL_privacyValueDisallowAll -> item.put("t", "disallow_all")
+                is TLRPC.TL_privacyValueDisallowContacts -> item.put("t", "disallow_contacts")
+                is TLRPC.TL_privacyValueDisallowUsers -> {
+                    item.put("t", "disallow_users")
+                    item.put("u", JSONArray(rule.users))
+                }
+                is TLRPC.TL_privacyValueDisallowChatParticipants -> {
+                    item.put("t", "disallow_chats")
+                    item.put("c", JSONArray(rule.chats))
+                }
+                is TLRPC.TL_privacyValueDisallowBots -> item.put("t", "disallow_bots")
+                else -> continue
+            }
+            array.put(item)
+        }
+        return array.toString()
+    }
+
+    private fun parseRules(json: String): ArrayList<TLRPC.PrivacyRule>? {
+        val rules = ArrayList<TLRPC.PrivacyRule>()
+        try {
+            val array = JSONArray(json)
+            for (i in 0 until array.length()) {
+                val item = array.getJSONObject(i)
+                when (item.optString("t")) {
+                    "allow_all" -> rules.add(TLRPC.TL_privacyValueAllowAll())
+                    "allow_contacts" -> rules.add(TLRPC.TL_privacyValueAllowContacts())
+                    "allow_users" -> {
+                        val rule = TLRPC.TL_privacyValueAllowUsers()
+                        rule.users.addAll(longArray(item.optJSONArray("u")))
+                        rules.add(rule)
+                    }
+                    "allow_chats" -> {
+                        val rule = TLRPC.TL_privacyValueAllowChatParticipants()
+                        rule.chats.addAll(longArray(item.optJSONArray("c")))
+                        rules.add(rule)
+                    }
+                    "allow_close_friends" -> rules.add(TLRPC.TL_privacyValueAllowCloseFriends())
+                    "allow_premium" -> rules.add(TLRPC.TL_privacyValueAllowPremium())
+                    "allow_bots" -> rules.add(TLRPC.TL_privacyValueAllowBots())
+                    "disallow_all" -> rules.add(TLRPC.TL_privacyValueDisallowAll())
+                    "disallow_contacts" -> rules.add(TLRPC.TL_privacyValueDisallowContacts())
+                    "disallow_users" -> {
+                        val rule = TLRPC.TL_privacyValueDisallowUsers()
+                        rule.users.addAll(longArray(item.optJSONArray("u")))
+                        rules.add(rule)
+                    }
+                    "disallow_chats" -> {
+                        val rule = TLRPC.TL_privacyValueDisallowChatParticipants()
+                        rule.chats.addAll(longArray(item.optJSONArray("c")))
+                        rules.add(rule)
+                    }
+                    "disallow_bots" -> rules.add(TLRPC.TL_privacyValueDisallowBots())
+                    else -> return null
+                }
+            }
+        } catch (e: Exception) {
+            return null
+        }
+        return rules
+    }
+
+    private fun longArray(array: JSONArray?): List<Long> {
+        if (array == null) {
+            return emptyList()
+        }
+        val result = ArrayList<Long>()
+        for (i in 0 until array.length()) {
+            result.add(array.optLong(i))
+        }
+        return result
+    }
+
+    /**
+     * Builds the input rules. When userId is not zero the peer is added to the allowed users and
+     * removed from the disallowed ones, so the status of the peer becomes visible for a moment.
+     */
+    private fun buildRules(rules: ArrayList<TLRPC.PrivacyRule>, account: Int, userId: Long): ArrayList<TLRPC.InputPrivacyRule>? {
+        val result = ArrayList<TLRPC.InputPrivacyRule>()
+        val controller = MessagesController.getInstance(account)
+        var allowUsers: TLRPC.TL_inputPrivacyValueAllowUsers? = null
+        for (rule in rules) {
+            when (rule) {
+                is TLRPC.TL_privacyValueAllowAll -> result.add(TLRPC.TL_inputPrivacyValueAllowAll())
+                is TLRPC.TL_privacyValueAllowContacts -> result.add(TLRPC.TL_inputPrivacyValueAllowContacts())
+                is TLRPC.TL_privacyValueAllowCloseFriends -> result.add(TLRPC.TL_inputPrivacyValueAllowCloseFriends())
+                is TLRPC.TL_privacyValueAllowPremium -> result.add(TLRPC.TL_inputPrivacyValueAllowPremium())
+                is TLRPC.TL_privacyValueAllowBots -> result.add(TLRPC.TL_inputPrivacyValueAllowBots())
+                is TLRPC.TL_privacyValueDisallowAll -> result.add(TLRPC.TL_inputPrivacyValueDisallowAll())
+                is TLRPC.TL_privacyValueDisallowContacts -> result.add(TLRPC.TL_inputPrivacyValueDisallowContacts())
+                is TLRPC.TL_privacyValueDisallowBots -> result.add(TLRPC.TL_inputPrivacyValueDisallowBots())
+                is TLRPC.TL_privacyValueAllowUsers -> {
+                    val input = TLRPC.TL_inputPrivacyValueAllowUsers()
+                    for (id in rule.users) {
+                        val inputUser = inputUser(controller, id) ?: continue
+                        if (userId != 0L && id == userId) {
+                            continue
+                        }
+                        input.users.add(inputUser)
+                    }
+                    allowUsers = input
+                }
+                is TLRPC.TL_privacyValueDisallowUsers -> {
+                    val input = TLRPC.TL_inputPrivacyValueDisallowUsers()
+                    for (id in rule.users) {
+                        if (userId != 0L && id == userId) {
+                            continue
+                        }
+                        val inputUser = inputUser(controller, id) ?: continue
+                        input.users.add(inputUser)
+                    }
+                    result.add(input)
+                }
+                is TLRPC.TL_privacyValueAllowChatParticipants -> {
+                    val input = TLRPC.TL_inputPrivacyValueAllowChatParticipants()
+                    input.chats.addAll(rule.chats)
+                    result.add(input)
+                }
+                is TLRPC.TL_privacyValueDisallowChatParticipants -> {
+                    val input = TLRPC.TL_inputPrivacyValueDisallowChatParticipants()
+                    input.chats.addAll(rule.chats)
+                    result.add(input)
+                }
+                else -> return null
+            }
+        }
+        if (userId != 0L) {
+            val inputUser = inputUser(controller, userId) ?: return null
+            if (allowUsers == null) {
+                allowUsers = TLRPC.TL_inputPrivacyValueAllowUsers()
+            }
+            allowUsers.users.add(inputUser)
+        }
+        if (allowUsers != null) {
+            result.add(0, allowUsers)
+        }
+        return result
+    }
+
+    private fun inputUser(controller: MessagesController, id: Long): TLRPC.InputUser? {
+        val user = controller.getUser(id) ?: return null
+        return controller.getInputUser(user)
+    }
+}
