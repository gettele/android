+    private fun pickMiniApp() {
+        if (slots.size >= MainTabsConfig.MAX_SLOTS) {
+            bulletin(lc("The bar holds six tabs."))
+            return
+        }
+        if (loadingMiniApps) {
+            return
+        }
+        loadingMiniApps = true
+        MediaDataController.getInstance(account).loadAttachMenuBots(true, false) {
+            loadingMiniApps = false
+            val bots = TeleMiniAppFragment.sideMenuBots(account)
+            if (bots.isEmpty()) {
+                bulletin(localized(R.string.TeleMiniAppEmpty))
+                return@loadAttachMenuBots
+            }
+            val builder = AlertDialog.Builder(parentActivity, resourceProvider)
+            builder.setTitle(localized(R.string.TeleMiniAppPickerTitle))
+            val names = bots.map { it.short_name.ifEmpty { "Mini app" } }.toTypedArray()
+            builder.setItems(names) { _, which ->
+                addMiniApp(bots[which].bot_id)
+            }
+            builder.setNegativeButton(LocaleController.getString(R.string.Cancel), null)
+            showDialog(builder.create())
+        }
+    }
