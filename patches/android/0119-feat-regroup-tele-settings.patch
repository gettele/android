diff --git a/TMessagesProj/src/main/java/tele/helpers/TeleBackup.kt b/TMessagesProj/src/main/java/tele/helpers/TeleBackup.kt
new file mode 100644
index 000000000..5dfde65e1
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/TeleBackup.kt
@@ -0,0 +1,86 @@
+package tele.helpers
+
+import tele.Item
+import tele.TeleHooks
+import tele.TeleConfig
+
+// the settings export and import of the backup page: a plain text list of the public options
+object TeleBackup {
+
+    private const val HEADER = "# tele settings"
+    private const val MAX_LINES = 512
+    private const val MAX_LENGTH = 64 * 1024
+
+    // the internal values and the server url stay on the device
+    private val SKIPPED = setOf("known_settings", "changelog_accounts", "shot_view", "tele_server_url")
+
+    private fun items(): List<Item<*>> = TeleConfig.exportedItems()
+
+    fun export(): String {
+        val lines = ArrayList<String>()
+        lines.add(HEADER)
+        for (item in items()) {
+            if (item.key in SKIPPED) continue
+            when (val value = item.value) {
+                is Boolean -> lines.add("${item.key}=true")
+                is Int -> lines.add("${item.key}=$value")
+                is Float -> lines.add("${item.key}=$value")
+                is String -> {
+                    if (value.isEmpty()) continue
+                    lines.add("${item.key}=${value.replace("\n", " ")}")
+                }
+                else -> continue
+            }
+        }
+        return lines.joinToString("\n")
+    }
+
+    // returns the number of the applied options, throws when the text is not an export
+    fun import(text: String): Int {
+        if (text.length > MAX_LENGTH) {
+            throw IllegalArgumentException("the settings are too long")
+        }
+        val lines = text.split('\n').map { it.trim() }.filter { it.isNotEmpty() && !it.startsWith("#") }
+        if (lines.isEmpty() || lines.size > MAX_LINES) {
+            throw IllegalArgumentException("this is not a tele settings export")
+        }
+        val byKey = HashMap<String, Item<*>>()
+        for (item in items()) {
+            byKey[item.key] = item
+        }
+        var applied = 0
+        for (line in lines) {
+            val separator = line.indexOf('=')
+            if (separator <= 0) {
+                throw IllegalArgumentException("the settings are damaged")
+            }
+            val key = line.substring(0, separator)
+            val value = line.substring(separator + 1)
+            val item = byKey[key] ?: continue
+            if (item.key in SKIPPED) continue
+            when (item.value) {
+                is Boolean -> {
+                    if (value != "true" && value != "false") {
+                        throw IllegalArgumentException("the settings are damaged")
+                    }
+                    TeleConfig.set(item, value == "true")
+                }
+                is Int -> {
+                    val number = value.toIntOrNull()
+                        ?: throw IllegalArgumentException("the settings are damaged")
+                    TeleConfig.set(item, number)
+                }
+                is Float -> {
+                    val number = value.toFloatOrNull()
+                        ?: throw IllegalArgumentException("the settings are damaged")
+                    TeleConfig.set(item, number)
+                }
+                is String -> TeleConfig.set(item, value)
+                else -> continue
+            }
+            TeleHooks.onConfigChanged(item)
+            applied++
+        }
+        return applied
+    }
+}
