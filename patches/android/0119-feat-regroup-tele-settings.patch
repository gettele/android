+    private fun exportSettings() {
+        val text = tele.helpers.TeleBackup.export()
+        AndroidUtilities.addToClipboard(text)
+        BulletinFactory.of(this).createSimpleBulletin(R.raw.info, "The settings are copied to the clipboard.").show()
+    }
+
+    private fun importSettings() {
+        val context = screenContext ?: return
+        val clipboard = context.getSystemService(android.content.Context.CLIPBOARD_SERVICE) as? android.content.ClipboardManager ?: return
+        val clip = clipboard.primaryClip ?: return
+        if (clip.itemCount == 0) return
+        val text = clip.getItemAt(0).coerceToText(context).toString()
+        val applied = runCatching { tele.helpers.TeleBackup.import(text) }
+        if (applied.isSuccess) {
+            BulletinFactory.of(this).createSimpleBulletin(R.raw.info, "Imported ${applied.getOrNull()} settings.").show()
+            refresh()
+        } else {
+            BulletinFactory.of(this).createSimpleBulletin(R.raw.error, "This is not a tele settings export.").show()
+        }
+    }
