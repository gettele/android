+import org.telegram.ui.Components.RecyclerListView
+import tele.db.TeleDatabaseHelper
+import tele.helpers.DeletedMessages
+
+class TeleDeletedMessagesActivity : BaseFragment() {
+    private val account get() = UserConfig.selectedAccount
+    private val dialogId get() = arguments?.getLong(ARG_DIALOG_ID) ?: 0L
+    private var dialogs: List<TeleDatabaseHelper.ArchivedDialog> = emptyList()
+    private var messages: List<TLRPC.Message> = emptyList()
+    private var adapter: Adapter? = null
+    private var sharedResources: org.telegram.messenger.ChatMessageSharedResources? = null
+
+    private val isDialogMode get() = dialogId != 0L
+
+    private fun reload() {
+        if (isDialogMode) {
+            messages = DeletedMessages.getAll(account, dialogId)
+        } else {
+            dialogs = DeletedMessages.getDialogs(account)
+        }
+        adapter?.notifyDataSetChanged()
+    }
+
+    override fun createView(context: Context): View {
+        actionBar.setBackButtonImage(R.drawable.ic_ab_back)
+        actionBar.setAllowOverlayTitle(true)
+        actionBar.setTitle(if (isDialogMode) peerTitle(dialogId) else LocaleController.getString(R.string.TeleDeletedMessages))
+        actionBar.setActionBarMenuOnItemClick(object : ActionBar.ActionBarMenuOnItemClick() {
+            override fun onItemClick(id: Int) {
+                if (id == -1) finishFragment()
+                else if (id == MENU_CLEAR) confirmClear()
+            }
+        })
+        actionBar.createMenu().addItem(MENU_CLEAR, R.drawable.msg_delete)
+
+        reload()
+        val container = FrameLayout(context)
+        container.setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundGray))
+        fragmentView = container
+        val list = RecyclerListView(context)
+        val layoutManager = LinearLayoutManager(context)
+        if (isDialogMode) {
+            layoutManager.stackFromEnd = true
+        }
+        list.setLayoutManager(layoutManager)
+        list.setVerticalScrollBarEnabled(false)
+        adapter = Adapter(context)
+        list.adapter = adapter
+        list.setOnItemClickListener { _, position ->
+            if (!isDialogMode) {
+                dialogs.getOrNull(position)?.let { presentFragment(ofDialog(it.dialogId)) }
+            }
+        }
+        container.addView(list, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.MATCH_PARENT.toFloat()))
+        return container
+    }
+
+    override fun onResume() {
+        super.onResume()
+        reload()
+    }
+
+    private fun confirmClear() {
+        if (isDialogMode) {
+            if (messages.isEmpty()) return
+            val ids = ArrayList<Int>(messages.size)
+            for (message in messages) ids.add(message.id)
+            clearDialog(dialogId, ids)
+            return
+        }
+        if (dialogs.isEmpty()) return
+        for (dialog in dialogs) {
+            val ids = ArrayList<Int>()
+            for (message in DeletedMessages.getAll(account, dialog.dialogId)) ids.add(message.id)
+            clearDialog(dialog.dialogId, ids)
+        }
+    }
+
+    private fun clearDialog(targetDialogId: Long, ids: ArrayList<Int>) {
+        if (ids.isEmpty()) {
+            DeletedMessages.deleteAll(account, targetDialogId)
+            reload()
+            return
+        }
+        MessagesController.getInstance(account).deleteMessagesFromUser(ids, null, null, targetDialogId, 0, false, 0)
+    }
+
+    private fun peerTitle(id: Long): String {
+        val controller = MessagesController.getInstance(account)
+        if (id > 0) {
+            val user = controller.getUser(id)
+            if (user != null) return ContactsController.formatName(user.first_name, user.last_name)
+        } else if (id < 0) {
+            val chat = controller.getChat(-id)
+            if (chat != null) return chat.title
+        }
+        return "id $id"
+    }
+
+    private inner class Adapter(private val context: Context) : RecyclerListView.SelectionAdapter() {
+        override fun getItemCount(): Int = if (isDialogMode) maxOf(messages.size, 1) else maxOf(dialogs.size, 1)
+        override fun isEnabled(holder: RecyclerView.ViewHolder): Boolean = !isDialogMode
+
+        override fun getItemViewType(position: Int): Int = if (isDialogMode) {
+            if (messages.isEmpty()) TYPE_EMPTY else TYPE_MESSAGE
+        } else {
+            if (dialogs.isEmpty()) TYPE_EMPTY else TYPE_DIALOG
+        }
+
+        override fun onCreateViewHolder(parent: ViewGroup, viewType: Int): RecyclerView.ViewHolder {
+            val view: View = when (viewType) {
+                TYPE_EMPTY -> TextView(context).apply {
+                    setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2))
+                    textSize = 14f
+                    setPadding(AndroidUtilities.dp(16f), AndroidUtilities.dp(12f), AndroidUtilities.dp(16f), AndroidUtilities.dp(4f))
+                }
+                TYPE_DIALOG -> LinearLayout(context).apply {
+                    orientation = LinearLayout.HORIZONTAL
+                    gravity = Gravity.CENTER_VERTICAL
+                    setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundWhite))
+                    val avatar = BackupImageView(context).apply { tag = AVATAR_TAG }
+                    addView(avatar, LinearLayout.LayoutParams(AndroidUtilities.dp(48f), AndroidUtilities.dp(48f)).apply {
+                        leftMargin = AndroidUtilities.dp(12f)
+                        topMargin = AndroidUtilities.dp(8f)
+                        bottomMargin = AndroidUtilities.dp(8f)
+                    })
+                    val textColumn = LinearLayout(context).apply { orientation = LinearLayout.VERTICAL }
+                    addView(textColumn, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT).apply {
+                        leftMargin = AndroidUtilities.dp(12f)
+                        rightMargin = AndroidUtilities.dp(16f)
+                    })
+                    textColumn.addView(TextView(context).apply {
+                        tag = TITLE_TAG
+                        setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
+                        textSize = 16f
+                    }, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT))
+                    textColumn.addView(TextView(context).apply {
+                        tag = SUBTITLE_TAG
+                        setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2))
+                        textSize = 13f
+                    }, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT))
+                }
+                else -> LinearLayout(context).apply {
+                    orientation = LinearLayout.VERTICAL
+                    setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundWhite))
+                    addView(TextView(context).apply {
+                        tag = LABEL_TAG
+                        setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
+                        textSize = 13f
+                        setPadding(AndroidUtilities.dp(16f), AndroidUtilities.dp(12f), AndroidUtilities.dp(16f), AndroidUtilities.dp(4f))
+                    }, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT))
+                    addView(ChatMessageCell(context, account, false, sharedResources ?: org.telegram.messenger.ChatMessageSharedResources(context).also { sharedResources = it }, resourceProvider).apply {
+                        tag = CELL_TAG
+                    }, LinearLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT))
+                }
+            }
+            view.layoutParams = RecyclerView.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT)
+            return RecyclerListView.Holder(view)
+        }
+
+        override fun onBindViewHolder(holder: RecyclerView.ViewHolder, position: Int) {
+            when (getItemViewType(position)) {
+                TYPE_EMPTY -> (holder.itemView as TextView).text = LocaleController.getString(R.string.TeleDeletedHistoryEmpty)
+                TYPE_DIALOG -> {
+                    val dialog = dialogs[position]
+                    val avatar = holder.itemView.findViewWithTag<BackupImageView>(AVATAR_TAG)
+                    val controller = MessagesController.getInstance(account)
+                    val user = controller.getUser(dialog.dialogId)
+                    val chat = controller.getChat(-dialog.dialogId)
+                    if (user != null) {
+                        val avatarDrawable = AvatarDrawable(user)
+                        avatar.setForUserOrChat(user, avatarDrawable)
+                    } else if (chat != null) {
+                        val avatarDrawable = AvatarDrawable(chat)
+                        avatar.setForUserOrChat(chat, avatarDrawable)
+                    }
+                    holder.itemView.findViewWithTag<TextView>(TITLE_TAG).text = peerTitle(dialog.dialogId)
+                    val count = dialog.count
+                    val preview = if (count == 1) "1 deleted message" else "$count deleted messages"
+                    holder.itemView.findViewWithTag<TextView>(SUBTITLE_TAG).text = "$preview · ${LocaleController.formatDateChat(dialog.lastDeletedAt.toLong())}"
+                }
+                else -> {
+                    val message = messages[position]
+                    holder.itemView.findViewWithTag<TextView>(LABEL_TAG).text = "${senderTitle(message)} · ${LocaleController.formatDateChat(message.date.toLong())}"
+                    val messageObject = MessageObject(account, message, true, false)
+                    holder.itemView.findViewWithTag<ChatMessageCell>(CELL_TAG).setMessageObject(messageObject, null, false, false, true, true)
+                }
+            }
+        }
+    }
+
+    private fun senderTitle(message: TLRPC.Message): String {
+        val senderId = message.from_id?.user_id ?: 0L
+        if (senderId != 0L) {
+            val user = MessagesController.getInstance(account).getUser(senderId)
+            if (user != null) return ContactsController.formatName(user.first_name, user.last_name)
+        }
+        return peerTitle(message.peer_id?.user_id ?: 0L)
+    }
+
+    companion object {
+        const val MODE_ARCHIVE = "deleted_archive"
+        private const val ARG_DIALOG_ID = "dialog_id"
+        private const val MENU_CLEAR = 1
+        private const val TYPE_EMPTY = 0
+        private const val TYPE_DIALOG = 1
+        private const val TYPE_MESSAGE = 2
+        private const val AVATAR_TAG = 3
+        private const val TITLE_TAG = 4
+        private const val SUBTITLE_TAG = 5
+        private const val LABEL_TAG = 6
+        private const val CELL_TAG = 7
+
+        @JvmStatic
+        fun ofDialog(dialogId: Long): TeleDeletedMessagesActivity = TeleDeletedMessagesActivity().apply {
+            arguments = android.os.Bundle().apply { putLong(ARG_DIALOG_ID, dialogId) }
+        }
+    }
+}
