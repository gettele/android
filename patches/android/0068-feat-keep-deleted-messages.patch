+    fun getDeletedMessages(account: Int, dialogId: Long? = null): List<ArchivedMessage> {
+        val db = helper?.readableDatabase ?: return emptyList()
+        val result = ArrayList<ArchivedMessage>()
+        val cursor = if (dialogId == null) {
+            db.rawQuery("SELECT account, dialog_id, message_id, date, deleted_at, data FROM tele_deleted_messages WHERE account = ? ORDER BY deleted_at DESC, message_id DESC", arrayOf(account.toString()))
+        } else {
+            db.rawQuery("SELECT account, dialog_id, message_id, date, deleted_at, data FROM tele_deleted_messages WHERE account = ? AND dialog_id = ? ORDER BY deleted_at DESC, message_id DESC", arrayOf(account.toString(), dialogId.toString()))
+        }
+        cursor.use {
+            while (it.moveToNext()) result.add(ArchivedMessage(it.getInt(0), it.getLong(1), it.getInt(2), it.getInt(3), it.getInt(4), it.getBlob(5)))
+        }
+        return result
+    }
+
+    fun deleteDeletedMessages(account: Int, dialogId: Long? = null) {
+        val db = helper?.writableDatabase ?: return
+        if (dialogId == null) db.delete("tele_deleted_messages", "account = ?", arrayOf(account.toString()))
+        else db.delete("tele_deleted_messages", "account = ? AND dialog_id = ?", arrayOf(account.toString(), dialogId.toString()))
+    }
+
+    private class Helper(context: Context) : SQLiteOpenHelper(context, "tele.db", null, 2) {
