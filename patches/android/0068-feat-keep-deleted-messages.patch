@@ -0,0 +1,48 @@
+package tele.helpers
+
+import org.telegram.messenger.UserConfig
+import org.telegram.tgnet.TLRPC
+import org.telegram.tgnet.SerializedData
+import tele.TeleConfig
+import tele.db.TeleDatabaseHelper
+
+object DeletedMessages {
+    @JvmStatic
+    fun shouldArchive(account: Int, outgoing: Boolean, userInitiated: Boolean = false, dialogId: Long = 0L): Boolean =
+        !org.telegram.messenger.DialogObject.isEncryptedDialog(dialogId) && (TeleConfig.KEEP_DELETED_MESSAGES.value || outgoing && userInitiated && TeleConfig.KEEP_SELF_DELETED_MESSAGES.value)
+
+    @JvmStatic
+    fun archiveMessage(account: Int, message: TLRPC.Message, userInitiated: Boolean = false) {
+        if (message.id <= 0 || !shouldArchive(account, message.out, userInitiated, message.dialog_id)) return
+        val stream = SerializedData(message.getObjectSize())
+        try {
+            message.serializeToStream(stream)
+            TeleDatabaseHelper.putDeletedMessage(account, message.dialog_id, message.id, message.date, (System.currentTimeMillis() / 1000L).toInt(), stream.toByteArray())
+        } finally {
+            stream.cleanup()
+        }
+    }
+
+    @JvmStatic
+    fun getAll(account: Int, dialogId: Long? = null): List<TLRPC.Message> {
+        return TeleDatabaseHelper.getDeletedMessages(account, dialogId).mapNotNull { row ->
+            runCatching {
+                val stream = SerializedData(row.data)
+                try {
+                    val message = TLRPC.Message.TLdeserialize(stream, stream.readInt32(false), false) ?: return@runCatching null
+                    message.readAttachPath(stream, UserConfig.getInstance(account).clientUserId)
+                    message.dialog_id = row.dialogId
+                    message.id = row.messageId
+                    message
+                } finally {
+                    stream.cleanup()
+                }
+            }.getOrNull()
+        }
+    }
+
+    @JvmStatic
+    fun deleteAll(account: Int, dialogId: Long? = null) {
+        TeleDatabaseHelper.deleteDeletedMessages(account, dialogId)
+    }
+}
