diff --git a/TMessagesProj/src/main/java/tele/helpers/DeletedMessages.kt b/TMessagesProj/src/main/java/tele/helpers/DeletedMessages.kt
new file mode 100644
index 000000000..4e541f11c
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/DeletedMessages.kt
@@ -0,0 +1,156 @@
+package tele.helpers
+
+import android.graphics.Canvas
+import android.graphics.PorterDuff
+import android.graphics.drawable.Drawable
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.ApplicationLoader
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.MessageObject
+import org.telegram.messenger.R
+import org.telegram.messenger.UserConfig
+import org.telegram.tgnet.TLRPC
+import org.telegram.tgnet.SerializedData
+import tele.TeleConfig
+import tele.db.TeleDatabaseHelper
+import java.util.concurrent.ConcurrentHashMap
+
+object DeletedMessages {
+    @JvmStatic
+    fun shouldArchive(account: Int, outgoing: Boolean, userInitiated: Boolean = false, dialogId: Long = 0L): Boolean =
+        !org.telegram.messenger.DialogObject.isEncryptedDialog(dialogId) && (TeleConfig.KEEP_DELETED_MESSAGES.value || outgoing && userInitiated && TeleConfig.KEEP_SELF_DELETED_MESSAGES.value)
+
+    @JvmStatic
+    fun keepInChat(account: Int, message: TLRPC.Message, userInitiated: Boolean): Boolean {
+        if (message.id <= 0) return false
+        if (!shouldArchive(account, message.out, userInitiated, message.dialog_id)) return false
+        if (message.action != null && message.action !is TLRPC.TL_messageActionEmpty) return false
+        val media = message.media
+        if (media != null && media.ttl_seconds != 0) return false
+        return true
+    }
+
+    @JvmStatic
+    fun archiveMessage(account: Int, message: TLRPC.Message, userInitiated: Boolean = false) {
+        if (message.id <= 0 || !shouldArchive(account, message.out, userInitiated, message.dialog_id)) return
+        val stream = SerializedData(message.getObjectSize())
+        try {
+            message.serializeToStream(stream)
+            TeleDatabaseHelper.putDeletedMessage(account, message.dialog_id, message.id, message.date, (System.currentTimeMillis() / 1000L).toInt(), stream.toByteArray())
+        } finally {
+            stream.cleanup()
+        }
+    }
+
+    @JvmStatic
+    fun isKeptDb(account: Int, dialogId: Long, messageId: Int): Boolean {
+        return TeleDatabaseHelper.hasDeletedMessage(account, dialogId, messageId)
+    }
+
+    @JvmStatic
+    fun removeKeptDb(account: Int, dialogId: Long, messageId: Int) {
+        TeleDatabaseHelper.removeDeletedMessage(account, dialogId, messageId)
+    }
+
+    private val keptInChat = ConcurrentHashMap<Int, ConcurrentHashMap<Long, MutableSet<Int>>>()
+    private val loadedDialogs = ConcurrentHashMap.newKeySet<Long>()
+
+    private fun dialogKey(account: Int, dialogId: Long): Long = (account.toLong() shl 48) or (dialogId and 0xFFFFFFFFFFFFL)
+
+    @JvmStatic
+    fun ensureLoaded(account: Int, dialogId: Long) {
+        val key = dialogKey(account, dialogId)
+        if (!loadedDialogs.add(key)) return
+        val ids = TeleDatabaseHelper.getKeptIds(account, dialogId)
+        keptInChat.getOrPut(account) { ConcurrentHashMap() }.getOrPut(dialogId) { ConcurrentHashMap.newKeySet() }.addAll(ids)
+    }
+
+    @JvmStatic
+    fun isKept(account: Int, dialogId: Long, messageId: Int): Boolean {
+        ensureLoaded(account, dialogId)
+        return keptInChat[account]?.get(dialogId)?.contains(messageId) == true
+    }
+
+    @JvmStatic
+    fun isKept(messageObject: MessageObject): Boolean {
+        return messageObject.messageOwner != null && isKept(messageObject.currentAccount, messageObject.getDialogId(), messageObject.getId())
+    }
+
+    @JvmStatic
+    fun filterInChat(account: Int, dialogId: Long, ids: ArrayList<Int>, userInitiated: Boolean, lookup: (Int) -> MessageObject?): ArrayList<Int>? {
+        if (ids.isEmpty()) return null
+        ensureLoaded(account, dialogId)
+        val set = keptInChat.getOrPut(account) { ConcurrentHashMap() }.getOrPut(dialogId) { ConcurrentHashMap.newKeySet() }
+        var keptAny = false
+        val result = ArrayList<Int>(ids.size)
+        for (id in ids) {
+            val obj = lookup(id)
+            if (obj != null && obj.messageOwner != null) {
+                if (set.contains(id)) {
+                    set.remove(id)
+                } else if (keepInChat(account, obj.messageOwner, userInitiated)) {
+                    set.add(id)
+                    keptAny = true
+                    continue
+                }
+            }
+            result.add(id)
+        }
+        return if (keptAny) result else null
+    }
+
+    @JvmStatic
+    fun getAll(account: Int, dialogId: Long? = null): List<TLRPC.Message> {
+        return TeleDatabaseHelper.getDeletedMessages(account, dialogId).mapNotNull { row ->
+            runCatching {
+                val stream = SerializedData(row.data)
+                try {
+                    val message = TLRPC.Message.TLdeserialize(stream, stream.readInt32(false), false) ?: return@runCatching null
+                    message.readAttachPath(stream, UserConfig.getInstance(account).clientUserId)
+                    message.dialog_id = row.dialogId
+                    message.id = row.messageId
+                    message
+                } finally {
+                    stream.cleanup()
+                }
+            }.getOrNull()
+        }
+    }
+
+    fun getDialogs(account: Int): List<TeleDatabaseHelper.ArchivedDialog> = TeleDatabaseHelper.getDeletedDialogs(account)
+
+    fun deleteAll(account: Int, dialogId: Long? = null) {
+        TeleDatabaseHelper.deleteDeletedMessages(account, dialogId)
+    }
+
+    @JvmStatic
+    fun fadeMarker(): Boolean = TeleConfig.DELETED_MARKER.value == "fade"
+    @JvmStatic
+    fun textMarker(): Boolean = TeleConfig.DELETED_MARKER.value == "text"
+    @JvmStatic
+    fun iconMarker(): Boolean = TeleConfig.DELETED_MARKER.value == "icon"
+
+    @JvmStatic
+    fun markerText(): CharSequence = LocaleController.getString(R.string.TeleDeletedMarker)
+    @JvmStatic
+    fun markerWidth(): Int = AndroidUtilities.dp(18f)
+
+    private var trashDrawable: Drawable? = null
+    private var trashColor = 0
+
+    @JvmStatic
+    fun drawTrashMarker(canvas: Canvas, rightX: Float, centerY: Float, color: Int, alpha: Float) {
+        if (trashDrawable == null) {
+            trashDrawable = ApplicationLoader.applicationContext.getDrawable(R.drawable.msg_delete)?.mutate()
+            if (trashDrawable == null) return
+        }
+        if (trashColor != color) {
+            trashColor = color
+            trashDrawable!!.colorFilter = android.graphics.PorterDuffColorFilter(color, PorterDuff.Mode.SRC_ATOP)
+        }
+        trashDrawable!!.alpha = (alpha * 255).toInt()
+        val size = AndroidUtilities.dp(14f)
+        trashDrawable!!.setBounds((rightX - size).toInt(), (centerY - size / 2f).toInt(), rightX.toInt(), (centerY + size / 2f).toInt())
+        trashDrawable!!.draw(canvas)
+    }
+}
