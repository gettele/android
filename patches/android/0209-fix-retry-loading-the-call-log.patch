From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Sun, 25 Oct 2026 15:53:56 +0300
Subject: [PATCH] fix: retry loading the call log

---
 .../java/org/telegram/ui/CallLogActivity.java | 23 +++++++++++++++++--
 1 file changed, 21 insertions(+), 2 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/CallLogActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/CallLogActivity.java
index f77cbefd4..439af544e 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/CallLogActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/CallLogActivity.java
@@ -716,6 +716,15 @@ public class CallLogActivity extends BaseFragment implements NotificationCenter.
 			observersGroup = null;
 		}
 		super.onFragmentDestroy();
+		if (retryRunnable != null) {
+			AndroidUtilities.cancelRunOnUIThread(retryRunnable);
+			retryRunnable = null;
+		}
+		getNotificationCenter().removeObserver(this, NotificationCenter.didReceiveNewMessages);
+		getNotificationCenter().removeObserver(this, NotificationCenter.messagesDeleted);
+		getNotificationCenter().removeObserver(this, NotificationCenter.activeGroupCallsUpdated);
+		getNotificationCenter().removeObserver(this, NotificationCenter.chatInfoDidLoad);
+		getNotificationCenter().removeObserver(this, NotificationCenter.groupCallUpdated);
 	}
 
 	@Override
@@ -1193,8 +1202,11 @@ public class CallLogActivity extends BaseFragment implements NotificationCenter.
 		simpleActionBar.setActionModeCount(selectedIds.size(), updateAnimated);
 	}
 
+	private Runnable retryRunnable;
+	private long retryDelay;
+
 	private void getCalls(int max_id, final int count) {
-		if (loading) {
+		if (loading || retryRunnable != null) {
 			return;
 		}
 		loading = true;
@@ -1319,8 +1331,15 @@ public class CallLogActivity extends BaseFragment implements NotificationCenter.
 				if (currentRow != null && !currentRow.calls.isEmpty() && !calls.contains(currentRow)) {
 					calls.add(currentRow);
 				}
+				retryDelay = 0;
 			} else {
-				endReached = true;
+				// keep the rows and retry with a bounded backoff instead of ending the list
+				retryDelay = retryDelay == 0 ? 1000 : Math.min(retryDelay * 2, 30000);
+				retryRunnable = () -> {
+					retryRunnable = null;
+					getCalls(max_id, count);
+				};
+				AndroidUtilities.runOnUIThread(retryRunnable, retryDelay);
 			}
 			loading = false;
 			if (!firstLoaded) {
