@@ -0,0 +1,43 @@
+package tele.helpers
+
+import android.content.Context
+import android.content.Intent
+import android.net.Uri
+import org.telegram.messenger.FileLog
+import tele.TeleConfig
+import java.util.Locale
+
+// opens a location in the picked web map instead of the system "geo:" handler
+object MapService {
+
+    class Site(val id: String, val name: String, val url: String)
+
+    @JvmField
+    val SITES = listOf(
+        Site("google", "Google Maps", "https://maps.google.com/maps?q={lat},{lon}&ll={lat},{lon}&z=16"),
+        Site("osm", "OpenStreetMap", "https://www.openstreetmap.org/?mlat={lat}&mlon={lon}#map=16/{lat}/{lon}"),
+        Site("yandex", "Yandex Maps", "https://yandex.ru/maps/?ll={lon},{lat}&z=16&pt={lon},{lat}"),
+        Site("2gis", "2GIS", "https://2gis.ru/geo/{lon},{lat}?m={lon},{lat}/16"),
+        Site("apple", "Apple Maps", "https://maps.apple.com/?ll={lat},{lon}&q={title}&z=16")
+    )
+
+    fun label(id: String): String = SITES.firstOrNull { it.id == id }?.name ?: "System default"
+
+    /** True when the location was opened in the picked site; false means the caller keeps the stock flow. */
+    @JvmStatic
+    fun open(context: Context?, lat: Double, lon: Double, title: String?): Boolean {
+        val site = SITES.firstOrNull { it.id == TeleConfig.MAP_SERVICE.value }
+        if (site == null || context == null) return false
+        return try {
+            val url = site.url
+                .replace("{lat}", String.format(Locale.ENGLISH, "%.6f", lat))
+                .replace("{lon}", String.format(Locale.ENGLISH, "%.6f", lon))
+                .replace("{title}", Uri.encode(if (title.isNullOrEmpty()) "Point" else title))
+            context.startActivity(Intent(Intent.ACTION_VIEW, Uri.parse(url)).addFlags(Intent.FLAG_ACTIVITY_NEW_TASK))
+            true
+        } catch (e: Exception) {
+            FileLog.e(e)
+            false
+        }
+    }
+}
