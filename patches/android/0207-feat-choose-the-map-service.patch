+    private fun chooseMapService() {
+        val activity = parentActivity ?: return
+        val sites = tele.helpers.MapService.SITES
+        val values = arrayOf("") + sites.map { it.id }
+        val labels = arrayOf(lc("System default")) + sites.map { lc(it.name) }
+        val builder = if (resourceProvider != null) AlertDialog.Builder(activity, resourceProvider) else AlertDialog.Builder(activity)
+        builder.setTitle(lc("Map service"))
+        builder.setItems(labels) { _, which ->
+            TeleConfig.set(TeleConfig.MAP_SERVICE, values[which])
+            refresh()
+        }
+        showDialog(builder.create())
+    }
+
