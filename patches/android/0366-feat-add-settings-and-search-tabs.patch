+    val TELE_SECTION_SLUGS = TELE_SECTION_MODES.keys.toList()
 
     @JvmStatic
     fun labelsMode(): Int = when (TeleConfig.MAIN_TABS_LABELS.value) {
@@ -42,6 +90,31 @@ object MainTabsConfig {
         else -> LABELS_ALL
     }
 
+    @JvmStatic
+    fun isTeleSettingsKind(kind: String): Boolean = kind == KIND_TELE_SETTINGS || kind in TELE_SECTION_KINDS
+
+    @JvmStatic
+    fun teleSectionKind(slug: String): String = KIND_TELE_SECTION_PREFIX + slug
+
+    @JvmStatic
+    fun teleSettingsMode(kind: String): String {
+        if (kind == KIND_TELE_SETTINGS) return TeleSettingsActivity.MODE_ROOT
+        return TELE_SECTION_MODES[kind.removePrefix(KIND_TELE_SECTION_PREFIX)] ?: TeleSettingsActivity.MODE_ROOT
+    }
+
+    @JvmStatic
+    fun titleResOf(kind: String): Int = when (kind) {
+        KIND_TELE_SETTINGS -> R.string.TeleTabTele
+        KIND_SEARCH -> R.string.Search
+        KIND_NOTIFICATIONS -> R.string.SettingsNotifications
+        KIND_DATA_USAGE -> R.string.TeleTabDataStorage
+        else -> if (kind.startsWith(KIND_TELE_SECTION_PREFIX)) {
+            TELE_SECTION_TITLES[kind.removePrefix(KIND_TELE_SECTION_PREFIX)] ?: 0
+        } else {
+            0
+        }
+    }
+
     /** The icon a page slot shows: its own choice, or the one its kind starts with. */
     @JvmStatic
     fun iconNameOf(slot: Slot): String =
