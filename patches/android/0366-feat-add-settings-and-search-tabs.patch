+    private fun showTeleSectionPicker(anchor: View) {
+        if (slots.size >= MainTabsConfig.MAX_SLOTS) {
+            bulletin(lc("The bar holds six tabs."))
+            return
+        }
+        val options = ItemOptions.makeOptions(this, anchor)
+        if (slots.none { it.kind == MainTabsConfig.KIND_TELE_SETTINGS }) {
+            options.add(R.drawable.tele_settings_icon, localized(R.string.TeleTabTeleSettings)) {
+                addSlot(MainTabsConfig.Slot(MainTabsConfig.KIND_TELE_SETTINGS))
+            }
+        }
+        for (slug in MainTabsConfig.TELE_SECTION_SLUGS) {
+            val kind = MainTabsConfig.teleSectionKind(slug)
+            if (slots.any { it.kind == kind }) continue
+            options.add(R.drawable.msg_settings, localized(MainTabsConfig.titleResOf(kind))) {
+                addSlot(MainTabsConfig.Slot(kind))
+            }
+        }
+        options.setBlur(true)
+        options.translate(0f, -AndroidUtilities.dp(4f).toFloat())
+        val bg = Theme.createRoundRectDrawable(AndroidUtilities.dp(28f), Theme.getColor(Theme.key_windowBackgroundWhite, resourceProvider))
+        bg.paint.setShadowLayer(AndroidUtilities.dp(6f).toFloat(), 0f, AndroidUtilities.dp(1f).toFloat(), Theme.multAlpha(0xFF000000.toInt(), 0.15f))
+        options.setScrimViewBackground(bg)
+        options.show()
+    }
+
