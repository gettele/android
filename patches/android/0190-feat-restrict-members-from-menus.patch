diff --git a/TMessagesProj/src/main/java/tele/helpers/RestrictMembers.kt b/TMessagesProj/src/main/java/tele/helpers/RestrictMembers.kt
new file mode 100644
index 000000000..6a6df30d6
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/RestrictMembers.kt
@@ -0,0 +1,132 @@
+package tele.helpers
+
+import androidx.collection.LongSparseArray
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.ChatObject
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.MessageObject
+import org.telegram.messenger.MessagesController
+import org.telegram.messenger.R
+import org.telegram.messenger.UserConfig
+import org.telegram.messenger.UserObject
+import org.telegram.tgnet.TLObject
+import org.telegram.tgnet.TLRPC
+import org.telegram.ui.ActionBar.AlertDialog
+import org.telegram.ui.ActionBar.BaseFragment
+import org.telegram.ui.ChatActivity
+import org.telegram.ui.ChatRightsEditActivity
+import tele.TeleConfig
+
+// tele 0328: restrict a member from a message or userpic menu, and find people by their numeric id in the member pickers
+object RestrictMembers {
+
+    private const val MAX_ID_DIGITS = 20
+
+    /** Group admins with the right to ban, for a member who isn't the creator, nor you, nor an admin you can't edit. */
+    @JvmStatic
+    fun canRestrict(account: Int, chat: TLRPC.Chat?, user: TLRPC.User?): Boolean {
+        if (!TeleConfig.RESTRICT_MENU.value || chat == null || user == null) return false
+        if (!ChatObject.isChannel(chat) || !chat.megagroup || !ChatObject.canBlockUsers(chat)) return false
+        if (UserObject.isUserSelf(user) || UserObject.isDeleted(user) || user.id == UserConfig.getInstance(account).getClientUserId()) return false
+        val admin = MessagesController.getInstance(account).getAdminInChannel(user.id, chat.id)
+        if (admin is TLRPC.TL_channelParticipantCreator) return false
+        return admin !is TLRPC.TL_channelParticipantAdmin || admin.can_edit
+    }
+
+    /** The user who wrote a regular message; none for anonymous admins, channels and service entries. */
+    private fun senderOf(account: Int, message: MessageObject?): TLRPC.User? {
+        val owner = message?.messageOwner ?: return null
+        if (message.id <= 0 || message.scheduled || message.isSponsored) return null
+        val from = owner.from_id as? TLRPC.TL_peerUser ?: return null
+        return MessagesController.getInstance(account).getUser(from.user_id)
+    }
+
+    @JvmStatic
+    fun fillMenu(chat: ChatActivity, message: MessageObject?, items: ArrayList<CharSequence>, icons: ArrayList<Int>, options: ArrayList<Int>) {
+        if (!TeleConfig.RESTRICT_MENU.value) return
+        val account = chat.currentAccount
+        val user = senderOf(account, message) ?: return
+        if (!canRestrict(account, chat.currentChat, user)) return
+        items.add(LocaleController.getString(R.string.Restrict))
+        icons.add(R.drawable.msg_permissions)
+        options.add(ChatActivity.tele_option_restrict)
+    }
+
+    @JvmStatic
+    fun restrictMessageSender(chat: ChatActivity, message: MessageObject?) {
+        val user = senderOf(chat.currentAccount, message) ?: return
+        open(chat, chat.currentChat, user)
+    }
+
+    /** Opens the stock rights editor with the current restrictions of the member; nothing is deleted. */
+    @JvmStatic
+    fun open(fragment: BaseFragment, chat: TLRPC.Chat?, user: TLRPC.User?) {
+        val account = fragment.currentAccount
+        if (chat == null || user == null || !canRestrict(account, chat, user)) return
+        MessagesController.getInstance(account).getChannelParticipant(chat, user) { participant ->
+            AndroidUtilities.runOnUIThread {
+                if (fragment.parentActivity == null || fragment.parentLayout == null) return@runOnUIThread
+                present(fragment, chat, user, participant)
+            }
+        }
+    }
+
+    private fun present(fragment: BaseFragment, chat: TLRPC.Chat, user: TLRPC.User, participant: TLRPC.ChannelParticipant?) {
+        if (participant is TLRPC.TL_channelParticipantCreator) return
+        val admin = participant is TLRPC.TL_channelParticipantAdmin
+        val edit = {
+            fragment.presentFragment(ChatRightsEditActivity(
+                user.id,
+                chat.id,
+                participant?.admin_rights,
+                chat.default_banned_rights,
+                participant?.banned_rights,
+                participant?.rank ?: "",
+                ChatRightsEditActivity.TYPE_BANNED,
+                !admin || participant?.can_edit == true,
+                false,
+                null
+            ))
+        }
+        if (!admin) {
+            edit()
+            return
+        }
+        // like the stock exception picker: restricting an admin removes their admin rights
+        val activity = fragment.parentActivity ?: return
+        val builder = AlertDialog.Builder(activity)
+        builder.setTitle(LocaleController.getString(R.string.AppName))
+        builder.setMessage(LocaleController.formatString(R.string.AdminWillBeRemoved, UserObject.getUserName(user)))
+        builder.setPositiveButton(LocaleController.getString(R.string.OK)) { _, _ -> edit() }
+        builder.setNegativeButton(LocaleController.getString(R.string.Cancel), null)
+        fragment.showDialog(builder.create())
+    }
+
+    /** The user a numeric query names, when this account already knows them. */
+    @JvmStatic
+    fun userById(account: Int, query: String?): TLRPC.User? {
+        if (!TeleConfig.RESTRICT_MENU.value || query == null) return null
+        val digits = query.trim().replace(" ", "")
+        if (digits.isEmpty() || digits.length > MAX_ID_DIGITS || !digits.all { it in '0'..'9' }) return null
+        val id = digits.toLongOrNull()?.takeIf { it > 0 } ?: return null
+        val user = MessagesController.getInstance(account).getUser(id) ?: return null
+        return if (user.id == UserConfig.getInstance(account).getClientUserId()) null else user
+    }
+
+    /** Adds the found user to the picker's own results, unless the list already holds them. */
+    @JvmStatic
+    fun addFound(result: ArrayList<Any?>, map: LongSparseArray<TLObject>, names: ArrayList<CharSequence?>, group: List<TLObject>, user: TLRPC.User?) {
+        if (user == null || map.get(user.id) != null) return
+        if (result.any { it is TLRPC.User && it.id == user.id }) return
+        val inGroup = group.any {
+            (it is TLRPC.ChannelParticipant && MessageObject.getPeerId(it.peer) == user.id) ||
+                (it is TLRPC.ChatParticipant && it.user_id == user.id)
+        }
+        if (inGroup) return
+        val at = result.size
+        while (names.size < at) names.add(null)
+        names.add(at.coerceAtMost(names.size), UserObject.getUserName(user))
+        result.add(user)
+        map.put(user.id, user)
+    }
+}
