diff --git a/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
index e80cf12b6..0fad404b1 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/ChatActivity.java
@@ -1256,6 +1256,7 @@ public class ChatActivity extends BaseFragment implements
     public final static int tele_option_view_as_tl = 120;
     public final static int tele_option_edit_history = 121;
     public final static int tele_option_shot = 130;
+    public final static int tele_option_copy_service_text = 219;
     public final static int OPTION_ABOUT_REVENUE_SHARING_ADS = 33;
     public final static int OPTION_REPORT_AD = 34;
     public final static int OPTION_REMOVE_ADS = 35;
@@ -34169,6 +34170,12 @@ public class ChatActivity extends BaseFragment implements
                 BulletinFactory.of(this).createCopyBulletin(getString(R.string.TeleMessageIdCopied)).show();
                 break;
             }
+            case tele_option_copy_service_text: {
+                // the localized text of the service message
+                AndroidUtilities.addToClipboard(selectedObject.messageText);
+                BulletinFactory.of(this).createCopyBulletin(getString(R.string.TeleMessageIdCopied)).show();
+                break;
+            }
             case tele_option_view_as_tl: {
                 final MessageObject object = selectedObject;
                 closeMenu();
@@ -46743,6 +46750,13 @@ public class ChatActivity extends BaseFragment implements
             options.add(0, tele_option_copy_msg_id);
             icons.add(0, R.drawable.msg_copy);
         }
+        if (tele.TeleConfig.COPY_SERVICE_TEXT.getValue() && message.getId() > 0
+                && message.messageOwner != null && message.messageOwner.action != null
+                && message.messageText != null && message.messageText.length() > 0) {
+            items.add(0, "Copy service text");
+            options.add(0, tele_option_copy_service_text);
+            icons.add(0, R.drawable.msg_copy);
+        }
 
 
         boolean allowChatActions = true;
