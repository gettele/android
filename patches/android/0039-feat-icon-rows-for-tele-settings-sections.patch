+        val value: String? = null,
+        val item: Item<*>? = null,
+        val mode: String? = null,
+        val subtitle: String? = null,
+        val icon: Int = 0,
+        val iconTop: Int = 0,
+        val iconBottom: Int = 0
+    )
 
     private var adapter: ListAdapter? = null
 
