                 else -> (cell as TextSettingsCell).setTextAndValue(row.title, row.value, false)
             }
         }
@@ -123,11 +137,15 @@ class TeleSettingsActivity @JvmOverloads constructor(private val mode: String =
         private const val TYPE_TOGGLE = 2
         private const val TYPE_SHADOW = 3
         private const val TYPE_LINK = 4
+        private const val TYPE_LINK_ICON = 5
 
         private fun toggle(title: String, item: Item<*>) = Row(TYPE_TOGGLE, title = title, item = item)
 
         private fun link(title: String, mode: String) = Row(TYPE_LINK, title = title, mode = mode)
 
+        private fun sectionLink(title: String, subtitle: String, mode: String, icon: Int, colors: IconBackgroundColors) =
