                 cell.setChecked(newValue)
                 TeleConfig.set(row.item, newValue)
                 TeleHooks.onConfigChanged(row.item)
-            } else if (row.type == TYPE_LINK) {
+            } else if (row.type == TYPE_LINK || row.type == TYPE_LINK_ICON) {
                 when (row.mode) {
                     TeleNamesActivity.MODE_LOCAL -> presentFragment(TeleNamesActivity(TeleNamesActivity.MODE_LOCAL))
                     TeleNamesActivity.MODE_ALIAS -> presentFragment(TeleNamesActivity(TeleNamesActivity.MODE_ALIAS))
@@ -84,7 +96,7 @@ class TeleSettingsActivity @JvmOverloads constructor(private val mode: String =
 
         override fun isEnabled(holder: RecyclerView.ViewHolder): Boolean {
             val row = rows.getOrNull(holder.adapterPosition) ?: return false
-            return row.type == TYPE_VALUE || row.type == TYPE_TOGGLE || row.type == TYPE_LINK
+            return row.type == TYPE_VALUE || row.type == TYPE_TOGGLE || row.type == TYPE_LINK || row.type == TYPE_LINK_ICON
         }
 
         override fun onCreateViewHolder(parent: ViewGroup, viewType: Int): RecyclerView.ViewHolder {
@@ -92,6 +104,7 @@ class TeleSettingsActivity @JvmOverloads constructor(private val mode: String =
                 TYPE_HEADER -> HeaderCell(context)
                 TYPE_TOGGLE -> TextCheckCell(context)
                 TYPE_SHADOW -> TextInfoPrivacyCell(context)
+                TYPE_LINK_ICON -> SettingsActivity.SettingCell(context, null)
                 else -> TextSettingsCell(context)
             }
             view.layoutParams = RecyclerView.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT)
@@ -104,6 +117,7 @@ class TeleSettingsActivity @JvmOverloads constructor(private val mode: String =
                 is HeaderCell -> cell.setText(row.title)
                 is TextCheckCell -> cell.setTextAndCheck(row.title, row.item!!.value as Boolean, true)
                 is TextInfoPrivacyCell -> cell.setText("")
