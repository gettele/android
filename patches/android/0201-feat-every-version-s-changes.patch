diff --git a/TMessagesProj/src/main/java/tele/helpers/TeleChangelogHistory.kt b/TMessagesProj/src/main/java/tele/helpers/TeleChangelogHistory.kt
new file mode 100644
index 000000000..59d1c7b8d
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/TeleChangelogHistory.kt
@@ -0,0 +1,163 @@
+package tele.helpers
+
+import android.text.Spannable
+import android.text.SpannableString
+import android.text.Spanned
+import android.text.style.ForegroundColorSpan
+import android.text.style.StyleSpan
+import org.json.JSONObject
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.ApplicationLoader
+import org.telegram.messenger.DispatchQueue
+import org.telegram.messenger.FileLog
+import org.telegram.messenger.R
+import org.telegram.ui.ActionBar.Theme
+import tele.ui.settings.TeleSettingsActivity
+
+// the changelog of every tele release (tele desktop 0237): res/raw/changelog_history.json is written by ci into the apk,
+// so it's read offline and never fetched
+object TeleChangelogHistory {
+    private const val MAX_SIZE = 4 * 1024 * 1024
+    private const val MAX_RELEASES = 200
+    private const val MAX_ITEMS = 100
+    private const val MAX_OPTIONS = 16
+    private const val MAX_TITLE = 64
+    private const val MAX_ITEM = 1024
+    private val TAG = Regex("^v[0-9][0-9.]*-tele\\.([1-9][0-9]*)$")
+    private val OPTION = Regex("^tele-[a-z0-9][a-z0-9-]{0,63}$")
+
+    class Item(@JvmField val text: String, @JvmField val where: String, @JvmField val category: String, @JvmField val options: List<String>)
+    class Release(@JvmField val version: Int, @JvmField val tag: String, @JvmField val title: String, @JvmField val url: String, @JvmField val items: List<Item>)
+
+    private val queue by lazy { DispatchQueue("teleChangelogHistory") }
+    // UI thread only; the list is immutable once published
+    private var releases: List<Release>? = null
+    private var loading = false
+    private val waiting = ArrayList<(List<Release>) -> Unit>()
+
+    /** Newest first; empty when the build has no history or it is malformed. The callback runs on the UI thread. */
+    @JvmStatic
+    fun load(callback: (List<Release>) -> Unit) {
+        AndroidUtilities.runOnUIThread {
+            val known = releases
+            if (known != null) {
+                callback(known)
+                return@runOnUIThread
+            }
+            waiting.add(callback)
+            if (loading) return@runOnUIThread
+            loading = true
+            queue.postRunnable {
+                val parsed = readAsset()
+                AndroidUtilities.runOnUIThread {
+                    releases = parsed
+                    loading = false
+                    val callbacks = ArrayList(waiting)
+                    waiting.clear()
+                    callbacks.forEach { it(parsed) }
+                }
+            }
+        }
+    }
+
+    /** The parsed history when it has been loaded already, else null. */
+    @JvmStatic
+    fun loaded(): List<Release>? = releases
+
+    private fun readAsset(): List<Release> {
+        return try {
+            val bytes = ApplicationLoader.applicationContext.resources.openRawResource(R.raw.changelog_history).use { input ->
+                val out = java.io.ByteArrayOutputStream()
+                val buffer = ByteArray(16 * 1024)
+                while (true) {
+                    val read = input.read(buffer)
+                    if (read < 0) break
+                    out.write(buffer, 0, read)
+                    if (out.size() > MAX_SIZE) throw Exception("The history is too large")
+                }
+                out.toByteArray()
+            }
+            parse(String(bytes, Charsets.UTF_8))
+        } catch (e: Exception) {
+            FileLog.e("TeleChangelogHistory: ${e.javaClass.simpleName}")
+            emptyList()
+        }
+    }
+
+    private fun text(value: Any?, limit: Int): String = (value as? String)?.trim().orEmpty().take(limit)
+
+    private fun parse(source: String): List<Release> {
+        val array = JSONObject(source).optJSONArray("releases") ?: return emptyList()
+        val byVersion = HashMap<Int, Release>()
+        for (i in 0 until minOf(array.length(), MAX_RELEASES)) {
+            val o = array.optJSONObject(i) ?: continue
+            val tag = o.optString("tag")
+            val version = TAG.matchEntire(tag)?.groupValues?.get(1)?.toIntOrNull() ?: o.optInt("version")
+            if (version <= 0 || byVersion.containsKey(version)) continue
+            val list = o.optJSONArray("items") ?: continue
+            val items = ArrayList<Item>()
+            for (j in 0 until minOf(list.length(), MAX_ITEMS)) {
+                val item = list.optJSONObject(j) ?: continue
+                val body = text(item.opt("text"), MAX_ITEM)
+                if (body.isEmpty()) continue
+                val options = ArrayList<String>()
+                val raw = item.optJSONArray("options")
+                if (raw != null) {
+                    for (k in 0 until minOf(raw.length(), MAX_OPTIONS)) {
+                        val id = raw.optString(k)
+                        if (OPTION.matches(id) && id !in options) options.add(id)
+                    }
+                }
+                items.add(Item(body, text(item.opt("where"), MAX_ITEM), text(item.opt("category"), MAX_TITLE), options))
+            }
+            if (items.isEmpty()) continue
+            val title = text(o.opt("title"), MAX_TITLE).ifEmpty { "tele $version" }
+            val url = o.optString("url").takeIf { it.startsWith(TeleUpdater.RELEASES + "/") } ?: "${TeleUpdater.RELEASES}/tag/$tag"
+            byVersion[version] = Release(version, tag, title, url, items)
+        }
+        return byVersion.values.sortedByDescending { it.version }
+    }
+
+    /** The words of a search query. */
+    @JvmStatic
+    fun words(query: String): List<String> = query.trim().split(Regex("\\s+")).filter { it.isNotEmpty() }
+
+    /** Every word is in the text, the place or the category of the item; no words match everything. */
+    @JvmStatic
+    fun matches(item: Item, words: List<String>): Boolean {
+        if (words.isEmpty()) return true
+        return words.all { word ->
+            item.text.contains(word, true) || item.where.contains(word, true) || item.category.contains(word, true)
+        }
+    }
+
+    /** The text with the found words in bold and blue. */
+    @JvmStatic
+    fun highlight(text: String, words: List<String>): CharSequence {
+        if (words.isEmpty()) return text
+        val spannable = SpannableString(text)
+        var found = false
+        for (word in words) {
+            var from = 0
+            while (true) {
+                val index = text.indexOf(word, from, true)
+                if (index < 0) break
+                from = index + word.length
+                found = true
+                spannable.setSpan(StyleSpan(android.graphics.Typeface.BOLD), index, from, Spannable.SPAN_EXCLUSIVE_EXCLUSIVE)
+                spannable.setSpan(ForegroundColorSpan(Theme.getColor(Theme.key_windowBackgroundWhiteBlueText)), index, from, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
+            }
+        }
+        return if (found) spannable else text
+    }
+
+    /** The id of the setting an item is about: its own option ids first, then the name its place ends with. */
+    @JvmStatic
+    fun settingId(item: Item): String? {
+        for (option in item.options) {
+            TeleSettingsLinks.resolve(option)?.let { return it }
+        }
+        val last = item.where.substringAfterLast('→').trim()
+        return if (last.isEmpty()) null else TeleSettingsActivity.idForTitle(last)
+    }
+}
