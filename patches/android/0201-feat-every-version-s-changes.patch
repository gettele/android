+    }
 }
diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleChangelogActivity.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleChangelogActivity.kt
new file mode 100644
index 000000000..e7da313ab
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleChangelogActivity.kt
@@ -0,0 +1,196 @@
+package tele.ui.settings
+
+import android.content.Context
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.View
+import android.view.ViewGroup
+import android.widget.EditText
+import android.widget.FrameLayout
+import android.widget.LinearLayout
+import android.widget.TextView
+import androidx.recyclerview.widget.LinearLayoutManager
+import androidx.recyclerview.widget.RecyclerView
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.R
+import org.telegram.messenger.browser.Browser
+import org.telegram.ui.ActionBar.ActionBar
+import org.telegram.ui.ActionBar.ActionBarMenuItem
+import org.telegram.ui.ActionBar.BaseFragment
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Cells.HeaderCell
+import org.telegram.ui.Cells.ShadowSectionCell
+import org.telegram.ui.Components.LayoutHelper
+import org.telegram.ui.Components.RecyclerListView
+import tele.helpers.TeleChangelogHistory
+import tele.helpers.TeleLowercase
+import tele.helpers.TeleSettingsLinks
+
+// the changelog of every tele release from the apk, with a search (tele desktop 0237); works offline
+class TeleChangelogActivity : BaseFragment() {
+
+    private sealed class Row {
+        class Title(val text: String) : Row()
+        class Entry(val release: TeleChangelogHistory.Release, val item: TeleChangelogHistory.Item) : Row()
+        object Gap : Row()
+        class Note(val text: String) : Row()
+    }
+
+    private var releases: List<TeleChangelogHistory.Release>? = null
+    private var rows: List<Row> = emptyList()
+    private var words: List<String> = emptyList()
+    private var adapter: Adapter? = null
+
+    private fun lc(text: String): String = TeleLowercase.lc(text)
+
+    override fun createView(context: Context): View {
+        actionBar.setBackButtonImage(R.drawable.ic_ab_back)
+        actionBar.setAllowOverlayTitle(true)
+        actionBar.setTitle(lc("What's new"))
+        actionBar.setActionBarMenuOnItemClick(object : ActionBar.ActionBarMenuOnItemClick() {
+            override fun onItemClick(id: Int) {
+                if (id == -1) finishFragment()
+            }
+        })
+        actionBar.createMenu().addItem(SEARCH_ID, R.drawable.outline_header_search)
+            .setIsSearchField(true, false)
+            .setActionBarMenuItemSearchListener(object : ActionBarMenuItem.ActionBarMenuItemSearchListener() {
+                override fun onSearchExpand() {
+                    search("")
+                }
+
+                override fun onSearchCollapse() {
+                    search("")
+                }
+
+                override fun onTextChanged(editText: EditText) {
+                    search(editText.text.toString())
+                }
+            })
+            .setSearchFieldHint(LocaleController.getString(R.string.Search))
+
+        val root = FrameLayout(context)
+        root.setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundGray))
+        fragmentView = root
+        val list = RecyclerListView(context)
+        list.setLayoutManager(LinearLayoutManager(context))
+        adapter = Adapter(context)
+        list.adapter = adapter
+        list.setOnItemClickListener { _, position -> open(rows.getOrNull(position)) }
+        root.addView(list, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.MATCH_PARENT.toFloat()))
+
+        // parsed off the main thread; the rows appear when it is done
+        rows = listOf(Row.Note(lc("Loading…")))
+        TeleChangelogHistory.load { loaded ->
+            releases = loaded
+            rebuild()
+        }
+        return root
+    }
+
+    private fun search(query: String) {
+        val now = TeleChangelogHistory.words(query)
+        if (now == words) return
+        words = now
+        rebuild()
+    }
+
+    private fun rebuild() {
+        val loaded = releases ?: return
+        val result = ArrayList<Row>()
+        for (release in loaded) {
+            val found = release.items.filter { TeleChangelogHistory.matches(it, words) }
+            if (found.isEmpty()) continue
+            if (result.isNotEmpty()) result.add(Row.Gap)
+            result.add(Row.Title(lc(release.title)))
+            found.forEach { result.add(Row.Entry(release, it)) }
+        }
+        if (result.isEmpty()) {
+            result.add(Row.Note(lc(if (loaded.isEmpty()) "There is no changelog history in this build." else "Nothing found.")))
+        }
+        rows = result
+        adapter?.notifyDataSetChanged()
+    }
+
+    private fun open(row: Row?) {
+        val entry = row as? Row.Entry ?: return
+        val id = TeleChangelogHistory.settingId(entry.item)
+        if (id != null) {
+            presentFragment(TeleSettingsLinks.fragment("tg://settings/tele?highlight=$id"))
+        } else {
+            Browser.openUrl(parentActivity, entry.release.url)
+        }
+    }
+
+    private inner class Adapter(private val context: Context) : RecyclerListView.SelectionAdapter() {
+        override fun getItemCount(): Int = rows.size
+
+        override fun isEnabled(holder: RecyclerView.ViewHolder): Boolean = holder.itemViewType == TYPE_ENTRY
+
+        override fun getItemViewType(position: Int): Int = when (rows[position]) {
+            is Row.Title -> TYPE_TITLE
+            is Row.Entry -> TYPE_ENTRY
+            is Row.Gap -> TYPE_GAP
+            is Row.Note -> TYPE_NOTE
+        }
+
+        override fun onCreateViewHolder(parent: ViewGroup, viewType: Int): RecyclerView.ViewHolder {
+            val view: View = when (viewType) {
+                TYPE_TITLE -> HeaderCell(context).apply { setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundWhite)) }
+                TYPE_ENTRY -> EntryCell(context)
+                TYPE_GAP -> ShadowSectionCell(context)
+                else -> TextView(context).apply {
+                    gravity = Gravity.CENTER
+                    setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15f)
+                    setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
+                    setPadding(AndroidUtilities.dp(24f), AndroidUtilities.dp(48f), AndroidUtilities.dp(24f), AndroidUtilities.dp(48f))
+                }
+            }
+            view.layoutParams = RecyclerView.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT)
+            return RecyclerListView.Holder(view)
+        }
+
+        override fun onBindViewHolder(holder: RecyclerView.ViewHolder, position: Int) {
+            // recycled cells are fully reset by every bind
+            when (val row = rows[position]) {
+                is Row.Title -> (holder.itemView as HeaderCell).setText(row.text)
+                is Row.Entry -> (holder.itemView as EntryCell).bind(row.item, words)
+                is Row.Note -> (holder.itemView as TextView).text = row.text
+                is Row.Gap -> {}
+            }
+        }
+    }
+
+    private class EntryCell(context: Context) : LinearLayout(context) {
+        private val body = TextView(context)
+        private val details = TextView(context)
+
+        init {
+            orientation = VERTICAL
+            setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundWhite))
+            setPadding(AndroidUtilities.dp(21f), AndroidUtilities.dp(10f), AndroidUtilities.dp(21f), AndroidUtilities.dp(10f))
+            body.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 15f)
+            body.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText))
+            details.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 13f)
+            details.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2))
+            addView(body, LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT))
+            addView(details, LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT).apply { topMargin = AndroidUtilities.dp(2f) })
+        }
+
+        fun bind(item: TeleChangelogHistory.Item, words: List<String>) {
+            body.text = TeleChangelogHistory.highlight(item.text, words)
+            val place = listOf(item.category, item.where).filter { it.isNotEmpty() }.distinct().joinToString(" · ")
+            details.visibility = if (place.isEmpty()) GONE else VISIBLE
+            details.text = TeleChangelogHistory.highlight(place, words)
+        }
+    }
+
+    companion object {
+        private const val SEARCH_ID = 1
+        private const val TYPE_TITLE = 0
+        private const val TYPE_ENTRY = 1
+        private const val TYPE_GAP = 2
+        private const val TYPE_NOTE = 3
+    }
+}
