diff --git a/TMessagesProj/src/main/java/tele/helpers/TeleSilent.kt b/TMessagesProj/src/main/java/tele/helpers/TeleSilent.kt
new file mode 100644
index 000000000..bf128efda
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/TeleSilent.kt
@@ -0,0 +1,107 @@
+package tele.helpers
+
+import android.os.SystemClock
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.MessagesController
+import org.telegram.messenger.R
+import org.telegram.messenger.UserConfig
+import org.telegram.messenger.Utilities
+import tele.TeleConfig
+import tele.db.TeleDatabaseHelper
+
+/**
+ * Silent sending by default. The per chat state is the stock "silent_<dialogId>" pref; with the
+ * global default on, a chat is silent unless it is listed as "sound" here (tele_kv, per account).
+ */
+object TeleSilent {
+
+    private const val SOUND_KEY = "silent_sound_"
+    private const val SOUND_WINDOW_MS = 6000L
+
+    private val sound = arrayOfNulls<HashSet<Long>>(UserConfig.MAX_ACCOUNT_COUNT)
+    private val armedDialog = LongArray(UserConfig.MAX_ACCOUNT_COUNT)
+    private val armedUntil = LongArray(UserConfig.MAX_ACCOUNT_COUNT)
+
+    @JvmStatic
+    fun enabled(): Boolean = TeleConfig.SILENT_BY_DEFAULT.value || TeleConfig.SILENT_PER_CHAT.value
+
+    private fun stock(account: Int, dialogId: Long): Boolean =
+        MessagesController.getNotificationsSettings(account).getBoolean("silent_$dialogId", false)
+
+    private fun soundSet(account: Int): HashSet<Long> = synchronized(sound) {
+        sound[account] ?: HashSet<Long>().also { set ->
+            TeleDatabaseHelper.get(SOUND_KEY + account)?.split(',')?.forEach { it.toLongOrNull()?.let(set::add) }
+            sound[account] = set
+        }
+    }
+
+    private fun resolve(account: Int, dialogId: Long, stock: Boolean): Boolean {
+        if (dialogId == UserConfig.getInstance(account).getClientUserId()) {
+            return false
+        }
+        return stock || (TeleConfig.SILENT_BY_DEFAULT.value && synchronized(sound) { dialogId !in soundSet(account) })
+    }
+
+    /** The chat state the menus and the field hint show. */
+    @JvmStatic
+    fun inChat(account: Int, dialogId: Long): Boolean {
+        val stock = stock(account, dialogId)
+        return if (enabled()) resolve(account, dialogId, stock) else stock
+    }
+
+    /** What the send paths apply: [inChat] unless a "send with sound" was just picked for this chat. */
+    @JvmStatic
+    fun isSilent(account: Int, dialogId: Long): Boolean {
+        val stock = stock(account, dialogId)
+        if (!enabled()) {
+            return stock
+        }
+        return resolve(account, dialogId, stock) && !soundArmed(account, dialogId)
+    }
+
+    /** The send menus swap "send without sound" for "send with sound" in a silent chat. */
+    @JvmStatic
+    fun menuSound(account: Int, dialogId: Long): Boolean = dialogId != 0L && enabled() && inChat(account, dialogId)
+
+    /**
+     * The media sends build their messages on another thread a moment later, so the pick is
+     * kept for a short window instead of one call.
+     */
+    @JvmStatic
+    fun armSound(account: Int, dialogId: Long) {
+        synchronized(armedUntil) {
+            armedDialog[account] = dialogId
+            armedUntil[account] = SystemClock.elapsedRealtime() + SOUND_WINDOW_MS
+        }
+    }
+
+    private fun soundArmed(account: Int, dialogId: Long): Boolean = synchronized(armedUntil) {
+        armedDialog[account] == dialogId && SystemClock.elapsedRealtime() < armedUntil[account]
+    }
+
+    @JvmStatic
+    fun setSilent(account: Int, dialogId: Long, silent: Boolean) {
+        MessagesController.getNotificationsSettings(account).edit().putBoolean("silent_$dialogId", silent).apply()
+        onToggled(account, dialogId, silent)
+    }
+
+    /** The stock pref is already written; this keeps the "sound" list of the global default in step. */
+    @JvmStatic
+    fun onToggled(account: Int, dialogId: Long, silent: Boolean) {
+        if (!TeleConfig.SILENT_BY_DEFAULT.value) {
+            return
+        }
+        val ids = synchronized(sound) {
+            val set = soundSet(account)
+            if (!(if (silent) set.remove(dialogId) else set.add(dialogId))) {
+                return
+            }
+            set.joinToString(",")
+        }
+        Utilities.globalQueue.postRunnable { TeleDatabaseHelper.put(SOUND_KEY + account, ids) }
+    }
+
+    @JvmStatic
+    fun typeHint(account: Int, dialogId: Long, base: String): String =
+        if (enabled() && inChat(account, dialogId)) LocaleController.getString(R.string.TeleSilentMessage) else base
+}
