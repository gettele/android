+    // every page is laid out alone at full width and drawn; a still copy covers the preview meanwhile
+    private fun render(done: (List<File>) -> Unit) {
+        if (busy || messageCount() == 0) return
+        val pages = pages()
+        if (pages.isEmpty()) return
+        busy = true
+        selection.clear(true)
+        cover.setImageBitmap(snapshot(box))
+        cover.visibility = View.VISIBLE
+        topFade.visibility = View.GONE
+        bottomFade.visibility = View.GONE
+        button.setLoading(true)
+        frame.invalidateWall()
+        val stamp = System.currentTimeMillis()
+        val files = ArrayList<File>()
+        var failed = false
+        fun finish() {
+            busy = false
+            button.setLoading(false)
+            rebuild()
+            cover.visibility = View.GONE
+            cover.setImageBitmap(null)
+            if (failed || files.size != pages.size) {
+                BulletinFactory.of(root, null).createErrorBulletin(TeleLowercase.lc("Not enough memory for the picture.")).show()
+            } else {
+                done(files)
+            }
+        }
+        fun step(index: Int) {
+            if (restored) return
+            if (index >= pages.size || failed) {
+                finish()
+                return
+            }
+            column.bind(pages[index], OPTIONS)
+            val width = frame.width
+            frame.measure(View.MeasureSpec.makeMeasureSpec(width, View.MeasureSpec.EXACTLY), View.MeasureSpec.makeMeasureSpec(0, View.MeasureSpec.UNSPECIFIED))
+            frame.layout(frame.left, frame.top, frame.left + width, frame.top + frame.measuredHeight)
+            afterImages {
+                frame.measure(View.MeasureSpec.makeMeasureSpec(width, View.MeasureSpec.EXACTLY), View.MeasureSpec.makeMeasureSpec(0, View.MeasureSpec.UNSPECIFIED))
+                frame.layout(frame.left, frame.top, frame.left + width, frame.top + frame.measuredHeight)
+                val scale = min(MAX_SCALE, MAX_SIDE / max(frame.width, frame.height).toFloat())
+                val bitmap = frame.render(scale)
+                if (bitmap == null) {
+                    failed = true
+                    finish()
+                    return@afterImages
+                }
+                val file = File(directory(), "screenshot_${stamp}_${index + 1}.png")
+                Utilities.globalQueue.postRunnable {
+                    val ok = runCatching { FileOutputStream(file).use { bitmap.compress(Bitmap.CompressFormat.PNG, 100, it) } }.getOrDefault(false)
+                    bitmap.recycle()
+                    AndroidUtilities.runOnUIThread {
+                        if (ok) files.add(file) else failed = true
+                        step(index + 1)
+                    }
+                }
+            }
+        }
+        step(0)
+    }
+
+    private fun snapshot(view: View): Bitmap? = runCatching {
+        val bitmap = Bitmap.createBitmap(max(1, view.width), max(1, view.height), Bitmap.Config.ARGB_8888)
+        view.draw(Canvas(bitmap))
+        bitmap
+    }.getOrNull()
+
+    private fun uriOf(file: File): Uri = FileProvider.getUriForFile(context, ApplicationLoader.getApplicationId() + ".provider", file)
+
+    private fun copy() {
+        render { files ->
+            val clipboard = context.getSystemService(Context.CLIPBOARD_SERVICE) as ClipboardManager
+            val clip = ClipData.newUri(context.contentResolver, "screenshot", uriOf(files[0]))
+            for (i in 1 until files.size) clip.addItem(ClipData.Item(uriOf(files[i])))
+            clipboard.setPrimaryClip(clip)
+            BulletinFactory.of(root, null).createCopyBulletin(TeleLowercase.lc("Shot copied to clipboard.")).show()
+        }
+    }
+
+    private fun save() {
+        render { files ->
+            var left = files.size
+            for (file in files) {
+                MediaController.saveFile(file.absolutePath, context, 0, file.name, "image/png", Utilities.Callback<Uri> {
+                    left--
+                    if (left == 0) BulletinFactory.of(root, null).createDownloadBulletin(if (files.size > 1) BulletinFactory.FileType.PHOTOS else BulletinFactory.FileType.PHOTO).show()
+                })
+            }
+        }
+    }
+
+    private fun shareExternally() {
+        render { files ->
+            val uris = ArrayList(files.map { uriOf(it) })
+            val intent = if (uris.size == 1) {
+                Intent(Intent.ACTION_SEND).putExtra(Intent.EXTRA_STREAM, uris[0])
+            } else {
+                Intent(Intent.ACTION_SEND_MULTIPLE).putParcelableArrayListExtra(Intent.EXTRA_STREAM, uris)
+            }
+            intent.type = "image/png"
+            intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
+            context.startActivity(Intent.createChooser(intent, TeleLowercase.lc("Share")))
+        }
+    }
+
+    private fun canSendHere(): Boolean {
+        if (chat.chatMode != ChatActivity.MODE_DEFAULT || !chat.canSendMessage()) return false
+        val target = chat.currentChat
+        return target == null || ChatObject.canSendPhoto(target)
+    }
+
+    private class Target(val dialogId: Long, val topMessage: MessageObject?, val monoForumPeer: Long)
+
+    private fun sendHere() {
+        if (!canSendHere()) return
+        render { files -> send(listOf(Target(chat.dialogId, chat.threadMessage, 0)), files, null, true) }
+    }
+
+    private fun share() {
+        render { files ->
+            val alert = object : ShareAlert(context, null, null, false, null, false, null) {
+                override fun sendInternal(withSound: Boolean) {
+                    val comment = commentTextView?.text
+                    val targets = ArrayList<Target>()
+                    for (i in 0 until selectedDialogs.size()) {
+                        val key = selectedDialogs.keyAt(i)
+                        if (AlertsCreator.checkSlowMode(context, currentAccount, key, !comment.isNullOrEmpty())) return
+                        val mono = MessagesController.getInstance(currentAccount).isMonoForum(key)
+                        val topic = selectedDialogTopics[selectedDialogs.get(key)]
+                        val top = if (topic != null && !mono) MessageObject(currentAccount, topic.topicStartMessage, false, false) else null
+                        val peer = if (topic != null && mono) DialogObject.getPeerDialogId(topic.from_id) else 0L
+                        targets.add(Target(key, top, peer))
+                    }
+                    if (targets.isEmpty()) return
+                    send(targets, files, comment, withSound) { dismiss() }
+                }
+            }
+            alert.show()
+        }
+    }
+
+    private fun send(targets: List<Target>, files: List<File>, comment: CharSequence?, withSound: Boolean, sent: (() -> Unit)? = null) {
+        val controller = MessagesController.getInstance(account)
+        val paid = ArrayList<Long>()
+        var count = 0
+        for (target in targets) {
+            var price = controller.getSendPaidMessagesStars(target.dialogId)
+            if (price <= 0) price = DialogObject.getMessagesStarsPrice(controller.isUserContactBlocked(target.dialogId))
+            if (price > 0) {
+                count += files.size
+                if (!paid.contains(target.dialogId)) paid.add(target.dialogId)
+            }
+        }
+        val entities = if (comment.isNullOrEmpty()) null else MediaDataController.getInstance(account).getEntities(arrayOf(comment), true)
+        AlertsCreator.ensurePaidMessagesMultiConfirmation(account, paid, count) { prices ->
+            for (target in targets) {
+                val infos = ArrayList<SendMessagesHelper.SendingMediaInfo>()
+                files.forEachIndexed { index, file ->
+                    val info = SendMessagesHelper.SendingMediaInfo()
+                    info.path = file.absolutePath
+                    if (index == 0 && !comment.isNullOrEmpty()) {
+                        info.caption = comment.toString()
+                        info.entities = entities
+                    }
+                    infos.add(info)
+                }
+                val price = prices?.get(target.dialogId) ?: 0L
+                SendMessagesHelper.prepareSendingMedia(
+                    AccountInstance.getInstance(account), infos, target.dialogId, target.topMessage, target.topMessage,
+                    null, null, false, true, null, withSound, 0, 0, 0, false, null, null, 0, false, price, target.monoForumPeer, null
+                )
+            }
+            sent?.invoke()
+            dismiss()
+            sentNotice(targets.map { it.dialogId }, files.size)
+        }
+    }
+
+    private fun sentNotice(dialogs: List<Long>, images: Int) {
+        val text = if (dialogs.size == 1) {
+            val did = dialogs[0]
+            val name = if (did == UserConfig.getInstance(account).getClientUserId()) {
+                LocaleController.getString(R.string.SavedMessages)
+            } else {
+                DialogObject.getDialogTitle(MessagesController.getInstance(account).getUserOrChat(did))
+            }
+            TeleLowercase.lc(if (images > 1) "Screenshots sent to **%s**" else "Screenshot sent to **%s**").format(name)
+        } else {
+            LocaleController.formatPluralString("TeleScreenshotSentChats", dialogs.size)
+        }
+        BulletinFactory.of(chat).createSimpleBulletin(R.raw.forward, AndroidUtilities.replaceTags(text)).show()
+    }
+
+    override fun dismiss() {
+        restore()
+        super.dismiss()
+    }
+
+    private fun restore() {
+        if (restored) return
+        restored = true
+        isOpen = false
+        selection.clear(true)
+        frame.release()
+    }
+
+    companion object {
+        private val OPTIONS = ShotOptions(background = true, dates = true, hidden = 0)
+        private const val FOOTER_DP = 36f
+        private const val FADE_DP = 28f
+        private const val SWIPE_DP = 72f
+        private const val IMAGE_WAIT_MS = 3000L
+        private const val MAX_SCALE = 2f
+        private const val MAX_SIDE = 2560f
+
+        @JvmStatic
+        var isOpen = false
+            private set
+
+        @JvmStatic
+        fun open(chat: ChatActivity, messages: List<MessageObject>) {
+            val context = chat.parentActivity ?: return
+            if (isOpen || messages.isEmpty() || !TeleShot.allowed(chat, messages)) return
+            TeleShot.preload(chat, messages, context) {
+                if (chat.parentActivity != null && !isOpen) chat.showDialog(TeleScreenshotSheet(chat, messages, ScreenshotTheme(chat.currentAccount, chat.themeDelegate)))
+            }
+        }
+    }
+}
