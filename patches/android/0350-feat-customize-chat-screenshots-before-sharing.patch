+    private fun loadThemes() {
+        val controller = ChatThemeController.getInstance(account)
+        val flags = ChatThemeController.THEME_LIST_WITH_DEFAULT or ChatThemeController.THEME_LIST_WITH_EMOJI
+        controller.requestAllChatThemes(object : ResultCallback<List<EmojiThemes>> {
+            override fun onComplete(result: List<EmojiThemes>?) {
+                AndroidUtilities.runOnUIThread { onThemes(controller.getEmojiThemes(flags)) }
+            }
+        }, true)
