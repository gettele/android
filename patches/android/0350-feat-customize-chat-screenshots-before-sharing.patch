@@ -0,0 +1,161 @@
+package tele.helpers
+
+import android.Manifest
+import android.app.Activity
+import android.content.pm.PackageManager
+import android.database.ContentObserver
+import android.net.Uri
+import android.os.Build
+import android.os.Handler
+import android.os.Looper
+import android.os.SystemClock
+import android.provider.MediaStore
+import androidx.annotation.RequiresApi
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.ApplicationLoader
+import org.telegram.messenger.MessageObject
+import org.telegram.messenger.R
+import org.telegram.messenger.Utilities
+import org.telegram.tgnet.TLRPC
+import org.telegram.ui.Cells.ChatMessageCell
+import org.telegram.ui.ChatActivity
+import org.telegram.ui.Components.BulletinFactory
+import tele.TeleConfig
+import tele.ui.TeleScreenshotSheet
+import java.lang.ref.WeakReference
+
+// a spoiler that stays dust even with "reveal spoilers": what the screenshot editor cut out
+class ScreenshotCut : TLRPC.TL_messageEntitySpoiler()
+
+object ScreenshotWatch {
+
+    private const val NOTICE_MS = 5000
+    private const val REPEAT_MS = 1500L
+
+    private var chatRef: WeakReference<ChatActivity>? = null
+    private var activityRef: WeakReference<Activity>? = null
+    private var captureCallback: Any? = null
+    private var observer: ContentObserver? = null
+    private var sinceSeconds = 0L
+    private var lastMediaId = -1L
+    private var lastNoticeAt = 0L
+
+    @JvmStatic
+    fun resume(chat: ChatActivity) {
+        stop()
+        if (!TeleConfig.SCREENSHOT_EDITOR.value || chat.isSecretChat) return
+        val activity = chat.parentActivity ?: return
+        chatRef = WeakReference(chat)
+        sinceSeconds = System.currentTimeMillis() / 1000 - 1
+        if (Build.VERSION.SDK_INT >= 34) watchCapture(activity) else watchGallery()
+    }
+
+    @JvmStatic
+    fun pause(chat: ChatActivity) {
+        if (chatRef?.get() === chat) stop()
+    }
+
+    private fun stop() {
+        if (Build.VERSION.SDK_INT >= 34) unwatchCapture()
+        observer?.let { runCatching { ApplicationLoader.applicationContext.contentResolver.unregisterContentObserver(it) } }
+        observer = null
+        chatRef = null
+    }
+
+    @RequiresApi(34)
+    private fun watchCapture(activity: Activity) {
+        val callback = Activity.ScreenCaptureCallback { AndroidUtilities.runOnUIThread { captured() } }
+        runCatching { activity.registerScreenCaptureCallback(activity.mainExecutor, callback) }.onSuccess {
+            captureCallback = callback
+            activityRef = WeakReference(activity)
+        }
+    }
+
+    @RequiresApi(34)
+    private fun unwatchCapture() {
+        val callback = captureCallback as? Activity.ScreenCaptureCallback
+        val activity = activityRef?.get()
+        if (callback != null && activity != null) runCatching { activity.unregisterScreenCaptureCallback(callback) }
+        captureCallback = null
+        activityRef = null
+    }
+
+    // without the system callback the screenshot shows up in the gallery; only when photo access is already given
+    private fun watchGallery() {
+        val context = ApplicationLoader.applicationContext
+        val permission = if (Build.VERSION.SDK_INT >= 33) Manifest.permission.READ_MEDIA_IMAGES else Manifest.permission.READ_EXTERNAL_STORAGE
+        if (context.checkSelfPermission(permission) != PackageManager.PERMISSION_GRANTED) return
+        val watcher = object : ContentObserver(Handler(Looper.getMainLooper())) {
+            override fun onChange(selfChange: Boolean, uri: Uri?) {
+                Utilities.globalQueue.postRunnable { checkGallery() }
+            }
+        }
+        runCatching {
+            context.contentResolver.registerContentObserver(MediaStore.Images.Media.EXTERNAL_CONTENT_URI, true, watcher)
+            observer = watcher
+        }
+    }
+
+    private fun checkGallery() {
+        val since = sinceSeconds
+        val location = if (Build.VERSION.SDK_INT >= 29) MediaStore.Images.Media.RELATIVE_PATH else MediaStore.Images.Media.DATA
+        val projection = arrayOf(MediaStore.Images.Media._ID, MediaStore.Images.Media.DISPLAY_NAME, location)
+        val found = runCatching {
+            ApplicationLoader.applicationContext.contentResolver.query(
+                MediaStore.Images.Media.EXTERNAL_CONTENT_URI,
+                projection,
+                MediaStore.Images.Media.DATE_ADDED + " >= ?",
+                arrayOf(since.toString()),
+                MediaStore.Images.Media.DATE_ADDED + " DESC"
+            )?.use { cursor ->
+                if (!cursor.moveToFirst()) return@use null
+                val id = cursor.getLong(0)
+                val text = ((cursor.getString(1) ?: "") + " " + (cursor.getString(2) ?: "")).lowercase()
+                if (text.contains("screenshot")) id else null
+            }
+        }.getOrNull() ?: return
+        AndroidUtilities.runOnUIThread {
+            if (found == lastMediaId) return@runOnUIThread
+            lastMediaId = found
+            captured()
+        }
+    }
+
+    private fun captured() {
+        val chat = chatRef?.get() ?: return
+        if (chat.parentActivity == null || chat.isPaused() || TeleScreenshotSheet.isOpen) return
+        val now = SystemClock.elapsedRealtime()
+        if (now - lastNoticeAt < REPEAT_MS) return
+        val messages = visibleMessages(chat)
+        if (messages.isEmpty()) return
+        lastNoticeAt = now
+        BulletinFactory.of(chat).createSimpleBulletin(
+            R.raw.ic_save_to_gallery,
+            TeleLowercase.lc("Screenshot taken"),
+            TeleLowercase.lc("Hide messages or cut text"),
+            TeleLowercase.lc("Customize")
+        ) { TeleScreenshotSheet.open(chat, messages, TeleScreenshotSheet.Mode.SCREENSHOT) }.setDuration(NOTICE_MS).show(true)
+    }
+
+    private fun visibleMessages(chat: ChatActivity): List<MessageObject> {
+        val list = chat.chatListView ?: return emptyList()
+        val top = chat.chatListViewPaddingTop
+        val bottom = list.measuredHeight - chat.blurredViewBottomOffset
+        val found = ArrayList<MessageObject>()
+        for (i in 0 until list.childCount) {
+            val cell = list.getChildAt(i) as? ChatMessageCell ?: continue
+            if (cell.bottom <= top || cell.top >= bottom) continue
+            val message = cell.messageObject ?: continue
+            if (message.isDateObject || !usable(chat, message)) continue
+            found.add(message)
+        }
+        return TeleShot.expand(chat, found, null).filter { usable(chat, it) }
+    }
+
+    // what stock keeps off screenshots (view-once, paid media) never goes into a picture
+    private fun usable(chat: ChatActivity, message: MessageObject): Boolean =
+        TeleShot.allowed(chat, listOf(message)) &&
+            message.type != MessageObject.TYPE_PAID_MEDIA &&
+            !message.isVoiceOnce && !message.isRoundOnce &&
+            !message.needDrawBluredPreview() && !message.hasRevealedExtendedMedia()
+}
