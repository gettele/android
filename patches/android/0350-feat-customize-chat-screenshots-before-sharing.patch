+    // the incoming bubble color reads on a pattern wallpaper, not on a plain one of the same lightness
+    private fun updateFooterTint() {
+        footerTintDirty = false
+        val bubble = Theme.getColor(Theme.key_chat_inBubble, look)
+        val wallLight = AndroidUtilities.computePerceivedBrightness(averageWall())
+        footerTint = when {
+            abs(wallLight - AndroidUtilities.computePerceivedBrightness(bubble)) > 0.25f -> bubble
+            wallLight > 0.5f -> 0x99000000.toInt()
+            else -> 0xCCFFFFFF.toInt()
+        }
+    }
