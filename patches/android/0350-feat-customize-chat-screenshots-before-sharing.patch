+        override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
+            val width = MeasureSpec.getSize(widthMeasureSpec)
+            val page = pageWidth()
+            val factor = scale(width)
+            wall.measure(MeasureSpec.makeMeasureSpec(page, MeasureSpec.EXACTLY), MeasureSpec.makeMeasureSpec(wallHeight(), MeasureSpec.EXACTLY))
+            scroll.measure(MeasureSpec.makeMeasureSpec(page, MeasureSpec.EXACTLY), MeasureSpec.makeMeasureSpec((maxHeight() / factor).toInt(), MeasureSpec.AT_MOST))
+            scroll.pivotX = 0f
+            scroll.pivotY = 0f
+            scroll.scaleX = factor
+            scroll.scaleY = factor
+            val height = (scroll.measuredHeight * factor).toInt()
+            val fade = AndroidUtilities.dp(FADE_DP)
+            topFade.measure(MeasureSpec.makeMeasureSpec(width, MeasureSpec.EXACTLY), MeasureSpec.makeMeasureSpec(fade, MeasureSpec.EXACTLY))
+            bottomFade.measure(MeasureSpec.makeMeasureSpec(width, MeasureSpec.EXACTLY), MeasureSpec.makeMeasureSpec(fade, MeasureSpec.EXACTLY))
+            cover.measure(MeasureSpec.makeMeasureSpec(width, MeasureSpec.EXACTLY), MeasureSpec.makeMeasureSpec(height, MeasureSpec.EXACTLY))
+            setMeasuredDimension(width, height)
