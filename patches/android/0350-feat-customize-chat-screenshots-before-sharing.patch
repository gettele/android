+
+    private fun onThemes(result: List<EmojiThemes>?) {
+        if (result.isNullOrEmpty() || restored) return
+        val items = ArrayList<ChatThemeBottomSheet.ChatThemeItem>()
+        val stub = ChatThemeBottomSheet.ChatThemeItem(result[0])
+        stub.themeIndex = if (forceDark) 1 else 0
+        items.add(stub)
+        val currentKey = originalTheme?.themeKey
+        var hasCurrent = false
+        for (i in 1 until result.size) {
+            val theme = result[i]
+            theme.loadPreviewColors(account)
+            val item = ChatThemeBottomSheet.ChatThemeItem(theme)
+            item.themeIndex = if (forceDark) 1 else 0
+            if (currentKey != null && ThemeKey.equals(theme.themeKey, currentKey)) {
+                hasCurrent = true
+                items.add(1, item)
+            } else {
+                items.add(item)
+            }
+        }
+        if (originalTheme != null && !hasCurrent) {
+            originalTheme.loadPreviewColors(account)
+            val item = ChatThemeBottomSheet.ChatThemeItem(originalTheme)
+            item.themeIndex = if (forceDark) 1 else 0
+            items.add(1, item)
+        }
+        themesAdapter.setItems(items)
+        themesAdapter.setSelectedItem(if (originalTheme != null) 1 else 0)
+    }
