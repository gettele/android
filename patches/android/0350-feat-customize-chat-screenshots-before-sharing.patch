+    private inner class EditorFrame(context: Context) : ShotFrame(context, column, wall, look) {
+        private val slop = ViewConfiguration.get(context).scaledTouchSlop
+        private val iconPaint = Paint(Paint.ANTI_ALIAS_FLAG)
+        private val icon: Drawable? = context.resources.getDrawable(R.drawable.menu_hide_gift).mutate()
+        private var downX = 0f
+        private var downY = 0f
+        private var target: List<View>? = null
+        private var swiping = false
+        private var slide = 0f
+        private var armed = false
+
+        private fun threshold(): Float = AndroidUtilities.dp(SWIPE_DP).toFloat()
+
+        private fun unitAt(y: Float): List<View>? {
+            for (unit in column.unitBounds()) {
+                if (y < unit[2] || y >= unit[3]) continue
+                val views = (unit[0] until unit[1]).mapNotNull { column.getChildAt(it) as? ChatMessageCell }
+                return views.ifEmpty { null }
+            }
+            return null
+        }
+
+        private fun canSwipe(): Boolean = !busy && !selection.isInSelectionMode
+
+        private fun startsSwipe(ev: MotionEvent): Boolean {
+            val dx = ev.x - downX
+            val dy = ev.y - downY
+            return target != null && canSwipe() && dx < -slop && abs(dx) > abs(dy) * 1.5f
+        }
+
+        // the selection overlay lives beside the frame, so the handles and the tap-away only work when it is fed the same touches
+        override fun dispatchTouchEvent(ev: MotionEvent): Boolean {
+            val shift = column.cropLeft.toFloat()
+            ev.offsetLocation(shift, 0f)
+            selection.checkSelectionCancel(ev)
+            val handled = selection.isInSelectionMode && selectionOverlay.onTouchEvent(ev)
+            val tapped = !handled && selectionOverlay.checkOnTap(ev)
+            ev.offsetLocation(-shift, 0f)
+            if (handled) return true
+            if (tapped) ev.action = MotionEvent.ACTION_CANCEL
+            return super.dispatchTouchEvent(ev)
+        }
+
+        override fun onInterceptTouchEvent(ev: MotionEvent): Boolean {
+            when (ev.actionMasked) {
+                MotionEvent.ACTION_DOWN -> {
+                    downX = ev.x
+                    downY = ev.y
+                    target = unitAt(ev.y)
+                    swiping = false
+                }
+                MotionEvent.ACTION_MOVE -> if (!swiping && startsSwipe(ev)) {
+                    swiping = true
+                    parent?.requestDisallowInterceptTouchEvent(true)
+                    return true
+                }
+            }
+            return false
+        }
+
+        override fun onTouchEvent(ev: MotionEvent): Boolean {
+            when (ev.actionMasked) {
+                MotionEvent.ACTION_DOWN -> return target != null
+                MotionEvent.ACTION_MOVE -> {
+                    if (!swiping && startsSwipe(ev)) {
+                        swiping = true
+                        parent?.requestDisallowInterceptTouchEvent(true)
+                    }
+                    if (swiping) setSlide(min(0f, ev.x - downX))
+                }
+                MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> {
+                    if (swiping) finishSwipe(ev.actionMasked == MotionEvent.ACTION_UP && -slide >= threshold())
+                    swiping = false
+                }
+            }
+            return true
+        }
+
+        private fun setSlide(value: Float) {
+            slide = value
+            target?.forEach { it.translationX = value }
+            val reached = -value >= threshold()
+            if (reached && !armed) performHapticFeedback(HapticFeedbackConstants.KEYBOARD_TAP, HapticFeedbackConstants.FLAG_IGNORE_GLOBAL_SETTING)
+            armed = reached
+            invalidate()
+            column.invalidate()
+        }
+
+        private fun finishSwipe(hide: Boolean) {
+            val views = target ?: return
+            val from = slide
+            val to = if (hide) -width.toFloat() else 0f
+            val animator = android.animation.ValueAnimator.ofFloat(from, to)
+            animator.duration = 180
+            animator.addUpdateListener { setSlide(it.animatedValue as Float) }
+            animator.addListener(object : android.animation.AnimatorListenerAdapter() {
+                override fun onAnimationEnd(animation: android.animation.Animator) {
+                    slide = 0f
+                    armed = false
+                    views.forEach { it.translationX = 0f }
+                    if (hide) hideUnit(views)
+                    invalidate()
+                }
+            })
+            animator.start()
+        }
+
+        override fun dispatchDraw(canvas: Canvas) {
+            super.dispatchDraw(canvas)
+            val views = target ?: return
+            if (slide >= 0f || views.isEmpty()) return
+            val top = views.minOf { it.top }
+            val bottom = views.maxOf { it.bottom }
+            val progress = min(1f, -slide / threshold())
+            val size = AndroidUtilities.dp(32f)
+            val cx = width - AndroidUtilities.dp(16f) - size / 2f + max(0f, threshold() + slide) * 0.5f
+            val cy = (top + bottom) / 2f
+            iconPaint.color = Theme.getColor(Theme.key_chat_serviceBackground, look)
+            iconPaint.alpha = (255 * progress).toInt()
+            canvas.drawCircle(cx, cy, size / 2f * (0.6f + 0.4f * progress), iconPaint)
+            icon?.let {
+                val half = AndroidUtilities.dp(10f)
+                it.setBounds((cx - half).toInt(), (cy - half).toInt(), (cx + half).toInt(), (cy + half).toInt())
+                it.colorFilter = PorterDuffColorFilter(Theme.getColor(Theme.key_chat_serviceText, look), PorterDuff.Mode.SRC_IN)
+                it.alpha = (255 * progress).toInt()
+                it.draw(canvas)
+            }
+        }
+    }
+
+    private fun hideUnit(views: List<View>) {
+        views.forEach { view -> (view as? ChatMessageCell)?.messageObject?.let { hidden.add(it.id) } }
+        rebuild()
+    }
+
+    private fun cutSelection() {
+        val cell = selection.selectedCell ?: return
+        val message = cell.messageObject ?: return
+        val start = selection.selectionStart
+        val end = selection.selectionEnd
+        selection.clear(true)
+        if (end <= start) return
+        val list = cuts.getOrPut(message.id) { ArrayList() }
+        val translated = message.translated
+        val overlapping = list.filter { it.translated == translated && it.start < end && it.end > start }
+        val covered = (start until end).all { offset -> overlapping.any { offset >= it.start && offset < it.end } }
+        list.removeAll(overlapping)
+        if (!covered) {
+            val from = min(start, overlapping.minOfOrNull { it.start } ?: start)
+            val to = max(end, overlapping.maxOfOrNull { it.end } ?: end)
+            list.add(Cut(from, to, translated))
+        }
+        rebuild()
+    }
+
+    private fun applyCuts(original: MessageObject, copy: TLRPC.Message) {
+        val list = cuts[original.id] ?: return
+        for (cut in list) {
+            val entity = ScreenshotCut()
+            entity.offset = cut.start
+            entity.length = cut.end - cut.start
+            val translatedText = copy.translatedText
+            if (cut.translated && translatedText != null) {
+                val text = TLRPC.TL_textWithEntities()
+                text.text = translatedText.text
+                text.entities = ArrayList(translatedText.entities ?: ArrayList())
+                text.entities.add(entity)
+                copy.translatedText = text
+            } else {
+                copy.entities = ArrayList(copy.entities ?: ArrayList())
+                copy.entities.add(entity)
+                copy.flags = copy.flags or TLRPC.MESSAGE_FLAG_HAS_ENTITIES
+            }
+        }
+    }
