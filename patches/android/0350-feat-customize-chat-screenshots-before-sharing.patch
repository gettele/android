+    private fun applyTheme() {
+        val ownLook = ThemeKey.equals(selectedTheme?.themeKey, originalTheme?.themeKey) && forceDark == originalDark
+        if (ownLook) look.showChat() else look.show(selectedTheme, forceDark)
+        refreshWall()
+        applyChromeColors()
+        rebuild()
+        // pattern wallpapers finish loading after the switch
+        AndroidUtilities.runOnUIThread({ refreshWall() }, 400)
