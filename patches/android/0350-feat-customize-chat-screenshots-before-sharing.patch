+    // every page is laid out alone and drawn; a still copy covers the preview meanwhile
+    private fun render(done: (List<File>) -> Unit) {
+        if (busy || messageCount() == 0) return
+        val pages = pages()
+        if (pages.isEmpty()) return
+        busy = true
+        selection.clear(true)
+        cover.setImageBitmap(snapshot(box))
+        cover.visibility = View.VISIBLE
+        topFade.visibility = View.GONE
+        bottomFade.visibility = View.GONE
+        button.setLoading(true)
+        frame.invalidateWall()
+        val stamp = System.currentTimeMillis()
+        val files = ArrayList<File>()
+        var failed = false
+        var lowered = 0
+        fun finish() {
+            busy = false
+            button.setLoading(false)
+            rebuild()
+            cover.visibility = View.GONE
+            cover.setImageBitmap(null)
+            if (failed || files.size != pages.size) {
+                BulletinFactory.of(root, null).createErrorBulletin(TeleLowercase.lc("Not enough memory for the picture.")).show()
+            } else {
+                if (lowered > 0) BulletinFactory.of(root, null).createErrorBulletin(TeleLowercase.lc("Not enough memory: saved at %dx.").format(lowered)).show()
+                done(files)
+            }
+        }
+        fun step(index: Int) {
+            if (restored) return
+            if (index >= pages.size || failed) {
+                finish()
+                return
+            }
+            column.bind(pages[index], options, names)
+            // measured at the page width like the preview, so bubbles keep their line breaks
+            val available = (frame.parent as View).width
+            fun place() {
+                frame.measure(View.MeasureSpec.makeMeasureSpec(available, View.MeasureSpec.AT_MOST), View.MeasureSpec.makeMeasureSpec(0, View.MeasureSpec.UNSPECIFIED))
+                val left = (available - frame.measuredWidth) / 2
+                frame.layout(left, frame.top, left + frame.measuredWidth, frame.top + frame.measuredHeight)
+            }
+            place()
+            afterImages {
+                place()
+                var scale = min(options.scale.toFloat(), ShotColumn.MAX_SIDE / max(frame.width, frame.height).toFloat())
+                var bitmap = frame.render(scale)
+                while (bitmap == null && scale > 1f) {
+                    scale = max(1f, scale - 1f)
+                    bitmap = frame.render(scale)
+                }
+                if (bitmap == null) {
+                    failed = true
+                    finish()
+                    return@afterImages
+                }
+                if (scale < options.scale) lowered = max(1, scale.toInt())
+                val file = File(directory(), "screenshot_${stamp}_${index + 1}.png")
+                Utilities.globalQueue.postRunnable {
+                    val ok = runCatching { FileOutputStream(file).use { bitmap.compress(Bitmap.CompressFormat.PNG, 100, it) } }.getOrDefault(false)
+                    bitmap.recycle()
+                    AndroidUtilities.runOnUIThread {
+                        if (ok) files.add(file) else failed = true
+                        step(index + 1)
+                    }
+                }
+            }
+        }
+        step(0)
+    }
+
+    private fun snapshot(view: View): Bitmap? = runCatching {
+        val bitmap = Bitmap.createBitmap(max(1, view.width), max(1, view.height), Bitmap.Config.ARGB_8888)
+        view.draw(Canvas(bitmap))
+        bitmap
+    }.getOrNull()
