+            }
+            TeleLowercase.lc(if (images > 1) "Screenshots sent to **%s**" else "Screenshot sent to **%s**").format(name)
+        } else {
+            LocaleController.formatPluralString("TeleScreenshotSentChats", dialogs.size)
+        }
+        BulletinFactory.of(chat).createSimpleBulletin(R.raw.forward, AndroidUtilities.replaceTags(text)).show()
+    }
