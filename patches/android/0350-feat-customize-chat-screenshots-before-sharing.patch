diff --git a/TMessagesProj/src/main/java/tele/helpers/ShotNames.kt b/TMessagesProj/src/main/java/tele/helpers/ShotNames.kt
new file mode 100644
index 000000000..004b8dbd3
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/ShotNames.kt
@@ -0,0 +1,181 @@
+package tele.helpers
+
+import org.telegram.messenger.MessageObject
+import org.telegram.messenger.MessagesController
+import org.telegram.messenger.UserConfig
+import org.telegram.messenger.UserObject
+import org.telegram.tgnet.TLRPC
+import java.lang.reflect.Modifier
+
+enum class ShotNameMode { CONTACTS, OWN, HIDDEN, CUSTOM }
+
+class ShotNames(
+    @JvmField val mode: ShotNameMode = ShotNameMode.CONTACTS,
+    @JvmField val custom: Map<Long, String> = emptyMap()
+) {
+    companion object {
+
+        @JvmField
+        val STOCK = ShotNames()
+
+        // messages are built on one thread; scoped so the real chat, dialogs and every other screen keep stock names
+        private val scoped = ThreadLocal<ShotNames?>()
+
+        @JvmStatic
+        fun push(names: ShotNames?): ShotNames? {
+            val previous = scoped.get()
+            if (names == null) scoped.remove() else scoped.set(names)
+            return previous
+        }
+
+        @JvmStatic
+        fun pop(previous: ShotNames?) {
+            if (previous == null) scoped.remove() else scoped.set(previous)
+        }
+
+        @JvmStatic
+        fun activeUserName(user: TLRPC.User?): String? = userName(scoped.get(), user)
+
+        @JvmStatic
+        fun activeChatTitle(chat: TLRPC.Chat?): String? = chatTitle(scoped.get(), chat)
+
+        fun hidden(): String = TeleLowercase.lc("Someone")
+
+        // null means the stock name
+        @JvmStatic
+        fun userName(names: ShotNames?, user: TLRPC.User?): String? {
+            if (names == null || user == null) return null
+            return when (names.mode) {
+                ShotNameMode.CONTACTS -> null
+                ShotNameMode.HIDDEN -> hidden()
+                ShotNameMode.CUSTOM -> names.custom[user.id]
+                ShotNameMode.OWN -> ownName(user)
+            }
+        }
+
+        @JvmStatic
+        fun chatTitle(names: ShotNames?, chat: TLRPC.Chat?): String? {
+            if (names == null || chat == null) return null
+            return when (names.mode) {
+                ShotNameMode.CONTACTS, ShotNameMode.OWN -> null
+                ShotNameMode.HIDDEN -> hidden()
+                ShotNameMode.CUSTOM -> names.custom[-chat.id]
+            }
+        }
+
+        @JvmStatic
+        fun avatarName(names: ShotNames?, user: TLRPC.User?): String? {
+            if (names == null || user == null) return null
+            if (names.mode == ShotNameMode.HIDDEN) return ""
+            val name = userName(names, user) ?: return null
+            return if (names.mode == ShotNameMode.OWN && name.startsWith("@")) name.substring(1) else name
+        }
+
+        @JvmStatic
+        fun avatarTitle(names: ShotNames?, chat: TLRPC.Chat?): String? {
+            if (names == null || chat == null) return null
+            return if (names.mode == ShotNameMode.HIDDEN) "" else chatTitle(names, chat)
+        }
+
+        @JvmStatic
+        fun hidesAvatar(names: ShotNames?): Boolean = names != null && names.mode == ShotNameMode.HIDDEN
+
+        // forward headers resolve from_id only; from_name is typed data and stays
+        @JvmStatic
+        fun forwardName(account: Int, names: ShotNames?, fwd: TLRPC.MessageFwdHeader?): String? {
+            if (names == null || fwd == null || fwd.from_id == null) return null
+            val peer = MessageObject.getPeerId(fwd.from_id)
+            if (peer > 0) return userName(names, MessagesController.getInstance(account).getUser(peer))
+            if (peer < 0) return chatTitle(names, MessagesController.getInstance(account).getChat(-peer))
+            return null
+        }
+
+        @JvmStatic
+        fun replyName(names: ShotNames?, peer: Long): String? {
+            if (names == null) return null
+            return when (names.mode) {
+                ShotNameMode.HIDDEN -> hidden()
+                ShotNameMode.CUSTOM -> if (peer != 0L) names.custom[peer] else null
+                ShotNameMode.CONTACTS, ShotNameMode.OWN -> null
+            }
+        }
+
+        private fun ownName(user: TLRPC.User): String {
+            if (UserObject.isUserSelf(user) || !UserObject.isContact(user) && LocalNames.get(user.id) == null) {
+                return UserObject.tele_stockName(user) ?: ""
+            }
+            val username = UserObject.getPublicUsername(user)
+            return if (username.isNullOrEmpty()) UserObject.getUserName(user) else "@$username"
+        }
+
+        @JvmStatic
+        fun stockName(account: Int, peer: Long): String {
+            if (peer > 0) {
+                val user = MessagesController.getInstance(account).getUser(peer)
+                return if (user != null) UserObject.getUserName(user) else ""
+            }
+            if (peer < 0) return MessagesController.getInstance(account).getChat(-peer)?.title.orEmpty()
+            return ""
+        }
+
+        @JvmStatic
+        fun people(account: Int, messages: List<MessageObject>): List<Long> {
+            val result = LinkedHashSet<Long>()
+            val me = UserConfig.getInstance(account).clientUserId
+            for (message in messages) {
+                val owner = message.messageOwner ?: continue
+                val sender = if (owner.out) me else MessageObject.getPeerId(owner.from_id)
+                addKnown(account, sender, result)
+                if (sender == 0L) addKnown(account, MessageObject.getPeerId(owner.peer_id), result)
+                val fwd = owner.fwd_from
+                if (fwd != null) {
+                    addKnown(account, MessageObject.getPeerId(fwd.from_id), result)
+                    addKnown(account, MessageObject.getPeerId(fwd.saved_from_peer), result)
+                }
+                val reply = message.replyMessageObject
+                if (reply != null) addKnown(account, reply.fromChatId, result)
+                val header = owner.reply_to
+                if (header != null) {
+                    val from = header.reply_from
+                    if (from != null) {
+                        addKnown(account, MessageObject.getPeerId(from.from_id), result)
+                        addKnown(account, MessageObject.getPeerId(from.saved_from_peer), result)
+                    }
+                    addKnown(account, MessageObject.getPeerId(header.reply_to_peer_id), result)
+                    if (header.story_id != 0) addKnown(account, MessageObject.getPeerId(header.peer), result)
+                }
+                collectAction(account, owner.action, result)
+            }
+            return result.toList()
+        }
+
+        private fun addKnown(account: Int, peer: Long, result: MutableSet<Long>) {
+            if (peer == 0L || !result.add(peer)) return
+            val controller = MessagesController.getInstance(account)
+            val known = if (peer > 0) controller.getUser(peer) != null else controller.getChat(-peer) != null
+            if (!known) result.remove(peer)
+        }
+
+        // the lookup drops gift ids that are not peers
+        private fun collectAction(account: Int, action: TLRPC.MessageAction?, result: MutableSet<Long>) {
+            action ?: return
+            for (field in action.javaClass.declaredFields) {
+                if (Modifier.isStatic(field.modifiers)) continue
+                field.isAccessible = true
+                val name = field.name
+                if (field.type == Long::class.javaPrimitiveType) {
+                    if (name != "id" && !name.endsWith("_id")) continue
+                    val id = field.getLong(action)
+                    if (name.endsWith("chat_id") || name.endsWith("channel_id")) {
+                        addKnown(account, -id, result)
+                    } else {
+                        addKnown(account, id, result)
+                    }
+                } else if (List::class.java.isAssignableFrom(field.type)) {
+                    val list = field.get(action) as? List<*> ?: continue
+                    for (value in list) if (value is Long) addKnown(account, value, result)
+                }
+            }
+        }
+    }
+}
