+        private const val FOOTER_DP = 36f
+        private const val FADE_DP = 28f
+        private const val SWIPE_DP = 72f
+        private const val IMAGE_WAIT_MS = 3000L
+        private const val STALE_MS = 60 * 60 * 1000L
+
+        private val PART_LABELS = listOf(
+            ShotPart.NAMES to "Names and badges",
+            ShotPart.USERPICS to "Userpics",
+            ShotPart.REPLIES to "Replies and quotes",
+            ShotPart.FORWARDS to "Forwarded from",
+            ShotPart.PREVIEWS to "Link previews",
+            ShotPart.BUTTONS to "Inline buttons",
+            ShotPart.REACTIONS to "Reactions",
+            ShotPart.INFO to "Time and read checks"
+        )
+
+        private val NAME_LABELS = listOf(
+            ShotNameMode.CONTACTS to "As in my contacts",
+            ShotNameMode.OWN to "Their own names",
+            ShotNameMode.HIDDEN to "Hidden",
+            ShotNameMode.CUSTOM to "Custom"
+        )
+
+        @JvmStatic
+        var isOpen = false
+            private set
+
+        @JvmStatic
+        fun open(chat: ChatActivity, messages: List<MessageObject>, mode: Mode, skipped: Map<Int, Int> = emptyMap()) {
+            val context = chat.parentActivity ?: return
+            if (isOpen || messages.isEmpty() || !TeleShot.allowed(chat, messages)) return
+            TeleShot.preload(chat, messages, context) {
+                if (chat.parentActivity == null || isOpen) return@preload
+                // an album may still be uploading from the previous run
+                val stale = System.currentTimeMillis() - STALE_MS
+                File(FileLoader.getDirectory(FileLoader.MEDIA_DIR_CACHE), "tele_screenshots").listFiles()?.forEach { if (it.lastModified() < stale) it.delete() }
+                chat.showDialog(TeleScreenshotSheet(chat, messages, ScreenshotTheme(chat.currentAccount, chat.themeDelegate), mode, skipped))
+            }
+        }
+    }
+}
