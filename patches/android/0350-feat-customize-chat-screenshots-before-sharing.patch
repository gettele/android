+    private fun afterImages(done: () -> Unit) {
+        val deadline = SystemClock.elapsedRealtime() + IMAGE_WAIT_MS
+        fun check() {
+            if (restored) return
+            if (imagesReady() || SystemClock.elapsedRealtime() >= deadline) done() else AndroidUtilities.runOnUIThread({ check() }, 120)
+        }
+        AndroidUtilities.runOnUIThread({ check() }, 60)
+    }
