+
+    // the incoming bubble color reads on a pattern wallpaper, not on a plain one of the same lightness
+    private fun updateFooterTint() {
+        footerTintDirty = false
+        val bubble = Theme.getColor(Theme.key_chat_inBubble, look)
+        val wallLight = AndroidUtilities.computePerceivedBrightness(averageWall())
+        footerTint = when {
+            abs(wallLight - AndroidUtilities.computePerceivedBrightness(bubble)) > 0.25f -> bubble
+            wallLight > 0.5f -> 0x99000000.toInt()
+            else -> 0xCCFFFFFF.toInt()
+        }
+    }
+
+    private fun averageWall(): Int {
+        val side = 12
+        val bitmap = Bitmap.createBitmap(side, side, Bitmap.Config.ARGB_8888)
+        val canvas = Canvas(bitmap)
+        canvas.drawColor(Theme.getColor(Theme.key_windowBackgroundWhite))
+        canvas.scale(side / wall.width.toFloat(), side / wall.height.toFloat())
+        wall.draw(canvas)
+        var red = 0
+        var green = 0
+        var blue = 0
+        for (y in 0 until side) for (x in 0 until side) {
+            val pixel = bitmap.getPixel(x, y)
+            red += android.graphics.Color.red(pixel)
+            green += android.graphics.Color.green(pixel)
+            blue += android.graphics.Color.blue(pixel)
+        }
+        bitmap.recycle()
+        val count = side * side
+        return android.graphics.Color.rgb(red / count, green / count, blue / count)
+    }
