+    private val footerText = TextPaint(Paint.ANTI_ALIAS_FLAG)
+    private val footerIcon: Drawable? by lazy { context.resources.getDrawable(R.drawable.tele_stat_notification).mutate() }
+
+    private fun drawFooter(canvas: Canvas, width: Int, top: Int) {
+        if (footerTintDirty && wall.width > 0 && wall.height > 0) updateFooterTint()
+        val tint = footerTint
+        val height = frame.footerHeight
+        val side = AndroidUtilities.dp(14f)
+        footerText.color = tint
+        footerText.typeface = AndroidUtilities.bold()
+        footerText.textSize = AndroidUtilities.dp(16f).toFloat()
+        val baseline = top + height / 2f - (footerText.descent() + footerText.ascent()) / 2f
+        canvas.drawText("tele", side.toFloat(), baseline, footerText)
+        footerIcon?.let {
+            val size = AndroidUtilities.dp(20f)
+            val left = width - side - size
+            val iconTop = top + (height - size) / 2
+            it.setBounds(left, iconTop, left + size, iconTop + size)
+            it.colorFilter = PorterDuffColorFilter(tint, PorterDuff.Mode.SRC_IN)
+            it.draw(canvas)
