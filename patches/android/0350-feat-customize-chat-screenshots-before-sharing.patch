+    private fun asDocuments(): Boolean = !options.background && options.transparent
+
+    // the export folder is emptied on every open, a docked picture has to outlive it
+    private fun dock(file: File): Boolean {
+        val kept = runCatching {
+            val dir = File(ApplicationLoader.getFilesDirFixed(), "tele_docked").also { it.mkdirs() }
+            DockedMedia.pruneKept(dir)
+            file.copyTo(File(dir, file.name), overwrite = true)
+        }.getOrNull() ?: return false
+        val bounds = BitmapFactory.Options().apply { inJustDecodeBounds = true }
+        BitmapFactory.decodeFile(kept.absolutePath, bounds)
+        val entry = MediaController.PhotoEntry(0, 0, 0, kept.absolutePath, 0, false, bounds.outWidth, bounds.outHeight, kept.length())
+        if (DockedMedia.add(chat, entry, asDocuments())) return true
+        kept.delete()
+        return false
+    }
