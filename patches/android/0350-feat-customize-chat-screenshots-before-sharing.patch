+    private fun messageCount(): Int {
+        val groups = HashSet<Long>()
+        var count = 0
+        for (entry in entries) {
+            val message = entry.message
+            if (message.isDateObject || message.contentType == 1) continue
+            if (message.groupId != 0L && !groups.add(message.groupId)) continue
+            count++
+        }
+        return count
+    }
+
+    // a shot stays one picture while it fits in memory
+    private fun fitsOnePicture(): Boolean {
+        val width = max(1, frame.measuredWidth).toLong() * options.scale
+        val height = frame.measuredHeight.toLong() * options.scale
+        return height <= ShotColumn.MAX_SIDE && width * height <= ShotColumn.MAX_PIXELS
+    }
+
+    // greedy split by whole units: a page is at most one screen tall with its date, padding and footer
+    private fun pages(): List<List<ShotEntry>> {
+        val units = column.unitBounds()
+        if (units.isEmpty() || entries.isEmpty()) return emptyList()
+        if (mode == Mode.SHOT && fitsOnePicture()) return listOf(entries)
+        val limit = wallHeight()
+        val padding = column.paddingTop + column.paddingBottom + frame.footerHeight
+        val dated = options.dates
+        val dateHeight = if (!dated) 0 else units.firstOrNull { isDate(entries[it[0]]) }?.let { it[3] - it[2] } ?: AndroidUtilities.dp(38f)
+        val result = ArrayList<List<ShotEntry>>()
+        var page = ArrayList<IntArray>()
+        var pageTop = 0
+        fun flush() {
+            while (page.isNotEmpty() && isDate(entries[page.last()[0]])) page.removeAt(page.size - 1)
+            if (page.isEmpty()) return
+            val list = ArrayList<ShotEntry>()
+            val first = entries[page.first()[0]]
+            if (dated && !isDate(first)) list.add(ShotEntry(ShotMessages.dateObject(account, first.message.messageOwner.date), null))
+            page.forEach { unit -> for (i in unit[0] until unit[1]) list.add(entries[i]) }
+            result.add(list)
+            page = ArrayList()
+        }
+        for (unit in units) {
+            if (page.isEmpty()) pageTop = unit[2]
+            val header = if (page.isEmpty() && !isDate(entries[unit[0]]) || page.isNotEmpty() && !isDate(entries[page.first()[0]])) dateHeight else 0
+            val needed = unit[3] - pageTop + padding + header
+            if (page.isNotEmpty() && needed > limit) {
+                val carried = if (isDate(entries[page.last()[0]])) page.last() else null
+                flush()
+                pageTop = carried?.get(2) ?: unit[2]
+                if (carried != null) page.add(carried)
+            }
+            page.add(unit)
+        }
+        flush()
+        return result
+    }
+
+    private fun isDate(entry: ShotEntry): Boolean = entry.message.isDateObject
+
+    private fun updateSummary() {
+        if (busy) return
+        val messages = messageCount()
+        val count = if (messages == 0) 0 else max(1, pages().size)
+        val shot = mode == Mode.SHOT
+        val messageText = LocaleController.formatPluralString("TeleScreenshotMessages", messages)
+        val summary = when {
+            messages == 0 -> TeleLowercase.lc("Swipe a message to the left to hide it")
+            shot && count == 1 -> messageText
+            else -> TeleLowercase.lc("%1\$s · %2\$s").format(
+                LocaleController.formatPluralString(if (shot) "TeleShotPictures" else "TeleScreenshotImages", count),
+                messageText
+            )
+        }
+        // runs on every layout of the frame; an unchanged text must not ask for another one
+        if (subtitle.text?.toString() != summary) subtitle.text = summary
+        val action = LocaleController.formatPluralString(if (shot) "TeleShotShare" else "TeleScreenshotShare", max(1, count))
+        if (action != buttonText) {
+            buttonText = action
+            button.setText(action, true)
+        }
+        button.isEnabled = messages > 0
+        button.alpha = if (messages > 0) 1f else 0.5f
+        updateFades()
+    }
+
+    private fun updateFades() {
+        if (busy) return
+        topFade.visibility = if (scroll.canScrollVertically(-1)) View.VISIBLE else View.GONE
+        bottomFade.visibility = if (scroll.canScrollVertically(1)) View.VISIBLE else View.GONE
+    }
