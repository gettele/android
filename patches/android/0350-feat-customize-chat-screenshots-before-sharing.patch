+import org.telegram.ui.ActionBar.MessageDrawable
+import org.telegram.ui.Stories.recorder.PreviewView
+import java.io.File
+
+// the look of the screenshot editor: the chat's own until another theme or day/night is picked, never the chat's or the app's
+class ScreenshotTheme(private val account: Int, private val chat: ChatActivity.ThemeDelegate?) : Theme.ResourcesProvider {
+
+    private val colors = SparseIntArray()
+    private val drawables = HashMap<String, Drawable>()
+    private val paints = HashMap<String, Paint>()
+    private var own = false
+    private var dark = Theme.isCurrentThemeDark()
+
+    var wallpaper: Drawable? = null
+        private set
+
+    init {
+        showChat()
+    }
+
+    fun showChat() {
+        own = false
+        dark = chat?.isDark ?: Theme.isCurrentThemeDark()
+        colors.clear()
+        drawables.clear()
+        paints.clear()
+        wallpaper = chat?.wallpaperDrawable ?: Theme.getCachedWallpaperNonBlocking()
+    }
+
+    fun show(theme: EmojiThemes?, isDark: Boolean) {
+        own = true
+        dark = isDark
+        colors.clear()
+        val loaded = if (theme != null && !theme.showAsDefaultStub) theme.createColors(account, if (isDark) 1 else 0) else appColors(isDark)
+        for (i in 0 until loaded.size()) colors.put(loaded.keyAt(i), loaded.valueAt(i))
+        wallpaper = if (theme != null && !theme.showAsDefaultStub) {
+            PreviewView.getBackgroundDrawableFromTheme(account, theme, 0, isDark)
+        } else {
+            PreviewView.getBackgroundDrawable(null, account, null as TLRPC.WallPaper?, isDark)
+        }
+        initDrawables()
+        initPaints()
+    }
+
+    // same choice as the stock day/night switch: the last day or night theme the user had
+    private fun appColors(isDark: Boolean): SparseIntArray {
+        val active = Theme.getActiveTheme()
+        val info = if (active.isDark == isDark) active else {
+            val preferences = ApplicationLoader.applicationContext.getSharedPreferences("themeconfig", Activity.MODE_PRIVATE)
+            val day = preferences.getString("lastDayTheme", "Blue")?.let { Theme.getTheme(it) }?.takeIf { !it.isDark } ?: Theme.getTheme("Blue")
+            val night = preferences.getString("lastDarkTheme", "Dark Blue")?.let { Theme.getTheme(it) }?.takeIf { it.isDark } ?: Theme.getTheme("Dark Blue")
+            if (isDark) night else day
+        }
+        val result = SparseIntArray()
+        Theme.getDefaultColors()?.forEachIndexed { key, color -> result.put(key, color) }
+        val link = arrayOfNulls<String>(1)
+        val values = if (info.assetName != null) Theme.getThemeFileValues(null, info.assetName, link) else Theme.getThemeFileValues(File(info.pathToFile), null, link)
+        if (values != null) {
+            for (i in 0 until values.size()) result.put(values.keyAt(i), values.valueAt(i))
+            info.getAccent(false)?.fillAccentColors(values, result)
+        }
+        return result
+    }
+
+    // mirrors ChatActivity.ThemeDelegate: bubbles bound to these colors, the rest of the chat drawables recolored copies
+    private fun initDrawables() {
+        drawables.clear()
+        for ((key, source) in Theme.getThemeDrawablesMap()) {
+            val drawable: Drawable? = when (key) {
+                Theme.key_drawable_msgIn -> MessageDrawable(MessageDrawable.TYPE_TEXT, false, false, this)
+                Theme.key_drawable_msgInSelected -> MessageDrawable(MessageDrawable.TYPE_TEXT, false, true, this)
+                Theme.key_drawable_msgInMedia -> MessageDrawable(MessageDrawable.TYPE_MEDIA, false, false, this)
+                Theme.key_drawable_msgInMediaSelected -> MessageDrawable(MessageDrawable.TYPE_MEDIA, false, true, this)
+                Theme.key_drawable_msgOut -> MessageDrawable(MessageDrawable.TYPE_TEXT, true, false, this)
+                Theme.key_drawable_msgOutSelected -> MessageDrawable(MessageDrawable.TYPE_TEXT, true, true, this)
+                Theme.key_drawable_msgOutMedia -> MessageDrawable(MessageDrawable.TYPE_MEDIA, true, false, this)
+                Theme.key_drawable_msgOutMediaSelected -> MessageDrawable(MessageDrawable.TYPE_MEDIA, true, true, this)
+                else -> source.constantState?.newDrawable()?.mutate()?.also { copy ->
+                    val colorKey = Theme.getThemeDrawableColorKey(key)
+                    if (colorKey >= 0) Theme.setDrawableColor(copy, getColor(colorKey))
+                }
+            }
+            if (drawable != null) drawables[key] = drawable
+        }
+    }
+
+    private fun initPaints() {
+        paints.clear()
+        val service = wallpaper?.let { AndroidUtilities.calcDrawableColor(it)[0] } ?: getColor(Theme.key_chat_serviceBackground)
+        for ((key, source) in Theme.getThemePaintsMap()) {
+            val paint = if (source is TextPaint) TextPaint().also {
+                it.textSize = source.textSize
+                it.typeface = source.typeface
+            } else Paint()
+            if (source.flags and Paint.ANTI_ALIAS_FLAG != 0) paint.flags = Paint.ANTI_ALIAS_FLAG
+            val colorKey = Theme.getThemePaintColorKey(key)
+            when {
+                key == Theme.key_paint_chatActionBackground -> paint.color = service
+                colorKey >= 0 && key != Theme.key_paint_chatActionBackgroundDarken -> paint.color = getColor(colorKey)
+            }
+            paints[key] = paint
+        }
+    }
+
+    override fun getColor(key: Int): Int {
+        if (own) {
+            val index = colors.indexOfKey(key)
+            return if (index >= 0) colors.valueAt(index) else Theme.getColor(key)
+        }
+        return chat?.getColor(key) ?: Theme.getColor(key)
+    }
+
+    override fun getCurrentColor(key: Int): Int = if (own) getColor(key) else chat?.getCurrentColor(key) ?: Theme.getColor(key)
+
+    override fun getDrawable(drawableKey: String): Drawable? = if (own) drawables[drawableKey] else chat?.getDrawable(drawableKey)
+
+    override fun getPaint(paintKey: String): Paint? = if (own) paints[paintKey] ?: Theme.getThemePaint(paintKey) else chat?.getPaint(paintKey) ?: Theme.getThemePaint(paintKey)
+
+    override fun hasGradientService(): Boolean = !own && chat?.hasGradientService() == true
+
+    override fun applyServiceShaderMatrix(w: Int, h: Int, translationX: Float, translationY: Float) {
+        if (!own) chat?.applyServiceShaderMatrix(w, h, translationX, translationY)
+    }
+
+    override fun getAnimatedEmojiColorFilter(): ColorFilter? = if (own) Theme.chat_animatedEmojiTextColorFilter else chat?.animatedEmojiColorFilter
+
+    override fun isDark(): Boolean = dark
+
+    override fun isCompactMode(): Boolean = chat?.isCompactMode ?: super.isCompactMode()
+}
