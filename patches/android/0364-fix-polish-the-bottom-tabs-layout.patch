+    private void teleMeasureEqualTabs(int maxTotalWidthForTabs, int height, int tabHeight) {
+        measureTabTexts(PASS_TEXT_SIZES_DP[0]);
+        final int slotCount = Math.max(1, visibleChildCount);
+        final int slotWidth = maxTotalWidthForTabs / slotCount;
+        final int remainder = maxTotalWidthForTabs - slotWidth * slotCount;
+        final int maxTextWidth = Math.max(0, slotWidth - dp(8) * 2);
+        for (int a = 0, N = getChildCount(); a < N; a++) {
+            final View child = getChildAt(a);
+            if (isViewVisible(child) && child instanceof GlassTabView) {
+                ((GlassTabView) child).tele_setMaxLabelWidth(maxTextWidth);
+            }
+        }
+        applyPassTextSize(0);
+
+        int l = 0;
+        int slotIndex = 0;
+        for (int a = 0, N = getChildCount(); a < N; a++) {
+            final View child = getChildAt(a);
+            if (!isViewVisible(child)) {
+                tabsWidth[a] = 0;
+                tabsLeftPos[a] = 0;
+                child.measure(
+                    MeasureSpec.makeMeasureSpec(0, MeasureSpec.EXACTLY),
+                    MeasureSpec.makeMeasureSpec(tabHeight, MeasureSpec.EXACTLY));
+                continue;
+            }
+            final int width = slotWidth + (slotIndex < remainder ? 1 : 0);
+            slotIndex++;
+            tabsWidth[a] = width;
+            tabsLeftPos[a] = l;
+            l += width;
+            child.measure(
+                MeasureSpec.makeMeasureSpec(width, MeasureSpec.EXACTLY),
+                MeasureSpec.makeMeasureSpec(tabHeight, MeasureSpec.EXACTLY));
+        }
+        setMeasuredDimension(l + getPaddingLeft() + getPaddingRight(), height);
+        calculateTotalSizesAfterMeasure();
+    }
+
