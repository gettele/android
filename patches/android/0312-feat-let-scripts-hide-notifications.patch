diff --git a/TMessagesProj/src/main/java/tele/scripting/ScriptNotifications.kt b/TMessagesProj/src/main/java/tele/scripting/ScriptNotifications.kt
new file mode 100644
index 000000000..ec1133cfb
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/scripting/ScriptNotifications.kt
@@ -0,0 +1,67 @@
+package tele.scripting
+
+import org.json.JSONObject
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.CopyOnWriteArrayList
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicInteger
+
+/**
+ * The notification interceptors of the running scripts: a new message notification is offered to
+ * them before the app shows it, and a script that says drop keeps it away. No answer fails open.
+ */
+object ScriptNotifications {
+
+    private const val TIMEOUT_MS = 500L
+
+    private val runtimes = CopyOnWriteArrayList<ScriptRuntime>()
+    private val waiters = ConcurrentHashMap<Int, CountDownLatch>()
+    private val verdicts = ConcurrentHashMap<Int, Boolean>()
+    private val tokens = AtomicInteger(1)
+
+    @JvmStatic
+    fun register(runtime: ScriptRuntime) {
+        if (!runtimes.contains(runtime)) runtimes.add(runtime)
+    }
+
+    @JvmStatic
+    fun unregister(runtime: ScriptRuntime) {
+        runtimes.remove(runtime)
+    }
+
+    @JvmStatic
+    fun verdict(token: Int, drop: Boolean) {
+        verdicts[token] = drop
+        waiters[token]?.countDown()
+    }
+
+    /** True to show the notification, false to drop it. */
+    @JvmStatic
+    fun intercept(chatId: Long, fromId: Long, kind: String, mentioned: Boolean, text: String?): Boolean {
+        if (runtimes.isEmpty()) return true
+        for (runtime in runtimes) {
+            if (!runtime.hasNotificationInterceptors()) continue
+            val token = tokens.getAndIncrement()
+            val latch = CountDownLatch(1)
+            waiters[token] = latch
+            val payload = JSONObject()
+                .put("token", token)
+                .put("chatId", chatId)
+                .put("fromId", fromId)
+                .put("kind", kind)
+                .put("mentioned", mentioned)
+                .put("text", text ?: "")
+            if (!runtime.requestNotification(token, payload)) {
+                waiters.remove(token)
+                continue
+            }
+            val answered = latch.await(TIMEOUT_MS, TimeUnit.MILLISECONDS)
+            val drop = verdicts.remove(token)
+            waiters.remove(token)
+            if (!answered || drop == null) return true
+            if (drop) return false
+        }
+        return true
+    }
+}
