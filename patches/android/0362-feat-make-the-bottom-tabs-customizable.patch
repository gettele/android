--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/MainTabsBadges.kt
@@ -0,0 +1,16 @@
+package tele.helpers
+
+import org.telegram.messenger.MessagesController
+
+/** The counter of a chat shortcut on the bar: the unread of that dialog, muted ones stay silent. */
+object MainTabsBadges {
+
+    @JvmStatic
+    fun unread(account: Int, dialogId: Long): Int {
+        if (dialogId == 0L) return 0
+        val messagesController = MessagesController.getInstance(account)
+        val dialog = messagesController.getDialog(dialogId) ?: return 0
+        if (messagesController.isDialogMuted(dialogId, 0)) return 0
+        return messagesController.getDialogUnreadCount(dialog)
+    }
+}
diff --git a/TMessagesProj/src/main/java/tele/helpers/MainTabsConfig.kt b/TMessagesProj/src/main/java/tele/helpers/MainTabsConfig.kt
new file mode 100644
index 000000000..f60942460
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/MainTabsConfig.kt
@@ -0,0 +1,165 @@
+package tele.helpers
+
+import org.json.JSONArray
+import org.json.JSONObject
+import org.telegram.messenger.FileLog
+import org.telegram.messenger.UserConfig
+import tele.TeleConfig
+
+/** The bar of the custom main tabs: page slots drive the pager, shortcut slots open a chat. */
+object MainTabsConfig {
+
+    const val KIND_CHATS = "chats"
+    const val KIND_CONTACTS = "contacts"
+    const val KIND_CALLS = "calls"
+    const val KIND_SETTINGS = "settings"
+    const val KIND_PROFILE = "profile"
+    const val KIND_SAVED = "saved"
+    private const val KIND_CHAT_PREFIX = "chat:"
+    const val MAX_SLOTS = 6
+
+    @JvmField
+    val PAGE_KINDS = listOf(KIND_CHATS, KIND_CONTACTS, KIND_CALLS, KIND_SETTINGS, KIND_PROFILE)
+
+    class Slot(val kind: String, val iconName: String = "") {
+        val key: String get() = kind
+        val isShortcut: Boolean get() = kind == KIND_SAVED || kind.startsWith(KIND_CHAT_PREFIX)
+        val isPage: Boolean get() = !isShortcut
+        val dialogId: Long
+            get() = if (kind.startsWith(KIND_CHAT_PREFIX)) {
+                kind.substring(KIND_CHAT_PREFIX.length).toLongOrNull() ?: 0
+            } else {
+                0
+            }
+    }
+
+    private var version = 0
+    @JvmStatic
+    fun version(): Int = version
+
+    @JvmStatic
+    fun onChanged() {
+        version++
+    }
+
+    private var cachedRaw: String? = null
+    private var cachedAccount = -1
+    private var cachedSlots: List<Slot> = emptyList()
+
+    @JvmStatic
+    fun slots(account: Int): List<Slot> {
+        val raw = TeleConfig.MAIN_TABS_CONFIG.value
+        if (raw == cachedRaw && account == cachedAccount) return cachedSlots
+        val parsed = parse(raw)
+        val list = if (parsed.isNullOrEmpty()) defaults(account) else normalize(parsed)
+        cachedRaw = raw
+        cachedAccount = account
+        cachedSlots = list
+        return list
+    }
+
+    @JvmStatic
+    fun save(slots: List<Slot>) {
+        TeleConfig.set(TeleConfig.MAIN_TABS_CONFIG, serialize(normalize(slots)))
+        onChanged()
+    }
+
+    /** Hiding calls leaves the settings page in its place, like the stock bar does. */
+    @JvmStatic
+    fun remove(account: Int, key: String) {
+        val list = ArrayList(slots(account))
+        val index = list.indexOfFirst { it.key == key }
+        if (index < 0) return
+        if (key == KIND_CALLS && list.none { it.kind == KIND_SETTINGS }) {
+            list[index] = Slot(KIND_SETTINGS)
+        } else {
+            list.removeAt(index)
+        }
+        save(list)
+    }
+
+    @JvmStatic
+    fun pageCount(account: Int): Int = slots(account).count { it.isPage }
+
+    @JvmStatic
+    fun pageSlotAt(account: Int, position: Int): Slot? {
+        if (position < 0) return null
+        var index = 0
+        for (slot in slots(account)) {
+            if (!slot.isPage) continue
+            if (index == position) return slot
+            index++
+        }
+        return null
+    }
+
+    @JvmStatic
+    fun pagePosition(account: Int, kind: String): Int {
+        var index = 0
+        for (slot in slots(account)) {
+            if (!slot.isPage) continue
+            if (slot.kind == kind) return index
+            index++
+        }
+        return -1
+    }
+
+    @JvmStatic
+    fun chatsPosition(account: Int): Int = pagePosition(account, KIND_CHATS)
+
+    private fun defaults(account: Int): List<Slot> {
+        val calls = account in 0 until UserConfig.MAX_ACCOUNT_COUNT && UserConfig.getInstance(account).showCallsTab
+        return listOf(
+            Slot(KIND_CHATS),
+            Slot(KIND_CONTACTS),
+            Slot(if (calls) KIND_CALLS else KIND_SETTINGS),
+            Slot(KIND_PROFILE)
+        )
+    }
+
+    private fun normalize(input: List<Slot>): List<Slot> {
+        val out = ArrayList<Slot>(MAX_SLOTS)
+        val seen = HashSet<String>()
+        fun add(slot: Slot) {
+            if (out.size >= MAX_SLOTS || !seen.add(slot.key)) return
+            out.add(slot)
+        }
+        add(input.firstOrNull { it.kind == KIND_CHATS } ?: Slot(KIND_CHATS))
+        for (slot in input) {
+            if (slot.kind == KIND_CHATS) continue
+            val valid = slot.kind in PAGE_KINDS || slot.kind == KIND_SAVED ||
+                (slot.kind.startsWith(KIND_CHAT_PREFIX) && slot.dialogId != 0L)
+            if (valid) add(slot)
+        }
+        return out
+    }
+
+    private fun serialize(slots: List<Slot>): String {
+        val array = JSONArray()
+        for (slot in slots) {
+            val object_ = JSONObject()
+            object_.put("kind", slot.kind)
+            if (slot.iconName.isNotEmpty()) object_.put("icon", slot.iconName)
+            array.put(object_)
+        }
+        return JSONObject().put("version", 1).put("slots", array).toString()
+    }
+
+    private fun parse(raw: String): List<Slot>? {
+        if (raw.isBlank()) return null
+        return runCatching {
+            val array = JSONObject(raw).optJSONArray("slots") ?: return@runCatching null
+            val out = ArrayList<Slot>(array.length())
+            for (i in 0 until array.length()) {
+                val object_ = array.optJSONObject(i) ?: continue
+                val kind = object_.optString("kind", "")
+                if (kind.isEmpty()) continue
+                out.add(Slot(kind, object_.optString("icon", "")))
+            }
+            out
+        }.getOrElse {
+            FileLog.e(it)
+            null
+        }
+    }
+}
