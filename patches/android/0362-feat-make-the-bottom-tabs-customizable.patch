+    /* tele: the custom main tabs */
+
+    private final ArrayList<String> telePageKeys = new ArrayList<>();
+    private final ArrayList<String> teleTabKinds = new ArrayList<>();
+    private final ArrayList<Integer> teleTabPagePositions = new ArrayList<>();
+    private final ArrayList<Long> teleTabDialogIds = new ArrayList<>();
+    private boolean teleBuiltCustom;
+    private int teleBuiltVersion = -1;
+    private int teleProfilePage = POSITION_PROFILE;
+
+    private void teleRefreshBar() {
+        if (tabsView == null || viewPager == null || getContext() == null) {
+            return;
+        }
+        if (viewPager.isManualScrolling() || viewPager.isTouch()) {
+            viewPager.postDelayed(this::teleRefreshBar, 400);
+            return;
+        }
+        if (tele.TeleConfig.CUSTOM_MAIN_TABS.getValue() == teleBuiltCustom
+                && tele.helpers.MainTabsConfig.version() == teleBuiltVersion) {
+            return;
+        }
+        teleRebuildBar(false);
+    }
+
+    private void teleRebuildBar(boolean initial) {
+        final boolean custom = tele.TeleConfig.CUSTOM_MAIN_TABS.getValue();
+        final ArrayList<tele.helpers.MainTabsConfig.Slot> slots = new ArrayList<>();
+        final ArrayList<String> newKeys = new ArrayList<>();
+        if (custom) {
+            slots.addAll(tele.helpers.MainTabsConfig.slots(currentAccount));
+            for (int a = 0; a < slots.size(); a++) {
+                final tele.helpers.MainTabsConfig.Slot slot = slots.get(a);
+                if (slot.isPage()) {
+                    newKeys.add(slot.getKind());
+                }
+            }
+        } else {
+            newKeys.add(tele.helpers.MainTabsConfig.KIND_CHATS);
+            newKeys.add(tele.helpers.MainTabsConfig.KIND_CONTACTS);
+            newKeys.add(getUserConfig().showCallsTab ? tele.helpers.MainTabsConfig.KIND_CALLS : tele.helpers.MainTabsConfig.KIND_SETTINGS);
+            newKeys.add(tele.helpers.MainTabsConfig.KIND_PROFILE);
+        }
+
+        final int currentPosition = viewPager != null ? viewPager.getCurrentPosition() : -1;
+        final String selectedKey = !initial && currentPosition >= 0 && currentPosition < telePageKeys.size()
+            ? telePageKeys.get(currentPosition) : null;
+
+        if (!initial) {
+            teleRemapFragments(telePageKeys, newKeys);
+        }
+        telePageKeys.clear();
+        telePageKeys.addAll(newKeys);
+        teleProfilePage = newKeys.indexOf(tele.helpers.MainTabsConfig.KIND_PROFILE);
+
+        tabsView.tele_clearIgnoreClickTabs();
+        tabsView.removeAllViews();
+        teleTabKinds.clear();
+        teleTabPagePositions.clear();
+        teleTabDialogIds.clear();
+
+        final ArrayList<GlassTabView> built = new ArrayList<>();
+        if (custom) {
+            int page = 0;
+            for (int a = 0; a < slots.size(); a++) {
+                final tele.helpers.MainTabsConfig.Slot slot = slots.get(a);
+                final GlassTabView tab;
+                if (slot.isPage()) {
+                    tab = teleBuildPageTab(slot.getKind(), page);
+                    teleTabPagePositions.add(page);
+                    teleTabDialogIds.add(0L);
+                    page++;
+                } else {
+                    tab = teleBuildShortcutTab(slot);
+                    teleTabPagePositions.add(-1);
+                    teleTabDialogIds.add(teleDialogIdOf(slot));
+                }
+                teleTabKinds.add(slot.getKind());
+                built.add(tab);
+                tabsView.addTabToIgnoreClick(tab);
+            }
+        } else {
+            built.add(teleBuildStockTab(INDEX_CHATS, POSITION_CHATS));
+            built.add(teleBuildStockTab(INDEX_CONTACTS, POSITION_CONTACTS));
+            built.add(teleBuildStockTab(INDEX_SETTINGS, POSITION_CALLS_OR_SETTINGS));
+            built.add(teleBuildStockTab(INDEX_CALLS, POSITION_CALLS_OR_SETTINGS));
+            built.add(teleBuildStockTab(INDEX_PROFILE, POSITION_PROFILE));
+            teleTabPagePositions.add(POSITION_CHATS);
+            teleTabPagePositions.add(POSITION_CONTACTS);
+            teleTabPagePositions.add(POSITION_CALLS_OR_SETTINGS);
+            teleTabPagePositions.add(POSITION_CALLS_OR_SETTINGS);
+            teleTabPagePositions.add(POSITION_PROFILE);
+            teleTabKinds.add(tele.helpers.MainTabsConfig.KIND_CHATS);
+            teleTabKinds.add(tele.helpers.MainTabsConfig.KIND_CONTACTS);
+            teleTabKinds.add(tele.helpers.MainTabsConfig.KIND_SETTINGS);
+            teleTabKinds.add(tele.helpers.MainTabsConfig.KIND_CALLS);
+            teleTabKinds.add(tele.helpers.MainTabsConfig.KIND_PROFILE);
+            teleTabDialogIds.add(0L);
+            teleTabDialogIds.add(0L);
+            teleTabDialogIds.add(0L);
+            teleTabDialogIds.add(0L);
+            teleTabDialogIds.add(0L);
+            tabsView.addTabToIgnoreClick(built.get(INDEX_CHATS));
+            tabsView.addTabToIgnoreClick(built.get(INDEX_CONTACTS));
+            tabsView.addTabToIgnoreClick(built.get(INDEX_CALLS));
+            tabsView.addTabToIgnoreClick(built.get(INDEX_PROFILE));
+        }
+
+        tabs = built.toArray(new GlassTabView[0]);
+        for (int a = 0; a < tabs.length; a++) {
+            tabsView.addView(tabs[a]);
+            tabsView.setViewVisible(tabs[a], true, false);
+        }
+        if (!custom) {
+            final boolean calls = getUserConfig().showCallsTab;
+            tabsView.setViewVisible(tabs[INDEX_SETTINGS], !calls, false);
+            tabsView.setViewVisible(tabs[INDEX_CALLS], calls, false);
+        }
+
+        int newPosition = selectedKey != null ? newKeys.indexOf(selectedKey) : -1;
+        if (newPosition < 0) {
+            newPosition = teleChatsPagePosition();
+        }
+        if (newPosition < 0) {
+            newPosition = 0;
+        }
+        if (!initial && viewPager != null) {
+            if (viewPager.getCurrentPosition() != newPosition || viewPager.getCurrentPosition() >= telePageKeys.size()) {
+                viewPager.setPosition(newPosition);
+            } else {
+                viewPager.rebuild(false);
+            }
+        }
+
+        teleBuiltCustom = custom;
+        teleBuiltVersion = tele.helpers.MainTabsConfig.version();
+        if (viewPager != null) {
+            selectTab(viewPager.getCurrentPosition(), false);
+        }
+        teleUpdateUnreadBadges(false);
+        teleUpdateContactsBadge();
+        tabsView.requestLayout();
+        if (!initial) {
+            blur3_invalidateBlur();
+        }
+    }
+
+    /** Pages live at their slot positions: the fragments that stay keep their state, the removed ones go. */
+    private void teleRemapFragments(ArrayList<String> oldKeys, ArrayList<String> newKeys) {
+        for (int position = 0; position < oldKeys.size(); position++) {
+            if (fragmentsArr.get(position) != null && !newKeys.contains(oldKeys.get(position))) {
+                dropFragmentAtPosition(position);
+            }
+        }
+        final SparseArray<FragmentState> kept = new SparseArray<>();
+        for (int position = 0; position < oldKeys.size(); position++) {
+            final FragmentState state = fragmentsArr.get(position);
+            if (state != null) {
+                kept.put(position, state);
+            }
+        }
+        fragmentsArr.clear();
+        for (int position = 0; position < newKeys.size(); position++) {
+            final int oldPosition = oldKeys.indexOf(newKeys.get(position));
+            if (oldPosition < 0) {
+                continue;
+            }
+            final FragmentState state = kept.get(oldPosition);
+            if (state != null) {
+                fragmentsArr.put(position, state);
+            }
+        }
+    }
+
+    private GlassTabView teleBuildPageTab(String kind, int position) {
+        final GlassTabView tab;
+        if (tele.helpers.MainTabsConfig.KIND_CONTACTS.equals(kind)) {
+            tab = GlassTabView.createMainTab(getContext(), resourceProvider, GlassTabView.TabAnimation.CONTACTS, R.string.MainTabsContacts);
+            tab.setOnLongClickListener(this::openContactsSelector);
+        } else if (tele.helpers.MainTabsConfig.KIND_CALLS.equals(kind)) {
+            tab = GlassTabView.createMainTab(getContext(), resourceProvider, GlassTabView.TabAnimation.CALLS, R.string.MainTabsCalls);
+            tab.setOnLongClickListener(this::teleOpenCallsSelector);
+        } else if (tele.helpers.MainTabsConfig.KIND_SETTINGS.equals(kind)) {
+            tab = GlassTabView.createMainTab(getContext(), resourceProvider, GlassTabView.TabAnimation.SETTINGS, R.string.Settings);
+        } else if (tele.helpers.MainTabsConfig.KIND_PROFILE.equals(kind)) {
+            tab = GlassTabView.createAvatar(getContext(), resourceProvider, currentAccount, R.string.MainTabsProfile);
+            tab.setOnLongClickListener(this::openAccountSelector);
+        } else {
+            tab = GlassTabView.createMainTab(getContext(), resourceProvider, GlassTabView.TabAnimation.CHATS, R.string.MainTabsChats);
+            tab.setOnLongClickListener(this::openFoldersSelector);
+        }
+        final int page = position;
+        tab.setOnClickListener(v -> teleOnPageTabClicked(page));
+        return tab;
+    }
+
+    private GlassTabView teleBuildStockTab(int index, int position) {
+        final GlassTabView tab;
+        if (index == INDEX_CHATS) {
+            tab = GlassTabView.createMainTab(getContext(), resourceProvider, GlassTabView.TabAnimation.CHATS, R.string.MainTabsChats);
+            tab.setOnLongClickListener(this::openFoldersSelector);
+        } else if (index == INDEX_CONTACTS) {
+            tab = GlassTabView.createMainTab(getContext(), resourceProvider, GlassTabView.TabAnimation.CONTACTS, R.string.MainTabsContacts);
+            tab.setOnLongClickListener(this::openContactsSelector);
+        } else if (index == INDEX_SETTINGS) {
+            tab = GlassTabView.createMainTab(getContext(), resourceProvider, GlassTabView.TabAnimation.SETTINGS, R.string.Settings);
+        } else if (index == INDEX_CALLS) {
+            tab = GlassTabView.createMainTab(getContext(), resourceProvider, GlassTabView.TabAnimation.CALLS, R.string.MainTabsCalls);
+            tab.setOnLongClickListener(this::openCallsSelector);
+        } else {
+            tab = GlassTabView.createAvatar(getContext(), resourceProvider, currentAccount, R.string.MainTabsProfile);
+            tab.setOnLongClickListener(this::openAccountSelector);
+        }
+        final int page = position;
+        tab.setOnClickListener(v -> teleOnPageTabClicked(page));
+        return tab;
+    }
+
+    private GlassTabView teleBuildShortcutTab(tele.helpers.MainTabsConfig.Slot slot) {
+        final long dialogId = teleDialogIdOf(slot);
+        final GlassTabView tab = GlassTabView.tele_createDialogAvatar(getContext(), resourceProvider, teleDialogTitle(dialogId));
+        teleSetAvatar(tab, dialogId);
+        tab.setCounter(null, false, false);
+        tab.setOnClickListener(v -> {
+            if (viewPager.isManualScrolling() || viewPager.isTouch()) {
+                return;
+            }
+            teleOpenDialog(dialogId);
+        });
+        tab.setOnLongClickListener(v -> teleOpenShortcutMenu(v, slot));
+        return tab;
+    }
+
+    private long teleDialogIdOf(tele.helpers.MainTabsConfig.Slot slot) {
+        if (tele.helpers.MainTabsConfig.KIND_SAVED.equals(slot.getKind())) {
+            return getUserConfig().getClientUserId();
+        }
+        return slot.getDialogId();
+    }
+
+    private void teleOnPageTabClicked(int position) {
+        if (viewPager.isManualScrolling() || viewPager.isTouch()) {
+            return;
+        }
+        if (viewPager.getCurrentPosition() == position) {
+            final BaseFragment fragment = getCurrentVisibleFragment();
+            if (position == teleChatsPagePosition() && fragment instanceof DialogsActivity
+                    && tele.TeleConfig.CHATS_TAB_DOUBLE_TAP_ALL.getValue()
+                    && tele.helpers.ChatsTabDoubleTap.onReselect((DialogsActivity) fragment)) {
+                return;
+            }
+            if (fragment instanceof MainTabsActivity.TabFragmentDelegate) {
+                ((MainTabsActivity.TabFragmentDelegate) fragment).onParentScrollToTop();
+            }
+            return;
+        }
+        selectTab(position, true);
+        viewPager.scrollToPosition(position);
+    }
+
+    private void teleSelectTab(int position, boolean animated) {
+        if (tabs == null) {
+            return;
+        }
+        for (int a = 0; a < tabs.length; a++) {
+            final int page = a < teleTabPagePositions.size() ? teleTabPagePositions.get(a) : -1;
+            tabs[a].setSelected(page >= 0 && page == position, animated);
+        }
+    }
+
+    private void teleSetGestureSelectedOverride(float animatedPosition, boolean allow) {
+        if (tabs == null || tabsView == null) {
+            return;
+        }
+        for (int a = 0; a < tabs.length; a++) {
+            final int page = a < teleTabPagePositions.size() ? teleTabPagePositions.get(a) : -1;
+            final float visibility = page < 0 ? 0 : Math.max(0, 1f - Math.abs(page - animatedPosition));
+            tabs[a].setGestureSelectedOverride(visibility, allow && page >= 0);
+        }
+        tabsView.invalidate();
+    }
+
+    private void teleUpdateUnreadBadges(boolean animated) {
+        if (tabsView == null || tabs == null) {
+            return;
+        }
+        final GlassTabView chatsTab = teleTabForKind(tele.helpers.MainTabsConfig.KIND_CHATS);
+        if (chatsTab != null) {
+            final int unreadCount = tele.helpers.TeleCounters.folderCounter(MessagesStorage.getInstance(currentAccount).getMainUnreadCount());
+            chatsTab.setCounter(unreadCount > 0 ? LocaleController.formatNumber(unreadCount, ',') : null, false, animated);
+        }
+        for (int a = 0; a < tabs.length && a < teleTabDialogIds.size(); a++) {
+            final long dialogId = teleTabDialogIds.get(a);
+            if (dialogId == 0) {
+                continue;
+            }
+            final int unreadCount = tele.helpers.TeleCounters.folderCounter(tele.helpers.MainTabsBadges.unread(currentAccount, dialogId));
+            tabs[a].setCounter(unreadCount > 0 ? LocaleController.formatNumber(unreadCount, ',') : null, false, animated);
+        }
+    }
+
+    private void teleUpdateContactsBadge() {
+        final GlassTabView tab = teleTabForKind(tele.helpers.MainTabsConfig.KIND_CONTACTS);
+        if (tab == null) {
+            return;
+        }
+        final boolean hasPermission = Build.VERSION.SDK_INT >= 23 && ContactsController.hasContactsPermission();
+        if (hasPermission) {
+            MessagesController.getGlobalNotificationsSettings().edit().putBoolean("askAboutContacts2", true).apply();
+        }
+        if (Build.VERSION.SDK_INT >= 23 && UserConfig.getInstance(currentAccount).syncContacts && !hasPermission && MessagesController.getGlobalNotificationsSettings().getBoolean("askAboutContacts2", true)) {
+            tab.setCounter("!", true, true);
+        } else {
+            tab.setCounter(null, true, true);
+        }
+    }
+
+    private GlassTabView teleTabForKind(String kind) {
+        if (tabs == null) {
+            return null;
+        }
+        for (int a = 0; a < tabs.length && a < teleTabKinds.size(); a++) {
+            if (kind.equals(teleTabKinds.get(a))) {
+                return tabs[a];
+            }
+        }
+        return null;
+    }
+
+    private void teleUpdateProfileTab() {
+        final GlassTabView tab = teleTabForKind(tele.helpers.MainTabsConfig.KIND_PROFILE);
+        if (tab != null) {
+            tab.updateUserAvatar(currentAccount);
+        }
+    }
+
+    private void teleRefreshShortcuts() {
+        if (tabs == null || teleTabDialogIds.isEmpty()) {
+            return;
+        }
+        boolean changed = false;
+        for (int a = 0; a < tabs.length && a < teleTabDialogIds.size(); a++) {
+            final long dialogId = teleTabDialogIds.get(a);
+            if (dialogId == 0) {
+                continue;
+            }
+            tabs[a].setText(teleDialogTitle(dialogId));
+            teleSetAvatar(tabs[a], dialogId);
+            changed = true;
+        }
+        if (changed && tabsView != null) {
+            tabsView.requestLayout();
+        }
+    }
+
+    private void teleSetAvatar(GlassTabView tab, long dialogId) {
+        final BackupImageView image = tab.getBackupImageView();
+        if (image == null) {
+            return;
+        }
+        final AvatarDrawable drawable = new AvatarDrawable();
+        if (dialogId == getUserConfig().getClientUserId()) {
+            drawable.setAvatarType(AvatarDrawable.AVATAR_TYPE_SAVED);
+            image.setImage(null, null, drawable, null);
+            return;
+        }
+        TLObject object = null;
+        if (DialogObject.isEncryptedDialog(dialogId)) {
+            final TLRPC.EncryptedChat encryptedChat = getMessagesController().getEncryptedChat(DialogObject.getEncryptedChatId(dialogId));
+            if (encryptedChat != null) {
+                object = getMessagesController().getUser(encryptedChat.user_id);
+            }
+        } else {
+            object = getMessagesController().getUserOrChat(dialogId);
+        }
+        if (object == null) {
+            drawable.setInfo(dialogId, "", "", null);
+            image.setImage(null, null, drawable, null);
+            return;
+        }
+        drawable.setInfo(currentAccount, object);
+        image.setForUserOrChat(object, drawable);
+    }
+
+    private CharSequence teleDialogTitle(long dialogId) {
+        if (dialogId == getUserConfig().getClientUserId()) {
+            return getString(R.string.SavedMessages);
+        }
+        if (DialogObject.isEncryptedDialog(dialogId)) {
+            final TLRPC.EncryptedChat encryptedChat = getMessagesController().getEncryptedChat(DialogObject.getEncryptedChatId(dialogId));
+            if (encryptedChat != null) {
+                final TLRPC.User user = getMessagesController().getUser(encryptedChat.user_id);
+                if (user != null) {
+                    return UserObject.getUserName(user);
+                }
+            }
+            return "";
+        }
+        return DialogObject.getName(currentAccount, dialogId);
+    }
+
+    private void teleOpenDialog(long dialogId) {
+        if (dialogId == 0) {
+            return;
+        }
+        final Bundle args = new Bundle();
+        if (DialogObject.isEncryptedDialog(dialogId)) {
+            args.putInt("enc_id", DialogObject.getEncryptedChatId(dialogId));
+        } else if (DialogObject.isUserDialog(dialogId)) {
+            args.putLong("user_id", dialogId);
+        } else {
+            args.putLong("chat_id", -dialogId);
+        }
+        if (getMessagesController().checkCanOpenChat(args, this)) {
+            presentFragment(new ChatActivity(args));
+        }
+    }
+
+    private boolean teleOpenShortcutMenu(View anchor, tele.helpers.MainTabsConfig.Slot slot) {
+        if (getContext() == null || getParentActivity() == null) {
+            return false;
+        }
+        final long dialogId = teleDialogIdOf(slot);
+        final ItemOptions o = ItemOptions.makeOptions(this, anchor);
+        o.add(R.drawable.msg_openin, getString(R.string.Open), () -> teleOpenDialog(dialogId));
+        o.add(R.drawable.msg_delete, getString(R.string.Remove), () -> {
+            tele.helpers.MainTabsConfig.remove(currentAccount, slot.getKey());
+            teleRefreshBar();
+        });
+        o.setBlur(true);
+        o.translate(0, -dp(4));
+        o.setGravity(Gravity.LEFT);
+        final ShapeDrawable bg = Theme.createRoundRectDrawable(dp(28), getThemedColor(Theme.key_windowBackgroundWhite));
+        bg.getPaint().setShadowLayer(dp(6), 0, dp(1), Theme.multAlpha(0xFF000000, 0.15f));
+        o.setScrimViewBackground(bg);
+        o.show();
+        return true;
+    }
+
+    private boolean teleOpenCallsSelector(View anchor) {
+        if (getContext() == null || getParentActivity() == null) {
+            return false;
+        }
+        final ItemOptions o = ItemOptions.makeOptions(this, anchor);
+        o.add(R.drawable.menu_call_create, getString(R.string.GroupCallCreate2), () -> CallLogActivity.openCreateCall(this));
+        o.add(R.drawable.msg_archive_hide, getString(R.string.HideCallTab), () -> {
+            tele.helpers.MainTabsConfig.remove(currentAccount, tele.helpers.MainTabsConfig.KIND_CALLS);
+            teleRefreshBar();
+        });
+        o.setBlur(true);
+        o.translate(0, -dp(4));
+        final ShapeDrawable bg = Theme.createRoundRectDrawable(dp(28), getThemedColor(Theme.key_windowBackgroundWhite));
+        bg.getPaint().setShadowLayer(dp(6), 0, dp(1), Theme.multAlpha(0xFF000000, 0.15f));
+        o.setScrimViewBackground(bg);
+        o.show();
+        return true;
+    }
+
+    private int teleChatsPagePosition() {
+        if (!tele.TeleConfig.CUSTOM_MAIN_TABS.getValue()) {
+            return POSITION_CHATS;
+        }
+        final int position = tele.helpers.MainTabsConfig.chatsPosition(currentAccount);
+        return position >= 0 ? position : POSITION_CHATS;
+    }
+
+    private int teleProfilePagePosition() {
+        if (!tele.TeleConfig.CUSTOM_MAIN_TABS.getValue()) {
+            return POSITION_PROFILE;
+        }
+        return teleProfilePage;
+    }
+
+    private void teleOpenFolder(int folderId) {
+        final int chats = teleChatsPagePosition();
+        if (viewPager.getCurrentPosition() == chats && dialogsActivity != null) {
+            dialogsActivity.scrollToFolder(folderId);
+        } else {
+            if (dialogsActivity == null) {
+                telePrepareDialogsActivity(null);
+            }
+            pendingFolderId = folderId;
+            selectTab(chats, true);
+            viewPager.scrollToPosition(chats);
+        }
+    }
+
+    private DialogsActivity telePrepareDialogsActivity(Bundle bundle) {
+        if (bundle == null) {
+            bundle = new Bundle();
+        }
+        bundle.putBoolean("hasMainTabs", true);
+        dialogsActivity = new DialogsActivity(bundle);
+        dialogsActivity.setMainTabsActivityController(new MainTabsActivityControllerImpl());
+        putFragmentAtPosition(teleChatsPagePosition(), dialogsActivity);
+        return dialogsActivity;
+    }
+
+    private BaseFragment teleCreatePageAt(int position) {
+        final tele.helpers.MainTabsConfig.Slot slot = tele.helpers.MainTabsConfig.pageSlotAt(currentAccount, position);
+        final Bundle args = new Bundle();
+        final String kind = slot != null ? slot.getKind() : tele.helpers.MainTabsConfig.KIND_CHATS;
+        if (tele.helpers.MainTabsConfig.KIND_CONTACTS.equals(kind)) {
+            args.putBoolean("needPhonebook", true);
+            args.putBoolean("needFinishFragment", false);
+            args.putBoolean("hasMainTabs", true);
+            return new ContactsActivity(args);
+        } else if (tele.helpers.MainTabsConfig.KIND_CALLS.equals(kind)) {
+            args.putBoolean("needFinishFragment", false);
+            args.putBoolean("hasMainTabs", true);
+            return new CallLogActivity(args);
+        } else if (tele.helpers.MainTabsConfig.KIND_SETTINGS.equals(kind)) {
+            args.putBoolean("hasMainTabs", true);
+            return new SettingsActivity(args);
+        } else if (tele.helpers.MainTabsConfig.KIND_PROFILE.equals(kind)) {
+            args.putLong("user_id", UserConfig.getInstance(currentAccount).getClientUserId());
+            args.putBoolean("my_profile", true);
+            args.putBoolean("hasMainTabs", true);
+            return new ProfileActivity(args);
+        }
+        args.putBoolean("hasMainTabs", true);
+        dialogsActivity = new DialogsActivity(args);
+        dialogsActivity.setMainTabsActivityController(new MainTabsActivityControllerImpl());
+        return dialogsActivity;
+    }
+
+    private void teleOnScrollEnd() {
+        if (tabsView != null) {
+            selectTab(viewPager.getCurrentPosition(), true);
+            setGestureSelectedOverride(0, false);
+        }
+        blur3_invalidateBlur();
+        if (viewPager != null) {
+            final int currentPosition = viewPager.getCurrentPosition();
+            final int profilePosition = teleProfilePagePosition();
+            if (profilePosition >= 0 && currentPosition != profilePosition) {
+                dropFragmentAtPosition(profilePosition);
+            }
+            if (pendingFolderId != null && currentPosition == teleChatsPagePosition() && dialogsActivity != null) {
+                dialogsActivity.scrollToFolder(pendingFolderId);
+                pendingFolderId = null;
+            }
+            if (tele.ui.TeleFolderSidebar.enabled() && fragmentView != null) {
+                fragmentView.getRootView().requestLayout();
+            }
+        }
+    }
 }
