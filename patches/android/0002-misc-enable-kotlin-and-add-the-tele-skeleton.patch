index 000000000..fb82bdb8d
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/TeleConfig.kt
@@ -0,0 +1,58 @@
+package tele
+
+import android.content.Context
+import android.content.SharedPreferences
+
+val configItems = mutableListOf<Item<*>>()
+
+abstract class Item<T>(val key: String, val default: T) {
+    var value: T = default
+        internal set
+
+    init {
+        configItems.add(this)
+    }
+
+    internal fun load(prefs: SharedPreferences) {
+        @Suppress("UNCHECKED_CAST")
+        value = when (default) {
+            is Boolean -> prefs.getBoolean(key, default) as T
+            is Int -> prefs.getInt(key, default) as T
+            is Float -> prefs.getFloat(key, default) as T
+            is String -> prefs.getString(key, default) as T
+            else -> default
+        }
+    }
+
+    internal fun save(prefs: SharedPreferences) {
+        prefs.edit().apply {
+            when (val v = value) {
+                is Boolean -> putBoolean(key, v)
+                is Int -> putInt(key, v)
+                is Float -> putFloat(key, v)
+                is String -> putString(key, v)
+            }
+        }.apply()
+    }
+}
+
+class BoolItem(key: String, default: Boolean = false) : Item<Boolean>(key, default)
+class IntItem(key: String, default: Int) : Item<Int>(key, default)
+class FloatItem(key: String, default: Float) : Item<Float>(key, default)
+class StringItem(key: String, default: String) : Item<String>(key, default)
+
+object TeleConfig {
+    private var prefs: SharedPreferences? = null
+
+    fun init(context: Context) {
+        val p = context.applicationContext.getSharedPreferences("tele_config", Context.MODE_PRIVATE)
+        prefs = p
+        configItems.forEach { it.load(p) }
+    }
+
+    fun <T> set(item: Item<T>, v: T) {
+        val p = prefs ?: return
+        item.value = v
+        item.save(p)
+    }
+}
