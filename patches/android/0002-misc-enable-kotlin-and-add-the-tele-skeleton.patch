@@ -0,0 +1,47 @@
+package tele.db
+
+import android.content.ContentValues
+import android.content.Context
+import android.database.sqlite.SQLiteDatabase
+import android.database.sqlite.SQLiteOpenHelper
+
+object TeleDatabaseHelper {
+    private var helper: Helper? = null
+
+    fun init(context: Context) {
+        if (helper == null) {
+            helper = Helper(context.applicationContext)
+        }
+    }
+
+    fun put(key: String, value: String?) {
+        val db = helper?.writableDatabase ?: return
+        if (value == null) {
+            db.delete("tele_kv", "key = ?", arrayOf(key))
+            return
+        }
+        val cv = ContentValues()
+        cv.put("key", key)
+        cv.put("value", value)
+        db.insertWithOnConflict("tele_kv", null, cv, SQLiteDatabase.CONFLICT_REPLACE)
+    }
+
+    fun get(key: String, default: String? = null): String? {
+        val db = helper?.readableDatabase ?: return default
+        db.rawQuery("SELECT value FROM tele_kv WHERE key = ?", arrayOf(key)).use { c ->
+            if (c.moveToFirst()) {
+                return c.getString(0)
+            }
+        }
+        return default
+    }
+
+    private class Helper(context: Context) : SQLiteOpenHelper(context, "tele.db", null, 1) {
+        override fun onCreate(db: SQLiteDatabase) {
+            db.execSQL("CREATE TABLE IF NOT EXISTS tele_kv (key TEXT PRIMARY KEY, value TEXT)")
+        }
+
+        override fun onUpgrade(db: SQLiteDatabase, oldVersion: Int, newVersion: Int) {
+        }
+    }
+}
