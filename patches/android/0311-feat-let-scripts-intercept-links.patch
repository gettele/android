+    fun hasLinkInterceptors(): Boolean = linkInterceptors.isNotEmpty()
+
+    /** Asks the script's interceptors about a link; the answer comes back through link.verdict. */
+    fun requestLink(token: Int, url: String): Boolean {
+        if (!running || handle == 0L || linkInterceptors.isEmpty()) return false
+        val payload = JSONObject().put("token", token).put("url", url).toString()
+        queue.offer(Runnable {
+            val error = QuickJs.call(handle, "__teleLink", payload)
+            if (error != null) fault(error)
+        })
+        return true
+    }
