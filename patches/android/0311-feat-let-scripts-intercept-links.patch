+				if (callback === undefined) {
+					continue;
+				}
+				let verdict = callback({ url: current });
+				if (verdict === undefined || verdict === null) {
+					verdict = 'open';
+				}
+				if (typeof verdict !== 'string') {
+					continue;
+				}
+				if (verdict === 'drop') {
