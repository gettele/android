diff --git a/TMessagesProj/src/main/java/tele/scripting/ScriptLinks.kt b/TMessagesProj/src/main/java/tele/scripting/ScriptLinks.kt
new file mode 100644
index 000000000..e01567a6b
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/scripting/ScriptLinks.kt
@@ -0,0 +1,64 @@
+package tele.scripting
+
+import android.net.Uri
+import org.json.JSONObject
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.CopyOnWriteArrayList
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.TimeUnit
+import java.util.concurrent.atomic.AtomicInteger
+
+/**
+ * The link interceptors of the running scripts: every link the app is about to open is offered to
+ * them in start order, and the first rewrite wins. A script that does not answer in time fails open.
+ */
+object ScriptLinks {
+
+    private const val TIMEOUT_MS = 500L
+
+    private val runtimes = CopyOnWriteArrayList<ScriptRuntime>()
+    private val waiters = ConcurrentHashMap<Int, CountDownLatch>()
+    private val verdicts = ConcurrentHashMap<Int, JSONObject>()
+    private val tokens = AtomicInteger(1)
+
+    @JvmStatic
+    fun register(runtime: ScriptRuntime) {
+        if (!runtimes.contains(runtime)) runtimes.add(runtime)
+    }
+
+    @JvmStatic
+    fun unregister(runtime: ScriptRuntime) {
+        runtimes.remove(runtime)
+    }
+
+    @JvmStatic
+    fun verdict(token: Int, payload: JSONObject) {
+        verdicts[token] = payload
+        waiters[token]?.countDown()
+    }
+
+    /** The link to open, or null when a script drops it. */
+    @JvmStatic
+    fun intercept(uri: Uri): Uri? {
+        if (runtimes.isEmpty()) return uri
+        var url = uri.toString()
+        for (runtime in runtimes) {
+            if (!runtime.hasLinkInterceptors()) continue
+            val token = tokens.getAndIncrement()
+            val latch = CountDownLatch(1)
+            waiters[token] = latch
+            if (!runtime.requestLink(token, url)) {
+                waiters.remove(token)
+                continue
+            }
+            val answered = latch.await(TIMEOUT_MS, TimeUnit.MILLISECONDS)
+            val answer = verdicts.remove(token)
+            waiters.remove(token)
+            if (!answered || answer == null) return if (url == uri.toString()) uri else Uri.parse(url)
+            if (answer.optBoolean("drop")) return null
+            val next = answer.optString("url")
+            if (next.isNotEmpty()) url = next
+        }
+        return if (url == uri.toString()) uri else Uri.parse(url)
+    }
+}
