diff --git a/TMessagesProj/src/main/java/tele/helpers/TeleCompactRows.kt b/TMessagesProj/src/main/java/tele/helpers/TeleCompactRows.kt
new file mode 100644
index 000000000..005b6c8dc
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/TeleCompactRows.kt
@@ -0,0 +1,39 @@
+package tele.helpers
+
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.ui.DialogsActivity
+import tele.TeleConfig
+import java.util.Collections
+import java.util.WeakHashMap
+
+// Compact chat list rows: a small avatar and one line, no message preview.
+object TeleCompactRows {
+    const val HEIGHT_DP = 40
+    const val AVATAR_DP = 28
+    const val SKIP_DP = 6
+
+    private val screens: MutableSet<DialogsActivity> = Collections.newSetFromMap(WeakHashMap())
+
+    @JvmStatic
+    fun enabled(): Boolean = TeleConfig.HIDE_LIST_PREVIEWS.value
+
+    // only the chat list and its folders, not the pickers
+    @JvmStatic
+    fun applies(dialogsType: Int): Boolean = enabled() && (dialogsType == 0 || dialogsType == 7 || dialogsType == 8)
+
+    @JvmStatic
+    fun height(dialogsType: Int, stock: Int): Int = if (applies(dialogsType)) AndroidUtilities.dp(HEIGHT_DP.toFloat()) else stock
+
+    @JvmStatic
+    fun track(screen: DialogsActivity) {
+        synchronized(screens) { screens.add(screen) }
+    }
+
+    @JvmStatic
+    fun onToggled() {
+        AndroidUtilities.runOnUIThread {
+            val open = synchronized(screens) { screens.toList() }
+            open.forEach { it.tele_refreshRows() }
+        }
+    }
+}
