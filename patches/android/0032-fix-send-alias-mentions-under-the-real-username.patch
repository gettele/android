From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Mon, 5 Oct 2026 05:03:26 +0300
Subject: [PATCH] fix: send alias mentions under the real username

The alias text used to stay in the sent message with a mention layered
on top, so every recipient could read the alias. A user with a public
username is now substituted with @username and a plain mention entity;
without one, the alias becomes the user's real name with an
inputMessageEntityMentionName, the same shape stock builds when you
mention someone without a username. Local names are read from
first_name/last_name directly so they are never leaked into the text.

Constraint: mentions of users without a public username need visible text
Rejected: keeping the alias as a hidden entity | text is what others read
Confidence: high
Scope-risk: narrow
---
 .../src/main/java/tele/helpers/Aliases.kt     | 61 ++++++++++++-------
 1 file changed, 39 insertions(+), 22 deletions(-)

diff --git a/TMessagesProj/src/main/java/tele/helpers/Aliases.kt b/TMessagesProj/src/main/java/tele/helpers/Aliases.kt
index 962290d86..e15c67e6b 100644
--- a/TMessagesProj/src/main/java/tele/helpers/Aliases.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/Aliases.kt
@@ -82,6 +82,38 @@ object Aliases {
         }
     }
 
+    private fun mentionFor(account: Int, did: Long, offset: Int, length: Int): Pair<TLRPC.MessageEntity, String>? {
+        val controller = org.telegram.messenger.MessagesController.getInstance(account)
+        if (did > 0) {
+            val user = controller.getUser(did)
+            val username = org.telegram.messenger.UserObject.getPublicUsername(user)
+            if (username != null) {
+                return Pair(TLRPC.TL_messageEntityMention().also {
+                    it.offset = offset
+                    it.length = username.length + 1
+                }, "@$username")
+            }
+            val inputUser = controller.getInputUser(did)
+            val name = if (user != null) org.telegram.messenger.ContactsController.formatName(user.first_name, user.last_name) else null
+            if (inputUser != null && !name.isNullOrEmpty()) {
+                return Pair(TLRPC.TL_inputMessageEntityMentionName().also {
+                    it.user_id = inputUser
+                    it.offset = offset
+                    it.length = name.length
+                }, name)
+            }
+            return null
+        }
+        val username = org.telegram.messenger.ChatObject.getPublicUsername(controller.getChat(-did))
+        if (username != null) {
+            return Pair(TLRPC.TL_messageEntityMention().also {
+                it.offset = offset
+                it.length = username.length + 1
+            }, "@$username")
+        }
+        return null
+    }
+
     @JvmStatic
     fun replaceForSend(account: Int, message: Array<CharSequence?>): ArrayList<TLRPC.MessageEntity>? {
         if (!TeleConfig.USERNAME_ALIASES.value) return null
@@ -99,28 +131,13 @@ object Aliases {
                 val did = dialogId(account, alias)
                 if (did != 0L) {
                     val shift = if (result == null) 0 else added
-                    if (did > 0) {
-                        val inputUser = org.telegram.messenger.MessagesController.getInstance(account).getInputUser(did)
-                        if (inputUser != null) {
-                            mentions.add(TLRPC.TL_inputMessageEntityMentionName().also {
-                                it.user_id = inputUser
-                                it.offset = i + shift
-                                it.length = j - i
-                            })
-                        }
-                    } else {
-                        val chat = org.telegram.messenger.MessagesController.getInstance(account).getChat(-did)
-                        val username = org.telegram.messenger.ChatObject.getPublicUsername(chat)
-                        if (username != null) {
-                            val replacement = "@$username"
-                            result = result ?: text
-                            result = result.substring(0, i + shift) + replacement + result.substring(j + shift)
-                            added += replacement.length - (j - i)
-                            mentions.add(TLRPC.TL_messageEntityMention().also {
-                                it.offset = i + shift
-                                it.length = replacement.length
-                            })
-                        }
+                    val mention = mentionFor(account, did, i + shift, j - i)
+                    if (mention != null) {
+                        val replacement = mention.second
+                        result = result ?: text
+                        result = result.substring(0, i + shift) + replacement + result.substring(j + shift)
+                        added += replacement.length - (j - i)
+                        mentions.add(mention.first)
                     }
                 }
                 i = j
