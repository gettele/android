From: tangenx <me@tangenx.dev>
Date: Wed, 21 Oct 2026 15:42:20 +0300
Subject: [PATCH] fix: sort the peers by the peer type

---
 .../src/main/java/tele/ui/settings/TelePeersActivity.kt      | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TelePeersActivity.kt b/TMessagesProj/src/main/java/tele/ui/settings/TelePeersActivity.kt
index 387d3c4bc..9fe858fdf 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TelePeersActivity.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TelePeersActivity.kt
@@ -115,6 +115,11 @@ class TelePeersActivity(private val account: Int, private val mode: String) : Ba
 
     /** A person or a bot: the peer of the dialog is a user, not a chat. */
     private fun isUser(dialog: TLRPC.Dialog): Boolean {
+        val peer = dialog.peer
+        if (peer != null) {
+            // the peer of a person carries the user id, the peer of a chat or a channel does not
+            return peer.user_id != 0L
+        }
         val messagesController = AccountInstance.getInstance(account).getMessagesController()
         return messagesController.getUser(dialog.id) != null && messagesController.getChat(dialog.id) == null
     }
