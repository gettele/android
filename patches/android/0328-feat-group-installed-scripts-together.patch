From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: test <test@example.com>
Date: Tue, 10 Nov 2026 03:22:51 +0300
Subject: [PATCH] feat: group installed scripts together

---
 .../java/tele/ui/settings/TeleScriptsActivity.kt  | 15 ++++++++++-----
 1 file changed, 10 insertions(+), 5 deletions(-)

diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleScriptsActivity.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleScriptsActivity.kt
index ea0501a0d..8a52747c4 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TeleScriptsActivity.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleScriptsActivity.kt
@@ -71,23 +71,28 @@ class TeleScriptsActivity @JvmOverloads constructor(private val installUrl: Stri
         if (!tele.scripting.ScriptFolder.isDefault()) {
             items.add(UItem.asButton(ID_DEFAULT_FOLDER, lc("Use the default folder")))
         }
+        items.add(UItem.asShadow(null))
         items.add(UItem.asHeader(lc("Installed")))
         if (scripts.isEmpty()) {
             items.add(UItem.asShadow(lc("No scripts yet. Import a .js, .mjs, .ts or .mts file.")))
         }
         for ((index, script) in scripts.withIndex()) {
-            items.add(
-                UItem.asSwitchNoIcon(ID_SCRIPT + index, script.name)
-                    .setChecked(Scripts.isEnabled(account, script.id))
-            )
             val error = script.error ?: ScriptStore.lastError(account, script.id)
             val status = when {
                 error != null -> lc("Error: ") + error
                 Scripts.isEnabled(account, script.id) -> lc("On · ") + script.id
                 else -> lc("Off · ") + script.id
             }
-            items.add(UItem.asShadow(status))
+            items.add(
+                UItem.asSwitchNoIcon(ID_SCRIPT + index, script.name).apply {
+                    checked = Scripts.isEnabled(account, script.id)
+                    bind = Utilities.Callback { view: View ->
+                        (view as org.telegram.ui.Cells.TextCheckCell2).setTextAndValueAndCheck(script.name, status, checked, true, true)
+                    }
+                }
+            )
         }
+        if (scripts.isNotEmpty()) items.add(UItem.asShadow(null))
     }
 
     private fun click(item: UItem, view: View, position: Int, x: Float, y: Float) {
