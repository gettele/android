@@ -0,0 +1,37 @@
+package tele.ui
+
+import android.content.Context
+import android.graphics.Canvas
+import org.telegram.messenger.ChatMessageSharedResources
+import org.telegram.messenger.MessageObject
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Cells.ChatMessageCell
+
+// a chat cell that can leave parts out of the picture without touching ChatMessageCell
+class ShotCell(
+    context: Context,
+    account: Int,
+    shared: ChatMessageSharedResources,
+    resourcesProvider: Theme.ResourcesProvider?
+) : ChatMessageCell(context, account, false, shared, resourcesProvider) {
+
+    @JvmField
+    var hideNames = false
+
+    @JvmField
+    var hideUserpics = false
+
+    @JvmField
+    var hideInfo = false
+
+    override fun isNeedAuthorName(): Boolean = !hideNames && super.isNeedAuthorName()
+
+    override fun needDrawAvatar(): Boolean = !hideUserpics && super.needDrawAvatar()
+
+    override fun checkNeedDrawShareButton(messageObject: MessageObject?): Boolean = false
+
+    // notime empties the text, but media bubbles still paint an empty time pill
+    override fun drawTime(canvas: Canvas, alpha: Float, fromParent: Boolean) {
+        if (!hideInfo) super.drawTime(canvas, alpha, fromParent)
+    }
+}
