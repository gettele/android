+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleShotActivity.kt
@@ -0,0 +1,419 @@
+package tele.ui.settings
+
+import android.content.ClipData
+import android.content.ClipboardManager
+import android.content.Context
+import android.content.Intent
+import android.graphics.Bitmap
+import android.graphics.drawable.Drawable
+import android.net.Uri
+import android.os.SystemClock
+import android.view.Gravity
+import android.view.View
+import android.view.ViewGroup
+import android.widget.FrameLayout
+import android.widget.LinearLayout
+import android.widget.ScrollView
+import android.widget.TextView
+import androidx.core.content.FileProvider
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.ApplicationLoader
+import org.telegram.messenger.ChatObject
+import org.telegram.messenger.FileLoader
+import org.telegram.messenger.MediaController
+import org.telegram.messenger.MessageObject
+import org.telegram.messenger.R
+import org.telegram.messenger.Utilities
+import org.telegram.ui.ActionBar.ActionBar
+import org.telegram.ui.ActionBar.ActionBarMenuSubItem
+import org.telegram.ui.ActionBar.AlertDialog
+import org.telegram.ui.ActionBar.BaseFragment
+import org.telegram.ui.ActionBar.BottomSheet
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Cells.HeaderCell
+import org.telegram.ui.Cells.TextCheckCell
+import org.telegram.ui.Cells.TextSettingsCell
+import org.telegram.ui.ChatActivity
+import org.telegram.ui.Components.BulletinFactory
+import org.telegram.ui.Components.LayoutHelper
+import org.telegram.ui.Components.SizeNotifierFrameLayout
+import tele.helpers.ShotMessages
+import tele.helpers.ShotOptions
+import tele.helpers.ShotPart
+import tele.ui.ShotCell
+import tele.ui.ShotColumn
+import tele.ui.ShotFlags
+import tele.ui.ShotFrame
+import java.io.File
+import java.io.FileOutputStream
+import java.lang.ref.WeakReference
+import java.text.SimpleDateFormat
+import java.util.Date
+import java.util.Locale
+
+// tele shot (desktop 0089, 0107, 0114): the picture of chat messages with a preview and options
+class TeleShotActivity(origin: ChatActivity, private val source: List<MessageObject>) : BaseFragment() {
+
+    private val originRef = WeakReference(origin)
+    private val account = origin.currentAccount
+    private val themeProvider: Theme.ResourcesProvider? = origin.resourceProvider
+    private val flags = ShotFlags.of(origin)
+    private var options = ShotOptions.load()
+
+    private var frame: ShotFrame? = null
+    private var note: TextView? = null
+    private var scaleCell: TextSettingsCell? = null
+    private var sendItem: ActionBarMenuSubItem? = null
+    private var busy = false
+
+    override fun onFragmentCreate(): Boolean {
+        shotDirectory().listFiles()?.forEach { it.delete() }
+        return super.onFragmentCreate()
+    }
+
+    override fun onFragmentDestroy() {
+        frame?.release()
+        super.onFragmentDestroy()
+    }
+
+    override fun createView(context: Context): View {
+        actionBar.setBackButtonImage(R.drawable.ic_ab_back)
+        actionBar.setTitle("shot")
+        actionBar.setActionBarMenuOnItemClick(object : ActionBar.ActionBarMenuOnItemClick() {
+            override fun onItemClick(id: Int) {
+                when (id) {
+                    -1 -> finishFragment()
+                    MENU_OPTIONS -> showOptions()
+                    MENU_COPY -> copy()
+                    MENU_SAVE -> save()
+                    MENU_SHARE -> share()
+                    MENU_SEND -> send()
+                }
+            }
+        })
+        val menu = actionBar.createMenu()
+        menu.addItem(MENU_OPTIONS, R.drawable.msg_settings)
+        menu.addItem(MENU_COPY, R.drawable.msg_copy)
+        menu.addItem(MENU_SAVE, R.drawable.msg_download)
+        val more = menu.addItem(0, R.drawable.ic_ab_other)
+        more.addSubItem(MENU_SHARE, R.drawable.msg_shareout, "share")
+        sendItem = more.addSubItem(MENU_SEND, R.drawable.msg_send, "send to chat")
+        sendItem?.visibility = if (canSendBack()) View.VISIBLE else View.GONE
+
+        val root = FrameLayout(context)
+        root.setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundGray))
+        fragmentView = root
+
+        val wall = object : SizeNotifierFrameLayout(context) {
+            override fun getNewDrawable(): Drawable? = originRef.get()?.themeDelegate?.wallpaperDrawable ?: super.getNewDrawable()
+
+            override fun getNewDrawableMotion(): Boolean = false
+
+            override fun isActionBarVisible(): Boolean = false
+
+            override fun isStatusBarVisible(): Boolean = false
+        }
+        wall.setBackgroundImage(originRef.get()?.themeDelegate?.wallpaperDrawable ?: Theme.getCachedWallpaperNonBlocking(), false)
+        wall.visibility = View.INVISIBLE
+        root.addView(wall, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.MATCH_PARENT.toFloat()))
+
+        val column = ShotColumn(context, account, themeProvider, flags)
+        val shotFrame = ShotFrame(context, column, wall, themeProvider)
+        shotFrame.options = options
+        shotFrame.scale = options.scale
+        frame = shotFrame
+
+        val holder = FrameLayout(context)
+        holder.addView(shotFrame, FrameLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.WRAP_CONTENT, Gravity.TOP or Gravity.CENTER_HORIZONTAL))
+        val scroll = ScrollView(context)
+        scroll.isVerticalScrollBarEnabled = false
+        scroll.clipToPadding = false
+        scroll.setPadding(0, AndroidUtilities.statusBarHeight + ActionBar.getCurrentActionBarHeight() + AndroidUtilities.dp(8f), 0, AndroidUtilities.dp(56f))
+        scroll.addView(holder, FrameLayout.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT))
+        root.addView(scroll, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.MATCH_PARENT.toFloat()))
+
+        val noteView = TextView(context)
+        noteView.setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText))
+        noteView.setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundGray))
+        noteView.textSize = 13f
+        noteView.gravity = Gravity.CENTER
+        noteView.setPadding(AndroidUtilities.dp(16f), AndroidUtilities.dp(8f), AndroidUtilities.dp(16f), AndroidUtilities.dp(8f))
+        noteView.visibility = View.GONE
+        note = noteView
+        root.addView(noteView, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT, Gravity.BOTTOM))
+
+        actionBar.setAddToContainer(false)
+        root.addView(actionBar, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT.toFloat()))
+
+        shotFrame.viewTreeObserver.addOnGlobalLayoutListener { refreshState() }
+        reload()
+        return root
+    }
+
+    private fun reload() {
+        val shotFrame = frame ?: return
+        shotFrame.column.bind(ShotMessages.build(account, source, options), options)
+        shotFrame.options = options
+    }
+
+    private fun refreshState() {
+        val shotFrame = frame ?: return
+        val column = shotFrame.column
+        val text = if (column.shown in 1 until column.total) "too tall for one picture: only the first ${column.shown} of ${column.total} messages fit." else null
+        note?.text = text
+        note?.visibility = if (text == null) View.GONE else View.VISIBLE
+        scaleCell?.setTextAndValue("scale", scaleLabel(), false)
+    }
+
+    private fun scaleLabel(): String {
+        val shotFrame = frame
+        return "${options.scale}x, ${(shotFrame?.width ?: 0) * options.scale} × ${(shotFrame?.height ?: 0) * options.scale} px"
+    }
+
+    private fun changed(relayout: Boolean) {
+        options.save()
+        frame?.scale = options.scale
+        if (relayout) reload() else frame?.options = options
+        frame?.requestLayout()
+        refreshState()
+    }
+
+    private fun showOptions() {
+        val context = parentActivity ?: return
+        val content = LinearLayout(context)
+        content.orientation = LinearLayout.VERTICAL
+        // keeps the preview visible above the panel
+        val scroll = object : ScrollView(context) {
+            override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
+                val cap = (AndroidUtilities.displaySize.y * SHEET_HEIGHT_RATIO).toInt()
+                super.onMeasure(widthMeasureSpec, MeasureSpec.makeMeasureSpec(cap, MeasureSpec.AT_MOST))
+            }
+        }
+        scroll.addView(content)
+        val sheet = BottomSheet.Builder(context, false).setCustomView(scroll).create()
+
+        fun header(text: String) {
+            val cell = HeaderCell(context)
+            cell.setText(text)
+            content.addView(cell, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT))
+        }
+
+        lateinit var rebuild: () -> Unit
+
+        fun toggle(text: String, checked: Boolean, rebuildRows: Boolean, onChange: (Boolean) -> Unit) {
+            val cell = TextCheckCell(context)
+            cell.setBackground(Theme.createSelectorDrawable(Theme.getColor(Theme.key_listSelector), 2))
+            cell.setTextAndCheck(text, checked, false)
+            cell.setOnClickListener {
+                val value = !cell.isChecked
+                cell.setChecked(value)
+                onChange(value)
+                if (rebuildRows) rebuild()
+            }
+            content.addView(cell, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT))
+        }
+
+        rebuild = {
+            content.removeAllViews()
+            header("messages")
+            if (source.any { it.isOutOwner }) {
+                toggle("my messages as incoming", options.incoming, false) {
+                    options = options.copy(incoming = it)
+                    changed(true)
+                }
+            }
+            toggle("date badges", options.dates, false) {
+                options = options.copy(dates = it)
+                changed(true)
+            }
+            header("show")
+            for ((part, label) in PART_LABELS) {
+                toggle(label, options.shows(part), false) {
+                    options = options.withPart(part, it)
+                    changed(true)
+                }
+            }
+            header("background")
+            toggle("show background", options.background, true) {
+                options = options.copy(background = it)
+                changed(false)
+            }
+            if (!options.background) {
+                toggle("transparent", options.transparent, false) {
+                    options = options.copy(transparent = it)
+                    changed(false)
+                }
+            }
+            header("export")
+            val cell = TextSettingsCell(context)
+            cell.setBackground(Theme.createSelectorDrawable(Theme.getColor(Theme.key_listSelector), 2))
+            cell.setTextAndValue("scale", scaleLabel(), false)
+            cell.setOnClickListener { chooseScale() }
+            scaleCell = cell
+            content.addView(cell, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT))
+        }
+        sheet.setOnDismissListener(android.content.DialogInterface.OnDismissListener { scaleCell = null })
+        rebuild()
+        showDialog(sheet)
+    }
+
+    private fun chooseScale() {
+        val context = parentActivity ?: return
+        val labels = Array<CharSequence>(ShotOptions.MAX_SCALE) { index ->
+            val value = index + 1
+            if (value == options.scale) "${value}x ✓" else "${value}x"
+        }
+        val builder = AlertDialog.Builder(context)
+        builder.setTitle("scale")
+        builder.setItems(labels) { _, which ->
+            options = options.copy(scale = which + 1)
+            changed(false)
+        }
+        showDialog(builder.create())
+    }
+
+    private fun shotDirectory(): File = File(FileLoader.getDirectory(FileLoader.MEDIA_DIR_CACHE), "tele_shots").also { it.mkdirs() }
+
+    private fun imagesReady(): Boolean {
+        val column = frame?.column ?: return true
+        for (i in 0 until column.childCount) {
+            val cell = column.getChildAt(i) as? ShotCell ?: continue
+            if (cell.visibility != View.VISIBLE || cell.messageObject?.isPhoto != true) continue
+            if (cell.photoImage?.hasImageLoaded() != true) return false
+        }
+        return true
+    }
+
+    private fun awaitImages(done: () -> Unit) {
+        val deadline = SystemClock.elapsedRealtime() + IMAGE_WAIT_MS
+        fun check() {
+            if (fragmentView == null) return
+            if (imagesReady() || SystemClock.elapsedRealtime() >= deadline) done() else AndroidUtilities.runOnUIThread({ check() }, 150)
+        }
+        check()
+    }
+
+    private class Rendered(val file: File, val width: Int, val height: Int)
+
+    private fun export(onReady: (Rendered) -> Unit) {
+        if (busy) return
+        val shotFrame = frame ?: return
+        busy = true
+        awaitImages {
+            var scale = options.scale
+            var bitmap: Bitmap? = null
+            while (scale >= 1 && bitmap == null) {
+                bitmap = shotFrame.render(scale)
+                if (bitmap == null) scale--
+            }
+            if (bitmap == null) {
+                busy = false
+                BulletinFactory.of(this).createErrorBulletin("not enough memory for the picture.").show()
+                return@awaitImages
+            }
+            if (scale != options.scale) {
+                BulletinFactory.of(this).createErrorBulletin("not enough memory: saved at ${scale}x.").show()
+            }
+            val rendered = bitmap
+            Utilities.globalQueue.postRunnable {
+                val file = File(shotDirectory(), "shot_" + SimpleDateFormat("yyyyMMdd_HHmmss", Locale.US).format(Date()) + ".png")
+                val ok = runCatching { FileOutputStream(file).use { rendered.compress(Bitmap.CompressFormat.PNG, 100, it) } }.getOrDefault(false)
+                val width = rendered.width
+                val height = rendered.height
+                rendered.recycle()
+                AndroidUtilities.runOnUIThread {
+                    busy = false
+                    if (ok) {
+                        onReady(Rendered(file, width, height))
+                    } else {
+                        BulletinFactory.of(this).createErrorBulletin("couldn't save the shot.").show()
+                    }
+                }
+            }
+        }
+    }
+
+    private fun uriOf(file: File, context: Context): Uri =
+        FileProvider.getUriForFile(context, ApplicationLoader.getApplicationId() + ".provider", file)
+
+    private fun copy() {
+        val context = parentActivity ?: return
+        export { rendered ->
+            val clipboard = context.getSystemService(Context.CLIPBOARD_SERVICE) as ClipboardManager
+            clipboard.setPrimaryClip(ClipData.newUri(context.contentResolver, "shot", uriOf(rendered.file, context)))
+            BulletinFactory.of(this).createCopyBulletin("shot copied to clipboard.").show()
+        }
+    }
+
+    private fun save() {
+        val context = parentActivity ?: return
+        export { rendered ->
+            if (AndroidUtilities.isInternalUri(Uri.fromFile(rendered.file))) {
+                BulletinFactory.of(this).createErrorBulletin("couldn't save the shot.").show()
+            } else {
+                MediaController.saveFile(rendered.file.absolutePath, context, 0, rendered.file.name, "image/png", Utilities.Callback<Uri> {
+                    BulletinFactory.of(this).createDownloadBulletin(BulletinFactory.FileType.PHOTO).show()
+                })
+            }
+        }
+    }
+
+    private fun share() {
+        val context = parentActivity ?: return
+        export { rendered ->
+            val intent = Intent(Intent.ACTION_SEND)
+            intent.type = "image/png"
+            intent.putExtra(Intent.EXTRA_STREAM, uriOf(rendered.file, context))
+            intent.addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
+            context.startActivity(Intent.createChooser(intent, "share"))
+        }
+    }
+
+    private fun canSendBack(): Boolean {
+        val chat = originRef.get() ?: return false
+        if (chat.chatMode != ChatActivity.MODE_DEFAULT || !chat.canSendMessage()) return false
+        val target = chat.currentChat
+        return target == null || ChatObject.canSendPhoto(target)
+    }
+
+    private fun send() {
+        val chat = originRef.get() ?: return
+        if (!canSendBack()) return
+        val shotOptions = options
+        export { rendered ->
+            val forceDocument = (!shotOptions.background && shotOptions.transparent) || !fitsPhoto(rendered.width, rendered.height)
+            val entry = MediaController.PhotoEntry(0, 0, 0, rendered.file.absolutePath, 0, false, rendered.width, rendered.height, rendered.file.length())
+            chat.sendMedia(entry, null, true, 0, 0, forceDocument, 0)
+            finishFragment()
+        }
+    }
+
+    private fun fitsPhoto(width: Int, height: Int): Boolean {
+        val longSide = maxOf(width, height)
+        val shortSide = minOf(width, height)
+        return longSide <= PHOTO_SIDE_LIMIT && shortSide > 0 && longSide.toFloat() / shortSide <= PHOTO_MAX_RATIO
+    }
+
+    companion object {
+        private const val MENU_OPTIONS = 1
+        private const val MENU_COPY = 2
+        private const val MENU_SAVE = 3
+        private const val MENU_SHARE = 4
+        private const val MENU_SEND = 5
+        private const val IMAGE_WAIT_MS = 3000L
+        private const val SHEET_HEIGHT_RATIO = 0.5f
+        private const val PHOTO_SIDE_LIMIT = 2560
+        private const val PHOTO_MAX_RATIO = 20f
+
+        private val PART_LABELS = listOf(
+            ShotPart.NAMES to "names and badges",
+            ShotPart.USERPICS to "userpics",
+            ShotPart.REPLIES to "replies and quotes",
+            ShotPart.FORWARDS to "forwarded from",
+            ShotPart.PREVIEWS to "link previews",
+            ShotPart.BUTTONS to "inline buttons",
+            ShotPart.REACTIONS to "reactions",
+            ShotPart.INFO to "time and read checks"
+        )
+    }
+}
