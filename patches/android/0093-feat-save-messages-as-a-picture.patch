+package tele.ui
+
+import android.content.Context
+import android.graphics.Bitmap
+import android.graphics.Canvas
+import android.graphics.Paint
+import android.graphics.RectF
+import android.view.View
+import android.view.ViewGroup
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.ui.ActionBar.Theme
+import tele.helpers.ShotOptions
+import kotlin.math.min
+
+// crops the column to the picture area, paints the background and renders the export bitmap
+class ShotFrame(
+    context: Context,
+    val column: ShotColumn,
+    private val wall: View,
+    private val resources: Theme.ResourcesProvider?
+) : ViewGroup(context) {
+
+    var options = ShotOptions()
+        set(value) {
+            field = value
+            invalidate()
+        }
+
+    var scale = 1
+        set(value) {
+            if (field != value) {
+                field = value
+                requestLayout()
+            }
+        }
+
+    private var exporting = false
+    private var exportScale = 1
+    private var chunk: Bitmap? = null
+    private var chunkScale = 0
+    private val tilePaint = Paint(Paint.FILTER_BITMAP_FLAG)
+    private val checkerPaint = Paint()
+    private val tileRect = RectF()
+
+    init {
+        setWillNotDraw(false)
+        addView(column, LayoutParams(LayoutParams.WRAP_CONTENT, LayoutParams.WRAP_CONTENT))
+    }
+
+    override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
+        val available = MeasureSpec.getSize(widthMeasureSpec)
+        column.prepare(available, scale)
+        setMeasuredDimension(min(column.cropWidth, available), column.measuredHeight)
+    }
+
+    override fun onLayout(changed: Boolean, l: Int, t: Int, r: Int, b: Int) {
+        column.layout(-column.cropLeft, 0, column.measuredWidth - column.cropLeft, column.measuredHeight)
+    }
+
+    fun invalidateWall() {
+        chunk?.recycle()
+        chunk = null
+        invalidate()
+    }
+
+    fun release() {
+        chunk?.recycle()
+        chunk = null
+    }
+
+    override fun onDraw(canvas: Canvas) {
+        val o = options
+        when {
+            o.background -> paintWall(canvas)
+            !o.transparent -> canvas.drawColor(Theme.getColor(Theme.key_windowBackgroundWhite, resources))
+            !exporting -> paintChecker(canvas)
+        }
+    }
+
+    override fun dispatchDraw(canvas: Canvas) {
+        canvas.save()
+        canvas.clipRect(0, 0, width, height)
+        super.dispatchDraw(canvas)
+        canvas.restore()
+    }
+
+    private fun paintChecker(canvas: Canvas) {
+        val cell = AndroidUtilities.dp(8f)
+        val light = 0xFFFFFFFF.toInt()
+        val dark = 0xFFCCCCCC.toInt()
+        var y = 0
+        var row = 0
+        while (y < height) {
+            var x = 0
+            var col = row
+            while (x < width) {
+                checkerPaint.color = if (col % 2 == 0) light else dark
+                canvas.drawRect(x.toFloat(), y.toFloat(), (x + cell).toFloat(), (y + cell).toFloat(), checkerPaint)
+                x += cell
+                col++
+            }
+            y += cell
+            row++
+        }
+    }
+
+    // one wallpaper screen drawn through the real background view, tiled with every second tile mirrored
+    private fun wallChunk(wanted: Int): Bitmap? {
+        chunk?.let { if (chunkScale >= wanted) return it }
+        if (wall.width <= 0 || wall.height <= 0) return null
+        chunk?.recycle()
+        chunk = null
+        return try {
+            val bitmap = Bitmap.createBitmap(wall.width * wanted, wall.height * wanted, Bitmap.Config.ARGB_8888)
+            val canvas = Canvas(bitmap)
+            canvas.scale(wanted.toFloat(), wanted.toFloat())
+            wall.draw(canvas)
+            chunk = bitmap
+            chunkScale = wanted
+            bitmap
+        } catch (e: OutOfMemoryError) {
+            null
+        }
+    }
+
+    private fun paintWall(canvas: Canvas) {
+        val bitmap = wallChunk(if (exporting) min(exportScale, 2) else 1)
+        if (bitmap == null) {
+            canvas.drawColor(Theme.getColor(Theme.key_windowBackgroundWhite, resources))
+            return
+        }
+        val tileHeight = wall.height
+        tileRect.set(0f, 0f, wall.width.toFloat(), tileHeight.toFloat())
+        var y = 0
+        var index = 0
+        while (y < height) {
+            canvas.save()
+            if (index % 2 == 0) {
+                canvas.translate(-column.cropLeft.toFloat(), y.toFloat())
+            } else {
+                canvas.translate(-column.cropLeft.toFloat(), (y + tileHeight).toFloat())
+                canvas.scale(1f, -1f)
+            }
+            canvas.drawBitmap(bitmap, null, tileRect, tilePaint)
+            canvas.restore()
+            y += tileHeight
+            index++
+        }
+    }
+
+    // null when the bitmap does not fit in memory; the caller drops the scale
+    fun render(scale: Int): Bitmap? {
+        if (width <= 0 || height <= 0) return null
+        val bitmap = try {
+            Bitmap.createBitmap(width * scale, height * scale, Bitmap.Config.ARGB_8888)
+        } catch (e: OutOfMemoryError) {
+            return null
+        }
+        exporting = true
+        exportScale = scale
+        column.setDrawingToBitmap(true)
+        try {
+            val canvas = Canvas(bitmap)
+            canvas.scale(scale.toFloat(), scale.toFloat())
+            draw(canvas)
+        } finally {
+            column.setDrawingToBitmap(false)
+            exporting = false
+        }
+        return bitmap
+    }
+}
