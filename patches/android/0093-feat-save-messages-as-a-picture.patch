diff --git a/TMessagesProj/src/main/java/tele/helpers/ShotMessages.kt b/TMessagesProj/src/main/java/tele/helpers/ShotMessages.kt
new file mode 100644
index 000000000..608666641
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/ShotMessages.kt
@@ -0,0 +1,147 @@
+package tele.helpers
+
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.MessageObject
+import org.telegram.tgnet.TLObject
+import org.telegram.tgnet.TLRPC
+import java.util.Calendar
+
+class ShotEntry(val message: MessageObject, val group: MessageObject.GroupedMessages?)
+
+class ShotMessageObject private constructor(
+    account: Int,
+    message: TLRPC.Message,
+    replyTo: MessageObject?
+) : MessageObject(account, message, replyTo, true, true) {
+
+    // the flag must exist before the field initializer runs: layout is generated inside super()
+    private val incoming = building.get() == true
+
+    override fun isOutOwner(): Boolean = if (building.get() == true || incoming) false else super.isOutOwner()
+
+    companion object {
+        private val building = ThreadLocal<Boolean>()
+
+        fun create(account: Int, message: TLRPC.Message, replyTo: MessageObject?, incoming: Boolean): ShotMessageObject {
+            building.set(incoming)
+            try {
+                return ShotMessageObject(account, message, replyTo)
+            } finally {
+                building.remove()
+            }
+        }
+    }
+}
+
+object ShotMessages {
+
+    // renders deep copies so hidden parts are removed without touching the real chat messages
+    @JvmStatic
+    fun build(account: Int, source: List<MessageObject>, options: ShotOptions): List<ShotEntry> {
+        val groups = HashMap<Long, MessageObject.GroupedMessages>()
+        val result = ArrayList<ShotEntry>()
+        var lastDay = -1
+        var lastGroupId = 0L
+        for (original in source) {
+            val copy = copyOf(original, options)
+            val replyTo = if (options.shows(ShotPart.REPLIES)) original.replyMessageObject else null
+            val message = ShotMessageObject.create(account, copy, replyTo, options.incoming)
+            if (options.hidden and ShotPart.INFO.bit != 0) message.notime = true
+            val groupId = message.groupId
+            val startsEntry = groupId == 0L || groupId != lastGroupId
+            if (options.dates && startsEntry) {
+                val day = dayKey(copy.date)
+                if (day != lastDay) {
+                    lastDay = day
+                    result.add(ShotEntry(dateObject(account, copy.date), null))
+                }
+            }
+            lastGroupId = groupId
+            if (groupId != 0L) {
+                val group = groups.getOrPut(groupId) { MessageObject.GroupedMessages().also { it.groupId = groupId } }
+                group.messages.add(message)
+                result.add(ShotEntry(message, group))
+            } else {
+                result.add(ShotEntry(message, null))
+            }
+        }
+        groups.values.forEach { it.calculate() }
+        return result
+    }
+
+    private fun copyOf(original: MessageObject, options: ShotOptions): TLRPC.Message {
+        val source = original.messageOwner
+        val copy = runCatching { TLObject.deepCopy(source, TLRPC.Message::TLdeserialize) }.getOrNull() ?: source
+        if (copy !== source) {
+            copy.dialog_id = source.dialog_id
+            copy.attachPath = source.attachPath
+            copy.params = source.params
+            copy.stickerVerified = source.stickerVerified
+            copy.isThreadMessage = source.isThreadMessage
+            copy.voiceTranscription = source.voiceTranscription
+            copy.voiceTranscriptionFinal = source.voiceTranscriptionFinal
+            copy.voiceTranscriptionOpen = source.voiceTranscriptionOpen
+            copy.originalLanguage = source.originalLanguage
+            copy.translatedToLanguage = source.translatedToLanguage
+            copy.translatedText = source.translatedText
+            copy.replyStory = source.replyStory
+            copy.replyMessage = source.replyMessage
+            copy.send_state = 0
+        }
+        if (options.incoming) copy.out = false
+        if (!options.shows(ShotPart.REPLIES)) {
+            copy.reply_to = null
+            copy.replyMessage = null
+            copy.replyStory = null
+            copy.flags = copy.flags and TLRPC.MESSAGE_FLAG_REPLY.inv()
+        }
+        if (!options.shows(ShotPart.FORWARDS)) {
+            copy.fwd_from = null
+            copy.flags = copy.flags and TLRPC.MESSAGE_FLAG_FWD.inv()
+        }
+        if (!options.shows(ShotPart.BUTTONS)) {
+            copy.reply_markup = null
+            copy.flags = copy.flags and TLRPC.MESSAGE_FLAG_HAS_MARKUP.inv()
+        }
+        if (!options.shows(ShotPart.REACTIONS)) {
+            copy.reactions = null
+        }
+        if (!options.shows(ShotPart.PREVIEWS) && copy.media is TLRPC.TL_messageMediaWebPage) {
+            copy.media = TLRPC.TL_messageMediaEmpty()
+            copy.flags = copy.flags and TLRPC.MESSAGE_FLAG_HAS_MEDIA.inv()
+        }
+        if (!options.shows(ShotPart.INFO)) {
+            copy.views = 0
+            copy.flags = copy.flags and TLRPC.MESSAGE_FLAG_HAS_VIEWS.inv()
+            copy.edit_date = 0
+            copy.flags = copy.flags and TLRPC.MESSAGE_FLAG_EDITED.inv()
+            copy.post_author = null
+        }
+        return copy
+    }
+
+    private fun dayKey(date: Int): Int {
+        val calendar = Calendar.getInstance()
+        calendar.timeInMillis = date * 1000L
+        return calendar.get(Calendar.YEAR) * 1000 + calendar.get(Calendar.DAY_OF_YEAR)
+    }
+
+    // same shape as ChatActivity.putFilteredDate
+    private fun dateObject(account: Int, date: Int): MessageObject {
+        val message = TLRPC.TL_message()
+        message.message = LocaleController.formatDateChat(date.toLong())
+        message.id = 0
+        val calendar = Calendar.getInstance()
+        calendar.timeInMillis = date * 1000L
+        calendar.set(Calendar.HOUR_OF_DAY, 0)
+        calendar.set(Calendar.MINUTE, 0)
+        calendar.set(Calendar.SECOND, 0)
+        calendar.set(Calendar.MILLISECOND, 0)
+        message.date = (calendar.timeInMillis / 1000).toInt()
+        val result = MessageObject(account, message, false, false)
+        result.type = 10
+        result.contentType = 1
+        result.isDateObject = true
+        return result
+    }
+}
diff --git a/TMessagesProj/src/main/java/tele/helpers/TeleShot.kt b/TMessagesProj/src/main/java/tele/helpers/TeleShot.kt
new file mode 100644
index 000000000..5e553eaaf
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/TeleShot.kt
@@ -0,0 +1,194 @@
+package tele.helpers
+
+import android.view.View
+import org.json.JSONObject
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.FileLoader
+import org.telegram.messenger.ImageLocation
+import org.telegram.messenger.MessageObject
+import org.telegram.messenger.MessagesController
+import org.telegram.messenger.NotificationCenter
+import org.telegram.messenger.R
+import org.telegram.ui.ActionBar.ActionBarMenu
+import org.telegram.ui.ActionBar.AlertDialog
+import org.telegram.ui.ChatActivity
+import tele.TeleConfig
+import tele.ui.settings.TeleShotActivity
+
+object TeleShot {
+
+    private const val MAX_WAIT_MS = 15_000L
+
+    @JvmStatic
+    fun enabled(): Boolean = TeleConfig.SHOT.value
+
+    @JvmStatic
+    fun fillMenu(
+        chat: ChatActivity,
+        message: MessageObject,
+        group: MessageObject.GroupedMessages?,
+        items: ArrayList<CharSequence>,
+        icons: ArrayList<Int>,
+        options: ArrayList<Int>
+    ) {
+        if (!enabled() || !allowed(chat, expand(chat, listOf(message), group))) return
+        val at = options.indexOf(ChatActivity.OPTION_DELETE).let { if (it >= 0) it else options.size }
+        items.add(at, "shot")
+        icons.add(at, R.drawable.msg_gallery)
+        options.add(at, ChatActivity.tele_option_shot)
+    }
+
+    @JvmStatic
+    fun addActionItem(menu: ActionBarMenu, id: Int): View? {
+        if (!enabled()) return null
+        return menu.addItemWithWidth(id, R.drawable.msg_gallery, AndroidUtilities.dp(48f), "shot")
+    }
+
+    @JvmStatic
+    fun updateActionItem(chat: ChatActivity, item: View?, selected: List<MessageObject>) {
+        if (item == null) return
+        val visible = enabled() && selected.isNotEmpty() && allowed(chat, expand(chat, selected, null))
+        item.visibility = if (visible) View.VISIBLE else View.GONE
+    }
+
+    @JvmStatic
+    fun open(chat: ChatActivity, selected: List<MessageObject>, group: MessageObject.GroupedMessages?) {
+        if (!enabled()) return
+        val messages = expand(chat, selected, group)
+        if (messages.isEmpty() || !allowed(chat, messages)) return
+        val context = chat.parentActivity ?: return
+        val screen = {
+            chat.presentFragment(TeleShotActivity(chat, messages))
+            Unit
+        }
+        preload(chat, messages, context, screen)
+    }
+
+    // an album always travels whole, even when only one of its photos was selected
+    private fun expand(chat: ChatActivity, selected: List<MessageObject>, group: MessageObject.GroupedMessages?): List<MessageObject> {
+        val all = ArrayList<MessageObject>(selected)
+        if (group != null) all.addAll(group.messages)
+        selected.forEach { message -> chat.getValidGroupedMessage(message)?.let { all.addAll(it.messages) } }
+        return all.asSequence()
+            .filter { it.messageOwner != null && !it.isSponsored }
+            .distinctBy { it.id }
+            .sortedWith(compareBy({ it.messageOwner.date }, { it.id }))
+            .toList()
+    }
+
+    // stock predicates on purpose: the "forward protected messages as copies" toggle must not unlock shots
+    private fun allowed(chat: ChatActivity, messages: List<MessageObject>): Boolean {
+        if (messages.isEmpty()) return false
+        val mode = chat.chatMode
+        if (mode != ChatActivity.MODE_DEFAULT && mode != ChatActivity.MODE_SAVED) return false
+        if (chat.isReport || chat.isSecretChat) return false
+        val controller = MessagesController.getInstance(chat.currentAccount)
+        return messages.all {
+            !it.isSponsored && !it.isEphemeral && !it.isQuickReply && !it.isWelcomeMessage &&
+                it.id > 0 && !it.scheduled && !it.messageOwner.noforwards && !controller.isPeerNoForwards(it.dialogId)
+        }
+    }
+
+    // a cell picks its download state at bind time, so photos must be on disk before the screen builds them
+    private fun preload(chat: ChatActivity, messages: List<MessageObject>, context: android.content.Context, done: () -> Unit) {
+        val account = chat.currentAccount
+        val loader = FileLoader.getInstance(account)
+        val pending = HashSet<String>()
+        for (message in messages) {
+            if (!message.isPhoto || message.photoThumbs == null) continue
+            val size = FileLoader.getClosestPhotoSizeWithSize(message.photoThumbs, AndroidUtilities.getPhotoSize()) ?: continue
+            if (loader.getPathToMessage(message.messageOwner).exists()) continue
+            pending.add(FileLoader.getAttachFileName(size))
+            loader.loadFile(ImageLocation.getForObject(size, message.photoThumbsObject), message, null, FileLoader.PRIORITY_NORMAL, 0)
+        }
+        if (pending.isEmpty()) {
+            done()
+            return
+        }
+
+        val dialog = AlertDialog(context, AlertDialog.ALERT_TYPE_SPINNER)
+        var finished = false
+        lateinit var observer: NotificationCenter.NotificationCenterDelegate
+        fun finish(proceed: Boolean) {
+            if (finished) return
+            finished = true
+            NotificationCenter.getInstance(account).removeObserver(observer, NotificationCenter.fileLoaded)
+            NotificationCenter.getInstance(account).removeObserver(observer, NotificationCenter.fileLoadFailed)
+            runCatching { dialog.dismiss() }
+            if (proceed) done()
+        }
+        val timeout = Runnable { finish(true) }
+        observer = NotificationCenter.NotificationCenterDelegate { id, _, args ->
+            if (id == NotificationCenter.fileLoaded || id == NotificationCenter.fileLoadFailed) {
+                pending.remove(args.getOrNull(0) as? String)
+                if (pending.isEmpty()) {
+                    AndroidUtilities.cancelRunOnUIThread(timeout)
+                    AndroidUtilities.runOnUIThread { finish(true) }
+                }
+            }
+        }
+        NotificationCenter.getInstance(account).addObserver(observer, NotificationCenter.fileLoaded)
+        NotificationCenter.getInstance(account).addObserver(observer, NotificationCenter.fileLoadFailed)
+        dialog.setCanceledOnTouchOutside(false)
+        dialog.setOnCancelListener {
+            AndroidUtilities.cancelRunOnUIThread(timeout)
+            finish(false)
+        }
+        dialog.show()
+        AndroidUtilities.runOnUIThread(timeout, MAX_WAIT_MS)
+    }
+}
+
+enum class ShotPart(val bit: Int) {
+    NAMES(1), USERPICS(2), REPLIES(4), FORWARDS(8), PREVIEWS(16), BUTTONS(32), REACTIONS(64), INFO(128);
+
+    val key: String
+        get() = name.lowercase()
+}
+
+// hidden is a bitmask of ShotPart bits that are NOT drawn; "incoming" is never persisted
+data class ShotOptions(
+    val background: Boolean = true,
+    val dates: Boolean = false,
+    val transparent: Boolean = false,
+    val incoming: Boolean = false,
+    val hidden: Int = ShotPart.INFO.bit,
+    val scale: Int = 1
+) {
+    fun shows(part: ShotPart): Boolean = hidden and part.bit == 0
+
+    fun withPart(part: ShotPart, shown: Boolean): ShotOptions =
+        copy(hidden = if (shown) hidden and part.bit.inv() else hidden or part.bit)
+
+    fun save() {
+        val json = JSONObject()
+        json.put("background", background)
+        json.put("dates", dates)
+        json.put("transparent", transparent)
+        ShotPart.values().forEach { json.put(it.key, shows(it)) }
+        json.put("scale", scale.coerceIn(1, MAX_SCALE))
+        TeleConfig.set(TeleConfig.SHOT_VIEW, json.toString())
+    }
+
+    companion object {
+        const val MAX_SCALE = 4
+
+        @JvmStatic
+        fun load(): ShotOptions {
+            val raw = TeleConfig.SHOT_VIEW.value
+            val defaults = ShotOptions()
+            if (raw.isEmpty()) return defaults
+            val json = runCatching { JSONObject(raw) }.getOrNull() ?: return defaults
+            var result = defaults.copy(
+                background = json.optBoolean("background", defaults.background),
+                dates = json.optBoolean("dates", defaults.dates),
+                transparent = json.optBoolean("transparent", defaults.transparent),
+                scale = json.optInt("scale", defaults.scale).coerceIn(1, MAX_SCALE)
+            )
+            ShotPart.values().forEach { part ->
+                result = result.withPart(part, json.optBoolean(part.key, defaults.shows(part)))
+            }
+            return result
+        }
+    }
+}
