+import kotlin.math.max
+import kotlin.math.min
+
+// what the origin chat tells its cells; mirrors the formulas in ChatActivity's adapter
+class ShotFlags(
+    val isChat: Boolean,
+    val isBot: Boolean,
+    val isBotForum: Boolean,
+    val isMegagroup: Boolean,
+    val isForum: Boolean,
+    val isMonoForum: Boolean,
+    val isSavedChat: Boolean,
+    val isRepliesChat: Boolean,
+    val hasDiscussion: Boolean,
+    val senderIsChat: Boolean,
+    val senderIsSelfOrReplies: Boolean
+) {
+    companion object {
+        fun of(chat: ChatActivity): ShotFlags {
+            val currentChat = chat.currentChat
+            val user = chat.currentUser
+            val self = UserObject.isUserSelf(user)
+            val replies = UserObject.isReplyUser(user)
+            val megagroup = ChatObject.isChannel(currentChat) && currentChat.megagroup
+            return ShotFlags(
+                isChat = currentChat != null || self || replies,
+                isBot = user != null && user.bot,
+                isBotForum = UserObject.isBotForum(user),
+                isMegagroup = megagroup,
+                isForum = ChatObject.isForum(currentChat),
+                isMonoForum = ChatObject.isMonoForum(currentChat),
+                isSavedChat = chat.chatMode == ChatActivity.MODE_SAVED,
+                isRepliesChat = replies,
+                hasDiscussion = ChatObject.isChannel(currentChat) && currentChat.has_link && !megagroup,
+                senderIsChat = currentChat != null,
+                senderIsSelfOrReplies = self || replies
+            )
+        }
+    }
+}
+
+// attached, laid-out cells that are both the preview and the export source
+class ShotColumn(
+    context: Context,
+    private val account: Int,
+    private val resources: Theme.ResourcesProvider?,
+    private val flags: ShotFlags
+) : ViewGroup(context) {
+
+    private val shared = ChatMessageSharedResources(context)
+    private val padding = AndroidUtilities.dp(PADDING_DP)
+    private val sidePadding = AndroidUtilities.dp(SIDE_PADDING_DP)
+
+    private var pending: Pair<List<ShotEntry>, ShotOptions>? = null
+    private var units: List<IntArray> = emptyList()
+    private var spans = IntArray(0)
+    private var tops = IntArray(0)
+    private var lefts = IntArray(0)
+    private var groups: List<MessageObject.GroupedMessages?> = emptyList()
+    private var groupPositions: List<MessageObject.GroupedMessagePosition?> = emptyList()
+    private val messageCells = ArrayList<ChatMessageCell>()
+
+    var cropLeft = 0
+        private set
+    var cropRight = 0
+        private set
+    var total = 0
+        private set
+    var shown = 0
+        private set
+
+    val cropWidth: Int get() = cropRight - cropLeft
+
+    private val delegate = object : ChatMessageCell.ChatMessageCellDelegate {
+        override fun canPerformActions(): Boolean = false
+    }
+
+    private val afterTime = ArrayList<ChatMessageCell>()
+    private val afterNames = ArrayList<ChatMessageCell>()
+    private val afterCaption = ArrayList<ChatMessageCell>()
+    private val afterReactions = ArrayList<ChatMessageCell>()
+
+    init {
+        setPadding(0, padding, 0, padding)
+        setWillNotDraw(true)
+    }
+
+    fun bind(entries: List<ShotEntry>, options: ShotOptions) {
+        pending = entries to options
+        if (isAttachedToWindow) applyPending()
+    }
+
+    override fun onAttachedToWindow() {
+        super.onAttachedToWindow()
+        applyPending()
+    }
+
+    // touches go to the scroll view: the picture is not interactive
+    override fun dispatchTouchEvent(ev: android.view.MotionEvent?): Boolean = false
+
+    fun setDrawingToBitmap(value: Boolean) {
+        messageCells.forEach { it.drawingToBitmap = value }
+    }
+
+    private fun applyPending() {
+        val (entries, options) = pending ?: return
+        pending = null
+        removeAllViews()
+        messageCells.clear()
+        total = entries.size
+        groups = entries.map { it.group }
+        groupPositions = entries.map { it.group?.getPosition(it.message) }
+        spans = IntArray(entries.size) { groupPositions[it]?.spanSize ?: SPAN_COUNT }
+        val unitList = ArrayList<IntArray>()
+        var unitStart = 0
+        entries.forEachIndexed { index, entry ->
+            val isNewUnit = index == 0 || entry.group == null || entries[index - 1].group !== entry.group
+            if (isNewUnit && index > 0) {
+                unitList.add(intArrayOf(unitStart, index))
+                unitStart = index
+            }
+        }
+        if (entries.isNotEmpty()) unitList.add(intArrayOf(unitStart, entries.size))
+        units = unitList
+
+        entries.forEachIndexed { index, entry ->
+            val message = entry.message
+            if (message.isDateObject || message.contentType == 1) {
+                val cell = ChatActionCell(context, false, resources)
+                addView(cell, ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT))
+                cell.setMessageObject(message)
+            } else {
+                val cell = ShotCell(context, account, shared, resources)
+                cell.setDelegate(delegate)
+                cell.isChat = flags.isChat
+                cell.isBot = flags.isBot
+                cell.isBotForum = flags.isBotForum
+                cell.isMegagroup = flags.isMegagroup
+                cell.isForum = flags.isForum
+                cell.isMonoForum = flags.isMonoForum
+                cell.isSavedChat = flags.isSavedChat
+                cell.isRepliesChat = flags.isRepliesChat
+                cell.hasDiscussion = flags.hasDiscussion
+                cell.hideNames = !options.shows(ShotPart.NAMES)
+                cell.hideUserpics = !options.shows(ShotPart.USERPICS)
+                cell.hideInfo = !options.shows(ShotPart.INFO)
+                addView(cell, ViewGroup.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT))
+                val (pinnedTop, pinnedBottom) = pinned(entries, index)
+                cell.setMessageObject(message, entry.group, pinnedBottom, pinnedTop, false, false)
+                messageCells.add(cell)
+            }
+        }
+        requestLayout()
+        invalidate()
+    }
+
+    private fun pinned(entries: List<ShotEntry>, index: Int): Pair<Boolean, Boolean> {
+        val entry = entries[index]
+        val group = entry.group
+        val position = group?.getPosition(entry.message)
+        var pinnedTop: Boolean
+        var pinnedBottom: Boolean
+        if (group != null && position != null && !group.isDocuments) {
+            val first = position.flags and MessageObject.POSITION_FLAG_TOP != 0
+            val last = position.flags and MessageObject.POSITION_FLAG_BOTTOM != 0
+            pinnedTop = if (first) packs(outside(entries, index, -1), entry.message) else true
+            pinnedBottom = if (last) packs(entry.message, outside(entries, index, 1)) else true
+        } else {
+            pinnedTop = packs(entries.getOrNull(index - 1)?.message, entry.message)
+            pinnedBottom = packs(entry.message, entries.getOrNull(index + 1)?.message)
+        }
+        return pinnedTop to pinnedBottom
+    }
+
+    private fun outside(entries: List<ShotEntry>, index: Int, step: Int): MessageObject? {
+        val group = entries[index].group
+        var i = index + step
+        while (group != null && entries.getOrNull(i)?.group === group) i += step
+        return entries.getOrNull(i)?.message
+    }
+
+    // upper is the older bubble; same rules as the adapter's pinnedTop/pinnedBottom
+    private fun packs(upper: MessageObject?, lower: MessageObject?): Boolean {
+        if (upper == null || lower == null) return false
+        if (upper.isDateObject || lower.isDateObject || upper.contentType == 1 || lower.contentType == 1) return false
+        if (upper.messageOwner.reply_markup is TLRPC.TL_replyInlineMarkup) return false
+        if (upper.isOutOwner != lower.isOutOwner) return false
+        if (abs(upper.messageOwner.date - lower.messageOwner.date) > 5 * 60) return false
+        if (upper.messageOwner.paid_message_stars > 0 || lower.messageOwner.paid_message_stars > 0) return false
+        return when {
+            flags.senderIsChat -> upper.fromChatId == lower.fromChatId && !(upper.fromChatId < 0 && flags.isMegagroup)
+            flags.senderIsSelfOrReplies -> !upper.isPrivateForward && !lower.isPrivateForward && upper.senderId == lower.senderId
+            else -> true
+        }
+    }
+
+    // measures at the given width, then crops and truncates; the frame calls this from onMeasure
+    fun prepare(width: Int, scale: Int) {
+        for (i in 0 until childCount) getChildAt(i).visibility = View.VISIBLE
+        measureAndLayout(width)
+        computeCrop(width)
+        truncate(width, scale)
+        shown = if (childCount == 0) 0 else visibleEntryCount()
+    }
+
+    private fun measureAndLayout(width: Int) {
+        measure(MeasureSpec.makeMeasureSpec(width, MeasureSpec.EXACTLY), MeasureSpec.makeMeasureSpec(0, MeasureSpec.UNSPECIFIED))
+        layout(0, 0, measuredWidth, measuredHeight)
+    }
+
+    // album cells of one row sit side by side, like the chat list's 1000-span grid
+    override fun onMeasure(widthMeasureSpec: Int, heightMeasureSpec: Int) {
+        val width = MeasureSpec.getSize(widthMeasureSpec)
+        val count = childCount
+        if (tops.size != count) {
+            tops = IntArray(count)
+            lefts = IntArray(count)
+        }
+        var y = paddingTop
+        var i = 0
+        while (i < count) {
+            var span = 0
+            var rowHeight = 0
+            var j = i
+            while (j < count) {
+                val child = getChildAt(j)
+                if (child.visibility == View.GONE) {
+                    j++
+                    continue
+                }
+                val size = spans.getOrElse(j) { SPAN_COUNT }
+                if (span > 0 && span + size > SPAN_COUNT) break
+                val left = width * span / SPAN_COUNT
+                val right = width * (span + size) / SPAN_COUNT
+                child.measure(MeasureSpec.makeMeasureSpec(right - left, MeasureSpec.EXACTLY), MeasureSpec.makeMeasureSpec(0, MeasureSpec.UNSPECIFIED))
+                lefts[j] = left
+                tops[j] = y
+                rowHeight = max(rowHeight, child.measuredHeight - siblingOverlap(j, child))
+                span += size
+                j++
+            }
+            y += rowHeight
+            i = j
+        }
+        setMeasuredDimension(width, y + paddingBottom)
+    }
+
+    override fun onLayout(changed: Boolean, l: Int, t: Int, r: Int, b: Int) {
+        for (i in 0 until childCount) {
+            val child = getChildAt(i)
+            if (child.visibility == View.GONE) continue
+            child.layout(lefts[i], tops[i], lefts[i] + child.measuredWidth, tops[i] + child.measuredHeight)
+        }
+    }
+
+    // same math as the chat list's item decoration: a tall album cell next to stacked ones overlaps the rows below
+    private fun siblingOverlap(index: Int, child: View): Int {
+        val cell = child as? ShotCell ?: return 0
+        val position = groupPositions.getOrNull(index) ?: return 0
+        val heights = position.siblingHeights ?: return 0
+        val group = groups.getOrNull(index) ?: return 0
+        val maxHeight = max(AndroidUtilities.displaySize.x, AndroidUtilities.displaySize.y) * 0.5f
+        var h = cell.extraInsetHeight
+        for (height in heights) h += Math.ceil((maxHeight * height).toDouble()).toInt()
+        h += (position.maxY - position.minY) * Math.round(7 * AndroidUtilities.density)
+        for (other in group.posArray) {
+            if (other.minY != position.minY || other.minX == position.minX && other.maxX == position.maxX && other.minY == position.minY && other.maxY == position.maxY) continue
+            h -= Math.ceil((maxHeight * other.ph).toDouble()).toInt() - AndroidUtilities.dp(4f)
+            break
+        }
+        return h
+    }
+
+    private fun visibleEntryCount(): Int {
+        var count = 0
+        for (i in 0 until childCount) if (getChildAt(i).visibility == View.VISIBLE) count++
+        return count
+    }
+
+    private fun computeCrop(width: Int) {
+        var left = width
+        var right = 0
+        var actionWidth = 0
+        for (i in 0 until childCount) {
+            val child = getChildAt(i)
+            when (child) {
+                is ChatMessageCell -> {
+                    left = min(left, child.left + child.boundsLeft)
+                    right = max(right, child.left + child.boundsRight)
+                }
+                is ChatActionCell -> actionWidth = max(actionWidth, child.boundsRight - child.boundsLeft)
+            }
+        }
+        if (right <= left) {
+            val half = (actionWidth + 2 * sidePadding) / 2
+            left = width / 2 - half
+            right = width / 2 + half
+        } else {
+            left -= sidePadding
+            right += sidePadding
+            val need = actionWidth + 2 * sidePadding
+            if (right - left < need) {
+                val center = (left + right) / 2
+                left = center - need / 2
+                right = left + need
+            }
+        }
+        cropLeft = max(0, left)
+        cropRight = min(width, max(right, cropLeft + 1))
+        val shift = ((cropLeft + cropRight) / 2 - width / 2).toFloat()
+        for (i in 0 until childCount) {
+            val child = getChildAt(i)
+            if (child is ChatActionCell) child.translationX = shift
+        }
+    }
+
+    private fun truncate(width: Int, scale: Int) {
+        val perPixelBudget = MAX_PIXELS / max(1, cropWidth * scale)
+        val limit = min(MAX_SIDE, perPixelBudget) / scale
+        var keep = units.size
+        for (u in units.indices) {
+            val lastChild = getChildAt(units[u][1] - 1) ?: continue
+            if (lastChild.bottom + padding > limit && u > 0) {
+                keep = u
+                break
+            }
+        }
+        if (keep == units.size) return
+        val firstHidden = units[keep][0]
+        for (i in firstHidden until childCount) getChildAt(i).visibility = View.GONE
+        measureAndLayout(width)
+    }
+
+    override fun dispatchDraw(canvas: Canvas) {
+        val screenHeight = AndroidUtilities.displaySize.y
+        for (cell in messageCells) cell.setParentViewSize(width, screenHeight)
+        drawGroupBackgrounds(canvas)
+        super.dispatchDraw(canvas)
+        drawAfter(canvas)
+    }
+
+    // the list draws album bubbles itself, not the cells (same passes as ChatActivity's list)
+    private fun drawGroupBackgrounds(canvas: Canvas) {
+        val drawn = HashSet<MessageObject.GroupedMessages>()
+        for (i in 0 until childCount) {
+            val cell = getChildAt(i) as? ChatMessageCell ?: continue
+            val group = cell.currentMessagesGroup ?: continue
+            if (cell.visibility != View.VISIBLE || group.messages.size == 1 || !drawn.add(group)) continue
+            var l = 0
+            var t = 0
+            var r = 0
+            var b = 0
+            var top: ChatMessageCell? = null
+            for (j in 0 until childCount) {
+                val member = getChildAt(j) as? ChatMessageCell ?: continue
+                val position = member.currentPosition
+                if (member.currentMessagesGroup !== group || member.visibility != View.VISIBLE || position == null) continue
+                var memberTop = member.top + member.paddingTop + member.backgroundDrawableTop
+                var memberBottom = member.top + member.paddingTop + member.backgroundDrawableBottom
+                if (position.flags and MessageObject.POSITION_FLAG_TOP == 0) memberTop -= AndroidUtilities.dp(10f)
+                if (position.flags and MessageObject.POSITION_FLAG_BOTTOM == 0) memberBottom += AndroidUtilities.dp(10f)
+                val memberLeft = member.left + member.backgroundDrawableLeft
+                val memberRight = member.left + member.backgroundDrawableRight
+                if (top == null) {
+                    top = member
+                    l = memberLeft
+                    t = memberTop
+                    r = memberRight
+                    b = memberBottom
+                } else {
+                    l = min(l, memberLeft)
+                    t = min(t, memberTop)
+                    r = max(r, memberRight)
+                    b = max(b, memberBottom)
+                }
+            }
+            val owner = top ?: continue
+            owner.drawBackground(canvas, l, t, r, b, owner.isPinnedTop, owner.isPinnedBottom, false, 0)
+        }
+    }
+
+    override fun drawChild(canvas: Canvas, child: View, drawingTime: Long): Boolean {
+        val result = super.drawChild(canvas, child, drawingTime)
+        if (child is ChatMessageCell) {
+            if (child.hasOutboundsContent()) {
+                canvas.save()
+                canvas.translate(child.x, child.y + child.paddingTop)
+                child.drawOutboundsContent(canvas)
+                canvas.restore()
+            }
+            collectAfter(child)
+            drawAvatar(canvas, child)
+        } else if (child is ChatActionCell) {
+            canvas.save()
+            canvas.translate(child.x, child.y)
+            child.drawOutboundsContent(canvas)
+            canvas.restore()
+        }
+        return result
+    }
+
+    // conditions copied from ChatActivity's list drawChild
+    private fun collectAfter(cell: ChatMessageCell) {
+        val position = cell.currentPosition ?: return
+        if (position.last || position.minX.toInt() == 0 && position.minY.toInt() == 0) {
+            if (position.last) afterTime.add(cell)
+            if (position.minX.toInt() == 0 && position.minY.toInt() == 0 && cell.hasNameLayout()) afterNames.add(cell)
+        }
+        if (position.flags and cell.captionFlag() != 0) afterCaption.add(cell)
+        if (position.flags and MessageObject.POSITION_FLAG_BOTTOM != 0 && position.flags and MessageObject.POSITION_FLAG_LEFT != 0) {
+            afterReactions.add(cell)
+        }
+    }
+
+    private fun drawAfter(canvas: Canvas) {
+        for (cell in afterTime) {
+            canvas.save()
+            canvas.translate(cell.left.toFloat(), cell.y)
+            cell.drawTime(canvas, 1f, true)
+            canvas.restore()
+        }
+        for (cell in afterNames) {
+            canvas.save()
+            canvas.translate(cell.left.toFloat(), cell.y)
+            cell.setInvalidatesParent(true)
+            cell.drawNamesLayout(canvas, 1f)
+            cell.setInvalidatesParent(false)
+            canvas.restore()
+        }
+        for (cell in afterCaption) {
+            if (!cell.transitionParams.wasDraw) continue
+            val selectionOnly = cell.currentPosition != null && cell.currentPosition.flags and MessageObject.POSITION_FLAG_LEFT == 0
+            canvas.save()
+            canvas.translate(cell.left.toFloat(), cell.y)
+            cell.setInvalidatesParent(true)
+            cell.drawCaptionLayout(canvas, selectionOnly, 1f)
+            cell.setInvalidatesParent(false)
+            canvas.restore()
+        }
+        for (cell in afterReactions) {
+            if (!cell.transitionParams.wasDraw) continue
+            canvas.save()
+            canvas.translate(cell.left.toFloat(), cell.y)
+            cell.setInvalidatesParent(true)
+            cell.drawReactionsLayout(canvas, 1f, null)
+            cell.drawCommentLayout(canvas, 1f)
+            cell.setInvalidatesParent(false)
+            canvas.restore()
+        }
+        afterTime.clear()
+        afterNames.clear()
+        afterCaption.clear()
+        afterReactions.clear()
+    }
+
+    // userpic sits at the bottom of the run, same clamps as the list
+    private fun drawAvatar(canvas: Canvas, cell: ChatMessageCell) {
+        val avatar = cell.avatarImage ?: return
+        if (cell.drawPinnedBottom()) {
+            avatar.setVisible(false, false)
+            return
+        }
+        var runTop = cell.top + cell.paddingTop
+        var current = cell
+        var index = indexOfChild(cell)
+        while (current.drawPinnedTop() && index > 0) {
+            val above = getChildAt(index - 1) as? ChatMessageCell ?: break
+            index--
+            current = above
+            runTop = above.top + above.paddingTop
+        }
+        var y = cell.y.toInt() + cell.paddingTop + cell.layoutHeight
+        if (y - AndroidUtilities.dp(48f) < runTop) y = runTop + AndroidUtilities.dp(48f)
+        if (y > cell.bottom) y = cell.bottom
+        avatar.setImageY((y - AndroidUtilities.dp(44f)).toFloat())
+        avatar.setAlpha(1f)
+        avatar.setVisible(true, false)
+        avatar.draw(canvas)
+    }
+
+    companion object {
+        private const val SPAN_COUNT = 1000
+        private const val PADDING_DP = 4f
+        private const val SIDE_PADDING_DP = 8f
+        private const val MAX_SIDE = 16000
+        private const val MAX_PIXELS = 16 * 1024 * 1024
+    }
+}
