new file mode 100644
index 000000000..bdcadecd7
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/ChatsTabDoubleTap.kt
@@ -0,0 +1,20 @@
+package tele.helpers
+
+import android.os.SystemClock
+import android.view.ViewConfiguration
+import org.telegram.ui.DialogsActivity
+import java.lang.ref.WeakReference
+
+object ChatsTabDoubleTap {
+    private var lastTapAt = 0L
+    private var lastDialogs: WeakReference<DialogsActivity>? = null
+
+    @JvmStatic
+    fun onReselect(dialogs: DialogsActivity): Boolean {
+        val now = SystemClock.uptimeMillis()
+        val doubleTap = lastDialogs?.get() === dialogs && now - lastTapAt <= ViewConfiguration.getDoubleTapTimeout()
+        lastDialogs = WeakReference(dialogs)
+        lastTapAt = if (doubleTap) 0L else now
+        return doubleTap && dialogs.tele_switchToAllChatsFolder()
+    }
+}
