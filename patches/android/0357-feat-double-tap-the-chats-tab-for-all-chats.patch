+    public void tele_selectFolder(int index) {
+        FilterTabsView.Tab tab = filterTabsView.getTab(index);
+        if (tab == null) return;
+        if (fragmentSearchField != null && fragmentSearchFieldWatcher != null && fragmentSearchFieldWatcher.isSearchExpanded()) {
+            fragmentSearchField.editText.getText().clear();
+            AndroidUtilities.hideKeyboard(fragmentSearchField.editText);
+            fragmentSearchField.editText.clearFocus();
+            if (fragmentSearchFieldWatcher.isSearchExpanded() && !fragmentSearchFieldWatcher.toggleSearch(false)) {
+                return;
+            }
+        }
+        if (rightSlidingDialogContainer != null && rightSlidingDialogContainer.hasFragment()) {
+            if (!rightSlidingDialogContainer.isOpenned) {
+                return;
+            }
+            rightSlidingDialogContainer.finishPreview();
+        }
+        if (viewPages[0].selectedType == tab.id) {
+            scrollToTop(true, false);
+        } else {
+            filterTabsView.scrollToTab(tab, index);
+        }
+    }
+
+    public boolean tele_switchToAllChatsFolder() {
+        if (filterTabsView == null || !canShowFilterTabsView || searchIsShowed || inPreviewMode) {
+            return false;
+        }
+        int index = 0;
+        if (!tele.TeleConfig.HIDE_ALL_CHATS_FOLDER.getValue()) {
+            ArrayList<MessagesController.DialogFilter> filters = getMessagesController().getDialogFilters();
+            for (int i = 0; i < filters.size(); i++) {
+                if (filters.get(i).isDefault()) {
+                    index = i;
+                    break;
+                }
+            }
+        }
+        FilterTabsView.Tab tab = filterTabsView.getTab(index);
+        if (tab == null || viewPages[0].selectedType == tab.id) {
+            return false;
+        }
+        tele_selectFolder(index);
+        return true;
+    }
+
     public void switchToCurrentSelectedMode(boolean animated) {
