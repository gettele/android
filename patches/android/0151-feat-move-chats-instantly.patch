From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Sat, 24 Oct 2026 03:46:41 +0300
Subject: [PATCH 151/151] feat: move chats instantly

---
 .../java/org/telegram/ui/Components/DialogsItemAnimator.java    | 2 +-
 TMessagesProj/src/main/java/tele/TeleConfig.kt                  | 2 ++
 TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt      | 1 +
 .../src/main/java/tele/ui/settings/TeleSettingsActivity.kt      | 2 ++
 4 files changed, 6 insertions(+), 1 deletion(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Components/DialogsItemAnimator.java b/TMessagesProj/src/main/java/org/telegram/ui/Components/DialogsItemAnimator.java
index b9b6f0ed0..b3c4a11f2 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Components/DialogsItemAnimator.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Components/DialogsItemAnimator.java
@@ -324,7 +324,7 @@ public class DialogsItemAnimator extends SimpleItemAnimator {
         resetAnimation(holder);
         int deltaX = toX - fromX;
         int deltaY = toY - fromY;
-        if (deltaX == 0 && deltaY == 0) {
+        if (deltaX == 0 && deltaY == 0 || tele.TeleConfig.INSTANT_CHAT_MOVE.getValue()) {
             dispatchMoveFinished(holder);
             return false;
         }
diff --git a/TMessagesProj/src/main/java/tele/TeleConfig.kt b/TMessagesProj/src/main/java/tele/TeleConfig.kt
index ade75c155..e16b2ac5b 100644
--- a/TMessagesProj/src/main/java/tele/TeleConfig.kt
+++ b/TMessagesProj/src/main/java/tele/TeleConfig.kt
@@ -262,6 +262,8 @@ object TeleConfig {
     val HIDE_COMMUNITIES = BoolItem("hide_communities", false)
     @JvmField
     val JUMP_TO_FIRST = BoolItem("jump_to_first", false)
+    @JvmField
+    val INSTANT_CHAT_MOVE = BoolItem("instant_chat_move", false)
 
     private var prefs: SharedPreferences? = null
 
diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt
index f0f44a3b2..bdb5156fe 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt
@@ -206,6 +206,7 @@ object TeleSearch {
             section(1244, "Pins in topics and saved messages", "chats", TeleSettingsActivity.MODE_CHATS, "Pin chats past the limit"),
             section(1255, "Hide communities", "chats", TeleSettingsActivity.MODE_CHATS),
             section(1256, "Jump to the first message", "chats", TeleSettingsActivity.MODE_CHATS),
+            section(1257, "Move chats instantly", "chats", TeleSettingsActivity.MODE_CHATS),
             section(1190, "Export settings", "backup", TeleSettingsActivity.MODE_BACKUP),
             section(1191, "Import settings", "backup", TeleSettingsActivity.MODE_BACKUP),
             section(GUID_UPDATES, "Update automatically", "updates", TeleSettingsActivity.MODE_UPDATES),
diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
index 215ab4b77..3d20517f3 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
@@ -593,6 +593,7 @@ class TeleSettingsActivity @JvmOverloads constructor(private val mode: String =
         private val DESCRIPTIONS = mapOf(
             "Remove my messages" to "Adds it to chat menus: deletes all your messages there for everyone.",
             "Show seconds in message times" to "Times read 14:03:21, and service messages show their time too.",
+            "Move chats instantly" to "Chats jump to their new place in the list without sliding.",
             "Jump to the first message" to "Adds it to the chat menu: opens the very start of the chat or topic.",
             "Hide communities" to "Their chats show up as regular chats.",
             "Hide the all chats folder" to "The chat list opens on your first folder.",
@@ -785,6 +786,7 @@ class TeleSettingsActivity @JvmOverloads constructor(private val mode: String =
                 toggle("Hide similar channels", TeleConfig.HIDE_SIMILAR_CHANNELS),
                 toggle("Hide communities", TeleConfig.HIDE_COMMUNITIES),
                 toggle("Jump to the first message", TeleConfig.JUMP_TO_FIRST),
+                toggle("Move chats instantly", TeleConfig.INSTANT_CHAT_MOVE),
                 Row(TYPE_SHADOW),
                 Row(TYPE_HEADER, "Chats and profiles"),
                 toggle("Show names instead of phone numbers in chat headers", TeleConfig.NAME_INSTEAD_OF_PHONE),
