+    // results of the local searches of tele (regex, sender + type): shown through the stock navigation
+    public void tele_portResults(int guid, long dialogId, String query, ArrayList<MessageObject> loaded, int index, int count, boolean reached, boolean jump) {
+        if (reqId != 0) {
+            getConnectionsManager().cancelRequest(reqId, true);
+            reqId = 0;
+        }
+        if (mergeReqId != 0) {
+            getConnectionsManager().cancelRequest(mergeReqId, true);
+            mergeReqId = 0;
+        }
+        lastReqId++;
+        loadingMoreSearchMessages = false;
+        loadingSearchLocal = false;
+        loadedPredirectedSearchLocal = false;
+        lastGuid = guid;
+        lastDialogId = dialogId;
+        lastMergeDialogId = 0;
+        lastSearchUser = null;
+        lastSearchChat = null;
+        lastReaction = null;
+        lastSearchQuery = query;
+        searchServerResultMessages.clear();
+        searchLocalResultMessages.clear();
+        searchServerResultMessagesMap[0].clear();
+        searchServerResultMessagesMap[1].clear();
+        for (int a = 0; a < loaded.size(); a++) {
+            MessageObject m = loaded.get(a);
+            searchServerResultMessages.add(m);
+            searchServerResultMessagesMap[m.getDialogId() == dialogId ? 0 : 1].put(m.getId(), m);
+        }
+        updateSearchResults();
+        messagesSearchEndReached[0] = reached;
+        messagesSearchEndReached[1] = true;
+        messagesSearchCount[0] = count;
+        messagesSearchCount[1] = 0;
+        lastReturnedNum = Math.max(0, Math.min(index, searchResultMessages.size() - 1));
+        if (searchResultMessages.isEmpty()) {
+            getNotificationCenter().postNotificationName(NotificationCenter.chatSearchResultsAvailable, guid, 0, getMask(), 0L, 0, 0, jump);
+        } else {
+            MessageObject m = searchResultMessages.get(lastReturnedNum);
+            getNotificationCenter().postNotificationName(NotificationCenter.chatSearchResultsAvailable, guid, m.getId(), getMask(), m.getDialogId(), lastReturnedNum, getSearchCount(), jump);
+        }
+    }
+
+    public void tele_clearResults() {
+        if (reqId != 0) {
+            getConnectionsManager().cancelRequest(reqId, true);
+            reqId = 0;
+        }
+        if (mergeReqId != 0) {
+            getConnectionsManager().cancelRequest(mergeReqId, true);
+            mergeReqId = 0;
+        }
+        lastReqId++;
+        loadingMoreSearchMessages = false;
+        lastSearchQuery = null;
+        searchServerResultMessagesMap[0].clear();
+        searchServerResultMessagesMap[1].clear();
+        clearFoundMessageObjects();
+    }
+
+    public void tele_setQuery(String query) {
+        lastSearchQuery = query;
+    }
+
     public String getLastSearchQuery() {
         return lastSearchQuery;
     }
