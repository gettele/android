+package tele.helpers
+
+import android.content.Context
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.View
+import android.view.ViewGroup
+import android.widget.CompoundButton
+import android.widget.FrameLayout
+import android.widget.HorizontalScrollView
+import android.widget.LinearLayout
+import android.widget.TextView
+import androidx.core.view.AccessibilityDelegateCompat
+import androidx.core.view.ViewCompat
+import androidx.core.view.accessibility.AccessibilityNodeInfoCompat
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.DispatchQueue
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.MediaDataController
+import org.telegram.messenger.MessageObject
+import org.telegram.messenger.NotificationCenter
+import org.telegram.messenger.R
+import org.telegram.messenger.UserConfig
+import org.telegram.tgnet.TLObject
+import org.telegram.tgnet.TLRPC
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.ChatActivity
+import org.telegram.ui.Components.ChatActivityTopPanelLayout
+import org.telegram.ui.Components.LayoutHelper
+import tele.TeleConfig
+import java.lang.ref.WeakReference
+import java.util.concurrent.ConcurrentHashMap
+import java.util.regex.Pattern
+import java.util.regex.PatternSyntaxException
+
+// regex search over the messages a chat has already loaded (tele 0168); the hits go through the stock result list and arrows
+object ChatSearch {
+    private const val TYPED_DELAY = 250L
+    private const val RESCAN_DELAY = 300L
+    private const val OLDER_DELAY = 50L
+    private const val OLDER_PAGES = 4
+    private const val OLDER_TIMEOUT = 15_000L
+    // one message that needs longer than this is a runaway pattern
+    private const val SLOW_NANOS = 3_000_000_000L
+    private const val CACHE_LIMIT = 3000
+    private const val CHIP_REGEX = -1
+
+    private val queue by lazy { DispatchQueue("teleChatSearch") }
+    private val sessions = ConcurrentHashMap<Long, WeakReference<Session>>()
+
+    // the generation a scan belongs to; a newer one cancels it
+    private class Token {
+        @Volatile
+        var value = 0
+    }
+
+    private fun key(account: Int, guid: Int): Long = (account.toLong() shl 32) or (guid.toLong() and 0xffffffffL)
+
+    private fun session(account: Int, guid: Int): Session? = sessions[key(account, guid)]?.get()
+
+    @JvmStatic
+    fun create(activity: ChatActivity, panel: ChatActivityTopPanelLayout?, container: FrameLayout): Session? {
+        if (panel == null || activity.chatMode == ChatActivity.MODE_SEARCH) return null
+        val session = Session(activity, panel, container)
+        sessions[key(session.account, session.guid)] = WeakReference(session)
+        return session
+    }
+
+    // the stock navigation ran past the last hit: a local search loads older messages itself, never asks the server
+    @JvmStatic
+    fun more(account: Int, guid: Int): Boolean = session(account, guid)?.loadMore() ?: false
+
+    @JvmStatic
+    fun onToggled() {
+        val it = sessions.entries.iterator()
+        while (it.hasNext()) {
+            val session = it.next().value.get()
+            if (session == null) it.remove() else session.refresh()
+        }
+    }
+
+    private class Chip(val id: Int, val label: String, val description: String)
+
+    private class Source(val message: MessageObject, val text: String, val dialogId: Long, val id: Int, val edit: Int)
+
+    private class Hit(val message: MessageObject, val quote: String, val date: Int)
+
+    private class Scan(val hits: List<Hit>, val slow: Boolean)
+
+    private class Copy(val text: String, val edit: Int, val message: MessageObject)
+
+    private data class Key(val dialogId: Long, val id: Int)
+
+    private class Cancelled : RuntimeException(null, null, false, false)
+
+    private class Slow : RuntimeException(null, null, false, false)
+
+    // lets a runaway pattern be cancelled or timed out while it is matching one message
+    private class Guarded(private val text: String, private val generation: Int, private val token: Token) : CharSequence {
+        private val start = System.nanoTime()
+        private var reads = 0
+
+        override val length: Int get() = text.length
+
+        override fun get(index: Int): Char {
+            if ((++reads and 0x3FF) == 0) {
+                if (token.value != generation) throw Cancelled()
+                if (System.nanoTime() - start > SLOW_NANOS) throw Slow()
+            }
+            return text[index]
+        }
+
+        override fun subSequence(startIndex: Int, endIndex: Int): CharSequence = text.substring(startIndex, endIndex)
+
+        override fun toString(): String = text
+    }
+
+    private enum class State { IDLE, OK, INVALID, SLOW }
+
+    private enum class Mode { NONE, REGEX }
+
+    private class ChipRow(context: Context, private val resources: Theme.ResourcesProvider?) : HorizontalScrollView(context) {
+        private val box = LinearLayout(context)
+        var signature = ""
+
+        init {
+            isHorizontalScrollBarEnabled = false
+            overScrollMode = OVER_SCROLL_NEVER
+            clipToPadding = false
+            setPadding(AndroidUtilities.dp(6f), 0, AndroidUtilities.dp(6f), 0)
+            box.orientation = LinearLayout.HORIZONTAL
+            box.gravity = Gravity.CENTER_VERTICAL
+            addView(box, FrameLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, ViewGroup.LayoutParams.MATCH_PARENT))
+        }
+
+        // the chips are rebuilt on every change, so a rebind always starts from the true selection
+        fun bind(chips: List<Chip>, selected: (Chip) -> Boolean, click: (Chip) -> Unit) {
+            box.removeAllViews()
+            val text = Theme.getColor(Theme.key_windowBackgroundWhiteBlackText, resources)
+            val accent = Theme.getColor(Theme.key_featuredStickers_addButton, resources)
+            val onAccent = Theme.getColor(Theme.key_featuredStickers_buttonText, resources)
+            for (chip in chips) {
+                val picked = selected(chip)
+                val view = TextView(context)
+                view.gravity = Gravity.CENTER
+                view.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14f)
+                view.typeface = AndroidUtilities.bold()
+                view.setPadding(AndroidUtilities.dp(12f), 0, AndroidUtilities.dp(12f), 0)
+                view.text = chip.label
+                view.setTextColor(if (picked) onAccent else text)
+                val fill = if (picked) accent else Theme.multAlpha(text, 0.08f)
+                view.background = Theme.createSimpleSelectorRoundRectDrawable(AndroidUtilities.dp(16f), fill, Theme.multAlpha(text, 0.2f))
+                view.isSelected = picked
+                view.contentDescription = chip.description
+                ViewCompat.setAccessibilityDelegate(view, object : AccessibilityDelegateCompat() {
+                    override fun onInitializeAccessibilityNodeInfo(host: View, info: AccessibilityNodeInfoCompat) {
+                        super.onInitializeAccessibilityNodeInfo(host, info)
+                        info.className = CompoundButton::class.java.name
+                        info.isCheckable = true
+                        info.isChecked = picked
+                    }
+                })
+                view.setOnClickListener { click(chip) }
+                box.addView(view, LinearLayout.LayoutParams(ViewGroup.LayoutParams.WRAP_CONTENT, AndroidUtilities.dp(32f)).apply {
+                    leftMargin = AndroidUtilities.dp(3f)
+                    rightMargin = AndroidUtilities.dp(3f)
+                })
+            }
+        }
+    }
+
+    class Session internal constructor(
+        private val activity: ChatActivity,
+        private val panel: ChatActivityTopPanelLayout,
+        private val container: FrameLayout
+    ) {
+        internal val account = activity.currentAccount
+        internal val guid = activity.classGuid
+        private val dialogId = activity.dialogId
+        private val isSaved = dialogId == UserConfig.getInstance(account).clientUserId
+        private val row = ChipRow(container.context, activity.resourceProvider)
+        private val cache = ConcurrentHashMap<Key, Copy>()
+        private val token = Token()
+
+        private var released = false
+        private var regexOn = false
+        private var query = ""
+        private var hashtag = false
+        private var state = State.IDLE
+        private var mode = Mode.NONE
+        private var hits: List<Hit> = emptyList()
+        private var generation = 0
+        private var pendingOlder = false
+        private var pendingFrom = 0
+        private var olderBudget = 0
+
+        private val typed = Runnable { runRegex(jump = true, keep = false) }
+        private val rescan = Runnable { runRegex(jump = false, keep = true) }
+        private val olderTimeout = Runnable {
+            pendingOlder = false
+            runRegex(jump = false, keep = true)
+        }
+
+        init {
+            panel.addView(row, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, 44))
+            panel.setPriority(row, 9)
+            panel.setDebugName(row, "tele search chips")
+            syncPanel()
+        }
+
+        private val mdc: MediaDataController get() = MediaDataController.getInstance(account)
+
+        private fun regexActive() = TeleConfig.REGEX_SEARCH.value && regexOn
+
+        private fun chips(): List<Chip> {
+            val list = ArrayList<Chip>()
+            if (TeleConfig.REGEX_SEARCH.value) {
+                list.add(Chip(CHIP_REGEX, ".*", LocaleController.getString(R.string.TeleRegexChip)))
+            }
+            return list
+        }
+
+        private fun selected(chip: Chip) = chip.id == CHIP_REGEX && regexOn
+
+        private fun click(chip: Chip) {
+            if (released) return
+            if (chip.id == CHIP_REGEX) toggleRegex()
+        }
+
+        // shown together with the stock bottom bar of the search, hidden for hashtag queries which are a different search
+        fun syncPanel() {
+            if (released) return
+            val chips = chips()
+            val show = chips.isNotEmpty() && container.visibility == View.VISIBLE && !hashtag
+            if (show) {
+                val signature = chips.joinToString("|") { "${it.id}:${selected(it)}" }
+                if (signature != row.signature) {
+                    row.signature = signature
+                    row.bind(chips, ::selected, ::click)
+                }
+            }
+            panel.setViewVisible(row, show, true)
+        }
+
+        internal fun refresh() {
+            if (released) return
+            if (!TeleConfig.REGEX_SEARCH.value && regexOn) {
+                regexOn = false
+                leaveRegex()
+            }
+            syncPanel()
+        }
+
+        fun destroy() {
+            released = true
+            cancelTimers()
+            token.value = ++generation
+            cache.clear()
+            panel.removeView(row)
+            sessions.remove(key(account, guid))
+        }
+
+        fun onCollapse() {
+            cancelTimers()
+            token.value = ++generation
+            regexOn = false
+            query = ""
+            hashtag = false
+            state = State.IDLE
+            mode = Mode.NONE
+            hits = emptyList()
+            pendingOlder = false
+            cache.clear()
+            row.signature = ""
+            syncPanel()
+        }
+
+        // true when the search was answered here, so the stock request is skipped
+        fun onSearchPressed(text: String): Boolean {
+            query = text
+            if (!regexActive()) {
+                mode = Mode.NONE
+                return false
+            }
+            runRegex(jump = true, keep = false)
+            return true
+        }
+
+        fun onFromChosen(): Boolean {
+            if (!regexActive()) return false
+            query = ""
+            runRegex(jump = true, keep = false)
+            return true
+        }
+
+        fun onTextChanged(text: String) {
+            query = text
+            val tag = !regexOn && (text.startsWith("#") || text.startsWith("$"))
+            if (tag != hashtag) {
+                hashtag = tag
+                syncPanel()
+            }
+            if (regexActive()) {
+                AndroidUtilities.cancelRunOnUIThread(typed)
+                AndroidUtilities.runOnUIThread(typed, TYPED_DELAY)
+            }
+        }
+
+        fun onNotification(id: Int, args: Array<out Any?>) {
+            if (released) return
+            if (id == NotificationCenter.chatSearchResultsAvailable) {
+                if (mode == Mode.REGEX && args.size > 1 && args[0] == guid) {
+                    // the chat highlights the hit itself, not the pattern
+                    val messageId = args[1] as? Int ?: return
+                    hits.firstOrNull { it.message.id == messageId }?.let { mdc.tele_setQuery(it.quote) }
+                }
+            } else if (id == NotificationCenter.messagesDidLoad) {
+                if (args.size > 10 && args[10] == guid) changed()
+            } else if (id == NotificationCenter.messagesDeleted || id == NotificationCenter.didReceiveNewMessages) {
+                changed()
+            }
+        }
+
+        fun countText(index: Int, count: Int, list: Boolean): CharSequence? {
+            if (released || !regexActive()) return null
+            return when {
+                state == State.INVALID -> LocaleController.getString(R.string.TeleRegexInvalid)
+                state == State.SLOW -> LocaleController.getString(R.string.TeleRegexSlow)
+                mode != Mode.REGEX -> null
+                pendingOlder -> LocaleController.getString(R.string.TeleRegexLoading)
+                count <= 0 -> null
+                list -> LocaleController.formatString(R.string.TeleRegexCountList, count)
+                else -> LocaleController.formatString(R.string.TeleRegexCountOf, index + 1, count)
+            }
+        }
+
+        private fun cancelTimers() {
+            AndroidUtilities.cancelRunOnUIThread(typed)
+            AndroidUtilities.cancelRunOnUIThread(rescan)
+            AndroidUtilities.cancelRunOnUIThread(olderTimeout)
+        }
+
+        private fun toggleRegex() {
+            regexOn = !regexOn
+            hashtag = false
+            syncPanel()
+            if (regexOn) runRegex(jump = true, keep = false) else leaveRegex()
+        }
+
+        // back to the stock semantics: the query goes to the server as the user typed it
+        private fun leaveRegex() {
+            cancelTimers()
+            token.value = ++generation
+            val was = mode != Mode.NONE
+            mode = Mode.NONE
+            hits = emptyList()
+            state = State.IDLE
+            pendingOlder = false
+            if (was || query.isNotEmpty()) activity.tele_runSearch(query, query.isEmpty())
+        }
+
+        private fun changed() {
+            if (!regexActive() || state != State.OK) return
+            AndroidUtilities.cancelRunOnUIThread(rescan)
+            AndroidUtilities.runOnUIThread(rescan, if (pendingOlder) OLDER_DELAY else RESCAN_DELAY)
+        }
+
+        private fun currentMessageId(): Int {
+            val results = mdc.searchResultMessages
+            return results.getOrNull(mdc.searchPosition)?.id ?: 0
+        }
+
+        private fun fail(failed: State) {
+            cancelTimers()
+            state = failed
+            mode = Mode.NONE
+            hits = emptyList()
+            pendingOlder = false
+            activity.tele_runSearch(query, true)
+        }
+
+        private fun runRegex(jump: Boolean, keep: Boolean) {
+            AndroidUtilities.cancelRunOnUIThread(typed)
+            AndroidUtilities.cancelRunOnUIThread(rescan)
+            if (released || !regexActive()) return
+            val gen = ++generation
+            token.value = gen
+            if (query.isEmpty()) {
+                cancelTimers()
+                state = State.IDLE
+                mode = Mode.NONE
+                hits = emptyList()
+                pendingOlder = false
+                activity.tele_runSearch(query, true)
+                return
+            }
+            val pattern = try {
+                Pattern.compile(query, Pattern.CASE_INSENSITIVE or Pattern.UNICODE_CASE)
+            } catch (e: PatternSyntaxException) {
+                fail(State.INVALID)
+                return
+            } catch (e: StackOverflowError) {
+                fail(State.INVALID)
+                return
+            }
+            val keepId = if (keep && mode == Mode.REGEX) currentMessageId() else 0
+            val from = activity.tele_searchFrom()
+            // the loaded messages are read here on the main thread, the matching runs away from it
+            val sources = ArrayList<Source>(activity.messages.size)
+            for (message in activity.messages) {
+                val owner = message.messageOwner ?: continue
+                val text = owner.message
+                if (text.isNullOrEmpty() || message.id <= 0) continue
+                if (from != 0L && message.fromChatId != from) continue
+                sources.add(Source(message, text, message.dialogId, message.id, owner.edit_date))
+            }
+            queue.postRunnable {
+                val scan = scan(pattern, sources, gen)
+                if (scan != null) {
+                    AndroidUtilities.runOnUIThread {
+                        if (!released && gen == generation) publish(scan, jump, keepId)
+                    }
+                }
+            }
+        }
+
+        private fun scan(pattern: Pattern, sources: List<Source>, gen: Int): Scan? {
+            val out = ArrayList<Hit>()
+            for (source in sources) {
+                if (token.value != gen) return null
+                val matcher = pattern.matcher(Guarded(source.text, gen, token))
+                val quote = try {
+                    if (matcher.find()) matcher.group() else continue
+                } catch (e: Cancelled) {
+                    return null
+                } catch (e: Slow) {
+                    return Scan(emptyList(), true)
+                } catch (e: StackOverflowError) {
+                    return Scan(emptyList(), true)
+                }
+                val copy = copyOf(source, quote) ?: continue
+                out.add(Hit(copy, quote, copy.messageOwner.date))
+            }
+            out.sortWith(compareByDescending<Hit> { it.date }.thenByDescending { it.message.id })
+            return Scan(out, false)
+        }
+
+        // the result list gets its own objects, so the chat's messages are never touched by the stock result handling
+        private fun copyOf(source: Source, quote: String): MessageObject? {
+            val key = Key(source.dialogId, source.id)
+            var entry = cache[key]
+            if (entry == null || entry.text != source.text || entry.edit != source.edit) {
+                try {
+                    val owner = TLObject.deepCopy(source.message.messageOwner) { stream, constructor, exception ->
+                        TLRPC.Message.TLdeserialize(stream, constructor, exception)
+                    } ?: return null
+                    owner.dialog_id = source.dialogId
+                    val message = MessageObject(account, owner, null, null, null, null, null, true, true, 0L, false, false, isSaved)
+                    if (message.hasValidGroupId()) message.isPrimaryGroupMessage = true
+                    entry = Copy(source.text, source.edit, message)
+                } catch (e: Throwable) {
+                    return null
+                }
+                if (cache.size >= CACHE_LIMIT) cache.clear()
+                cache[key] = entry
+            }
+            entry.message.setQuery(quote, true)
+            return entry.message
+        }
+
+        private fun publish(scan: Scan, jump: Boolean, keepId: Int) {
+            if (scan.slow) {
+                fail(State.SLOW)
+                return
+            }
+            state = State.OK
+            hits = scan.hits
+            var index = 0
+            var go = jump
+            if (keepId != 0) {
+                val at = hits.indexOfFirst { it.message.id == keepId }
+                if (at >= 0) index = at
+            }
+            if (pendingOlder) {
+                val at = hits.indexOfFirst { it.message.id == pendingFrom }
+                if (at >= 0 && at + 1 < hits.size) {
+                    index = at + 1
+                    go = true
+                    pendingOlder = false
+                } else if (at < 0) {
+                    pendingOlder = false
+                } else {
+                    when (activity.tele_olderState()) {
+                        1 -> if (olderBudget > 0) {
+                            olderBudget--
+                            activity.tele_loadOlder()
+                        } else {
+                            pendingOlder = false
+                        }
+                        0 -> pendingOlder = false
+                    }
+                }
+            }
+            AndroidUtilities.cancelRunOnUIThread(olderTimeout)
+            if (pendingOlder) AndroidUtilities.runOnUIThread(olderTimeout, OLDER_TIMEOUT)
+            mode = Mode.REGEX
+            val reached = activity.tele_olderState() == 0
+            val quote = hits.getOrNull(index)?.quote ?: query
+            mdc.tele_portResults(guid, dialogId, quote, ArrayList(hits.map { it.message }), index, hits.size, reached, go)
+        }
+
+        internal fun loadMore(): Boolean {
+            if (released || mode != Mode.REGEX) return false
+            if (pendingOlder) return true
+            val older = activity.tele_olderState()
+            if (older == 0) return true
+            pendingOlder = true
+            pendingFrom = currentMessageId()
+            olderBudget = OLDER_PAGES
+            if (older == 1) {
+                olderBudget--
+                activity.tele_loadOlder()
+            }
+            AndroidUtilities.cancelRunOnUIThread(olderTimeout)
+            AndroidUtilities.runOnUIThread(olderTimeout, OLDER_TIMEOUT)
+            activity.tele_refreshSearchCount()
+            return true
+        }
+    }
+}
