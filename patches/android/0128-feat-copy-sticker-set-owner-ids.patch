index 6d169c4b3..af85cf564 100644
--- a/TMessagesProj/src/main/java/tele/helpers/PeerId.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/PeerId.kt
@@ -80,6 +80,21 @@ object PeerId {
     fun showDcRow(): Boolean =
         TeleConfig.SHOW_DC.value && !TeleConfig.MERGE_ID_DC.value
 
+    /**
+     * Recovers the sticker-set creator ID from Telegram's packed set ID.
+     * This mirrors desktop 0266; validate against a known owner/set pair before relying on it.
+     */
+    @JvmStatic
+    fun stickerSetOwnerId(setId: Long): Long? {
+        if (setId <= 0L) return null
+        val high = setId ushr 32
+        val low = setId and 0xffff_ffffL
+        if (low ushr 24 == 0L) return high.takeIf { it > 0L }
+        val band = (low.inv() and 0xffff_ffffL) ushr 22
+        val owner = high + (band shl 31)
+        return owner.takeIf { it > 0L }
+    }
+
     private fun botApiAdjusted(account: Int, userId: Long, chatId: Long): Long {
         if (userId != 0L || chatId == 0L || !TeleConfig.BOT_API_PEER_IDS.value) {
             return if (userId != 0L) userId else chatId
