From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: test <test@example.com>
Date: Tue, 10 Nov 2026 04:01:54 +0300
Subject: [PATCH] fix: keep other changes inside their settings group

---
 .../main/java/tele/ui/settings/TeleSettingsActivity.kt    | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
index 8803ddd4e..5d52d0e51 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
@@ -787,6 +787,12 @@ class TeleSettingsActivity @JvmOverloads constructor(private val mode: String =
                 caption.setPadding(AndroidUtilities.dp(21f), AndroidUtilities.dp(4f), AndroidUtilities.dp(21f), AndroidUtilities.dp(8f))
                 caption
             }
+            "changelog_note" -> TextView(context).apply {
+                text = lc(row.title.orEmpty())
+                setTextSize(android.util.TypedValue.COMPLEX_UNIT_DIP, 14f)
+                setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteBlackText, resourceProvider))
+                setPadding(AndroidUtilities.dp(21f), AndroidUtilities.dp(10f), AndroidUtilities.dp(21f), AndroidUtilities.dp(10f))
+            }
             "new_tabs" -> newTabsView(context)
             "names_preview" -> TelePreviews.namesView(context, resourceProvider)
             "ids_preview" -> TelePreviews.idsView(context, resourceProvider)
@@ -1312,7 +1318,7 @@ class TeleSettingsActivity @JvmOverloads constructor(private val mode: String =
                 }
                 if (plain.isNotEmpty()) {
                     result.add(Row(TYPE_HEADER, prefix + "other changes"))
-                    plain.forEach { result.add(Row(TYPE_SHADOW, title = it.text)) }
+                    plain.forEach { result.add(Row(TYPE_CUSTOM, title = it.text, mode = "changelog_note")) }
                     result.add(Row(TYPE_SHADOW))
                 }
                 listed = true
