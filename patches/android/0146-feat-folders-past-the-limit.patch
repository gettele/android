@@ -0,0 +1,544 @@
+package tele.helpers
+
+import android.util.Base64
+import android.util.SparseArray
+import org.json.JSONArray
+import org.json.JSONObject
+import org.telegram.messenger.FileLog
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.MessagesController
+import org.telegram.messenger.MessagesController.DialogFilter
+import org.telegram.messenger.MessagesStorage
+import org.telegram.messenger.R
+import org.telegram.messenger.UserConfig
+import org.telegram.messenger.Utilities
+import org.telegram.tgnet.ConnectionsManager
+import org.telegram.tgnet.RequestDelegate
+import org.telegram.tgnet.SerializedData
+import org.telegram.tgnet.TLObject
+import org.telegram.tgnet.TLRPC
+import org.telegram.tgnet.Vector
+import tele.TeleConfig
+import tele.db.TeleDatabaseHelper
+
+/**
+ * Folders past the Telegram limits. A folder that doesn't fit the server folder count lives only on this device
+ * (local id range, never sent). What doesn't fit the chats limit of a server folder is kept here and merged back
+ * into the folder when it is read, so the server folder stays valid.
+ */
+object LocalFolders {
+
+    const val LOCAL_BASE = 0x40000000
+    private const val NO_LIMIT = 0x00FFFFFF
+    private const val KEY = "local_folders"
+
+    @JvmStatic
+    fun isLocal(id: Int): Boolean = id >= LOCAL_BASE
+
+    @JvmStatic
+    fun enabled(): Boolean = TeleConfig.LOCAL_FOLDERS.value
+
+    private class Stored(
+        val id: Int,
+        var name: String,
+        var entities: ByteArray?,
+        var flags: Int,
+        var color: Int,
+        var noAnimate: Boolean,
+        var always: List<Long>,
+        var never: List<Long>,
+        var pinned: List<Pair<Long, Int>>
+    )
+
+    private class Overflow(val always: List<Long>, val never: List<Long>, val pinned: List<Long>) {
+        fun isEmpty() = always.isEmpty() && never.isEmpty()
+        fun same(o: Overflow) = always == o.always && never == o.never && pinned == o.pinned
+    }
+
+    private class ServerPart(val always: Set<Long>, val never: Set<Long>)
+
+    private class State(val userId: Long) {
+        val folders = ArrayList<Stored>()
+        val overflow = HashMap<Int, Overflow>()
+        var order: List<Int> = emptyList()
+        // what the server holds for a folder, known from the last read or write
+        val server = HashMap<Int, ServerPart>()
+        // edits of a server folder the server refused, e.g. a folder past the free limit after premium ends
+        val pending = HashMap<Int, ByteArray>()
+        var lastId = LOCAL_BASE - 1
+    }
+
+    private val states = SparseArray<State>()
+
+    private fun state(account: Int): State? {
+        val userId = UserConfig.getInstance(account).getClientUserId()
+        if (userId == 0L) return null
+        synchronized(states) {
+            val known = states.get(account)
+            if (known != null && known.userId == userId) return known
+            val fresh = State(userId)
+            read(fresh)
+            states.put(account, fresh)
+            return fresh
+        }
+    }
+
+    private fun key(userId: Long) = "$KEY:$userId"
+
+    private fun read(state: State) {
+        val raw = runCatching { TeleDatabaseHelper.get(key(state.userId)) }.getOrNull() ?: return
+        runCatching {
+            val json = JSONObject(raw)
+            val folders = json.optJSONArray("folders") ?: JSONArray()
+            for (i in 0 until folders.length()) {
+                val f = folders.getJSONObject(i)
+                val id = f.getInt("id")
+                if (!isLocal(id)) continue
+                val pins = f.optJSONArray("pinned") ?: JSONArray()
+                state.folders.add(Stored(
+                    id, f.optString("name"), f.optString("ent").takeIf { it.isNotEmpty() }?.let { Base64.decode(it, Base64.NO_WRAP) },
+                    f.optInt("flags"), f.optInt("color", -1), f.optInt("na") == 1,
+                    longs(f.optJSONArray("always")), longs(f.optJSONArray("never")),
+                    (0 until pins.length()).map { pins.getJSONArray(it).let { p -> p.getLong(0) to p.getInt(1) } }
+                ))
+                state.lastId = maxOf(state.lastId, id)
+            }
+            val overflow = json.optJSONObject("overflow")
+            if (overflow != null) {
+                for (k in overflow.keys()) {
+                    val o = overflow.getJSONObject(k)
+                    val entry = Overflow(longs(o.optJSONArray("a")), longs(o.optJSONArray("n")), longs(o.optJSONArray("p")))
+                    val id = k.toIntOrNull() ?: continue
+                    if (id > 0 && !isLocal(id) && !entry.isEmpty()) state.overflow[id] = entry
+                }
+            }
+            val pending = json.optJSONObject("pending")
+            if (pending != null) {
+                for (k in pending.keys()) {
+                    val id = k.toIntOrNull() ?: continue
+                    if (id > 0 && !isLocal(id)) state.pending[id] = Base64.decode(pending.getString(k), Base64.NO_WRAP)
+                }
+            }
+            val order = json.optJSONArray("order") ?: JSONArray()
+            state.order = (0 until order.length()).map { order.getInt(it) }
+        }.onFailure { FileLog.e(it) }
+    }
+
+    private fun longs(array: JSONArray?): List<Long> =
+        if (array == null) emptyList() else (0 until array.length()).map { array.getLong(it) }
+
+    private fun persist(state: State) {
+        val json = JSONObject()
+        json.put("v", 1)
+        val folders = JSONArray()
+        for (f in state.folders) {
+            folders.put(JSONObject().apply {
+                put("id", f.id)
+                put("name", f.name)
+                f.entities?.let { put("ent", Base64.encodeToString(it, Base64.NO_WRAP)) }
+                put("flags", f.flags)
+                put("color", f.color)
+                put("na", if (f.noAnimate) 1 else 0)
+                put("always", JSONArray(f.always))
+                put("never", JSONArray(f.never))
+                put("pinned", JSONArray().apply { f.pinned.forEach { put(JSONArray().put(it.first).put(it.second)) } })
+            })
+        }
+        json.put("folders", folders)
+        val overflow = JSONObject()
+        for ((id, o) in state.overflow) {
+            overflow.put(id.toString(), JSONObject().put("a", JSONArray(o.always)).put("n", JSONArray(o.never)).put("p", JSONArray(o.pinned)))
+        }
+        json.put("overflow", overflow)
+        val pending = JSONObject()
+        for ((id, data) in state.pending) pending.put(id.toString(), Base64.encodeToString(data, Base64.NO_WRAP))
+        json.put("pending", pending)
+        json.put("order", JSONArray(state.order))
+        val text = json.toString()
+        val key = key(state.userId)
+        Utilities.globalQueue.postRunnable { runCatching { TeleDatabaseHelper.put(key, text) }.onFailure { FileLog.e(it) } }
+    }
+
+    private fun entitiesBytes(entities: ArrayList<TLRPC.MessageEntity>?): ByteArray? {
+        if (entities.isNullOrEmpty()) return null
+        return runCatching {
+            val stream = SerializedData()
+            Vector.serialize(stream, entities)
+            stream.toByteArray()
+        }.getOrNull()
+    }
+
+    private fun entitiesFrom(bytes: ByteArray?): ArrayList<TLRPC.MessageEntity> {
+        if (bytes == null) return ArrayList()
+        return runCatching {
+            Vector.deserialize(SerializedData(bytes), TLRPC.MessageEntity::TLdeserialize, false)
+        }.getOrNull() ?: ArrayList()
+    }
+
+    private fun build(stored: Stored): DialogFilter {
+        val filter = DialogFilter()
+        filter.id = stored.id
+        filter.name = stored.name
+        filter.entities = entitiesFrom(stored.entities)
+        filter.flags = stored.flags
+        filter.color = stored.color
+        filter.title_noanimate = stored.noAnimate
+        filter.alwaysShow = ArrayList(stored.always)
+        filter.neverShow = ArrayList(stored.never)
+        stored.pinned.forEach { filter.pinnedDialogs.put(it.first, it.second) }
+        filter.pendingUnreadCount = -1
+        filter.unreadCount = -1
+        return filter
+    }
+
+    private fun snapshot(filter: DialogFilter): Stored {
+        val pins = ArrayList<Pair<Long, Int>>()
+        for (i in 0 until filter.pinnedDialogs.size()) pins.add(filter.pinnedDialogs.keyAt(i) to filter.pinnedDialogs.valueAt(i))
+        return Stored(
+            filter.id, filter.name ?: "", entitiesBytes(filter.entities), filter.flags, filter.color, filter.title_noanimate,
+            ArrayList(filter.alwaysShow), ArrayList(filter.neverShow), pins
+        )
+    }
+
+    // the folders of the server in their order, the local ones slotted behind what preceded them last time
+    private fun mergedOrder(server: List<Int>, locals: List<Int>, stored: List<Int>): ArrayList<Int> {
+        val result = ArrayList(server.filter { !isLocal(it) || it in locals })
+        val pending = ArrayList(stored.filter { it in locals })
+        for (id in locals) if (id !in pending) pending.add(id)
+        for (id in pending) {
+            if (id in result) continue
+            var position = result.size
+            val at = stored.indexOf(id)
+            if (at >= 0) {
+                position = 0
+                for (k in at - 1 downTo 0) {
+                    val found = result.indexOf(stored[k])
+                    if (found >= 0) {
+                        position = found + 1
+                        break
+                    }
+                }
+            }
+            result.add(position, id)
+        }
+        return result
+    }
+
+    private fun localIds(state: State): List<Int> = state.folders.map { it.id }
+
+    /** Storage thread: drops the local folders from the list and puts them back when the option is on. */
+    @JvmStatic
+    fun sync(account: Int, list: ArrayList<DialogFilter>, map: SparseArray<DialogFilter>) {
+        for (i in list.indices.reversed()) {
+            val id = list[i].id
+            if (isLocal(id)) {
+                list.removeAt(i)
+                map.remove(id)
+            }
+        }
+        if (!enabled()) return
+        val state = state(account) ?: return
+        for (stored in state.folders) {
+            val filter = build(stored)
+            list.add(filter)
+            map.put(filter.id, filter)
+        }
+        reorder(state, list)
+    }
+
+    private fun reorder(state: State, list: ArrayList<DialogFilter>) {
+        val server = list.filter { !isLocal(it.id) }.sortedBy { it.order }.map { it.id }
+        val order = mergedOrder(server, localIds(state), state.order)
+        for (filter in list) filter.order = order.indexOf(filter.id)
+        list.sortBy { it.order }
+    }
+
+    /** UI thread: the server list stays as it is, only the local folders change. */
+    @JvmStatic
+    fun onToggled() {
+        for (account in 0 until UserConfig.MAX_ACCOUNT_COUNT) {
+            if (!UserConfig.getInstance(account).isClientActivated) continue
+            MessagesStorage.getInstance(account).tele_syncLocalFilters()
+            // the lists of the server folders drop or regain what was kept here
+            MessagesController.getInstance(account).loadRemoteFilters(true)
+        }
+    }
+
+    /** Storage thread: true when the folder is local and was kept here instead of in the database. */
+    @JvmStatic
+    fun save(account: Int, filter: DialogFilter): Boolean {
+        if (!isLocal(filter.id)) return false
+        val state = state(account) ?: return true
+        val stored = snapshot(filter)
+        synchronized(state) {
+            val i = state.folders.indexOfFirst { it.id == filter.id }
+            if (i < 0) state.folders.add(stored) else state.folders[i] = stored
+            state.lastId = maxOf(state.lastId, filter.id)
+        }
+        persist(state)
+        return true
+    }
+
+    /** Storage thread: a folder is gone, so are its local parts. */
+    @JvmStatic
+    fun forget(account: Int, id: Int) {
+        val state = state(account) ?: return
+        var changed: Boolean
+        synchronized(state) {
+            state.server.remove(id)
+            changed = state.folders.removeAll { it.id == id }
+            if (state.overflow.remove(id) != null) changed = true
+            if (changed) state.order = state.order.filter { it != id }
+        }
+        if (changed) persist(state)
+    }
+
+    /** Storage thread: remembers the order of every folder, the local ones included. */
+    @JvmStatic
+    fun saveOrder(account: Int, list: List<DialogFilter>) {
+        if (!enabled()) return
+        val state = state(account) ?: return
+        if (state.folders.isEmpty()) return
+        val order = list.sortedBy { it.order }.map { it.id }
+        if (order == state.order) return
+        state.order = order
+        persist(state)
+    }
+
+    /** Storage thread: a server list arrived; the parts kept here are merged back into its folders. */
+    @JvmStatic
+    fun onRemote(account: Int, vector: MutableList<TLRPC.DialogFilter>) {
+        val state = state(account) ?: return
+        val ids = HashSet<Int>()
+        var changed = false
+        synchronized(state) {
+            for (remote in vector) {
+                if (remote.id == 0) continue
+                ids.add(remote.id)
+                state.server[remote.id] = ServerPart(
+                    (remote.pinned_peers + remote.include_peers).mapNotNull { dialogId(it) }.toSet(),
+                    remote.exclude_peers.mapNotNull { dialogId(it) }.toSet()
+                )
+            }
+            state.server.keys.retainAll(ids)
+            if (state.overflow.keys.retainAll(ids)) changed = true
+            if (state.pending.keys.retainAll(ids)) changed = true
+            if (enabled()) {
+                for (i in vector.indices) {
+                    // the server still has the old version of a folder it refused to update
+                    val edit = state.pending[vector[i].id]?.let { filterOf(it) }
+                    if (edit != null) vector[i] = edit
+                }
+                for (remote in vector) {
+                    val o = state.overflow[remote.id] ?: continue
+                    merge(account, remote, o)
+                }
+            }
+        }
+        if (changed) persist(state)
+    }
+
+    private fun merge(account: Int, remote: TLRPC.DialogFilter, o: Overflow) {
+        val pinned = remote.pinned_peers.mapNotNull { dialogId(it) }
+        val included = (pinned + remote.include_peers.mapNotNull { dialogId(it) }).toHashSet()
+        for (did in o.always) if (included.add(did)) remote.include_peers.add(inputPeer(account, did))
+        val excluded = remote.exclude_peers.mapNotNull { dialogId(it) }.toHashSet()
+        for (did in o.never) if (excluded.add(did)) remote.exclude_peers.add(inputPeer(account, did))
+        if (o.pinned.isNotEmpty()) {
+            val merged = ArrayList<Long>()
+            for (did in o.pinned) if ((did in pinned || did in o.always) && did !in merged) merged.add(did)
+            for (did in pinned) if (did !in merged) merged.add(did)
+            remote.pinned_peers = ArrayList(merged.map { inputPeer(account, it) })
+        }
+    }
+
+    /** Storage thread: slots the local folders into the order the server sent. */
+    @JvmStatic
+    fun mergeOrder(account: Int, order: ArrayList<Int>) {
+        if (!enabled()) return
+        val state = state(account) ?: return
+        val locals = localIds(state)
+        if (locals.isEmpty()) return
+        val merged = mergedOrder(order, locals, state.order)
+        order.clear()
+        order.addAll(merged)
+    }
+
+    private fun dialogId(peer: TLRPC.InputPeer): Long? = when {
+        peer.user_id != 0L -> peer.user_id
+        peer.chat_id != 0L -> -peer.chat_id
+        peer.channel_id != 0L -> -peer.channel_id
+        else -> null
+    }
+
+    private fun inputPeer(account: Int, did: Long): TLRPC.InputPeer {
+        val controller = MessagesController.getInstance(account)
+        if (did > 0) {
+            return TLRPC.TL_inputPeerUser().apply {
+                user_id = did
+                access_hash = controller.getUser(did)?.access_hash ?: 0L
+            }
+        }
+        val chat = controller.getChat(-did)
+        if (chat != null && org.telegram.messenger.ChatObject.isChannel(chat)) {
+            return TLRPC.TL_inputPeerChannel().apply {
+                channel_id = -did
+                access_hash = chat.access_hash
+            }
+        }
+        return TLRPC.TL_inputPeerChat().apply { chat_id = -did }
+    }
+
+    private fun serverChatsLimit(account: Int): Int {
+        val controller = MessagesController.getInstance(account)
+        return if (UserConfig.getInstance(account).isPremium) controller.dialogFiltersChatsLimitPremium else controller.dialogFiltersChatsLimitDefault
+    }
+
+    /** UI thread: cuts what doesn't fit the server limits off the request and keeps it here. */
+    @JvmStatic
+    fun trim(account: Int, id: Int, tl: TLRPC.DialogFilter) {
+        if (!enabled() || id == 0 || isLocal(id)) return
+        val state = state(account) ?: return
+        val limit = serverChatsLimit(account)
+        val pinned = tl.pinned_peers.mapNotNull { dialogId(it) }
+        val include = tl.include_peers.mapNotNull { dialogId(it) }
+        val always = pinned + include.filter { it !in pinned }
+        val never = tl.exclude_peers.mapNotNull { dialogId(it) }
+        val known = synchronized(state) { state.server[id] }
+        val stored = synchronized(state) { state.overflow[id] }
+
+        // ones the server already holds go first, then the ones kept here, then the new ones
+        fun pick(list: List<Long>, onServer: Set<Long>?, local: List<Long>?): Pair<List<Long>, List<Long>> {
+            fun rank(did: Long): Int {
+                val server = onServer?.contains(did) ?: (local?.contains(did) != true)
+                return if (server) 0 else if (local?.contains(did) == true) 1 else 2
+            }
+            fun position(did: Long): Int = pinned.indexOf(did).let { if (it < 0) pinned.size else it }
+            val sorted = list.sortedWith(compareBy({ rank(it) }, { position(it) }))
+            val count = minOf(sorted.size, limit)
+            return sorted.subList(0, count) to sorted.subList(count, sorted.size)
+        }
+
+        val (serverAlways, localAlways) = pick(always, known?.always, stored?.always)
+        val (serverNever, localNever) = pick(never, known?.never, stored?.never)
+        val serverPinned = pinned.filter { it in serverAlways }
+        val overflow = Overflow(localAlways, localNever, if (serverPinned.size != pinned.size) pinned else emptyList())
+
+        val keepAlways = serverAlways.toHashSet()
+        val keepNever = serverNever.toHashSet()
+        tl.pinned_peers.removeAll { dialogId(it) !in serverPinned }
+        tl.include_peers.removeAll { dialogId(it) !in keepAlways }
+        tl.exclude_peers.removeAll { dialogId(it) !in keepNever }
+
+        var changed = false
+        synchronized(state) {
+            state.server[id] = ServerPart(keepAlways, keepNever)
+            val was = state.overflow[id]
+            if (overflow.isEmpty()) {
+                changed = state.overflow.remove(id) != null
+            } else if (was == null || !was.same(overflow)) {
+                state.overflow[id] = overflow
+                changed = true
+            }
+        }
+        if (changed) persist(state)
+    }
+
+    /** What a request does for a folder that stays here: nothing to the server, the callback still runs. */
+    @JvmStatic
+    fun send(connections: ConnectionsManager, req: TLObject, delegate: RequestDelegate?): Int {
+        val id = when (req) {
+            is TLRPC.TL_messages_updateDialogFilter -> req.id
+            else -> 0
+        }
+        if (isLocal(id)) {
+            delegate?.run(null, null)
+            return 0
+        }
+        val edit = (req as? TLRPC.TL_messages_updateDialogFilter)?.filter
+        if (id == 0 || edit == null || !enabled()) return connections.sendRequest(req, delegate)
+        val account = (0 until UserConfig.MAX_ACCOUNT_COUNT).firstOrNull { ConnectionsManager.getInstance(it) === connections }
+            ?: return connections.sendRequest(req, delegate)
+        val data = serialize(edit)
+        return connections.sendRequest(req) { response, error ->
+            notePending(account, id, if (error == null) null else data)
+            delegate?.run(response, error)
+        }
+    }
+
+    private fun notePending(account: Int, id: Int, data: ByteArray?) {
+        val state = state(account) ?: return
+        val changed = synchronized(state) {
+            if (data == null) state.pending.remove(id) != null else { state.pending[id] = data; true }
+        }
+        if (changed) persist(state)
+    }
+
+    private fun serialize(obj: TLObject): ByteArray {
+        val stream = SerializedData(obj.getObjectSize())
+        try {
+            obj.serializeToStream(stream)
+            return stream.toByteArray()
+        } finally {
+            stream.cleanup()
+        }
+    }
+
+    private fun filterOf(data: ByteArray): TLRPC.DialogFilter? = runCatching {
+        val stream = SerializedData(data)
+        try {
+            TLRPC.DialogFilter.TLdeserialize(stream, stream.readInt32(false), false)
+        } finally {
+            stream.cleanup()
+        }
+    }.getOrNull()
+
+    /** The folders a server order may mention; the local ones are only known here. */
+    @JvmStatic
+    fun serverOrder(order: ArrayList<Int>) {
+        order.removeAll { isLocal(it) }
+    }
+
+    /** A free id for a new folder: the stock one while the server has room, a local one past its limit. */
+    @JvmStatic
+    fun newId(account: Int, stockId: Int): Int {
+        if (!enabled()) return stockId
+        val controller = MessagesController.getInstance(account)
+        val server = controller.dialogFilters.count { it.id != 0 && !isLocal(it.id) }
+        val limit = if (UserConfig.getInstance(account).isPremium) controller.dialogFiltersLimitPremium else controller.dialogFiltersLimitDefault
+        if (server < limit) return stockId
+        val state = state(account) ?: return stockId
+        var id = synchronized(state) { state.lastId } + 1
+        while (controller.dialogFiltersById.get(id) != null) id++
+        synchronized(state) { state.lastId = id }
+        return id
+    }
+
+    /** The folder limits the options lift: a chat in a folder has no cap here. */
+    @JvmStatic
+    fun chatsLimit(stock: Int): Int = if (enabled()) NO_LIMIT else stock
+
+    @JvmStatic
+    fun unlimitedChats(limit: Int): Boolean = limit >= NO_LIMIT
+
+    /** The folders the premium lock may touch: none with the option on, else only the ones the server holds. */
+    @JvmStatic
+    fun lockable(list: ArrayList<DialogFilter>): ArrayList<DialogFilter> {
+        if (enabled()) {
+            // the server keeps every folder after premium ends, the lock is only the client's
+            for (filter in list) filter.locked = false
+            return ArrayList()
+        }
+        return list
+    }
+
+    /** The line under a folder in the folder list: where its chats live. */
+    @JvmStatic
+    fun status(account: Int, filter: DialogFilter, info: CharSequence): CharSequence {
+        if (isLocal(filter.id)) return "$info · " + LocaleController.getString(R.string.TeleFolderLocal)
+        if (!enabled() || filter.id == 0) return info
+        val state = state(account) ?: return info
+        val count = synchronized(state) { state.overflow[filter.id]?.let { it.always.size + it.never.size } ?: 0 }
+        return if (count > 0) "$info · " + LocaleController.formatString(R.string.TeleFolderOverflow, count) else info
+    }
+}
