From: tangenx <me@tangenx.dev>
Date: Wed, 21 Oct 2026 23:24:51 +0300
Subject: [PATCH 113/143] feat: hide the collectible status hint

---
 .../src/main/java/org/telegram/ui/ProfileActivity.java     | 7 +++++++
 TMessagesProj/src/main/java/tele/TeleConfig.kt             | 2 ++
 TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt | 1 +
 .../src/main/java/tele/ui/settings/TeleSettingsActivity.kt | 4 +++-
 4 files changed, 13 insertions(+), 1 deletion(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/ProfileActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/ProfileActivity.java
index 70b777874..ca95cc0d6 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/ProfileActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/ProfileActivity.java
@@ -16875,6 +16875,13 @@ public class ProfileActivity extends BaseFragment implements NotificationCenter.
 
     public void updateCollectibleHint() {
         tele_updateVerifyHint();
+        if (tele.TeleConfig.HIDE_COLLECTIBLE_HINT.getValue()) {
+            if (collectibleHint != null) {
+                collectibleHint.setAlpha(0f);
+                collectibleHintVisible = false;
+            }
+            return;
+        }
         if (collectibleHint == null) return;
         collectibleHint.setJointPx(0, -collectibleHint.getPaddingLeft() + nameTextView[1].getX() + nameTextView[1].getRightDrawableX() * nameTextView[1].getScaleX());
         final float expanded = AndroidUtilities.lerp(expandAnimatorValues, currentExpanAnimatorFracture);
diff --git a/TMessagesProj/src/main/java/tele/TeleConfig.kt b/TMessagesProj/src/main/java/tele/TeleConfig.kt
index 18a5de185..4562eaffe 100644
--- a/TMessagesProj/src/main/java/tele/TeleConfig.kt
+++ b/TMessagesProj/src/main/java/tele/TeleConfig.kt
@@ -206,6 +206,8 @@ object TeleConfig {
     val HIDE_GIFT_BUTTON = BoolItem("hide_gift_button", false)
     @JvmField
     val HIDE_SIMILAR_CHANNELS = BoolItem("hide_similar_channels", false)
+    @JvmField
+    val HIDE_COLLECTIBLE_HINT = BoolItem("hide_collectible_hint", false)
 
     private var prefs: SharedPreferences? = null
 
