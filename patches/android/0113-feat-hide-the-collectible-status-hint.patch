             "Peek at hidden last seen" to "Briefly show the last seen of a peer that hides it, then restore your own rule. The peer can see that you looked.",
-            "Streamer mode" to "Block screen capture in every window and hide the notification previews."
+            "Streamer mode" to "Block screen capture in every window and hide the notification previews.",
         )
 
         private fun toggle(title: String, item: Item<*>) = Row(TYPE_TOGGLE, title = title, subtitle = DESCRIPTIONS[title], item = item)
@@ -470,6 +471,7 @@ class TeleSettingsActivity @JvmOverloads constructor(private val mode: String =
                 toggle("View messages as TL", TeleConfig.VIEW_AS_TL),
                 toggle("Save messages as a picture", TeleConfig.SHOT),
                 toggle("Hide similar channels", TeleConfig.HIDE_SIMILAR_CHANNELS),
+                toggle("Hide the collectible status hint", TeleConfig.HIDE_COLLECTIBLE_HINT),
                 Row(TYPE_SHADOW),
