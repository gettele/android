+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt
@@ -132,6 +132,7 @@ object TeleSearch {
             section(1109, "Attach media above the field (beta)", "sending", TeleSettingsActivity.MODE_SENDING),
             section(1120, "Hide the gift button in the message field", "sending", TeleSettingsActivity.MODE_SENDING),
             section(1121, "Hide similar channels", "interface", TeleSettingsActivity.MODE_INTERFACE),
+            section(1122, "Hide the collectible status hint", "interface", TeleSettingsActivity.MODE_INTERFACE),
             section(GUID_UPDATES, "Update automatically", "updates", TeleSettingsActivity.MODE_ROOT),
             section(GUID_UPDATES + 1, "Check for updates", "updates", TeleSettingsActivity.MODE_ROOT),
             section(GUID_UPDATES + 2, "Show what's new after updates", "updates", TeleSettingsActivity.MODE_ROOT),
