             "View messages as TL" to "Fetch the current Telegram object and open it as TL.",
             "Save messages as a picture" to "Export a message or selection as an image.",
             "Hide similar channels" to "Do not ask the server for similar channels and hide the ones it already sent.",
+            "Hide the collectible status hint" to "Do not show the collectible hint over the profile name.",
             "Pick brush colors from the image" to "Pick a color directly from the edited image.",
             "Hide stories" to "Hide stories and story-sharing entry points.",
             "Watch stories invisibly" to "View stories without appearing in the viewer list.",
@@ -383,7 +384,7 @@ class TeleSettingsActivity @JvmOverloads constructor(private val mode: String =
             "Hide messages by words" to "Hide incoming messages that match a word or a java regex.",
