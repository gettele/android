From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Fri, 23 Oct 2026 14:44:45 +0300
Subject: [PATCH 161/161] fix: hide the group switch divider

---
 .../main/java/org/telegram/ui/Cells/TextCheckCell2.java    | 7 ++++++-
 .../src/main/java/tele/ui/settings/TeleSettingsActivity.kt | 1 +
 2 files changed, 7 insertions(+), 1 deletion(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Cells/TextCheckCell2.java b/TMessagesProj/src/main/java/org/telegram/ui/Cells/TextCheckCell2.java
index 4576e19d5..7931b7625 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Cells/TextCheckCell2.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Cells/TextCheckCell2.java
@@ -51,7 +51,12 @@ public class TextCheckCell2 extends FrameLayout {
     private Runnable collapseSwitchClick;
 
     private boolean collapseAlignToTitle;
+    private boolean collapseDivider = true;
 
+    public void setCollapseDividerVisible(boolean visible) {
+        collapseDivider = visible;
+        if (checkBoxClickArea != null) checkBoxClickArea.invalidate();
+    }
 
     public void setCollapseArrow(String text, boolean collapsed, Runnable onCheckClick) {
         if (collapseViewContainer == null) {
@@ -78,7 +83,7 @@ public class TextCheckCell2 extends FrameLayout {
                 @Override
                 protected void onDraw(Canvas canvas) {
                     super.onDraw(canvas);
-                    canvas.drawLine(0, dp(14), 2, getMeasuredHeight()- dp(14), Theme.dividerPaint);
+                    if (collapseDivider) canvas.drawLine(0, dp(14), 2, getMeasuredHeight()- dp(14), Theme.dividerPaint);
                 }
             };
             checkBoxClickArea.setBackground(Theme.createSelectorDrawable(Theme.getColor(Theme.key_listSelector), 2));
diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
index 956ed8db2..44a3a6bf0 100644
--- a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
@@ -331,6 +331,7 @@ class TeleSettingsActivity @JvmOverloads constructor(private val mode: String =
                                  bind = Utilities.Callback { view: View ->
                                      val cell = view as TextCheckCell2
                                     cell.setCollapseSwitchClick { setGroupValue(row, !(row.item!!.value as Boolean)) }
+                                    cell.setCollapseDividerVisible(false)
                                     if (!row.subtitle.isNullOrEmpty()) {
                                          cell.setTextAndValue(displayTitle(title), row.subtitle, true, true)
                                      }
