From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Mon, 19 Oct 2026 01:59:10 +0300
Subject: [PATCH] feat: offer to send crash reports on start

---
 .../java/org/telegram/ui/LaunchActivity.java  |  1 +
 .../src/main/java/tele/helpers/TeleCrash.kt   | 54 ++++++++++++++++---
 2 files changed, 48 insertions(+), 7 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/LaunchActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/LaunchActivity.java
index 73229daa8..68abfd6db 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/LaunchActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/LaunchActivity.java
@@ -7007,6 +7007,7 @@ public class LaunchActivity extends BasePermissionsActivity implements INavigati
         onPasscodeResume();
         if (passcodeDialog == null || passcodeDialog.passcodeView.getVisibility() != View.VISIBLE) {
             actionBarLayout.onResume();
+            tele.helpers.TeleCrash.offerPending(this);
             if (AndroidUtilities.isTablet()) {
                 if (rightActionBarLayout != null) {
                     rightActionBarLayout.onResume();
diff --git a/TMessagesProj/src/main/java/tele/helpers/TeleCrash.kt b/TMessagesProj/src/main/java/tele/helpers/TeleCrash.kt
index fa5a184ea..0161b0897 100644
--- a/TMessagesProj/src/main/java/tele/helpers/TeleCrash.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/TeleCrash.kt
@@ -1,10 +1,14 @@
 package tele.helpers
 
+import android.app.Activity
 import android.content.Context
+import android.os.Build
+import org.telegram.messenger.AndroidUtilities
 import org.telegram.messenger.ApplicationLoader
 import org.telegram.messenger.BuildVars
 import org.telegram.messenger.FileLog
-import org.telegram.messenger.UserConfig
+import org.telegram.ui.ActionBar.AlertDialog
+import tele.TeleBuild
 import tele.TeleConfig
 import java.io.File
 import java.io.PrintWriter
@@ -12,6 +16,7 @@ import java.io.StringWriter
 
 object TeleCrash {
     private const val CRASH_FILE = "tele_crash_report.txt"
+    private var offered = false
 
     @JvmStatic
     fun crashFile(context: Context = ApplicationLoader.applicationContext): File =
@@ -34,13 +39,23 @@ object TeleCrash {
         }
     }
 
+    // like desktop's CollectCrashReports: only while the tele server is on
+    private fun collecting(): Boolean = TeleConfig.SEND_CRASH_REPORTS.value && TeleServer.serverUrl().isNotEmpty()
+
+    private fun versionCode(context: Context): Long = runCatching {
+        val info = context.packageManager.getPackageInfo(context.packageName, 0)
+        if (Build.VERSION.SDK_INT >= 28) info.longVersionCode else info.versionCode.toLong()
+    }.getOrDefault(0L)
+
     private fun writeReport(context: Context, thread: Thread, throwable: Throwable) {
-        if (!TeleConfig.SEND_CRASH_REPORTS.value) return
+        if (!collecting()) return
         val sw = StringWriter()
         throwable.printStackTrace(PrintWriter(sw))
         val report = buildString {
             appendLine("platform: Android")
-            appendLine("version: ${BuildVars.BUILD_VERSION_STRING}")
+            appendLine("version: ${BuildVars.BUILD_VERSION_STRING} (${versionCode(context)})")
+            appendLine("tele: ${TeleBuild.BUILD}")
+            appendLine("device: ${Build.MANUFACTURER} ${Build.MODEL}, android ${Build.VERSION.RELEASE} (sdk ${Build.VERSION.SDK_INT})")
             appendLine("thread: ${thread.name}")
             appendLine("report:")
             appendLine(sw.toString())
@@ -48,6 +63,23 @@ object TeleCrash {
         crashFile(context).writeText(report)
     }
 
+    // the next start after a crash asks before anything leaves the device, like desktop's crash window
+    @JvmStatic
+    fun offerPending(activity: Activity) {
+        if (offered || !hasPending(activity)) return
+        offered = true
+        if (!collecting()) {
+            clearPending(activity)
+            return
+        }
+        AlertDialog.Builder(activity)
+            .setTitle("tele crashed")
+            .setMessage("the last time tele was launched it crashed. send the crash report to the tele server?")
+            .setPositiveButton("send") { _, _ -> sendPendingAsync(activity) }
+            .setNegativeButton("don't send") { _, _ -> clearPending(activity) }
+            .show()
+    }
+
     @JvmStatic
     fun clearPending(context: Context = ApplicationLoader.applicationContext) {
         val f = crashFile(context)
@@ -55,9 +87,10 @@ object TeleCrash {
     }
 
     @JvmStatic
-    fun sendPendingAsync(context: Context = ApplicationLoader.applicationContext, url: String = TeleConfig.TELE_SERVER_URL.value) {
-        val base = url.trim().trimEnd('/')
+    fun sendPendingAsync(context: Context = ApplicationLoader.applicationContext, url: String = TeleServer.serverUrl()) {
+        val base = url
         if (base.isEmpty() || !hasPending(context)) return
+        val appContext = context.applicationContext
         val report = runCatching { crashFile(context).readText() }.getOrNull() ?: return
         Thread {
             var connection: java.net.HttpURLConnection? = null
@@ -76,7 +109,7 @@ object TeleCrash {
                     w.write("Android\r\n")
                     w.write("--$boundary\r\n")
                     w.write("Content-Disposition: form-data; name=\"version\"\r\n\r\n")
-                    w.write("7112\r\n")
+                    w.write("${versionCode(context)}\r\n")
                     w.write("--$boundary\r\n")
                     w.write("Content-Disposition: form-data; name=\"report\"; filename=\"report.txt\"\r\n")
                     w.write("Content-Type: text/plain; charset=UTF-8\r\n\r\n")
@@ -86,12 +119,19 @@ object TeleCrash {
                     w.flush()
                 }
                 FileLog.d("TeleCrash: server response ${connection.responseCode}")
-                if (connection.responseCode in 200..299) clearPending(context)
+                val sent = connection.responseCode in 200..299
+                if (sent) clearPending(context)
+                toast(appContext, if (sent) "crash report sent" else "couldn't send the crash report")
             } catch (e: Exception) {
                 FileLog.e(e)
+                toast(appContext, "couldn't send the crash report")
             } finally {
                 connection?.disconnect()
             }
         }.start()
     }
+
+    private fun toast(context: Context, text: String) {
+        AndroidUtilities.runOnUIThread { android.widget.Toast.makeText(context, text, android.widget.Toast.LENGTH_SHORT).show() }
+    }
 }
