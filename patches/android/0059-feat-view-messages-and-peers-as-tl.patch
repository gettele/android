diff --git a/TMessagesProj/src/main/java/tele/helpers/ViewAsTl.kt b/TMessagesProj/src/main/java/tele/helpers/ViewAsTl.kt
new file mode 100644
index 000000000..fb131cc3a
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/ViewAsTl.kt
@@ -0,0 +1,219 @@
+package tele.helpers
+
+import android.content.Intent
+import android.util.Base64
+import androidx.core.content.FileProvider
+import java.io.ByteArrayOutputStream
+import java.io.File
+import java.io.FileOutputStream
+import java.util.zip.Deflater
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.ApplicationLoader
+import org.telegram.messenger.ChatObject
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.browser.Browser
+import org.telegram.tgnet.SerializedData
+import org.telegram.tgnet.TLObject
+import org.telegram.tgnet.TLRPC
+import org.telegram.ui.ActionBar.BaseFragment
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Components.BulletinFactory
+import tele.TeleConfig
+
+object ViewAsTl {
+    private const val PACK_FROM = 512
+    private const val MAX_DIRECT_URL_LENGTH = 2000
+    private const val SCHEMA_URL = "https://schema.jppgr.am/embed"
+
+    @JvmStatic
+    fun isEnabled(): Boolean = TeleConfig.VIEW_AS_TL.value
+
+    @JvmStatic
+    fun viewMessage(fragment: BaseFragment, dialogId: Long, messageId: Int) {
+        if (!isEnabled() || messageId <= 0 || fragment.parentActivity == null) {
+            return
+        }
+
+        val controller = fragment.messagesController
+        val request: TLObject
+        if (dialogId < 0) {
+            val chat = controller.getChat(-dialogId)
+            if (chat == null) {
+                showError(fragment, LocaleController.getString(org.telegram.messenger.R.string.TeleViewAsTlError))
+                return
+            }
+            if (ChatObject.isChannel(chat)) {
+                val channel = TLRPC.TL_channels_getMessages()
+                channel.channel = org.telegram.messenger.MessagesController.getInputChannel(chat)
+                channel.id.add(messageId)
+                request = channel
+            } else {
+                val messages = TLRPC.TL_messages_getMessages()
+                messages.id.add(messageId)
+                request = messages
+            }
+        } else {
+            val messages = TLRPC.TL_messages_getMessages()
+            messages.id.add(messageId)
+            request = messages
+        }
+
+        val requestId = fragment.connectionsManager.sendRequest(request) { response, error ->
+            AndroidUtilities.runOnUIThread {
+                if (error != null) {
+                    BulletinFactory.of(fragment).showForError(error)
+                    return@runOnUIThread
+                }
+                val messages = response as? TLRPC.messages_Messages
+                val message = messages?.messages?.firstOrNull { it.id == messageId }
+                if (message == null) {
+                    showError(fragment, LocaleController.getString(org.telegram.messenger.R.string.TeleViewAsTlError))
+                } else {
+                    open(fragment, message)
+                }
+            }
+        }
+        fragment.connectionsManager.bindRequestToGuid(requestId, fragment.getClassGuid())
+    }
+
+    @JvmStatic
+    fun viewPeer(fragment: BaseFragment, userId: Long, chatId: Long) {
+        if (!isEnabled() || fragment.parentActivity == null) {
+            return
+        }
+        val controller = fragment.messagesController
+        val request: TLObject
+        if (userId != 0L) {
+            val user = controller.getUser(userId)
+            if (user == null) {
+                showError(fragment, LocaleController.getString(org.telegram.messenger.R.string.TeleViewAsTlError))
+                return
+            }
+            request = TLRPC.TL_users_getFullUser().apply {
+                id = controller.getInputUser(user)
+            }
+        } else if (chatId != 0L) {
+            val chat = controller.getChat(chatId)
+            if (chat == null) {
+                showError(fragment, LocaleController.getString(org.telegram.messenger.R.string.TeleViewAsTlError))
+                return
+            }
+            request = if (ChatObject.isChannel(chat)) {
+                TLRPC.TL_channels_getFullChannel().apply {
+                    channel = org.telegram.messenger.MessagesController.getInputChannel(chat)
+                }
+            } else {
+                TLRPC.TL_messages_getFullChat().apply {
+                    this.chat_id = chat.id
+                }
+            }
+        } else {
+            return
+        }
+        val requestId = fragment.connectionsManager.sendRequest(request) { response, error ->
+            AndroidUtilities.runOnUIThread {
+                if (error != null) {
+                    BulletinFactory.of(fragment).showForError(error)
+                } else if (response != null) {
+                    open(fragment, response)
+                } else {
+                    showError(fragment, LocaleController.getString(org.telegram.messenger.R.string.TeleViewAsTlError))
+                }
+            }
+        }
+        fragment.connectionsManager.bindRequestToGuid(requestId, fragment.getClassGuid())
+    }
+
+    @JvmStatic
+    fun open(fragment: BaseFragment, value: TLObject) {
+        val bytes = serialize(value)
+        if (bytes.isEmpty()) {
+            showError(fragment, LocaleController.getString(org.telegram.messenger.R.string.TeleViewAsTlError))
+            return
+        }
+        val packed = if (bytes.size > PACK_FROM) rawDeflate(bytes) else null
+        val compressed = packed != null && packed.size < bytes.size
+        val payload = if (compressed) packed!! else bytes
+        val data = Base64.encodeToString(
+            payload,
+            Base64.URL_SAFE or Base64.NO_WRAP or Base64.NO_PADDING
+        )
+        val theme = if (Theme.isCurrentThemeDark()) "dark" else "light"
+        val url = buildString {
+            append(SCHEMA_URL)
+            append("#layer=")
+            append(TLRPC.LAYER)
+            append("&theme=")
+            append(theme)
+            if (compressed) {
+                append("&z=1")
+            }
+            append("&data=")
+            append(data)
+        }
+        if (url.length > MAX_DIRECT_URL_LENGTH) {
+            openRedirect(fragment, url)
+        } else {
+            Browser.openUrl(fragment.parentActivity, url)
+        }
+    }
+
+    private fun openRedirect(fragment: BaseFragment, url: String) {
+        runCatching {
+            val directory = ApplicationLoader.getFilesDirFixed("cache/tele-tl")
+            val file = File(directory, "redirect-${System.currentTimeMillis()}.html")
+            FileOutputStream(file).use { output ->
+                val escaped = url.replace("\\", "\\\\").replace("\"", "\\\"")
+                val html = """<!doctype html><meta charset="utf-8"><script>location.replace("$escaped")</script><a href="$url">open</a>"""
+                output.write(html.toByteArray())
+            }
+            val uri = FileProvider.getUriForFile(
+                fragment.parentActivity,
+                ApplicationLoader.getApplicationId() + ".provider",
+                file
+            )
+            val intent = Intent(Intent.ACTION_VIEW, uri)
+                .setDataAndType(uri, "text/html")
+                .addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
+            fragment.parentActivity.startActivity(intent)
+        }.onFailure {
+            showError(fragment, LocaleController.getString(org.telegram.messenger.R.string.TeleViewAsTlError))
+        }
+    }
+
+    private fun serialize(value: TLObject): ByteArray {
+        return runCatching {
+            val data = SerializedData(value.objectSize)
+            value.serializeToStream(data)
+            val bytes = data.toByteArray()
+            data.cleanup()
+            bytes
+        }.getOrDefault(ByteArray(0))
+    }
+
+    private fun rawDeflate(bytes: ByteArray): ByteArray? {
+        val deflater = Deflater(Deflater.BEST_COMPRESSION, true)
+        return try {
+            deflater.setInput(bytes)
+            deflater.finish()
+            val output = ByteArrayOutputStream(bytes.size)
+            val buffer = ByteArray(1024)
+            while (!deflater.finished()) {
+                val count = deflater.deflate(buffer)
+                if (count <= 0) {
+                    break
+                }
+                output.write(buffer, 0, count)
+            }
+            output.toByteArray()
+        } finally {
+            deflater.end()
+        }
+    }
+
+    private fun showError(fragment: BaseFragment, message: String) {
+        if (fragment.parentActivity != null) {
+            BulletinFactory.of(fragment).showForError(message)
+        }
+    }
+}
