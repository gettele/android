From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Mon, 5 Oct 2026 06:52:55 +0300
Subject: [PATCH] feat: call the app tele in its own texts

Stock strings that name the app itself are overridden from the app
module, which wins over the library at merge time, so strings.xml stays
untouched. Service references (Telegram Premium, moderators, FAQ links)
and on-disk folder names are deliberately left alone.

Constraint: never edit stock strings.xml
Rejected: editing values-*/strings.xml per locale | same stock-file rule
Confidence: medium
Scope-risk: narrow
---
 .../src/main/res/values/tele_strings.xml      | 32 +++++++++++++++++++
 1 file changed, 32 insertions(+)
 create mode 100644 TMessagesProj_App/src/main/res/values/tele_strings.xml

diff --git a/TMessagesProj_App/src/main/res/values/tele_strings.xml b/TMessagesProj_App/src/main/res/values/tele_strings.xml
new file mode 100644
index 000000000..50421c240
--- /dev/null
+++ b/TMessagesProj_App/src/main/res/values/tele_strings.xml
@@ -0,0 +1,32 @@
+<?xml version="1.0" encoding="utf-8"?>
+<!-- Overrides of stock strings where "Telegram" names the app itself.
+     The app module wins over the library at resource merge time, so the
+     stock strings.xml stays untouched. Service references (Telegram
+     Premium, moderators, FAQ links) are deliberately left alone. -->
+<resources>
+    <string name="AppNameBeta">tele Beta</string>
+    <string name="Page1Title">tele</string>
+    <string name="NotificationHiddenName">tele</string>
+    <string name="NotificationHiddenChatName">tele</string>
+    <string name="SecretChatName">tele</string>
+    <string name="AppLocked">tele Locked</string>
+    <string name="TelegramTones">tele tones</string>
+    <string name="CallText">tele will call you in %1$d:%2$02d</string>
+    <string name="CallAvailableIn2">tele can call you in %1$d:%2$02d</string>
+    <string name="StorageUsageTelegram">tele uses %s of your device storage.</string>
+    <string name="StorageUsageTelegramLess">tele uses %s of your device storage.</string>
+    <string name="DownloadedFilesMessage">tele lets you store all documents you send and receive in the cloud and save storage space on your device.</string>
+    <string name="SdCardErrorDescription">tele is unable to save data on your SD card.</string>
+    <string name="PermissionNoLocation">tele needs access to your location so that you can share it with your friends.</string>
+    <string name="PermissionDrawAboveOtherApps">tele needs access to draw above other apps to play videos in Picture-in-Picture mode.</string>
+    <string name="VoipNeedCameraPermission">tele needs access to your camera so that you can make video calls.</string>
+    <string name="VoipInCallBranding">tele Call</string>
+    <string name="VoipInVideoCallBranding">tele Video Call</string>
+    <string name="VoipInCallBrandingWithName">tele Call to %s</string>
+    <string name="VoipInVideoCallBrandingWithName">tele Video Call to %s</string>
+    <string name="CallViaTelegram">tele Call</string>
+    <string name="VideoCallViaTelegram">tele Video Call</string>
+    <string name="VoiceCallViaTelegram">tele Voice Call</string>
+    <string name="MapPreviewProviderTelegram">tele</string>
+    <string name="SearchPostsHeaderNews">tele News</string>
+</resources>
