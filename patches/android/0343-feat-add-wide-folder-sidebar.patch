@@ -0,0 +1,171 @@
+package tele.ui
+
+import android.content.Context
+import android.graphics.PorterDuff
+import android.graphics.PorterDuffColorFilter
+import android.text.TextUtils
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.View
+import android.view.ViewGroup
+import android.widget.FrameLayout
+import android.widget.ImageView
+import android.widget.TextView
+import androidx.recyclerview.widget.LinearLayoutManager
+import androidx.recyclerview.widget.RecyclerView
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.Emoji
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.MessagesController
+import org.telegram.messenger.MessagesStorage
+import org.telegram.messenger.R
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Components.LayoutHelper
+import tele.TeleConfig
+import tele.helpers.FolderIcons
+import tele.helpers.LocalFolders
+import tele.helpers.TeleCounters
+
+class TeleFolderSidebar(
+    context: Context,
+    private val resourcesProvider: Theme.ResourcesProvider?
+) : FrameLayout(context) {
+
+    fun interface OnFolderClickListener {
+        fun onFolderClick(index: Int)
+    }
+
+    private data class Item(val filter: MessagesController.DialogFilter, val unread: Int)
+
+    private val items = ArrayList<Item>()
+    private var account = 0
+    private var selectedIndex = 0
+    private var listener: OnFolderClickListener? = null
+
+    private val list = RecyclerView(context)
+    private val adapter = FolderAdapter()
+
+    init {
+        setBackgroundColor(color(Theme.key_windowBackgroundWhite))
+        list.layoutManager = LinearLayoutManager(context, LinearLayoutManager.VERTICAL, false)
+        list.adapter = adapter
+        list.clipToPadding = false
+        list.setPadding(0, AndroidUtilities.dp(4f), 0, AndroidUtilities.dp(4f))
+        addView(list, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.MATCH_PARENT.toFloat()))
+        val divider = View(context)
+        divider.setBackgroundColor(color(Theme.key_divider))
+        addView(divider, LayoutHelper.createFrame(1f, LayoutHelper.MATCH_PARENT.toFloat(), Gravity.RIGHT))
+    }
+
+    fun setOnFolderClickListener(value: OnFolderClickListener?) {
+        listener = value
+    }
+
+    fun setFolders(filters: List<MessagesController.DialogFilter>, account: Int, selected: Int) {
+        this.account = account
+        val nextSelected = selected.coerceIn(0, (filters.size - 1).coerceAtLeast(0))
+        val structureChanged = items.size != filters.size || items.indices.any { items[it].filter !== filters[it] }
+        val selectionChanged = selectedIndex != nextSelected
+        selectedIndex = nextSelected
+        items.clear()
+        for (filter in filters) {
+            val unread = if (TeleCounters.hideFolders()) 0 else if (filter.isDefault) {
+                MessagesStorage.getInstance(account).mainUnreadCount
+            } else {
+                LocalFolders.unreadOf(account, filter)
+            }
+            items.add(Item(filter, unread.coerceAtLeast(0)))
+        }
+        adapter.notifyDataSetChanged()
+        if (items.isNotEmpty() && (structureChanged || selectionChanged)) list.scrollToPosition(selectedIndex)
+    }
+
+    fun setSelectedFolder(index: Int) {
+        if (index == selectedIndex || index < 0 || index >= items.size) return
+        val previous = selectedIndex
+        selectedIndex = index
+        adapter.notifyItemChanged(previous)
+        adapter.notifyItemChanged(index)
+        list.smoothScrollToPosition(index)
+    }
+
+    private fun color(key: Int) = Theme.getColor(key, resourcesProvider)
+
+    private inner class FolderAdapter : RecyclerView.Adapter<FolderHolder>() {
+        override fun onCreateViewHolder(parent: ViewGroup, viewType: Int): FolderHolder {
+            val row = FrameLayout(context)
+            row.layoutParams = RecyclerView.LayoutParams(
+                ViewGroup.LayoutParams.MATCH_PARENT,
+                AndroidUtilities.dp(58f)
+            ).apply {
+                leftMargin = AndroidUtilities.dp(6f)
+                rightMargin = AndroidUtilities.dp(6f)
+                topMargin = AndroidUtilities.dp(2f)
+                bottomMargin = AndroidUtilities.dp(2f)
+            }
+            val icon = TextView(context)
+            icon.gravity = Gravity.CENTER
+            icon.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 23f)
+            row.addView(icon, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.MATCH_PARENT.toFloat()))
+            val badge = TextView(context)
+            badge.gravity = Gravity.CENTER
+            badge.setTextSize(TypedValue.COMPLEX_UNIT_DIP, 10f)
+            badge.typeface = AndroidUtilities.bold()
+            badge.setTextColor(color(Theme.key_featuredStickers_buttonText))
+            badge.minWidth = AndroidUtilities.dp(18f)
+            badge.setPadding(AndroidUtilities.dp(4f), 0, AndroidUtilities.dp(4f), 0)
+            badge.background = Theme.createRoundRectDrawable(AndroidUtilities.dp(9f), color(Theme.key_featuredStickers_unread))
+            row.addView(badge, LayoutHelper.createFrame(LayoutHelper.WRAP_CONTENT, 18f, Gravity.TOP or Gravity.RIGHT, 0f, 3f, 1f, 0f))
+            val lock = ImageView(context)
+            lock.setImageResource(R.drawable.other_lockedfolders)
+            lock.colorFilter = PorterDuffColorFilter(color(Theme.key_windowBackgroundWhiteGrayText), PorterDuff.Mode.SRC_IN)
+            row.addView(lock, LayoutHelper.createFrame(12, 12f, Gravity.BOTTOM or Gravity.RIGHT, 0f, 0f, 5f, 5f))
+            return FolderHolder(row, icon, badge, lock)
+        }
+
+        override fun onBindViewHolder(holder: FolderHolder, position: Int) {
+            val item = items[position]
+            val filter = item.filter
+            val selected = position == selectedIndex
+            val name = if (filter.isDefault) LocaleController.getString(R.string.FilterAllChats) else filter.name
+            val accent = color(Theme.key_windowBackgroundWhiteBlueText)
+            holder.row.isSelected = selected
+            holder.row.background = Theme.createSimpleSelectorRoundRectDrawable(
+                AndroidUtilities.dp(12f),
+                if (selected) Theme.multAlpha(accent, 0.14f) else 0,
+                color(Theme.key_listSelector)
+            )
+            holder.row.contentDescription = if (item.unread > 0) {
+                TextUtils.concat(name, "\n", LocaleController.formatPluralString("AccDescrUnreadCount", item.unread))
+            } else {
+                name
+            }
+            holder.row.setOnClickListener {
+                val index = holder.adapterPosition
+                if (index != RecyclerView.NO_POSITION) listener?.onFolderClick(index)
+            }
+            val folderIcon = if (Emoji.isValidEmoji(filter.name)) filter.name else FolderIcons.emoji(account, filter)
+            holder.icon.text = Emoji.replaceEmoji(folderIcon, holder.icon.paint.fontMetricsInt, false)
+            holder.icon.alpha = if (filter.locked) 0.55f else 1f
+            holder.badge.visibility = if (item.unread > 0) View.VISIBLE else View.GONE
+            holder.badge.text = if (item.unread > 99) "99+" else LocaleController.formatNumber(item.unread.toLong(), ',')
+            holder.lock.visibility = if (filter.locked) View.VISIBLE else View.GONE
+        }
+
+        override fun getItemCount() = items.size
+    }
+
+    private class FolderHolder(
+        val row: FrameLayout,
+        val icon: TextView,
+        val badge: TextView,
+        val lock: ImageView
+    ) : RecyclerView.ViewHolder(row)
+
+    companion object {
+        const val WIDTH_DP = 72
+
+        @JvmStatic
+        fun enabled(): Boolean = TeleConfig.FOLDER_SIDEBAR.value && AndroidUtilities.isTablet()
+    }
+}
