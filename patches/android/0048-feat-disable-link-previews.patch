             section(GUID_PRIVACY, "tele privacy", "privacy", TeleSettingsActivity.MODE_PRIVACY),
             section(GUID_PRIVACY + 1, "hide stories", "privacy", TeleSettingsActivity.MODE_PRIVACY),
diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleSettingsActivity.kt
index 8aa045d1c..541cae57f 100644
