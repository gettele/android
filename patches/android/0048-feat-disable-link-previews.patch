             section(GUID_PRIVACY + 16, "rewrite pasted links by rules", "privacy", TeleSettingsActivity.MODE_PRIVACY),
             ProfileActivity.SearchAdapter.SearchResult(GUID_PRIVACY + 17, "link rewrite rules", icon) { fragment.presentFragment(TeleRulesActivity()) },
