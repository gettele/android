From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Mon, 5 Oct 2026 22:28:00 +0300
Subject: [PATCH 048/128] feat: disable link previews

no_link_previews gates isMessageWebPageSearchEnabled, the single choke
point that both triggers the preview search on typing and carries the
search flag into saved drafts, so suppressed previews stay suppressed
when the message is sent from a draft. Manually attached previews (which
set the web page directly) keep working.

Constraint: partial by plan - force-own-preview and not-for-pasted stay open
Confidence: high
Scope-risk: narrow
---
 .../org/telegram/ui/Components/ChatActivityEnterView.java  | 7 +++++--
 TMessagesProj/src/main/java/tele/TeleConfig.kt             | 2 ++
 TMessagesProj/src/main/java/tele/ui/settings/TeleSearch.kt | 1 +
 .../src/main/java/tele/ui/settings/TeleSettingsActivity.kt | 1 +
 4 files changed, 9 insertions(+), 2 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Components/ChatActivityEnterView.java b/TMessagesProj/src/main/java/org/telegram/ui/Components/ChatActivityEnterView.java
index 881ffb001..eb803f95b 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Components/ChatActivityEnterView.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Components/ChatActivityEnterView.java
@@ -5961,7 +5961,7 @@ public class ChatActivityEnterView extends FrameLayout implements
                 if (delegate != null) {
                     if (!ignoreTextChange) {
                         if (before > count + 1 || (count - before) > 2 || TextUtils.isEmpty(charSequence)) {
-                            messageWebPageSearch = true;
+                            messageWebPageSearch = !tele.TeleConfig.NO_LINK_PREVIEWS.getValue();
                         }
                         delegate.onTextChanged(charSequence, before > count + 1 || (count - before) > 2, false);
                     }
@@ -6966,6 +6966,9 @@ public class ChatActivityEnterView extends FrameLayout implements
     }
 
     public boolean isMessageWebPageSearchEnabled() {
+        if (tele.TeleConfig.NO_LINK_PREVIEWS.getValue()) {
+            return false;
+        }
         return messageWebPageSearch;
     }
 
@@ -7856,7 +7859,7 @@ public class ChatActivityEnterView extends FrameLayout implements
                 if (replyToTopMsg == null && replyingTopMessage != null) {
                     replyToTopMsg = replyingTopMessage;
                 }
-                SendMessagesHelper.SendMessageParams params = SendMessagesHelper.SendMessageParams.of(message[0].toString(), dialog_id, replyingMessageObject, replyToTopMsg, messageWebPage, messageWebPageSearch, entities, null, null, notify, scheduleDate, scheduleRepeatPeriod, sendAnimationData, updateStickersOrder);
+                SendMessagesHelper.SendMessageParams params = SendMessagesHelper.SendMessageParams.of(message[0].toString(), dialog_id, replyingMessageObject, replyToTopMsg, messageWebPage, messageWebPageSearch && !tele.TeleConfig.NO_LINK_PREVIEWS.getValue(), entities, null, null, notify, scheduleDate, scheduleRepeatPeriod, sendAnimationData, updateStickersOrder);
                 params.sendMessageChatArguments = parentFragment != null ? parentFragment.getMessageChatSendParams() : null;
                 params.effect_id = effectId;
                 params.payStars = payStars;
diff --git a/TMessagesProj/src/main/java/tele/TeleConfig.kt b/TMessagesProj/src/main/java/tele/TeleConfig.kt
index a3b7c1096..e219e3317 100644
--- a/TMessagesProj/src/main/java/tele/TeleConfig.kt
+++ b/TMessagesProj/src/main/java/tele/TeleConfig.kt
@@ -116,6 +116,8 @@ object TeleConfig {
     val CLEAN_SENT_LINKS = BoolItem("clean_sent_links", false)
     @JvmField
     val REWRITE_PASTED_LINKS = BoolItem("rewrite_pasted_links", false)
+    @JvmField
+    val NO_LINK_PREVIEWS = BoolItem("no_link_previews", false)
 
     private var prefs: SharedPreferences? = null
 
