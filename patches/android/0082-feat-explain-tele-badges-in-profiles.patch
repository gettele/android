index 000000000..8ada62d79
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/ui/LeftDrawableTap.kt
@@ -0,0 +1,50 @@
+package tele.ui
+
+import android.annotation.SuppressLint
+import android.view.MotionEvent
+import android.view.View
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.ui.ActionBar.SimpleTextView
+import kotlin.math.abs
+
+// SimpleTextView only reports taps on its right drawable; this adds them for the left one without touching the stock class
+object LeftDrawableTap {
+    @JvmStatic
+    @SuppressLint("ClickableViewAccessibility")
+    fun set(view: SimpleTextView, listener: View.OnClickListener?) {
+        if (listener == null) {
+            view.setOnTouchListener(null)
+            return
+        }
+        var tracking = false
+        var downX = 0f
+        var downY = 0f
+        view.setOnTouchListener { v, e ->
+            val drawable = view.leftDrawable
+            when (e.actionMasked) {
+                MotionEvent.ACTION_DOWN -> {
+                    val b = drawable?.bounds
+                    val slop = AndroidUtilities.dp(8f)
+                    tracking = b != null && e.x >= b.left - slop && e.x <= b.right + slop && e.y >= b.top - slop && e.y <= b.bottom + slop
+                    if (tracking) {
+                        downX = e.x
+                        downY = e.y
+                        v.parent?.requestDisallowInterceptTouchEvent(true)
+                    }
+                }
+                MotionEvent.ACTION_MOVE -> if (tracking && (abs(e.x - downX) >= AndroidUtilities.touchSlop || abs(e.y - downY) >= AndroidUtilities.touchSlop)) {
+                    tracking = false
+                    v.parent?.requestDisallowInterceptTouchEvent(false)
+                    return@setOnTouchListener true
+                }
+                MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> if (tracking) {
+                    tracking = false
+                    v.parent?.requestDisallowInterceptTouchEvent(false)
+                    if (e.actionMasked == MotionEvent.ACTION_UP) listener.onClick(v)
+                    return@setOnTouchListener true
+                }
+            }
+            tracking
+        }
+    }
+}
