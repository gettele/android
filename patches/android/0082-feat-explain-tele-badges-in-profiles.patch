+    private HintView2 tele_verifyHint;
+
+    private void tele_bindVerifyHint(int a, long teleIconId, TLRPC.User user, TLRPC.Chat chat) {
+        if (a != 1) return;
+        final String description = teleIconId != 0 ? tele.helpers.TeleBadges.description(currentAccount, user, chat) : null;
+        tele.ui.LeftDrawableTap.set(nameTextView[a], description == null ? null : v -> tele_showVerifyHint(description));
+        if (description == null && tele_verifyHint != null) {
+            tele_verifyHint.hide();
+        }
+    }
+
+    private void tele_showVerifyHint(CharSequence text) {
+        if (avatarContainer2 == null || nameTextView[1] == null) return;
+        if (tele_verifyHint != null) {
+            tele_verifyHint.hide();
+        }
+        final HintView2 hint = new HintView2(getContext(), HintView2.DIRECTION_BOTTOM);
+        hint.setMultilineText(true);
+        hint.setText(text);
+        hint.setDuration(5000);
+        hint.setPadding(dp(12), 0, dp(12), 0);
+        hint.setOnHiddenListener(() -> {
+            AndroidUtilities.removeFromParent(hint);
+            if (tele_verifyHint == hint) {
+                tele_verifyHint = null;
+            }
+        });
+        avatarContainer2.addView(hint, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, 200));
+        tele_verifyHint = hint;
+        tele_updateVerifyHint();
+        hint.show();
+    }
+
+    private void tele_updateVerifyHint() {
+        final HintView2 hint = tele_verifyHint;
+        if (hint == null) return;
+        final SimpleTextView name = nameTextView[1];
+        final Drawable badge = name == null ? null : name.getLeftDrawable();
+        if (badge == null) {
+            hint.hide();
+            return;
+        }
+        final float[] point = { badge.getBounds().centerX(), badge.getBounds().top };
+        name.getMatrix().mapPoints(point);
+        hint.setJointPx(0, -hint.getPaddingLeft() + name.getLeft() + point[0]);
+        hint.setTranslationY(name.getTop() + point[1] - dp(200));
+    }
