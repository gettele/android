+    /** The folders that count against the server limit. */
+    @JvmStatic
+    fun countedFolders(list: List<DialogFilter>): Int = list.count { !isUnsorted(it.id) }
+
+    private fun unsortedFilter(): DialogFilter {
+        val filter = DialogFilter()
+        filter.id = UNSORTED_ID
+        filter.name = LocaleController.getString(R.string.TeleFolderUnsorted)
+        filter.flags = MessagesController.DIALOG_FILTER_FLAG_EXCLUDE_ARCHIVED
+        filter.color = -1
+        filter.pendingUnreadCount = -1
+        filter.unreadCount = -1
+        return filter
+    }
+
+    private class Cover(val flags: Int, val always: HashSet<Long>, val never: HashSet<Long>)
+
+    private class Covers(val print: Int, val list: List<Cover>)
+
+    private val covers = SparseArray<Covers>()
+
+    // what the other folders hold; rebuilt only when one of them changed
+    private fun coversOf(account: Int): List<Cover> {
+        val filters = ArrayList(MessagesController.getInstance(account).dialogFilters)
+        var print = 1
+        for (f in filters) {
+            if (f.id == 0 || isUnsorted(f.id)) continue
+            print = 31 * print + f.id
+            print = 31 * print + f.flags
+            print = 31 * print + f.alwaysShow.size
+            print = 31 * print + System.identityHashCode(f.alwaysShow)
+            print = 31 * print + f.neverShow.size
+            print = 31 * print + System.identityHashCode(f.neverShow)
+        }
+        synchronized(covers) {
+            val known = covers.get(account)
+            if (known != null && known.print == print) return known.list
+            val list = filters.filter { it.id != 0 && !isUnsorted(it.id) }
+                .map { Cover(it.flags, HashSet(it.alwaysShow), HashSet(it.neverShow)) }
+            covers.put(account, Covers(print, list))
+            return list
+        }
+    }
+
+    /** A chat is unsorted when it isn't archived and no other folder takes it. */
+    @JvmStatic
+    fun unsortedIncludes(account: Int, dialogId: Long, d: TLRPC.Dialog): Boolean {
+        if (d.folder_id != 0) return false
+        val controller = MessagesController.getInstance(account)
+        val type: Int
+        if (dialogId > 0) {
+            val user = controller.getUser(dialogId) ?: return false
+            if (ChatObject.isUserCollapsedInCommunity(account, user)) return false
+            type = when {
+                user.bot -> MessagesController.DIALOG_FILTER_FLAG_BOTS
+                user.self || user.contact || ContactsController.getInstance(account).isContact(dialogId) -> MessagesController.DIALOG_FILTER_FLAG_CONTACTS
+                else -> MessagesController.DIALOG_FILTER_FLAG_NON_CONTACTS
+            }
+        } else {
+            val chat = controller.getChat(-dialogId) ?: return false
+            if (ChatObject.isCommunity(chat) || ChatObject.isChatCollapsedInCommunity(account, chat)) return false
+            type = if (ChatObject.isChannel(chat) && !chat.megagroup) MessagesController.DIALOG_FILTER_FLAG_CHANNELS else MessagesController.DIALOG_FILTER_FLAG_GROUPS
+        }
+        for (cover in coversOf(account)) {
+            if (dialogId in cover.never) continue
+            if ((cover.flags and type) != 0 || dialogId in cover.always) return false
+        }
+        return true
+    }
+
+    /** The unread counter of a folder tab; the unsorted one has no stored counter, so it is counted here. */
+    @JvmStatic
+    fun unreadOf(account: Int, filter: DialogFilter): Int {
+        if (!isUnsorted(filter.id)) return filter.unreadCount
+        val controller = MessagesController.getInstance(account)
+        val accountInstance = AccountInstance.getInstance(account)
+        var count = 0
+        for (d in ArrayList(controller.allDialogs)) {
+            if (d !is TLRPC.TL_dialog) continue
+            if (controller.getDialogUnreadCount(d) <= 0 && !d.unread_mark) continue
+            var did = d.id
+            if (DialogObject.isEncryptedDialog(did)) {
+                controller.getEncryptedChat(DialogObject.getEncryptedChatId(did))?.let { did = it.user_id }
+            }
+            if (filter.includesDialog(accountInstance, did, d)) count++
+        }
+        return count
+    }
 }
