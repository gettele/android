@@ -0,0 +1,111 @@
+package tele.helpers
+
+import org.telegram.ui.Cells.ChatActionCell
+import org.telegram.ui.Cells.ChatMessageCell
+import org.telegram.ui.ChatActivity
+import org.telegram.ui.Components.chat.layouts.ChatActivitySideControlsButtonsLayout
+
+/** The bookmark marks, the bookmark button and the chat menu entry of one open chat. */
+class ChatBookmarks(private val chat: ChatActivity) {
+
+    private var lastJump = 0
+
+    // what the bubbles were last drawn for, so a rebind only happens when the marks changed
+    private var applied = 0
+
+    private fun marks(): Boolean = Bookmarks.enabled() && chat.teleBookmarkChat()
+
+    private fun buttons(): Boolean = Bookmarks.enabled() && chat.teleCornerChat()
+
+    private fun signature(): Int {
+        if (!Bookmarks.enabled()) return 0
+        val ids = Bookmarks.list(chat.currentAccount, chat.dialogId, 0L).map { it.messageId }
+        return if (ids.isEmpty()) 0 else ids.hashCode()
+    }
+
+    /** Loads what the chat needs and rebinds the bubbles when the marks arrived after them. */
+    fun start() {
+        if (!marks()) {
+            sync()
+            update(false)
+            return
+        }
+        Bookmarks.load(chat.currentAccount, chat.dialogId) {
+            sync()
+            update(false)
+        }
+    }
+
+    private fun sync() {
+        val now = signature()
+        if (now != applied) {
+            applied = now
+            chat.teleRebind()
+        }
+    }
+
+    /** A bookmark of the chat was added, removed or renamed by the chat itself: its row is already redrawn. */
+    fun changed() {
+        applied = signature()
+        update(true)
+    }
+
+    /** Messages that left the chat for good take their bookmarks with them. */
+    fun deleted(ids: Collection<Int>) {
+        if (!marks()) return
+        var dirty = false
+        for (id in ids) {
+            if (Bookmarks.find(chat.currentAccount, chat.dialogId, id) != null) {
+                Bookmarks.remove(chat.currentAccount, chat.dialogId, id)
+                dirty = true
+            }
+        }
+        if (dirty) changed()
+    }
+
+    fun update(animated: Boolean) {
+        val side = chat.teleSideControls() ?: return
+        val list = if (buttons()) Bookmarks.list(chat.currentAccount, chat.dialogId, chat.topicId) else emptyList()
+        side.showButton(ChatActivitySideControlsButtonsLayout.BUTTON_BOOKMARKS, list.isNotEmpty(), animated)
+        side.setButtonCount(ChatActivitySideControlsButtonsLayout.BUTTON_BOOKMARKS, list.size, animated)
+        chat.teleBookmarksMenu(list.isNotEmpty())
+    }
+
+    fun onClick(buttonId: Int): Boolean {
+        if (buttonId != ChatActivitySideControlsButtonsLayout.BUTTON_BOOKMARKS) return false
+        jumpToNext()
+        return true
+    }
+
+    /** Walks the bookmarks of the chat from the newest to the oldest, starting near what is on the screen. */
+    private fun jumpToNext() {
+        val list = Bookmarks.list(chat.currentAccount, chat.dialogId, chat.topicId)
+        if (list.isEmpty()) return
+        var target = list.last()
+        val range = visibleRange()
+        val last = list.indexOfFirst { it.messageId == lastJump }
+        if (last >= 0 && range != null && lastJump in range) {
+            if (last > 0) target = list[last - 1]
+        } else if (range != null) {
+            list.lastOrNull { it.messageId <= range.first }?.let { target = it }
+        }
+        lastJump = target.messageId
+        chat.scrollToMessageId(target.messageId, 0, true, 0, true, 0)
+    }
+
+    /** The ids of the messages on the screen, null when the list shows none. */
+    private fun visibleRange(): IntRange? {
+        val list = chat.chatListView ?: return null
+        var min = Int.MAX_VALUE
+        var max = 0
+        for (i in 0 until list.childCount) {
+            val view = list.getChildAt(i)
+            if (view.bottom <= 0 || view.top >= list.height) continue
+            val message = (view as? ChatMessageCell)?.messageObject ?: (view as? ChatActionCell)?.messageObject ?: continue
+            if (message.id <= 0) continue
+            min = minOf(min, message.id)
+            max = maxOf(max, message.id)
+        }
+        return if (max == 0) null else min..max
+    }
+}
