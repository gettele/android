+/** Local message bookmarks: they live in tele.db next to the other tele archives, never on the server. */
+object Bookmarks {
+
+    private const val MAX_NAME = 128
+    private const val MAX_PREVIEW = 256
+
+    class Entry(
+        val dialogId: Long,
+        val topicId: Long,
+        val messageId: Int,
+        @Volatile var name: String?,
+        val preview: String,
+        val created: Int
+    ) {
+        /** The name of the user, else the text kept from the time of the bookmark. */
+        fun title(): String {
+            val own = name
+            if (!own.isNullOrBlank()) return own
+            return preview.ifBlank { LocaleController.getString(R.string.TeleBookmarkMessage) }
+        }
+    }
+
+    private val cache = ConcurrentHashMap<Long, ConcurrentHashMap<Int, Entry>>()
+    private val loaded = ConcurrentHashMap.newKeySet<Long>()
+    private val whitespace = Regex("\\s+")
+
+    // the key is used on every bind of a message cell, so it is a plain number, not an object
+    private fun key(account: Int, dialogId: Long): Long = (account.toLong() shl 48) or (dialogId and 0xFFFFFFFFFFFFL)
+
+    @JvmStatic
+    fun enabled(): Boolean = TeleConfig.BOOKMARKS.value
+
+    /** The memory only answer for the cells: a chat that is not loaded yet shows no marks and rebinds when it is. */
+    @JvmStatic
+    fun isBookmarked(message: MessageObject, group: MessageObject.GroupedMessages?): Boolean {
+        if (!enabled() || message.id <= 0) return false
+        val map = cache[key(message.currentAccount, message.dialogId)] ?: return false
+        if (map.containsKey(message.id)) return true
+        // an album has one time line, so one mark stands for every bookmarked part of it
+        return group != null && group.messages.any { it.id > 0 && map.containsKey(it.id) }
+    }
+
+    @JvmStatic
+    fun find(account: Int, dialogId: Long, messageId: Int): Entry? = cache[key(account, dialogId)]?.get(messageId)
+
+    /** The bookmarks of a chat (all its topics) or of one topic, by message id. Needs [load] first. */
+    @JvmStatic
+    fun list(account: Int, dialogId: Long, topicId: Long): List<Entry> {
+        val all = cache[key(account, dialogId)]?.values ?: return emptyList()
+        return all.filter { topicId == 0L || it.topicId == topicId }.sortedBy { it.messageId }
+    }
+
+    @JvmStatic
+    fun isLoaded(account: Int, dialogId: Long): Boolean = loaded.contains(key(account, dialogId))
+
+    /** Reads the bookmarks of a chat off the main thread, [done] runs on the main thread. */
+    @JvmStatic
+    fun load(account: Int, dialogId: Long, done: (() -> Unit)?) {
+        val key = key(account, dialogId)
+        if (loaded.contains(key)) {
+            done?.invoke()
+            return
+        }
+        Utilities.globalQueue.postRunnable {
+            val rows = TeleDatabaseHelper.getBookmarks(account, dialogId)
+            AndroidUtilities.runOnUIThread {
+                val map = cache.getOrPut(key) { ConcurrentHashMap() }
+                // what was bookmarked while the read was running stays
+                for (row in rows) map.putIfAbsent(row.messageId, Entry(row.dialogId, row.topicId, row.messageId, row.name, row.preview, row.created))
+                loaded.add(key)
+                done?.invoke()
+            }
+        }
+    }
+
+    /** Every bookmark of the account, newest first, for the list of all of them. */
+    @JvmStatic
+    fun loadAll(account: Int, done: (List<Entry>) -> Unit) {
+        Utilities.globalQueue.postRunnable {
+            val rows = TeleDatabaseHelper.getBookmarks(account).map { Entry(it.dialogId, it.topicId, it.messageId, it.name, it.preview, it.created) }
+            AndroidUtilities.runOnUIThread { done(rows) }
+        }
+    }
+
+    @JvmStatic
+    fun count(account: Int): Int = TeleDatabaseHelper.countBookmarks(account)
+
+    private fun previewOf(message: MessageObject): String {
+        val text = message.caption?.takeIf { it.isNotEmpty() } ?: message.messageText
+        return (text?.toString() ?: "").replace(whitespace, " ").trim().take(MAX_PREVIEW)
+    }
+
+    // the topic is kept for the forums only, where the list opens the bookmark inside its topic
+    private fun topicOf(account: Int, message: MessageObject): Long {
+        val chat = MessagesController.getInstance(account).getChat(-message.dialogId)
+        return if (chat != null && ChatObject.isForum(chat)) message.topicId.coerceAtLeast(1L) else 0L
+    }
+
+    /** Whether the message can carry a bookmark: a sent message of a regular chat. */
+    @JvmStatic
+    fun allowed(message: MessageObject?): Boolean =
+        message != null && message.id > 0 && !message.scheduled && !message.isEphemeral && !message.isSponsored
+
+    @JvmStatic
+    fun add(account: Int, message: MessageObject) {
+        if (!allowed(message)) return
+        val dialogId = message.dialogId
+        val entry = Entry(dialogId, topicOf(account, message), message.id, null, previewOf(message), ConnectionsManager.getInstance(account).currentTime)
+        cache.getOrPut(key(account, dialogId)) { ConcurrentHashMap() }[entry.messageId] = entry
+        Utilities.globalQueue.postRunnable {
+            TeleDatabaseHelper.putBookmark(account, TeleDatabaseHelper.BookmarkRow(entry.dialogId, entry.topicId, entry.messageId, entry.name, entry.preview, entry.created))
+        }
+    }
+
+    @JvmStatic
+    fun remove(account: Int, dialogId: Long, messageId: Int) {
+        cache[key(account, dialogId)]?.remove(messageId)
+        Utilities.globalQueue.postRunnable { TeleDatabaseHelper.removeBookmark(account, dialogId, messageId) }
+    }
+
+    @JvmStatic
+    fun rename(account: Int, dialogId: Long, messageId: Int, name: String?) {
+        val value = name?.trim()?.take(MAX_NAME)?.ifEmpty { null }
+        cache[key(account, dialogId)]?.get(messageId)?.name = value
+        Utilities.globalQueue.postRunnable { TeleDatabaseHelper.updateBookmarkName(account, dialogId, messageId, value) }
+    }
+
+    // the message menu
+
+    /** Adds the bookmark items before Delete, so they sit with the other message actions. */
+    @JvmStatic
+    fun fillMenu(chat: ChatActivity, message: MessageObject, items: ArrayList<CharSequence>, icons: ArrayList<Int>, options: ArrayList<Int>) {
+        if (!enabled() || !chat.teleBookmarkChat() || !allowed(message)) return
+        val marked = find(chat.currentAccount, message.dialogId, message.id) != null
+        val at = options.indexOf(ChatActivity.OPTION_DELETE).let { if (it >= 0) it else options.size }
+        if (marked) {
+            items.add(at, LocaleController.getString(R.string.TeleBookmarkRename))
+            icons.add(at, R.drawable.menu_tag_rename)
+            options.add(at, ChatActivity.tele_option_rename_bookmark)
+        }
+        val index = if (marked) at + 1 else at
+        items.add(index, LocaleController.getString(if (marked) R.string.TeleBookmarkRemove else R.string.TeleBookmark))
+        icons.add(index, if (marked) R.drawable.menu_tag_delete else R.drawable.msg_saved)
+        options.add(index, ChatActivity.tele_option_bookmark)
+    }
+
+    @JvmStatic
+    fun toggle(chat: ChatActivity, message: MessageObject?) {
+        if (message == null || !enabled() || !allowed(message)) return
+        val account = chat.currentAccount
+        if (find(account, message.dialogId, message.id) != null) remove(account, message.dialogId, message.id) else add(account, message)
+        chat.teleBookmarksChanged(message.id)
+    }
+
+    @JvmStatic
+    fun showRename(chat: ChatActivity, message: MessageObject?) {
+        if (message == null) return
+        val entry = find(chat.currentAccount, message.dialogId, message.id) ?: return
+        showRenameDialog(chat, chat.currentAccount, entry) { chat.teleBookmarksChanged(entry.messageId) }
+    }
+
+    /** The name box of a bookmark, for the chat and for the list. [saved] runs after the new name is stored. */
+    fun showRenameDialog(fragment: BaseFragment, account: Int, entry: Entry, saved: () -> Unit) {
+        val activity = fragment.parentActivity ?: return
+        val provider = fragment.resourceProvider
+        val input = TeleHooks.themedField(activity, provider)
+        input.setText(entry.name)
+        input.hint = LocaleController.getString(R.string.TeleBookmarkName)
+        input.setSelection(input.text?.length ?: 0)
+        val builder = if (provider != null) AlertDialog.Builder(activity, provider) else AlertDialog.Builder(activity)
+        builder.setTitle(LocaleController.getString(R.string.TeleBookmarkRename))
+        builder.setView(TeleHooks.wrapField(activity, input))
+        builder.setPositiveButton(LocaleController.getString(R.string.Save)) { _, _ ->
+            rename(account, entry.dialogId, entry.messageId, input.text.toString())
+            // the list works with its own copy of the entry
+            entry.name = input.text.toString().trim().take(MAX_NAME).ifEmpty { null }
+            saved()
+        }
+        builder.setNegativeButton(LocaleController.getString(R.string.Cancel), null)
+        fragment.showDialog(builder.create())
+    }
+
+    // opening
+
+    /** The list of the bookmarks of the chat itself, never twice in a row. */
+    @JvmStatic
+    fun openList(chat: ChatActivity) {
+        if (chat.parentLayout?.lastFragment is TeleBookmarksActivity) return
+        chat.presentFragment(TeleBookmarksActivity.of(chat.currentAccount, chat.dialogId, chat.topicId))
+    }
+
+    /** The bookmark of a chat that is gone, or whose message is gone, leaves with it, like after a failed fetch. */
+    @JvmStatic
+    fun missing(chat: ChatActivity, messageId: Int) {
+        if (!enabled() || !chat.teleBookmarkChat() || find(chat.currentAccount, chat.dialogId, messageId) == null) return
+        remove(chat.currentAccount, chat.dialogId, messageId)
+        chat.teleBookmarksChanged(messageId)
+    }
+
+    /**
+     * Opens the chat at the message, inside its topic for a forum. A chat that is gone is told, not crashed on.
+     * The list is left on the way: the chat below it is scrolled when it is the chat of the bookmark, else a new chat takes its place.
+     */
+    @JvmStatic
+    fun open(fragment: BaseFragment, account: Int, entry: Entry) {
+        val below = fragment.parentLayout?.backgroundFragment as? ChatActivity
+        if (below != null && below.dialogId == entry.dialogId && (entry.topicId == 0L || below.topicId == 0L || below.topicId == entry.topicId)) {
+            below.scrollToMessageId(entry.messageId, 0, true, 0, true, 0)
+            fragment.finishFragment()
+            return
+        }
+        val controller = MessagesController.getInstance(account)
+        val args = Bundle()
+        if (entry.dialogId < 0) {
+            val chat = controller.getChat(-entry.dialogId)
+            if (chat == null) {
+                Toast.makeText(ApplicationLoader.applicationContext, LocaleController.getString(R.string.TeleDraftChatUnavailable), Toast.LENGTH_SHORT).show()
+                return
+            }
+            if (entry.topicId > 0 && ChatObject.isForum(chat)) {
+                val topic = controller.topicsController.findTopic(-entry.dialogId, entry.topicId)
+                if (topic != null) {
+                    ForumUtilities.getChatActivityForTopic(fragment, -entry.dialogId, topic, entry.messageId, args)?.let {
+                        fragment.presentFragment(it, true)
+                        return
+                    }
+                }
+            }
+            args.putLong("chat_id", -entry.dialogId)
+        } else {
+            if (controller.getUser(entry.dialogId) == null) {
+                Toast.makeText(ApplicationLoader.applicationContext, LocaleController.getString(R.string.TeleDraftChatUnavailable), Toast.LENGTH_SHORT).show()
+                return
+            }
+            args.putLong("user_id", entry.dialogId)
+        }
+        args.putInt("message_id", entry.messageId)
+        fragment.presentFragment(ChatActivity(args), true)
+    }
+
+    // the mark in the time of a bubble
+
+    /** The width the mark takes in the time line of a bubble. */
+    @JvmStatic
+    fun iconWidth(): Int = AndroidUtilities.dp(16f)
+
+    /** The time of a bubble with the bookmark mark before it. */
+    @JvmStatic
+    fun timeWithIcon(time: CharSequence): CharSequence {
+        val result = SpannableStringBuilder()
+        // a zero width placeholder carries the mark, the cell adds its width to the time width
+        result.append('\u200B')
+        result.setSpan(IconSpan(iconWidth()), 0, 1, Spanned.SPAN_EXCLUSIVE_EXCLUSIVE)
+        result.append(time)
+        return result
+    }
+
+    private var icon: Drawable? = null
+    private var iconColor = 0
+
+    private fun tinted(color: Int, alpha: Int): Drawable? {
+        val drawable = icon ?: ApplicationLoader.applicationContext.getDrawable(R.drawable.msg_saved)?.mutate()?.also { icon = it } ?: return null
+        if (iconColor != color) {
+            iconColor = color
+            drawable.colorFilter = PorterDuffColorFilter(color, PorterDuff.Mode.SRC_IN)
+        }
+        drawable.alpha = alpha
+        return drawable
+    }
+
+    /** The round mark beside a service message, which has no time line to carry it: before the pill, after it when there is no room. */
+    @JvmStatic
+    fun drawServiceMark(canvas: Canvas, background: Paint, darken: Paint?, color: Int, left: Float, right: Float, top: Float, size: Float, width: Float) {
+        val skip = AndroidUtilities.dp(6f)
+        val before = left - skip - size
+        val x = if (before >= 0f) before else minOf(right + skip, width - size)
+        val cx = x + size / 2f
+        val cy = top + size / 2f
+        canvas.drawCircle(cx, cy, size / 2f, background)
+        if (darken != null && darken.alpha > 0) canvas.drawCircle(cx, cy, size / 2f, darken)
+        val drawable = tinted(color, 255) ?: return
+        val half = AndroidUtilities.dp(14f) / 2f
+        drawable.setBounds((cx - half).toInt(), (cy - half).toInt(), (cx + half).toInt(), (cy + half).toInt())
+        drawable.draw(canvas)
+    }
+
+    private class IconSpan(private val width: Int) : ReplacementSpan() {
+        override fun getSize(paint: Paint, text: CharSequence?, start: Int, end: Int, fm: Paint.FontMetricsInt?): Int = width
+
+        override fun draw(canvas: Canvas, text: CharSequence?, start: Int, end: Int, x: Float, top: Int, y: Int, bottom: Int, paint: Paint) {
+            val drawable = tinted(paint.color, paint.alpha) ?: return
+            val size = AndroidUtilities.dp(14f)
+            val centerY = y + (paint.ascent() + paint.descent()) / 2f
+            val left = x.toInt()
+            val upper = (centerY - size / 2f).toInt()
+            drawable.setBounds(left, upper, left + size, upper + size)
+            drawable.draw(canvas)
+        }
+    }
+}
