diff --git a/TMessagesProj/src/main/java/tele/ui/settings/TeleBookmarksActivity.kt b/TMessagesProj/src/main/java/tele/ui/settings/TeleBookmarksActivity.kt
new file mode 100644
index 000000000..98cd593c7
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/ui/settings/TeleBookmarksActivity.kt
@@ -0,0 +1,161 @@
+package tele.ui.settings
+
+import android.content.Context
+import android.os.Bundle
+import android.util.TypedValue
+import android.view.Gravity
+import android.view.View
+import android.view.ViewGroup
+import android.widget.FrameLayout
+import android.widget.TextView
+import androidx.recyclerview.widget.LinearLayoutManager
+import androidx.recyclerview.widget.RecyclerView
+import org.telegram.messenger.AndroidUtilities
+import org.telegram.messenger.LocaleController
+import org.telegram.messenger.R
+import org.telegram.ui.ActionBar.ActionBar
+import org.telegram.ui.ActionBar.AlertDialog
+import org.telegram.ui.ActionBar.BaseFragment
+import org.telegram.ui.ActionBar.Theme
+import org.telegram.ui.Components.LayoutHelper
+import org.telegram.ui.Components.RecyclerListView
+import tele.helpers.Bookmarks
+
+/** The bookmarks of one chat (or one forum topic), or of the whole account when no chat is given. */
+class TeleBookmarksActivity : BaseFragment() {
+
+    private val account get() = arguments.getInt(ARG_ACCOUNT)
+    private val dialogId get() = arguments.getLong(ARG_DIALOG_ID)
+    private val topicId get() = arguments.getLong(ARG_TOPIC_ID)
+
+    private var entries: List<Bookmarks.Entry> = emptyList()
+    private var adapter: Adapter? = null
+
+    private fun reload() {
+        val showList = { list: List<Bookmarks.Entry> ->
+            entries = list
+            adapter?.notifyDataSetChanged()
+        }
+        if (dialogId == 0L) {
+            Bookmarks.loadAll(account) { if (fragmentView != null) showList(it) }
+        } else {
+            Bookmarks.load(account, dialogId) {
+                // the newest message first, like the button walks them
+                if (fragmentView != null) showList(Bookmarks.list(account, dialogId, topicId).asReversed())
+            }
+        }
+    }
+
+    override fun createView(context: Context): View {
+        actionBar.setBackButtonImage(R.drawable.ic_ab_back)
+        actionBar.setAllowOverlayTitle(true)
+        actionBar.setTitle(LocaleController.getString(R.string.TeleBookmarks))
+        if (dialogId != 0L) actionBar.setSubtitle(TeleDraftsActivity.chatTitle(account, dialogId, topicId.toInt()))
+        actionBar.setActionBarMenuOnItemClick(object : ActionBar.ActionBarMenuOnItemClick() {
+            override fun onItemClick(id: Int) {
+                if (id == -1) finishFragment()
+            }
+        })
+        val container = FrameLayout(context)
+        container.setBackgroundColor(Theme.getColor(Theme.key_windowBackgroundWhite))
+        fragmentView = container
+        val list = RecyclerListView(context)
+        list.layoutManager = LinearLayoutManager(context)
+        list.isVerticalScrollBarEnabled = false
+        adapter = Adapter(context)
+        list.adapter = adapter
+        list.setOnItemClickListener { _, position -> entries.getOrNull(position)?.let { Bookmarks.open(this, account, it) } }
+        list.setOnItemLongClickListener { _, position ->
+            entries.getOrNull(position)?.let { showActions(it) }
+            true
+        }
+        container.addView(list, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, LayoutHelper.MATCH_PARENT.toFloat()))
+        reload()
+        return container
+    }
+
+    override fun onResume() {
+        super.onResume()
+        reload()
+    }
+
+    private fun showActions(entry: Bookmarks.Entry) {
+        val activity = parentActivity ?: return
+        val labels = arrayOf<CharSequence>(LocaleController.getString(R.string.TeleBookmarkRename), LocaleController.getString(R.string.TeleBookmarkRemove))
+        val dialog = AlertDialog.Builder(activity, resourceProvider)
+            .setTitle(entry.title())
+            .setItems(labels) { _, which ->
+                if (which == 0) {
+                    Bookmarks.showRenameDialog(this, account, entry) { adapter?.notifyDataSetChanged() }
+                } else {
+                    Bookmarks.remove(account, entry.dialogId, entry.messageId)
+                    reload()
+                }
+            }
+            .create()
+        showDialog(dialog)
+        dialog.setItemColor(1, Theme.getColor(Theme.key_text_RedBold), Theme.getColor(Theme.key_text_RedRegular))
+    }
+
+    private inner class Adapter(private val context: Context) : RecyclerListView.SelectionAdapter() {
+        override fun getItemCount(): Int = maxOf(entries.size, 1)
+        override fun isEnabled(holder: RecyclerView.ViewHolder): Boolean = entries.isNotEmpty()
+        override fun getItemViewType(position: Int): Int = if (entries.isEmpty()) TYPE_EMPTY else TYPE_ENTRY
+
+        override fun onCreateViewHolder(parent: ViewGroup, viewType: Int): RecyclerView.ViewHolder {
+            val view: View = if (viewType == TYPE_EMPTY) {
+                TextView(context).apply {
+                    setTextColor(Theme.getColor(Theme.key_windowBackgroundWhiteGrayText2))
+                    setTextSize(TypedValue.COMPLEX_UNIT_DIP, 14f)
+                    gravity = Gravity.CENTER
+                    setPadding(AndroidUtilities.dp(32f), AndroidUtilities.dp(48f), AndroidUtilities.dp(32f), AndroidUtilities.dp(16f))
+                }
+            } else {
+                TeleChatRow(context)
+            }
+            view.layoutParams = RecyclerView.LayoutParams(ViewGroup.LayoutParams.MATCH_PARENT, ViewGroup.LayoutParams.WRAP_CONTENT)
+            return RecyclerListView.Holder(view)
+        }
+
+        override fun onBindViewHolder(holder: RecyclerView.ViewHolder, position: Int) {
+            if (getItemViewType(position) == TYPE_EMPTY) {
+                (holder.itemView as TextView).text = LocaleController.getString(R.string.TeleNoBookmarks)
+                return
+            }
+            val entry = entries[position]
+            val row = holder.itemView as TeleChatRow
+            row.setPeer(account, entry.dialogId)
+            row.name.text = entry.title()
+            row.time.text = LocaleController.stringForMessageListDate(entry.created.toLong())
+            // the chat of the bookmark in the full list, the text it was made on when the user named it
+            row.preview.text = when {
+                dialogId == 0L -> TeleDraftsActivity.chatTitle(account, entry.dialogId, entry.topicId.toInt())
+                !entry.name.isNullOrBlank() -> entry.preview
+                else -> ""
+            }
+            row.counter.visibility = View.GONE
+            row.secondary.visibility = View.GONE
+        }
+    }
+
+    companion object {
+        const val MODE_BOOKMARKS = "bookmarks_list"
+        private const val ARG_ACCOUNT = "account"
+        private const val ARG_DIALOG_ID = "dialog_id"
+        private const val ARG_TOPIC_ID = "topic_id"
+        private const val TYPE_EMPTY = 0
+        private const val TYPE_ENTRY = 1
+
+        /** The bookmarks of a chat or a topic of it, or of the whole account for dialogId 0. */
+        @JvmStatic
+        @JvmOverloads
+        fun of(account: Int, dialogId: Long = 0L, topicId: Long = 0L): TeleBookmarksActivity =
+            TeleBookmarksActivity().apply {
+                arguments = Bundle().apply {
+                    putInt(ARG_ACCOUNT, account)
+                    putLong(ARG_DIALOG_ID, dialogId)
+                    putLong(ARG_TOPIC_ID, topicId)
+                }
+            }
+    }
+}
