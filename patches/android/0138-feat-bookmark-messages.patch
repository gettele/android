+    fun putBookmark(account: Int, row: BookmarkRow) {
+        val db = helper?.writableDatabase ?: return
+        val values = ContentValues().apply {
+            put("account", account)
+            put("dialog_id", row.dialogId)
+            put("topic_id", row.topicId)
+            put("message_id", row.messageId)
+            put("name", row.name)
+            put("preview", row.preview)
+            put("created", row.created)
+        }
+        db.insertWithOnConflict("tele_bookmarks", null, values, SQLiteDatabase.CONFLICT_REPLACE)
+    }
+
+    /** The bookmarks of an account, or of one chat, newest first. */
+    fun getBookmarks(account: Int, dialogId: Long? = null): List<BookmarkRow> {
+        val db = helper?.readableDatabase ?: return emptyList()
+        val result = ArrayList<BookmarkRow>()
+        val columns = "dialog_id, topic_id, message_id, name, preview, created"
+        val cursor = if (dialogId == null) {
+            db.rawQuery("SELECT $columns FROM tele_bookmarks WHERE account = ? ORDER BY created DESC, message_id DESC", arrayOf(account.toString()))
+        } else {
+            db.rawQuery("SELECT $columns FROM tele_bookmarks WHERE account = ? AND dialog_id = ? ORDER BY created DESC, message_id DESC", arrayOf(account.toString(), dialogId.toString()))
+        }
+        cursor.use {
+            while (it.moveToNext()) result.add(BookmarkRow(it.getLong(0), it.getLong(1), it.getInt(2), if (it.isNull(3)) null else it.getString(3), it.getString(4), it.getInt(5)))
+        }
+        return result
+    }
+
+    fun updateBookmarkName(account: Int, dialogId: Long, messageId: Int, name: String?) {
+        val db = helper?.writableDatabase ?: return
+        val values = ContentValues().apply { put("name", name) }
+        db.update("tele_bookmarks", values, "account = ? AND dialog_id = ? AND message_id = ?", arrayOf(account.toString(), dialogId.toString(), messageId.toString()))
+    }
+
+    fun removeBookmark(account: Int, dialogId: Long, messageId: Int) {
+        val db = helper?.writableDatabase ?: return
+        db.delete("tele_bookmarks", "account = ? AND dialog_id = ? AND message_id = ?", arrayOf(account.toString(), dialogId.toString(), messageId.toString()))
+    }
+
+    fun countBookmarks(account: Int): Int {
+        val db = helper?.readableDatabase ?: return 0
+        db.rawQuery("SELECT COUNT(*) FROM tele_bookmarks WHERE account = ?", arrayOf(account.toString())).use { return if (it.moveToFirst()) it.getInt(0) else 0 }
+    }
