From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Thu, 5 Nov 2026 17:48:06 +0300
Subject: [PATCH] feat: open tele updates from update buttons

---
 .../telegram/ui/Components/AlertsCreator.java |  2 +-
 .../src/main/java/tele/helpers/TeleUpdater.kt | 21 +++++++++++++++++++
 2 files changed, 22 insertions(+), 1 deletion(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Components/AlertsCreator.java b/TMessagesProj/src/main/java/org/telegram/ui/Components/AlertsCreator.java
index eb78a2df7..78d39725e 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Components/AlertsCreator.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Components/AlertsCreator.java
@@ -736,7 +736,7 @@ public class AlertsCreator {
         builder.setMessage(text);
         builder.setPositiveButton(LocaleController.getString(R.string.OK), null);
         if (updateApp) {
-            builder.setNegativeButton(LocaleController.getString(R.string.UpdateApp), (dialog, which) -> Browser.openUrl(context, BuildVars.PLAYSTORE_APP_URL));
+            builder.setNegativeButton(LocaleController.getString(R.string.UpdateApp), (dialog, which) -> tele.helpers.TeleUpdater.openUpdates(context));
         }
         return builder.show();
     }
diff --git a/TMessagesProj/src/main/java/tele/helpers/TeleUpdater.kt b/TMessagesProj/src/main/java/tele/helpers/TeleUpdater.kt
index 612b847ce..384bed163 100644
--- a/TMessagesProj/src/main/java/tele/helpers/TeleUpdater.kt
+++ b/TMessagesProj/src/main/java/tele/helpers/TeleUpdater.kt
@@ -1,6 +1,7 @@
 package tele.helpers
 
 import android.app.Activity
+import android.content.Context
 import android.os.Build
 import org.json.JSONObject
 import org.telegram.messenger.AndroidUtilities
@@ -97,6 +98,26 @@ object TeleUpdater {
         return AndroidUtilities.openForView(file, file.name, APK_MIME, activity, null, false)
     }
 
+    /** Update buttons across the app: install a ready apk, else check and open tele's updates page. */
+    @JvmStatic
+    fun openUpdates(context: Context) {
+        val activity = context as? Activity
+        if (activity != null && install(activity)) {
+            return
+        }
+        if (status.state == State.DISABLED) {
+            org.telegram.messenger.browser.Browser.openUrl(context, RELEASES)
+            return
+        }
+        checkNow()
+        val fragment = org.telegram.ui.LaunchActivity.getSafeLastFragment()
+        if (fragment != null) {
+            fragment.presentFragment(tele.ui.settings.TeleSettingsActivity(tele.ui.settings.TeleSettingsActivity.MODE_UPDATES))
+        } else {
+            org.telegram.messenger.browser.Browser.openUrl(context, RELEASES)
+        }
+    }
+
     @JvmStatic
     fun addListener(listener: Runnable) {
         listeners.add(listener)
