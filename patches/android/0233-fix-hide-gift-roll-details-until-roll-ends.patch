From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Tue, 3 Nov 2026 04:37:33 +0300
Subject: [PATCH] fix: hide gift roll details until roll ends

---
 .../main/java/tele/ui/TeleGiftRollSheet.kt    | 30 +++++++++----------
 1 file changed, 15 insertions(+), 15 deletions(-)

diff --git a/TMessagesProj/src/main/java/tele/ui/TeleGiftRollSheet.kt b/TMessagesProj/src/main/java/tele/ui/TeleGiftRollSheet.kt
index 6d8c9115f..bd6150a10 100644
--- a/TMessagesProj/src/main/java/tele/ui/TeleGiftRollSheet.kt
+++ b/TMessagesProj/src/main/java/tele/ui/TeleGiftRollSheet.kt
@@ -51,7 +51,7 @@ class TeleGiftRollSheet(
     private var rolling = false
     private var result: GiftFakeUpgrade.Result? = null
 
-    private val step = Runnable {
+    private val step: Runnable = Runnable {
         if (!rolling) return@Runnable
         showScrambled()
         handler.postDelayed(step, ROLL_INTERVAL)
@@ -82,7 +82,7 @@ class TeleGiftRollSheet(
         layout.addView(noticeView, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT, Gravity.CENTER, 0, 0, 0, 8))
 
         val preview = FrameLayout(context)
-        preview.addView(backdropView, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, 220))
+        preview.addView(backdropView, LayoutHelper.createFrame(LayoutHelper.MATCH_PARENT, 220f))
         preview.addView(modelView, LayoutHelper.createFrame(160, 160, Gravity.CENTER))
         preview.addView(patternView, LayoutHelper.createFrame(64, 64, Gravity.CENTER))
         layout.addView(preview, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, 220))
@@ -141,6 +141,14 @@ class TeleGiftRollSheet(
         }
         layout.addView(clearHistoryView, LayoutHelper.createLinear(LayoutHelper.MATCH_PARENT, LayoutHelper.WRAP_CONTENT))
 
+        setOnHideListener {
+            // a roll that is closed before it ends is cancelled
+            handler.removeCallbacks(step)
+            if (rolling) {
+                rolling = false
+                android.util.Log.d("TeleGiftRoll", "fake_roll_cancel")
+            }
+        }
         setCustomView(layout)
         refreshHistory()
         roll()
@@ -158,12 +166,11 @@ class TeleGiftRollSheet(
         val models = candidates.models
         val patterns = candidates.patterns
         val backdrops = candidates.backdrops
-        var model: TL_stars.starGiftAttributeModel? = null
         var pattern: TL_stars.starGiftAttributePattern? = null
         var backdrop: TL_stars.starGiftAttributeBackdrop? = null
         if (models.isNotEmpty()) {
-            model = models[Random.nextInt(models.size)]
-            StarsIntroActivity.setGiftImage(modelView.getImageReceiver(), model.document, 160)
+            // the model of the gift stays hidden until the roll ends
+            modelView.getImageReceiver().clearImage()
         }
         if (patterns.isNotEmpty()) {
             pattern = patterns[Random.nextInt(patterns.size)]
@@ -173,8 +180,9 @@ class TeleGiftRollSheet(
             backdrop = backdrops[Random.nextInt(backdrops.size)]
             setBackdrop(backdrop)
         }
-        numberView.text = "#" + (result?.number ?: 0)
-        modelNameView.text = model?.name ?: ""
+        // the number and the model stay hidden until the roll ends
+        numberView.text = ""
+        modelNameView.text = ""
         patternNameView.text = pattern?.name ?: ""
         backdropNameView.text = backdrop?.name ?: ""
     }
@@ -245,14 +253,6 @@ class TeleGiftRollSheet(
         }
     }
 
-    override fun onDetachedFromWindow() {
-        super.onDetachedFromWindow()
-        handler.removeCallbacks(step)
-        if (rolling) {
-            rolling = false
-            android.util.Log.d("TeleGiftRoll", "fake_roll_cancel")
-        }
-    }
 
     companion object {
         private const val ROLL_INTERVAL = 70L
