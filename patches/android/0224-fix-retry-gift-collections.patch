diff --git a/TMessagesProj/src/main/java/org/telegram/ui/Stars/StarsController.java b/TMessagesProj/src/main/java/org/telegram/ui/Stars/StarsController.java
index 66b87d1d2..9c07fa3c5 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/Stars/StarsController.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/Stars/StarsController.java
@@ -3216,6 +3216,13 @@ public class StarsController {
                     loading = false;
 
                     NotificationCenter.getInstance(currentAccount).postNotificationName(NotificationCenter.starUserGiftCollectionsLoaded, dialogId, GiftsCollections.this);
+                } else if (tele.helpers.GiftCollectionsRetry.enabled()) {
+                    // stock stays "loading" forever after an error
+                    loading = false;
+                    currentRequestId = -1;
+                    AndroidUtilities.runOnUIThread(() -> {
+                        if (shown) load();
+                    }, tele.helpers.GiftCollectionsRetry.DELAY_MS);
                 }
             }));
         }
