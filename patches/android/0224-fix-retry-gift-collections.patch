diff --git a/TMessagesProj/src/main/java/tele/helpers/GiftCollectionsRetry.kt b/TMessagesProj/src/main/java/tele/helpers/GiftCollectionsRetry.kt
new file mode 100644
index 000000000..e154bef39
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/GiftCollectionsRetry.kt
@@ -0,0 +1,12 @@
+package tele.helpers
+
+import tele.TeleConfig
+
+/** A failed load of the gift collections is tried again after a pause (desktop 0224). */
+object GiftCollectionsRetry {
+
+    const val DELAY_MS = 3000L
+
+    @JvmStatic
+    fun enabled(): Boolean = TeleConfig.GIFT_COLLECTIONS_RETRY.value
+}
