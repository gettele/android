diff --git a/TMessagesProj/src/main/java/tele/helpers/Gifts.kt b/TMessagesProj/src/main/java/tele/helpers/Gifts.kt
new file mode 100644
index 000000000..9c397e4ff
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/Gifts.kt
@@ -0,0 +1,13 @@
+package tele.helpers
+
+import org.telegram.tgnet.tl.TL_stars
+import tele.TeleConfig
+
+object Gifts {
+
+    @JvmStatic
+    fun giftId(gift: TL_stars.StarGift?): Long? = when (gift) {
+        is TL_stars.TL_starGiftUnique -> if (TeleConfig.SHOW_GIFT_IDS.value) gift.gift_id else null
+        else -> if (TeleConfig.SHOW_REGULAR_GIFT_IDS.value) gift?.id else null
+    }
+}
diff --git a/TMessagesProj/src/main/java/tele/helpers/LocalNames.kt b/TMessagesProj/src/main/java/tele/helpers/LocalNames.kt
new file mode 100644
index 000000000..308db0908
--- /dev/null
+++ b/TMessagesProj/src/main/java/tele/helpers/LocalNames.kt
@@ -0,0 +1,51 @@
+package tele.helpers
+
+import org.json.JSONObject
+import tele.TeleConfig
+import tele.db.TeleDatabaseHelper
+
+object LocalNames {
+
+    private const val KEY = "local_names"
+    private val names = HashMap<Long, String>()
+    private var loaded = false
+
+    private fun ensureLoaded() {
+        if (loaded) return
+        loaded = true
+        TeleDatabaseHelper.get(KEY)?.let { raw ->
+            runCatching {
+                val json = JSONObject(raw)
+                for (key in json.keys()) {
+                    names[key.toLong()] = json.getString(key)
+                }
+            }
+        }
+    }
+
+    @JvmStatic
+    fun get(userId: Long): String? {
+        if (!TeleConfig.LOCAL_NAMES.value) return null
+        synchronized(names) {
+            ensureLoaded()
+            return names[userId]
+        }
+    }
+
+    @JvmStatic
+    fun set(userId: Long, name: String?) {
+        synchronized(names) {
+            ensureLoaded()
+            if (name.isNullOrEmpty()) {
+                names.remove(userId)
+            } else {
+                names[userId] = name
+            }
+            val json = JSONObject()
+            for ((id, value) in names) {
+                json.put(id.toString(), value)
+            }
+            TeleDatabaseHelper.put(KEY, json.toString())
+        }
+    }
+}
