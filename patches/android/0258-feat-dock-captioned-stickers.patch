+    @JvmStatic
+    fun canAttachSticker(fragment: ChatActivity?): Boolean {
+        if (fragment == null || !enabled() || fragment.chatMode != ChatActivity.MODE_DEFAULT) return false
+        return fragment.messagesController.getSendPaidMessagesStars(fragment.dialogId) == 0L
+    }
+
+    /** Desktop 0236: a sticker or GIF from the picker goes above the field instead of out at once. */
+    @JvmStatic
+    fun attachSticker(fragment: ChatActivity?, document: TLRPC.Document?): Boolean {
+        if (document == null || !canAttachSticker(fragment)) return false
+        val enter = fragment!!.chatActivityEnterView
+        if (enter == null || enter.isEditingMessage) return false
+        val key = keyOf(fragment)
+        ensureLoaded(key.account)
+        val tray = trays.getOrPut(key) { Tray() }
+        if (tray.items.isEmpty()) tray.date = (System.currentTimeMillis() / 1000L).toInt()
+        tray.items.removeAll { it.isSticker }
+        val item = Item()
+        item.document = document
+        item.imageId = -(tray.items.size + 1)
+        tray.items.add(0, item)
+        changed(key)
+        return true
+    }
+
+    /** Desktop 0236: a GIF of the picker goes to the tray as the bot sent it, not only its document. */
+    @JvmStatic
+    fun attachGif(fragment: ChatActivity?, gif: Any?, parent: Any?): Boolean {
+        if (gif is TLRPC.Document) return attachSticker(fragment, gif)
+        val result = gif as? TLRPC.BotInlineResult ?: return false
+        if (!canAttachSticker(fragment)) return false
+        val enter = fragment!!.chatActivityEnterView
+        if (enter == null || enter.isEditingMessage) return false
+        val key = keyOf(fragment)
+        ensureLoaded(key.account)
+        val tray = trays.getOrPut(key) { Tray() }
+        if (tray.items.isEmpty()) tray.date = (System.currentTimeMillis() / 1000L).toInt()
+        tray.items.removeAll { it.isSticker }
+        val item = Item()
+        item.inlineResult = result
+        item.document = result.document
+        item.imageId = -(tray.items.size + 1)
+        tray.items.add(0, item)
+        changed(key)
+        return true
+    }
