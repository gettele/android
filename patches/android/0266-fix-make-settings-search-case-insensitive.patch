From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: tangenx <me@tangenx.dev>
Date: Thu, 5 Nov 2026 03:19:14 +0300
Subject: [PATCH] fix: make settings search case-insensitive

---
 .../src/main/java/org/telegram/ui/ProfileActivity.java        | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/TMessagesProj/src/main/java/org/telegram/ui/ProfileActivity.java b/TMessagesProj/src/main/java/org/telegram/ui/ProfileActivity.java
index 1a9d00df1..5b6e0dcce 100644
--- a/TMessagesProj/src/main/java/org/telegram/ui/ProfileActivity.java
+++ b/TMessagesProj/src/main/java/org/telegram/ui/ProfileActivity.java
@@ -15461,7 +15461,7 @@ public class ProfileActivity extends BaseFragment implements NotificationCenter.
                     SpannableStringBuilder stringBuilder = null;
                     for (int i = 0; i < searchArgs.length; i++) {
                         if (searchArgs[i].length() != 0) {
-                            String searchString = searchArgs[i];
+                            String searchString = searchArgs[i].toLowerCase(Locale.ROOT);
                             int index = title.indexOf(" " + searchString);
                             if (index < 0 && translitArgs[i] != null) {
                                 searchString = translitArgs[i];
@@ -15501,7 +15501,7 @@ public class ProfileActivity extends BaseFragment implements NotificationCenter.
                         SpannableStringBuilder stringBuilder = null;
                         for (int i = 0; i < searchArgs.length; i++) {
                             if (searchArgs[i].length() != 0) {
-                                String searchString = searchArgs[i];
+                                String searchString = searchArgs[i].toLowerCase(Locale.ROOT);
                                 int index = title.indexOf(" " + searchString);
                                 if (index < 0 && translitArgs[i] != null) {
                                     searchString = translitArgs[i];
